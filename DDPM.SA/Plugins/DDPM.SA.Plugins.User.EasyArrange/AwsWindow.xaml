<Window x:Class="DDPM.SA.Plugins.User.EasyArrange.AwsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DDPM.SA.Plugins.User.EasyArrange"
        mc:Ignorable="d"
        Title="AwsWindow" 
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        Height="134" Width="788" 
        Loaded="Window_Loaded">
    <Window.Resources>
        <SolidColorBrush x:Key="OuterBorder_BkBrush" Color="#F20D121A"/>
        <SolidColorBrush x:Key="OuterBorder_BdBrush" Color="#293B4D"/>
        
    </Window.Resources>
    <Grid>
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Hidden"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsAwsWindowVisible}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                        <Setter Property="Window.Topmost" Value="True" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>

        <Border BorderBrush="{StaticResource OuterBorder_BdBrush}" Background="{StaticResource OuterBorder_BkBrush}"
                Width="{Binding cxAws}" Height="{Binding cyAws}"
                CornerRadius="6" BorderThickness="1.5">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.Resources>
                    <Style TargetType="ContentControl">
                        <Setter Property="Width" Value="120"/>
                        <Setter Property="Height" Value="90"/>
                    </Style>
                </Grid.Resources>

                <ContentControl Grid.Column="0" />
                <ContentControl Grid.Column="1" Content="{Binding AwsIcon1}"/>
                <ContentControl Grid.Column="2" Content="{Binding AwsIcon2}"/>
                <ContentControl Grid.Column="3" Content="{Binding AwsIcon3}"/>
                <ContentControl Grid.Column="4" Content="{Binding AwsIcon4}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
