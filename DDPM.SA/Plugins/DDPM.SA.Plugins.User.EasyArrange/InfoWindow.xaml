<Window x:Class="DDPM.SA.Plugins.User.EasyArrange.InfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DDPM.SA.Plugins.User.EasyArrange"
        mc:Ignorable="d"
        Title="InfoWindow" Height="450" Width="800"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual" Left="-99999" Top="-9999"
        Loaded="Window_Loaded" Unloaded="Window_Unloaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <WrapPanel Grid.Row="0">
            <TextBlock Text="Cursor(" />
            <TextBlock Text="{Binding xCursor}" />
            <TextBlock Text="," />
            <TextBlock Text="{Binding yCursor}" />
            <TextBlock Text="), " />

            <TextBlock Text="IsMoving=" />
            <TextBlock Text="{Binding IsMoving}" />
            <TextBlock Text=", IsOnlyShift=" />
            <TextBlock Text="{Binding IsOnlyShift}" />
            <TextBlock Text=", IsShiftPressed=" />
            <TextBlock Text="{Binding IsShiftPressed}" />

            <!-- -->
            <TextBlock Text=", IsWorkUIEnabled=" />
            <TextBlock Text="{Binding IsWorkUIEnabled}" />
            <TextBlock Text=", IsWorkUIShowing=" />
            <TextBlock Text="{Binding IsWorkUIShowing}" />

            <!-- -->
            <TextBlock Text=", Hovering.Screen=" />
            <TextBlock Text="{Binding HoveringScreen}" />
            <TextBlock Text=", Cell=" />
            <TextBlock Text="{Binding HoveringCell}" />

            <TextBlock Text=", hWndForeground=" />
            <TextBlock Text="{Binding hWndForeground}" />


            <TextBlock Text=", IsAwsEanbled="/>
            <TextBlock Text="{Binding IsAwsEnabled}" />
            <TextBlock Text=", IsAwsVisible=" />
            <TextBlock Text="{Binding IsAwsWindowVisible}" />
            <TextBlock Text=", AwsPos(" />
            <TextBlock Text="{Binding xAws}" />
            <TextBlock Text="," />
            <TextBlock Text="{Binding yAws}" />
            <TextBlock Text="), " />

            <TextBlock Text=", PathName=" />
            <TextBlock Text="{Binding PathNameForeground}" />

            <TextBlock Text=", StartMovingMsg=" />
            <TextBlock Text="{Binding StartMovingMsg}" />
        </WrapPanel>
        <TabControl Grid.Row="1">
            <TabItem Header="WorkWindow">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="WorkWindowCount=" />
                        <TextBlock Text="{Binding WorkWindowCount}" />
                    </StackPanel>
                    <ListBox Name="lbWorkWins" ItemsSource="{Binding WorkWinCellInfos}">
                    </ListBox>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>