<Window x:Class="DDPM.SA.Plugins.User.EasyArrange.SaveCustomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DDPM.SA.Plugins.User.EasyArrange"
        mc:Ignorable="d"
        Title="SaveCustomWindow"
        Width="417" Height="196"
        WindowStyle="None" ResizeMode="NoResize" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" AllowsTransparency="True" Loaded="Window_Loaded">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DDPM.SA.Plugins.User.EasyArrange;component/EAStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid MouseLeftButtonDown="rootGrid_MouseLeftButtonDown">
        <Border Name="saveCustomDlg" BorderBrush="#FF293B4D" BorderThickness="1" CornerRadius="4" Background="#F20D121A"
                Width="417" Height="196" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="4" Direction="270" ShadowDepth="4" Color="Black" Opacity="0.6" />
            </Border.Effect>
            <Grid>
                <StackPanel Margin="32">
                    <Grid Height="28">
                        <TextBlock Text="Custom layout" FontFamily="Roboto" Foreground="White" FontSize="20"
                                   VerticalAlignment="Center" HorizontalAlignment="Left" />
                    </Grid>
                    <!--

                    <ComboBox Name="cbNames" Height="46" Margin="0,8" Style="{StaticResource DdpmComboBoxStyle}"
                    IsEditable="True" />
                    -->
                    <ComboBox Name="cbNames" Height="46" Margin="0,8"
                              IsEditable="True" Loaded="cbNames_Loaded" />

                    <StackPanel Orientation="Horizontal" Margin="0,8">
                        <Button Content="Cancel" Padding="31.5,8" Click="cancelButton_Click" />
                        <Button Content="Save"  Padding="31.5,8" Margin="7,0,0,0" Click="saveButton_Click" />
                    </StackPanel>
                </StackPanel>
                <Grid Width="14" Height="14" Margin="20,18" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Path Fill="#FFCCCCCC"
                          Data="M14 0.7175L13.2825 0L7 6.3L0.7175 0.04375L0 0.76125L6.25625 7L0.04375 13.2388L0.76125 14L7 7.74375L13.2388 14L13.9563 13.2825L7.7 7L14 0.7175Z" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>