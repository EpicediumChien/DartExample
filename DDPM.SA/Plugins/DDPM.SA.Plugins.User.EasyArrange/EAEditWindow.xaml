<Window x:Class="DDPM.SA.Plugins.User.EasyArrange.EAEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DDPM.SA.Plugins.User.EasyArrange"
        mc:Ignorable="d"
        Title="EAEditWindow" Height="450" Width="800"
        WindowStyle="None" ResizeMode="NoResize" Background="Transparent" 
        Topmost="True" ShowInTaskbar="False" AllowsTransparency="True" 
        Loaded="Window_Loaded">
    <Window.Resources>
        <!--  **************** DdpmComboBoxStyle: Custom WPF ComboBox  ****************  -->

        <!--  Resources of DdpmComboBox  -->
        <!--  DdomCB_BdColor=(64,88,109,1) : the BorderBrush of the ComboBox ToggleButton part.  -->
        <SolidColorBrush x:Key="DdpmCB_BdColor" Color="#FF40586D" />
        <!--  DdpmCD_BkColor=(41,59,77,1): The background color of the DdpmComboBox  -->
        <SolidColorBrush x:Key="DdpmCB_BkColor" Color="#FF2F3B4D" />
        <!--  DdpmCB_TextColor=(255,255,255,1): The normal item text color of Text in Dropdown list  -->
        <SolidColorBrush x:Key="DdpmCB_TextColor" Color="White" />
        <!--  DdpmCB_HiTextColor=(49,162,227,1): The highlight item color of Text in Dropdown list  -->
        <SolidColorBrush x:Key="DdpmCB_HiTextColor" Color="#FFFF6C6C" />
        <!--  DdpmCB_SelTextColor=(49,162,227,1): The selected item color of Text in Dropdown list  -->
        <SolidColorBrush x:Key="DdpmCB_SelTextColor" Color="#FF31A2E3" />


        <!--  ToogleButton PART of DdpmComboBox  -->
        <!--
       [1] Draw the arrow down by default.
       [2] When the toggle is Checked, change the arrow to 'up'.
       [3] When mouse over on the toggle button, hi light the button background color.
   -->
        <ControlTemplate x:Key="DdpmComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Grid x:Name="toggleBtnRoot" Background="#19000000">

                <!--  [1]  -->
                <Viewbox
               Grid.Column="1"
               Width="16"
               Height="16"
               Margin="0,0,8,0"
               HorizontalAlignment="Right"
               VerticalAlignment="Center"
               Stretch="Uniform">
                    <Grid Width="20" Height="20">
                        <Path
                       Name="Arrow"
                       Data="M1,0 L0,1 L10,11 L20,1 L19,0 L10,9 z"
                       Fill="White" />
                    </Grid>
                </Viewbox>
            </Grid>
            <ControlTemplate.Triggers>
                <!--  [2]  -->
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Arrow" Property="Data" Value="M1,11 L0,10 L10,0 L20,10 L19,11 L10,2 z" />
                </Trigger>
                <!--  [3]  -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="toggleBtnRoot" Property="Background" Value="#4CB1B0B0" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>


        <!--  EditBox (TextBox) of DdpmComboBox  -->
        <!--
       It's unused, because that DdpmComboBox is not editable currently.
   -->
        <ControlTemplate x:Key="ComboBoxTextBox" TargetType="{x:Type TextBox}">
            <Border
           x:Name="PART_ContentHost"
           Background="{TemplateBinding Background}"
           Focusable="False" />
        </ControlTemplate>


        <!--  ComboBoxItem style of DdpmComboBox  -->
        <!--
       Define the hilight style when mouse selecting item
   -->
        <Style x:Key="DdpmComboBoxItemContainerStyle" TargetType="{x:Type ComboBoxItem}">
            <Setter Property="SnapsToDevicePixels" Value="true" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="OverridesDefaultStyle" Value="true" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border Name="Border" Padding="2,2,2,0" SnapsToDevicePixels="true"
                           Background="{StaticResource FakeTransparent}">
                            <ContentPresenter
                           Name="contentPresenter"
                           Margin="0,8,40,8"
                           VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="true">
                                <!-- -->
                                <Setter TargetName="Border" Property="Background" Value="#FF232D36"/>

                                <!-- 
                           <Setter Property="Foreground" Value="{StaticResource DdpmCB_HiTextColor}" /> -->
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Foreground" Value="#888888" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DdpmCB_SelTextColor}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!--  DdpmComboBox Control Template  -->
        <!--
       [1] The margin between ComboBox and Popup is 12
       [2] Popup color and border style
       [3] The scrollbar is hidden in Popup => it's based on the design in Figma.
       [4] Color and border style of ComboBox itself.
       [5] ToggleButton is arranged to entire ComboBox area, templateRoot.Row[0]
   -->
        <ControlTemplate x:Key="DdpmComboBoxControlTemplate" TargetType="ComboBox">
            <Grid x:Name="templateRoot">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="7" />
                    <!--  [1]  -->
                </Grid.RowDefinitions>

                <!--  [2] PART_Popup  -->
                <Popup
               Name="PART_Popup"
               Grid.Row="1"
               MinWidth="{Binding ActualWidth, ElementName=templateRoot}"
               Margin="0,30,0,0"
               AllowsTransparency="True"
               Focusable="False"
               IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource Mode=TemplatedParent}}"
               Placement="Bottom"
               PopupAnimation="Slide">

                    <Border
                   Name="dropDownBorder"
                   Margin="0,0,0,0"
                   Background="{StaticResource DdpmCB_BkColor}"
                   BorderBrush="{StaticResource DdpmCB_BdColor}"
                   BorderThickness="1"
                   CornerRadius="4">
                        <!--  [3] ScrollViewer of Popup  -->
                        <ScrollViewer
                       x:Name="DropDownScrollViewer"
                       Margin="4"
                       SnapsToDevicePixels="True"
                       VerticalScrollBarVisibility="Hidden">

                            <Grid x:Name="grid" RenderOptions.ClearTypeHint="Enabled">
                                <Canvas
                               x:Name="canvas"
                               Width="0"
                               Height="0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top">
                                    <Rectangle
                                   x:Name="opaqueRect"
                                   Width="{Binding ActualWidth, ElementName=dropDownBorder}"
                                   Height="{Binding ActualHeight, ElementName=dropDownBorder}"
                                   Fill="{Binding Background, ElementName=dropDownBorder}" />
                                </Canvas>

                                <ItemsPresenter
                               x:Name="ItemsPresenter"
                               KeyboardNavigation.DirectionalNavigation="Contained"
                               SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Grid>
                        </ScrollViewer>
                    </Border>
                </Popup>

                <!--  [4]  -->
                <Border
               Background="{StaticResource DdpmCB_BkColor}"
               BorderBrush="{StaticResource DdpmCB_BdColor}"
               BorderThickness="1"
               CornerRadius="4">
                    <Grid>
                        <!--  Reserved Column 1 space for the up/down arrow  -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="32" />
                        </Grid.ColumnDefinitions>
                        <!--  [5] toggleButton  -->
                        <ToggleButton
                       Name="toggleButton"
                       Grid.ColumnSpan="2"
                       HorizontalAlignment="Stretch"
                       ClickMode="Press"
                       Focusable="True"
                       IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                       Template="{StaticResource DdpmComboBoxToggleButtonTemplate}" />

                        <ContentPresenter
                       x:Name="contentPresenter"
                       Grid.Column="0"
                       Margin="8,0,0,0"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Content="{TemplateBinding SelectionBoxItem}"
                       ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                       ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                       ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                       IsHitTestVisible="False" />
                    </Grid>
                </Border>
            </Grid>

            <ControlTemplate.Triggers>
                <Trigger Property="IsEnabled" Value="false">
                    <Setter Property="Foreground" Value="#888888"/>
                </Trigger>
            </ControlTemplate.Triggers>
            <!-- Currently no need
           <ControlTemplate.Triggers>
               <Trigger Property="HasItems" Value="false">
                   <Setter TargetName="dropDownBorder" Property="MinHeight" Value="95"/>
               </Trigger>
               <Trigger Property="IsEnabled" Value="false">
                   <Setter Property="Foreground" Value="#888888"/>
               </Trigger>
               <Trigger Property="IsGrouping" Value="true">
                   <Setter Property="ScrollViewer.CanContentScroll" Value="false"/>
               </Trigger>

               <Trigger SourceName="PART_Popup" Property="Popup.AllowsTransparency" Value="true">
                   <Setter TargetName="dropDownBorder" Property="CornerRadius" Value="4"/>
                   <Setter TargetName="dropDownBorder" Property="Margin" Value="0,32,0,0"/>
               </Trigger>
            </ControlTemplate.Triggers>
       -->
        </ControlTemplate>

        <!--  DdpmCombox Style usage from here  -->
        <Style x:Key="DdpmComboBoxStyle" TargetType="ComboBox">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource DdpmCB_BkColor}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template" Value="{StaticResource DdpmComboBoxControlTemplate}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DdpmComboBoxItemContainerStyle}" />
        </Style>

    </Window.Resources>
    
    <Grid>
        <ContentControl Name="splitCtrl"/>
        
        <Grid Name="dragContainer" Width="{Binding ElementName=splitCtrl, Path=ActualWidth}" Visibility="Collapsed"
              Height="{Binding ElementName=splitCtrl, Path=ActualWidth}">
            <Border Name="saveCustomDlg" BorderBrush="#FF293B4D" BorderThickness="1" CornerRadius="4" Background="#F20D121A"
                    Width="417" Height="196" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="4" Direction="270" ShadowDepth="4" Color="Black" Opacity="0.6"/>
                </Border.Effect>
                <Grid>
                    <StackPanel Margin="32">
                        <Grid Height="28">
                            <TextBlock Text="Custom layout" FontFamily="Roboto" Foreground="White" FontSize="20"
                                       VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </Grid>
                        <ComboBox Height="40" Margin="0,8" Style="{StaticResource DdpmComboBoxStyle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8">
                            <Button Content="Cancel" Padding="31.5,8" Click="cancelButton_Click" />
                            <Button Content="Save"  Padding="31.5,8" Margin="7,0,0,0" Click="saveButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                    <Grid Width="14" Height="14" Margin="20,18" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Path Fill="#FFCCCCCC"
                              Data="M14 0.7175L13.2825 0L7 6.3L0.7175 0.04375L0 0.76125L6.25625 7L0.04375 13.2388L0.76125 14L7 7.74375L13.2388 14L13.9563 13.2825L7.7 7L14 0.7175Z"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
