<UserControl x:Class="DDPM.Easy.Common.SplitCtrl4C"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DDPM.Easy.Common"
             mc:Ignorable="d"
             d:Background="Black"
             d:DesignHeight="60" d:DesignWidth="80"
             d:DataContext="{DynamicResource vmDesign}"
             IsVisibleChanged="UserControl_IsVisibleChanged">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="EAStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:SplitCtrlVM x:Key="vmDesign" IsVertical="True" SplitMode="AWS"
                               IsEditable="True" HoveringCell="4C1" />
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- OuterBorder -->
    <Border Style="{StaticResource OuterBorderStyle}">
        <!-- BaseGrid -->
        <Grid>

            <!-- HorzBase -->
            <Grid Name="g0" Style="{StaticResource SplitBaseStyle_Horz}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding Settings[0], Mode=TwoWay}" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="{Binding Settings[1], Mode=TwoWay}" />
                </Grid.ColumnDefinitions>

                <Grid Name="g1" Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="{Binding Settings[2], Mode=TwoWay}" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="{Binding Settings[3], Mode=TwoWay}" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="{Binding Settings[4], Mode=TwoWay}" />
                    </Grid.RowDefinitions>

                    <local:CellBorder x:Name="cell_4c2" Grid.Row="0">
                        <local:CellBorder.Style>
                            <Style TargetType="local:CellBorder" BasedOn="{StaticResource CellBorderStyle2}">
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsWorkMode}" Value="True"/>
                                            <Condition Binding="{Binding HoveringCell}" Value="4c2"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="BorderBrush" Value="{StaticResource SplitCtrl_CellBorder_BdColor_Work_Hover}" />
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsAwsMode}" Value="True"/>
                                            <Condition Binding="{Binding HoveringCell}" Value="4c2"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="{StaticResource SplitCtrl_CellBorder_BkColor_Aws_Hover}"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </local:CellBorder.Style>
                    </local:CellBorder>
                    
                    <local:CellBorder x:Name="cell_4c3" Grid.Row="2">
                        <local:CellBorder.Style>
                            <Style TargetType="local:CellBorder" BasedOn="{StaticResource CellBorderStyle2}">
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsWorkMode}" Value="True"/>
                                            <Condition Binding="{Binding HoveringCell}" Value="4c3"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="BorderBrush" Value="{StaticResource SplitCtrl_CellBorder_BdColor_Work_Hover}" />
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsAwsMode}" Value="True"/>
                                            <Condition Binding="{Binding HoveringCell}" Value="4c3"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="{StaticResource SplitCtrl_CellBorder_BkColor_Aws_Hover}"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </local:CellBorder.Style>
                    </local:CellBorder>
                    <local:CellBorder x:Name="cell_4c4" Grid.Row="4">
                        <local:CellBorder.Style>
                            <Style TargetType="local:CellBorder" BasedOn="{StaticResource CellBorderStyle2}">
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsWorkMode}" Value="True"/>
                                            <Condition Binding="{Binding HoveringCell}" Value="4c4"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="BorderBrush" Value="{StaticResource SplitCtrl_CellBorder_BdColor_Work_Hover}" />
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsAwsMode}" Value="True"/>
                                            <Condition Binding="{Binding HoveringCell}" Value="4c4"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="{StaticResource SplitCtrl_CellBorder_BkColor_Aws_Hover}"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </local:CellBorder.Style>
                    </local:CellBorder>

                    <GridSplitter Name="h1" Grid.Row="1" Style="{StaticResource SplitterStyle_Horz}" />
                    <GridSplitter Name="h2" Grid.Row="3" Style="{StaticResource SplitterStyle_Horz}" />
                </Grid>

                <local:CellBorder x:Name="cell_4c1" Grid.Column="0">
                    <local:CellBorder.Style>
                        <Style TargetType="local:CellBorder" BasedOn="{StaticResource CellBorderStyle2}">
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsWorkMode}" Value="True"/>
                                        <Condition Binding="{Binding HoveringCell}" Value="4c1"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="BorderBrush" Value="{StaticResource SplitCtrl_CellBorder_BdColor_Work_Hover}" />
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsAwsMode}" Value="True"/>
                                        <Condition Binding="{Binding HoveringCell}" Value="4c1"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="{StaticResource SplitCtrl_CellBorder_BkColor_Aws_Hover}"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </local:CellBorder.Style>
                </local:CellBorder>

                <GridSplitter Name="v1" Grid.Column="1" Style="{StaticResource SplitterStyle_Vert}" />
            </Grid>

            <!-- VertBase -->
            <Grid Name="G0" Style="{StaticResource SplitBaseStyle_Vert}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="{Binding Settings[1], Mode=TwoWay}" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="{Binding Settings[0], Mode=TwoWay}" />
                </Grid.RowDefinitions>

                <Grid Name="G1" Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding Settings[2], Mode=TwoWay}" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="{Binding Settings[3], Mode=TwoWay}" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="{Binding Settings[4], Mode=TwoWay}" />
                    </Grid.ColumnDefinitions>

                    <local:CellBorder x:Name="cell_4C2" Grid.Column="0">
                        <local:CellBorder.Style>
                            <Style TargetType="local:CellBorder" BasedOn="{StaticResource CellBorderStyle2}">
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsWorkMode}" Value="True"/>
                                            <Condition Binding="{Binding HoveringCell}" Value="4C2"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="BorderBrush" Value="{StaticResource SplitCtrl_CellBorder_BdColor_Work_Hover}" />
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsAwsMode}" Value="True"/>
                                            <Condition Binding="{Binding HoveringCell}" Value="4C2"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="{StaticResource SplitCtrl_CellBorder_BkColor_Aws_Hover}"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </local:CellBorder.Style>
                    </local:CellBorder>
                    <local:CellBorder x:Name="cell_4C3" Grid.Column="2">
                        <local:CellBorder.Style>
                            <Style TargetType="local:CellBorder" BasedOn="{StaticResource CellBorderStyle2}">
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsWorkMode}" Value="True"/>
                                            <Condition Binding="{Binding HoveringCell}" Value="4C3"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="BorderBrush" Value="{StaticResource SplitCtrl_CellBorder_BdColor_Work_Hover}" />
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsAwsMode}" Value="True"/>
                                            <Condition Binding="{Binding HoveringCell}" Value="4C3"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="{StaticResource SplitCtrl_CellBorder_BkColor_Aws_Hover}"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </local:CellBorder.Style>
                    </local:CellBorder>
                    <local:CellBorder x:Name="cell_4C4" Grid.Column="4">
                        <local:CellBorder.Style>
                            <Style TargetType="local:CellBorder" BasedOn="{StaticResource CellBorderStyle2}">
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsWorkMode}" Value="True"/>
                                            <Condition Binding="{Binding HoveringCell}" Value="4C4"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="BorderBrush" Value="{StaticResource SplitCtrl_CellBorder_BdColor_Work_Hover}" />
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsAwsMode}" Value="True"/>
                                            <Condition Binding="{Binding HoveringCell}" Value="4C4"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="{StaticResource SplitCtrl_CellBorder_BkColor_Aws_Hover}"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </local:CellBorder.Style>
                    </local:CellBorder>

                    <GridSplitter Name="V1" Grid.Column="1" Style="{StaticResource SplitterStyle_Vert}" />

                    <GridSplitter Name="V2" Grid.Column="3" Style="{StaticResource SplitterStyle_Vert}" />
                </Grid>

                <local:CellBorder x:Name="cell_4C1" Grid.Row="2">
                    <local:CellBorder.Style>
                        <Style TargetType="local:CellBorder" BasedOn="{StaticResource CellBorderStyle2}">
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsWorkMode}" Value="True"/>
                                        <Condition Binding="{Binding HoveringCell}" Value="4C1"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="BorderBrush" Value="{StaticResource SplitCtrl_CellBorder_BdColor_Work_Hover}" />
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsAwsMode}" Value="True"/>
                                        <Condition Binding="{Binding HoveringCell}" Value="4C1"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="{StaticResource SplitCtrl_CellBorder_BkColor_Aws_Hover}"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </local:CellBorder.Style>
                </local:CellBorder>

                <GridSplitter Name="H1" Grid.Row="1" Style="{StaticResource SplitterStyle_Horz}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>