<UserControl x:Class="DDPM.Easy.Common.EzListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DDPM.Easy.Common"
             mc:Ignorable="d"
             d:DesignHeight="64" d:DesignWidth="616">
    <UserControl.Resources>

        <!-- EzBtn (pervBtn and nextBtn) Style -->
        <SolidColorBrush x:Key="EzBtn_BkColor_Default" Color="#FF193457" />
        <SolidColorBrush x:Key="EzBtn_BkColor_Disabled" Color="#FF596067" />
        <!-- Reference: https://stackoverflow.com/questions/69997661/css-linear-gradient-to-xaml
        CSS on Figma: linear-gradient(100deg, #0672CB 0.46%, #0078D4 0.46%, #6E69CF 118.31%));
        -->
        <LinearGradientBrush x:Key="EzBtn_BkColor_Hover" StartPoint="0.5,1" EndPoint="0.5,0"
                             MappingMode="RelativeToBoundingBox">
            <LinearGradientBrush.RelativeTransform>
                <TransformGroup>
                    <RotateTransform CenterX="0.5" CenterY="0.5" Angle="100" />
                </TransformGroup>
            </LinearGradientBrush.RelativeTransform>
            <LinearGradientBrush.GradientStops>
                <GradientStopCollection>
                    <GradientStop Color="#FF0672CB" Offset="0" />
                    <GradientStop Color="#FF0078D4" Offset="0.46" />
                    <GradientStop Color="#FF6E69CF" Offset="1.1831" />
                </GradientStopCollection>
            </LinearGradientBrush.GradientStops>
        </LinearGradientBrush>

        <Color x:Key="EzBtn_BdColor">#FF132F54</Color>
        <SolidColorBrush x:Key="EzBtn_BdColor_Default" Color="{StaticResource EzBtn_BdColor}" />
        <SolidColorBrush x:Key="EzBtn_BdColor_Disabled" Color="{StaticResource EzBtn_BdColor}" />
        <SolidColorBrush x:Key="EzBtn_BdColor_Hover" Color="{StaticResource EzBtn_BdColor}" />

        <Style x:Key="EzBtnStyle" TargetType="Border">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="60" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderBrush" Value="{StaticResource EzBtn_BdColor_Default}" />
            <Setter Property="Background" Value="{StaticResource EzBtn_BkColor_Default}" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#7F000000" ShadowDepth="0" BlurRadius="12" Opacity="1" Direction="0" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             Value="False">
                    <Setter Property="Background" Value="{StaticResource EzBtn_BkColor_Disabled}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- EzBtn Arrow Style -->
        <SolidColorBrush x:Key="EzBtnArrow_Fill_Default" Color="White" />
        <SolidColorBrush x:Key="EzBtnArrow_Fill_Disabled" Color="#FFF5F6F7" />
        <SolidColorBrush x:Key="EzBtnArrow_Fill_Hover" Color="White" />
    </UserControl.Resources>
    <Grid>
        <!-- Col0=prevBtn, Col2=nextBtn, Col1=items -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- prevBtn -->
        <Border Grid.Column="0" Name="prevBtn">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource EzBtnStyle}">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource EzBtn_BkColor_Hover}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Viewbox Width="16" Height="16">
                <Grid Width="16" Height="16">
                    <Path Name="ezBtnLeftArrow"
                          Data="M7.79 14.79L8.49 13.99L2.23 8.53004L16 8.53004L16 7.47004L2.23 7.47004L8.49 2.00004L7.79 1.20004L5.93601e-07 8.00004L7.79 14.79Z">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Fill" Value="{StaticResource EzBtnArrow_Fill_Default}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=prevBtn, Path=IsMouseOver}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource EzBtnArrow_Fill_Hover}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 Value="False">
                                        <Setter Property="Fill" Value="{StaticResource EzBtnArrow_Fill_Disabled}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Grid>
            </Viewbox>
        </Border>

        <!-- nextBtn -->
        <Border Grid.Column="2" Name="nextBtn">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource EzBtnStyle}">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource EzBtn_BkColor_Hover}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Viewbox Width="16" Height="16">
                <Grid Width="16" Height="16">
                    <Path Name="ezBtnRightArrow"
                          Data="M8.21 1.20996L7.51 2.00996L13.77 7.46996H0V8.52996H13.77L7.51 14L8.21 14.8L16 7.99996L8.21 1.20996Z">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Fill" Value="{StaticResource EzBtnArrow_Fill_Default}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=nextBtn, Path=IsMouseOver}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource EzBtnArrow_Fill_Hover}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 Value="False">
                                        <Setter Property="Fill" Value="{StaticResource EzBtnArrow_Fill_Disabled}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Grid>
            </Viewbox>
        </Border>

        <!-- Items -->
        <Grid Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ContentControl Grid.Column="0" Content="{Binding Item0}" />
            <ContentControl Grid.Column="1" Content="{Binding Item1}" />
            <ContentControl Grid.Column="2" Content="{Binding Item2}" />
            <ContentControl Grid.Column="3" Content="{Binding Item3}" />
            <ContentControl Grid.Column="4" Content="{Binding Item4}" />
        </Grid>
    </Grid>
</UserControl>