                    <ColumnDefinition Width="{Binding Settings[1], Mode=TwoWay}"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="{Binding Settings[2], Mode=TwoWay}"/>
                </Grid.ColumnDefinitions>

                <local:CellBorder x:Name="cell_6a1" Grid.Column="0" Grid.Row="0">
                    <local:CellBorder.Style>
                        <Style TargetType="local:CellBorder" BasedOn="{StaticResource CellBorderStyle2}">
                            <Setter Property="BorderBrush" Value="{StaticResource SplitCtrl_CellBorder_BdColor_Work_Normal}"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsWorkMode}" Value="True"/>
                                        <Condition Binding="{Binding HoveringCell}" Value="6a1"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="BorderBrush" Value="{StaticResource SplitCtrl_CellBorder_BdColor_Work_Hover}" />
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsAwsMode}" Value="True"/>
                                        <Condition Binding="{Binding HoveringCell}" Value="6a1"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="{StaticResource SplitCtrl_CellBorder_BkColor_Aws_Hover}"/>
                                </MultiDataTrigger>
