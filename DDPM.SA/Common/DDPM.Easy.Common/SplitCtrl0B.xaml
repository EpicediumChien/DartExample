<UserControl x:Class="DDPM.Easy.Common.SplitCtrl0B"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DDPM.Easy.Common"
             mc:Ignorable="d" 
             d:Background="Black"
             d:DesignHeight="60" d:DesignWidth="80"
             d:DataContext="{DynamicResource vmDesign}"
             Name="uc" IsVisibleChanged="uc_IsVisibleChanged"
             >
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="EAStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:SplitCtrlVM x:Key="vmDesign" IsVertical="False" SplitMode="Icon"
                               IsEditable="False"/>
            
            <SolidColorBrush x:Key="BkFillBrush" Color="#FF132F54"/>
            <!-- CellBorder = Border -->
            <SolidColorBrush x:Key="SplitCtrl_CellBorder_BdColor_Work_Normal" Color="#FFE6AC28" />
            <SolidColorBrush x:Key="SplitCtrl_CellBorder_BdColor_Work_Hover" Color="#FF0672CB" />

            <Style x:Key="CellBorderStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource SplitCtrl_CellBorder_BdColor_Work_Normal}" />
                <Setter Property="BorderThickness" Value="6"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Style.Triggers>
                    <Trigger Property="Tag" Value="H">
                        <Setter Property="BorderBrush" Value="{StaticResource SplitCtrl_CellBorder_BdColor_Work_Hover}" />
                    </Trigger>
                    <DataTrigger Binding="{Binding IsAwsMode}" Value="True">
                        <Setter Property="BorderThickness" Value="1.5"/>
                        <Setter Property="BorderBrush" Value="{StaticResource SplitCtrl_OuterBorder_BdColor_Aws_Normal}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="Split0BOuterBorderStyle" TargetType="Border" BasedOn="{StaticResource OuterBorderStyle}">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsIconMode}" Value="True">
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsAwsMode}" Value="True">
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            
            <!-- CellBorder = CellBorder -->
            <Style x:Key="CellBoder0B" TargetType="{x:Type local:CellBorder}">
                <Setter Property="BorderBrush" Value="{StaticResource SplitCtrl_CellBorder_BdColor_Work_Normal}" />
                <Setter Property="BorderThickness" Value="6"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Style.Triggers>
                    <MultiDataTrigger>
                        <!--<MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsWorkMode}" Value="True"/>
                            <Condition Binding="{Binding IsHover, RelativeSource={RelativeSource AncestorType=local:CellBorder}}" Value="True"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="BorderBrush" Value="{StaticResource SplitCtrl_CellBorder_BdColor_Work_Hover}" />
                    </MultiDataTrigger>-->
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsWorkMode}" Value="True"/>
                            <Condition Binding="{Binding IsHover, RelativeSource={RelativeSource Self}}" Value="True"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="BorderBrush" Value="{StaticResource SplitCtrl_CellBorder_BdColor_Work_Hover}" />
                    </MultiDataTrigger>

                    <!--<DataTrigger Binding="{Binding IsHover, ElementName=uc}" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource SplitCtrl_CellBorder_BdColor_Work_Hover}" />
                    </DataTrigger>
                    
                     <DataTrigger Binding="{Binding IsAwsMode}" Value="True">
                        <Setter Property="BorderThickness" Value="1.5"/>
                        <Setter Property="BorderBrush" Value="{StaticResource SplitCtrl_OuterBorder_BdColor_Aws_Normal}"/>
                    </DataTrigger>
                  
                    -->
                    <DataTrigger Binding="{Binding IsAwsMode}" Value="True">
                        <Setter Property="BorderThickness" Value="1.5"/>
                        <Setter Property="BorderBrush" Value="{StaticResource SplitCtrl_OuterBorder_BdColor_Aws_Normal}"/>
                    </DataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsAwsMode}" Value="True"/>
                            <Condition Binding="{Binding IsHover, RelativeSource={RelativeSource Self}}" Value="True"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="BkBrush" Value="{StaticResource SplitCtrl_CellBorder_BkColor_Aws_Hover}"/>
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <!-- Icon Mode -->
        <!-- OuterBorder -->
        <Border Style="{StaticResource Split0BOuterBorderStyle}"/>

        <!-- IconMode -->
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsIconMode}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger> 
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <!-- HorzBase -->
            <Grid Name="g0" Style="{StaticResource SplitBaseStyle_Horz}">
                <Grid Width="60" Height="35">
                    <Rectangle Width="41" Height="34" StrokeThickness="1" 
                               Stroke="{DynamicResource SplitCtrl_OuterBorder_BdColor_Icon_Normal}"
                              HorizontalAlignment="Right" Fill="{DynamicResource SplitCtrl0B_IconFill}"
                      RadiusX="3" RadiusY="3"/>
                    <Rectangle Width="39" Height="18"  StrokeThickness="1" 
                               Stroke="{DynamicResource SplitCtrl_OuterBorder_BdColor_Icon_Normal}"
                               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,11,0,0" 
                               Fill="{DynamicResource SplitCtrl0B_IconFill}"
                               RadiusX="3" RadiusY="3"/>
                </Grid>
            </Grid>

            <!-- VertBase -->
            <Grid Name="G0" Style="{StaticResource SplitBaseStyle_Vert}">
                <Grid Width="35" Height="60">
                    <Rectangle Width="34" Height="41" Stroke="{DynamicResource SplitCtrl_OuterBorder_BdColor_Icon_Normal}"
                               StrokeThickness="1" 
                      VerticalAlignment="Top" Fill="{DynamicResource SplitCtrl0B_IconFill}"
                      RadiusX="3" RadiusY="3"/>
                    <Rectangle Width="18" Height="39" Stroke="{DynamicResource SplitCtrl_OuterBorder_BdColor_Icon_Normal}"
                               StrokeThickness="1" 
                               HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="11,0,0,0"
                               Fill="{DynamicResource SplitCtrl0B_IconFill}"
                      RadiusX="3" RadiusY="3"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- Work Mode -->
        <Canvas Name="canvas">
            <Canvas.Resources>
                <Style TargetType="local:CellBorder" BasedOn="{StaticResource CellBoder0B}"/>
            </Canvas.Resources>
        </Canvas>
    </Grid>

</UserControl>
