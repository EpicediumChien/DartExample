    <SolidColorBrush x:Key="SecondaryButton_BdColor_Pressed" Color="#F5F6F7"/>
    <SolidColorBrush x:Key="SecondaryButton_BdColor_Disabled" Color="#A3A3A3"/>

    <SolidColorBrush x:Key="SecondaryButton_TextColor_Default" Color="#F5F6F7"/>
