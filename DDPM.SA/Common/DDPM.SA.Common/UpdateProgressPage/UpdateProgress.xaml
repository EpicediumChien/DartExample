<UXControls:UXWindow x:Class="DDPM.SA.Common.UpdateProgressPage.UpdateProgress"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:local="clr-namespace:DDPM.SA.Common.UpdateProgressPage"
                     xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
                     xmlns:Alert="clr-namespace:DDPM.SA.Common.Alert"
                     xmlns:lang="clr-namespace:DDPM.SA.Resources.Helper;assembly=DDPM.SA.Resources"
                     mc:Ignorable="d"
                     WindowStartupLocation="CenterScreen"
                     WindowStyle="None"
                     d:DesignHeight="440"
                     d:DesignWidth="800"
                     ShowInTaskbar="False"
                     Topmost="True"
                     Background="Transparent"
                     Loaded="UXWindow_Loaded">
    <UXControls:UXWindow.Resources>
        <!-- 自定義 ProgressBar 樣式 -->
        <Style x:Key="CustomProgressBarStyle"
               TargetType="ProgressBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <!-- 背景 -->
                            <Rectangle Width="{TemplateBinding Width}"
                                       Height="{TemplateBinding Height}"
                                       Fill="{TemplateBinding Background}" />
                            <!-- 動畫條紋 -->
                            <Border x:Name="AnimatedStripes"
                                    Width="{TemplateBinding Width}"
                                    Height="{TemplateBinding Height}"
                                    Background="{TemplateBinding Background}">
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <DrawingBrush x:Name="drawingBrush"
                                                      Stretch="Fill"
                                                      TileMode="Tile"
                                                      ViewportUnits="Absolute"
                                                      Viewport="0,0,36,36"
                                                      ViewboxUnits="RelativeToBoundingBox"
                                                      Viewbox="0,0,1,1">
                                            <DrawingBrush.Drawing>
                                                <GeometryDrawing Brush="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"
                                                                 Geometry="M0,210 L126,0 L232,0 L104,216 Z" />
                                            </DrawingBrush.Drawing>
                                        </DrawingBrush>
                                    </Rectangle.Fill>
                                    <Rectangle.Triggers>
                                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <RectAnimation Storyboard.TargetName="drawingBrush"
                                                                   Storyboard.TargetProperty="(DrawingBrush.Viewport)"
                                                                   From="0,0,36,36"
                                                                   To="36,0,36,36"
                                                                   Duration="0:0:1"
                                                                   AutoReverse="False"
                                                                   RepeatBehavior="Forever" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Rectangle.Triggers>
                                </Rectangle>
                            </Border>
                            <!-- 前景（進度條） -->
                            <Rectangle x:Name="PART_Indicator"
                                       Fill="{TemplateBinding Foreground}"
                                       Height="{TemplateBinding Height}"
                                       Width="{TemplateBinding Width}"
                                       HorizontalAlignment="Left" />
                            <!-- 用於調整 PART_Indicator 寬度的剪裁 -->
                            <Rectangle x:Name="PART_Track"
                                       Width="{TemplateBinding Width}"
                                       Height="{TemplateBinding Height}"
                                       Fill="Transparent" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- 觸發器處理 IsIndeterminate 屬性 -->
                            <Trigger Property="IsIndeterminate"
                                     Value="True">
                                <Setter TargetName="AnimatedStripes"
                                        Property="Visibility"
                                        Value="Visible" />
                                <Setter TargetName="PART_Indicator"
                                        Property="Visibility"
                                        Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsIndeterminate"
                                     Value="False">
                                <Setter TargetName="AnimatedStripes"
                                        Property="Visibility"
                                        Value="Collapsed" />
                                <Setter TargetName="PART_Indicator"
                                        Property="Visibility"
                                        Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UXControls:UXWindow.Resources>
    <Grid MouseDown="Grid_MouseDown">
        <Image Source="{Binding ProgressBarImage}" />
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <UXControls:UXTextBlock Text="{Binding UpdateTitle}"
                                        FontSize="24"
                                        FontFamily="Roboto"
                                        HorizontalAlignment="Left"
                                        Margin="8,8,8,8"
                                        Foreground="{Binding TextForeground}" />
            </Grid>
            <Grid Grid.Row="1">
                <UXControls:UXTextBlock Text="{Binding UpdateVersion}"
                                        FontSize="16"
                                        FontFamily="Roboto"
                                        HorizontalAlignment="Left"
                                        Margin="8,8,8,8"
                                        Foreground="{Binding TextForeground}" />
            </Grid>
            <Grid Grid.Row="2">
                <UXControls:UXTextBlock Text="{Binding UpdateSubTitle}"
                                        FontSize="16"
                                        FontFamily="Roboto"
                                        HorizontalAlignment="Left"
                                        Margin="8,8,8,8"
                                        Foreground="{Binding TextForeground}" />
            </Grid>
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <UXControls:UXTextBlock Grid.Column="0"
                                        Text="{Binding ProgressStr}"
                                        FontSize="16"
                                        FontFamily="Roboto"
                                        HorizontalAlignment="Left"
                                        Margin="8,8,8,8"
                                        Foreground="{Binding TextForeground}" />
                <Grid Grid.Column="1"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center">
                    <Path Data="M7.99994 1.26C9.05321 1.26151 10.0914 1.51022 11.031 1.98612C11.9707 2.46201 12.7855 3.1518 13.4099 4H10.2799V5.05H15.3299V0H14.2599V3.32C13.275 2.01027 11.9036 1.04304 10.3392 0.554923C8.77488 0.0668019 7.09673 0.0824552 5.54176 0.599671C3.9868 1.11689 2.63361 2.10953 1.67331 3.4374C0.713006 4.76528 0.194123 6.36128 0.189941 8H1.25994C1.25994 6.21244 1.97005 4.4981 3.23404 3.2341C4.49804 1.97011 6.21238 1.26 7.99994 1.26Z"
                          Fill="#0672CB" />
                    <Path Data="M14.7399 8C14.7358 9.41548 14.2861 10.7937 13.4546 11.9393C12.6231 13.0848 11.4521 13.9395 10.1076 14.3821C8.76312 14.8248 7.31339 14.8329 5.96403 14.4053C4.61466 13.9777 3.43416 13.1362 2.58994 12H5.71994V11H0.719941V16H1.73994V12.68C2.72484 13.9897 4.09632 14.957 5.66066 15.4451C7.225 15.9332 8.90316 15.9175 10.4581 15.4003C12.0131 14.8831 13.3663 13.8905 14.3266 12.5626C15.2869 11.2347 15.8058 9.63872 15.8099 8H14.7399Z"
                          Fill="#0672CB" />
                </Grid>
                <UXControls:UXTextBlock Grid.Column="2"
                                        Text="{Binding ProgressStr_2}"
                                        FontSize="16"
                                        FontFamily="Roboto"
                                        HorizontalAlignment="Right"
                                        Margin="8,8,8,8"
                                        Foreground="{Binding ProgressStr_2_Color}" />
            </Grid>
            <Grid Grid.Row="5"
                  Margin="5">
                <ProgressBar Style="{StaticResource CustomProgressBarStyle}"
                             x:Name="progressBar"
                             Height="24"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding ProgressValue, Mode=OneWay}"
                             IsIndeterminate="{Binding Progress_IsAnimated}"
                             Foreground="#0672CB"
                             Background="White" />
            </Grid>
            <StackPanel Orientation="Vertical"
                        Grid.Row="6">
                <Alert:AlertBase Margin="5"
                                 AlertType="Info"
                                 Message="{Binding [UpdateProgressMsg], Source={x:Static lang:LangHelper.Instance}, Mode=OneWay}"
                                 Height="53" />
                <Alert:AlertBase Margin="5"
                                 AlertType="Info"
                                 Message="{Binding AlertMessage}"
                                 Visibility="{Binding AlertVisibility}"
                                 Height="53" />
            </StackPanel>
        </Grid>
    </Grid>
</UXControls:UXWindow>