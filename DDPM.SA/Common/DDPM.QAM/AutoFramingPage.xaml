<UserControl x:Class="DDPM.QAM.AutoFramingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             xmlns:local="clr-namespace:DDPM.QAM"
             mc:Ignorable="d"
             Height="72"
             Width="288">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DDPM.QAM;component/PluginStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Background="#141D28"
            Height="72"
            CornerRadius="0,0,10,10">
        <Grid Margin="10,5,10,5">
            <StackPanel HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <UXControls:UXTextBlock Text="AI Auto-Framing"
                                        FontSize="16"
                                        Foreground="White"
                                        TextBlockSemanticColorType="Light"
                                        TextBlockType="Caption"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left" />
                <Path Data="M8 5.05005C8.55228 5.05005 9 4.60233 9 4.05005C9 3.49776 8.55228 3.05005 8 3.05005C7.44772 3.05005 7 3.49776 7 4.05005C7 4.60233 7.44772 5.05005 8 5.05005Z
                      M8.75 6.44995H7.25V12.65H8.75V6.44995Z
                      M8 1C11.85 1 15 4.15 15 8C15 11.85 11.85 15 8 15C4.15 15 1 11.85 1 8C1 4.15 4.15 1 8 1ZM8 0C3.6 0 0 3.6 0 8C0 12.4 3.6 16 8 16C12.4 16 16 12.4 16 8C16 3.6 12.4 0 8 0Z"
                      Fill="White"
                      Margin="8"
                      VerticalAlignment="Center">
                    <Path.ToolTip>
                        <ToolTip Style="{StaticResource InfoToolTipStyle}"
                                 Placement="Top"
                                 VerticalOffset="8"
                                 HorizontalOffset="6">
                            <TextBlock Text=""
                                       Style="{StaticResource TabInfoToolTipTextStyle}"
                                       MaxWidth="350" />
                        </ToolTip>
                    </Path.ToolTip>
                </Path>
            </StackPanel>
            <Grid HorizontalAlignment="Right"
                  VerticalAlignment="Center">
                <UXControls:UXToggleSwitch IsChecked="{Binding Path= AutoFramingStatus}"
                                           ContentTextVisibility="True"
                                           Content="{Binding Path=AutoFramingStatus_String}"
                                           Foreground="White" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
