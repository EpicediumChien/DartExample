    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- <ResourceDictionary Source="/DDPM.QAM;component/PluginStyles.xaml" /> -->
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Border Background="{DynamicResource Default_SA_QAM_CameraSetting_BackGround}"
            CornerRadius="10">
