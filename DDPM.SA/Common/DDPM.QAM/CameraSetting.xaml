                        Focusable="True"
                        MouseLeftButtonDown="Presets_Click"
                        Height="72"
                        Tag="0"
                        IsEnabled="{Binding Settings_IsEnable[0]}"
                        Visibility="{Binding Settings_IsVisibility[0]}">
          <Border.Style>
            <Style TargetType="Border"
                               BasedOn="{StaticResource Border_Test}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding Settings_IsSelected[0]}"
                                             Value="True">
                  <Setter Property="Background"
                                            Value="{StaticResource VbarItem_HiBkColor}" />
                  <Setter Property="BorderBrush"
                                            Value="{StaticResource VbarItem_HiBdColor}" />
                </DataTrigger>
                <Trigger Property="IsEnabled"
                                         Value="false">
                  <Setter Property="Opacity"
                                            Value="0.5" />
                  <Setter Property="Background"
                                            Value="#596067" />
                </Trigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <Border.ToolTip>
            <ToolTip Background="Transparent" BorderThickness="0" Placement="Center" VerticalOffset="-65">
              <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                <Border.Resources>
                  <Style BasedOn="{StaticResource Tooltip_TextBlockStyle}" TargetType="TextBlock" />
                </Border.Resources>
                <TextBlock Text="{Binding [Presets], Source={x:Static lang:LangHelper.Instance}, Mode=OneWay}"
