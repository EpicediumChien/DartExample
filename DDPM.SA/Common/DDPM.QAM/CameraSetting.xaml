<Window x:Class="DDPM.QAM.CameraSetting"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
        xmlns:local="clr-namespace:DDPM.QAM"
        xmlns:lang="clr-namespace:DDPM.SA.Resources.Helper;assembly=DDPM.SA.Resources"
        mc:Ignorable="d"
        Title="CameraSetting"
        WindowStyle="None"
        Width="288"
        ShowInTaskbar="True"
        AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
