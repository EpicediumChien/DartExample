            <Path.Style>
              <Style TargetType="Path">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Settings_IsSelected[0]}"
                                                 Value="True">
                    <Setter Property="Fill"
                                                Value="{DynamicResource Default_SA_QAM_Path_IsTrigger_Color}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Settings_IsSelected[0]}"
                                                 Value="False">
                    <Setter Property="Fill"
