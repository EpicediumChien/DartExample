      <Grid.RowDefinitions>
        <RowDefinition Height="56" />
        <RowDefinition Height="72" />
        <RowDefinition Height="1*" />
      </Grid.RowDefinitions>
      <Border CornerRadius="10,10,0,0" MouseDown="Header_MouseDown">
        <Border.Style>
          <Style TargetType="Border">
            <Style.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Cursor" Value="/DDPM.QAM;component/Imgs/Cursor/HandCursor.cur"/>
              </Trigger>
              <DataTrigger Binding="{Binding IsDragging}" Value="True">
                <Setter Property="Cursor" Value="/DDPM.QAM;component/Imgs/Cursor/FistCursor.cur"/>
                <Setter Property="Background" Value="{DynamicResource Default_SA_QAM_Dragging_Hover}"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <UXControls:UXTextBlock FontSize="16"
                                    TextBlockType="Header1"
                                    FontFamily="Roboto"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontWeight="Bold"
                                    Text="{Binding DeviceModel}"
                                    TextWrapping="WrapWithOverflow"
                                    Foreground="{DynamicResource Default_SA_QAM_Path_BkColor}" />
      </Border>
