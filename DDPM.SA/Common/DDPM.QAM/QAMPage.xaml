<Window x:Class="DDPM.QAM.QAMPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DDPM.QAM"
        mc:Ignorable="d"
        Title="QAMPage"
        WindowStyle="None"
        Height="138"
        Width="72"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        AllowsTransparency="True" IsVisibleChanged="Window_IsVisibleChanged"
        Background="Transparent" Closing="Window_Closing"
        Topmost="True"
        Loaded="Window_Loaded">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!--<ResourceDictionary Source="/DDPM.QAM;component/PluginStyles.xaml" />-->
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Border BorderThickness="2"
            BorderBrush="{StaticResource VbarItem_HiBdColor}" 
            CornerRadius="10">
    <!-- 
        <Border Background="{DynamicResource Default_SA_QAM_BackGround}"
                CornerRadius="10"> -->
    <Border CornerRadius="10">
      <Border.Style>
        <Style TargetType="Border">
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsDragging}" Value="True">
              <Setter Property="Background" Value="{DynamicResource Default_SA_QAM_Dragging_Hover}"/>
            </DataTrigger>

            <DataTrigger Binding="{Binding IsDragging}" Value="False">
              <Setter Property="Background" Value="{DynamicResource Default_SA_QAM_BackGround}"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="32" />
          <RowDefinition Height="72" />
          <RowDefinition Height="34" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <Grid Grid.Column="0" x:Name="HeaderBd"
                          MouseDown="Grid_MouseDown">
            <Border CornerRadius="10,0,0,0" Height="32">
              <Border.Style>
                <Style TargetType="Border">
                  <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter Property="Cursor" Value="/DDPM.QAM;component/Imgs/Cursor/HandCursor.cur"/>
                      <Setter Property="Background" Value="{DynamicResource Default_SA_QAM_BackGround_1}"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="False">
                      <Setter Property="Background" Value="Transparent"/>
                    </Trigger>
                    <DataTrigger Binding="{Binding IsDragging}" Value="True">
                      <Setter Property="Cursor" Value="/DDPM.QAM;component/Imgs/Cursor/FistCursor.cur"/>
                      <Setter Property="Background" Value="{DynamicResource Default_SA_QAM_Dragging_Hover}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <Path Data="M0.589844 0H2.07984V1.28H0.589844V0Z M3.91984 0H5.40984V1.28H3.91984V0Z 
                              M0.589844 7.15H2.07984V8.43H0.589844V7.15Z M3.91984 7.15H5.40984V8.43H3.91984V7.15Z
                              M0.589844 3.57H2.07984V4.85H0.589844V3.57Z M3.91984 3.57H5.40984V4.85H3.91984V3.57Z 
                              M0.589844 10.72H2.07984V12H0.589844V10.72Z M3.91984 10.72H5.40984V12H3.91984V10.72Z"
                              Fill="{DynamicResource Default_SA_QAM_Path_BkColor}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                <Path.Style>
                  <Style TargetType="Path">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsMouseOver, ElementName=HeaderBd}" Value="True">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>

                      <DataTrigger Binding="{Binding IsMouseOver, ElementName=HeaderBd}" Value="False">
                        <Setter Property="Visibility" Value="Collapsed"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Path.Style>
              </Path>
            </Border>
          </Grid>

          <Grid Grid.Column="1"
                          Background="Transparent"
                          MouseDown="Close_Click">
            <Border CornerRadius="0,10,0,0" Height="32">
              <Border.Style>
                <Style TargetType="Border">
                  <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter Property="Background" Value="{DynamicResource Default_SA_QAM_Close_Hover}"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="False">
                      <Setter Property="Background" Value="Transparent"/>
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <Path Data="M16 0.82L15.18 0L8 7.2L0.82 0.05L0 0.87L7.15 8L0.05 15.13L0.87 16L8 8.85L15.13 16L15.95 15.18L8.8 8L16 0.82Z"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                <Path.Style>
                  <Style TargetType="Path">
                    <Setter Property="Fill" Value="{DynamicResource Default_SA_QAM_Path_BkColor}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                        <Setter Property="Fill" Value="White" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Path.Style>
              </Path>
            </Border>
          </Grid>
        </Grid>
