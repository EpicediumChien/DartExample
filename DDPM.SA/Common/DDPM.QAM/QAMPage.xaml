                          Fill="{DynamicResource Default_SA_QAM_Path_BkColor}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" /> -->
            <Image Stretch="Uniform" Height="25" Width="25" x:Name="DDPMInco" Source="{DynamicResource QAMImage_CallDDPM}" IsHitTestVisible="False" />
          </Border>
        </Grid>
      </Grid>
    </Border>
  </Border>
</Window>
