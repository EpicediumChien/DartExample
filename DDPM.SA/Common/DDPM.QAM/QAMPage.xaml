                <Grid Grid.Row="1"
                      Background="{DynamicResource Default_SA_QAM_BackGround_1}"
                      MouseDown="CameraSetting_Click">
                    <Path Data="M12.6523 11.5214L13.3484 10.1927L18.2504 12.7604L18.2504 3.23948L13.3484 5.80716L12.6524 4.47841L19.7504 0.760463L19.7504 15.2395L12.6523 11.5214Z M1.5 2.5H12.5V13.5H9V15H12.5H14V13.5V2.5V1H12.5H1.5H0V2.5V7H1.5V2.5Z M7.7628 11.7016C7.82859 11.3726 7.7628 11.0437 7.69702 10.7148L8.81539 10.0569L8.22331 8.87275L7.03915 9.20169C6.84179 8.93854 6.57865 8.74118 6.3155 8.54382L6.64443 7.29388L5.39449 6.83337L4.80241 8.01753C4.47348 7.95174 4.14455 8.01753 3.81562 8.08332L3.15775 6.96495L1.97359 7.55702L2.36831 8.80697C2.10517 9.00433 1.90781 9.26747 1.71045 9.53062L0.460505 9.20169L0 10.4516L1.18416 11.0437C1.11837 11.3726 1.18416 11.7016 1.24994 12.0305L0.131573 12.6884L0.723651 13.8725L1.97359 13.4778C2.17095 13.741 2.4341 13.9383 2.69725 14.1357L2.36831 15.3856L3.61826 15.8461L4.21033 14.662C4.53927 14.7277 4.8682 14.662 5.19713 14.5962L5.855 15.7145L7.03915 15.1225L6.51286 14.0041C6.77601 13.8067 6.97337 13.5436 7.17073 13.2804L8.42067 13.6094L8.88117 12.3594L7.7628 11.7016ZM5.06556 12.6884C4.34191 13.0173 3.4209 12.6884 3.09196 11.9647C2.76303 11.2411 3.09196 10.3201 3.81562 9.99112C4.53927 9.66219 5.46028 9.99112 5.78921 10.7148C6.11814 11.4384 5.78921 12.3594 5.06556 12.6884Z"
                          Fill="{DynamicResource Default_SA_QAM_Path_BkColor}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Grid> -->

        <Grid Grid.Row="1"
                    MouseDown="CameraSetting_Click" Height="72">
          <Grid.Style>
            <Style TargetType="Grid">
              <Setter Property="Background" Value="{DynamicResource Default_SA_QAM_BackGround_1}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsCameraSettingSelected}" Value="True">
                  <Setter Property="Background" Value="{DynamicResource VbarItem_HiBkColor}" />
                </DataTrigger>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsMouseOver}" Value="True"/>
                    <Condition Binding="{Binding IsCameraSettingSelected}" Value="False"/>
                  </MultiDataTrigger.Conditions>
                  <!--<Setter Property="Background" Value="{DynamicResource Default_SA_QAM_CameraSetting_Hover}"/>-->
                  <Setter Property="Background" Value="{DynamicResource Default_SA_QAM_CameraSetting_Hover}"/>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsDragging}" Value="True">
                  <Setter Property="Background" Value="{DynamicResource Default_SA_QAM_Dragging_Hover}"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Grid.Style>

          <Path x:Name="icon_CameraSetting" Data="M12.6523 11.5214L13.3484 10.1927L18.2504 12.7604L18.2504 3.23948L13.3484 5.80716L12.6524 4.47841L19.7504 0.760463L19.7504 15.2395L12.6523 11.5214Z M1.5 2.5H12.5V13.5H9V15H12.5H14V13.5V2.5V1H12.5H1.5H0V2.5V7H1.5V2.5Z M7.7628 11.7016C7.82859 11.3726 7.7628 11.0437 7.69702 10.7148L8.81539 10.0569L8.22331 8.87275L7.03915 9.20169C6.84179 8.93854 6.57865 8.74118 6.3155 8.54382L6.64443 7.29388L5.39449 6.83337L4.80241 8.01753C4.47348 7.95174 4.14455 8.01753 3.81562 8.08332L3.15775 6.96495L1.97359 7.55702L2.36831 8.80697C2.10517 9.00433 1.90781 9.26747 1.71045 9.53062L0.460505 9.20169L0 10.4516L1.18416 11.0437C1.11837 11.3726 1.18416 11.7016 1.24994 12.0305L0.131573 12.6884L0.723651 13.8725L1.97359 13.4778C2.17095 13.741 2.4341 13.9383 2.69725 14.1357L2.36831 15.3856L3.61826 15.8461L4.21033 14.662C4.53927 14.7277 4.8682 14.662 5.19713 14.5962L5.855 15.7145L7.03915 15.1225L6.51286 14.0041C6.77601 13.8067 6.97337 13.5436 7.17073 13.2804L8.42067 13.6094L8.88117 12.3594L7.7628 11.7016ZM5.06556 12.6884C4.34191 13.0173 3.4209 12.6884 3.09196 11.9647C2.76303 11.2411 3.09196 10.3201 3.81562 9.99112C4.53927 9.66219 5.46028 9.99112 5.78921 10.7148C6.11814 11.4384 5.78921 12.3594 5.06556 12.6884Z"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
            <Path.Style>
              <Style TargetType="Path">
                <Setter Property="Fill" Value="{DynamicResource Default_SA_QAM_Path_BkColor}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsCameraSettingSelected}" Value="True">
                    <Setter Property="Fill" Value="White" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Path.Style>
          </Path>
        </Grid>
        <Grid Grid.Row="2"
                      Background="Transparent"
                      MouseDown="CallDDPM_Click">
          <Border CornerRadius="0,0,10,10" 
                            VerticalAlignment="Top"
                            Height="30">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Default_SA_QAM_BackGround}"/>
                <Style.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Default_SA_QAM_Menu_Hover}"/>
                  </Trigger>
                  <DataTrigger Binding="{Binding IsDragging}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Default_SA_QAM_Dragging_Hover}"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
