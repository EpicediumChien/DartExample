<UserControl x:Class="DDPM.QAM.FOVPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             xmlns:local="clr-namespace:DDPM.QAM"
             mc:Ignorable="d"
             Height="216"
             Width="288">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="/DDPM.QAM;component/PluginStyles.xaml" />-->
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Background="{DynamicResource Default_SA_QAM_Menu_BackGround}"
            Height="216"
            CornerRadius="0,0,10,10">
        <StackPanel IsEnabled="{Binding ZoomEnableStatus}">
            <Border x:Name="btnFOV0"
                    Width="256"
                    Height="36"
                    MouseLeftButtonDown="FOV_Click"
                    Cursor="Hand"
                    Margin="8,30,8,10"
                    Tag="0">
                <Border.Style>
                    <Style TargetType="Border"
                           BasedOn="{StaticResource BorderUnpair}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FOV_IsSelected[0]}"
                                         Value="True">
                                <Setter Property="Background"
                                        Value="{DynamicResource Border_Hover_Color}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter Property="Background"
                                        Value="{DynamicResource Border_Hover_Color}" />
                            </Trigger>
                            <Trigger Property="IsMouseCaptured"
                                     Value="True">
                                <Setter Property="Background"
                                        Value="{DynamicResource Border_Hover_Color}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <UXControls:UXTextBlock Foreground="{DynamicResource Button_UXStyleColor_ForWhiteFrame}"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            FontFamily="Roboto"
                                            FontSize="14"
                                            Name="txtFOV0" />
                </Grid>
            </Border>
            <Border x:Name="btnFOV1"
                    Width="256"
                    Height="36"
                    MouseLeftButtonDown="FOV_Click"
                    Cursor="Hand"
                    Margin="8,10,8,10"
                    Tag="1">
                <Border.Style>
                    <Style TargetType="Border"
                           BasedOn="{StaticResource BorderUnpair}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FOV_IsSelected[1]}"
                                         Value="True">
                                <Setter Property="Background"
                                        Value="{DynamicResource Border_Hover_Color}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter Property="Background"
                                        Value="{DynamicResource Border_Hover_Color}" />
                            </Trigger>
                            <Trigger Property="IsMouseCaptured"
                                     Value="True">
                                <Setter Property="Background"
                                        Value="{DynamicResource Border_Hover_Color}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <UXControls:UXTextBlock Foreground="{DynamicResource Button_UXStyleColor_ForWhiteFrame}"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            FontFamily="Roboto"
                                            FontSize="14"
                                            Name="txtFOV1" />
                </Grid>
            </Border>
            <Border x:Name="btnFOV2"
                    Width="256"
                    Height="36"
                    MouseLeftButtonDown="FOV_Click"
                    Cursor="Hand"
                    Margin="8,10,8,10"
                    Tag="2">
                <Border.Style>
                    <Style TargetType="Border"
                           BasedOn="{StaticResource BorderUnpair}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FOV_IsSelected[2]}"
                                         Value="True">
                                <Setter Property="Background"
                                        Value="{DynamicResource Border_Hover_Color}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter Property="Background"
                                        Value="{DynamicResource Border_Hover_Color}" />
                            </Trigger>
                            <Trigger Property="IsMouseCaptured"
                                     Value="True">
                                <Setter Property="Background"
                                        Value="{DynamicResource Border_Hover_Color}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <UXControls:UXTextBlock Foreground="{DynamicResource Button_UXStyleColor_ForWhiteFrame}"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            FontFamily="Roboto"
                                            FontSize="14"
                                            Name="txtFOV2" />
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
