<UserControl x:Class="DDPM.QAM.PresetsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             xmlns:local="clr-namespace:DDPM.QAM"
             mc:Ignorable="d"
             Height="216" Loaded="UserControl_Loaded"
             Width="288">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="/DDPM.QAM;component/PluginStyles.xaml" />-->
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="ScrollBar">
                <Setter Property="Background"
                        Value="Transparent" />
                <Setter Property="Width"
                        Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track Name="PART_Track"
                                       IsDirectionReversed="false">
                                    <Track.Thumb>
                                        <Thumb Name="Thumb"
                                               Background="Gray"
                                               Height="30"
                                               Width="12">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Ellipse Fill="Gray"
                                                             Width="12"
                                                             Height="30" />
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Background="{DynamicResource Default_SA_QAM_Menu_BackGround}"
            Height="216"
            CornerRadius="0,0,10,10">
        <!--<ScrollViewer >-->
        <StackPanel>
            <ItemsControl ItemsSource="{Binding UI_ProfileList}"
                          Name="listTopics"
                          BorderThickness="0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <Border x:Name="Border_Test"
                                    Width="256"
                                    Height="40"
                                    MouseLeftButtonDown="SetProfile_Click"
                                    Cursor="Hand"
                                    Margin="8,10,8,5"
                                    Visibility="Visible">
                                <Border.Style>
                                    <Style TargetType="Border"
                                           BasedOn="{StaticResource BorderUnpair}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}"
                                                         Value="True">
                                                <Setter Property="Background"
                                                        Value="{DynamicResource Border_Hover_Color}" />
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver"
                                                     Value="True">
                                                <Setter Property="Background"
                                                        Value="{DynamicResource Border_Hover_Color}" />
                                            </Trigger>
                                            <Trigger Property="IsMouseCaptured"
                                                     Value="True">
                                                <Setter Property="Background"
                                                        Value="{DynamicResource Border_Hover_Color}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <UXControls:UXTextBlock Foreground="{DynamicResource Button_UXStyleColor_ForWhiteFrame}"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Center"
                                                            FontFamily="Roboto"
                                                            FontSize="14"
                                                            Text="{Binding Profile_Name}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
        <!--</ScrollViewer>-->
    </Border>
</UserControl>
