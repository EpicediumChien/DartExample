<UserControl x:Class="DDPM.QAM.ZoomPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             xmlns:local="clr-namespace:DDPM.QAM"
             mc:Ignorable="d"
             Height="72"
             Width="288">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="/DDPM.QAM;component/PluginStyles.xaml" />-->
            </ResourceDictionary.MergedDictionaries>
            <local:SliderWidthConverter x:Key="SliderWidthConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Background="{DynamicResource Default_SA_QAM_Menu_BackGround}"
            Height="72"
            CornerRadius="0,0,10,10">
        <Grid Margin="10,5,10,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
