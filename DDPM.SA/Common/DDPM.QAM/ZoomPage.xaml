                      Fill="{DynamicResource Default_SA_QAM_Path_BkColor}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
            </Grid>
            <Slider Grid.Column="1"
                    Margin="8,0"
                    HorizontalContentAlignment="Stretch"
                    AutoToolTipPlacement="None"
                    IsMoveToPointEnabled="True"
                    IsSnapToTickEnabled="True"
                    LargeChange="1"
                    SmallChange="1"
                    Width="200"
                    Maximum="{Binding ZoomMax}"
                    Minimum="{Binding ZoomMin}"
                    Value="{Binding Path=ZoomValue, Mode=TwoWay}"
                    Thumb.DragStarted="ZoomSlider_DragStarted"
                    Thumb.DragCompleted="ZoomSlider_DragCompleted" 
                    IsEnabled="{Binding ZoomEnableStatus}">
                <Slider.Template>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <!-- Black background for the slider -->
                            <Canvas Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Slider}}"
                                    Height="4"
                                    VerticalAlignment="Center">
                                <Rectangle Fill="#293B4D"
                                           Height="4"
                                           Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Slider}}" />
                                <Rectangle Fill="#A4B8CD"
                                           Height="4"
                                           Width="{Binding Value, RelativeSource={RelativeSource AncestorType=Slider}, Converter={StaticResource SliderWidthConverter}}" />
                            </Canvas>
                            
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="#A4B8CD"
                                                         Width="20"
                                                         Height="20" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Slider.Template>
            </Slider>
            <Grid Grid.Column="2">
                <Path Data="M6.58925 2.93002H5.52925V5.58002H2.88925V6.64002H5.52925V9.29002H6.58925V6.64002H9.23925V5.58002H6.58925V2.93002Z
          M15.9993 15.25L10.7393 10C11.4833 9.11157 11.9583 8.02928 12.1087 6.88024C12.2591 5.73121 12.0785 4.56312 11.5882 3.51313C11.0978 2.46315 10.3181 1.57486 9.3405 0.952577C8.36292 0.33029 7.22809 -0.000164308 6.06925 1.70432e-05C5.08796 -0.00230429 4.12064 0.232535 3.24965 0.684541C2.37866 1.13655 1.62979 1.79233 1.06681 2.59606C0.503823 3.3998 0.143396 4.32767 0.0162124 5.30069C-0.110971 6.2737 -0.00114447 7.26304 0.336342 8.18447C0.673829 9.10591 1.22898 9.93214 1.95453 10.5928C2.68008 11.2535 3.55454 11.7291 4.50346 11.9791C5.45238 12.2291 6.44765 12.246 7.40454 12.0286C8.36143 11.8111 9.2516 11.3656 9.99925 10.73L15.2493 16L15.9993 15.25ZM6.06925 11.11C5.08034 11.11 4.11365 10.8168 3.2914 10.2674C2.46915 9.71796 1.82829 8.93707 1.44985 8.02343C1.07142 7.1098 0.972399 6.10447 1.16532 5.13457C1.35825 4.16466 1.83445 3.27375 2.53372 2.57448C3.23298 1.87522 4.12389 1.39902 5.0938 1.20609C6.0637 1.01316 7.06904 1.11218 7.98267 1.49062C8.8963 1.86906 9.67719 2.50992 10.2266 3.33217C10.776 4.15441 11.0693 5.12111 11.0693 6.11002C11.0693 7.4361 10.5425 8.70787 9.60478 9.64555C8.6671 10.5832 7.39533 11.11 6.06925 11.11Z"
                      Fill="{DynamicResource Default_SA_QAM_Path_BkColor}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
