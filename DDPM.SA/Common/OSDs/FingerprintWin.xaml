<Window
    x:Class="DDPM.OSDs.FingerprintWin"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:lang="clr-namespace:DDPM.SA.Resources.Helper;assembly=DDPM.SA.Resources"
    AllowsTransparency="True"
    Background="Transparent"
    Loaded="Window_Loaded"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStartupLocation="Manual"
    WindowStyle="None"
    mc:Ignorable="d">

    <Window.Resources>
        <Storyboard x:Key="FadeOut">
            <DoubleAnimation
                BeginTime="0:0:2.0"
                FillBehavior="HoldEnd"
                Storyboard.TargetName="fadeOutCtrl"
                Storyboard.TargetProperty="Opacity"
                From="0.9"
                To="0"
                Duration="0:0:1" />
        </Storyboard>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid
            x:Name="fadeOutCtrl"
            Grid.Row="0"
            Grid.Column="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom">

            <Border
                Width="366"
                Height="135"
                Background="{DynamicResource Default_SA_OSD_Border_BkColor}"
                BorderBrush="#0DFFFFFF"
                BorderThickness="1.5"
                CornerRadius="5"
                Opacity="0.9">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--Close-->
                    <Canvas Width="20" Height="20" Margin="0,10,10,0" 
                            HorizontalAlignment="Right" VerticalAlignment="Top" 
                            MouseLeftButtonDown="close_Click"
                            Background="Transparent"
                            Tag="{DynamicResource Default_SA_OSD_PathColor}">
                        <Path Data="M16,0.82 L15.18,0 L8,7.2 L0.82,0.05 L0,0.87 L7.15,8 L0.05,15.13 L0.87,16 L8,8.85 L15.13,16 L15.95,15.18 L8.8,8 L16,0.82 Z" 
                            Fill="{Binding Tag, RelativeSource={RelativeSource AncestorType=Canvas}}" />
                    </Canvas>

                    <Grid Grid.Row="1">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="50*" />
                            <RowDefinition Height="50*" />
                        </Grid.RowDefinitions>
                        <!--FingerPrint-->
                        <Canvas Grid.Row="0"
                            Width="35" Height="35"
                            HorizontalAlignment="Center" VerticalAlignment="Top"
                            Tag="{DynamicResource Default_SA_OSD_PathColor}">
                            <Path Data="M8.1127 5.09687C11.1557 3.43428 14.5366 2.48435 18.0002 2.31875C21.464 2.49182 24.8472 3.42538 27.9096 5.05312L28.9377 5.62187L30.0533 3.5875L29.0471 3.01875C25.6364 1.20014 21.8617 0.168631 18.0002 0C14.1695 0.179767 10.4297 1.22692 7.0627 3.0625L6.05645 3.63125L7.0627 5.66562L8.09082 5.09687H8.1127Z" Fill="{Binding Tag, RelativeSource={RelativeSource AncestorType=Canvas}}"/>
                            <Path Data="M33.7283 12.4469C31.9263 9.94457 29.5675 7.89513 26.8381 6.46018C24.1086 5.02523 21.0831 4.24401 18.0002 4.17812C14.9082 4.23443 11.873 5.01833 9.14045 6.46632C6.4079 7.9143 4.05489 9.98564 2.27207 12.5125L1.6377 13.475L3.58457 14.7656L4.21895 13.7812C5.81321 11.6065 7.88394 9.82529 10.2726 8.57408C12.6613 7.32286 15.3046 6.63478 18.0002 6.5625C20.6941 6.64285 23.3346 7.33444 25.722 8.58501C28.1095 9.83557 30.1815 11.6124 31.7814 13.7812L32.4377 14.7437L34.3627 13.4531L33.7283 12.4906V12.4469Z" Fill="{Binding Tag, RelativeSource={RelativeSource AncestorType=Canvas}}"/>
                            <Path Data="M18.0002 8.09375C14.5102 8.09293 11.1399 9.36592 8.52197 11.6738C5.904 13.9816 4.21836 17.1656 3.78145 20.6281C3.49188 23.6484 4.08457 26.6879 5.4877 29.3781L6.07832 30.3844L8.06895 29.225L7.5002 28.2188C6.36124 25.9694 5.8762 23.4457 6.1002 20.9344C6.44882 18.0266 7.85359 15.3483 10.0475 13.4085C12.2415 11.4686 15.0717 10.4024 18.0002 10.4125C20.4158 10.3828 22.7829 11.0917 24.7845 12.4444C26.7861 13.797 28.3268 15.7289 29.2002 17.9813C29.8346 20.1688 30.3158 22.8375 28.4346 23.8875C27.9828 24.1604 27.4791 24.3363 26.9557 24.4041C26.4322 24.4719 25.9004 24.43 25.3939 24.2812C24.8629 24.163 24.3949 23.851 24.0814 23.4062C23.9411 23.0273 23.8242 22.6402 23.7314 22.2469C23.6199 21.2349 23.2904 20.2591 22.7654 19.3868C22.2405 18.5144 21.5327 17.7662 20.6908 17.1937C19.4867 16.4547 18.0441 16.2083 16.6629 16.5057C15.2818 16.8031 14.0684 17.6215 13.2752 18.7906C11.7877 21.2406 12.7064 26.3375 15.1783 29.2906C17.3753 31.6768 20.1137 33.4999 23.1627 34.6063L24.2564 35L25.0439 32.8125L23.9502 32.4188C21.2751 31.4639 18.8726 29.8723 16.9502 27.7812C15.0252 25.5938 14.3689 21.4594 15.2658 19.9938C15.7497 19.3188 16.4789 18.8605 17.297 18.7174C18.115 18.5742 18.9565 18.7576 19.6408 19.2281C20.8221 19.8625 21.2158 21.4156 21.5221 22.7719C21.6282 23.3525 21.8045 23.9181 22.0471 24.4563C22.6477 25.4608 23.6107 26.1968 24.7377 26.5125C25.5491 26.7446 26.3987 26.812 27.2365 26.7105C28.0743 26.6091 28.8833 26.3409 29.6158 25.9219C33.3564 23.8438 31.9564 18.9438 31.4752 17.325C30.4694 14.5752 28.6305 12.2078 26.2149 10.553C23.7994 8.89824 20.9277 8.03851 18.0002 8.09375Z" Fill="{Binding Tag, RelativeSource={RelativeSource AncestorType=Canvas}}"/>
                            <Path Data="M18.3939 14.4375C19.8722 14.4373 21.3071 14.9361 22.4664 15.8533C23.6257 16.7704 24.4415 18.052 24.7814 19.4906L25.0439 20.6281L27.2314 20.0813L26.9689 18.9656C26.4992 17.0033 25.3783 15.2581 23.7893 14.0146C22.2002 12.7712 20.2366 12.1029 18.2189 12.1187C11.7877 12.1187 7.9377 16.2094 7.9377 23.0562C7.9377 23.625 8.11269 28.8531 13.8877 34.1469L14.7627 34.9125L16.3158 33.2062L15.4627 32.4188C12.5766 30.093 10.7094 26.735 10.2564 23.0562C10.1422 21.9374 10.2704 20.807 10.6322 19.742C10.9939 18.6771 11.5809 17.7026 12.353 16.8848C13.1251 16.067 14.0644 15.4251 15.1068 15.0028C16.1492 14.5805 17.2703 14.3877 18.3939 14.4375Z" Fill="{Binding Tag, RelativeSource={RelativeSource AncestorType=Canvas}}"/>
                            <Path Data="M28.4783 29.0281C28.4783 29.0281 21.5877 29.3781 19.4658 23.4719L19.0939 22.3781L16.9064 23.1656L17.2783 24.2594C18.0939 26.8531 20.1908 28.6625 22.4346 29.6312C23.9493 30.2276 25.599 30.509 27.2564 30.4594C27.7731 30.4703 28.2868 30.4006 28.7845 30.2531L30.0502 31.2125L31.2127 29.4625L29.9564 28.5156C29.0962 28.9114 28.2096 29.2223 27.3064 29.4469C27.0233 29.5045 26.7359 29.5527 26.4471 29.5906C26.1836 29.5906 24.2283 29.1625 28.4783 29.0281Z" Fill="{Binding Tag, RelativeSource={RelativeSource AncestorType=Canvas}}"/>
                        </Canvas>
                        <TextBlock
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="Roboto"
                            FontSize="14"
                            FontWeight="Medium"
                            Foreground="{DynamicResource Default_SA_OSD_PathColor}"
                            Text="{Binding [Presence_detection_sensor_is_covered], Source={x:Static lang:LangHelper.Instance}, Mode=OneWay}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>