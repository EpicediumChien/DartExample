    <Grid x:Name="fadeOutCtrl"
          HorizontalAlignment="Center"
          VerticalAlignment="Bottom">
        <Border Width="332"
                Height="135"
                Background="{DynamicResource Default_SA_OSD_Border_BkColor}"
                BorderBrush="#0DFFFFFF"
                BorderThickness="1.5"
                CornerRadius="5"
                Opacity="0.9">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50*" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               HorizontalAlignment="Left"
                               FontFamily="Roboto"
                               FontSize="20"
                               TextWrapping="WrapWithOverflow"
                               Foreground="{DynamicResource Default_SA_OSD_PathColor}"
                               Text="{Binding ShowStringTitle}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Margin" Value="10,10,31,10" />
                                <Setter Property="FontWeight" Value="Medium" />
                                <Setter Property="VerticalAlignment" Value="Top" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding OSDType_Device}" Value="FW">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Margin" Value="36,32,0,0" />
                                        <Setter Property="FontWeight" Value="Regular" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding OSDType_Device}" Value="FingerPrint">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style></TextBlock>
                    <!--Close-->
                    <Canvas Grid.Column="1"
                            Width="20"
                            Height="20"
                            Margin="0,10,10,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            MouseLeftButtonDown="close_Click"
                            Background="Transparent"
                            Tag="{DynamicResource Default_SA_OSD_PathColor}">
                        <Canvas.Style>
                            <Style TargetType="Canvas">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding OSDType_Device}"
                                                 Value="CapsLockOn">
                                        <Setter Property="Visibility"
                                                Value="Hidden" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding OSDType_Device}"
                                                 Value="CapsLockOff">
                                        <Setter Property="Visibility"
                                                Value="Hidden" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding OSDType_Device}"
                                                 Value="ScrollLockOn">
                                        <Setter Property="Visibility"
                                                Value="Hidden" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding OSDType_Device}"
                                                 Value="ScrollLockOff">
                                        <Setter Property="Visibility"
                                                Value="Hidden" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding OSDType_Device}"
                                                 Value="NumLockOn">
                                        <Setter Property="Visibility"
                                                Value="Hidden" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding OSDType_Device}"
                                                 Value="NumLockOff">
                                        <Setter Property="Visibility"
                                                Value="Hidden" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding OSDType_Device}"
                                                 Value="WalkAwayLock">
                                        <Setter Property="Visibility"
                                                Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding OSDType_Device}"
                                                 Value="StartRecording">
                                        <Setter Property="Visibility"
                                                Value="Hidden" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding OSDType_Device}"
                                                 Value="EasyMemory">
                                        <Setter Property="Visibility"
                                                Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Canvas.Style>
                        <Path Data="M16,0.82 L15.18,0 L8,7.2 L0.82,0.05 L0,0.87 L7.15,8 L0.05,15.13 L0.87,16 L8,8.85 L15.13,16 L15.95,15.18 L8.8,8 L16,0.82 Z"
                              Fill="{Binding Tag, RelativeSource={RelativeSource AncestorType=Canvas}}" />
                    </Canvas>
                </Grid>
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="50*" />
                    </Grid.RowDefinitions>
                    <ContentControl>
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding OSDType_Device}"
                                                 Value="Unknown">
                                        <Setter Property="ContentTemplate"
                                                Value="{StaticResource BatteryLowIcon}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding OSDType_Device}"
                                                 Value="Keyboard">
                                        <Setter Property="ContentTemplate"
                                                Value="{StaticResource KeyboardIcon}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding OSDType_Device}"
                                                 Value="Mouse">
                                        <Setter Property="ContentTemplate"
                                                Value="{StaticResource WirelessMouseIcon}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding OSDType_Device}"
                                                 Value="Headset">
                                        <Setter Property="ContentTemplate"
                                                Value="{StaticResource HeadsetIcon}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding OSDType_Device}"
                                                 Value="Pen">
                                        <Setter Property="ContentTemplate"
                                                Value="{StaticResource PencilIcon}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding OSDType_Device}"
                                                 Value="QAM">
                                        <Setter Property="ContentTemplate"
                                                Value="{StaticResource QAM}" />
                                        <Setter Property="Grid.RowSpan"
                                                Value="2" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding OSDType_Device}"
                                                 Value="CapsLockOn">
                                        <Setter Property="ContentTemplate"
                                                Value="{StaticResource CapLockONIcon}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding OSDType_Device}"
                                                 Value="CapsLockOff">
                                        <Setter Property="ContentTemplate"
                                                Value="{StaticResource CapLockOFFIcon}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding OSDType_Device}"
                                                 Value="NumLockOn">
                                        <Setter Property="ContentTemplate"
                                                Value="{StaticResource NumLockONIcon}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding OSDType_Device}"
                                                 Value="NumLockOff">
                                        <Setter Property="ContentTemplate"
                                                Value="{StaticResource NumLockOFFIcon}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding OSDType_Device}"
                                                 Value="ScrollLockOn">
                                        <Setter Property="ContentTemplate"
                                                Value="{StaticResource ScrollLockONIcon}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding OSDType_Device}"
                                                 Value="ScrollLockOff">
                                        <Setter Property="ContentTemplate"
                                                Value="{StaticResource ScrollLockOFFIcon}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding OSDType_Device}" 
                                                 Value="FW">
                                        <Setter Property="Visibility" 
                                                Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding OSDType_Device}"
                                                 Value="Mute">
                                        <Setter Property="ContentTemplate"
                                                Value="{StaticResource Mute}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding OSDType_Device}"
                                                 Value="UnMute">
                                        <Setter Property="ContentTemplate"
                                                Value="{StaticResource UnMute}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding OSDType_Device}"
                                                 Value="FingerPrint">
                                        <Setter Property="ContentTemplate"
                                                Value="{StaticResource Fingerprint}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding OSDType_Device}"
                                                 Value="WalkAwayLock">
                                        <Setter Property="ContentTemplate"
                                                Value="{StaticResource WalkawayLock}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                    <StackPanel x:Name="StringPart"
                                Grid.Row="1"
                                Orientation="Vertical">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding OSDType_Device}" Value="QAM">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding OSDType_Device}" Value="FW">
                                        <Setter Property="Grid.Row" Value="0" />
                                        <Setter Property="Grid.RowSpan" Value="2" />
                                        <Setter Property="HorizontalAlignment" Value="Left" />
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding OSDType_Device}" Value="StartRecording">
                                        <Setter Property="Grid.Row" Value="0" />
                                        <Setter Property="Grid.RowSpan" Value="2" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding OSDType_Device}" Value="EasyMemory">
                                        <Setter Property="Grid.Row" Value="0" />
                                        <Setter Property="Grid.RowSpan" Value="2" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Top"
                                   FontFamily="Roboto"
                                   FontSize="14"
                                   FontWeight="Medium"
                                   TextWrapping="WrapWithOverflow"
                                   Foreground="{DynamicResource Default_SA_OSD_PathColor}"
                                   Text="{Binding ShowStringTitle}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OSDType_Device}" Value="FW">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding OSDType_Device}" Value="StartRecording">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock 
                                   FontFamily="Roboto"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource Default_SA_OSD_PathColor}"
                                   Text="{Binding ShowStringContent,RelativeSource={RelativeSource AncestorType={x:Type local:OSDUserControl}},UpdateSourceTrigger=PropertyChanged}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Center" />
                                    <Setter Property="VerticalAlignment" Value="Top" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OSDType_Device}" Value="WalkAwayLock">
                                            <Setter Property="Margin" Value="0,10,0,0" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding OSDType_Device}" Value="Unknown">
                                            <Setter Property="FontSize" Value="14" />
                                            <Setter Property="FontWeight" Value="Medium" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding OSDType_Device}" Value="Keyboard">
                                            <Setter Property="FontSize" Value="14" />
                                            <Setter Property="FontWeight" Value="Medium" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding OSDType_Device}" Value="Mouse">
                                            <Setter Property="FontSize" Value="14" />
                                            <Setter Property="FontWeight" Value="Medium" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding OSDType_Device}" Value="Headset">
                                            <Setter Property="FontSize" Value="14" />
                                            <Setter Property="FontWeight" Value="Medium" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding OSDType_Device}" Value="Pen">
                                            <Setter Property="FontSize" Value="14" />
                                            <Setter Property="FontWeight" Value="Medium" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding OSDType_Device}" Value="CapsLockOn">
                                            <Setter Property="FontSize" Value="14" />
                                            <Setter Property="FontWeight" Value="Medium" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding OSDType_Device}" Value="CapsLockOff">
                                            <Setter Property="FontSize" Value="14" />
                                            <Setter Property="FontWeight" Value="Medium" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding OSDType_Device}" Value="ScrollLockOn">
                                            <Setter Property="FontSize" Value="14" />
                                            <Setter Property="FontWeight" Value="Medium" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding OSDType_Device}" Value="ScrollLockOff">
                                            <Setter Property="FontSize" Value="14" />
                                            <Setter Property="FontWeight" Value="Medium" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding OSDType_Device}" Value="NumLockOn">
                                            <Setter Property="FontSize" Value="14" />
                                            <Setter Property="FontWeight" Value="Medium" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding OSDType_Device}" Value="NumLockOff">
                                            <Setter Property="FontSize" Value="14" />
                                            <Setter Property="FontWeight" Value="Medium" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding OSDType_Device}" Value="FW">
                                            <Setter Property="FontSize" Value="16" />
                                            <Setter Property="FontWeight" Value="Regular" />
                                            <Setter Property="TextAlignment" Value="Left" />
                                            <Setter Property="Margin" Value="36,-8,0,0" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding OSDType_Device}" Value="Mute">
                                            <Setter Property="FontSize" Value="14" />
                                            <Setter Property="FontWeight" Value="Medium" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding OSDType_Device}" Value="UnMute">
                                            <Setter Property="FontSize" Value="14" />
                                            <Setter Property="FontWeight" Value="Medium" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding OSDType_Device}" Value="FingerPrint">
                                            <Setter Property="FontSize" Value="14" />
                                            <Setter Property="FontWeight" Value="Medium" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding OSDType_Device}" Value="WalkAwayLock">
                                            <Setter Property="FontSize" Value="14" />
                                            <Setter Property="FontWeight" Value="Medium" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding OSDType_Device}" Value="StartRecording">
                                            <Setter Property="FontSize" Value="64" />
                                            <Setter Property="FontWeight" Value="ExtraLight" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding OSDType_Device}" Value="EasyMemory">
                                            <Setter Property="FontSize" Value="40" />
                                            <Setter Property="FontWeight" Value="ExtraLight" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
