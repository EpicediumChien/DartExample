        <DataTemplate x:Key="WirelessMouseIcon">
            <!--Wireless Mouse-->
            <Canvas Grid.Row="0"
                    Width="50" Height="50"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top" 
                    Tag="{DynamicResource Default_SA_OSD_PathColor}">
                <!-- Path for the small rectangle -->
                <Path Data="M14.94 5.36h2.12v5.72h-2.12z"
                      Fill="{Binding Tag, RelativeSource={RelativeSource AncestorType=Canvas}}" />
                <!-- Path for the mouse body -->
                <Path Data="M17.46 0h-2.92c-4.115 0.011-7.449 3.345-7.46 7.459v17.081c0.011 4.115 3.345 7.449 7.459 7.46h2.921c4.115-0.011 7.449-3.345 7.46-7.459v-17.081c-0.011-4.115-3.345-7.449-7.459-7.46h-0.001zM22.8 24.54c-0.011 2.941-2.398 5.32-5.34 5.32 0 0-0 0-0 0h-2.92c0 0-0 0-0 0-2.942 0-5.329-2.379-5.34-5.319v-17.081c0.011-2.941 2.398-5.32 5.34-5.32 0 0 0 0 0 0h2.92c0 0 0 0 0 0 2.942 0 5.329 2.379 5.34 5.319v0.001z"
