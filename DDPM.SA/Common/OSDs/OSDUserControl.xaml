<UserControl x:Class="DDPM.OSDs.OSDUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DDPM.OSDs"
             mc:Ignorable="d" 
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <Storyboard x:Key="FadeOut">
            <DoubleAnimation
          BeginTime="0:0:2.0"
          FillBehavior="HoldEnd"
          Storyboard.TargetName="fadeOutCtrl"
          Storyboard.TargetProperty="Opacity"
          From="0.9"
          To="0"
          Duration="0:0:1" />
        </Storyboard>

        <DataTemplate x:Key="WirelessMouseIcon">
            <!--Wireless Mouse-->
            <Canvas Grid.Row="0"
                    Width="50" Height="50"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top" 
                    Tag="{DynamicResource Default_SA_OSD_PathColor}">
                <!-- Path for the small rectangle -->
                <Path Data="M14.94 5.36h2.12v5.72h-2.12z"
                        Fill="{Binding Tag, RelativeSource={RelativeSource AncestorType=Canvas}}" />
                <!-- Path for the mouse body -->
                <Path Data="M17.46 0h-2.92c-4.115 0.011-7.449 3.345-7.46 7.459v17.081c0.011 4.115 3.345 7.449 7.459 7.46h2.921c4.115-0.011 7.449-3.345 7.46-7.459v-17.081c-0.011-4.115-3.345-7.449-7.459-7.46h-0.001zM22.8 24.54c-0.011 2.941-2.398 5.32-5.34 5.32 0 0-0 0-0 0h-2.92c0 0-0 0-0 0-2.942 0-5.329-2.379-5.34-5.319v-17.081c0.011-2.941 2.398-5.32 5.34-5.32 0 0 0 0 0 0h2.92c0 0 0 0 0 0 2.942 0 5.329 2.379 5.34 5.319v0.001z"
                        Fill="{Binding Tag, RelativeSource={RelativeSource AncestorType=Canvas}}" />
            </Canvas>
        </DataTemplate>
        <DataTemplate x:Key="BatteryLowIcon">
            <Canvas Width="35" Height="35">
                <Path Data="M20.26,4.18 V0 H11.74 V4.18 H7.28 V31.28 H24.72 V4.18 ZM13.84,2 H18.16 V4 H13.84 ZM22.62,29.2 H9.38 V6.26 H22.62 ZM20.54,15.64 H11.46 V27.1 H20.54 V15.64 ZM18.54,25.02 H13.54 V17.72 H18.46 Z" 
                          Fill="Black" />
            </Canvas>
        </DataTemplate>

        <DataTemplate x:Key="CapsLockOff">
            <Canvas
              Width="50" Height="50"
              HorizontalAlignment="Center"
              VerticalAlignment="Bottom" >
                <!--Main Container Shape-->
                <Path Data="M16.5625 20V12.5C16.25 7.8125 20 4.0625 24.375 3.75H25.625C30.625 3.75 34.375 7.8125 34.375 12.5H37.8125C38.125 5.625 32.8125 0.3125 25.9375 0H25.625C18.75 0 13.125 5.625 13.125 12.5V20H5.625V50H44.0625V20H16.5625ZM40.9375 46.5625H9.375V23.4375H40.9375V46.5625Z"
                Fill="Black" />
                <!--Inner Details-->
                <Path Data="M25.2842 30.1885L21.8037 40.7969H19L23.7549 28H25.5391L25.2842 30.1885Z" Fill="Black" />
                <Path Data="M28.1758 40.7969L24.6865 30.1885L24.4053 28H26.207L30.9883 40.7969H28.1758Z" Fill="Black" />
                <Path Data="M28.0176 36.0332V38.0986H21.2588V36.0332H28.0176Z" Fill="Black" />
            </Canvas>
        </DataTemplate>

    </UserControl.Resources>
    <Grid
     
     x:Name="fadeOutCtrl"
     HorizontalAlignment="Center"
     VerticalAlignment="Bottom">

        <Border      
         Width="332"
         Height="135"
         Background="{DynamicResource Default_SA_OSD_Border_BkColor}"
         BorderBrush="#0DFFFFFF"
         BorderThickness="1.5"
         CornerRadius="5"
         Opacity="0.9">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!--Close-->
                <Canvas Grid.Row="0" Width="20" Height="20" Margin="0,10,10,0" 
                     HorizontalAlignment="Right" VerticalAlignment="Top" 
                     MouseLeftButtonDown="close_Click"
                     Background="Transparent"
                     Tag="{DynamicResource Default_SA_OSD_PathColor}">
                    <Path Data="M16,0.82 L15.18,0 L8,7.2 L0.82,0.05 L0,0.87 L7.15,8 L0.05,15.13 L0.87,16 L8,8.85 L15.13,16 L15.95,15.18 L8.8,8 L16,0.82 Z" 
                     Fill="{Binding Tag, RelativeSource={RelativeSource AncestorType=Canvas}}" />
                </Canvas>

                <Grid Grid.Row="1">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="50*" />
                        <RowDefinition Height="50*" />
                    </Grid.RowDefinitions>

                    <ContentControl >
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding OSDType}" Value="0">
                                        <Setter Property="ContentTemplate" Value="{StaticResource WirelessMouseIcon}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding OSDType}" Value="1">
                                        <Setter Property="ContentTemplate" Value="{StaticResource BatteryLowIcon}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding OSDType}" Value="2">
                                        <Setter Property="ContentTemplate" Value="{StaticResource CapsLockOff}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>

                    <StackPanel
                     Grid.Row="1"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Orientation="Vertical">

                        <TextBlock
                         HorizontalAlignment="Center"
                         VerticalAlignment="Top"
                         FontFamily="Roboto"
                         FontSize="14"
                         FontWeight="Medium"
                         TextWrapping="WrapWithOverflow"
                         Foreground="{DynamicResource Default_SA_OSD_PathColor}"
                         Text="{Binding ShowStringTitle}" />

                        <TextBlock
                         HorizontalAlignment="Center"
                         VerticalAlignment="Top"
                         FontFamily="Roboto"
                         FontSize="14"
                         FontWeight="Medium"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource Default_SA_OSD_PathColor}"
                         Text="{Binding ShowStringContent}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
