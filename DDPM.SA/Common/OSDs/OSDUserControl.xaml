        <DataTemplate x:Key="PencilIcon">
            <!--Pencil-->
            <Canvas Grid.Row="0"
                    Width="35" Height="35"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom" 
                    Tag="{DynamicResource Default_SA_OSD_PathColor}">
                <Path Data="M26.14 0l-22.46 22.46-3.32 8.52-0.36 1.02 1.02-0.36 8.54-3.34 22.44-22.44zM3.74 28.26l1.72-4.44 2.74 2.7zM9.74 25.04l-2.82-2.8 16-16 2.82 2.78-16 16zM24.48 4.72l1.66-1.66 2.8 2.8-1.64 1.64z"
                      Fill="{Binding Tag, RelativeSource={RelativeSource AncestorType=Canvas}}" />
            </Canvas>
        </DataTemplate>



    </UserControl.Resources>
    <Grid
     
     x:Name="fadeOutCtrl"
     HorizontalAlignment="Center"
     VerticalAlignment="Bottom">

        <Border      
         Width="332"
         Height="135"
         Background="{DynamicResource Default_SA_OSD_Border_BkColor}"
         BorderBrush="#0DFFFFFF"
         BorderThickness="1.5"
         CornerRadius="5"
         Opacity="0.9">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!--Close-->
                <Canvas Grid.Row="0" Width="20" Height="20" Margin="0,10,10,0" 
                     HorizontalAlignment="Right" VerticalAlignment="Top" 
                     MouseLeftButtonDown="close_Click"
                     Background="Transparent"
                     Tag="{DynamicResource Default_SA_OSD_PathColor}">
                    <Path Data="M16,0.82 L15.18,0 L8,7.2 L0.82,0.05 L0,0.87 L7.15,8 L0.05,15.13 L0.87,16 L8,8.85 L15.13,16 L15.95,15.18 L8.8,8 L16,0.82 Z" 
                     Fill="{Binding Tag, RelativeSource={RelativeSource AncestorType=Canvas}}" />
                </Canvas>

                <Grid Grid.Row="1">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="50*" />
                        <RowDefinition Height="50*" />
                    </Grid.RowDefinitions>

                    <ContentControl >
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding OSDType_Device}" Value="Unknown">
                                        <Setter Property="ContentTemplate" Value="{StaticResource BatteryLowIcon}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding OSDType_Device}" Value="Keyboard">
                                        <Setter Property="ContentTemplate" Value="{StaticResource KeyboardIcon}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding OSDType_Device}" Value="Mouse">
                                        <Setter Property="ContentTemplate" Value="{StaticResource WirelessMouseIcon}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding OSDType_Device}" Value="Headset">
                                        <Setter Property="ContentTemplate" Value="{StaticResource HeadsetIcon}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding OSDType_Device}" Value="Pen">
                                        <Setter Property="ContentTemplate" Value="{StaticResource PencilIcon}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>

                    <StackPanel
                     Grid.Row="1"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Orientation="Vertical">

                        <TextBlock
                         HorizontalAlignment="Center"
                         VerticalAlignment="Top"
                         FontFamily="Roboto"
                         FontSize="14"
                         FontWeight="Medium"
                         TextWrapping="WrapWithOverflow"
                         Foreground="{DynamicResource Default_SA_OSD_PathColor}"
                         Text="{Binding ShowStringTitle}" />

                        <TextBlock
                         HorizontalAlignment="Center"
                         VerticalAlignment="Top"
                         FontFamily="Roboto"
                         FontSize="14"
                         FontWeight="Medium"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource Default_SA_OSD_PathColor}"
                         Text="{Binding ShowStringContent}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
