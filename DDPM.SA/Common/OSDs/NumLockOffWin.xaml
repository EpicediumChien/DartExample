<Window
    x:Class="DDPM.OSDs.NumLockOffWin"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:lang="clr-namespace:DDPM.SA.Resources.Helper;assembly=DDPM.SA.Resources"
    AllowsTransparency="True"
    Background="Transparent"
    Loaded="Window_Loaded"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStartupLocation="Manual"
    WindowStyle="None" Closed="Window_Closed"
    mc:Ignorable="d">

    <Window.Resources>
        <Storyboard x:Key="FadeOut">
            <DoubleAnimation
                BeginTime="0:0:2.0"
                FillBehavior="HoldEnd"
                Storyboard.TargetName="fadeOutCtrl"
                Storyboard.TargetProperty="Opacity"
                From="0.9"
                To="0"
                Duration="0:0:1" />
        </Storyboard>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid
            Margin="0,32,0,0"
            x:Name="fadeOutCtrl"
            Grid.Row="0"
            Grid.Column="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom">

            <Border
                Width="366"
                Height="148"
                Background="{DynamicResource Default_SA_OSD_Border_BkColor}"
                BorderBrush="#0DFFFFFF"
                BorderThickness="1.5"
                CornerRadius="5"
                Opacity="0.9">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="50*" />
                        <RowDefinition Height="50*" />
                    </Grid.RowDefinitions>
                    
                    <!--NumLockOff-->
                    <Canvas Grid.Row="0" 
                            Width="50" Height="50"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Tag="{DynamicResource Default_SA_OSD_PathColor}">
                        <Path Data="M16.5625 20V12.5C16.25 7.8125 20 4.0625 24.375 3.75H25.625C30.625 3.75 34.375 7.8125 34.375 12.5H37.8125C38.125 5.625 32.8125 0.3125 25.9375 0H25.625C18.75 0 13.125 5.625 13.125 12.5V20H5.625V50H44.0625V20H16.5625ZM40.9375 46.5625H9.375V23.4375H40.9375V46.5625Z"
                              Fill="{Binding Tag, RelativeSource={RelativeSource AncestorType=Canvas}}" />
                        <Path Data="M27.8809 28.1768V41H25.3496V31.0947L22.3086 32.0615V30.0664L27.6084 28.1768H27.8809Z"
                              Fill="{Binding Tag, RelativeSource={RelativeSource AncestorType=Canvas}}" />
                    </Canvas>

                    <TextBlock
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="Roboto"
                        FontSize="14"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Default_SA_OSD_PathColor}"
                        Text="{Binding [Num_Lock_Off], Source={x:Static lang:LangHelper.Instance}, Mode=OneWay}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>