<Window
    x:Class="DDPM.OSDs.DisplayChangedWin"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    AllowsTransparency="True"
    Background="Transparent"
    Loaded="Window_Loaded"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStartupLocation="Manual"
    WindowStyle="None"
    Closed="Window_Closed"
    mc:Ignorable="d">

    <Window.Resources>
        <Storyboard x:Key="FadeOut">
            <DoubleAnimation
                BeginTime="0:0:2.0"
                FillBehavior="HoldEnd"
                Storyboard.TargetName="fadeOutCtrl"
                Storyboard.TargetProperty="Opacity"
                From="0.9"
                To="0"
                Duration="0:0:1" />
        </Storyboard>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid
            x:Name="fadeOutCtrl"
            Grid.Row="1"
            Grid.Column="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <Border
                Width="398"
                Height="296"
                Background="{DynamicResource Default_SA_OSD_Border_BkColor}"
                BorderBrush="#0DFFFFFF"
                BorderThickness="1.5"
                CornerRadius="5"
                Opacity="0.9">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="50*" />
                        <RowDefinition Height="50*" />
                    </Grid.RowDefinitions>
                    <Canvas Grid.Row="0" 
                            Width="60" Height="48"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Tag="{DynamicResource Default_SA_OSD_PathColor}">
                        <Path Data="M60,40.3125 V6.5625 H0 V40.3125 H23.4375 V49.6125 H14.0625 V53.5875 H45.9375 V49.6125 H36.5625 V40.3125 H60 Z M32.55,40.3125 V49.575 H27.45 V40.3125 H32.55 Z M4.0125,10.3125 H55.9875 V36.3 H4.0125 V10.3125 Z" 
                        Fill="{Binding Tag, RelativeSource={RelativeSource AncestorType=Canvas}}"/>
                    </Canvas>
                    <TextBlock
                        x:Name="ShowStringText"
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="Roboto"
                        FontSize="64"
                        FontWeight="ExtraLight"
                        Foreground="{DynamicResource Default_SA_OSD_PathColor}"
                        Text="P2422H" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>