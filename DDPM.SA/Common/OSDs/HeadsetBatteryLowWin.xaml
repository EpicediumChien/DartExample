                               Fill="{Binding Tag, RelativeSource={RelativeSource AncestorType=Canvas}}" />
                        </Canvas>

                        <StackPanel
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Vertical">

                            <TextBlock
                                x:Name="ShowStringText"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Roboto"
                                FontSize="14"
                                FontWeight="Medium"
                                Foreground="{DynamicResource Default_SA_OSD_PathColor}"
                                Text="" />

                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Roboto"
                                FontSize="14"
                                FontWeight="Medium"
                                Foreground="{DynamicResource Default_SA_OSD_PathColor}"
                                Text="{Binding [Battery_Low], Source={x:Static lang:LangHelper.Instance}, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>