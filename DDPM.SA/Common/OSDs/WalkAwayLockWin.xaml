<Window
    x:Class="DDPM.OSDs.WalkAwayLockWin"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:lang="clr-namespace:DDPM.SA.Resources.Helper;assembly=DDPM.SA.Resources"
    AllowsTransparency="True"
    Background="Transparent"
    Loaded="Window_Loaded"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStartupLocation="Manual"
    WindowStyle="None"
    mc:Ignorable="d">

    <Window.Resources>
        <Storyboard x:Key="FadeOut">
            <DoubleAnimation
                BeginTime="0:0:2.0"
                FillBehavior="HoldEnd"
                Storyboard.TargetName="fadeOutCtrl"
                Storyboard.TargetProperty="Opacity"
                From="0.9"
                To="0"
                Duration="0:0:1" />
        </Storyboard>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid
            x:Name="fadeOutCtrl"
            Grid.Row="0"
            Grid.Column="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom">

            <Border
                Width="366"
                Height="199"
                Background="{DynamicResource Default_SA_OSD_Border_BkColor}"
                BorderBrush="#0DFFFFFF"
                BorderThickness="1.5"
                CornerRadius="5"
                Opacity="0.9">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="33*" />
                        <RowDefinition Height="33*" />
                        <RowDefinition Height="33*" />
                    </Grid.RowDefinitions>
                    <Image
                        Grid.Row="0"
                        Width="35"
                        Height="35"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Source="./Img/Lock.png" />
                    <TextBlock
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="Roboto"
                        FontSize="20"
                        FontWeight="Medium"
                        Foreground="#FFFFFF"
                        Text="{Binding [Walk_Away_Lock], Source={x:Static lang:LangHelper.Instance}, Mode=OneWay}" />
                    <TextBlock
                        x:Name="ShowStringText"
                        Grid.Row="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        FontFamily="Roboto"
                        FontSize="40"
                        FontWeight="ExtraLight"
                        Foreground="#FFFFFF"
                        Text="5" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>