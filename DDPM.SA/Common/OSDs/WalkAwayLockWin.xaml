<Window
    x:Class="DDPM.OSDs.WalkAwayLockWin"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:lang="clr-namespace:DDPM.SA.Resources.Helper;assembly=DDPM.SA.Resources"
    AllowsTransparency="True"
    Background="Transparent"
    Loaded="Window_Loaded"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStartupLocation="Manual"
    WindowStyle="None"
    mc:Ignorable="d">

    <Window.Resources>
        <Storyboard x:Key="FadeOut">
            <DoubleAnimation
                BeginTime="0:0:2.0"
                FillBehavior="HoldEnd"
                Storyboard.TargetName="fadeOutCtrl"
                Storyboard.TargetProperty="Opacity"
                From="0.9"
                To="0"
                Duration="0:0:1" />
        </Storyboard>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid
            x:Name="fadeOutCtrl"
            Grid.Row="0"
            Grid.Column="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom">

            <Border
                Width="366"
                Height="199"
                Background="{DynamicResource Default_SA_OSD_Border_BkColor}"
                BorderBrush="#0DFFFFFF"
                BorderThickness="1.5"
                CornerRadius="5"
                Opacity="0.9">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="33*" />
                        <RowDefinition Height="33*" />
                        <RowDefinition Height="33*" />
                    </Grid.RowDefinitions>
                    <!--Walk away lock-->
                    <Canvas Grid.Row="0" 
                            Width="35" Height="35"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom" 
                            Tag="{DynamicResource Default_SA_OSD_PathColor}">
                        <!-- Path 1 (Main Shape) -->
                        <Path Data="M26.9688 14V8.75C27.1875 3.9375 23.4688 0.21875 18.6562 0H18.2188C13.4062 0 9.46875 3.9375 9.46875 8.75V14H4.4375V35H31.3438V14H26.9688ZM12.0938 8.75C11.875 5.46875 14.5 2.84375 17.5625 2.625H18.4375C21.9375 2.625 24.5625 5.46875 24.5625 8.75V14H12.0938V8.75ZM29.1562 32.5938H7.0625V16.4062H29.1562V32.5938Z"
                              Fill="{Binding Tag, RelativeSource={RelativeSource AncestorType=Canvas}}" />
                        <!-- Path 2 (Cross Shape) -->
                        <Path Data="M17.125 27.3438H19.3125V20.3438H15.375V22.5312H17.125V27.3438Z"
                              Fill="{Binding Tag, RelativeSource={RelativeSource AncestorType=Canvas}}" />
                    </Canvas>
                    <TextBlock
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="Roboto"
                        FontSize="20"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Default_SA_OSD_PathColor}"
                        Text="{Binding [Walk_Away_Lock], Source={x:Static lang:LangHelper.Instance}, Mode=OneWay}" />
                    <TextBlock
                        x:Name="ShowStringText"
                        Grid.Row="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        FontFamily="Roboto"
                        FontSize="40"
                        FontWeight="ExtraLight"
                        Foreground="{DynamicResource Default_SA_OSD_PathColor}"
                        Text="5" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>