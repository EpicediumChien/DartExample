<Window
    x:Class="DDPM.OSDs.MouseBatteryLowIWin"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:lang="clr-namespace:DDPM.SA.Resources.Helper;assembly=DDPM.SA.Resources"
    AllowsTransparency="True"
    Background="Transparent"
    Loaded="Window_Loaded"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStartupLocation="Manual"
    WindowStyle="None"
    Title="AFF4035F-B0CA-4B8C-991F-AAEBEB625EEF-MouseBatteryLowIWin"
    mc:Ignorable="d">

    <Window.Resources>
        <Storyboard x:Key="FadeOut">
            <DoubleAnimation
                BeginTime="0:0:2.0"
                FillBehavior="HoldEnd"
                Storyboard.TargetName="fadeOutCtrl"
                Storyboard.TargetProperty="Opacity"
                From="0.9"
                To="0"
                Duration="0:0:1" />
        </Storyboard>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid
            Margin="0,32,0,0"
            x:Name="fadeOutCtrl"
            Grid.Row="0"
            Grid.Column="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom">

            <Border
                Width="366"
                Height="148"
                Background="{DynamicResource Default_SA_OSD_Border_BkColor}"
                BorderBrush="#0DFFFFFF"
                BorderThickness="1.5"
                CornerRadius="5"
                Opacity="0.9">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--Close-->
                    <Canvas Grid.Row="0" Width="16" Height="16" Margin="0,10,10,0" 
                            HorizontalAlignment="Right" VerticalAlignment="Top" 
                            MouseLeftButtonDown="close_Click" 
                            Tag="{DynamicResource Default_SA_OSD_PathColor}">
                        <Path Data="M16,0.82 L15.18,0 L8,7.2 L0.82,0.05 L0,0.87 L7.15,8 L0.05,15.13 L0.87,16 L8,8.85 L15.13,16 L15.95,15.18 L8.8,8 L16,0.82 Z" 
                            Fill="{Binding Tag, RelativeSource={RelativeSource AncestorType=Canvas}}" />
                    </Canvas>

                    <Grid Grid.Row="1">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="50*" />
                            <RowDefinition Height="50*" />
                        </Grid.RowDefinitions>

                        <!--Wireless Mouse-->
                        <Canvas Grid.Row="0"
                            Width="50" Height="50"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top" 
                            Tag="{DynamicResource Default_SA_OSD_PathColor}">
                            <!-- Path for the small rectangle -->
                            <Path Data="M14.94 5.36h2.12v5.72h-2.12z"
                              Fill="{Binding Tag, RelativeSource={RelativeSource AncestorType=Canvas}}" />
                            <!-- Path for the mouse body -->
                            <Path Data="M17.46 0h-2.92c-4.115 0.011-7.449 3.345-7.46 7.459v17.081c0.011 4.115 3.345 7.449 7.459 7.46h2.921c4.115-0.011 7.449-3.345 7.46-7.459v-17.081c-0.011-4.115-3.345-7.449-7.459-7.46h-0.001zM22.8 24.54c-0.011 2.941-2.398 5.32-5.34 5.32 0 0-0 0-0 0h-2.92c0 0-0 0-0 0-2.942 0-5.329-2.379-5.34-5.319v-17.081c0.011-2.941 2.398-5.32 5.34-5.32 0 0 0 0 0 0h2.92c0 0 0 0 0 0 2.942 0 5.329 2.379 5.34 5.319v0.001z"
                              Fill="{Binding Tag, RelativeSource={RelativeSource AncestorType=Canvas}}" />
                        </Canvas>

                        <StackPanel
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Vertical">

                            <TextBlock
                                x:Name="ShowStringText"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Roboto"
                                FontSize="14"
                                FontWeight="Medium"
                                Foreground="{DynamicResource Default_SA_OSD_PathColor}"
                                Text="" />

                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Roboto"
                                FontSize="14"
                                FontWeight="Medium"
                                Foreground="{DynamicResource Default_SA_OSD_PathColor}"
                                Text="{Binding [Battery_Low], Source={x:Static lang:LangHelper.Instance}, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>