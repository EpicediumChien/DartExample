<Window x:Class="DDPM.OSDs.QAMHotKeyWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DDPM.OSDs"
        xmlns:lang="clr-namespace:DDPM.SA.Resources.Helper;assembly=DDPM.SA.Resources"
        AllowsTransparency="True"
        Background="Transparent"
        Loaded="Window_Loaded"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        mc:Ignorable="d">
    <Window.Resources>
        <Storyboard x:Key="FadeOut">
            <DoubleAnimation BeginTime="0:0:2.0"
                             FillBehavior="HoldEnd"
                             Storyboard.TargetName="fadeOutCtrl"
                             Storyboard.TargetProperty="Opacity"
                             From="0.9"
                             To="0"
                             Duration="0:0:1" />
        </Storyboard>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid x:Name="fadeOutCtrl"
              Grid.Row="0"
              Grid.Column="1"
              HorizontalAlignment="Center"
              VerticalAlignment="Bottom">
            <Border Width="366"
                    Height="135"
                    Background="{DynamicResource Default_SA_OSD_Border_BkColor}"
                    BorderBrush="#0DFFFFFF"
                    BorderThickness="1.5"
                    CornerRadius="5"
                    Opacity="0.9">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!--Close-->
                    <Canvas Grid.Row="0" Width="16" Height="16" Margin="0,10,10,0" 
                            HorizontalAlignment="Right" VerticalAlignment="Top" 
                            MouseLeftButtonDown="close_Click" 
                            Tag="{DynamicResource Default_SA_OSD_PathColor}">
                        <Path Data="M16,0.82 L15.18,0 L8,7.2 L0.82,0.05 L0,0.87 L7.15,8 L0.05,15.13 L0.87,16 L8,8.85 L15.13,16 L15.95,15.18 L8.8,8 L16,0.82 Z" 
                            Fill="{Binding Tag, RelativeSource={RelativeSource AncestorType=Canvas}}" />
                    </Canvas>
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50*" />
                            <RowDefinition Height="50*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   x:Name="ShowStringText"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Top"
                                   FontFamily="Roboto"
                                   Width="270"
                                   Height="40"
                                   TextWrapping="WrapWithOverflow"
                                   FontSize="14"
                                   FontWeight="Medium"
                                   Foreground="#FFFFFF"
                                   Text="{Binding [QAM_OSD_Msg], Source={x:Static lang:LangHelper.Instance}, Mode=OneWay}" />
                        <Button Grid.Row="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                FontFamily="Roboto"
                                Width="201"
                                Height="40"
                                FontSize="14"
                                FontWeight="Medium"
                                Foreground="#FFFFFF"
                                Background="#0672CB"
                                Content="{Binding [Go_to_Widget_Settings], Source={x:Static lang:LangHelper.Instance}, Mode=OneWay}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
