<Window x:Class="DDPM.OSDs.CollaborationNotAvailableWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lang="clr-namespace:DDPM.SA.Resources.Helper;assembly=DDPM.SA.Resources"
        AllowsTransparency="True"
        Background="Transparent"
        Loaded="Window_Loaded"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        mc:Ignorable="d">

    <Window.Resources>
        <Storyboard x:Key="FadeOut">
            <DoubleAnimation
            BeginTime="0:0:2.0"
            FillBehavior="HoldEnd"
            Storyboard.TargetName="fadeOutCtrl"
            Storyboard.TargetProperty="Opacity"
            From="0.9"
            To="0"
            Duration="0:0:1" />
        </Storyboard>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid
         Margin="0,50,0,0"
         x:Name="fadeOutCtrl"
         Grid.Row="0"
         Grid.Column="1"
         HorizontalAlignment="Center"
         VerticalAlignment="Bottom">

            <Border
             Width="332"
             Height="135"
             Background="{DynamicResource Default_SA_OSD_Border_BkColor}"
             BorderBrush="#0DFFFFFF"
             BorderThickness="1.5"
             CornerRadius="5"
             Opacity="0.9">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--Close-->
                    <Canvas Grid.Row="0" Width="20" Height="20" Margin="0,10,10,0" 
                         HorizontalAlignment="Right" VerticalAlignment="Top" 
                         MouseLeftButtonDown="close_Click"
                         Background="Transparent"
                         Tag="{DynamicResource Default_SA_OSD_PathColor}">
                        <Path Data="M16,0.82 L15.18,0 L8,7.2 L0.82,0.05 L0,0.87 L7.15,8 L0.05,15.13 L0.87,16 L8,8.85 L15.13,16 L15.95,15.18 L8.8,8 L16,0.82 Z" 
                         Fill="{Binding Tag, RelativeSource={RelativeSource AncestorType=Canvas}}" />
                    </Canvas>

                    <Grid Grid.Row="1">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="50*" />
                            <RowDefinition Height="50*" />
                        </Grid.RowDefinitions>

                        <!--Keyboard-->
                        <Canvas Grid.Row="0"
                         Width="50" Height="50"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Top"
                         Tag="{DynamicResource Default_SA_OSD_PathColor}">
                            <Path Data="M26.2812 14.6562V10.9062H27.6875C28.5163 10.9062 29.3112 10.577 29.8972 9.99096C30.4833 9.40491 30.8125 8.61005 30.8125 7.78125V3.125H27.4063V7.5625H26C25.1712 7.5625 24.3763 7.89174 23.7903 8.47779C23.2042 9.06384 22.875 9.8587 22.875 10.6875V14.6562H0V46.875H50V14.6562H26.2812ZM46.6562 43.4688H3.34375V18H46.6562V43.4688Z"
                           Fill="{Binding Tag, RelativeSource={RelativeSource AncestorType=Canvas}}" />
                            <Path Data="M7.84375 20.1562H12.7188V23.5H7.84375V20.1562Z"
                           Fill="{Binding Tag, RelativeSource={RelativeSource AncestorType=Canvas}}" />
                            <Path Data="M7.84375 26.0312H12.7188V29.3438H7.84375V26.0312Z"
                           Fill="{Binding Tag, RelativeSource={RelativeSource AncestorType=Canvas}}" />
                            <Path Data="M7.84375 31.8125H12.7188V35.1562H7.84375V31.8125Z"
                           Fill="{Binding Tag, RelativeSource={RelativeSource AncestorType=Canvas}}" />
                            <Path Data="M17.6562 20.1562H22.5312V23.5H17.6562V20.1562Z"
                           Fill="{Binding Tag, RelativeSource={RelativeSource AncestorType=Canvas}}" />
                            <Path Data="M17.6562 26.0312H22.5312V29.3438H17.6562V26.0312Z"
                           Fill="{Binding Tag, RelativeSource={RelativeSource AncestorType=Canvas}}" />
                            <Path Data="M17.6562 31.8125H22.5312V35.1562H17.6562V31.8125Z"
                           Fill="{Binding Tag, RelativeSource={RelativeSource AncestorType=Canvas}}" />
                            <Path Data="M27.4688 20.1562H32.3438V23.5H27.4688V20.1562Z"
                           Fill="{Binding Tag, RelativeSource={RelativeSource AncestorType=Canvas}}" />
                            <Path Data="M27.4688 26.0312H32.3438V29.3438H27.4688V26.0312Z"
                           Fill="{Binding Tag, RelativeSource={RelativeSource AncestorType=Canvas}}" />
                            <Path Data="M27.4688 31.8125H32.3438V35.1562H27.4688V31.8125Z"
                           Fill="{Binding Tag, RelativeSource={RelativeSource AncestorType=Canvas}}" />
                            <Path Data="M37.2812 20.1562H42.1562V23.5H37.2812V20.1562Z"
                           Fill="{Binding Tag, RelativeSource={RelativeSource AncestorType=Canvas}}" />
                            <Path Data="M37.2812 26.0312H42.1562V29.3438H37.2812V26.0312Z"
                           Fill="{Binding Tag, RelativeSource={RelativeSource AncestorType=Canvas}}" />
                            <Path Data="M37.2812 31.8125H42.1562V35.1562H37.2812V31.8125Z"
                           Fill="{Binding Tag, RelativeSource={RelativeSource AncestorType=Canvas}}" />
                            <Path Data="M15.3438 37.6562H34.625V41H15.3438V37.6562Z"
                           Fill="{Binding Tag, RelativeSource={RelativeSource AncestorType=Canvas}}" />
                        </Canvas>

                        <StackPanel
                         Grid.Row="1"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Orientation="Vertical">

                            <TextBlock
                             x:Name="ShowStringText"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             TextAlignment="Center"
                             FontFamily="Roboto"
                             FontSize="14"
                             FontWeight="Medium"
                             TextWrapping="Wrap"
                             Margin="48,16,48,32"
                             Foreground="{DynamicResource Default_SA_OSD_PathColor}"
                             Text="" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
