<Window x:Class="DDPM.OSDs.OSDMainWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DDPM.OSDs"
        AllowsTransparency="True"
        Background="Transparent"
        Loaded="Window_Loaded"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStyle="None"
        mc:Ignorable="d"
        Title="OSDMainWin">
    <Grid Margin="0,50,0,0">
        <ItemsControl Grid.Row="1" ItemsSource="{Binding OSDWins}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <local:AlignableWrapPanel HorizontalContentAlignment="Center" VerticalAlignment="Top"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type local:OSDUserControl}">
                    <local:OSDUserControl Margin="1,0,1,4" Width="332" Height="135"
                                 Closed="{Binding DataContext.OSDWinClosed,RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                 GUID="{Binding GUID}" OSDType="{Binding OSDType}" 
                                 ShowStringTitle="{Binding ShowStringTitle}" ShowStringContent="{Binding ShowStringContent}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
