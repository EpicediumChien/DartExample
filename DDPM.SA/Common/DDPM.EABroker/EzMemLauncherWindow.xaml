<Window x:Class="DDPM.EABroker.EzMemLauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DDPM.EABroker"
        mc:Ignorable="d"
        xmlns:lang="clr-namespace:DDPM.SA.Resources.Helper;assembly=DDPM.SA.Resources"
        WindowStartupLocation="Manual"
        AllowsTransparency="True" Topmost="True"
        WindowStyle="None" ResizeMode="NoResize" 
        Background="Transparent" ShowInTaskbar="False"
        Title="EzMemLauncherWindow" 
        Height="450" Width="800" 
        Loaded="Window_Loaded" ContentRendered="Window_ContentRendered">
    <Window.Resources>
        <!--<SolidColorBrush x:Key="Default_SA_OSD_Border_BkColor" Color="#141D28" />
        <SolidColorBrush x:Key="Default_SA_OSD_PathColor" Color="#FFFFFF" />-->

    </Window.Resources>
    <Grid>
        <ContentControl Name="splitCtrl" />
        <Border
                Width="304"
                Height="80" HorizontalAlignment="Right" VerticalAlignment="Top"
                Background="{DynamicResource Default_SA_OSD_Border_BkColor}"
                BorderBrush="#0DFFFFFF"
                BorderThickness="1.5"
                CornerRadius="5"
                Opacity="0.9">

            <Grid>

                <TextBlock
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="Roboto"
                        FontSize="40"
                        FontWeight="ExtraLight"
                        Foreground="{DynamicResource Default_SA_OSD_PathColor}"
                        Text="{Binding [Easy_Memory], Source={x:Static lang:LangHelper.Instance}, Mode=OneWay}" />
            </Grid>
        </Border>

    </Grid>
</Window>
