<Window x:Class="DDPM.EABroker.InfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DDPM.EABroker"
        mc:Ignorable="d"
        Title="InfoWindow" Height="300" Width="840" 
        Left="-99999" Top="-9999"
        ShowInTaskbar="False"
        Loaded="Window_Loaded" Unloaded="Window_Unloaded">
    <Window.Resources>
        <Style x:Key="InfoPropertyText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>

        <Style x:Key="InfoValueText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="DarkCyan"/>
        </Style>
        
    </Window.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- DashBoard -->
        <Grid Grid.Row="0">
            
        </Grid>
        <!-- TabControl -->
        <TabControl Grid.Row="1">
            <TabItem Header="General">
                
            </TabItem>
            
        </TabControl>
        
        <!-- Row 0: Window Moving info -->
        <StackPanel Grid.Row="0">
            <!-- Moving Window -->
            <WrapPanel>
                <TextBlock Text="Cursor(" />
                <TextBlock Text="{Binding xCursor}" />
                <TextBlock Text="," />
                <TextBlock Text="{Binding yCursor}" />
                <TextBlock Text="), " />
                <TextBlock Text="WorkScreen=" />
                <TextBlock Text="{Binding WorkScreenName}" />
                <TextBlock Text=", ScreenScale=" />
                <TextBlock Text="{Binding ScreenScale}" />
                <TextBlock Text=", " />
                <TextBlock Text="IsMoving=" />
                <TextBlock Text="{Binding IsMoving}" />

                <TextBlock Text=", hWndForeground=" />
                <TextBlock Text="{Binding hWndForeground}" />
                <TextBlock Text=", StartMovingMsg=" />
                <TextBlock Text="{Binding StartMovingMsg}" />
            </WrapPanel>
            <WrapPanel>
                <TextBlock Text="PathName=" />
                <TextBlock Text="{Binding PathNameForeground}" />
            </WrapPanel>
            <!-- EzSettings -->
            <WrapPanel>
                <TextBlock Text=", IsAwsEanbled="/>
                <TextBlock Text="{Binding IsAwsEnabled}" />
                <TextBlock Text=", IsOnlyShift=" />
                <TextBlock Text="{Binding IsOnlyShift}" />
                <TextBlock Text=", IsShiftPressed=" />
                <TextBlock Text="{Binding IsShiftPressed}" />
            </WrapPanel>
            <!-- Hovering -->
            <WrapPanel>
                <TextBlock Text=", HoveringWindow=" />
                <TextBlock Text="{Binding HoveringWindow}" />
                <TextBlock Text=", HoveringAwsIconText="/>
                <TextBlock Text="{Binding HoveringAwsIconText}"/>
                <TextBlock Text=", HoveringCell="/>
                <TextBlock Text="{Binding HoveringCell}"/>

            </WrapPanel>
            <!-- AWS Window -->
            <WrapPanel>
                <TextBlock Text=", IsAwsVisible=" />
                <TextBlock Text="{Binding IsAwsWindowVisible}" />
                <TextBlock Text=", AwsPos(" />
                <TextBlock Text="{Binding xAwsWindow}" />
                <TextBlock Text="," />
                <TextBlock Text="{Binding yAwsWindow}" />
                <TextBlock Text="), " />

            </WrapPanel>
            <!-- AwsBuddyWindow -->
            <WrapPanel>
                <TextBlock Text="IsAwsBuddyWindowVisible=" />
                <TextBlock Text="{Binding IsAwsBuddyWindowVisible}" />
                
            </WrapPanel>
        </StackPanel>
        <!-- Row 1: AWS Icons -->
        <StackPanel Grid.Row="1">
            <WrapPanel>
                <TextBlock Text="AwsIcon1:"/>
                <TextBlock Text="{Binding AwsIcon1Info}"/>
            </WrapPanel>
            <WrapPanel>
                <TextBlock Text="AwsIcon2:"/>
                <TextBlock Text="{Binding AwsIcon2Info}"/>
            </WrapPanel>
            <WrapPanel>
                <TextBlock Text="AwsIcon3:"/>
                <TextBlock Text="{Binding AwsIcon3Info}"/>
            </WrapPanel>
            <WrapPanel>
                <TextBlock Text="AwsIcon4:"/>
                <TextBlock Text="{Binding AwsIcon4Info}"/>
            </WrapPanel>
        </StackPanel>
        <!-- Row 2: WorkWindows -->
        <StackPanel Grid.Row="2">
            <WrapPanel>
                <TextBlock Text="WorkWindowCount="/>
                <TextBlock Text="{Binding WorkWindowUsedCount}"/>
                <TextBlock Text=", IsWorkUIEnabled=" />
                <TextBlock Text="{Binding IsWorkUIEnabled}" />
                <TextBlock Text=", IsWorkWindowVisible=" />
                <TextBlock Text="{Binding IsWorkWindowVisible}" />
            </WrapPanel>
            <ListBox ItemsSource="{Binding WorkWinCellInfos}"/>
        </StackPanel>
    </Grid>
</Window>
