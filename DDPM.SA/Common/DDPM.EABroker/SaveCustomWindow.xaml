<Window x:Class="DDPM.EABroker.SaveCustomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DDPM.EABroker"
        mc:Ignorable="d"
        Title="SaveCustomWindow" 
        MinHeight="196"
        d:DataContext="{DynamicResource vmDesign}"
        WindowStyle="None" ResizeMode="NoResize" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" AllowsTransparency="True" 
        SizeToContent="Height"
        Loaded="Window_Loaded" Unloaded="Window_Unloaded"
        >
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ComboBoxStyle.xaml" />
                <!--<ResourceDictionary Source="ButtonStyle.xaml" />-->
            </ResourceDictionary.MergedDictionaries>

            <Color x:Key="Color_FakeTransparent">#02000000</Color>
            <SolidColorBrush x:Key="FakeTransparent" Color="{StaticResource Color_FakeTransparent}" />

            <!-- Remove comment for design time test -->
            <!--<LinearGradientBrush x:Key="msgBoxGadientBrush" StartPoint="793,0" EndPoint="-69.2682,516.32"
                             MappingMode="Absolute">
                <GradientStop Color="#7F306CC7" Offset="0.0537435"/>
                <GradientStop Color="#7F0063B8" Offset="0.237111"/>
                <GradientStop Color="#1E003ACE" Offset="0.504036"/>
                <GradientStop Color="#7C674AB8" Offset="0.792288"/>
                <GradientStop Color="#7F0063B8" Offset="0.972444"/>
            </LinearGradientBrush>-->


            <local:SaveCustomWindowViewModel x:Key="vmDesign"  
                                             IsAdjustTextVisible="True"
                                             HeaderText="Arrange Windows" 
                                             SubText="Adjust your current window arrangement, edit the name (if desired), and click &#34;Save&#34; to store the arrangement."
                                             />
        </ResourceDictionary>
    </Window.Resources>

    <!-- Design time debug to use static data to show result in DesignView 
        Dark:
            Background="#F20D121A" BorderBrush="#293B4D"
        Light
            Background="FFFFFF" BorderBrush="#D8E1EB"
        Release:
            Background="{DynamicResource popupBase_Window_BkColor}" 
            BorderBrush="{DynamicResource popupBase_Window_BdColor}"
    -->
    <Border Width="420" BorderThickness="1" CornerRadius="4"
            Background="{DynamicResource popupBase_Window_BkColor}" 
            BorderBrush="{DynamicResource popupBase_Window_BdColor}"
            MouseLeftButtonDown="rootGrid_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="8" Color="#2D000000" Opacity="0.4"
                              Direction="315" ShadowDepth="3" />
        </Border.Effect>
        <Grid>
            <!-- Robert_Lin, 2024-12-2, use two layers in a Grid 
                    Layer 1 (Bottom): Rectangle with linear gradient brush 
                    Layer 2: Dialog body
                    Layer 3 (Top): CloseX button
            -->

            <!-- #region Layer 1 - Linear Gradient brush -->
            <Grid Background="{StaticResource msgBoxGadientBrush}" Opacity="0.15"/>
            <!-- #endregion Layer 1 - Linear Gradient brush -->

            <!-- #region Layer 2 - Dialog body-->
            <!-- Dialog body width is fixed (420) but height is depended on content, use a StakPanel as its container -->
            <StackPanel Margin="32">
                <!-- #region Layer2.HeaderText -->
                <!-- Design Time:
                Dark:
                           Foreground="#FFFFFF"/>
                Release:
                           Foreground="{DynamicResource popupBase_Header_TextColor}"/>
                -->
                <TextBlock x:Name="headerText" FontFamily="Roboto" FontSize="20" FontWeight="Normal"
                           Text="{Binding HeaderText}" Margin="0,0,0,8"
                           VerticalAlignment="Center" HorizontalAlignment="Left"
                           Foreground="{DynamicResource popupBase_Header_TextColor}"/>
                <!-- #edregion Layer2.HeaderText -->

                <!-- #region Layer2.SubText -->
                <!-- Design Time:
                Dark:
                          Foreground="#F5F6F7">
                Release:
                          Foreground="{DynamicResource popupBase_Body_TextColor}">
                -->
                <TextBlock x:Name="SubHeader1" FontFamily="Roboto" FontSize="16" FontWeight="Normal" Margin="0,8,0,16" TextWrapping="Wrap"
                          Text="{Binding SubText}"
                          VerticalAlignment="Top" HorizontalAlignment="Left"
                          Foreground="{DynamicResource popupBase_Body_TextColor}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAdjustTextVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!-- #endregion Layer2.SubText -->

                <!-- #region Layer2.ComboBox -->
                <ComboBox Name="cbNames" Height="40" Margin="0,8,0,16"
                        Style="{StaticResource DdpmComboBoxStyle}"
                        IsEditable="True" 
                        ItemsSource="{Binding CustomList}" 
                        DisplayMemberPath="CustomName"
                        SelectedItem="{Binding SelectedCustomItem, Mode=TwoWay}"
                        IsTextSearchEnabled="False" IsTextSearchCaseSensitive="False"
                        TextBoxBase.TextChanged="cbNames_TextChanged" 
                        IsReadOnly="{Binding IsComboBoxReadOnly}"
                        Loaded="cbNames_Loaded">
                    <ComboBox.Text>
                        <Binding Path="SelectedCustomItem.CustomName" Mode="TwoWay">
                            <Binding.ValidationRules>
                                <local:CustomNameValidationRule MaxChars="30"/>
                            </Binding.ValidationRules>
                        </Binding>
                    </ComboBox.Text>
                </ComboBox>
                <!-- #endregion Layer2.ComboBox -->

                <!-- #region Layer2.Buttons-->
                <StackPanel Orientation="Horizontal" Margin="0">
                    <Button Name="cancelBtn" Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Click="cancelButton_Click" />
                    <Button Name="saveBtn" Content="Save"  Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding IsSaveButtonEnabled}"
                                Margin="7,0,0,0" Click="saveButton_Click" />
                </StackPanel>
                <!-- #endregion Layer2.Buttons-->

            </StackPanel>
            <!-- #endregion Layer 2 - Dialog body-->

            <!-- #region Layer 3 - CloseX button -->
            <Grid Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,20,17,0"
                  Background="#02000000" MouseLeftButtonDown="closeX_MouseLeftButtonDown">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Background" Value="#02000000" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Dlg_CloseX_HoverBkColor}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <!-- DesignTime
                Dark:
                <Path Fill="#CCCCCC"
               
                Release:
                 <Path Fill="{DynamicResource popupBase_CloseX_FgColor}"
               -->
                <Path Fill="{DynamicResource popupBase_CloseX_FgColor}"
                     Data="M14 0.7175L13.2825 0L7 6.3L0.7175 0.04375L0 0.76125L6.25625 7L0.04375 13.2388L0.76125 14L7 7.74375L13.2388 14L13.9563 13.2825L7.7 7L14 0.7175Z"
                      />
            </Grid>
            <!-- #endregion Layer 3 - CloseX button -->
        </Grid>
    </Border>
    
