<Window x:Class="DDPM.EABroker.SaveCustomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DDPM.EABroker"
        mc:Ignorable="d"
        Title="SaveCustomWindow" 
        Width="420" MinHeight="196"
        d:DataContext="{DynamicResource vmDesign}"
        WindowStyle="None" ResizeMode="NoResize" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" AllowsTransparency="True" 
        Loaded="Window_Loaded"
        >
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ComboBoxStyle.xaml" />
                <ResourceDictionary Source="ButtonStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Color x:Key="Color_FakeTransparent">#02000000</Color>
            <SolidColorBrush x:Key="FakeTransparent" Color="{StaticResource Color_FakeTransparent}" />

            <local:SaveCustomWindowViewModel x:Key="vmDesign"  IsAdjustTextVisible="True"
                                             WindowTitle="Arrange Windows" 
                                             />
        </ResourceDictionary>
    </Window.Resources>

    <Window.Style>
        <Style TargetType="Window">
            <Setter Property="Height" Value="196"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOverlapLayout}" Value="True">
                    <Setter Property="Height" Value="284"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Style>
    <Grid MouseLeftButtonDown="rootGrid_MouseLeftButtonDown">
        <Border Name="saveCustomDlg" BorderBrush="#FF293B4D" BorderThickness="1" CornerRadius="4" 
                Background="#F20D121A">
            <Border.Effect>
                <DropShadowEffect BlurRadius="4" Direction="270" ShadowDepth="4" Color="Black" Opacity="0.6" />
            </Border.Effect>
            <Grid>
                <StackPanel Margin="32">
                    <Grid Height="28">
                        <TextBlock Name="txtCustomLayout" Text="{Binding WindowTitle}" FontFamily="Roboto" Foreground="White" FontSize="20"
                                   VerticalAlignment="Center" HorizontalAlignment="Left" />
                    </Grid>
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAdjustTextVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <TextBlock Name="txtAdjust" FontFamily="Roboto" Foreground="White" FontSize="16" Margin="0,8"
                                   TextWrapping="Wrap"
                                   Text="Adjust your current window arrangement, edit the name (if desired), and click &#34;Save&#34; to store the arrangement."/>
                    </Grid>
                    <ComboBox Name="cbNames" Height="40" Margin="0,8,0,16"
                              Style="{StaticResource DdpmComboBoxStyle}"
                              IsEditable="True" 
                              ItemsSource="{Binding CustomList}" 
                              DisplayMemberPath="CustomName"
                              SelectedItem="{Binding SelectedCustomItem, Mode=TwoWay}"
                              IsTextSearchEnabled="False" IsTextSearchCaseSensitive="False"
                              TextBoxBase.TextChanged="cbNames_TextChanged" 
                              IsReadOnly="{Binding IsComboBoxReadOnly}"
                              Loaded="cbNames_Loaded">
                        <ComboBox.Text>
                            <Binding Path="SelectedCustomItem.CustomName" Mode="TwoWay">
                                <Binding.ValidationRules>
                                    <local:CustomNameValidationRule MaxChars="30"/>
                                </Binding.ValidationRules>
                            </Binding>
                        </ComboBox.Text>
                   </ComboBox>

                    <StackPanel Orientation="Horizontal" Margin="0">
                        <Button Name="cancelBtn" Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Click="cancelButton_Click" />
                        <Button Name="saveBtn" Content="Save"  Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding IsSaveButtonEnabled}"
                                Margin="7,0,0,0" Click="saveButton_Click" />
                    </StackPanel>
                </StackPanel>
                <Grid Name="closeGrid" Width="14" Height="14" Margin="0,20,17,0" 
                      HorizontalAlignment="Right" VerticalAlignment="Top" MouseLeftButtonDown="closeGrid_MouseLeftButtonDown">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Background" Value="{StaticResource FakeTransparent}" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#33444E" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Path Data="M14 0.7175L13.2825 0L7 6.3L0.7175 0.04375L0 0.76125L6.25625 7L0.04375 13.2388L0.76125 14L7 7.74375L13.2388 14L13.9563 13.2825L7.7 7L14 0.7175Z">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Fill" Value="#FFCCCCCC"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=closeGrid, Path=IsMouseOver}" Value="True">
                                        <Setter Property="Fill" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>