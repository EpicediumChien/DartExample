<UserControl x:Class="DDPM.UI.Module.AddPen_Other.AddPen_OtherRightView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DDPM.UI.Module.AddPen_Other"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             xmlns:lang="clr-namespace:DDPM.UI.Resources.Helper;assembly=DDPM.UI.Resources"
             mc:Ignorable="d"
             xmlns:plugin="clr-namespace:DDPM.UI.Plugin.ViewModels;assembly=DDPM.UI.Plugin.Common"
             d:DesignHeight="527" d:DesignWidth="958"
             SizeChanged="UserControl_SizeChanged"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!--<ResourceDictionary Source="/DDPM.UI.Common;component/ModuleStyle.xaml" />-->
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="TextStyle1" TargetType="UXControls:UXTextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AddDeviceTxtCaption_TxtColor}" />
        <Setter Property="FontFamily" Value="Roboto" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LineHeight" Value="24" />
        <Setter Property="TextWrapping" Value="WrapWithOverflow" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="6,0,6,25"/>
      </Style>
      <Style x:Key="Border1" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AddDeviceBorder1_BgColor}" />
        <Setter Property="CornerRadius" Value="13" />
        <!--Setter Property="Width" Value="459" /-->
        <!--Setter Property="Height" Value="240" /-->
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border1BorderBrush}" />
        <Setter Property="Margin" Value="7,7,0,7"/>
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid>
    <UXControls:UXScrollViewer>
      <Border StylusDown="Pairing" Background="Transparent">
        <StackPanel Orientation="Vertical">
          <UXControls:UXTextBlock Name="txtOther" FontFamily="Roboto" FontSize="20" FontWeight="Normal"
                                            Focusable="True" KeyboardNavigation.TabIndex="31"
                              Margin="18,14,0,0" Foreground="{DynamicResource AddDeviceTxtCaption_TxtColor}" VerticalAlignment="Top" HorizontalAlignment="Left" />
          <UXControls:UXTextBlock Name="txtCaption" FontFamily="Roboto" FontSize="14" FontWeight="Normal"
                                            Focusable="True" KeyboardNavigation.TabIndex="32"
                                    Margin="18,14,0,0" Foreground="{DynamicResource AddDeviceTxtCaption_TxtColor}" VerticalAlignment="Top" HorizontalAlignment="Left" Text="{Binding [AddDevice.Pen.5], Source={x:Static lang:LangHelper.Instance}}"/>
          <StackPanel Orientation="Horizontal" Margin="18,25,0,0" x:Name="stepsStackPanel" HorizontalAlignment="Left">
            <Border Style="{StaticResource Border1}" x:Name="stepsBorder1" Margin="0,0,0,7" HorizontalAlignment="Left">
              <StackPanel Orientation="Vertical">
                <Image Margin="14,14" Source="/DDPM.UI.Resources;component/Resources/Images/Stylus.png" Stretch="Uniform"
                               HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="" Width="46" Height="46" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <UXControls:UXTextBlock Text="1." Margin="20,0,0,0" Style="{StaticResource TextStyle1}" />
                  <UXControls:UXTextBlock Name="txtStep1" Style="{StaticResource TextStyle1}" 
                                                            Focusable="True" KeyboardNavigation.TabIndex="33"/>
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Border1}" x:Name="stepsBorder2" Margin="7,0,0,7" HorizontalAlignment="Left">
              <StackPanel Orientation="Vertical">
                <Image Margin="14,14" Source="/DDPM.UI.Resources;component/Resources/Images/CheckOK.png" Stretch="Uniform"
                               HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="" Width="46" Height="46" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <UXControls:UXTextBlock Text="2." Margin="20,0,0,0" Style="{StaticResource TextStyle1}" />
                  <UXControls:UXTextBlock Name="txtStep2" Style="{StaticResource TextStyle1}" 
                                                            Text="{Binding [AddDevice.Pen.4], Source={x:Static lang:LangHelper.Instance}}"
                                                            Focusable="True" KeyboardNavigation.TabIndex="34"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </Border>
    </UXControls:UXScrollViewer>
  </Grid>
</UserControl>