<UserControl x:Class="DDPM.UI.Module.HeadsetAutomatedActions.HeadsetAutomatedActionsRightView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DDPM.UI.Module.HeadsetAutomatedActions"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             xmlns:plugin="clr-namespace:DDPM.UI.Plugin.ViewModels;assembly=DDPM.UI.Plugin.Common"
             xmlns:PluginCommon="clr-namespace:DDPM.UI.Plugin.Common;assembly=DDPM.UI.Plugin.Common"
             xmlns:lang="clr-namespace:DDPM.UI.Resources.Helper;assembly=DDPM.UI.Resources"
             d:DataContext="{d:DesignInstance Type=plugin:HeadsetViewModel}"
             xmlns:common="clr-namespace:DDPM.UI.Common;assembly=DDPM.UI.Common"
             mc:Ignorable="d"
             d:DesignHeight="655" d:DesignWidth="520" VerticalAlignment="Top" HorizontalAlignment="Left">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DDPM.UI.Common;component/PluginStyles.xaml" />
                <ResourceDictionary Source="/DDPM.UI.Common;component/ModuleStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <ImageBrush x:Key="UnselectedNodeImage" ImageSource="pack://application:,,,/DDPM.UI.Common;component/Resources/Headset_Dot.png" />
            <ImageBrush x:Key="SelectedNodeImage" ImageSource="pack://application:,,,/DDPM.UI.Common;component/Resources/Headset_whitedot.png" />

            <SolidColorBrush x:Key="SplitItem_BkColor" Color="#FF132F54" />
            <SolidColorBrush x:Key="SplitItem_NormalBdColor" Color="#FF0B1E38" />
            <SolidColorBrush x:Key="SplitItem_SelectedColor" Color="#FF5CC1EE" />

            <LinearGradientBrush x:Key="SplitItem_HoverBdColor" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#FF0672CB" />
                <GradientStop Offset="0.5" Color="#FF0078D4" />
                <GradientStop Offset="1" Color="#FF6E69CF" />
            </LinearGradientBrush>

            <!-- Border Style of Normal State -->
            <Style x:Key="SplitItemBorder_Normal" TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource SplitItem_NormalBdColor}" />
                <Setter Property="BorderThickness" Value="4" />
                <Setter Property="Padding" Value="0" />
            </Style>

            <!-- Border Style of Hover State -->
            <Style x:Key="SplitItemBorder_Hover" TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource SplitItem_HoverBdColor}" />
                <Setter Property="BorderThickness" Value="4" />
                <Setter Property="Padding" Value="0" />
            </Style>

            <!-- Border Style of Selected State -->
            <Style x:Key="SplitItemBorder_Selected" TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource SplitItem_SelectedColor}" />
                <Setter Property="BorderThickness" Value="1.5" />
            </Style>

            <Style x:Key="CollaborationButtonPressedStyle" TargetType="UXControls:UXButton">
                <Setter Property="BorderBrush" Value="{StaticResource SplitItem_HoverBdColor}" />
            </Style>

            <Style x:Key="DotStyle" TargetType="Ellipse">
                <Setter Property="Fill" Value="Blue" />
                <Setter Property="Width" Value="10" />
                <Setter Property="Height" Value="10" />
            </Style>

            <Style x:Key="LineStyle" TargetType="Path">
                <Setter Property="Stroke" Value="Blue" />
                <Setter Property="StrokeThickness" Value="2" />
            </Style>

            <LinearGradientBrush x:Key="GradientBrush" StartPoint="0,0" EndPoint="0,0.4">
                <GradientStop Color="Transparent" Offset="0.5" />
                <GradientStop Color="#0672CB" Offset="0" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="NormalBackground" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#0B1E38" Offset="0.0" />
                <GradientStop Color="#0B1E38" Offset="1.0" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="PressedBackground" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#0672CB" Offset="0.0" />
                <GradientStop Color="#0078D4" Offset="0.46" />
                <GradientStop Color="#6E69CF" Offset="1.1831" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="PressedBorderBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#55B4FD" Offset="0.0045" />
                <GradientStop Color="#6E69CF" Offset="1.0" />
            </LinearGradientBrush>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <local:BooleanToForegroundConverter x:Key="BooleanToForegroundConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Border x:Name="MainBorder" Background="#99132F54" CornerRadius="13" Width="520" Height="655" Margin="0,10,0,0">
            <StackPanel x:Name="MainStackPanel" Orientation="Vertical" Margin="16">
                <Grid>
                    <UXControls:UXTextBlock x:Name="txtCaption" Style="{StaticResource ModuleCaptionStyle}" Text="{Binding [AutomatedActions], Source={x:Static lang:LangHelper.Instance}}" FontFamily="Roboto" FontSize="20" Foreground="White" Height="28" Width="200" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,20,20,20" />
                </Grid>
                <Grid x:Name="WearDetectionGrid" Visibility="{Binding WearDetectionPageShow, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Top" Margin="0,0,0,15">
                    <Border x:Name="MainContentBorder" Background="#99132F54" CornerRadius="6" Width="488" Height="auto" VerticalAlignment="Top" Margin="0,0,0,0">
                        <StackPanel x:Name="MainContentStackPanel" Orientation="Vertical" Margin="0,20,0,10">
                            <!-- Wear Detection -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <UXControls:UXTextBlock x:Name="WearDetectionText" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="16" Foreground="White" Text="Wear Detection" Margin="18,0,0,0" />
                                <Image x:Name="WearDetectionImage" Grid.Column="1" Width="16" Height="16" Margin="9,0,0,0" Source="/DDPM.UI.Common;component/Resources/info.png" Stretch="Uniform">
                                    <Image.ToolTip>
                                        <ToolTip x:Name="WearDetectionToolTip" Style="{StaticResource InfoToolTipStyle}" Placement="Top" VerticalOffset="8" HorizontalOffset="6">
                                            <TextBlock x:Name="WearDetectionToolTipText" Style="{StaticResource TabInfoToolTipTextStyle}" Text="{Binding WearDetectionToolTip}" />
                                        </ToolTip>
                                    </Image.ToolTip>
                                </Image>
                                <UXControls:UXToggleSwitch x:Name="WearDetectionToggleSwitch" FontSize="16" Foreground="White" Content="{Binding Path=WearDetection_String, FallbackValue='OFF'}" IsChecked="{Binding Path=WearDetectionStatus}" IsEnabled="{Binding Path=SupportedWearDetection}" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" VerticalContentAlignment="Center" Margin="8" />
                            </Grid>

                            <!-- Second Type Page -->
                            <Grid Visibility="{Binding AutomatedActionsSensitivityUpPageShow, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border x:Name="SubContentBorder2" Grid.Row="0" Background="#99132F54" CornerRadius="6" Width="456" VerticalAlignment="Top" Margin="0,20,0,20">
                                    <Grid x:Name="SubContentGrid2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <UXControls:UXTextBlock x:Name="Sensitivity2TextBlock" Foreground="White" Text="Sensitivity"  FontSize="14" Margin="20,20,0,8" />
                                        <StackPanel x:Name="Sensitivity2StackPanel" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="16,0,0,8">
                                            <UXControls:UXToggleSwitch x:Name="LowButton" BorderBrush="#FF1E3F6C" BorderThickness="1.5" Width="208" Height="52" Margin="0,0,4,8" Background="{StaticResource SplitItem_NormalBdColor}" IsEnabled="{Binding ElementName=WearDetectionToggleSwitch, Path=IsChecked}" IsChecked="{Binding IsLowChecked, Mode=TwoWay}">
                                                <UXControls:UXToggleSwitch.Template>
                                                    <ControlTemplate TargetType="UXControls:UXToggleSwitch">
                                                        <Border x:Name="LowButtonBorder" Background="{StaticResource NormalBackground}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4,4,4,4">
                                                            <Grid>
                                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <UXControls:UXTextBlock Text="Low" FontSize="14" Foreground="White" TextAlignment="Center" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="LowButtonBorder" Property="Background" Value="{StaticResource PressedBackground}" />
                                                                <Setter TargetName="LowButtonBorder" Property="BorderBrush" Value="{StaticResource PressedBorderBrush}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </UXControls:UXToggleSwitch.Template>
                                            </UXControls:UXToggleSwitch>
                                            <UXControls:UXToggleSwitch x:Name="Normal2Button" BorderBrush="#FF1E3F6C" BorderThickness="1.5" Width="208" Height="52" Margin="4,0,0,8" Background="{StaticResource SplitItem_NormalBdColor}" IsEnabled="{Binding ElementName=WearDetectionToggleSwitch, Path=IsChecked}" IsChecked="{Binding IsNormal2Checked, Mode=TwoWay}">
                                                <UXControls:UXToggleSwitch.Template>
                                                    <ControlTemplate TargetType="UXControls:UXToggleSwitch">
                                                        <Border x:Name="Normal2ButtonBorder" Background="{StaticResource NormalBackground}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4,4,4,4">
                                                            <Grid>
                                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <UXControls:UXTextBlock Text="Normal" FontSize="14" Foreground="White" TextAlignment="Center" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="Normal2ButtonBorder" Property="Background" Value="{StaticResource PressedBackground}" />
                                                                <Setter TargetName="Normal2ButtonBorder" Property="BorderBrush" Value="{StaticResource PressedBorderBrush}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </UXControls:UXToggleSwitch.Template>
                                            </UXControls:UXToggleSwitch>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Grid Visibility="{Binding AutomatedActionsWhenHeadsetIsRemovedPageShow, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Border x:Name="SubContentBorder" Background="#99132F54" CornerRadius="6" Width="456" VerticalAlignment="Top">
                                    <StackPanel x:Name="SubContentStackPanel" Orientation="Vertical">
                                        <UXControls:UXTextBlock x:Name="WhenHeadsetIsRemovedText" Style="{StaticResource ModuleItemStyle}" Foreground="{Binding IsChecked, ElementName=WearDetectionToggleSwitch, Converter={StaticResource BooleanToForegroundConverter}}" Text="When headset is removed:" Margin="20" FontSize="14" />
                                        <!-- Pause Music -->
                                        <Grid x:Name="PauseMusicGrid">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <UXControls:UXTextBlock x:Name="PauseMusicText" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="16" Foreground="{Binding IsChecked, ElementName=WearDetectionToggleSwitch, Converter={StaticResource BooleanToForegroundConverter}}" Text="Pause Music" Margin="20,0,0,0" />
                                            <Image x:Name="PauseMusicImage" Grid.Column="1" Width="16" Height="16" Margin="8" Source="/DDPM.UI.Common;component/Resources/info.png" Stretch="Uniform">
                                                <Image.ToolTip>
                                                    <ToolTip x:Name="PauseMusicToolTip" Style="{StaticResource InfoToolTipStyle}" Placement="Top" VerticalOffset="8" HorizontalOffset="6">
                                                        <TextBlock x:Name="PauseMusicToolTipText" Style="{StaticResource TabInfoToolTipTextStyle}" Text="{Binding PauseMusicToolTip}" />
                                                    </ToolTip>
                                                </Image.ToolTip>
                                            </Image>
                                            <UXControls:UXToggleSwitch x:Name="PauseMusicToggleSwitch" FontSize="16" Foreground="White" Content="{Binding Path=PauseMusic_String, FallbackValue='OFF'}" IsChecked="{Binding Path=PauseMusicStatus}" IsEnabled="{Binding ElementName=WearDetectionToggleSwitch, Path=IsChecked}" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,20,0" />
                                        </Grid>

                                        <!-- Mute Microphone -->
                                        <Grid x:Name="MuteMicrophoneGrid" Height="50">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <UXControls:UXTextBlock x:Name="MuteMicrophoneText" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="16" Foreground="{Binding IsChecked, ElementName=WearDetectionToggleSwitch, Converter={StaticResource BooleanToForegroundConverter}}" Text="Mute Microphone" Margin="20,0,0,0" />
                                            <Image x:Name="MuteMicrophoneImage" Grid.Column="1" Width="16" Height="16" Margin="8" Source="/DDPM.UI.Common;component/Resources/info.png" Stretch="Uniform">
                                                <Image.ToolTip>
                                                    <ToolTip x:Name="MuteMicrophoneToolTip" Style="{StaticResource InfoToolTipStyle}" Placement="Top" VerticalOffset="8" HorizontalOffset="6">
                                                        <TextBlock x:Name="MuteMicrophoneToolTipText" Style="{StaticResource TabInfoToolTipTextStyle}" Text="{Binding MuteMicrophoneToolTip}" />
                                                    </ToolTip>
                                                </Image.ToolTip>
                                            </Image>
                                            <UXControls:UXToggleSwitch x:Name="MuteMicrophoneToggleSwitch" FontSize="16" Foreground="White" Content="{Binding Path=MuteMicrophone_String, FallbackValue='OFF'}" IsChecked="{Binding Path=MuteMicrophoneStatus}" IsEnabled="{Binding ElementName=WearDetectionToggleSwitch, Path=IsChecked}" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,20,0" />
                                        </Grid>

                                        <Line x:Name="SeparatorLine" X1="0" Y1="0" X2="456" Y2="0" Stroke="#1E3F6C" StrokeThickness="1" HorizontalAlignment="Center" Margin="18,16,0,16" />

                                        <!-- Quick Pause -->
                                        <Grid x:Name="QuickPauseGrid" Visibility="{Binding AutomatedActionsQuickPausePageShow, Converter={StaticResource BooleanToVisibilityConverter}}" Height="50">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <UXControls:UXTextBlock x:Name="QuickPauseText" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="16" Foreground="{Binding IsChecked, ElementName=WearDetectionToggleSwitch, Converter={StaticResource BooleanToForegroundConverter}}" Text="Quick Pause" Margin="20,0,0,0" />
                                            <Image x:Name="QuickPauseImage" Grid.Column="1" Width="16" Height="16" Margin="8" Source="/DDPM.UI.Common;component/Resources/info.png" Stretch="Uniform">
                                                <Image.ToolTip>
                                                    <ToolTip x:Name="QuickPauseToolTip" Style="{StaticResource InfoToolTipStyle}" Placement="Top" VerticalOffset="8" HorizontalOffset="6">
                                                        <TextBlock x:Name="QuickPauseToolTipText" Style="{StaticResource TabInfoToolTipTextStyle}" Text="{Binding QuickPauseToolTip}" />
                                                    </ToolTip>
                                                </Image.ToolTip>
                                            </Image>
                                            <UXControls:UXToggleSwitch x:Name="QuickPauseToggleSwitch" FontSize="16" Foreground="White" Content="{Binding Path=QuickPause_String, FallbackValue='OFF'}" IsChecked="{Binding Path=QuickPauseStatus}" IsEnabled="{Binding ElementName=WearDetectionToggleSwitch, Path=IsChecked}" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,20,0" />
                                        </Grid>
                                        <!-- SensitivityText -->
                                        <Grid x:Name="SensitivityTextGrid" Visibility="{Binding AutomatedActionsSensitivityPageShow, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,0">
                                            <UXControls:UXTextBlock x:Name="SensitivityTextBlock" Text="Sensitivity" Foreground="{Binding IsChecked, ElementName=WearDetectionToggleSwitch, Converter={StaticResource BooleanToForegroundConverter}}" FontSize="14" Margin="20,0,0,0" />
                                            <StackPanel x:Name="SensitivityStackPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                                <UXControls:UXToggleSwitch x:Name="NormalButton" BorderBrush="#FF1E3F6C" BorderThickness="1.5" Width="208" Height="52" Margin="0,20,0,20" Background="{StaticResource SplitItem_NormalBdColor}" IsEnabled="{Binding ElementName=WearDetectionToggleSwitch, Path=IsChecked}" IsChecked="{Binding IsNormalChecked, Mode=TwoWay}">
                                                    <UXControls:UXToggleSwitch.Template>
                                                        <ControlTemplate TargetType="UXControls:UXToggleSwitch">
                                                            <Border x:Name="NormalButtonBorder" Background="{StaticResource NormalBackground}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4,4,4,4">
                                                                <Grid>
                                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <UXControls:UXTextBlock Text="Normal" FontSize="14" Foreground="{Binding IsChecked, ElementName=WearDetectionToggleSwitch, Converter={StaticResource BooleanToForegroundConverter}}" TextAlignment="Center" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="NormalButtonBorder" Property="Background" Value="{StaticResource PressedBackground}" />
                                                                    <Setter TargetName="NormalButtonBorder" Property="BorderBrush" Value="{StaticResource PressedBorderBrush}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </UXControls:UXToggleSwitch.Template>
                                                </UXControls:UXToggleSwitch>
                                                <UXControls:UXToggleSwitch x:Name="SensitiveButton" BorderBrush="#FF1E3F6C" BorderThickness="1.5" Width="208" Height="52" Margin="8,0,0,0" Background="{StaticResource SplitItem_NormalBdColor}" IsEnabled="{Binding ElementName=WearDetectionToggleSwitch, Path=IsChecked}" IsChecked="{Binding IsSensitiveChecked, Mode=TwoWay}">
                                                    <UXControls:UXToggleSwitch.Template>
                                                        <ControlTemplate TargetType="UXControls:UXToggleSwitch">
                                                            <Border x:Name="SensitiveButtonBorder" Background="{StaticResource NormalBackground}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4,4,4,4">
                                                                <Grid>
                                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <UXControls:UXTextBlock Text="Sensitive" FontSize="14" Foreground="{Binding IsChecked, ElementName=WearDetectionToggleSwitch, Converter={StaticResource BooleanToForegroundConverter}}" TextAlignment="Center" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="SensitiveButtonBorder" Property="Background" Value="{StaticResource PressedBackground}" />
                                                                    <Setter TargetName="SensitiveButtonBorder" Property="BorderBrush" Value="{StaticResource PressedBorderBrush}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </UXControls:UXToggleSwitch.Template>
                                                </UXControls:UXToggleSwitch>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Answer Calls Page -->
                <Grid Visibility="{Binding AutomatedActionsAnswerCallPageShow, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border x:Name="SubContentBorder4" Grid.Row="0" Background="#99132F54" CornerRadius="6" Width="488" Height="72" VerticalAlignment="Top" Margin="0,0,0,20">
                        <Grid x:Name="AnswerCallsGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <UXControls:UXTextBlock x:Name="AnswerCallsText" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="16" Foreground="White" Text="Answer Calls" Margin="20,20,0,20" />
                            <Image x:Name="AnswerCallsImage" Grid.Column="1" Width="16" Height="16" Margin="8,0,0,0" Source="/DDPM.UI.Common;component/Resources/info.png" Stretch="Uniform">
                                <Image.ToolTip>
                                    <ToolTip x:Name="AnswerCallsToolTip" Style="{StaticResource InfoToolTipStyle}" Placement="Top" VerticalOffset="8" HorizontalOffset="6">
                                        <TextBlock x:Name="AnswerCallsToolTipText" Style="{StaticResource TabInfoToolTipTextStyle}" Text="{Binding AnswerCallsToolTip}" />
                                    </ToolTip>
                                </Image.ToolTip>
                            </Image>
                            <UXControls:UXToggleSwitch x:Name="AnswerCallsToggleSwitch" FontSize="16" Foreground="White" Content="{Binding Path=AnswerCalls_String, FallbackValue='OFF'}" IsChecked="{Binding Path=AnswerCallsStatus}" IsEnabled="{Binding Path=SupportedAnswerCalls}" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" VerticalContentAlignment="Center" Margin="20" />
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>