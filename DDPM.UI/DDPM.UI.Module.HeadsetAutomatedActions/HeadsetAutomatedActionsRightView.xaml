<UserControl x:Class="DDPM.UI.Module.HeadsetAutomatedActions.HeadsetAutomatedActionsRightView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DDPM.UI.Module.HeadsetAutomatedActions"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             xmlns:plugin="clr-namespace:DDPM.UI.Plugin.ViewModels;assembly=DDPM.UI.Plugin.Common"
             xmlns:PluginCommon="clr-namespace:DDPM.UI.Plugin.Common;assembly=DDPM.UI.Plugin.Common"
             xmlns:lang="clr-namespace:DDPM.UI.Resources.Helper;assembly=DDPM.UI.Resources"
             d:DataContext="{d:DesignInstance Type=plugin:HeadsetViewModel}"
             xmlns:common="clr-namespace:DDPM.UI.Common;assembly=DDPM.UI.Common"
             mc:Ignorable="d"
             d:DesignHeight="655" d:DesignWidth="520">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!--<ResourceDictionary Source="/DDPM.UI.Common;component/PluginStyles.xaml" />-->
        <!-- <ResourceDictionary Source="/DDPM.UI.Common;component/ModuleStyle.xaml" /> -->
      </ResourceDictionary.MergedDictionaries>

      <ImageBrush x:Key="UnselectedNodeImage" ImageSource="pack://application:,,,/DDPM.UI.Common;component/Resources/Headset_Dot.png" />
      <ImageBrush x:Key="SelectedNodeImage" ImageSource="pack://application:,,,/DDPM.UI.Common;component/Resources/Headset_whitedot.png" />

      <SolidColorBrush x:Key="SplitItem_BkColor" Color="#FF132F54" />
      <SolidColorBrush x:Key="SplitItem_NormalBdColor" Color="#FF0B1E38" />
      <SolidColorBrush x:Key="SplitItem_SelectedColor" Color="#FF5CC1EE" />

      <LinearGradientBrush x:Key="SplitItem_HoverBdColor" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FF0672CB" />
        <GradientStop Offset="0.5" Color="#FF0078D4" />
        <GradientStop Offset="1" Color="#FF6E69CF" />
      </LinearGradientBrush>

      <!-- Border Style of Normal State -->
      <Style x:Key="SplitItemBorder_Normal" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource SplitItem_NormalBdColor}" />
        <Setter Property="BorderThickness" Value="4" />
        <Setter Property="Padding" Value="0" />
      </Style>

      <!-- Border Style of Hover State -->
      <Style x:Key="SplitItemBorder_Hover" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource SplitItem_HoverBdColor}" />
        <Setter Property="BorderThickness" Value="4" />
        <Setter Property="Padding" Value="0" />
      </Style>

      <!-- Border Style of Selected State -->
      <Style x:Key="SplitItemBorder_Selected" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource SplitItem_SelectedColor}" />
        <Setter Property="BorderThickness" Value="1.5" />
      </Style>

      <Style x:Key="CollaborationButtonPressedStyle" TargetType="UXControls:UXButton">
        <Setter Property="BorderBrush" Value="{StaticResource SplitItem_HoverBdColor}" />
      </Style>

      <Style x:Key="DotStyle" TargetType="Ellipse">
        <Setter Property="Fill" Value="Blue" />
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
      </Style>

      <Style x:Key="LineStyle" TargetType="Path">
        <Setter Property="Stroke" Value="Blue" />
        <Setter Property="StrokeThickness" Value="2" />
      </Style>

      <LinearGradientBrush x:Key="GradientBrush" StartPoint="0,0" EndPoint="0,0.4">
        <GradientStop Color="Transparent" Offset="0.5" />
        <GradientStop Color="#0672CB" Offset="0" />
      </LinearGradientBrush>

      <LinearGradientBrush x:Key="NormalBackground" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#0B1E38" Offset="0.0" />
        <GradientStop Color="#0B1E38" Offset="1.0" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="PressedBackground" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#0672CB" Offset="0.0" />
        <GradientStop Color="#0078D4" Offset="0.46" />
        <GradientStop Color="#6E69CF" Offset="1.1831" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="PressedBorderBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#55B4FD" Offset="0.0045" />
        <GradientStop Color="#6E69CF" Offset="1.0" />
      </LinearGradientBrush>

      <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
      <local:BooleanToForegroundConverter x:Key="BooleanToForegroundConverter" />
      <local:BooleanToForegroundConverter2 x:Key="BooleanToForegroundConverter2" />
      <local:BooleanToForegroundConverter3 x:Key="BooleanToForegroundConverter3" />
      <local:BooleanToForegroundConverter4 x:Key="BooleanToForegroundConverter4" />
      <local:BooleanToOpacityConverter x:Key="BooleanToOpacityConverter" />
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid>
    <!--Elsa 20250331 for PIMS-348388 change Width="520" to Width="auto" Margin="0,10,10,0" to Margin="0,10,16,16" -->
    <Border x:Name="MainBorder" Style="{DynamicResource RightGroupBorderStyleForAudio}" CornerRadius="13" Width="auto" Height="auto" Margin="0,10,16,16">
      <StackPanel x:Name="MainStackPanel" Orientation="Vertical" Margin="16">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
          </Grid.ColumnDefinitions>
          <UXControls:UXTextBlock Grid.Column="0" x:Name="txtCaption" Style="{StaticResource ModuleCaptionStyle}" Text="{Binding [AutomatedActions], Source={x:Static lang:LangHelper.Instance}}" FontFamily="Roboto" FontSize="20" Foreground="{DynamicResource TextBlock_ForegroundColor}" Height="28" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,20,20,20" />
          <Image Name="LockIconMic" Visibility="{Binding isWearLocked}" Grid.Column="1" Margin="0,0,0,5"
                           Source="pack://application:,,,/DDPM.UI.Common;component/Resources/Lock.png"
                           VerticalAlignment="Center" HorizontalAlignment="Center" Width="16" Height="16">
            <Image.ToolTip>
              <ToolTip>
                <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                  <Border.Resources>
                    <Style BasedOn="{StaticResource Tooltip_TextBlockStyle}" TargetType="TextBlock" />
                  </Border.Resources>
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding [ITLockToolTip.0], Source={x:Static lang:LangHelper.Instance}}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </ToolTip>
            </Image.ToolTip>
          </Image>
        </Grid>
        <Grid x:Name="WearDetectionGrid" Visibility="{Binding WearDetectionPageShow, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Top" Margin="0,0,0,15">
          <Border x:Name="MainContentBorder" Style="{DynamicResource RightGroupBorderStyleForAudio}" CornerRadius="6" Width="488" Height="auto" VerticalAlignment="Top" Margin="0,0,0,0">
            <StackPanel x:Name="MainContentStackPanel" Orientation="Vertical" Margin="0,20,0,10">
              <!-- Wear Detection -->
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <UXControls:UXTextBlock x:Name="WearDetectionText" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="16" Foreground="{DynamicResource TextBlock_ForegroundColor}" Text="{Binding [HeadsetAutomatedActions.0], Source={x:Static lang:LangHelper.Instance}}" Margin="18,0,0,0" />
                <Image x:Name="WearDetectionImage" Grid.Column="1" Width="16" Height="16" Margin="9,0,0,0" Source="/DDPM.UI.Common;component/Resources/info.png" Stretch="Uniform">
                  <Image.ToolTip>
                    <ToolTip Placement="Top" VerticalOffset="18" HorizontalOffset="6">
                      <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                        <Border.Resources>
                          <Style BasedOn="{StaticResource Tooltip_TextBlockStyle}" TargetType="TextBlock" />
                        </Border.Resources>
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding WearDetectionToolTip}" TextWrapping="WrapWithOverflow"/>
                        </StackPanel>
                      </Border>
                    </ToolTip>
                  </Image.ToolTip>
                </Image>
                <UXControls:UXToggleSwitch x:Name="WearDetectionToggleSwitch" FontSize="16" Foreground="{DynamicResource TextBlock_ForegroundColor}" Content="{Binding Path=WearDetection_String, FallbackValue='OFF'}" IsChecked="{Binding Path=WearDetectionStatus}" IsEnabled="{Binding Path=SupportedWearDetection}" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" VerticalContentAlignment="Center" Margin="8" IsTabStop="{Binding isWearTabStopped}"/>
              </Grid>

              <!-- Second Type Page -->
              <Grid Visibility="{Binding AutomatedActionsSensitivityUpPageShow, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border x:Name="SubContentBorder2" Grid.Row="0" Style="{DynamicResource RightGroupBorderStyleForAudio}" CornerRadius="6" Width="456" VerticalAlignment="Top" Margin="0,20,0,20">
                  <Grid x:Name="SubContentGrid2">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!--<UXControls:UXTextBlock x:Name="Sensitivity2TextBlock" Foreground="{DynamicResource TextBlock_ForegroundColor}" Text="{Binding [HeadsetAutomatedActions.14], Source={x:Static lang:LangHelper.Instance}}"  FontSize="14" Margin="20,20,0,8" />-->
                    <UXControls:UXTextBlock x:Name="Sensitivity2TextBlock" FontSize="14" Margin="20,20,0,8">
                      <UXControls:UXTextBlock.Opacity>
                        <MultiBinding Converter="{StaticResource BooleanToOpacityConverter}">
                          <Binding Path="IsChecked" ElementName="WearDetectionToggleSwitch" />
                        </MultiBinding>
                      </UXControls:UXTextBlock.Opacity>
                      <!--<UXControls:UXTextBlock.Foreground>
                                                <MultiBinding Converter="{StaticResource BooleanToForegroundConverter}">
                                                    <Binding Path="IsChecked" ElementName="WearDetectionToggleSwitch" />
                                                    <Binding Path="IsDarkTheme" />
                                                </MultiBinding>
                                            </UXControls:UXTextBlock.Foreground>-->
                      <UXControls:UXTextBlock.Text>
                        <Binding Path="[HeadsetAutomatedActions.14]" Source="{x:Static lang:LangHelper.Instance}" />
                      </UXControls:UXTextBlock.Text>
                    </UXControls:UXTextBlock>
                    <StackPanel x:Name="Sensitivity2StackPanel" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="16,0,0,8">
                      <UXControls:UXToggleSwitch x:Name="LowButton" BorderThickness="1.5" BorderBrush="{DynamicResource ToggleSwitch_NormalBorderBrush}" Background="{DynamicResource ToggleSwitch_NormalBackground}" Width="208" Height="52" Margin="0,0,4,8" 
                                                                       IsEnabled="{Binding ElementName=WearDetectionToggleSwitch, Path=IsChecked}" IsChecked="{Binding IsLowChecked, Mode=TwoWay}" IsTabStop="{Binding isWearTabStopped}">
                        <UXControls:UXToggleSwitch.Opacity>
                          <MultiBinding Converter="{StaticResource BooleanToOpacityConverter}">
                            <Binding Path="IsChecked" ElementName="WearDetectionToggleSwitch" />
                          </MultiBinding>
                        </UXControls:UXToggleSwitch.Opacity>
                        <UXControls:UXToggleSwitch.Template>
                          <ControlTemplate TargetType="UXControls:UXToggleSwitch">
                            <Border x:Name="LowButtonBorder" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4,4,4,4">
                              <Grid>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                  <!--<UXControls:UXTextBlock x:Name="LowButtonTextBlock" Text="{Binding [HeadsetAutomatedActions.2], Source={x:Static lang:LangHelper.Instance}}" FontSize="14" Foreground="{DynamicResource TextBlock_ForegroundColor}" TextAlignment="Center" />-->
                                  <UXControls:UXTextBlock x:Name="LowButtonTextBlock1" FontSize="14" TextAlignment="Center" >
                                    <UXControls:UXTextBlock.Style>
                                      <Style TargetType="UXControls:UXTextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource DefaultTheme_TxtColor}" />
                                        <Style.Triggers>
                                          <DataTrigger Binding="{Binding ElementName=WearDetectionToggleSwitch, Path=IsChecked}" Value="False">
                                            <Setter Property="Foreground" Value="{DynamicResource DefaultTheme_TxtColor}" />
                                          </DataTrigger>
                                        </Style.Triggers>
                                      </Style>
                                    </UXControls:UXTextBlock.Style>
                                    <UXControls:UXTextBlock.Text>
                                      <Binding Path="[HeadsetAutomatedActions.2]" Source="{x:Static lang:LangHelper.Instance}" />
                                    </UXControls:UXTextBlock.Text>
                                  </UXControls:UXTextBlock>
                                </StackPanel>
                              </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                              <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="LowButtonBorder" Property="Background" Value="{StaticResource PressedBackground}" />
                                <Setter TargetName="LowButtonBorder" Property="BorderBrush" Value="{StaticResource PressedBorderBrush}" />
                                <Setter TargetName="LowButtonTextBlock1" Property="Foreground" Value="White" />
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </UXControls:UXToggleSwitch.Template>
                      </UXControls:UXToggleSwitch>
                      <UXControls:UXToggleSwitch x:Name="Normal2Button" BorderThickness="1.5" BorderBrush="{DynamicResource ToggleSwitch_NormalBorderBrush}" Background="{DynamicResource ToggleSwitch_NormalBackground}" 
                                                                       Width="208" Height="52" Margin="4,0,0,8" IsEnabled="{Binding ElementName=WearDetectionToggleSwitch, Path=IsChecked}" IsChecked="{Binding IsNormal2Checked, Mode=TwoWay}" IsTabStop="{Binding isWearTabStopped}">
                        <UXControls:UXToggleSwitch.Opacity>
                          <MultiBinding Converter="{StaticResource BooleanToOpacityConverter}">
                            <Binding Path="IsChecked" ElementName="WearDetectionToggleSwitch" />
                          </MultiBinding>
                        </UXControls:UXToggleSwitch.Opacity>
                        <UXControls:UXToggleSwitch.Template>
                          <ControlTemplate TargetType="UXControls:UXToggleSwitch">
                            <Border x:Name="Normal2ButtonBorder" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4,4,4,4">
                              <Grid>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                  <!--<UXControls:UXTextBlock x:Name="Normal2ButtonTextBlock" Text="{Binding [HeadsetAutomatedActions.3], Source={x:Static lang:LangHelper.Instance}}" FontSize="14" Foreground="{DynamicResource TextBlock_ForegroundColor}" TextAlignment="Center" />-->
                                  <UXControls:UXTextBlock x:Name="Normal2ButtonTextBlock" FontSize="14" TextAlignment="Center" >
                                    <UXControls:UXTextBlock.Style>
                                      <Style TargetType="UXControls:UXTextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource DefaultTheme_TxtColor}" />
                                        <Style.Triggers>
                                          <DataTrigger Binding="{Binding ElementName=WearDetectionToggleSwitch, Path=IsChecked}" Value="False">
                                            <Setter Property="Foreground" Value="{DynamicResource DefaultTheme_TxtColor}" />
                                          </DataTrigger>
                                        </Style.Triggers>
                                      </Style>
                                    </UXControls:UXTextBlock.Style>
                                    <UXControls:UXTextBlock.Text>
                                      <Binding Path="[HeadsetAutomatedActions.3]" Source="{x:Static lang:LangHelper.Instance}" />
                                    </UXControls:UXTextBlock.Text>
                                  </UXControls:UXTextBlock>
                                </StackPanel>
                              </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                              <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Normal2ButtonBorder" Property="Background" Value="{StaticResource PressedBackground}" />
                                <Setter TargetName="Normal2ButtonBorder" Property="BorderBrush" Value="{StaticResource PressedBorderBrush}" />
                                <Setter TargetName="Normal2ButtonTextBlock" Property="Foreground" Value="White" />
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </UXControls:UXToggleSwitch.Template>
                      </UXControls:UXToggleSwitch>
                    </StackPanel>
                  </Grid>
                </Border>
              </Grid>

              <Grid Visibility="{Binding AutomatedActionsWhenHeadsetIsRemovedPageShow, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border x:Name="SubContentBorder" Style="{DynamicResource RightGroupBorderStyleForAudio}" CornerRadius="6" Width="456" VerticalAlignment="Top">
                  <StackPanel x:Name="SubContentStackPanel" Orientation="Vertical">
                    <!--<UXControls:UXTextBlock x:Name="WhenHeadsetIsRemovedText" Style="{StaticResource ModuleItemStyle}" Foreground="{Binding IsChecked, ElementName=WearDetectionToggleSwitch, Converter={StaticResource BooleanToForegroundConverter}}" Text="{Binding [HeadsetAutomatedActions.4], Source={x:Static lang:LangHelper.Instance}}" Margin="20" FontSize="14" />-->
                    <UXControls:UXTextBlock x:Name="WhenHeadsetIsRemovedText" Style="{StaticResource ModuleItemStyle}" Margin="20" FontSize="14">
                      <UXControls:UXTextBlock.Opacity>
                        <MultiBinding Converter="{StaticResource BooleanToOpacityConverter}">
                          <Binding Path="IsChecked" ElementName="WearDetectionToggleSwitch" />
                        </MultiBinding>
                      </UXControls:UXTextBlock.Opacity>
                      <!--<UXControls:UXTextBlock.Foreground>
                                                <MultiBinding Converter="{StaticResource BooleanToForegroundConverter}">
                                                    <Binding Path="IsChecked" ElementName="WearDetectionToggleSwitch" />
                                                    <Binding Path="IsDarkTheme" />
                                                </MultiBinding>
                                            </UXControls:UXTextBlock.Foreground>-->
                      <UXControls:UXTextBlock.Text>
                        <Binding Path="[HeadsetAutomatedActions.4]" Source="{x:Static lang:LangHelper.Instance}" />
                      </UXControls:UXTextBlock.Text>
                    </UXControls:UXTextBlock>
                    <!-- Pause Music -->
                    <Grid x:Name="PauseMusicGrid">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <!--<UXControls:UXTextBlock x:Name="PauseMusicText" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="16" Foreground="{Binding IsChecked, ElementName=WearDetectionToggleSwitch, Converter={StaticResource BooleanToForegroundConverter},ConverterParameter={Binding IsDarkTheme}}" Text="{Binding [HeadsetAutomatedActions.5], Source={x:Static lang:LangHelper.Instance}}" Margin="20,0,0,0" />-->
                      <UXControls:UXTextBlock TextTrimming="CharacterEllipsis" MaxWidth="300" x:Name="PauseMusicText" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="16" Margin="20,0,0,0">
                        <UXControls:UXTextBlock.Opacity>
                          <MultiBinding Converter="{StaticResource BooleanToOpacityConverter}">
                            <Binding Path="IsChecked" ElementName="WearDetectionToggleSwitch" />
                          </MultiBinding>
                        </UXControls:UXTextBlock.Opacity>
                        <!--<UXControls:UXTextBlock.Foreground>
                                                    <MultiBinding Converter="{StaticResource BooleanToForegroundConverter}">
                                                        <Binding Path="IsChecked" ElementName="WearDetectionToggleSwitch" />
                                                        <Binding Path="IsDarkTheme" />
                                                    </MultiBinding>
                                                </UXControls:UXTextBlock.Foreground>-->
                        <UXControls:UXTextBlock.Text>
                          <Binding Path="[HeadsetAutomatedActions.5]" Source="{x:Static lang:LangHelper.Instance}" />
                        </UXControls:UXTextBlock.Text>
                      </UXControls:UXTextBlock>

                      <Image x:Name="PauseMusicImage" Grid.Column="1" Width="16" Height="16" Margin="8" Source="/DDPM.UI.Common;component/Resources/info.png" Stretch="Uniform">
                        <Image.ToolTip>
                          <ToolTip Placement="Top" VerticalOffset="8" HorizontalOffset="6">
                            <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                              <Border.Resources>
                                <Style BasedOn="{StaticResource Tooltip_TextBlockStyle}" TargetType="TextBlock" />
                              </Border.Resources>
                              <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding PauseMusicToolTip}" MaxWidth="350" TextWrapping="WrapWithOverflow"/>
                              </StackPanel>
                            </Border>
                          </ToolTip>
                        </Image.ToolTip>
                      </Image>
                      <UXControls:UXToggleSwitch x:Name="PauseMusicToggleSwitch" FontSize="16" Foreground="{DynamicResource TextBlock_ForegroundColor}" Content="{Binding Path=PauseMusic_String, FallbackValue='OFF'}" IsChecked="{Binding Path=PauseMusicStatus}" IsEnabled="{Binding ElementName=WearDetectionToggleSwitch, Path=IsChecked}" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,20,0" IsTabStop="{Binding isWearTabStopped}">
                        <UXControls:UXToggleSwitch.Opacity>
                          <MultiBinding Converter="{StaticResource BooleanToOpacityConverter}">
                            <Binding Path="IsChecked" ElementName="WearDetectionToggleSwitch" />
                          </MultiBinding>
                        </UXControls:UXToggleSwitch.Opacity>
                        <!--<UXControls:UXTextBlock.Foreground>
                                                <MultiBinding Converter="{StaticResource BooleanToForegroundConverter}">
                                                    <Binding Path="IsChecked" ElementName="WearDetectionToggleSwitch" />
                                                    <Binding Path="IsDarkTheme" />
                                                </MultiBinding>
                                            </UXControls:UXTextBlock.Foreground>-->
                      </UXControls:UXToggleSwitch>
                    </Grid>

                    <!-- Mute Microphone -->
                    <Grid x:Name="MuteMicrophoneGrid" Height="50">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <!--<UXControls:UXTextBlock x:Name="MuteMicrophoneText" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="16" Foreground="{Binding IsChecked, ElementName=WearDetectionToggleSwitch, Converter={StaticResource BooleanToForegroundConverter}}" Text="{Binding [HeadsetAutomatedActions.6], Source={x:Static lang:LangHelper.Instance}}" Margin="20,0,0,0" />-->
                      <UXControls:UXTextBlock x:Name="MuteMicrophoneText" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="16" Margin="20,0,0,0">
                        <UXControls:UXTextBlock.Opacity>
                          <MultiBinding Converter="{StaticResource BooleanToOpacityConverter}">
                            <Binding Path="IsChecked" ElementName="WearDetectionToggleSwitch" />
                          </MultiBinding>
                        </UXControls:UXTextBlock.Opacity>
                        <!--<UXControls:UXTextBlock.Foreground>
                                                    <MultiBinding Converter="{StaticResource BooleanToForegroundConverter}">
                                                        <Binding Path="IsChecked" ElementName="WearDetectionToggleSwitch" />
                                                        <Binding Path="IsDarkTheme" />
                                                    </MultiBinding>
                                                </UXControls:UXTextBlock.Foreground>-->
                        <UXControls:UXTextBlock.Text>
                          <Binding Path="[HeadsetAutomatedActions.6]" Source="{x:Static lang:LangHelper.Instance}" />
                        </UXControls:UXTextBlock.Text>
                      </UXControls:UXTextBlock>
                      <Image ToolTipService.HorizontalOffset="-200" x:Name="MuteMicrophoneImage" Grid.Column="1" Width="16" Height="16" Margin="8" Source="/DDPM.UI.Common;component/Resources/info.png" Stretch="Uniform">
                        <Image.ToolTip>
                          <ToolTip Placement="Top" VerticalOffset="8" HorizontalOffset="6">
                            <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                              <Border.Resources>
                                <Style BasedOn="{StaticResource Tooltip_TextBlockStyle}" TargetType="TextBlock" />
                              </Border.Resources>
                              <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding MuteMicrophoneToolTip}" MaxWidth="350" TextWrapping="WrapWithOverflow"/>
                              </StackPanel>
                            </Border>
                          </ToolTip>
                        </Image.ToolTip>
                      </Image>
                      <UXControls:UXToggleSwitch x:Name="MuteMicrophoneToggleSwitch" FontSize="16" Foreground="{DynamicResource TextBlock_ForegroundColor}" Content="{Binding Path=MuteMicrophone_String, FallbackValue='OFF'}" IsChecked="{Binding Path=MuteMicrophoneStatus}" IsEnabled="{Binding ElementName=WearDetectionToggleSwitch, Path=IsChecked}" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,20,0" IsTabStop="{Binding isWearTabStopped}">
                        <UXControls:UXToggleSwitch.Opacity>
                          <MultiBinding Converter="{StaticResource BooleanToOpacityConverter}">
                            <Binding Path="IsChecked" ElementName="WearDetectionToggleSwitch" />
                          </MultiBinding>
                        </UXControls:UXToggleSwitch.Opacity>
                        <!--<UXControls:UXTextBlock.Foreground>
                                                <MultiBinding Converter="{StaticResource BooleanToForegroundConverter}">
                                                    <Binding Path="IsChecked" ElementName="WearDetectionToggleSwitch" />
                                                    <Binding Path="IsDarkTheme" />
                                                </MultiBinding>
                                            </UXControls:UXTextBlock.Foreground>-->
                      </UXControls:UXToggleSwitch>
                    </Grid>

                    <Line x:Name="SeparatorLine" X1="0" Y1="0" X2="456" Y2="0" Stroke="#1E3F6C" StrokeThickness="1" HorizontalAlignment="Center" Margin="18,16,0,16" />

                    <!-- Quick Pause -->
                    <Grid x:Name="QuickPauseGrid" Visibility="{Binding AutomatedActionsQuickPausePageShow, Converter={StaticResource BooleanToVisibilityConverter}}" Height="50">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <!--<UXControls:UXTextBlock x:Name="QuickPauseText" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="16" Foreground="{Binding IsChecked, ElementName=WearDetectionToggleSwitch, Converter={StaticResource BooleanToForegroundConverter}}" Text="{Binding [HeadsetAutomatedActions.7], Source={x:Static lang:LangHelper.Instance}}" Margin="20,0,0,0" />-->
                      <UXControls:UXTextBlock x:Name="QuickPauseText" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="16" Margin="20,0,0,0">
                        <UXControls:UXTextBlock.Opacity>
                          <MultiBinding Converter="{StaticResource BooleanToOpacityConverter}">
                            <Binding Path="IsChecked" ElementName="WearDetectionToggleSwitch" />
                          </MultiBinding>
                        </UXControls:UXTextBlock.Opacity>
                        <!--<UXControls:UXTextBlock.Foreground>
                                                    <MultiBinding Converter="{StaticResource BooleanToForegroundConverter}">
                                                        <Binding Path="IsChecked" ElementName="WearDetectionToggleSwitch" />
                                                        <Binding Path="IsDarkTheme" />
                                                    </MultiBinding>
                                                </UXControls:UXTextBlock.Foreground>-->
                        <UXControls:UXTextBlock.Text>
                          <Binding Path="[HeadsetAutomatedActions.7]" Source="{x:Static lang:LangHelper.Instance}" />
                        </UXControls:UXTextBlock.Text>
                      </UXControls:UXTextBlock>
                      <Image ToolTipService.HorizontalOffset="-250" x:Name="QuickPauseImage" Grid.Column="1" Width="16" Height="16" Margin="8" Source="/DDPM.UI.Common;component/Resources/info.png" Stretch="Uniform">
                        <Image.ToolTip>
                          <ToolTip Placement="Top" VerticalOffset="8" HorizontalOffset="6">
                            <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                              <Border.Resources>
                                <Style BasedOn="{StaticResource Tooltip_TextBlockStyle}" TargetType="TextBlock" />
                              </Border.Resources>
                              <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding QuickPauseToolTip}" TextWrapping="WrapWithOverflow"/>
                              </StackPanel>
                            </Border>
                          </ToolTip>
                        </Image.ToolTip>
                      </Image>
                      <UXControls:UXToggleSwitch x:Name="QuickPauseToggleSwitch" FontSize="16"  Foreground="{DynamicResource TextBlock_ForegroundColor}" Content="{Binding Path=QuickPause_String, FallbackValue='OFF'}" IsChecked="{Binding Path=QuickPauseStatus}" IsEnabled="{Binding ElementName=WearDetectionToggleSwitch, Path=IsChecked}" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,20,0" IsTabStop="{Binding isWearTabStopped}">
                        <UXControls:UXToggleSwitch.Opacity>
                          <MultiBinding Converter="{StaticResource BooleanToOpacityConverter}">
                            <Binding Path="IsChecked" ElementName="WearDetectionToggleSwitch" />
                          </MultiBinding>
                        </UXControls:UXToggleSwitch.Opacity>
                        <!--<UXControls:UXTextBlock.Foreground>
                                                <MultiBinding Converter="{StaticResource BooleanToForegroundConverter}">
                                                    <Binding Path="IsChecked" ElementName="WearDetectionToggleSwitch" />
                                                    <Binding Path="IsDarkTheme" />
                                                </MultiBinding>
                                            </UXControls:UXTextBlock.Foreground>-->
                      </UXControls:UXToggleSwitch>
                    </Grid>

                    <!-- SensitivityText -->
                    <Grid x:Name="SensitivityTextGrid" Visibility="{Binding AutomatedActionsSensitivityPageShow, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,0">
                      <!--<UXControls:UXTextBlock x:Name="SensitivityTextBlock" Text="{Binding [HeadsetAutomatedActions.1], Source={x:Static lang:LangHelper.Instance}}" Foreground="{Binding IsChecked, ElementName=WearDetectionToggleSwitch, Converter={StaticResource BooleanToForegroundConverter}}" FontSize="14" Margin="20,0,0,0" />-->
                      <UXControls:UXTextBlock x:Name="SensitivityTextBlock" FontSize="14" Margin="20,0,0,0">
                        <UXControls:UXTextBlock.Opacity>
                          <MultiBinding Converter="{StaticResource BooleanToOpacityConverter}">
                            <Binding Path="IsChecked" ElementName="WearDetectionToggleSwitch" />
                            <Binding Path="QuickPauseStatus"/>
                          </MultiBinding>
                        </UXControls:UXTextBlock.Opacity>
                        <!--<UXControls:UXTextBlock.Foreground>
                                                    <MultiBinding Converter="{StaticResource BooleanToForegroundConverter3}">
                                                        <Binding Path="IsChecked" ElementName="WearDetectionToggleSwitch" />
                                                        <Binding Path="IsDarkTheme" />
                                                        <Binding Path="QuickPauseStatus"/>
                                                    </MultiBinding>
                                                </UXControls:UXTextBlock.Foreground>-->
                        <UXControls:UXTextBlock.Text>
                          <Binding Path="[HeadsetAutomatedActions.14]" Source="{x:Static lang:LangHelper.Instance}" />
                        </UXControls:UXTextBlock.Text>
                      </UXControls:UXTextBlock>
                      <StackPanel x:Name="SensitivityStackPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <UXControls:UXToggleSwitch x:Name="NormalButton" BorderThickness="1.5" BorderBrush="{DynamicResource ToggleSwitch_NormalBorderBrush}"
                                                                           Background="{DynamicResource ToggleSwitch_NormalBackground}" Width="208" Height="52" Margin="0,20,0,20"
                                                                           IsEnabled="{Binding ElementName=WearDetectionToggleSwitch, Path=IsChecked}" IsChecked="{Binding IsNormalChecked, Mode=TwoWay}" IsTabStop="{Binding isWearTabStopped}">
                          <UXControls:UXToggleSwitch.Opacity>
                            <MultiBinding Converter="{StaticResource BooleanToOpacityConverter}">
                              <Binding Path="IsChecked" ElementName="WearDetectionToggleSwitch" />
                              <Binding Path="QuickPauseStatus"/>
                            </MultiBinding>
                          </UXControls:UXToggleSwitch.Opacity>
                          <UXControls:UXToggleSwitch.Template>
                            <ControlTemplate TargetType="UXControls:UXToggleSwitch">
                              <Border x:Name="NormalButtonBorder" CornerRadius="4,4,4,4" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!--<UXControls:UXTextBlock Text="{Binding [HeadsetAutomatedActions.3], Source={x:Static lang:LangHelper.Instance}}" FontSize="14" Foreground="{Binding IsChecked, ElementName=WearDetectionToggleSwitch, Converter={StaticResource BooleanToForegroundConverter}}" TextAlignment="Center" />-->
                                    <UXControls:UXTextBlock x:Name="NormalButtonTextBlock" FontSize="14" TextAlignment="Center" >
                                      <UXControls:UXTextBlock.Style>
                                        <Style TargetType="UXControls:UXTextBlock">
                                          <Setter Property="Foreground" Value="{DynamicResource DefaultTheme_TxtColor}" />
                                          <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=WearDetectionToggleSwitch, Path=IsChecked}" Value="False">
                                              <Setter Property="Foreground" Value="{DynamicResource DefaultTheme_TxtColor}" />
                                            </DataTrigger>
                                          </Style.Triggers>
                                        </Style>
                                      </UXControls:UXTextBlock.Style>
                                      <UXControls:UXTextBlock.Text>
                                        <Binding Path="[HeadsetAutomatedActions.3]" Source="{x:Static lang:LangHelper.Instance}" />
                                      </UXControls:UXTextBlock.Text>
                                    </UXControls:UXTextBlock>
                                  </StackPanel>
                                </Grid>
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                  <Setter TargetName="NormalButtonBorder" Property="Background" Value="{StaticResource PressedBackground}" />
                                  <Setter TargetName="NormalButtonBorder" Property="BorderBrush" Value="{StaticResource PressedBorderBrush}" />
                                  <Setter TargetName="NormalButtonTextBlock" Property="Foreground" Value="White" />
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </UXControls:UXToggleSwitch.Template>
                        </UXControls:UXToggleSwitch>
                        <UXControls:UXToggleSwitch x:Name="SensitiveButton" BorderThickness="1.5" BorderBrush="{DynamicResource ToggleSwitch_NormalBorderBrush}"
                                                                           Background="{DynamicResource ToggleSwitch_NormalBackground}" 
                                                                           Width="208" Height="52" Margin="8,0,0,0" IsEnabled="{Binding ElementName=WearDetectionToggleSwitch, Path=IsChecked}" IsChecked="{Binding IsSensitiveChecked, Mode=TwoWay}" IsTabStop="{Binding isWearTabStopped}">
                          <UXControls:UXToggleSwitch.Opacity>
                            <MultiBinding Converter="{StaticResource BooleanToOpacityConverter}">
                              <Binding Path="IsChecked" ElementName="WearDetectionToggleSwitch" />
                              <Binding Path="QuickPauseStatus"/>
                            </MultiBinding>
                          </UXControls:UXToggleSwitch.Opacity>
                          <UXControls:UXToggleSwitch.Template>
                            <ControlTemplate TargetType="UXControls:UXToggleSwitch">
                              <Border x:Name="SensitiveButtonBorder" CornerRadius="4,4,4,4" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!--<UXControls:UXTextBlock Text="{Binding [HeadsetAutomatedActions.1], Source={x:Static lang:LangHelper.Instance}}" FontSize="14" Foreground="{Binding IsChecked, ElementName=WearDetectionToggleSwitch, Converter={StaticResource BooleanToForegroundConverter}}" TextAlignment="Center" />-->
                                    <UXControls:UXTextBlock x:Name="SensitiveButtonTextBlock" FontSize="14" TextAlignment="Center">
                                      <UXControls:UXTextBlock.Style>
                                        <Style TargetType="UXControls:UXTextBlock">
                                          <Setter Property="Foreground" Value="{DynamicResource DefaultTheme_TxtColor}" />
                                          <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=WearDetectionToggleSwitch, Path=IsChecked}" Value="False">
                                              <Setter Property="Foreground" Value="{DynamicResource DefaultTheme_TxtColor}" />
                                            </DataTrigger>
                                          </Style.Triggers>
                                        </Style>
                                      </UXControls:UXTextBlock.Style>
                                      <UXControls:UXTextBlock.Text>
                                        <Binding Path="[HeadsetAutomatedActions.1]" Source="{x:Static lang:LangHelper.Instance}" />
                                      </UXControls:UXTextBlock.Text>
                                    </UXControls:UXTextBlock>
                                  </StackPanel>
                                </Grid>
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                  <Setter TargetName="SensitiveButtonBorder" Property="Background" Value="{StaticResource PressedBackground}" />
                                  <Setter TargetName="SensitiveButtonBorder" Property="BorderBrush" Value="{StaticResource PressedBorderBrush}" />
                                  <Setter TargetName="SensitiveButtonTextBlock" Property="Foreground" Value="White" />
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </UXControls:UXToggleSwitch.Template>
                        </UXControls:UXToggleSwitch>
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </Border>
              </Grid>
            </StackPanel>
          </Border>
          <Border Background="#132F54"
                            Opacity="0.6"
                            CornerRadius="13"
                            Visibility="{Binding isWearLocked}" />
        </Grid>

        <!-- Answer Calls Page -->
        <Grid Visibility="{Binding AutomatedActionsAnswerCallPageShow, Converter={StaticResource BooleanToVisibilityConverter}}">
          <Border x:Name="SubContentBorder4" Grid.Row="0" Style="{DynamicResource RightGroupBorderStyleForAudio}" CornerRadius="6" Width="488" Height="72" VerticalAlignment="Top" Margin="0,0,0,20">
            <Grid x:Name="AnswerCallsGrid">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <UXControls:UXTextBlock x:Name="AnswerCallsText" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="16" Margin="20,20,0,20" Foreground="{DynamicResource TextBlock_ForegroundColor}">
                <UXControls:UXTextBlock.Text>
                  <Binding Path="[HeadsetAutomatedActions.8]" Source="{x:Static lang:LangHelper.Instance}" />
                </UXControls:UXTextBlock.Text>
              </UXControls:UXTextBlock>
              <Image ToolTipService.HorizontalOffset="-250" x:Name="AnswerCallsImage" Grid.Column="1" Width="16" Height="16" Margin="8" Source="/DDPM.UI.Common;component/Resources/info.png" Stretch="Uniform">
                <Image.ToolTip>
                  <ToolTip Placement="Top" VerticalOffset="6" HorizontalOffset="8">
                    <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                      <Border.Resources>
                        <Style BasedOn="{StaticResource Tooltip_TextBlockStyle}" TargetType="TextBlock" />
                      </Border.Resources>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding AnswerCallsToolTip}" />
                      </StackPanel>
                    </Border>
                  </ToolTip>
                </Image.ToolTip>
              </Image>
              <UXControls:UXToggleSwitch x:Name="AnswerCallsToggleSwitch" FontSize="16" Foreground="{DynamicResource TextBlock_ForegroundColor}" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" VerticalContentAlignment="Center" Margin="20" IsChecked="{Binding Path=AnswerCallsStatus}" IsEnabled="{Binding Path=SupportedAnswerCalls}">
                <!--<UXControls:UXToggleSwitch.Opacity>
                                    <MultiBinding Converter="{StaticResource BooleanToOpacityConverter}">
                                        -->
                <!--<Binding Path="IsChecked" ElementName="WearDetectionToggleSwitch" />-->
                <!--
                                    </MultiBinding>
                                </UXControls:UXToggleSwitch.Opacity>-->
                <!--<UXControls:UXToggleSwitch.Foreground>
                                    <MultiBinding Converter="{StaticResource BooleanToForegroundConverter}">
                                        <Binding Path="SupportedAnswerCalls" />
                                        <Binding Path="IsDarkTheme" />
                                    </MultiBinding>
                                </UXControls:UXToggleSwitch.Foreground>-->
                <UXControls:UXToggleSwitch.Content>
                  <Binding Path="AnswerCalls_String" FallbackValue="OFF" />
                </UXControls:UXToggleSwitch.Content>
              </UXControls:UXToggleSwitch>
            </Grid>
          </Border>
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>