<UserControl x:Class="DDPM.UI.Module.EzSettings.EzSettingsRightView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DDPM.UI.Module.EzSettings"
             xmlns:lang="clr-namespace:DDPM.UI.Resources.Helper;assembly=DDPM.UI.Resources"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800" Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- <ResourceDictionary Source="/DDPM.UI.Common;component/ModuleStyle.xaml" /> -->
                <ResourceDictionary Source="/DDPM.UI.Common;component/ButtonStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="ItemDescriptionTextStyle" TargetType="UXControls:UXTextBlock">
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="Foreground" Value="{DynamicResource DefaultTheme_TxtColor}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                        <Setter Property="Foreground" Value="#8996A7"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>



        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <UXControls:UXScrollViewer>
            <Border Style="{StaticResource RightGroupBorderStyle}" Width="Auto">
                <Grid>
                    <StackPanel>
                        <!-- #region Row 0: Hotkey: Recent -->
                        <Grid Height="40" Margin="16,16,16,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <!-- Text "Hotkey: Recent"-->
                                <UXControls:UXTextBlock Text="{Binding [EazyMemorySettings.0], Source={x:Static lang:LangHelper.Instance}}" 
                                                        Style="{StaticResource ItemDescriptionTextStyle}"/>
                                <!-- (i) icon and tooltip -->
                                <Viewbox Width="16" Height="16"  Margin="16,0,0,0" Stretch="Uniform">
                                    <Grid Width="16" Height="16" Background="{StaticResource FakeTransparent}">
                                        <Grid.ToolTip>
                                            <ToolTip>
                                                <Border Style="{StaticResource Tooltip_OutterBorderStyle}"
                                                    MaxWidth="360">
                                                    <Grid>
                                                        <TextBlock Name="hotkeyRecentTooltipText"
                                                               Style="{StaticResource Tooltip_TextBlockStyle}"
                                                               TextWrapping="Wrap"/>
                                                    </Grid>
                                                </Border>
                                            </ToolTip>
                                        </Grid.ToolTip>
                                        <Path Data="M8 5.0498C8.55228 5.0498 9 4.60209 9 4.0498C9 3.49752 8.55228 3.0498 8 3.0498C7.44772 3.0498 7 3.49752 7 4.0498C7 4.60209 7.44772 5.0498 8 5.0498Z"
                                              Fill="{DynamicResource InfoIconColor}" />
                                        <Path Data="M8.75 6.4502H7.25V12.6502H8.75V6.4502Z"
                                              Fill="{DynamicResource InfoIconColor}" />
                                        <Path Data="M8 1C11.85 1 15 4.15 15 8C15 11.85 11.85 15 8 15C4.15 15 1 11.85 1 8C1 4.15 4.15 1 8 1ZM8 0C3.6 0 0 3.6 0 8C0 12.4 3.6 16 8 16C12.4 16 16 12.4 16 8C16 3.6 12.4 0 8 0Z"
                                              Fill="{DynamicResource InfoIconColor}" />
                                    </Grid>
                                </Viewbox>

                            </StackPanel>
                            <!-- Hotkey TextBox 
                                                      PreviewKeyDown="tbToggleInputSource_PreviewKeyDown"
                                                      PreviewKeyUp="tbToggleInputSource_PreviewKeyUp"
                                                      GotFocus="tbToggleInputSource_GotFocus"
                                                      LostFocus="tbToggleInputSource_LostFocus"
                                                      ContextMenuOpening="tbToggleInputSource_ContextMenuOpening"
                        -->
                            <!-- Robert_Lin, 2024-11-28 for LightMode, remove all color properties 
                            Before:
                            <UXControls:UXTextBox Grid.Column="2" Name="tbRecentHotkey" Margin="0"
                                             Text="{Binding RecentHotkey,Mode=TwoWay}"
                                             Background="#141D28" Foreground="White" Width="230"
                                             BorderBrush="#7E7E7E" BorderThickness="1" FontSize="14"
                                             HorizontalAlignment="Center" VerticalContentAlignment="Center"
                                             AcceptsReturn="True" ContextMenu="{x:Null}" PreviewKeyDown="tbRecentHotkey_PreviewKeyDown" 
                                             PreviewKeyUp="tbRecentHotkey_PreviewKeyUp" GotFocus="tbRecentHotkey_GotFocus" 
                                             LostFocus="tbRecentHotkey_LostFocus" ContextMenuOpening="tbRecentHotkey_ContextMenuOpening" 
                                             InputLanguageManager.InputLanguage="en-US" InputLanguageManager.RestoreInputLanguage="True"/>
                           
                            -->
                            <UXControls:UXTextBox Grid.Column="2" Name="tbRecentHotkey" Margin="0"
                                                  Text="{Binding RecentHotkey,Mode=TwoWay}" Width="230" BorderThickness="1" FontSize="14"
                                                  HorizontalAlignment="Center" VerticalContentAlignment="Center"
                                                  AcceptsReturn="True" ContextMenu="{x:Null}" PreviewKeyDown="tbRecentHotkey_PreviewKeyDown" 
                                                  PreviewKeyUp="tbRecentHotkey_PreviewKeyUp" GotFocus="tbRecentHotkey_GotFocus" 
                                                  LostFocus="tbRecentHotkey_LostFocus" ContextMenuOpening="tbRecentHotkey_ContextMenuOpening" 
                                                  InputLanguageManager.InputLanguage="en-US" InputLanguageManager.RestoreInputLanguage="True"/>
                        </Grid>
                        <!-- #endregion Row 0: Hotkey: Recent -->

                        <!-- #region Row 1: Allow app to split side by side without gap -->
                        <Grid Height="40" Margin="16,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Text "Allow app to split side by side without gap"-->
                            <UXControls:UXTextBlock Grid.Column="0" Text="{Binding [EazyMemorySettings.3], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource ItemDescriptionTextStyle}"/>
                            <!-- ToogleSwitch -->
                            <UXControls:UXToggleSwitch Grid.Column="2" IsChecked="{Binding IsWithoutGap}" ContentTextVisibility="True" 
                                                   Content="{Binding Path=IsWithoutGap_String}" HorizontalAlignment="Right" VerticalAlignment="Center"  
                                                   Foreground="White" />
                        </Grid>
                        <!-- #endregion Row 1: Allow app to split side by side without gap -->

                        <!-- #region Row 2: Only allow zone positioning when SHIFT is pressed -->
                        <Grid Height="40" Margin="16,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Text "Only allow zone positioning when SHIFT is pressed"-->
                            <UXControls:UXTextBlock Grid.Column="0" Text="{Binding [EazyMemorySettings.4], Source={x:Static lang:LangHelper.Instance}}"
                                                    Style="{StaticResource ItemDescriptionTextStyle}"/>
                            <!-- ToogleSwitch 
                        Content="{Binding Path=IsOnlyAllowWhenShiftKeyPressed_String}"
                        -->
                            <UXControls:UXToggleSwitch Grid.Column="2" IsChecked="{Binding IsOnlyAllowWhenShiftKeyPressed}" ContentTextVisibility="True" 
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Content="{Binding Path=IsOnlyAllowWhenShiftKeyPressed_String}"
                                                   />

                        </Grid>
                        <!-- #endregion Row 2: Only allow zone positioning when SHIFT is pressed -->

                        <!-- #region Row 3: Snap across multiple monitors -->
                        <Grid Height="40" Margin="16,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Text "Only allow zone positioning when SHIFT is pressed"-->
                            <!-- 
                        <UXControls:UXTextBlock Grid.Column="0" Text="Snap across multiple monitors" Style="{StaticResource ItemDescriptionTextStyle}"
                                                IsEnabled="{Binding IsSpanAcrossEnabled}"/>
                        -->
                            <TextBlock Grid.Column="0" Text="{Binding [EazyMemorySettings.5], Source={x:Static lang:LangHelper.Instance}}"
                                       FontFamily="Roboto" FontSize="16"
                                       VerticalAlignment="Center" IsEnabled="{Binding IsSpanAcrossEnabled}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource DefaultTheme_TxtColor}"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Foreground" Value="#8996A7"/>
                                            </Trigger>
                                        </Style.Triggers>

                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <!-- ToogleSwitch -->
                            <UXControls:UXToggleSwitch Grid.Column="2" IsChecked="{Binding IsSpanAcrossMultiMonitors}" ContentTextVisibility="True" 
                                                       Content="{Binding Path=IsSpanAcrossMultiMonitors_String}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"  
                                                       IsEnabled="{Binding IsSpanAcrossEnabled}"/>
                        </Grid>
                        <!-- #endregion Row 3: Snap across multiple monitors -->

                        <!-- #region Row 4: Application Window Snap -->
                        <Grid Height="40" Margin="16,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <!-- Text "Application Window Snap"-->
                                <UXControls:UXTextBlock Text="{Binding [EazyMemorySettings.6], Source={x:Static lang:LangHelper.Instance}}" 
                                                        Style="{StaticResource ItemDescriptionTextStyle}"/>
                                <!-- (i) icon and tooltip -->
                                <Viewbox Width="16" Height="16"  Margin="16,0,0,0" Stretch="Uniform">
                                    <Grid Width="16" Height="16" Background="{StaticResource FakeTransparent}">
                                        <Grid.ToolTip>
                                            <ToolTip>
                                                <Border Style="{StaticResource Tooltip_OutterBorderStyle}"
                                                   MaxWidth="360">
                                                    <Grid>
                                                        <TextBlock Name="applicationWindowSnapTooltipText"
                                                              Style="{StaticResource Tooltip_TextBlockStyle}"
                                                              TextWrapping="Wrap"/>
                                                    </Grid>
                                                </Border>
                                            </ToolTip>
                                        </Grid.ToolTip>
                                        <Path Data="M8 5.0498C8.55228 5.0498 9 4.60209 9 4.0498C9 3.49752 8.55228 3.0498 8 3.0498C7.44772 3.0498 7 3.49752 7 4.0498C7 4.60209 7.44772 5.0498 8 5.0498Z"
                                             Fill="{DynamicResource InfoIconColor}" />
                                        <Path Data="M8.75 6.4502H7.25V12.6502H8.75V6.4502Z"
                                             Fill="{DynamicResource InfoIconColor}" />
                                        <Path Data="M8 1C11.85 1 15 4.15 15 8C15 11.85 11.85 15 8 15C4.15 15 1 11.85 1 8C1 4.15 4.15 1 8 1ZM8 0C3.6 0 0 3.6 0 8C0 12.4 3.6 16 8 16C12.4 16 16 12.4 16 8C16 3.6 12.4 0 8 0Z"
                                             Fill="{DynamicResource InfoIconColor}" />
                                    </Grid>
                                </Viewbox>

                            </StackPanel>
                            <!-- ToogleSwitch -->
                            <UXControls:UXToggleSwitch Grid.Column="2" IsChecked="{Binding IsAwsEnabled}" ContentTextVisibility="True" 
                                                   Content="{Binding Path=IsAwsEnabled_String}" HorizontalAlignment="Right" VerticalAlignment="Center"  
                                                   />
                        </Grid>
                        <!-- #endregion Row 4: Application Window Snap -->

                        <TextBox Width="1" Height="1" Name="tbCleanFocus" Panel.ZIndex="-99" />
                    </StackPanel>

                    <!-- #region Show BusyIndicator over the page -->
                    <Border Background="#4C24273C">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <!-- Add a UXBusyIndicator from Robert -->
                        <UXControls:UXBusyIndicator BusyIndicatorType="Secondary" Width="64" Height="64"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    IsActive="{Binding IsBusy}" />
                    </Border>
                    <!-- #endregion Show BusyIndicator over the page -->
                </Grid>
            </Border>
        </UXControls:UXScrollViewer>
    </Grid>
</UserControl>