<UserControl x:Class="DDPM.Easy.Common.SplitCtrl4E"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DDPM.Easy.Common"
             mc:Ignorable="d"
             d:Background="Black"
             d:DesignHeight="60" d:DesignWidth="80"
             d:DataContext="{DynamicResource vmDesign}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="EAStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:SplitCtrlVM x:Key="vmDesign" IsVertical="True" SplitMode="Work"
                               IsEditable="True" HoveringCell="4E1" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource OuterBorderStyle}">
        <!-- BaseGrid -->
        <Grid>
            <!-- HorzBase -->
            <Grid Name="g0" Style="{StaticResource SplitBaseStyle_Horz}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding Settings[0], Mode=TwoWay}" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="{Binding Settings[1], Mode=TwoWay}" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="{Binding Settings[2], Mode=TwoWay}" />
                </Grid.ColumnDefinitions>

                <Grid Name="g1" Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="{Binding Settings[3], Mode=TwoWay}" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="{Binding Settings[4], Mode=TwoWay}" />
                    </Grid.RowDefinitions>

                    <Border Name="cell_4e1" Grid.Row="0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CellBorderStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HoveringCell}" Value="4e1">
                                        <Setter Property="BorderBrush" Value="{StaticResource  SplitCtrl_CellBorder_BdColor_Work_Hover}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <Border Name="cell_4e2" Grid.Row="2">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CellBorderStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HoveringCell}" Value="4e2">
                                        <Setter Property="BorderBrush" Value="{StaticResource  SplitCtrl_CellBorder_BdColor_Work_Hover}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <GridSplitter Name="h1" Grid.Row="1" Style="{StaticResource SplitterStyle_Horz}" />
                </Grid>

                <Border Name="cell_4e3" Grid.Column="2">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CellBorderStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HoveringCell}" Value="4e3">
                                    <Setter Property="BorderBrush" Value="{StaticResource  SplitCtrl_CellBorder_BdColor_Work_Hover}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <Border Name="cell_4e4" Grid.Column="4">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CellBorderStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HoveringCell}" Value="4e4">
                                    <Setter Property="BorderBrush" Value="{StaticResource  SplitCtrl_CellBorder_BdColor_Work_Hover}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <GridSplitter Name="v1" Grid.Column="1" Style="{StaticResource SplitterStyle_Vert}" />
                <GridSplitter Name="v2" Grid.Column="3" Style="{StaticResource SplitterStyle_Vert}" />
            </Grid>

            <!-- VertBase -->
            <Grid Name="G0" Style="{StaticResource SplitBaseStyle_Vert}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="{Binding Settings[0], Mode=TwoWay}" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="{Binding Settings[1], Mode=TwoWay}" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="{Binding Settings[2], Mode=TwoWay}" />
                </Grid.RowDefinitions>

                <Grid Name="G1" Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding Settings[4], Mode=TwoWay}" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="{Binding Settings[3], Mode=TwoWay}" />
                    </Grid.ColumnDefinitions>

                    <Border Name="cell_4E1" Grid.Column="2">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CellBorderStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HoveringCell}" Value="4E1">
                                        <Setter Property="BorderBrush" Value="{StaticResource  SplitCtrl_CellBorder_BdColor_Work_Hover}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <Border Name="cell_4E2" Grid.Column="0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CellBorderStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HoveringCell}" Value="4E2">
                                        <Setter Property="BorderBrush" Value="{StaticResource  SplitCtrl_CellBorder_BdColor_Work_Hover}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <GridSplitter Name="V1" Grid.Column="1" Style="{StaticResource SplitterStyle_Vert}" />
                </Grid>

                <Border Name="cell_4E3" Grid.Row="2">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CellBorderStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HoveringCell}" Value="4E3">
                                    <Setter Property="BorderBrush" Value="{StaticResource  SplitCtrl_CellBorder_BdColor_Work_Hover}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <Border Name="cell_4E4" Grid.Row="4">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CellBorderStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HoveringCell}" Value="4E4">
                                    <Setter Property="BorderBrush" Value="{StaticResource  SplitCtrl_CellBorder_BdColor_Work_Hover}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <GridSplitter Name="H1" Grid.Row="1" Style="{StaticResource SplitterStyle_Horz}" />
                <GridSplitter Name="H2" Grid.Row="3" Style="{StaticResource SplitterStyle_Horz}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>