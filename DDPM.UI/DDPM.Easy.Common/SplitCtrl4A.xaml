<UserControl x:Class="DDPM.Easy.Common.SplitCtrl4A"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DDPM.Easy.Common"
             mc:Ignorable="d"
             d:Background="Black"
             d:DesignHeight="60" d:DesignWidth="80"
             d:DataContext="{DynamicResource vmDesign}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="EAStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:SplitCtrlVM x:Key="vmDesign" IsVertical="True" SplitMode="Work"
                               IsEditable="True" HoveringCell="2A1" />
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- OuterBorder -->
    <Border Style="{StaticResource OuterBorderStyle}">
        <!-- BaseGrid -->
        <Grid>

            <!-- HorzBase -->
            <Grid Name="g0" Style="{StaticResource SplitBaseStyle_Horz}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding Settings[2], Mode=TwoWay}" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="{Binding Settings[3], Mode=TwoWay}" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="{Binding Settings[0], Mode=TwoWay}" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="{Binding Settings[1], Mode=TwoWay}" />
                </Grid.RowDefinitions>

                <Border Name="cell_4a1" Grid.Column="0" Grid.Row="0">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CellBorderStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HoveringCell}" Value="4a1">
                                    <Setter Property="BorderBrush" Value="{StaticResource SplitCtrl_CellBorder_BdColor_Work_Hover}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <Border Name="cell_4a2" Grid.Column="2" Grid.Row="0">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CellBorderStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HoveringCell}" Value="4a2">
                                    <Setter Property="BorderBrush" Value="{StaticResource SplitCtrl_CellBorder_BdColor_Work_Hover}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <Border Name="cell_4a3" Grid.Column="0" Grid.Row="2">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CellBorderStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HoveringCell}" Value="4a3">
                                    <Setter Property="BorderBrush" Value="{StaticResource SplitCtrl_CellBorder_BdColor_Work_Hover}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <Border Name="cell_4a4" Grid.Column="2" Grid.Row="2">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CellBorderStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HoveringCell}" Value="4a4">
                                    <Setter Property="BorderBrush" Value="{StaticResource SplitCtrl_CellBorder_BdColor_Work_Hover}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <GridSplitter Name="h1" Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource SplitterStyle_Horz}" />
                <GridSplitter Name="v1" Grid.Column="1" Grid.RowSpan="3" Style="{StaticResource SplitterStyle_Vert}" />
            </Grid>

            <!-- VertBase -->
            <Grid Name="G0" Style="{StaticResource SplitBaseStyle_Vert}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding Settings[1], Mode=TwoWay}" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="{Binding Settings[0], Mode=TwoWay}" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="{Binding Settings[2], Mode=TwoWay}" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="{Binding Settings[3], Mode=TwoWay}" />
                </Grid.RowDefinitions>

                <Border Name="cell_4A1" Grid.Column="2" Grid.Row="0">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CellBorderStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HoveringCell}" Value="4A1">
                                    <Setter Property="BorderBrush" Value="{StaticResource SplitCtrl_CellBorder_BdColor_Work_Hover}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <Border Name="cell_4A2" Grid.Column="2" Grid.Row="2">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CellBorderStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HoveringCell}" Value="4A2">
                                    <Setter Property="BorderBrush" Value="{StaticResource SplitCtrl_CellBorder_BdColor_Work_Hover}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <Border Name="cell_4A3" Grid.Column="0" Grid.Row="0">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CellBorderStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HoveringCell}" Value="4A3">
                                    <Setter Property="BorderBrush" Value="{StaticResource SplitCtrl_CellBorder_BdColor_Work_Hover}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <Border Name="cell_4A4" Grid.Column="0" Grid.Row="2">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CellBorderStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HoveringCell}" Value="4A4">
                                    <Setter Property="BorderBrush" Value="{StaticResource SplitCtrl_CellBorder_BdColor_Work_Hover}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <GridSplitter Name="H1" Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource SplitterStyle_Horz}" />
                <GridSplitter Name="V1" Grid.Column="1" Grid.Row="0" Grid.RowSpan="3" Style="{StaticResource SplitterStyle_Vert}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>