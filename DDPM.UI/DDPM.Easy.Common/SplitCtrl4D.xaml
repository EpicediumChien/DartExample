<UserControl x:Class="DDPM.Easy.Common.SplitCtrl4D"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DDPM.Easy.Common"
             mc:Ignorable="d" 
             d:Background="Black"
             d:DesignHeight="60" d:DesignWidth="80"
             d:DataContext="{DynamicResource vmDesign}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="EAStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <local:SplitCtrlVM x:Key="vmDesign" IsVertical="True" SplitMode="Edit"
                          IsEditable="True" HoveringCell="2A1"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- OuterBorder -->
    <Border Style="{StaticResource OuterBorderStyle}">
        <!-- BaseGrid -->
        <Grid>

            <!-- HorzBase -->
            <Grid Name="g0" Style="{StaticResource SplitBaseStyle_Horz}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding Settings[0], Mode=TwoWay}"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="{Binding Settings[1], Mode=TwoWay}"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="{Binding Settings[2], Mode=TwoWay}"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="{Binding Settings[3], Mode=TwoWay}"/>
                </Grid.ColumnDefinitions>

                <Border Name="cell_4d1" Grid.Column="0">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CellBorderStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HoveringCell}" Value="4d1">
                                    <Setter Property="BorderBrush" Value="{StaticResource SplitCtrl_CellBorder_BdColor_Work_Hover}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <Border Name="cell_4d2" Grid.Column="2">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CellBorderStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HoveringCell}" Value="4d2">
                                    <Setter Property="BorderBrush" Value="{StaticResource SplitCtrl_CellBorder_BdColor_Work_Hover}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <Border Name="cell_4d3" Grid.Column="4">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CellBorderStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HoveringCell}" Value="4d3">
                                    <Setter Property="BorderBrush" Value="{StaticResource SplitCtrl_CellBorder_BdColor_Work_Hover}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <Border Name="cell_4d4" Grid.Column="6">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CellBorderStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HoveringCell}" Value="4d4">
                                    <Setter Property="BorderBrush" Value="{StaticResource SplitCtrl_CellBorder_BdColor_Work_Hover}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <GridSplitter Name="v1" Grid.Column="1" Style="{StaticResource SplitterStyle_Vert}"/>
                <GridSplitter Name="v2" Grid.Column="3" Style="{StaticResource SplitterStyle_Vert}"/>
                <GridSplitter Name="v3" Grid.Column="5" Style="{StaticResource SplitterStyle_Vert}"/>     
            </Grid>

            <!-- VertBase -->
            <Grid Name="G0" Style="{StaticResource SplitBaseStyle_Vert}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="{Binding Settings[0], Mode=TwoWay}"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="{Binding Settings[1], Mode=TwoWay}"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="{Binding Settings[2], Mode=TwoWay}"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="{Binding Settings[3], Mode=TwoWay}"/>
                </Grid.RowDefinitions>

                <Border Name="cell_4D1" Grid.Row="0">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CellBorderStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HoveringCell}" Value="4D1">
                                    <Setter Property="BorderBrush" Value="{StaticResource SplitCtrl_CellBorder_BdColor_Work_Hover}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <Border Name="cell_4D2" Grid.Row="2">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CellBorderStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HoveringCell}" Value="4D2">
                                    <Setter Property="BorderBrush" Value="{StaticResource SplitCtrl_CellBorder_BdColor_Work_Hover}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <Border Name="cell_4D3" Grid.Row="4" >
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CellBorderStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HoveringCell}" Value="4D3">
                                    <Setter Property="BorderBrush" Value="{StaticResource SplitCtrl_CellBorder_BdColor_Work_Hover}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <Border Name="cell_4D4" Grid.Row="6">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CellBorderStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HoveringCell}" Value="4D4">
                                    <Setter Property="BorderBrush" Value="{StaticResource SplitCtrl_CellBorder_BdColor_Work_Hover}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <GridSplitter Name="H1" Grid.Row="1" Style="{StaticResource SplitterStyle_Horz}"/>
                <GridSplitter Name="H2" Grid.Row="3" Style="{StaticResource SplitterStyle_Horz}"/>
                <GridSplitter Name="H3" Grid.Row="5" Style="{StaticResource SplitterStyle_Horz}"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>