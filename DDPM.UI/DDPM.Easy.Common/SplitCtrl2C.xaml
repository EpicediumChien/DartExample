<UserControl x:Class="DDPM.Easy.Common.SplitCtrl2C"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DDPM.Easy.Common"
             mc:Ignorable="d"
             d:Background="Black"
             d:DesignHeight="60" d:DesignWidth="80"
             d:DataContext="{DynamicResource vmDesign}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="EAStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:SplitCtrlVM x:Key="vmDesign" IsVertical="False" SplitMode="Icon"
                               IsEditable="True" HoveringCell="2c1" />
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- OuterBorder -->
    <Border Style="{StaticResource OuterBorderStyle}">
        <!-- BaseGrid -->
        <Grid>

            <!-- HorzBase -->
            <Grid Name="g0" Style="{StaticResource SplitBaseStyle_Horz}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding Settings[0], Mode=TwoWay}" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="{Binding Settings[1], Mode=TwoWay}" />
                </Grid.ColumnDefinitions>

                <Border Name="cell_2c1" Grid.Column="0" >
                    <Border.Style>
                       <Style TargetType="Border" BasedOn="{StaticResource CellBorderStyle}">
                           <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsWorkMode}" Value="True"/>
                                        <Condition Binding="{Binding HoveringCell}" Value="2c1"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="BorderBrush" Value="{StaticResource SplitCtrl_CellBorder_BdColor_Work_Hover}" />
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsAwsMode}" Value="True"/>
                                        <Condition Binding="{Binding HoveringCell}" Value="2c1"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="{StaticResource SplitCtrl_CellBorder_BkColor_Aws_Hover}"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                       </Style>
                   </Border.Style>
                 </Border>
                <local:CellBorder x:Name="cellBd_2c1" Grid.Column="0" CellName="2c1" CornerRadius="6,0,0,6">
                    <!-- 
                    <local:CellBorder.Style>
                        <Style TargetType="local:CellBorder" BasedOn="{StaticResource  CellBorderStyle2}">
                            <Setter Property="BorderBrush" Value="{StaticResource SplitCtrl_CellBorder_BdColor_Work_Normal}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsHover, ElementName=cellBd_2c1}" Value="True">
                                    <Setter Property="BkBrush" Value="{StaticResource SplitCtrl_CellBorder_BdColor_Work_Hover}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </local:CellBorder.Style>
                    -->
                </local:CellBorder>
                
                <Border Name="cell_2c2" Grid.Column="2">
                     <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CellBorderStyle}">
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsWorkMode}" Value="True"/>
                                        <Condition Binding="{Binding HoveringCell}" Value="2c2"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="BorderBrush" Value="{StaticResource SplitCtrl_CellBorder_BdColor_Work_Hover}" />
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsAwsMode}" Value="True"/>
                                        <Condition Binding="{Binding HoveringCell}" Value="2c2"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="{StaticResource SplitCtrl_CellBorder_BkColor_Aws_Hover}"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <local:CellBorder x:Name="cellBd_2c2" Grid.Column="2" CellName="2c2" CornerRadius="0,6,6,0">
                    <!-- 
                    <local:CellBorder.Style>
                        <Style TargetType="local:CellBorder" BasedOn="{StaticResource  CellBorderStyle2}">
                            <Setter Property="BorderBrush" Value="{StaticResource SplitCtrl_CellBorder_BdColor_Work_Normal}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsHover, ElementName=cellBd_2c2}" Value="True">
                                    <Setter Property="BkBrush" Value="{StaticResource SplitCtrl_CellBorder_BdColor_Work_Hover}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </local:CellBorder.Style>
                    -->
                </local:CellBorder>

                <GridSplitter Name="v1" Grid.Column="1" Style="{StaticResource SplitterStyle_Vert}" />
            </Grid>

            <!-- VertBase -->
            <Grid Name="G0" Style="{StaticResource SplitBaseStyle_Vert}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="{Binding Settings[0], Mode=TwoWay}" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="{Binding Settings[1], Mode=TwoWay}" />
                </Grid.RowDefinitions>

                <Border Name="cell_2C1" Grid.Row="0">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CellBorderStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HoveringCell}" Value="2C1">
                                    <Setter Property="BorderBrush" Value="{StaticResource SplitCtrl_CellBorder_BdColor_Work_Hover}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <Border Name="cell_2C2" Grid.Row="2">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CellBorderStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HoveringCell}" Value="2C2">
                                    <Setter Property="BorderBrush" Value="{StaticResource SplitCtrl_CellBorder_BdColor_Work_Hover}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <GridSplitter Name="H1" Grid.Row="1" Style="{StaticResource SplitterStyle_Horz}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>