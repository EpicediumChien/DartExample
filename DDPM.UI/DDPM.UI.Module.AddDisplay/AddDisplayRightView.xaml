<UserControl x:Class="DDPM.UI.Module.AddDisplay.AddDisplayRightView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             xmlns:lang="clr-namespace:DDPM.UI.Resources.Helper;assembly=DDPM.UI.Resources"
             mc:Ignorable="d"
             d:DesignHeight="527" d:DesignWidth="958" 
             KeyboardNavigation.TabNavigation="Local"
             SizeChanged="UserControl_SizeChanged">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <Style x:Key="TextStyle1" TargetType="UXControls:UXTextBlock">
                <Setter Property="Foreground" Value="{DynamicResource AddDeviceTextStyle1_TxtColor}" />
                <Setter Property="FontFamily" Value="Roboto" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="LineHeight" Value="24" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>
            <Style x:Key="Border1" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource AddDeviceBorder1_BgColor}" />
                <Setter Property="CornerRadius" Value="13" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="BorderBrush" Value="{DynamicResource Border1BorderBrush}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <StackPanel Orientation="Vertical">
            <!-- Robert_Lin, 2025-2-8 for Narrator, for TextBlocks add TabIndex and Focusable -->
                <UXControls:UXTextBlock Name="txtCaption" FontFamily="Roboto" FontSize="20" FontWeight="Normal"
                                    Margin="18,24,0,0" Foreground="{DynamicResource AddDeviceTxtCaption_TxtColor}"
                                        Focusable="True" KeyboardNavigation.TabIndex="1"
                                    VerticalAlignment="Top" HorizontalAlignment="Left" Text="{Binding [WiredConnection], Source={x:Static lang:LangHelper.Instance}}"/>
                <UXControls:UXTextBlock Name="txtWiredConnection" Margin="19,0,0,0" FontFamily="Roboto"
                                    HorizontalAlignment="Left" Foreground="{DynamicResource AddDeviceTxtCaption_TxtColor}" FontSize="14" FontWeight="Normal" TextWrapping="WrapWithOverflow"/>
                <Border Style="{StaticResource Border1}" Margin="16,8,16,0" x:Name="contentBorder">
                    <Grid>
                        <StackPanel Orientation="Vertical" Margin="0,0,0,13">
                            <Image Margin="14,14" Source="/DDPM.UI.Resources;component/Resources/Images/WiredConnection.png" Stretch="Uniform"
                               HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="" Width="46" Height="46" />
                            <UXControls:UXTextBlock Name="txtStep1" Margin="15,10,10,10" Style="{StaticResource TextStyle1}" 
                                                    Focusable="True" KeyboardNavigation.TabIndex="2"
                                                Text="{Binding [AddDevice.Display.1], Source={x:Static lang:LangHelper.Instance}}" 
                                                    AutomationProperties.Name="{Binding [AddDevice.Display.1], Source={x:Static lang:LangHelper.Instance}}"
                                                TextWrapping="WrapWithOverflow"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
    </Grid>
</UserControl>