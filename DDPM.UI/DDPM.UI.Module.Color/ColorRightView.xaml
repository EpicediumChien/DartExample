<UserControl x:Class="DDPM.UI.Module.Color.ColorRightView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DDPM.UI.Module.Color"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             xmlns:common="clr-namespace:DDPM.UI.Common;assembly=DDPM.UI.Common"
             xmlns:lang="clr-namespace:DDPM.UI.Resources.Helper;assembly=DDPM.UI.Resources"
             mc:Ignorable="d"
             d:DesignHeight="850" d:DesignWidth="800" Loaded="UserControl_Loaded" Unloaded="UserControl_UnLoaded">
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DefaultTheme_TxtColor}" />
        </Style>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <common:InvertedBooleanToVisibilityConverter x:Key="InvertedBooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid>
        <!--Elsa 202504011 for PIMS-348407 change HorizontalScrollBarVisibility="Disabled" to HorizontalScrollBarVisibility="Hidden",add VerticalScrollBarVisibility="Auto"-->
        <!--20250414 Chewlin for PIMS-348204 ADD UseFadingScrolling="False"-->
        <UXControls:UXScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Auto" UseFadingScrolling="False">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Border
                            Width="648"
                            Height="53"
                            Margin="0,5,0,15"
                            CornerRadius="5"
                            Visibility="{Binding GreayoutAlart}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="7" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Border
                                            Grid.Column="0"
                                            Width="7"
                                            CornerRadius="5,0,0,5" />
                                <Grid
                                            Grid.Column="1"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <!-- Robert_Lin 2025-2-26 found it use static color (White), change it to DynamicResource -->
                                    <Path Data="M9 1.125C13.3313 1.125 16.875 4.66875 16.875 9C16.875 13.3312 13.3313 16.875 9 16.875C4.66875 16.875 1.125 13.3312 1.125 9C1.125 4.66875 4.66875 1.125 9 1.125ZM9 0C4.05 0 0 4.05 0 9C0 13.95 4.05 18 9 18C13.95 18 18 13.95 18 9C18 4.05 13.95 0 9 0Z" Fill="{DynamicResource InfoIconColor}" />
                                    <Path Data="M9.5625 7.3125L8.4375 7.3125L8.4375 14.2875L9.5625 14.2875L9.5625 7.3125Z" Fill="{DynamicResource InfoIconColor}" />
                                    <Path Data="M9 5.40039C9.46599 5.40039 9.84375 5.02263 9.84375 4.55664C9.84375 4.09065 9.46599 3.71289 9 3.71289C8.53401 3.71289 8.15625 4.09065 8.15625 4.55664C8.15625 5.02263 8.53401 5.40039 9 5.40039Z" Fill="{DynamicResource InfoIconColor}" />
                                </Grid>
                            </Grid>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock
                        FontFamily="Roboto"
                                        Focusable="True" KeyboardNavigation.TabIndex="102"
                        FontSize="13">
                        <Run Text="{Binding [ColorMsg.0], Source={x:Static lang:LangHelper.Instance}, Mode=OneWay}" />
                        <Hyperlink Click="Hyperlink_Click">
                            <Hyperlink.Style>
                                <Style TargetType="Hyperlink">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="#31A2E3" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Hyperlink.Style>
                            <Run Text="{Binding [Brightness.2], Source={x:Static lang:LangHelper.Instance}, Mode=OneWay}" />
                        </Hyperlink>
                        <Run Text="{Binding [Brightness.3], Source={x:Static lang:LangHelper.Instance}, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
                <Grid Grid.Row="1" Margin="0,0,0,15"
                      Visibility="{Binding SupportedHDR}"
                      IsEnabled="{Binding HDREnable}"
                      Opacity="{Binding HDROpacity}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource RightGroupBorderStyle}">
                        <Grid Height="45">
                            <UXControls:UXTextBlock Text="{Binding [HDR], Source={x:Static lang:LangHelper.Instance}}"
                                                    FontSize="16"
                                                    Foreground="{DynamicResource TextBlock_ForegroundColor}"
                                                    TextBlockSemanticColorType="Light"
                                                    TextBlockType="Caption"
                                                    Focusable="True"
                                                    KeyboardNavigation.TabIndex="107"
                                                    x:Name="labelHDR"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Left" />
                            <UXControls:UXToggleSwitch IsChecked="{Binding Path= HDRStatus}"
                                                       ContentTextVisibility="True"
                                                       Content="{Binding Path=HDRStatus_String}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       Focusable="True"
                                                       KeyboardNavigation.TabIndex="108"
                                                       AutomationProperties.LabeledBy="{Binding ElementName=labelHDR}"
                                                       Foreground="{DynamicResource TextBlock_ForegroundColor}" />
                        </Grid>
                    </Border>
                </Grid>
                <!-- RightGroupBorder.Manual -->
                <Grid Grid.Row="2"
                      Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    
                    <Border 
                        IsEnabled="{Binding ColorEnable}"
                        Opacity="{Binding ColorOpacity}"
                        Style="{StaticResource RightGroupBorderStyle}">

                        <!-- Group: Manual -->
                        <!--
                        <Expander x:Name="Expander_Manual" Style="{StaticResource GroupExpanderStyle}" Expanded="expanderHasExpanded">
                        -->
                        <!-- Robert_Lin 2025-2-26 For Narrator
                        If Expander KeyboardNavigation.TabNavigation="Cycle", then the [Tab] navigation will be cycled inside the expander.
                        For example, if the focus is on the last control of the expander, press [Tab] will move the focus to the first control of the expander.
                        Suggest to change "Cycle" to "Continue".
                        
                        -->
                        <Expander x:Name="Expander_Manual" Style="{StaticResource RightExpanderStyle}" Expanded="expanderHasExpanded" 
                                  KeyboardNavigation.TabNavigation="{Binding TabNavigation}" IsTabStop="{Binding isTabStoppable}" 
                                  KeyboardNavigation.AcceptsReturn="{Binding isTabStoppable}" KeyboardNavigation.IsTabStop="{Binding isTabStoppable}" 
                                  PreviewKeyDown="colorManualExpander_PreviewKeyDown"  >
                            <Expander.Header>
                                <!-- Group Header: Manual-->
                                <Grid Height="20">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>

                                    <UXControls:UXTextBlock Margin="30,0,0,0" Text="{Binding [Manual], Source={x:Static lang:LangHelper.Instance}}" FontSize="20"
                                                            TextBlockType="Caption"
                                                            Focusable="True" KeyboardNavigation.TabIndex="110"
                                                            Background="{DynamicResource Transparent}"
                                                            VerticalAlignment="Center" HorizontalAlignment="Left" />

                                    <Image Grid.Column="1" Visibility="{Binding LockMaskVisible}" 
                                            Source="pack://application:,,,/DDPM.UI.Common;component/Resources/Lock.png"
                                            VerticalAlignment="Center" HorizontalAlignment="Center" Width="16" Height="16">
                                        <Image.ToolTip>
                                            <ToolTip>
                                                <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                                    <Border.Resources>
                                                        <Style BasedOn="{StaticResource Tooltip_TextBlockStyle}" TargetType="TextBlock" />
                                                    </Border.Resources>
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding [ITLockToolTip.0], Source={x:Static lang:LangHelper.Instance}}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </ToolTip>
                                        </Image.ToolTip>
                                    </Image>

                                </Grid>
                            </Expander.Header>

                            <Expander.Content>
                                <Grid>
                                    <Border Margin="0,20,0,0" Background="Transparent">
                                        <Grid Height="76">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <UXControls:UXTextBlock Text="{Binding [Color.14], Source={x:Static lang:LangHelper.Instance}}" Grid.Column="0" FontSize="16"
                                                                    TextBlockType="Display1"
                                                                    Name="labelColorManualProfile" Focusable="True"
                                                                    KeyboardNavigation.TabIndex="115"
                                                                    Background="{DynamicResource Transparent}"
                                                                    VerticalAlignment="Center" HorizontalAlignment="Left" />

                                            <!--
                                            <UXControls:UXComboBox x:Name="cbManualPreset" Grid.Column="2"
                                            Background="{StaticResource UXComboBox_Background}"
                                            BorderBrush="{StaticResource UXComboBox_BorderBrush}"
                                            BorderThickness="{StaticResource Tooltip_BdThick}"
                                            Foreground="{StaticResource UXComboBox_Foreground}"
                                            Width="184"
                                            ItemsSource="{Binding ColorPresets_ItemsCollection}"
                                            SelectionChanged="cbManualPreset_SelectionChanged" />
                                            -->

                                            <!-- Robert_Lin 2025-2-26 for Narrator Try to modify KeyboardNavigation.* properties
                                            OLD:
                                            KeyboardNavigation.TabNavigation="{Binding TabNavigation}"
                                            -->
                                            <ComboBox x:Name="cbManualPreset" Grid.Column="2" Style="{StaticResource DdpmComboBoxStyle}" Width="184" Height="40"
                                                      KeyboardNavigation.TabIndex="116"
                                                      AutomationProperties.LabeledBy="{Binding ElementName=labelColorManualProfile}"
                                                    SelectionChanged="cbManualPreset_SelectionChanged"
                                                    ItemsSource="{Binding ColorPresets_ItemsCollection}"
                                                    SelectedIndex="{Binding ColorPresetSelectedIndex}"
                                                      IsTabStop="{Binding isTabStoppable}" KeyboardNavigation.AcceptsReturn="{Binding isTabStoppable}" KeyboardNavigation.IsTabStop="{Binding isTabStoppable}" />
                                        </Grid>
                                    </Border>
                                    <Border Opacity="0.6"  Visibility="{Binding LockMaskVisible}"/>
                                </Grid>

                            </Expander.Content>
                        </Expander>
                    </Border>
                    <Rectangle Height="1" Fill="{DynamicResource GroupExpanderHeaderBottomLineColor}" VerticalAlignment="Top" Margin="0, 60, 0, 0"/>
                </Grid>

                <!-- RightGroupBorder.Auto -->
                <Grid Grid.Row="3"
                      Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border 
                        IsEnabled="{Binding ColorEnable}"
                        Opacity="{Binding ColorOpacity}"
                        Style="{StaticResource RightGroupBorderStyle}">

                        <Expander  x:Name="Expander_Auto" Style="{StaticResource RightExpanderStyle}" Expanded="expanderHasExpanded"
                                   KeyboardNavigation.TabNavigation="{Binding TabNavigation}" IsTabStop="{Binding isTabStoppable}" 
                                   KeyboardNavigation.AcceptsReturn="{Binding isTabStoppable}" 
                                   KeyboardNavigation.IsTabStop="{Binding isTabStoppable}" PreviewKeyDown="colorAutoExpander_PreviewKeyDown" >
                            <Expander.Header>
                                <!-- Group Header: Auto-->
                                <Grid Height="20">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>

                                    <UXControls:UXTextBlock  Margin="30,0,0,0" Text="{Binding [Auto], Source={x:Static lang:LangHelper.Instance}}" FontSize="20"
                                                            TextBlockType="Caption"
                                                             Focusable="True" KeyboardNavigation.TabIndex="130"
                                                            VerticalAlignment="Center" HorizontalAlignment="Left" />
                                    <Image Grid.Column="1" Visibility="{Binding LockMaskVisible}" 
                                            Source="pack://application:,,,/DDPM.UI.Common;component/Resources/Lock.png"
                                            VerticalAlignment="Center" HorizontalAlignment="Center" Width="16" Height="16">
                                        <Image.ToolTip>
                                            <ToolTip>
                                                <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                                    <Border.Resources>
                                                        <Style BasedOn="{StaticResource Tooltip_TextBlockStyle}" TargetType="TextBlock" />
                                                    </Border.Resources>
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding [ITLockToolTip.0], Source={x:Static lang:LangHelper.Instance}}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </ToolTip>
                                        </Image.ToolTip>
                                    </Image>
                                </Grid>
                            </Expander.Header>

                            <Expander.Content>
                                <Grid>
                                    <Border Margin="0,35,0,0" Background="Transparent">
                                        <StackPanel>

                                            <UXControls:UXTextBlock Text="{Binding [Color.7], Source={x:Static lang:LangHelper.Instance}}" FontSize="16"
                                                                    TextBlockType="Display1" Margin="0,0,0,24"
                                                                    Focusable="True" KeyboardNavigation.TabIndex="135"
                                                                    VerticalAlignment="Center" HorizontalAlignment="Left" />

                                            <!-- RightPartBorder.App -->
                                            <Border Style="{StaticResource RightPartBorderStyle}" Padding="16">
                                                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <ListBox Background="{DynamicResource DefaultTheme_ListBoxBkColor}"
                                                                 Margin="0,0,0,16" Grid.Row="0"
                                                                 x:Name="lb_AppList"
                                                                 KeyboardNavigation.TabIndex="136"
                                                                 ItemsSource="{Binding AppsList, UpdateSourceTrigger=PropertyChanged}"
                                                                 HorizontalContentAlignment="Stretch"
                                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                                 ScrollViewer.CanContentScroll="True"
                                                                 PreviewDragEnter="lb_AppList_PreviewDragEnter"
                                                                 AllowDrop="True"
                                                                 KeyboardNavigation.TabNavigation="{Binding TabNavigation}" IsTabStop="{Binding isTabStoppable}" KeyboardNavigation.IsTabStop="{Binding isTabStoppable}"
                                                                 >
                                                        <ListBox.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="5" />
                                                            </Style>
                                                        </ListBox.Resources>
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,4">

                                                                    <Grid.Style>
                                                                        <Style TargetType="Grid">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding LockMaskVisible}" Value="Visible">
                                                                                    <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding LockMaskVisible}" Value="Collapsed">
                                                                                    <Setter Property="KeyboardNavigation.TabNavigation" Value="Local" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Grid.Style>


                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <!-- App Icon-->
                                                                        <ColumnDefinition Width="*" />
                                                                        <!-- App Name-->
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <!-- Preset for App, combobox-->
                                                                        <ColumnDefinition Width="12" />
                                                                        <!--Delete button-->
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>

                                                                    <Image Grid.Column="0" x:Name="appIcon" Source="{Binding AppIcon}"
                                                                               Width="40" Stretch="Uniform" />

                                                                    <TextBlock Grid.Column="1" x:Name="appName"
                                                                                   Text="{Binding AppName , UpdateSourceTrigger=PropertyChanged}"
                                                                                   Focusable="True"
                                                                                   VerticalAlignment="Center" HorizontalAlignment="Left"
                                                                                   Foreground="{DynamicResource DefaultTheme_TxtColor}" />

                                                                    <!-- -->
                                                                    <ComboBox Grid.Column="2" x:Name="appPreset"
                                                                                  Style="{StaticResource DdpmComboBoxStyle}"
                                                                                  ItemsSource="{Binding SupportPreset, UpdateSourceTrigger=PropertyChanged}" SelectedIndex="{Binding AppPresetIdx, UpdateSourceTrigger=PropertyChanged}" Width="150"
                                                                                  VerticalAlignment="Center" HorizontalAlignment="Stretch"  SelectionChanged="appPreset_SelectionChanged" KeyboardNavigation.TabNavigation="{Binding TabNavigation}" IsTabStop="{Binding isTabStoppable}" KeyboardNavigation.AcceptsReturn="{Binding isTabStoppable}" KeyboardNavigation.IsTabStop="{Binding isTabStoppable}"  />

                                                                    <!--
                                                                        <UXControls:UXComboBox Grid.Column="2" x:Name="appPreset"
                                                                        Background="{StaticResource UXComboBox_Background}"
                                                                        BorderBrush="{StaticResource UXComboBox_BorderBrush}"
                                                                        BorderThickness="{StaticResource Tooltip_BdThick}"
                                                                        Foreground="{StaticResource UXComboBox_Foreground}"
                                                                        ItemsSource="{Binding SupportPreset, UpdateSourceTrigger=PropertyChanged}"
                                                                        SelectedIndex="{Binding AppPresetIdx, UpdateSourceTrigger=PropertyChanged}"
                                                                        Width="180" Height="40"
                                                                        VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                                                        SelectionChanged="appPreset_SelectionChanged" />
                                                                        -->

                                                                    <Button Grid.Column="3" x:Name="appDeleteBtn" Content="X"
                                                                                Background="Transparent"
                                                                                Visibility="{Binding IsDeleteAble, UpdateSourceTrigger=PropertyChanged}"
                                                                                BorderBrush="Transparent"
                                                                                Foreground="{DynamicResource DefaultTheme_PathColor}"
                                                                                Click="appDeleteBtn_Click" KeyboardNavigation.TabNavigation="{Binding TabNavigation}" IsTabStop="{Binding isTabStoppable}" KeyboardNavigation.AcceptsReturn="{Binding isTabStoppable}" KeyboardNavigation.IsTabStop="{Binding isTabStoppable}" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                        <ListBox.ItemContainerStyle>
                                                            <Style TargetType="ListBoxItem">
                                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"></Setter>
                                                            </Style>
                                                        </ListBox.ItemContainerStyle>
                                                    </ListBox>

                                                    <UXControls:UXButton Name="btn_AddApp" Grid.Row="1" Content="{Binding [Color.0], Source={x:Static lang:LangHelper.Instance}}"
                                                                             KeyboardNavigation.TabIndex="137"
                                                                             ButtonType="Secondary" ButtonSemanticColorType="Neutral" HorizontalAlignment="Center"
                                                                             Style="{StaticResource UXButton_WhiteFrame}" Padding="24,8" Click="btn_AddApp_Click" 
                                                                             KeyboardNavigation.TabNavigation="{Binding TabNavigation}" IsTabStop="{Binding isTabStoppable}" 
                                                                             KeyboardNavigation.AcceptsReturn="{Binding isTabStoppable}" KeyboardNavigation.IsTabStop="{Binding isTabStoppable}" />

                                                    <!--
                                                        <Button x:Name="btn_AddApp" Grid.Row="2" Content="Add Application" VerticalAlignment="Top" Height="30" Width="140" Margin="0,60,0,0"
                                                        Foreground="White" Background="CornflowerBlue" BorderBrush="White"  Click="btn_AddApp_Click" />
                                                        -->
                                                </Grid>
                                            </Border>
                                        </StackPanel>

                                    </Border>
                                    <Border Opacity="0.6" Visibility="{Binding LockMaskVisible}"/>
                                </Grid>

                            </Expander.Content>
                        </Expander>
                    </Border>
                    <Rectangle Height="1" Fill="{DynamicResource GroupExpanderHeaderBottomLineColor}" VerticalAlignment="Top" Margin="0, 60, 0, 0"/>
                </Grid>

                <!-- RightGroupBorder.Nightlight -->
                <Border Grid.Row="4"
                        Margin="0,0,0,15"
                        IsEnabled="{Binding ColorEnable}"
                        Opacity="{Binding ColorOpacity}"
                        Style="{StaticResource RightGroupBorderStyle}">
                    <Grid x:Name="Nightlight_bar">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Rectangle Fill="Transparent" RadiusX="5" RadiusY="5" Grid.Column="0" Grid.ColumnSpan="2" Height="40" />
                        <Grid Grid.Column="0" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding [Color.8], Source={x:Static lang:LangHelper.Instance}}"  FontSize="14" FontFamily="Noto Sans" VerticalAlignment="Center" 
                                           Focusable="True" KeyboardNavigation.TabIndex="150"
                                           Grid.Column="0" Margin="16,0,0,0" HorizontalAlignment="Left" />
                            <TextBlock Text="(" Grid.Column="1"  FontFamily="Noto Sans" FontSize="14" VerticalAlignment="Center"  HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding NightlightStatus}" Grid.Column="2" VerticalAlignment="Center" FontFamily="Noto Sans" FontSize="14" HorizontalAlignment="Center" 
                                           Focusable="True" KeyboardNavigation.TabIndex="152"/>
                            <TextBlock Text=")" Grid.Column="3" FontFamily="Noto Sans" FontSize="14" VerticalAlignment="Center"  HorizontalAlignment="Center" />
                            <!--Elsa 20250401 for PIMS-348390 remove ToolTipService.Placement="Center" ToolTipService.VerticalOffset="40"-->
                            <Border Grid.Column="4" Margin="10,0,0,0" Background="{StaticResource FakeTransparent}">
                                <ContentControl Template="{StaticResource icon_Info}" Width="16" Height="16"/>
                                <Border.ToolTip>
                                    <!--Elsa 20250401 for PIMS-348390 change VerticalOffset="8" to VerticalOffset="12" HorizontalOffset="6" to HorizontalOffset="2",add MaxWidth="272" Opened="toolTip_Opened"-->
                                    <ToolTip Placement="Top" VerticalOffset="12" HorizontalOffset="2" MaxWidth="272" Opened="toolTip_Opened">
                                        <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                            <!--Elsa 20250401 for PIMS-348390 add MaxWidth="230" TextWrapping="WrapWithOverflow"-->
                                            <TextBlock Text="{Binding [Color.9], Source={x:Static lang:LangHelper.Instance}}" MaxWidth="230" TextWrapping="WrapWithOverflow"
                                                           Style="{StaticResource Tooltip_TextBlockStyle}" />
                                        </Border>
                                    </ToolTip>
                                </Border.ToolTip>
                            </Border>
                        </Grid>
                        <UXControls:UXLink Name="nightlight_config" Grid.Column="1" Content="{Binding [WindowsSettings], Source={x:Static lang:LangHelper.Instance}}" Click="nightlight_config_Click"
                                               IconPosition="IconRight" LinkSize="Medium" LinkColorScheme="Primary"
                                               KeyboardNavigation.TabIndex="156"
                                               LinkType="InLine" Icon="M29.86 29.86h-27.74v-27.72h13.88v-2.14h-16v32h32v-16h-2.12zM20.86 0v2.12h7.56l-15.060 15.060 1.52 1.5 14.98-15v7.46h2.14v-11.14z"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" Height="40">
                            <UXControls:UXLink.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                            </UXControls:UXLink.Resources>
                        </UXControls:UXLink>
                    </Grid>
                </Border>

                <!-- RightGroupBorder.AdvancedSettings -->
                <Border Grid.Row="5"
                         IsEnabled="{Binding ColorEnable}"
                         Opacity="{Binding ColorOpacity}"
                         Style="{StaticResource RightGroupBorderStyle}" 
                         Visibility="{Binding IsisAdvanced_Settings, UpdateSourceTrigger=PropertyChanged}"
                         Padding="16"
                         Margin="0,0,0,16"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Stretch">
                    <Border.Resources>
                        <Style TargetType="Expander">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Expander">
                                        <Border Background="Transparent">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <!-- Header (ToggleButton) -->
                                                    <RowDefinition Height="*"/>
                                                    <!-- Expandable Content -->
                                                </Grid.RowDefinitions>

                                                <!-- Expander Header -->
                                                <ToggleButton Name="HeaderSite"
                                                              Grid.Row="0"
                                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                                              AutomationProperties.Name="AdvancedSettings Expander"
                                                              Style="{StaticResource NoHoverToggleButtonStyle}"
                                                              Focusable="True"
                                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                                    <!--DockPanel.Dock="Top"-->
                                                    <StackPanel Orientation="Horizontal">
                                                        <ContentPresenter Content="{TemplateBinding Header}" 
                                                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                                          ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}"
                                                                          Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=StackPanel}}"
                                                                          HorizontalAlignment="Stretch" 
                                                                          VerticalAlignment="Stretch"/>
                                                    </StackPanel>
                                                </ToggleButton>
                                                <!-- Wrap ContentPresenter inside a Border -->
                                                <ContentPresenter Name="ExpandSite" 
                                                                  Grid.Row="1"
                                                                  ContentSource="Content"
                                                                  Margin="0,40,0,0"
                                                                  Visibility="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Border.Resources>
                    <Expander x:Name="Expander_Advanced_Settings"  Visibility="{Binding IsisAdvanced_Settings, UpdateSourceTrigger=PropertyChanged}"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0"
                              KeyboardNavigation.TabNavigation="{Binding TabNavigation}" IsTabStop="{Binding isTabStoppable}"
                              KeyboardNavigation.AcceptsReturn="{Binding isTabStoppable}" KeyboardNavigation.IsTabStop="{Binding isTabStoppable}" PreviewKeyDown="advancedSettingsExpander_PreviewKeyDown">
                        <Expander.Resources>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </Expander.Resources>
                        <Expander.Header>
                            <Grid Height="24" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <UXControls:UXTextBlock Grid.Column="0"
                                                        Margin="0,0,8,0" 
                                                        Text="{Binding [AdvancedSettings], Source={x:Static lang:LangHelper.Instance}}" FontSize="15" 
                                                        TextBlockType="Caption" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                        Focusable="True" KeyboardNavigation.TabIndex="160"
                                                        VerticalAlignment="Center" HorizontalAlignment="Left" />
                                <ContentControl Grid.Column="1" Visibility="{Binding LockMaskVisible}" VerticalAlignment="Center"
                                                    Template="{StaticResource icon_Lock}" Foreground="{DynamicResource LockIcon_Fill}">

                                    <ContentControl.ToolTip>

                                        <ToolTip>
                                            <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                                <Border.Resources>
                                                    <Style BasedOn="{StaticResource Tooltip_TextBlockStyle}" TargetType="TextBlock" />
                                                </Border.Resources>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding [ITLockToolTip.0], Source={x:Static lang:LangHelper.Instance}}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </ToolTip>
                                    </ContentControl.ToolTip>
                                </ContentControl>
                                <ContentControl Grid.Column="2" x:Name="UpArrowIcon" Width="12" Height="12" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,11,2" Template="{StaticResource icon_UpArrow}"
                                                Visibility="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <ContentControl Grid.Column="2" x:Name="DownArrowIcon" Width="12" Height="12" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,11,2" Template="{StaticResource icon_DownArrow}"
                                                Visibility="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}, Converter={StaticResource InvertedBooleanToVisibilityConverter}}"/>
                            </Grid>
                        </Expander.Header>

                        <Expander.Content>

                            <Grid>
                                <Border>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.5*" />
                                            <ColumnDefinition Width="8*" />
                                            <ColumnDefinition Width="1.5*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="1*" />
                                            <!--Color Management -->
                                            <RowDefinition Height="15" />
                                            <!-- space-->
                                            <RowDefinition Height="0.8*" />
                                            <!--Auto-adjust the ICC Color profile based on color preset-->
                                            <RowDefinition Height="*" />
                                            <!--Auto-adjust the color preset based on ICC Color profile-->
                                            <RowDefinition Height="1.5*" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Column="0" Margin="0,0,0,0">
                                            <StackPanel Grid.Column="0" Margin="0,0,0,0" Orientation="Horizontal" HorizontalAlignment="left">
                                            </StackPanel>
                                        </Grid>

                                        <Grid Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" Margin="0,0,0,0">
                                            <StackPanel Margin="0,0,0,0" Orientation="Horizontal" HorizontalAlignment="left">
                                                <TextBlock Text="{Binding [Color.11], Source={x:Static lang:LangHelper.Instance}}"  FontSize="14" FontFamily="Noto Sans" 
                                                               Focusable="True" KeyboardNavigation.TabIndex="165"
                                                               Name="labelColorManagement"
                                                               VerticalAlignment="Center" Grid.Column="0" Margin="0" HorizontalAlignment="Left" />
                                                <!--Elsa 20250407 for PIMS-348390 remove ToolTipService.Placement="Center" ToolTipService.VerticalOffset="40"-->
                                                <Border Grid.Column="1" Margin="10,0,0,0" Background="{StaticResource FakeTransparent}">
                                                    <ContentControl Template="{StaticResource icon_Info}" Width="16" Height="16"/>
                                                    <Border.ToolTip>
                                                        <!--Elsa 20250407 for PIMS-348390 change VerticalOffset="45" to VerticalOffset="12" HorizontalOffset="50" to HorizontalOffset="2" add MaxWidth="272"-->
                                                        <ToolTip Placement="Top" VerticalOffset="12" HorizontalOffset="2" MaxWidth="272">
                                                            <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                                                <!--Elsa 20250407 for PIMS-348390 add MaxWidth="230" TextWrapping="WrapWithOverflow"-->
                                                                <TextBlock Text="{Binding [Color.12], Source={x:Static lang:LangHelper.Instance}}" MaxWidth="230" TextWrapping="WrapWithOverflow"
                                                                               Style="{StaticResource Tooltip_TextBlockStyle}" />
                                                            </Border>
                                                        </ToolTip>
                                                    </Border.ToolTip>
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Grid.Column="3" Grid.Row="0"  Margin="0,0,0,0">

                                            <UXControls:UXToggleSwitch
                                                    Name="ColorManagement_ToggleSwitch"
                                                    Grid.Column="0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    KeyboardNavigation.TabIndex="168"
                                                    AutomationProperties.LabeledBy="{Binding ElementName=labelColorManagement}"
                                                    Click="Color_Management_Switch_Click"
                                                    ContentPlacement="Left"
                                                    ContentTextVisibility="True" KeyboardNavigation.TabNavigation="{Binding TabNavigation}" IsTabStop="{Binding isTabStoppable}" KeyboardNavigation.AcceptsReturn="{Binding isTabStoppable}" KeyboardNavigation.IsTabStop="{Binding isTabStoppable}" />
                                        </Grid>

                                        <Grid Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2" Margin="0">
                                            <UXControls:UXRadioButton  x:Name="rb_ICCprofile_based_Colorpreset" IsEnabled="False"
                                                                           Content="{Binding [Color.3], Source={x:Static lang:LangHelper.Instance}}"  FontSize="14"
                                                                           Click="rb_ICCprofile_based_Colorpreset_click" KeyboardNavigation.TabNavigation="{Binding TabNavigation}" 
                                                                           IsTabStop="{Binding isTabStoppable}" KeyboardNavigation.AcceptsReturn="{Binding isTabStoppable}" 
                                                                           KeyboardNavigation.TabIndex="171" 
                                                                           KeyboardNavigation.IsTabStop="{Binding isTabStoppable}">
                                                <UXControls:UXRadioButton.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                    </Style>
                                                </UXControls:UXRadioButton.Resources>
                                            </UXControls:UXRadioButton>
                                        </Grid>

                                        <!-- Robert_Lin 2025-1-18 [#PIMS-333922] L10N_ i18N_ DDPM 2.0_ GUI_ TP1_ es-ES, es-XL, it-IT, pt-BR, pt-PT, ua-UK_ Clipping found in stringID_ Color.5
                                            Issue: The Link text is clipped. 
                                            Fix solution: 
                                            1 Change StackPanel to WrapPanel so the RadioButon can be wrapped to next row. Top-allign make it's Circle control will be top-allign.
                                            2 Use UXTextBlock as the content of the UXRadioButton, to make sure it has the same color with RadioButton, and support TextWrap.
                                            3 Use UXHyperlink replace UXLink. It's IsEnabled bind to RadioButton. And use ICommand binding to replace UXLink.Click.
                                            
                                            OLD:
                                            
                                            <Grid Grid.Column="1" Grid.Row="3"  Margin="0,0,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <UXControls:UXRadioButton  x:Name="rb_Colorpreset_based_ICCprofile" IsEnabled="False" Content="{Binding [Color.4], Source={x:Static lang:LangHelper.Instance}}" FontSize="14" Click="rb_Colorpreset_based_ICCprofile_click" KeyboardNavigation.TabNavigation="{Binding TabNavigation}" IsTabStop="{Binding isTabStoppable}" KeyboardNavigation.AcceptsReturn="{Binding isTabStoppable}" KeyboardNavigation.IsTabStop="{Binding isTabStoppable}" />
                                                    <UXControls:UXLink Margin="-8,0,0,0" Name="ICC_profile_config" Content="{Binding [Color.5], Source={x:Static lang:LangHelper.Instance}}" Click="ICC_profile_config_Click"
                                                                       IconPosition="IconRight" LinkSize="Medium" LinkColorScheme="Primary"
                                                                       HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <UXControls:UXLink.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="Transparent" />
                                                            </Style>
                                                        </UXControls:UXLink.Resources>
                                                    </UXControls:UXLink>
                                                </StackPanel>
                                            </Grid>
                                            
                                            -->
                                        <Grid Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="3"  Margin="0,0,0,0">
                                            <WrapPanel>
                                                <UXControls:UXRadioButton  x:Name="rb_Colorpreset_based_ICCprofile" IsEnabled="False" 
                                                                               FontSize="14" Click="rb_Colorpreset_based_ICCprofile_click" KeyboardNavigation.TabNavigation="{Binding TabNavigation}" 
                                                                               IsTabStop="{Binding isTabStoppable}" KeyboardNavigation.AcceptsReturn="{Binding isTabStoppable}" 
                                                                               VerticalAlignment="Top" 
                                                                                KeyboardNavigation.TabIndex="172" 
                                                                               KeyboardNavigation.IsTabStop="{Binding isTabStoppable}" >
                                                    <UXControls:UXRadioButton.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                        </Style>
                                                    </UXControls:UXRadioButton.Resources>
                                                    <UXControls:UXTextBlock TextWrapping="Wrap" HorizontalAlignment="Center" FontSize="14">
                                                        <Run Text="{Binding [Color.4], Source={x:Static lang:LangHelper.Instance}, Mode=OneWay}"
                                                                 Foreground="{Binding ElementName=rb_Colorpreset_based_ICCprofile, Path=Foreground}"/>
                                                        <UXControls:UXHyperlink ColorScheme="Primary" IconPosition="None" Margin="0,0,0,-4"
                                                                                    HyperlinkText="{Binding [Color.5], Source={x:Static lang:LangHelper.Instance}}"
                                                                                    KeyboardNavigation.TabIndex="173" Focusable="True"
                                                                                    IsEnabled="{Binding ElementName=rb_Colorpreset_based_ICCprofile, Path=IsEnabled}"
                                                                                    Command="{Binding ICC_profile_hyperlink_ClickCommand}" PreviewKeyDown="iccProfileHyperlink_PreviewKeyDown"
                                                                                    />
                                                    </UXControls:UXTextBlock>
                                                </UXControls:UXRadioButton>

                                            </WrapPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <Border Background="#132F5499" Opacity="0.6"  Visibility="{Binding LockMaskVisible}"/>
                            </Grid>

                        </Expander.Content>
                    </Expander>
                </Border>

                <Grid Grid.Row="6" x:Name="stackpanel_DCM" Margin="0,0,0,0" HorizontalAlignment="Stretch" Visibility="{Binding DCM_Visibility}">
                    <!-- modify jim 20240604 -->
                    <UXControls:UXAlert Margin="0" HorizontalAlignment="Stretch">
                        <UXControls:UXAlertItem AlertItemType="Info" Margin="8,8,8,8" Label=""
                                                    Message="{Binding [Color.13], Source={x:Static lang:LangHelper.Instance}}" />
                    </UXControls:UXAlert>
                </Grid>

                <Border Grid.Row="0" Grid.RowSpan="7" Name="DisableAll"
                        Background="#4C24273C">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility"
                                    Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}"
                                            Value="True">
                                    <Setter Property="Visibility"
                                            Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <!-- Add a UXBusyIndicator from Robert -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <UXControls:UXBusyIndicator BusyIndicatorType="Secondary"
                                    Width="64"
                                    Height="64"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsActive="{Binding IsBusy}" />
                        <UXControls:UXTextBlock Margin="0, 20, 0, 0" Text="{Binding [HomePage.0], Source={x:Static lang:LangHelper.Instance}}" Foreground="#FF797F84" />
                    </StackPanel>
                </Border>
            </Grid>
        </UXControls:UXScrollViewer>
    </Grid>
</UserControl>