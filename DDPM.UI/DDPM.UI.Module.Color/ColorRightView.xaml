<UserControl x:Class="DDPM.UI.Module.Color.ColorRightView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DDPM.UI.Module.Color"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             xmlns:common="clr-namespace:DDPM.UI.Common;assembly=DDPM.UI.Common"
             xmlns:lang="clr-namespace:DDPM.UI.Resources.Helper;assembly=DDPM.UI.Resources"
             mc:Ignorable="d"
             d:DesignHeight="850" d:DesignWidth="800" Loaded="UserControl_Loaded" Unloaded="UserControl_UnLoaded">
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DefaultTheme_TxtColor}" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <UXControls:UXScrollViewer HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <StackPanel>

                    <Grid>
                        <Border
                            Width="648"
                            Height="53"
                            Margin="0,5,0,15"
                            CornerRadius="5"
                            Visibility="{Binding GreayoutAlart}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="7" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Border
                        Grid.Column="0"
                        Width="7"
                        CornerRadius="5,0,0,5" />
                                    <Grid
                        Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                                        <Path Data="M9 1.125C13.3313 1.125 16.875 4.66875 16.875 9C16.875 13.3312 13.3313 16.875 9 16.875C4.66875 16.875 1.125 13.3312 1.125 9C1.125 4.66875 4.66875 1.125 9 1.125ZM9 0C4.05 0 0 4.05 0 9C0 13.95 4.05 18 9 18C13.95 18 18 13.95 18 9C18 4.05 13.95 0 9 0Z" Fill="white" />
                                        <Path Data="M9.5625 7.3125L8.4375 7.3125L8.4375 14.2875L9.5625 14.2875L9.5625 7.3125Z" Fill="white" />
                                        <Path Data="M9 5.40039C9.46599 5.40039 9.84375 5.02263 9.84375 4.55664C9.84375 4.09065 9.46599 3.71289 9 3.71289C8.53401 3.71289 8.15625 4.09065 8.15625 4.55664C8.15625 5.02263 8.53401 5.40039 9 5.40039Z" Fill="white" />
                                    </Grid>
                                </Grid>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock
                        FontFamily="Roboto"
                        FontSize="13">
                        <Run Text="{Binding [ColorMsg.0], Source={x:Static lang:LangHelper.Instance}, Mode=OneWay}" />
                        <Hyperlink Click="Hyperlink_Click">
                            <Hyperlink.Style>
                                <Style TargetType="Hyperlink">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="#31A2E3" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Hyperlink.Style>
                            <Run Text="{Binding [Brightness.2], Source={x:Static lang:LangHelper.Instance}, Mode=OneWay}" />
                        </Hyperlink>
                        <Run Text="{Binding [Brightness.3], Source={x:Static lang:LangHelper.Instance}, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- RightGroupBorder.Manual -->
                    <Border 
                        IsEnabled="{Binding ColorEnable}"
                        Opacity="{Binding ColorOpacity}"
                        Style="{StaticResource RightGroupBorderStyle}">

                        <!-- Group: Manual -->
                        <!--
                        <Expander x:Name="Expander_Manual" Style="{StaticResource GroupExpanderStyle}" Expanded="expanderHasExpanded">
                        -->
                        <Expander x:Name="Expander_Manual" Style="{StaticResource RightExpanderStyle}" Expanded="expanderHasExpanded" KeyboardNavigation.TabNavigation="{Binding TabNavigation}" IsTabStop="{Binding isTabStoppable}" KeyboardNavigation.AcceptsReturn="{Binding isTabStoppable}" KeyboardNavigation.IsTabStop="{Binding isTabStoppable}"  >
                            <Expander.Header>
                                <!-- Group Header: Manual-->
                                <Grid Height="60">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>

                                    <UXControls:UXTextBlock Margin="30,0,0,0" Text="{Binding [Manual], Source={x:Static lang:LangHelper.Instance}}" FontSize="20"
                                                            TextBlockType="Caption"
                                                            Background="{DynamicResource Transparent}"
                                                            VerticalAlignment="Center" HorizontalAlignment="Left" />

                                    <Image Grid.Column="1" Visibility="{Binding LockMaskVisible}" 
                                            Source="pack://application:,,,/DDPM.UI.Common;component/Resources/Lock.png"
                                            VerticalAlignment="Center" HorizontalAlignment="Center" Width="16" Height="16">
                                        <Image.ToolTip>
                                            <ToolTip>
                                                <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                                    <Border.Resources>
                                                        <Style BasedOn="{StaticResource Tooltip_TextBlockStyle}" TargetType="TextBlock" />
                                                    </Border.Resources>
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding [ITLockToolTip.0], Source={x:Static lang:LangHelper.Instance}}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </ToolTip>
                                        </Image.ToolTip>
                                    </Image>

                                </Grid>
                            </Expander.Header>

                            <Expander.Content>
                                <Grid>
                                    <Border>
                                        <Grid Height="50" Margin="0,10">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <UXControls:UXTextBlock Text="{Binding [Color.6], Source={x:Static lang:LangHelper.Instance}}" Grid.Column="0" FontSize="16"
                                                                    TextBlockType="Display1"
                                                                    Background="{DynamicResource Transparent}"
                                                                    VerticalAlignment="Center" HorizontalAlignment="Left" />

                                            <!--
                                            <UXControls:UXComboBox x:Name="cbManualPreset" Grid.Column="2"
                                            Background="{StaticResource UXComboBox_Background}"
                                            BorderBrush="{StaticResource UXComboBox_BorderBrush}"
                                            BorderThickness="{StaticResource Tooltip_BdThick}"
                                            Foreground="{StaticResource UXComboBox_Foreground}"
                                            Width="184"
                                            ItemsSource="{Binding ColorPresets_ItemsCollection}"
                                            SelectionChanged="cbManualPreset_SelectionChanged" />
                                            -->
                                            <ComboBox x:Name="cbManualPreset" Grid.Column="2" Style="{StaticResource DdpmComboBoxStyle}"
                                                    Width="184"
                                                    SelectionChanged="cbManualPreset_SelectionChanged"
                                                    ItemsSource="{Binding ColorPresets_ItemsCollection}"
                                                    SelectedIndex="{Binding ColorPresetSelectedIndex}" KeyboardNavigation.TabNavigation="{Binding TabNavigation}" IsTabStop="{Binding isTabStoppable}" KeyboardNavigation.AcceptsReturn="{Binding isTabStoppable}" KeyboardNavigation.IsTabStop="{Binding isTabStoppable}" />
                                        </Grid>
                                    </Border>
                                    <Border Opacity="0.6"  Visibility="{Binding LockMaskVisible}"/>
                                </Grid>

                            </Expander.Content>
                        </Expander>
                    </Border>

                    <!-- RightGroupBorder.Auto -->
                    <Border 
                        IsEnabled="{Binding ColorEnable}"
                        Opacity="{Binding ColorOpacity}"
                        Style="{StaticResource RightGroupBorderStyle}" Margin="0,16,0,0">

                        <Expander  x:Name="Expander_Auto" Style="{StaticResource RightExpanderStyle}" Expanded="expanderHasExpanded" KeyboardNavigation.TabNavigation="{Binding TabNavigation}" IsTabStop="{Binding isTabStoppable}" KeyboardNavigation.AcceptsReturn="{Binding isTabStoppable}" KeyboardNavigation.IsTabStop="{Binding isTabStoppable}" >
                            <Expander.Header>
                                <!-- Group Header: Auto-->
                                <Grid Height="60">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>

                                    <UXControls:UXTextBlock  Margin="30,0,0,0" Text="{Binding [Auto], Source={x:Static lang:LangHelper.Instance}}" FontSize="20"
                                                            TextBlockType="Caption"
                                                            VerticalAlignment="Center" HorizontalAlignment="Left" />
                                    <Image Grid.Column="1" Visibility="{Binding LockMaskVisible}" 
                                            Source="pack://application:,,,/DDPM.UI.Common;component/Resources/Lock.png"
                                            VerticalAlignment="Center" HorizontalAlignment="Center" Width="16" Height="16">
                                        <Image.ToolTip>
                                            <ToolTip>
                                                <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                                    <Border.Resources>
                                                        <Style BasedOn="{StaticResource Tooltip_TextBlockStyle}" TargetType="TextBlock" />
                                                    </Border.Resources>
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding [ITLockToolTip.0], Source={x:Static lang:LangHelper.Instance}}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </ToolTip>
                                        </Image.ToolTip>
                                    </Image>
                                </Grid>
                            </Expander.Header>

                            <Expander.Content>
                                <Grid>
                                    <Border Background="Transparent">
                                        <StackPanel Margin="16">

                                            <UXControls:UXTextBlock Text="{Binding [Color.7], Source={x:Static lang:LangHelper.Instance}}" FontSize="16"
                                                                    TextBlockType="Display1"
                                                                    VerticalAlignment="Center" HorizontalAlignment="Left" />

                                            <!-- RightPartBorder.App -->
                                            <Border Style="{StaticResource RightPartBorderStyle}" Margin="0,16,0,0">
                                                <StackPanel>
                                                    <ListBox Background="{DynamicResource DefaultTheme_ListBoxBkColor}"
                                                             Margin="8" Grid.Row="1"
                                                             x:Name="lb_AppList"
                                                             ItemsSource="{Binding AppsList, UpdateSourceTrigger=PropertyChanged}"
                                                             HorizontalContentAlignment="Stretch"
                                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                             ScrollViewer.CanContentScroll="True"
                                                             PreviewDragEnter="lb_AppList_PreviewDragEnter"
                                                             AllowDrop="True"
                                                             KeyboardNavigation.TabNavigation="{Binding TabNavigation}" IsTabStop="{Binding isTabStoppable}" KeyboardNavigation.IsTabStop="{Binding isTabStoppable}"
                                                             >
                                                        <ListBox.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="5" />
                                                            </Style>
                                                        </ListBox.Resources>
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,4">

                                                                    <Grid.Style>
                                                                        <Style TargetType="Grid">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding LockMaskVisible}" Value="Visible">
                                                                                    <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding LockMaskVisible}" Value="Collapsed">
                                                                                    <Setter Property="KeyboardNavigation.TabNavigation" Value="Local" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Grid.Style>


                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <!-- App Icon-->
                                                                        <ColumnDefinition Width="*" />
                                                                        <!-- App Name-->
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <!-- Preset for App, combobox-->
                                                                        <ColumnDefinition Width="12" />
                                                                        <!--Delete button-->
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>

                                                                    <Image Grid.Column="0" x:Name="appIcon" Source="{Binding AppIcon}"
                                                                           Width="40" Stretch="Uniform" />

                                                                    <TextBlock Grid.Column="1" x:Name="appName"
                                                                               Text="{Binding AppName , UpdateSourceTrigger=PropertyChanged}"
                                                                               VerticalAlignment="Center" HorizontalAlignment="Left"
                                                                               Foreground="{DynamicResource DefaultTheme_TxtColor}" />

                                                                    <!-- -->
                                                                    <ComboBox Grid.Column="2" x:Name="appPreset"
                                                                              Style="{StaticResource DdpmComboBoxStyle}"
                                                                              ItemsSource="{Binding SupportPreset, UpdateSourceTrigger=PropertyChanged}" SelectedIndex="{Binding AppPresetIdx, UpdateSourceTrigger=PropertyChanged}" Width="150"
                                                                              VerticalAlignment="Center" HorizontalAlignment="Stretch"  SelectionChanged="appPreset_SelectionChanged" KeyboardNavigation.TabNavigation="{Binding TabNavigation}" IsTabStop="{Binding isTabStoppable}" KeyboardNavigation.AcceptsReturn="{Binding isTabStoppable}" KeyboardNavigation.IsTabStop="{Binding isTabStoppable}"  />

                                                                    <!--
                                                                    <UXControls:UXComboBox Grid.Column="2" x:Name="appPreset"
                                                                    Background="{StaticResource UXComboBox_Background}"
                                                                    BorderBrush="{StaticResource UXComboBox_BorderBrush}"
                                                                    BorderThickness="{StaticResource Tooltip_BdThick}"
                                                                    Foreground="{StaticResource UXComboBox_Foreground}"
                                                                    ItemsSource="{Binding SupportPreset, UpdateSourceTrigger=PropertyChanged}"
                                                                    SelectedIndex="{Binding AppPresetIdx, UpdateSourceTrigger=PropertyChanged}"
                                                                    Width="180" Height="40"
                                                                    VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                                                    SelectionChanged="appPreset_SelectionChanged" />
                                                                    -->

                                                                    <Button Grid.Column="3" x:Name="appDeleteBtn" Content="X"
                                                                            Background="Transparent"
                                                                            Visibility="{Binding IsDeleteAble, UpdateSourceTrigger=PropertyChanged}"
                                                                            BorderBrush="Transparent"
                                                                            Click="appDeleteBtn_Click" KeyboardNavigation.TabNavigation="{Binding TabNavigation}" IsTabStop="{Binding isTabStoppable}" KeyboardNavigation.AcceptsReturn="{Binding isTabStoppable}" KeyboardNavigation.IsTabStop="{Binding isTabStoppable}" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                        <ListBox.ItemContainerStyle>
                                                            <Style TargetType="ListBoxItem">
                                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"></Setter>
                                                            </Style>
                                                        </ListBox.ItemContainerStyle>
                                                    </ListBox>

                                                    <UXControls:UXButton Name="btn_AddApp" Grid.Row="2" Content="{Binding [Color.0], Source={x:Static lang:LangHelper.Instance}}"
                                                                         ButtonType="Secondary" ButtonSemanticColorType="Neutral" HorizontalAlignment="Center"
                                                                         Style="{StaticResource UXButton_WhiteFrame}" Padding="24,8" Click="btn_AddApp_Click" 
                                                                         KeyboardNavigation.TabNavigation="{Binding TabNavigation}" IsTabStop="{Binding isTabStoppable}" 
                                                                         KeyboardNavigation.AcceptsReturn="{Binding isTabStoppable}" KeyboardNavigation.IsTabStop="{Binding isTabStoppable}" />

                                                    <!--
                                                    <Button x:Name="btn_AddApp" Grid.Row="2" Content="Add Application" VerticalAlignment="Top" Height="30" Width="140" Margin="0,60,0,0"
                                                    Foreground="White" Background="CornflowerBlue" BorderBrush="White"  Click="btn_AddApp_Click" />
                                                    -->
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                    </Border>
                                    <Border Opacity="0.6" Visibility="{Binding LockMaskVisible}"/>
                                </Grid>

                            </Expander.Content>
                        </Expander>
                    </Border>

                    <!-- RightGroupBorder.Nightlight -->
                    <Border 
                        IsEnabled="{Binding ColorEnable}"
                        Opacity="{Binding ColorOpacity}"
                        Style="{StaticResource RightGroupBorderStyle}"  Margin="0,16,0,0">
                        <Grid x:Name="Nightlight_bar">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Rectangle Fill="Transparent" RadiusX="5" RadiusY="5" Grid.Column="0" Grid.ColumnSpan="2" Height="40" />
                            <Grid Grid.Column="0" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding [Color.8], Source={x:Static lang:LangHelper.Instance}}"  FontSize="14" FontFamily="Noto Sans" VerticalAlignment="Center" Grid.Column="0" Margin="16,0,0,0" HorizontalAlignment="Left" />
                                <TextBlock Text="(" Grid.Column="1"  FontFamily="Noto Sans" FontSize="14" VerticalAlignment="Center"  HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding NightlightStatus}" Grid.Column="2" VerticalAlignment="Center" FontFamily="Noto Sans" FontSize="14" HorizontalAlignment="Center" />
                                <TextBlock Text=")" Grid.Column="3" FontFamily="Noto Sans" FontSize="14" VerticalAlignment="Center"  HorizontalAlignment="Center" />

                                <Image Grid.Column="4" Stretch="None" Margin="10,0,0,0" Source="pack://application:,,,/DDPM.UI.Common;component/Resources/Icon_Info.png">
                                    <Image.ToolTip>
                                        <ToolTip Placement="Center" VerticalOffset="45">
                                            <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                                <Border.Resources>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Tooltip_TextBlockStyle}" />
                                                </Border.Resources>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding [Color.9], Source={x:Static lang:LangHelper.Instance}}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </ToolTip>
                                    </Image.ToolTip>
                                </Image>
                            </Grid>
                            <UXControls:UXLink Name="nightlight_config" Grid.Column="1" Content="{Binding [WindowsSettings], Source={x:Static lang:LangHelper.Instance}}" Click="nightlight_config_Click"
                                               IconPosition="IconRight" LinkSize="Medium" LinkColorScheme="Primary"
                                               LinkType="InLine" Icon="M29.86 29.86h-27.74v-27.72h13.88v-2.14h-16v32h32v-16h-2.12zM20.86 0v2.12h7.56l-15.060 15.060 1.52 1.5 14.98-15v7.46h2.14v-11.14z"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" Height="40">
                                <UXControls:UXLink.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                    </Style>
                                </UXControls:UXLink.Resources>
                            </UXControls:UXLink>
                        </Grid>
                    </Border>

                    <!-- RightGroupBorder.AdvancedSettings -->
                    <Border 
                         IsEnabled="{Binding ColorEnable}"
                         Opacity="{Binding ColorOpacity}"
                         Style="{StaticResource RightGroupBorderStyle}" Margin="0,16,0,0" Visibility="{Binding IsisAdvanced_Settings, UpdateSourceTrigger=PropertyChanged}">
                        <Expander x:Name="Expander_Advanced_Settings"  Visibility="{Binding IsisAdvanced_Settings, UpdateSourceTrigger=PropertyChanged}" KeyboardNavigation.TabNavigation="{Binding TabNavigation}" IsTabStop="{Binding isTabStoppable}" KeyboardNavigation.AcceptsReturn="{Binding isTabStoppable}" KeyboardNavigation.IsTabStop="{Binding isTabStoppable}" >
                            <Expander.Header>
                                <!-- Group Header:  Advanced Settings-->
                                <!-- Robert_Lin 2025-1-14 PIMS-333569] L10N: i18N: DDPM 2.0: GUI: TP1: es-ES, es-XL, it-IT, pt-PT, pt-BR, ua-UK: Clipping found in stringID: AdvancedSettings
                                The ColumnDefinition of Column 0 Width=140, causes the text been clipped.
                                Change Grid ColumnDefinitions to *,Auto   Text will has "..." if it is clipped.
                                OLD:
                                    <Grid.ColumnDefinitions>
                                       <ColumnDefinition Width="140" />
                                       <ColumnDefinition />
                                   </Grid.ColumnDefinitions>
           
                                   <UXControls:UXTextBlock  Margin="0,0,0,0" Text="{Binding [AdvancedSettings], Source={x:Static lang:LangHelper.Instance}}" FontSize="15" 
                                                          TextBlockType="Caption"
                                                          VerticalAlignment="Center" HorizontalAlignment="Left" />
                                 -->
                                <Grid Height="60">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <UXControls:UXTextBlock  Margin="0,0,8,0" 
                                                             Text="{Binding [AdvancedSettings], Source={x:Static lang:LangHelper.Instance}}" FontSize="15" 
                                                            TextBlockType="Caption" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                            VerticalAlignment="Center" HorizontalAlignment="Left" />
                                    
                                    <!-- Robert_Lin 2025-1-14 Change the Icon from Image to ContentControl, which use Path to draw the LockIcon to meet Light mode requirements.
                                    OLD:
                                    <Image Grid.Column="1" Visibility="{Binding LockMaskVisible}" d:Visibility="Visible"
                                       Source="pack://application:,,,/DDPM.UI.Common;component/Resources/Lock.png"
                                       VerticalAlignment="Center" HorizontalAlignment="Center" Width="16" Height="16">
                                       <Image.ToolTip>
                                           <ToolTip>
                                               <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                                   <Border.Resources>
                                                       <Style BasedOn="{StaticResource Tooltip_TextBlockStyle}" TargetType="TextBlock" />
                                                   </Border.Resources>
                                                   <StackPanel>
                                                       <StackPanel Orientation="Horizontal">
                                                           <TextBlock Text="{Binding [ITLockToolTip.0], Source={x:Static lang:LangHelper.Instance}}" />
                                                       </StackPanel>
                                                   </StackPanel>
                                               </Border>
                                           </ToolTip>
                                       </Image.ToolTip>
                                   </Image>

                                    -->
                                    <ContentControl Grid.Column="1" Visibility="{Binding LockMaskVisible}" VerticalAlignment="Center"
                                                    Template="{StaticResource icon_Lock}" Foreground="{DynamicResource LockIcon_Fill}">

                                        <ContentControl.ToolTip>

                                            <ToolTip>
                                                <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                                    <Border.Resources>
                                                        <Style BasedOn="{StaticResource Tooltip_TextBlockStyle}" TargetType="TextBlock" />
                                                    </Border.Resources>
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding [ITLockToolTip.0], Source={x:Static lang:LangHelper.Instance}}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </ToolTip>
                                        </ContentControl.ToolTip>
                                    </ContentControl>

                                  </Grid>
                            </Expander.Header>

                            <Expander.Content>

                                <Grid>
                                    <Border>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="0.5*" />
                                                <ColumnDefinition Width="8*" />
                                                <ColumnDefinition Width="1.5*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="1*" />
                                                <!--Color Management -->
                                                <RowDefinition Height="15" />
                                                <!-- space-->
                                                <RowDefinition Height="0.8*" />
                                                <!--Auto-adjust the ICC Color profile based on color preset-->
                                                <RowDefinition Height="*" />
                                                <!--Auto-adjust the color preset based on ICC Color profile-->
                                                <RowDefinition Height="1.5*" />
                                                <!--space-->
                                                <RowDefinition Height="20" />
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Column="0" Margin="0,0,0,0">
                                                <StackPanel Grid.Column="0" Margin="0,0,0,0" Orientation="Horizontal" HorizontalAlignment="left">
                                                </StackPanel>
                                            </Grid>

                                            <Grid Grid.Column="1" Grid.Row="0"  Margin="0,0,0,0">
                                                <StackPanel Margin="0,0,0,0" Orientation="Horizontal" HorizontalAlignment="left">
                                                    <TextBlock Text="{Binding [Color.11], Source={x:Static lang:LangHelper.Instance}}"  FontSize="14" FontFamily="Noto Sans" VerticalAlignment="Center" Grid.Column="0" Margin="16,0,0,0" HorizontalAlignment="Left" />

                                                    <Image Grid.Column="1" Stretch="None" Margin="10,0,0,0" Source="pack://application:,,,/DDPM.UI.Common;component/Resources/Icon_Info.png">
                                                        <Image.ToolTip>
                                                            <ToolTip Placement="Center" VerticalOffset="45" HorizontalOffset="50">
                                                                <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                                                    <Border.Resources>
                                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Tooltip_TextBlockStyle}" />
                                                                    </Border.Resources>
                                                                    <StackPanel>
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="{Binding [Color.12], Source={x:Static lang:LangHelper.Instance}}" />
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Border>
                                                            </ToolTip>
                                                        </Image.ToolTip>
                                                    </Image>
                                                </StackPanel>
                                            </Grid>

                                            <Grid Grid.Column="3" Grid.Row="0"  Margin="0,0,0,0">

                                                <UXControls:UXToggleSwitch
                                                    Name="ColorManagement_ToggleSwitch"
                                                    Grid.Column="0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    AutomationProperties.Name="ToggleSwitchLeft"
                                                    Click="Color_Management_Switch_Click"
                                                    ContentPlacement="Left"
                                                    ContentTextVisibility="True" KeyboardNavigation.TabNavigation="{Binding TabNavigation}" IsTabStop="{Binding isTabStoppable}" KeyboardNavigation.AcceptsReturn="{Binding isTabStoppable}" KeyboardNavigation.IsTabStop="{Binding isTabStoppable}" />
                                            </Grid>

                                            <Grid Grid.Column="1" Grid.Row="2"  Margin="0,0,0,0">
                                                <UXControls:UXRadioButton  x:Name="rb_ICCprofile_based_Colorpreset" IsEnabled="False" Content="{Binding [Color.3], Source={x:Static lang:LangHelper.Instance}}"  FontSize="14" Click="rb_ICCprofile_based_Colorpreset_click" KeyboardNavigation.TabNavigation="{Binding TabNavigation}" IsTabStop="{Binding isTabStoppable}" KeyboardNavigation.AcceptsReturn="{Binding isTabStoppable}" KeyboardNavigation.IsTabStop="{Binding isTabStoppable}" />
                                            </Grid>

                                            <Grid Grid.Column="1" Grid.Row="3"  Margin="0,0,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <UXControls:UXRadioButton  x:Name="rb_Colorpreset_based_ICCprofile" IsEnabled="False" Content="{Binding [Color.4], Source={x:Static lang:LangHelper.Instance}}" FontSize="14" Click="rb_Colorpreset_based_ICCprofile_click" KeyboardNavigation.TabNavigation="{Binding TabNavigation}" IsTabStop="{Binding isTabStoppable}" KeyboardNavigation.AcceptsReturn="{Binding isTabStoppable}" KeyboardNavigation.IsTabStop="{Binding isTabStoppable}" />
                                                    <UXControls:UXLink Margin="-8,0,0,0" Name="ICC_profile_config" Content="{Binding [Color.5], Source={x:Static lang:LangHelper.Instance}}" Click="ICC_profile_config_Click"
                                                                       IconPosition="IconRight" LinkSize="Medium" LinkColorScheme="Primary"
                                                                       HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <UXControls:UXLink.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="Transparent" />
                                                            </Style>
                                                        </UXControls:UXLink.Resources>
                                                    </UXControls:UXLink>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <Border Background="#132F5499" Opacity="0.6"  Visibility="{Binding LockMaskVisible}"/>
                                </Grid>

                            </Expander.Content>
                        </Expander>
                    </Border>

                    <StackPanel x:Name="stackpanel_DCM" Margin="-80,0,0,0" Height="100" HorizontalAlignment="Center" Width="850" Visibility="{Binding DCM_Visibility}">
                        <!-- modify jim 20240604 -->
                        <UXControls:UXAlert Margin="160,0,0,0">
                            <UXControls:UXAlertItem AlertItemType="Info" Margin="8,8,8,8" Label=""
                                                    Message="{Binding [Color.13], Source={x:Static lang:LangHelper.Instance}}" />
                        </UXControls:UXAlert>
                    </StackPanel>
                </StackPanel>

                <Border Name="DisableAll"
                        Background="#4C24273C">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility"
                                    Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}"
                                            Value="True">
                                    <Setter Property="Visibility"
                                            Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <!-- Add a UXBusyIndicator from Robert -->
                    <UXControls:UXBusyIndicator BusyIndicatorType="Secondary"
                                Width="64"
                                Height="64"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsActive="{Binding IsBusy}" />
                </Border>
            </Grid>
        </UXControls:UXScrollViewer>
    </Grid>
</UserControl>