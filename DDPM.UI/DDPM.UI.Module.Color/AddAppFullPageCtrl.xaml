<UserControl x:Class="DDPM.UI.Module.Color.AddAppFullPageCtrl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DDPM.UI.Module.Color"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             xmlns:lang="clr-namespace:DDPM.UI.Resources.Helper;assembly=DDPM.UI.Resources"
             mc:Ignorable="d" Background="{DynamicResource mainWindowBkColor}" Loaded="UserControl_Loaded"
             d:DesignHeight="735" d:DesignWidth="1378">
    <UserControl.Resources>
        <ResourceDictionary>
            <Color x:Key="ColorWhite">#FFFFFF</Color>
            <Color x:Key="ColorGray100">#F5F6F7</Color>
            <Color x:Key="ColorGray200">#F0F0F0</Color>
            <Color x:Key="ColorGray300">#E1E1E1</Color>
            <Color x:Key="ColorGray400">#D2D2D2</Color>
            <Color x:Key="ColorGray500">#B6B6B6</Color>
            <Color x:Key="ColorGray600">#7E7E7E</Color>
            <Color x:Key="ColorGray700">#6E6E6E</Color>
            <Color x:Key="ColorGray750">#666666</Color>
            <Color x:Key="ColorGray800">#636363</Color>
            <Color x:Key="ColorGray900">#0E0E0E</Color>
            <Color x:Key="ColorGray950">#444444</Color>
            <Color x:Key="ColorBlue100">#D9F5FD</Color>
            <Color x:Key="ColorBlue150">#D0E4EB</Color>
            <Color x:Key="ColorBlue200">#94DCF7</Color>
            <Color x:Key="ColorBlue300">#5CC1EE</Color>
            <Color x:Key="ColorBlue400">#31A2E3</Color>
            <Color x:Key="ColorBlue500">#1282D6</Color>
            <!-- "ColorBlue600" is considered the "Blue" / "Dell Blue" color (aka, the "Brand" color). -->
            <Color x:Key="ColorBlue600">#0672CB</Color>
            <Color x:Key="ColorBlue700">#0063B8</Color>
            <!-- "ColorBlue800" is considered the "Midnight" color. -->
            <Color x:Key="ColorBlue800">#00468B</Color>
            <Color x:Key="ColorBlue900">#002A58</Color>
            <SolidColorBrush x:Key="BrushScrollView_Background" Color="{DynamicResource ColorWhite}" />
            <SolidColorBrush x:Key="BrushScrollView_Forground" Color="{DynamicResource ColorGray500}" />
            <SolidColorBrush x:Key="BrushScrollBar_Background" Color="{DynamicResource ColorGray100}" />
            <SolidColorBrush x:Key="BrushScrollBarJogButton_Foreground" Color="#999999" />
            <SolidColorBrush x:Key="BrushScrollBarJogButton_Background" Color="{DynamicResource ColorGray100}" />
            <SolidColorBrush x:Key="BrushScrollBarThumb_Border" Color="#999999" />

            <SolidColorBrush x:Key="BrushScrollBarThumb_BackgroundNormal" Color="#999999" />
            <SolidColorBrush x:Key="BrushScrollBarThumb_BackgroundHover" Color="{DynamicResource ColorBlue600}" />
            <SolidColorBrush x:Key="BrushScrollBarThumb_BackgroundPress" Color="{DynamicResource ColorBlue700}" />
            <CubicEase x:Key="CubicEaseOut" EasingMode="EaseOut" />
            <CubicEase x:Key="CubicEaseInOut" EasingMode="EaseInOut" />
            <Style x:Key="VerticalScrollBarThumb" TargetType="{x:Type Thumb}">
                <Setter Property="OverridesDefaultStyle" Value="true"/>
                <Setter Property="Background" Value="{DynamicResource BrushScrollView_Forground}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="IsTabStop" Value="false"/>
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="UseLayoutRounding" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Thumb}">
                            <Grid SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" UseLayoutRounding="{TemplateBinding UseLayoutRounding}" >
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="hover" Storyboard.TargetProperty="(UIElement.Visibility)">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="0" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="MouseOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="hover" Storyboard.TargetProperty="(UIElement.Visibility)">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="1" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="hover" Storyboard.TargetProperty="(UIElement.Visibility)">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="1" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualStateGroup.Transitions>
                                            <VisualTransition From="Normal" To="MouseOver">
                                                <Storyboard>
                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="hover" Storyboard.TargetProperty="(UIElement.Visibility)">
                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/>
                                                    </ObjectAnimationUsingKeyFrames>
                                                    <DoubleAnimation  Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25" EasingFunction="{StaticResource CubicEaseInOut}" />
                                                </Storyboard>
                                            </VisualTransition>
                                            <VisualTransition From="MouseOver" To="Normal">
                                                <Storyboard>
                                                    <DoubleAnimation  Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" EasingFunction="{StaticResource CubicEaseInOut}" />
                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="hover" Storyboard.TargetProperty="(UIElement.Visibility)">
                                                        <DiscreteObjectKeyFrame KeyTime="0:0:0.26" Value="{x:Static Visibility.Collapsed}"/>
                                                    </ObjectAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </VisualTransition>
                                        </VisualStateGroup.Transitions>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <Rectangle Fill="Black" Width="18" HorizontalAlignment="Right" Opacity=".00125" Margin="-4,-2" />
                                <Rectangle x:Name="normal" Fill="{TemplateBinding Background}" Width="3" RadiusX="1.5" RadiusY="1.5" HorizontalAlignment="Right" Margin="1,2" />
                                <Rectangle x:Name="hover" Fill="{TemplateBinding Background}" Width="12" RadiusX="6" RadiusY="6" Visibility="Collapsed" Opacity="0" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <Style x:Key="HorizontalScrollBarThumb" TargetType="{x:Type Thumb}">
                <Setter Property="OverridesDefaultStyle" Value="true"/>
                <Setter Property="Background" Value="{DynamicResource BrushScrollView_Forground}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="IsTabStop" Value="false"/>
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="UseLayoutRounding" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Thumb}">
                            <Grid x:Name="Grid">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="hover" Storyboard.TargetProperty="(UIElement.Visibility)">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="0" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="MouseOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="hover" Storyboard.TargetProperty="(UIElement.Visibility)">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="1" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="hover" Storyboard.TargetProperty="(UIElement.Visibility)">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="1" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualStateGroup.Transitions>
                                            <VisualTransition From="Normal" To="MouseOver">
                                                <Storyboard>
                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="hover" Storyboard.TargetProperty="(UIElement.Visibility)">
                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/>
                                                    </ObjectAnimationUsingKeyFrames>
                                                    <DoubleAnimation  Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25" EasingFunction="{StaticResource CubicEaseInOut}" />
                                                </Storyboard>
                                            </VisualTransition>
                                            <VisualTransition From="MouseOver" To="Normal">
                                                <Storyboard>
                                                    <DoubleAnimation  Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" EasingFunction="{StaticResource CubicEaseInOut}" />
                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="hover" Storyboard.TargetProperty="(UIElement.Visibility)">
                                                        <DiscreteObjectKeyFrame KeyTime="0:0:0.26" Value="{x:Static Visibility.Collapsed}"/>
                                                    </ObjectAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </VisualTransition>
                                        </VisualStateGroup.Transitions>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Rectangle HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"  Height="3"
                            Width="Auto" RadiusX="1.5" RadiusY="1.5"   Opacity=".00125"                            
                             Fill="Black" />
                                <Rectangle x:Name="normal" HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"  Height="3"
                            Width="Auto" RadiusX="1.5" RadiusY="1.5"                               
                             Fill="{TemplateBinding Background}" />
                                <Rectangle x:Name="hover" HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"  Height="12"
                            Width="Auto"  RadiusX="6" RadiusY="6" Visibility="Collapsed"                               
                           Fill="{TemplateBinding Background}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <ControlTemplate x:Key="VerticalScrollBar" TargetType="{x:Type ScrollBar}">
                <ControlTemplate.Resources>
                    <Style TargetType="{x:Type ScrollBar}">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false"/>
                        <Setter Property="Stylus.IsFlicksEnabled" Value="false"/>
                    </Style>
                </ControlTemplate.Resources>
                <Grid x:Name="Bg" Background="{TemplateBinding Background}" SnapsToDevicePixels="True" UseLayoutRounding="True">
                    <Track x:Name="PART_Track" IsDirectionReversed="true" IsEnabled="{TemplateBinding IsMouseOver}" SnapsToDevicePixels="True" UseLayoutRounding="True" Margin="2">
                        <Track.Thumb>
                            <Thumb Style="{DynamicResource VerticalScrollBarThumb}" />
                        </Track.Thumb>
                    </Track>
                </Grid>
            </ControlTemplate>

            <ControlTemplate TargetType="{x:Type ScrollBar}" x:Key="HorizontalScrollBar">
                <ControlTemplate.Resources>
                    <Style TargetType="{x:Type ScrollBar}">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false"/>
                        <Setter Property="Stylus.IsFlicksEnabled" Value="false"/>
                        <Setter Property="Width" Value="Auto" />
                    </Style>
                </ControlTemplate.Resources>
                <Grid x:Name="Bg" Background="{TemplateBinding Background}" SnapsToDevicePixels="True" UseLayoutRounding="True">
                    <Track x:Name="PART_Track" IsDirectionReversed="false" IsEnabled="{TemplateBinding IsMouseOver}" SnapsToDevicePixels="True" UseLayoutRounding="True" Margin="2">
                        <Track.Thumb>
                            <Thumb Style="{DynamicResource HorizontalScrollBarThumb}"/>
                        </Track.Thumb>
                    </Track>
                </Grid>
            </ControlTemplate>

            <Style  TargetType="{x:Type ScrollBar}">
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Width" Value="Auto"/>
                        <Setter Property="Height" Value="18" />
                        <Setter Property="Template" Value="{StaticResource HorizontalScrollBar}" />
                    </Trigger>
                    <Trigger Property="Orientation" Value="Vertical">
                        <Setter Property="Width" Value="18"/>
                        <Setter Property="Height" Value="Auto" />
                        <Setter Property="Template" Value="{StaticResource VerticalScrollBar}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="4*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,0,0">
            <StackPanel Grid.Column="0" Margin="0,0,0,0" Orientation="Horizontal" HorizontalAlignment="left">
                <Button Margin="0,0,0,0"   FontFamily="Segoe MDL2 Assets" FontSize="13" Content="&#xE72B;" Height="30" Width="40"  Click="btnCancel_Click" Foreground="{DynamicResource DefaultTheme_TxtColor}" Background="Transparent" BorderThickness="0" VerticalAlignment="Top" />
                <TextBlock  FontSize="20" Text="{Binding [Color.0], Source={x:Static lang:LangHelper.Instance}}" Foreground="{DynamicResource DefaultTheme_TxtColor}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Column="1" Margin="5,0,5,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="20" />
                <!--Title-->
                <RowDefinition Height="*" />
                <!--Decription with little font size-->
                <RowDefinition Height="0.8*" />
                <!--Search - editable textblock-->
                <RowDefinition Height="*" />
                <!--Two sorting buttons-->
                <RowDefinition Height="1.5*" />
                <!--application available list-->
                <RowDefinition Height="7*" />
                <!--OK Cancel buttons-->
                <RowDefinition Height="1.5*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="3" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <UXControls:UXTextBox VerticalAlignment="Center"  Text="{Binding [Search], Source={x:Static lang:LangHelper.Instance},Mode=OneWay}" x:Name="edFilter" FontSize="14"  TextChanged="edFilter_TextChanged" HorizontalContentAlignment="Left"/>
            </Grid>
            
            <Grid  Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <UXControls:UXButton x:Name="btnSortbyName_Ascending" Margin="5,0" Foreground="{DynamicResource DdpmCB_FgColor}" Background="{DynamicResource DdpmCB_BkColor}" HorizontalAlignment="Stretch"   Click="btnSortbyName_Ascending_Click">
                    <StackPanel Orientation="Horizontal" Width="Auto" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <TextBlock Grid.Column="0" HorizontalAlignment="Left" Text="{Binding [Color.1], Source={x:Static lang:LangHelper.Instance}}" Margin="-120,0,0,0" />
                        <Path Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"  Data="M 0 0 L 5 5 L 10 0" Margin="0,0,-120,0" />
                    </StackPanel>
                </UXControls:UXButton>
                <UXControls:UXButton Margin="5,0" Foreground="{DynamicResource DdpmCB_FgColor}" Background="{DynamicResource DdpmCB_BkColor}"  HorizontalAlignment="Stretch" Grid.Column="0" x:Name="btnSortbyName_Descending"     Click="btnSortbyName_Descending_Click" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding [Color.1], Source={x:Static lang:LangHelper.Instance}}" Margin="-120,0,0,0" />
                        <Path Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"  Data="M 0 5 L 5 0 L 10 5" Margin="0,0,-120,0" />
                    </StackPanel>
                </UXControls:UXButton>

                <UXControls:UXButton Margin="5,0" Foreground="{DynamicResource DdpmCB_FgColor}" Background="{DynamicResource DdpmCB_BkColor}" Grid.Column="1"   HorizontalAlignment="Stretch" x:Name="btnSortbyDate_Ascending"    VerticalAlignment="Center"  Click="btnSortbyDate_Ascending_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding [Color.2], Source={x:Static lang:LangHelper.Instance}}" Margin="-120,0,0,0" />
                        <Path Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right"  Data="M 0 0 L 5 5 L 10 0" Margin="0,0,-120,0" />
                    </StackPanel>
                </UXControls:UXButton>
                <UXControls:UXButton Margin="5,0" Foreground="{DynamicResource DdpmCB_FgColor}" Background="{DynamicResource DdpmCB_BkColor}" Grid.Column="1"  HorizontalAlignment="Stretch" x:Name="btnSortbyDate_Descending"  VerticalAlignment="Center"  Click="btnSortbyDate_Descending_Click" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding [Color.2], Source={x:Static lang:LangHelper.Instance}}" Margin="-120,0,0,0" />
                        <Path Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"  Data="M 0 5 L 5 0 L 10 5" Margin="0,0,-120,0" />
                    </StackPanel>
                </UXControls:UXButton>
            </Grid>


            <ListView Grid.Row="5" BorderBrush="{DynamicResource DefaultTheme_BdBdColor}" BorderThickness="3"   HorizontalAlignment="Stretch" x:Name="lb_Installed_App"  Background="{DynamicResource DefaultTheme_BdBdColor}" SelectionMode="Multiple" SelectedIndex="{Binding Selected}">
                <ListView.Template>
                    <ControlTemplate TargetType="{x:Type ListView}">
                        <Border CornerRadius="5">
                            <ScrollViewer>
                                <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </ListView.Template>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!--check box-->
                                <ColumnDefinition Width="*" />
                                <!--App Icon-->
                                <ColumnDefinition Width="auto" />
                                <!--App Name-->
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="1" />
                            </Grid.RowDefinitions>

                            <UXControls:UXRadioButton  Grid.Column="0" Grid.Row="1" GroupName="Group" IsChecked="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}, Path=IsSelected}" >
                                <UXControls:UXRadioButton.Resources>
                                    <Style TargetType="{x:Type UXControls:UXRadioButton}">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type RadioButton}">
                                                    <UXControls:UXCheckBox  VerticalAlignment="Center" Background="{DynamicResource DefaultTheme_BdBdColor}"
                                                                    IsChecked="{Binding RelativeSource={RelativeSource TemplatedParent}, 
                                                                    Path=IsChecked, Mode=TwoWay}"
                                                                    IsHitTestVisible="False" Content="{TemplateBinding Content}" />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </UXControls:UXRadioButton.Resources>
                            </UXControls:UXRadioButton>
                            <Image Grid.Column="1" Grid.Row="1" x:Name="appIcon" Source="{Binding AppIcon}" Width="40"  Margin="20,0,10,0" VerticalAlignment="Center" />
                            <UXControls:UXTextBlock Grid.Column="2" Grid.Row="1" x:Name="appName" Text="{Binding AppName}"  VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center">

                <Button x:Name="btnAdd" Content="{Binding [Confirm], Source={x:Static lang:LangHelper.Instance}}" Width="100" Margin="0,20,0,0" Foreground="White" Background="DodgerBlue" Click="btnAdd_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>