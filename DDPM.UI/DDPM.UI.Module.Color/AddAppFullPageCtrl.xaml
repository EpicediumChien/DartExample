                                  Fill="{DynamicResource AddAppSearch_TextColor}">
                            </Path>
                        </Grid>
                    </Grid>
                </Border>
                <!-- #endregion Row 0: SearchBar -->

                <!-- #region Row 1: SortBar -->
                <!-- OLD: -->
                <Grid  Grid.Row="1" Margin="0,12,0,0" Height="49" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <UXControls:UXButton x:Name="btnSortbyName_Ascending" Margin="5,0" Foreground="{DynamicResource DdpmCB_FgColor}" Background="{DynamicResource DdpmCB_BkColor}" HorizontalAlignment="Stretch"   Click="btnSortbyName_Ascending_Click">
                        <StackPanel Orientation="Horizontal" Width="Auto" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <TextBlock Grid.Column="0" HorizontalAlignment="Left" Text="{Binding [Color.1], Source={x:Static lang:LangHelper.Instance}}" Margin="-120,0,0,0" />
                            <Path Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"  Data="M 0 0 L 5 5 L 10 0" Margin="0,0,-120,0" />
                        </StackPanel>
                    </UXControls:UXButton>
                    <UXControls:UXButton Margin="5,0" Foreground="{DynamicResource DdpmCB_FgColor}" Background="{DynamicResource DdpmCB_BkColor}"  HorizontalAlignment="Stretch" Grid.Column="0" x:Name="btnSortbyName_Descending"     Click="btnSortbyName_Descending_Click" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding [Color.1], Source={x:Static lang:LangHelper.Instance}}" Margin="-120,0,0,0" />
                            <Path Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"  Data="M 0 5 L 5 0 L 10 5" Margin="0,0,-120,0" />
                        </StackPanel>
                    </UXControls:UXButton>

                    <UXControls:UXButton Margin="5,0" Foreground="{DynamicResource DdpmCB_FgColor}" Background="{DynamicResource DdpmCB_BkColor}" Grid.Column="1"   HorizontalAlignment="Stretch" x:Name="btnSortbyDate_Ascending"    VerticalAlignment="Center"  Click="btnSortbyDate_Ascending_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding [Color.2], Source={x:Static lang:LangHelper.Instance}}" Margin="-120,0,0,0" />
                            <Path Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right"  Data="M 0 0 L 5 5 L 10 0" Margin="0,0,-120,0" />
                        </StackPanel>
                    </UXControls:UXButton>
                    <UXControls:UXButton Margin="5,0" Foreground="{DynamicResource DdpmCB_FgColor}" Background="{DynamicResource DdpmCB_BkColor}" Grid.Column="1"  HorizontalAlignment="Stretch" x:Name="btnSortbyDate_Descending"  VerticalAlignment="Center"  Click="btnSortbyDate_Descending_Click" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding [Color.2], Source={x:Static lang:LangHelper.Instance}}" Margin="-120,0,0,0" />
                            <Path Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"  Data="M 0 5 L 5 0 L 10 5" Margin="0,0,-120,0" />
                        </StackPanel>
                    </UXControls:UXButton>
                </Grid>
                <!-- NEW: Robert_Lin 2025-3-14 -->
                <Grid Grid.Row="1" Margin="0,12,0,0" Height="40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="Roboto"/>
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="FontWeight" Value="Normal"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </Grid.Resources>
                    <ToggleButton Name="sortByNameButton" Style="{StaticResource SortToggleButton}" Grid.Column="0" IsChecked="True" HorizontalContentAlignment="Left" 
                                  Click="sortByNameButton_Click">
                        <TextBlock Text="{Binding [Color.1], Source={x:Static lang:LangHelper.Instance}}" d:Text="Sort by Name" />
                    </ToggleButton>
                    <ToggleButton Name="sortByDateButton" Style="{StaticResource SortToggleButton}" Grid.Column="2" IsChecked="True" HorizontalContentAlignment="Left" Click="sortByDateButton_Click"
                                  >
                        <TextBlock Text="{Binding [Color.2], Source={x:Static lang:LangHelper.Instance}}" d:Text="Sort by Date" />
                    </ToggleButton>
                </Grid>
                <!-- #endregion Row 1: SortBar -->

                <!-- #region Row 2: AppListView -->
                <!-- OLD: -->
                <ListView Grid.Row="2"
                          BorderBrush="{DynamicResource DefaultTheme_BdBdColor}" BorderThickness="3"   HorizontalAlignment="Stretch"  Visibility="Collapsed"
                          x:Name="lb_Installed_App" Width="487"
                          Background="{DynamicResource DefaultTheme_BdBdColor}" SelectionMode="Multiple" SelectedIndex="{Binding Selected}">
                    <ListView.Template>
                        <ControlTemplate TargetType="{x:Type ListView}">
                            <Border CornerRadius="5">
                                <ScrollViewer>
                                    <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                </ScrollViewer>
                            </Border>
                        </ControlTemplate>
                    </ListView.Template>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <!--check box-->
                                    <ColumnDefinition Width="*" />
                                    <!--App Icon-->
                                    <ColumnDefinition Width="auto" />
                                    <!--App Name-->
                                    <ColumnDefinition Width="auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="1" />
                                </Grid.RowDefinitions>

                                <UXControls:UXRadioButton  Grid.Column="0" Grid.Row="1" GroupName="Group" IsChecked="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}, Path=IsSelected}" >
                                    <UXControls:UXRadioButton.Resources>
                                        <Style TargetType="{x:Type UXControls:UXRadioButton}">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type RadioButton}">
                                                        <UXControls:UXCheckBox  VerticalAlignment="Center" Background="{DynamicResource DefaultTheme_BdBdColor}"
                                                                    IsChecked="{Binding RelativeSource={RelativeSource TemplatedParent}, 
                                                                    Path=IsChecked, Mode=TwoWay}"
                                                                    IsHitTestVisible="False" Content="{TemplateBinding Content}" />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </UXControls:UXRadioButton.Resources>
                                </UXControls:UXRadioButton>
                                <Image Grid.Column="1" Grid.Row="1" x:Name="appIcon" Source="{Binding AppIcon}" Width="40"  Margin="20,0,10,0" VerticalAlignment="Center" />
                                <UXControls:UXTextBlock Grid.Column="2" Grid.Row="1" x:Name="appName" Text="{Binding AppName}"  VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                
                <!-- NEW: -->
                <Border Grid.Row="2" Margin="0,20" CornerRadius="6" BorderThickness="0" Background="{DynamicResource AddAppListView_BkColor}" Padding="16">
                    
                    <ListView Grid.Row="2" Name="appListView" MinHeight="80" Margin="0,0"
                              SelectedIndex="{Binding Selected}" ScrollViewer.VerticalScrollBarVisibility="Visible"
                              Background="Transparent"
                          ItemContainerStyle="{StaticResource AppListViewItemStyle}" SelectionChanged="appListView_SelectionChanged">
                        <ListView.Template>
                            <ControlTemplate TargetType="{x:Type ListView}">
                                <ScrollViewer>
                                    <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                </ScrollViewer>
                            </ControlTemplate>
                        </ListView.Template>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <UXControls:UXRadioButton Grid.Column="0" GroupName="appListViewGroup" VerticalAlignment="Center"
                                                          IsChecked="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}, Path=IsSelected, Mode=TwoWay}" >
                                        <UXControls:UXRadioButton.Resources>
                                            <!-- Robert_Lin 2025-3-17 to fix the issue: The background color of UXRadioButton is not transparent -->
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                            </Style>
                                        </UXControls:UXRadioButton.Resources>
                                    </UXControls:UXRadioButton>

                                    <Image Grid.Column="1" Grid.Row="1" x:Name="appIcon" Source="{Binding AppIcon}" Width="24"  Margin="2,0,4,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" x:Name="appName" Text="{Binding AppName}"  VerticalAlignment="Center" Margin="0,6,0,0"
                                           FontFamily="Roboto" FontSize="16" FontWeight="Normal" LineHeight="24" Foreground="{DynamicResource SortToggleButton_TextColor}"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
                <!-- #region Row 2: AppListView -->

                <!-- Row 3: ButtonBar -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Height="40" >

                    <Button x:Name="btnAdd" Content="{Binding [Confirm], Source={x:Static lang:LangHelper.Instance}}" MinWidth="114" Margin="0,0,0,0" 
                            Style="{StaticResource PrimaryButtonStyle}" IsEnabled="False"
                            Click="btnAdd_Click" />
                </StackPanel>
                
                <!-- Row 4: BottomSpace -->
                <Grid Grid.Row="4" MaxHeight="128" MinHeight="26"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>