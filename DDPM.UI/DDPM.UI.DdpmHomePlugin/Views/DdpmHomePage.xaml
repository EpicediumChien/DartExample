            <!-- Please Wait -->
            <!-- Robert_Lin, 2024-11-30, for LightMode, remove to balck background of Please Wait -->
            <Grid Visibility="{Binding IsPleaseWaitVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Width="587" Height="265" Background="{DynamicResource SpinnerBkColor}"
                        BorderThickness="1" CornerRadius="4" BorderBrush="#777777" 
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <Grid Height="40" HorizontalAlignment="Center" VerticalAlignment="Top"
                            Margin="0,64,0,32">
                            <UXControls:UXTextBlock Text="{Binding [HomePage.0], Source={x:Static lang:LangHelper.Instance}}"
                                                Foreground="{DynamicResource SpinnerWaitTxtColor}" FontSize="32"/>
                        </Grid>
                        <Grid Height="64">
                            <UXControls:UXBusyIndicator Width="64" Height="64"
                                                        BusyIndicatorType="Secondary" IsActive="True"/>
                        </Grid>
                        <WrapPanel HorizontalAlignment="Center" Margin="0,8">
                            <TextBlock Text="{Binding PleaseWaitMessage}" Foreground="#FF797F84"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>