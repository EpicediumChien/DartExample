<UserControl x:Class="DDPM.UI.Plugin.DdpmHomePlugin.DdpmHomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DDPM.UI.Plugin.DdpmHomePlugin"
             xmlns:model="clr-namespace:DDPM.UI.Plugin.DdpmHomePlugin.Model"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:commonModel="clr-namespace:DDPM.UI.Common.Models;assembly=DDPM.UI.Common"
             xmlns:DDPMUserControls="clr-namespace:DDPM.UI.Common;assembly=DDPM.UI.Common"
             xmlns:commCtrls="clr-namespace:DDPM.UI.Common.UserControls;assembly=DDPM.UI.Common"
             xmlns:PluginCommon="clr-namespace:DDPM.UI.Plugin.Common;assembly=DDPM.UI.Plugin.Common"
             xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
             xmlns:lang="clr-namespace:DDPM.UI.Resources.Helper;assembly=DDPM.UI.Resources"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             x:Name="rootUserControl"
             Loaded="UserControl_Loaded" SizeChanged="rootUserControl_SizeChanged">
    <UserControl.Resources>
        <!-- #region Unused -->
        <Style x:Key="ListBoxStyle_Devices_Unused" TargetType="ListBox">
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ScrollViewer.PanningMode" Value="HorizontalOnly" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--<DataTemplate x:Key="DeviceItemTemplate_Unused" DataType="model:DeviceInfo">
            <Border BorderBrush="Green" BorderThickness="3">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Image Grid.Row="0" Stretch="Uniform" Width="360"
                           Source="{Binding DeviceImage}">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Width" Value="360" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Width" Value="400" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                    <UXControls:UXTextBlock TextBlock.Text="{Binding DeviceName}"
                                            Foreground="White"
                                            TextBlockSemanticColorType="Light"
                                            TextBlockType="Header4"
                                            HorizontalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>-->

        <SolidColorBrush x:Key="ListBox.Static.Background" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="ListBox.Static.Border" Color="#FFABADB3" />
        <SolidColorBrush x:Key="ListBox.Disabled.Background" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="ListBox.Disabled.Border" Color="#FFD9D9D9" />
        <!-- #endregion -->

        <Style x:Key="ListViewStyle1" TargetType="{x:Type ListView}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="true" />
            <Setter Property="ScrollViewer.PanningMode" Value="VerticalOnly" />
            <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0,0,40,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListView}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                Padding="0" Margin="0" SnapsToDevicePixels="true">
                            <ScrollViewer Focusable="false" Padding="{TemplateBinding Padding}" HorizontalAlignment="Stretch" MinWidth="1050"
                                          MaxWidth="{Binding ScrollViewMaxWidth}">
                                <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </ScrollViewer>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Background" TargetName="Bd" Value="{StaticResource ListBox.Disabled.Background}" />
                                <Setter Property="BorderBrush" TargetName="Bd" Value="{StaticResource ListBox.Disabled.Border}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsGrouping" Value="true" />
                                    <Condition Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="false" />
                                </MultiTrigger.Conditions>
                                <Setter Property="ScrollViewer.CanContentScroll" Value="false" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HomeDeviceCount}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Tooltip - Robert_Lin, 2024-11-30 comment-out unused resurces -->
        <!--<SolidColorBrush x:Key="ToolipBkColor" Color="#FF1D2C3B" />
        <SolidColorBrush x:Key="ToolipBdColor" Color="#FF293B4D" />
        <SolidColorBrush x:Key="ToolipTextColor" Color="#FFF5F6F7" />-->

        <PluginCommon:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <!-- Dashed Brush for Focus border -->
        <DrawingBrush x:Key="FocusDotBrush" Viewport="0,0,1,1" ViewportUnits="Absolute" TileMode="Tile">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#B6B6B6">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,50,50" />
                                <RectangleGeometry Rect="50,50,50,50" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="UIDebugPanel" Grid.Row="0" Orientation="Horizontal" Visibility="Hidden" d:Visibility="Visible">

            <!--<UXControls:UXTextBlock TextBlock.Text="DDPM 2.0"
                                    TextBlockType="Header2" />-->
            <StackPanel x:Name="debugRwdParams" Orientation="Horizontal">
                <Button Content="+D" Click="addDisplay_Click" />
                <Button Content="+K" Click="addKb_Click" />
                <Button Content="+M" Click="addMouse_Click" />
                <Button Content="+A" Click="addAllTest_Click" />
                <CheckBox Name="ckbGreenBorder" Content="GreenBorder" Foreground="Green" />

                <TextBlock Foreground="#FF7BFF00" Text="Items=" Margin="8,0,0,0" />
                <TextBlock Foreground="#FF7BFF00" Text="{Binding Path=HomeDeviceCount}" />
                <TextBlock Foreground="#FFDA81DA" Text="cxView.Width=" Margin="8,0,0,0" />
                <TextBlock Foreground="#FFDA81DA" Text="{Binding ElementName=HomeDevicesListView, Path=ActualWidth}" />
                <TextBlock Foreground="Cyan" Text="cxItem=" Margin="8,0,0,0" />
                <TextBlock Foreground="Cyan" Text="{Binding cxItem}" />
                <Button Content="+" Margin="12,0" Click="addItem_Click" Visibility="Collapsed" />
                
                <local:AddDeviceButton Width="12" Height="12" Visibility="Collapsed"/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="2">

            <!-- Add Your first device -->
            <Grid Width="860" Height="220">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <!-- Robert_Lin, 2024-11-30, for LightMode, After remove to balck background of Please Wait 
                            "Add your first device" will be seen in dark mode. So change the DataTrigger to MultiDataTrigger
                            Only when HomeDeviceCount==0 AND IsPleaseWaitVisible==False will show the "Add your first device"
                            -->
                            <!-- OLD 
                            <DataTrigger Binding="{Binding HomeDeviceCount}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>-->
                            <!-- NEW -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HomeDeviceCount}" Value="0"/>
                                    <Condition Binding="{Binding IsPleaseWaitVisible}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <UXControls:UXTextBlock Grid.Row="0" Text="{Binding [NoDeviceDetected], Source={x:Static lang:LangHelper.Instance}}" 
                                        FontSize="20"
                                        Foreground="{DynamicResource HomePageFeature_TxtColor}" HorizontalAlignment="Center"/>
                <UXControls:UXTextBlock Grid.Row="1" Text="{Binding [Add1sDevice], Source={x:Static lang:LangHelper.Instance}}" 
                                        FontSize="64"
                                        Margin="0,16,0,50"
                                        Foreground="{DynamicResource HomePageKeyFeature_TxtColor}" HorizontalAlignment="Center"/>
                <UXControls:UXButton Grid.Row="2" Content="{Binding [Connect], Source={x:Static lang:LangHelper.Instance}}" ButtonType="Primary"
                                     MinWidth="160" Padding="24,2" FontSize="14"
                                     Command="{Binding ConnectButtonClickCommand}" />
            </Grid>
            <!-- Old,Unused, horizontal design, Dell UI team had changed the design
            <ListBox Style="{StaticResource ListBoxStyle_Devices}" Visibility="Collapsed"
            ItemTemplate="{StaticResource DeviceItemTemplate}"
            ItemsSource="{Binding DeviceCollection, Mode=TwoWay}"
            SelectedItem="{Binding SelDevice, Mode=OneWay}"
            SelectionChanged="deviceCollectionListBox_SelectionChanged" />
            -->
            <!-- Multi rows design -->
            <!-- Robert_Lin, 2024-8-5 Add handle PreviewKeyboard to eneble slecte a device with keyboard -->
            <ListView x:Name="HomeDevicesListView"  StylusDown="Pairing"
                      Style="{StaticResource ListViewStyle1}"
                      ItemsSource="{Binding HomeDevices}" PreviewKeyDown="HomeDevicesListView_PreviewKeyDown">
                <ListView.ItemContainerStyle>
                    <!-- ListView.ItemContainerStyle : Apply custom style to remove selection hover border -->
                    <Style TargetType="ListViewItem">
                        <Setter Property="SnapsToDevicePixels" Value="True" />
                        <Setter Property="Margin" Value="40,0,0,0" />
                        <Setter Property="MinWidth" Value="{Binding ItemMinWidth}" />
                        <Setter Property="MinHeight" Value="{Binding ItemMinWidth}" />
                        <Setter Property="MaxWidth" Value="{Binding ItemMaxWidth}" />
                        <Setter Property="MaxHeight" Value="{Binding ItemMaxWidth}" />
                        <Setter Property="Width" Value="{Binding ItemWidth}"/>
                        <Setter Property="Height" Value="{Binding ItemWidth}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="bd"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}"
                                            AutomationProperties.Name="Home device read"
                                            SnapsToDevicePixels="True">
                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                              VerticalAlignment="Stretch" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
