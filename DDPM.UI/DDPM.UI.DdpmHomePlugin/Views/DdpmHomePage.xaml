                                                        Duration="0:0:0.5" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger.Actions>
                                    </EventTrigger>
                                </Grid.Triggers>-->

                                <!-- BorderBrush="{StaticResource FocusDotBrush}" 
                                  <Border Name="bdItem" BorderBrush="{StaticResource FocusDotBrush}" Background="#02000000"
                                       Margin="0" Padding="0"
                                       Width="auto" Height="auto"
                                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                       Focusable="True"
                                       AutomationProperties.Name="Home device object"
                                       >
                             
                                -->
                                <Border Name="bdItem" BorderBrush="{StaticResource FocusDotBrush}" Background="#02000000"
