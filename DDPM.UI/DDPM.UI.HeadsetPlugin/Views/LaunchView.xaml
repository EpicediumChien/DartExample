<UserControl x:Class="DDPM.UI.Plugin.HeadsetPlugin.LaunchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             xmlns:common="clr-namespace:DDPM.UI.Common;assembly=DDPM.UI.Common"
             xmlns:PluginCommon="clr-namespace:DDPM.UI.Plugin.Common;assembly=DDPM.UI.Plugin.Common"
             xmlns:DDPMUserControls="clr-namespace:DDPM.UI.Common;assembly=DDPM.UI.Common"
             mc:Ignorable="d"
             xmlns:plugin="clr-namespace:DDPM.UI.Plugin.ViewModels;assembly=DDPM.UI.Plugin.Common"
             xmlns:lang="clr-namespace:DDPM.UI.Resources.Helper;assembly=DDPM.UI.Resources"
             d:DataContext="{d:DesignInstance Type=plugin:HeadsetViewModel}"
             d:DesignHeight="671" d:DesignWidth="1374">
    <UserControl.Resources>
        <ResourceDictionary>
            <!--<ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DDPM.UI.Common;component/PluginStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>-->
            <Storyboard x:Key="StoryGotoTwoView">
                <DoubleAnimation Storyboard.TargetName="RightGrid" Storyboard.TargetProperty="Width"
                                 Duration="0:0:0.4" From="{Binding RightFrameWidthFrom}" To="{Binding RightFrameWidthTo}" FillBehavior="HoldEnd" />
            </Storyboard>
            <Storyboard x:Key="StoryShrink">
                <DoubleAnimation Storyboard.TargetName="largeImage" Storyboard.TargetProperty="MaxWidth" From="620" To="500" Duration="0:0:0.4" AutoReverse="False" />
                <!--<DoubleAnimation Storyboard.TargetName="BottomGrid" Storyboard.TargetProperty="MaxHeight" From="540" To="500" Duration="0:0:0.4" AutoReverse="False" />-->
            </Storyboard>
            <Storyboard x:Key="StoryEnlarge">
                <DoubleAnimation Storyboard.TargetName="largeImage" Storyboard.TargetProperty="MaxWidth" Duration="0:0:0.4" From="500" To="620" />
                <!--<DoubleAnimation Storyboard.TargetName="BottomGrid" Storyboard.TargetProperty="MaxHeight" Duration="0:0:0.4" From="500" To="540" />-->
            </Storyboard>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <PluginCommon:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Right side: Header + RightView -->
            <Grid Grid.Column="1" Name="RightGrid" Width="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- RightViewHeader -->
                <common:RightViewHeaderCtrl Grid.Row="0" Name="rightViewHeaderCtrl"
                                            SelectedIndex="{Binding RightViewHeaderSelectedIndex, Mode=TwoWay}"
                                            ItemsSource="{Binding RightViewHeaders, Mode=TwoWay}"
                                            SelectionChanged="RightViewHeaderCtrl_SelectionChanged" />
                <ContentControl Grid.Row="1" Name="RightFrame" Content="{Binding RightView, Mode=TwoWay}" />
            </Grid>
            <!--Layer 2 : Nav and Vbar-->
            <Grid Grid.Column="0">
                <Border Background="#00FF0000" MouseLeftButtonDown="Mainframe_MouseLeftButtonDown" />
                <!--Image-->
                <Grid>
                    <Viewbox Name="largeImage" Margin="30,60" MaxWidth="620">
                        <Grid>
                            <!--<Grid>-->
                            <Image Source="{Binding ImageFilePath}" Stretch="Uniform" MouseLeftButtonDown="LargeImage_MouseLeftButtonDown" MaxWidth="620" />
                            <Rectangle Name="RecT" Fill="Transparent" Width="500" VerticalAlignment="Top" MouseDown="Mainframe_MouseLeftButtonDown"/>
                            <Rectangle Name="RecB" Fill="Transparent" Width="500" VerticalAlignment="Bottom" MouseDown="Mainframe_MouseLeftButtonDown"/>
                            <Rectangle Name="RecL" Fill="Transparent" Height="620" HorizontalAlignment="Left" MouseDown="Mainframe_MouseLeftButtonDown"/>
                            <Rectangle Name="RecR" Fill="Transparent" Height="620" HorizontalAlignment="Right" MouseDown="Mainframe_MouseLeftButtonDown"/>
                        </Grid>
                        <!--<Grid Margin="553,0,0,228.6">
                        <Image Source="/DDPM.UI.Resources;component/Resources/Images/TopButton5.png" Stretch="Uniform" MouseLeftButtonDown="LargeImage_MouseLeftButtonDown" MaxWidth="44.64" />
                        </Grid>
                        <Grid Margin="-296,356,0,228.6">
                        <Image Source="/DDPM.UI.Resources;component/Resources/Images/BarrelButton5.png" Stretch="Uniform" MouseLeftButtonDown="LargeImage_MouseLeftButtonDown" MaxWidth="40" />
                        </Grid>
                        <Grid Margin="0,0,0,228.6">
                        <Image Source="/DDPM.UI.Resources;component/Resources/Images/BarrelButton5.png" Stretch="Uniform" MouseLeftButtonDown="LargeImage_MouseLeftButtonDown" MaxWidth="44.64" />
                        </Grid>-->
                        <!--</Grid>-->
                    </Viewbox>
                </Grid>
            </Grid>
            <!--Vbar-->
            <!--<Grid HorizontalAlignment="Right" VerticalAlignment="Top" Name="VbarGrid">
                    <ItemsControl Name="vbarList" Margin="0,10,0,0"
                                  HorizontalAlignment="Right" VerticalAlignment="Top"
                                  ItemsSource="{Binding VbarItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <ContentPresenter />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Grid>-->
            <!--Name & Model-->
            <Grid VerticalAlignment="Top" Height="125">
                <Border Background="Transparent" MouseDown="PushBack"></Border>
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" x:Name="devNameStackPanel">
                        <Image x:Name="ArrowLeft" Margin="64,21,0,0" Source="{DynamicResource Arrow_Left}" Stretch="Fill"
                               VerticalAlignment="Top" HorizontalAlignment="Left" Cursor="" Width="24" Height="24">
                            <Image.InputBindings>
                                <MouseBinding Gesture="LeftClick" Command="{Binding GoBackClickedCommand, Mode=OneTime}" />
                            </Image.InputBindings>
                        </Image>
                        <UXControls:UXTextBlock Text="{Binding Name}" Margin="12,19,0,0" HorizontalAlignment="Left" TextWrapping="WrapWithOverflow"
                                                Style="{StaticResource ProductNameTextStyle}" Cursor="" VerticalAlignment="Top" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <UXControls:UXTextBlock Text="{Binding Model}" Margin="101,18,0,0" HorizontalAlignment="Left"
                                                Style="{StaticResource ModelNumberTextStyle}" />
                        <!--<Image Margin="9,22.5,0,0" Source="/DDPM.UI.Resources;component/Resources/Images/info.png" Stretch="Fill"
                               VerticalAlignment="Top" Cursor="" Width="16" Height="16">
                            <Image.InputBindings>
                                <MouseBinding Gesture="RightDoubleClick" Command="{Binding ShowInfoClickedCommand}" />
                            </Image.InputBindings>
                            <Image.ToolTip>
                                --><!--Elsa 20250401 for PIMS-348390 change VerticalOffset="6" to VerticalOffset="12" HorizontalOffset="8" to HorizontalOffset="2" --><!--
                                <ToolTip Placement="Top" VerticalOffset="12" HorizontalOffset="2">
                                    <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                        <Border.Resources>
                                            <Style BasedOn="{StaticResource Tooltip_TextBlockStyle}" TargetType="TextBlock" />
                                        </Border.Resources>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding FirmwareVersion2}" />
                                        </StackPanel>
                                    </Border>
                                </ToolTip>
                            </Image.ToolTip>
                        </Image>-->
                        <Button Style="{StaticResource StatelessButton}" Width="16" Height="16" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="9,22.5,0,0" KeyboardNavigation.TabIndex="14" AutomationProperties.Name="{Binding SelectedHomeDevice.DeviceInfoToolTipText}">
                            <!-- The (i) icon 16x16 -->
                            <ContentControl Template="{StaticResource icon_Info}"/>
                            <!-- ToolTip -->
                            <Button.ToolTip>
                                <!--Elsa 20250401 for PIMS-348390 change HorizontalOffset="0" to HorizontalOffset="2" -->
                                <ToolTip BorderThickness="0" Background="Transparent" Placement="Top" HorizontalOffset="2" VerticalOffset="12">
                                    <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                        <TextBlock Text="{Binding FirmwareVersion2}" Style="{StaticResource Tooltip_TextBlockStyle}" LineHeight="20"/>
                                    </Border>
                                </ToolTip>
                            </Button.ToolTip>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
            <!-- Vbar -->
            <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Name="VbarGrid">
                <ItemsControl Name="vbarList" Margin="0,5,10,0"
                                  HorizontalAlignment="Right" VerticalAlignment="Top"
                                  ItemsSource="{Binding VbarItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <ContentPresenter />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
            <!--Battery-->
            <Grid VerticalAlignment="Bottom">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Border Style="{StaticResource BorderConnection}" Margin="-70,0,0,8" Visibility="Collapsed" x:Name="DongleConnection">
                            <Grid Margin="16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <UXControls:UXTextBlock Grid.Column="0" Name="txt3" Style="{StaticResource ConnectionStyle3}" />
                                    <!--<Image Margin="4,0,0,0" Width="16" Height="16" Source="/DDPM.UI.Resources;component/Resources/Images/Dongle.png" />-->
                                    <ContentControl Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="16" Height="16"  Margin="0,5,8,5"
                                                    Template="{StaticResource icon_Dongle}" Foreground="{DynamicResource DefaultTheme_PathColor}" />
                                    <UXControls:UXTextBlock Grid.Column="2" Name="txtSystemName3" VerticalAlignment="Center" TextWrapping="WrapWithOverflow" LineHeight="20" Margin="0,3"
                                                            HorizontalAlignment="Left" FontFamily="{StaticResource RobotoFont}" Style="{StaticResource ConnectionStyle3}" />
                                </Grid>
                                <Line Grid.Row="1" X1="0" Y1="8" X2="220" Y2="8" Stroke="{DynamicResource EQLine_Color}" StrokeThickness="2" Height="16" />
                                <UXControls:UXTextBlock Grid.Row="2" Name="txtFirmware" Style="{StaticResource ConnectionStyle3}" LineHeight="24" TextWrapping="WrapWithOverflow" 
                                                        Margin="0,0,0,8"/>
                                <UXControls:UXTextBlock Grid.Row="3" Name="txtSlot" Style="{StaticResource ConnectionStyle3}" LineHeight="24" TextWrapping="WrapWithOverflow"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource BorderConnection}" Margin="{Binding ConnectionPopupMargin}" Visibility="Collapsed" x:Name="BLConnection" VerticalAlignment="Bottom" Width="252">
                            <StackPanel Orientation="Vertical">
                                <StackPanel Name="Host1" Orientation="Horizontal" Margin="20,18,0,0">
                                    <UXControls:UXTextBlock Name="txt1" Text="" FontSize="14"/>
                                    <ContentControl x:Name="imgBL1" Margin="4,0,0,0" Width="16" Height="16" Template="{StaticResource icon_Bluetooth}" Foreground="{DynamicResource DefaultTheme_PathColor}" />
                                    <!--<Image x:Name="imgBL1" Margin="4,0,0,0" Width="16" Height="16" />-->
                                    <UXControls:UXTextBlock Name="txtBLHost1" Margin="4,0,0,0" />
                                </StackPanel>
                                <StackPanel Name="Host2" Orientation="Horizontal" Margin="20,18,0,8">
                                    <UXControls:UXTextBlock Name="txt2" Text="" FontSize="14"/>
                                    <ContentControl x:Name="imgBL2" Margin="4,0,0,0" Width="16" Height="16" Template="{StaticResource icon_Bluetooth}" Foreground="{DynamicResource DefaultTheme_PathColor}" />
                                    <!--<Image x:Name="imgBL2" Margin="4,0,0,0" Width="16" Height="16" />-->
                                    <UXControls:UXTextBlock Name="txtBLHost2" Margin="4,0,0,0" />
                                </StackPanel>
                                <!-- Horz Line -->
                                <Line X1="15" Y1="10" X2="235" Y2="10" Stroke="{DynamicResource EQLine_Color}" StrokeThickness="2" />

                                <!-- This device can be paired with 2 hosts simulaneously -->
                                <UXControls:UXTextBlock Name="txtAudioBLText" Margin="20,16,20,16" Text="" FontSize="14" TextWrapping="Wrap" />
                            </StackPanel>
                            <!--<StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal" Margin="20,18,0,0">
                            <UXControls:UXTextBlock Name="txt1" Text="1" />
                            <Image x:Name="imgBL1" Margin="4,0,0,0" Width="16" Height="16" />
                            <UXControls:UXTextBlock Name="txtSystemName1" Margin="4,0,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="20,18,0,0">
                            <UXControls:UXTextBlock Name="txt2" Text="2" />
                            <Image x:Name="imgBL2" Margin="4,0,0,0" Width="16" Height="16" />
                            <UXControls:UXTextBlock Name="txtSystemName2" Margin="4,0,0,0" />
                            </StackPanel>
                            </StackPanel>-->
                        </Border>
                        <Border Style="{StaticResource BorderConnection}" Margin="-70,0,0,8" Visibility="Collapsed" x:Name="WiredConnection" Height="92" VerticalAlignment="Bottom">
                            <StackPanel Orientation="Vertical">
                                <StackPanel Orientation="Horizontal" Margin="20,18,0,0">
                                    <UXControls:UXTextBlock Name="Wiredtxt1" Text="1" />
                                    <ContentControl x:Name="imgWired1" Margin="4,0,0,0" Width="16" Height="16" Template="{StaticResource icon_Port}" Foreground="{DynamicResource DefaultTheme_PathColor}" />
                                    <!-- <Image x:Name="imgWired1" Margin="4,0,0,0" Width="16" Height="16" /> -->
                                    <UXControls:UXTextBlock Name="txtWiredSystemName" Margin="4,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <DDPMUserControls:BatteryIndicator Name="Battery" Margin="0,0,0,70" HorizontalAlignment="Center" MouseEnter="BatteryIndicator_MouseEnter"
                                                           BatteryLevel="{Binding BatteryLevel}" BatteryStatus="{Binding BatteryStatus}" MouseLeave="BatteryIndicator_MouseLeave"
                                                           ConnectionType="{Binding ConnectionType}" VerticalAlignment="Bottom" />
                        <Border Style="{StaticResource BorderUnpair}" Width="auto" MouseLeftButtonDown="Restore_Click" Cursor="Hand" Margin="8,0,0,70" x:Name="btnRestore" Visibility="{Binding IsRestoreEnable, Converter={StaticResource BoolToVisibilityConverter}}"
                                BorderBrush="{DynamicResource SecondaryButton_DefaultBdColor}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Padding="10,0,10,0" BorderBrush="{DynamicResource Button_UXStyleColor_ForWhiteFrame}" Background="Transparent" BorderThickness="1"  >
                                    <UXControls:UXTextBlock Name="txtRestore" VerticalAlignment="Center" Grid.Column="0" Foreground="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=Border}}"
                                                        HorizontalAlignment="Center" FontFamily="Roboto" FontSize="14" Text="{Binding [RestoreToDefault], Source={x:Static lang:LangHelper.Instance}}"/>
                                </Border>
                                <Image Grid.Column="1" Name="RestoreLockIcon" Visibility="Collapsed" Margin="0,0,6,0"
                                       Source="pack://application:,,,/DDPM.UI.Common;component/Resources/Lock.png"
                                       VerticalAlignment="Center" HorizontalAlignment="Center" Width="12" Height="12">
                                    <Image.ToolTip>
                                        <ToolTip>
                                            <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                                <Border.Resources>
                                                    <Style BasedOn="{StaticResource Tooltip_TextBlockStyle}" TargetType="TextBlock" />
                                                </Border.Resources>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding [ITLockToolTip.0], Source={x:Static lang:LangHelper.Instance}}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </ToolTip>
                                    </Image.ToolTip>
                                </Image>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource BorderUnpair}" Width="auto" MinWidth="105" MouseLeftButtonDown="Unpair_Click" Cursor="Hand" Margin="8,0,0,70" Visibility="Visible" x:Name="btnUnpair">
                            <Grid>
                                <Border Padding="10,0,10,0" BorderBrush="{DynamicResource Unpair_FgColor}" Background="Transparent" BorderThickness="1"  >
                                    <UXControls:UXTextBlock Name="txtUnpair" Foreground="{DynamicResource Unpair_FgColor}" VerticalAlignment="Center"
                                                        HorizontalAlignment="Center" FontFamily="Roboto" FontSize="14" Text="{Binding [Unpair], Source={x:Static lang:LangHelper.Instance}}"/>
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Please Wait -->
        <Grid x:Name="PleaseWaitGrid" Visibility="{Binding IsPleaseWaitVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Background="Transparent">
            <Border Width="587" Height="265"
                     BorderThickness="1" CornerRadius="4"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <Grid Height="40" HorizontalAlignment="Center" VerticalAlignment="Top"
                          Margin="0,64,0,32">
                        <UXControls:UXTextBlock Text="{Binding [HomePage.0], Source={x:Static lang:LangHelper.Instance}}"
                                                 FontSize="32" />
                    </Grid>
                    <Grid Height="64">
                        <UXControls:UXBusyIndicator Width="64" Height="64"
                                                    BusyIndicatorType="Secondary" IsActive="True" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>