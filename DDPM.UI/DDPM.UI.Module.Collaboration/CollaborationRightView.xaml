<UserControl x:Class="DDPM.UI.Module.Collaboration.CollaborationRightView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             xmlns:common="clr-namespace:DDPM.UI.Common;assembly=DDPM.UI.Common"
             xmlns:plugin="clr-namespace:DDPM.UI.Plugin.ViewModels;assembly=DDPM.UI.Plugin.Common"
             xmlns:PluginCommon="clr-namespace:DDPM.UI.Plugin.Common;assembly=DDPM.UI.Plugin.Common"
             d:DataContext="{d:DesignInstance Type=plugin:KeyboardViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="647" d:DesignWidth="520" VerticalAlignment="Top" HorizontalAlignment="Left">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DDPM.UI.Common;component/PluginStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <PluginCommon:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <Style x:Key="BroderStyle1" TargetType="Border">
                <Setter Property="Background" Value="#99132F54" />
                <Setter Property="Width" Value="236" />
                <Setter Property="Height" Value="56" />
            </Style>
            <Style x:Key="TextStyle1" TargetType="UXControls:UXTextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontFamily" Value="Roboto" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Foreground" Value="White" />
            </Style>
            <Style x:Key="ToggleStyle1" TargetType="UXControls:UXToggleSwitch">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontFamily" Value="Roboto" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="Foreground" Value="White" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Border Background="#99132F54" CornerRadius="13" Width="520"  Height="655" Margin="0,10,0,0">
            <StackPanel Orientation="Vertical">
                <Border Name="bdrAlert" Background="#364861" CornerRadius="4" Margin="16,23,16,-9" BorderThickness="7,0,0,0" BorderBrush="#0E92F2" MouseEnter="MessageBox_MouseEnter" MouseLeave="MessageBox_MouseLeave">
                    <StackPanel Orientation="Horizontal">
                        <Image x:Name="InfoIcon" Margin="12,0,0,0" Source="/DDPM.UI.Resources;component/Resources/Images/info.png" Stretch="Fill"
                               VerticalAlignment="Center" HorizontalAlignment="Left" Width="18" Height="18">
                        </Image>
                        <UXControls:UXTextBlock Name="txtMessage" FontSize="14" Background="#364861" Foreground="#F5F6F7" TextWrapping="Wrap" Width="415" Focusable="True"
                                                VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5,16,0,13" LineHeight="21" Padding="0,3,35,2">
                            <Run Name="txtAlert1" FontFamily="Roboto" FontWeight="Normal" AutomationProperties.Name="naAlert" />
                            <Run Name="txtLearnMore1" FontFamily="Roboto" Foreground="#31A2E3" FontWeight="Bold" Cursor="Hand" TextDecorations="Underline" KeyDown="txtLearnMore1_KeyDown" MouseLeftButtonDown="LearnMore_Click" Focusable="True" KeyboardNavigation.TabIndex="1" KeyboardNavigation.IsTabStop="True" />
                        </UXControls:UXTextBlock>
                        <Border Focusable="True" KeyboardNavigation.TabIndex="2" BorderThickness="0" KeyDown="Border_KeyDown">
                            <Image x:Name="CloseIcon" Source="/DDPM.UI.Common;component/Resources/Close.png" Stretch="Fill" Focusable="True"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" Width="15" Height="15" MouseLeftButtonDown="CloseDescription" Cursor="Hand">
                            </Image>
                        </Border>
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal">
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="430" />
                            <ColumnDefinition Width="74" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <UXControls:UXTextBlock Name="txtCollabsCaption" FontSize="20" Foreground="White" FontFamily="Roboto"
                                                        TextBlockSemanticColorType="Light" Margin="16,24,0,0" FontWeight="Normal" AutomationProperties.Name="nattt"
                                                        TextBlockType="Caption" MouseEnter="MessageBox_MouseEnter"
                                                        VerticalAlignment="Top" HorizontalAlignment="Left" />
                                <Image Margin="9,28,0,0" Source="/DDPM.UI.Resources;component/Resources/Images/info.png" Stretch="Uniform"
                                       VerticalAlignment="Top" HorizontalAlignment="Left" Cursor="Hand" Width="16" Height="16">
                                    <Image.ToolTip>
                                        <ToolTip Style="{StaticResource InfoToolTipStyle}" Placement="Top" VerticalOffset="8" HorizontalOffset="6">
                                            <TextBlock Name="txtCollabsTooltip" Style="{StaticResource TabInfoToolTipTextStyle}" />
                                        </ToolTip>
                                    </Image.ToolTip>
                                </Image>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Column="1">
                            <UXControls:UXToggleSwitch Margin="0,28,0,0" IsChecked="{Binding IsCollaborationKeyEnable}" VerticalContentAlignment="Center"
                                                       Content="{Binding IsCollaborationKeyEnableText}" Foreground="White" FontFamily="Roboto" FontSize="16" FontWeight="Normal"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                    </Grid>
                </StackPanel>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,23,0,0">
                        <Grid>
                            <Border Style="{StaticResource BroderStyle1}" Margin="16,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="100">
                                        <Image Margin="16,0,0,0" Source="/DDPM.UI.Resources;component/Resources/Images/Video.png" Stretch="Uniform" HorizontalAlignment="Left"
                                               Width="20" Height="14">
                                        </Image>
                                        <UXControls:UXTextBlock Name="txtVideo" Style="{StaticResource TextStyle1}" Margin="44,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                    </Grid>
                                    <Grid Width="120">
                                        <UXControls:UXToggleSwitch Margin="0" IsChecked="{Binding IsCollaborationCameraEnable}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                   Foreground="White" FontFamily="Roboto" FontSize="16" FontWeight="Normal"
                                                                   Content="{Binding IsCollaborationCameraEnableText}" IsEnabled="{Binding CameraToggleEnabled}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Name="bdrVideoShadow" Background="#60132F54" Margin="16,0,0,0" Visibility="{Binding IsCollabShadowVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>
                        <Grid>
                            <Border Style="{StaticResource BroderStyle1}" Margin="16,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="100">
                                        <Image Margin="16,0,0,0" Source="/DDPM.UI.Resources;component/Resources/Images/Share.png" Stretch="Uniform" VerticalAlignment="Center"
                                               Width="19" Height="20" HorizontalAlignment="Left">
                                        </Image>
                                        <UXControls:UXTextBlock Name="txtShare" Style="{StaticResource TextStyle1}" Margin="44,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                    </Grid>
                                    <Grid Width="120">
                                        <UXControls:UXToggleSwitch Margin="0" IsChecked="{Binding IsCollaborationScreenShareEnable}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                   Foreground="White" FontFamily="Roboto" FontSize="16" FontWeight="Normal"
                                                                   Content="{Binding IsCollaborationScreenShareEnableText}" IsEnabled="{Binding CameraToggleEnabled}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Background="#60132F54" Margin="16,0,0,0" Visibility="{Binding IsCollabShadowVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,16,0,0">
                        <Grid>
                            <Border Style="{StaticResource BroderStyle1}" Margin="16,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="100">
                                        <Image Margin="17,0,0,0" Source="/DDPM.UI.Resources;component/Resources/Images/ChatC.png" Stretch="Uniform"
                                               Width="18" Height="16" VerticalAlignment="Center" HorizontalAlignment="Left">
                                        </Image>
                                        <UXControls:UXTextBlock Name="txtChat" Style="{StaticResource TextStyle1}" Margin="44,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                    </Grid>
                                    <Grid Width="120">
                                        <UXControls:UXToggleSwitch Margin="0" IsChecked="{Binding IsCollaborationChatEnable}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                   Foreground="White" FontFamily="Roboto" FontSize="16" FontWeight="Normal"
                                                                   Content="{Binding IsCollaborationChatEnableText}" IsEnabled="{Binding ChatToggleEnabled}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Background="#60132F54" Margin="16,0,0,0" Visibility="{Binding IsCollabShadowVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>
                        <Grid>
                            <Border Style="{StaticResource BroderStyle1}" Margin="16,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="100">
                                        <Image Margin="10,0,0,0" Source="/DDPM.UI.Resources;component/Resources/Images/Mic.png" Stretch="Uniform"
                                               Width="28" Height="28" VerticalAlignment="Center" HorizontalAlignment="Left">
                                        </Image>
                                        <UXControls:UXTextBlock Name="txtMic" Style="{StaticResource TextStyle1}" Margin="44,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                    </Grid>
                                    <Grid Width="120">
                                        <UXControls:UXToggleSwitch Margin="0" IsChecked="{Binding IsCollaborationMicEnable}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                   Foreground="White" FontFamily="Roboto" FontSize="16" FontWeight="Normal"
                                                                   Content="{Binding IsCollaborationMicEnableText}" IsEnabled="{Binding MicToggleEnabled}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Background="#60132F54" Margin="16,0,0,0" Visibility="{Binding IsCollabShadowVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
                <Grid VerticalAlignment="top" Margin="0,12,0,0">
                    <Border Background="#99132F54" CornerRadius="6" Width="490" VerticalAlignment="Top" Margin="0,5,0,0">
                        <Grid VerticalAlignment="top">
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Left" Margin="0,18,0,0">
                                <UXControls:UXCheckBox Margin="10,0,0,0" Width="470" Height="42" IsChecked="{Binding IsCollaborationBlinkEffectEnable}" VerticalContentAlignment="Center"
                                                       IsEnabled="{Binding BlinkEffectToggleEnabled}"
                                                       Name="cbCollaborationBlinkEffectText" BorderThickness="0" Foreground="#F5F6F7" FontFamily="Roboto"
                                                       VerticalAlignment="Top" HorizontalAlignment="Left" FontWeight="Light" />
                                <UXControls:UXCheckBox Margin="10,8,0,0" Width="470" Height="42" IsChecked="{Binding IsCollaborationDoubleTapEnable}" VerticalContentAlignment="Center"
                                                       IsEnabled="{Binding DoubleTapToggleEnabled}"
                                                       Name="cbCollaborationDoubleTapText" BorderThickness="0" Foreground="#F5F6F7" FontFamily="Roboto"
                                                       VerticalAlignment="Top" HorizontalAlignment="Left" FontWeight="Light" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Background="#60132F54" CornerRadius="6" VerticalAlignment="Top" Margin="0,5,0,0"
                            Visibility="{Binding IsCollabShadowVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>