<UserControl x:Class="DDPM.UI.Module.WebCameraCapture.WebCameraCaptureRightView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             xmlns:plugin="clr-namespace:DDPM.UI.Plugin.ViewModels;assembly=DDPM.UI.Plugin.Common"
             xmlns:PluginCommon="clr-namespace:DDPM.UI.Plugin.Common;assembly=DDPM.UI.Plugin.Common"
             d:DataContext="{d:DesignInstance Type=plugin:WebCameraViewModel}"
             xmlns:common="clr-namespace:DDPM.UI.Common;assembly=DDPM.UI.Common"
             xmlns:lang="clr-namespace:DDPM.UI.Resources.Helper;assembly=DDPM.UI.Resources"
             mc:Ignorable="d"
             d:DesignHeight="675" d:DesignWidth="554">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DDPM.UI.Common;component/PluginStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <PluginCommon:HeightConverter x:Key="HeightConverter" />
            <Style x:Key="OpenButtonStyle" TargetType="common:ActionButton">
                <!--<Setter Property="Background" Value="#0D121A" />-->
                <!--<Setter Property="Foreground" Value="#FFFFFF" />-->
                <Setter Property="CornerRadius" Value="2" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{DynamicResource Button_UXStyleColor_ForWhiteFrame}" />
                <Setter Property="Foreground" Value="{DynamicResource Button_UXStyleColor_ForWhiteFrame}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontFamily" Value="Roboto" />
                <Setter Property="FontWeight" Value="Medium" />
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="BorderBrush" Value="#A3A3A3" />
                        <Setter Property="Foreground" Value="#6E6E6E" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="0,0,0,15">
        <Border CornerRadius="13" Margin="0,10,0,0" Width="470">
            <Border.Height>
                <MultiBinding Converter="{StaticResource HeightConverter}">
                    <Binding Path="Height" RelativeSource="{RelativeSource AncestorType=Grid}" />
                </MultiBinding>
            </Border.Height>
            <StackPanel Orientation="Vertical" Margin="16,16,16,0" IsEnabled="{Binding IsNotAddingProfile}">
                <Grid>
                    <UXControls:UXTextBlock Margin="0,10,0,6" Text="{Binding [Camera.3], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource ModuleCaptionStyle}" />

                    <Border Margin="0,0,67,0" Background="{StaticResource Webcam_UndoRedo_DisableBkColor}" HorizontalAlignment="Right" Width="40" Height="40" Visibility="{Binding Undo2Visibility}">
                        <ContentControl Template="{StaticResource icon_Undo}" Foreground="{DynamicResource Webcam_UndoRedo_DisableFgColor}"
                                        HorizontalAlignment="Center" VerticalContentAlignment="Center"/>
                    </Border>

                    <Border Margin="0,0,17,0" Background="{StaticResource Webcam_UndoRedo_DisableBkColor}" HorizontalAlignment="Right" Width="40" Height="40" Visibility="{Binding Redo2Visibility}">
                        <ContentControl Template="{StaticResource icon_Redo}" Foreground="{DynamicResource Webcam_UndoRedo_DisableFgColor}"
                                        HorizontalAlignment="Center" VerticalContentAlignment="Center"/>
                    </Border>

                    <Border Margin="0,0,67,0" Background="{DynamicResource Webcam_UndoRedo_BkColor}" HorizontalAlignment="Right" Width="40" Height="40" Visibility="{Binding UndoVisibility}"
                            MouseLeftButtonDown="Image_MouseLeftButtonDown" Tag="0" Cursor="Hand">
                        <ContentControl Template="{StaticResource icon_Undo}" Foreground="{DynamicResource DefaultTheme_PathColor}"
                                        HorizontalAlignment="Center" VerticalContentAlignment="Center"/>
                    </Border>

                    <Border Margin="0,0,17,0" Background="{DynamicResource Webcam_UndoRedo_BkColor}" HorizontalAlignment="Right" Width="40" Height="40" Visibility="{Binding RedoVisibility}"
                            MouseLeftButtonDown="Image_MouseLeftButtonDown" Tag="1" Cursor="Hand">
                        <ContentControl Template="{StaticResource icon_Redo}" Foreground="{DynamicResource DefaultTheme_PathColor}"
                                        HorizontalAlignment="Center" VerticalContentAlignment="Center"/>
                    </Border>
                </Grid>
                <Border CornerRadius="6" Margin="0,22,0,0">
                    <StackPanel Orientation="Vertical">
                        <UXControls:UXTextBlock Margin="18,25,0,18" Text="{Binding [WebCameraCapture.4], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource ModuleItemStyle}" IsEnabled="{Binding IsNotRecording}" />
                        <Grid Margin="18,0,18,18">
                            <!-- Define a Grid with three equal columns -->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="btnRes0_Col" Width="{Binding btnRes0_width}"  />
                                <!-- First column -->
                                <ColumnDefinition x:Name="btnRes1_Col" Width="{Binding btnRes1_width}" />
                                <!-- Second column -->
                                <ColumnDefinition x:Name="btnRes2_Col" Width="{Binding btnRes2_width}" />
                                <!-- Third column -->
                                <ColumnDefinition x:Name="btnRes3_Col" Width="{Binding btnRes3_width}" />
                                <!-- Third column -->
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" x:Name="btnRes0" Visibility="{Binding btnRes0_show}" CornerRadius="{Binding btnRes0_radius}" Focusable="True" MouseLeftButtonDown="btnResolution_Click" Height="30" Tag="0" IsEnabled="{Binding IsNotRecording}"
                                    HorizontalAlignment="Stretch">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource BorderBase}">
                                        <Setter Property="Background" Value="{DynamicResource RightView_Header_BkColor}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Resolution_IsSelected[0]}"  Value="True">
                                                <Setter Property="Background"  Value="{DynamicResource VbarItem_HiBkColor}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource VbarItem_HiBdColor}" />
                                            </DataTrigger>
                                            <Trigger Property="IsEnabled"  Value="false">
                                                <Setter Property="Opacity"  Value="0.5" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <UXControls:UXTextBlock x:Name="txtRes0" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Roboto">
                                    <UXControls:UXTextBlock.Style>
                                        <Style TargetType="UXControls:UXTextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource DefaultTheme_TxtColor}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Resolution_IsSelected[0]}"  Value="True">
                                                    <Setter Property="Foreground"  Value="#FFFFFF" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </UXControls:UXTextBlock.Style>
                                </UXControls:UXTextBlock>
                            </Border>
                            <Border Grid.Column="1" x:Name="btnRes1" Visibility="{Binding btnRes1_show}" CornerRadius="{Binding btnRes1_radius}" Focusable="True" MouseLeftButtonDown="btnResolution_Click" Height="30"  Tag="1" IsEnabled="{Binding IsNotRecording}"
                                    HorizontalAlignment="Stretch">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource BorderBase}">
                                        <Setter Property="Background" Value="{DynamicResource RightView_Header_BkColor}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Resolution_IsSelected[1]}"  Value="True">
                                                <Setter Property="Background"  Value="{DynamicResource VbarItem_HiBkColor}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource VbarItem_HiBdColor}" />
                                            </DataTrigger>
                                            <Trigger Property="IsEnabled"  Value="false">
                                                <Setter Property="Opacity"  Value="0.5" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <UXControls:UXTextBlock x:Name="txtRes1" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Roboto">
                                    <UXControls:UXTextBlock.Style>
                                        <Style TargetType="UXControls:UXTextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource DefaultTheme_TxtColor}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Resolution_IsSelected[1]}"  Value="True">
                                                    <Setter Property="Foreground"  Value="#FFFFFF" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </UXControls:UXTextBlock.Style>
                                </UXControls:UXTextBlock>
                            </Border>
                            <Border Grid.Column="2" x:Name="btnRes2" Visibility="{Binding btnRes2_show}" Focusable="True" MouseLeftButtonDown="btnResolution_Click" Height="30"  Tag="2" IsEnabled="{Binding IsNotRecording}"
                                    HorizontalAlignment="Stretch">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource BorderBase}">
                                        <Setter Property="Background" Value="{DynamicResource RightView_Header_BkColor}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Resolution_IsSelected[2]}"  Value="True">
                                                <Setter Property="Background"  Value="{DynamicResource VbarItem_HiBkColor}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource VbarItem_HiBdColor}" />
                                            </DataTrigger>
                                            <Trigger Property="IsEnabled"  Value="false">
                                                <Setter Property="Opacity"  Value="0.5" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <UXControls:UXTextBlock x:Name="txtRes2" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Roboto">
                                        <UXControls:UXTextBlock.Style>
                                            <Style TargetType="UXControls:UXTextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource DefaultTheme_TxtColor}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Resolution_IsSelected[2]}"  Value="True">
                                                        <Setter Property="Foreground"  Value="#FFFFFF" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </UXControls:UXTextBlock.Style>
                                    </UXControls:UXTextBlock>
                                </Grid>
                            </Border>
                            <Border Grid.Column="3" x:Name="btnRes3" Visibility="{Binding btnRes3_show}" Focusable="True" MouseLeftButtonDown="btnResolution_Click" Height="30"  Tag="3" IsEnabled="{Binding IsNotRecording}"
                                    HorizontalAlignment="Stretch">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource BorderBase}">
                                        <Setter Property="Background" Value="{DynamicResource RightView_Header_BkColor}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Resolution_IsSelected[2]}"  Value="True">
                                                <Setter Property="Background"  Value="{DynamicResource VbarItem_HiBkColor}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource VbarItem_HiBdColor}" />
                                            </DataTrigger>
                                            <Trigger Property="IsEnabled"  Value="false">
                                                <Setter Property="Opacity"  Value="0.5" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <UXControls:UXTextBlock x:Name="txtRes3" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Roboto">
                                        <UXControls:UXTextBlock.Style>
                                            <Style TargetType="UXControls:UXTextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource DefaultTheme_TxtColor}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Resolution_IsSelected[3]}"  Value="True">
                                                        <Setter Property="Foreground"  Value="#FFFFFF" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </UXControls:UXTextBlock.Style>
                                    </UXControls:UXTextBlock>
                                </Grid>
                            </Border>
                        </Grid>

                        <Border Width="400" Name="bdrAlertUsbtype" Background="#364861" CornerRadius="4" Margin="0,0,0,15" BorderThickness="7,0,0,0" BorderBrush="#0E92F2" Visibility="{Binding MessageBoxVisibilityUsbType}">
                            <StackPanel Orientation="Horizontal">
                                <!--<Image x:Name="InfoIcon" Margin="10,0,0,0" Source="/DDPM.UI.Resources;component/Resources/Images/info.png" Stretch="Fill"
                               VerticalAlignment="Center" HorizontalAlignment="Left" Width="18" Height="18">
                                </Image>-->
                                <ContentControl Template="{StaticResource icon_Info}" Margin="10,0,0,0" Width="18" Height="18" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                <UXControls:UXTextBlock Name="txtMessage" FontSize="13" Background="#364861" Foreground="#F5F6F7" TextWrapping="Wrap" Width="362" 
                                          Text="{Binding usbtype_info}"
                                          VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5,15,0,13" LineHeight="21" Padding="2,3,10,2">
                                </UXControls:UXTextBlock>
                                <Image x:Name="CloseIcon" Source="/DDPM.UI.Common;component/Resources/Close.png" Stretch="Fill" Focusable="True"
                         VerticalAlignment="Center" HorizontalAlignment="Right" Width="15" Height="15" MouseLeftButtonDown="CloseMessageBox" Cursor="Hand">
                                </Image>
                            </StackPanel>
                        </Border>


          </StackPanel>
        </Border>
        <Border CornerRadius="6" Margin="0,10,0,0">
          <StackPanel Orientation="Vertical">
            <StackPanel Orientation="Horizontal" Margin="18,25,0,18">
              <UXControls:UXTextBlock Text="{Binding [WebCameraCapture.8], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource ModuleItemStyle}" IsEnabled="{Binding IsNotRecording}" />
              <Border Background="{StaticResource FakeTransparent}" Cursor="Hand">
                <ContentControl Template="{StaticResource icon_Info}" Margin="9,0,0,0" Width="16" Height="16"/>
                <Border.ToolTip>
                  <ToolTip Placement="Right" VerticalOffset="-75" HorizontalOffset="-15">
                    <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                      <TextBlock Width="350" Height="56" Text="{Binding [WebCameraCapture.9], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource Tooltip_TextBlockStyle}" TextWrapping="Wrap" />
                    </Border>
                  </ToolTip>
                </Border.ToolTip>
              </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="18,0,18,18">
              <Border x:Name="btnFPS0" CornerRadius="5,0,0,5" Focusable="True" MouseLeftButtonDown="btnFPS_Click" Height="30" Width="{Binding btnRes3_width}" Tag="0" IsEnabled="{Binding IsNotRecording}">
                <Border.Style>
                  <Style TargetType="Border" BasedOn="{StaticResource BorderBase}">
                    <Setter Property="Background" Value="{DynamicResource RightView_Header_BkColor}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding FPS_IsSelected[0]}"  Value="True">
                        <Setter Property="Background"  Value="{DynamicResource VbarItem_HiBkColor}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource VbarItem_HiBdColor}" />
                      </DataTrigger>
                      <Trigger Property="IsEnabled"  Value="false">
                        <Setter Property="Opacity"  Value="0.5" />
                      </Trigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <UXControls:UXTextBlock x:Name="txtFPS0" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Roboto">
                  <UXControls:UXTextBlock.Style>
                    <Style TargetType="UXControls:UXTextBlock">
                      <Setter Property="Foreground" Value="{DynamicResource DefaultTheme_TxtColor}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding FPS_IsSelected[0]}"  Value="True">
                          <Setter Property="Foreground"  Value="#FFFFFF" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </UXControls:UXTextBlock.Style>
                </UXControls:UXTextBlock>
              </Border>
              <Border x:Name="btnFPS1" Focusable="True" MouseLeftButtonDown="btnFPS_Click" Height="30" Width="100" Tag="1" IsEnabled="{Binding IsFPS1Enable}">
                <Border.Style>
                  <Style TargetType="Border" BasedOn="{StaticResource BorderBase}">
                    <Setter Property="Background" Value="{DynamicResource RightView_Header_BkColor}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding FPS_IsSelected[1]}"  Value="True">
                        <Setter Property="Background"  Value="{DynamicResource VbarItem_HiBkColor}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource VbarItem_HiBdColor}" />
                      </DataTrigger>
                      <Trigger Property="IsEnabled"  Value="false">
                        <Setter Property="Opacity"  Value="0.5" />
                      </Trigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <UXControls:UXTextBlock x:Name="txtFPS1" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Roboto">
                  <UXControls:UXTextBlock.Style>
                    <Style TargetType="UXControls:UXTextBlock">
                      <Setter Property="Foreground" Value="{DynamicResource DefaultTheme_TxtColor}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding FPS_IsSelected[1]}"  Value="True">
                          <Setter Property="Foreground"  Value="#FFFFFF" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </UXControls:UXTextBlock.Style>
                </UXControls:UXTextBlock>
              </Border>
              <Border x:Name="btnFPS2" Focusable="True" MouseLeftButtonDown="btnFPS_Click" Height="30" Width="100" Tag="2" IsEnabled="{Binding IsFPS2Enable}">
                <Border.Style>
                  <Style TargetType="Border" BasedOn="{StaticResource BorderBase}">
                    <Setter Property="Background" Value="{DynamicResource RightView_Header_BkColor}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding FPS_IsSelected[2]}"  Value="True">
                        <Setter Property="Background"  Value="{DynamicResource VbarItem_HiBkColor}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource VbarItem_HiBdColor}" />
                      </DataTrigger>
                      <Trigger Property="IsEnabled"  Value="false">
                        <Setter Property="Opacity"  Value="0.5" />
                      </Trigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <Grid>
                  <UXControls:UXTextBlock x:Name="txtFPS2" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Roboto">
                    <UXControls:UXTextBlock.Style>
                      <Style TargetType="UXControls:UXTextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource DefaultTheme_TxtColor}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding FPS_IsSelected[2]}"  Value="True">
                            <Setter Property="Foreground"  Value="#FFFFFF" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </UXControls:UXTextBlock.Style>
                  </UXControls:UXTextBlock>
                </Grid>
              </Border>
            </StackPanel>
          </StackPanel>
        </Border>
        <Border CornerRadius="6" Margin="0,10,0,0">
          <StackPanel Orientation="Vertical" Margin="18,12,0,02">
            <UXControls:UXCheckBox Name="ckboxCountdown" Margin="0" Content="{Binding [WebCameraCapture.0], Source={x:Static lang:LangHelper.Instance}}" IsChecked="{Binding WebcamCountdown}" FontFamily="Roboto" Foreground="{DynamicResource DefaultTheme_TxtColor}" />
            <UXControls:UXCheckBox Name="ckboxFramingGrid" Margin="0,15,0,12" Content="{Binding [WebCameraCapture.1], Source={x:Static lang:LangHelper.Instance}}" IsChecked="{Binding WebcamGrid}" FontFamily="Roboto" Foreground="{DynamicResource DefaultTheme_TxtColor}" />
          </StackPanel>
        </Border>
        <Border CornerRadius="6" Margin="0,10,0,4000">
          <StackPanel Orientation="Vertical">
            <StackPanel Orientation="Vertical" Margin="18,25,0,18">
              <UXControls:UXTextBlock Text="{Binding [WebCameraCapture.10], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource ModuleItemStyle}" />
              <StackPanel Orientation="Horizontal" Margin="15,15,15,0">
                <UXControls:UXTextBox Name="txtCaptureFolder" AutomationProperties.Name="TextBoxDefault" Width="165" Height="40"  IsReadOnly="True" FontFamily="Roboto" FontSize="14" VerticalAlignment="Center" Padding="8,10,0,0"
                                                      TextWrapping ="NoWrap"  Background="{DynamicResource Webcam_TextBox_BkColor}" Foreground="{DynamicResource Webcam_TextBox_FgColor}"/>
                                <common:ActionButton Name="btnOpen" Margin="8,0,8,0" Style="{StaticResource OpenButtonStyle}" MouseLeftButtonDown="Open_Click"  Width="97" Height="40" FontFamily="Roboto" Cursor="Hand" IsEnabled="{Binding IsNotRecording}">
                                    <!--<UXControls:UXButton.Style>
                    <Style TargetType="UXControls:UXButton">
                      <Style.Triggers>
                        <Trigger Property="IsEnabled"  Value="false">
                          <Setter Property="Opacity"  Value="0.5" />
                        </Trigger>
                      </Style.Triggers>
                    </Style>
                  </UXControls:UXButton.Style>-->
                                </common:ActionButton>
                                <UXControls:UXButton ButtonType="Primary" Click="Change_Click" Content="{Binding [WebCameraCapture.3], Source={x:Static lang:LangHelper.Instance}}" Width="112" Height="40" FontFamily="Roboto" Cursor="Hand" IsEnabled="{Binding IsNotRecording}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>