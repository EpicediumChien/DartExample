<UserControl x:Class="DDPM.UI.Module.WebCameraCapture.WebCameraCaptureRightView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             xmlns:plugin="clr-namespace:DDPM.UI.Plugin.ViewModels;assembly=DDPM.UI.Plugin.Common"
             xmlns:PluginCommon="clr-namespace:DDPM.UI.Plugin.Common;assembly=DDPM.UI.Plugin.Common"
             d:DataContext="{d:DesignInstance Type=plugin:WebCameraViewModel}"
             xmlns:common="clr-namespace:DDPM.UI.Common;assembly=DDPM.UI.Common"
             xmlns:lang="clr-namespace:DDPM.UI.Resources.Helper;assembly=DDPM.UI.Resources"
             mc:Ignorable="d"
             d:DesignHeight="675" d:DesignWidth="554" VerticalAlignment="Top" HorizontalAlignment="Left">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/DDPM.UI.Common;component/PluginStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <PluginCommon:HeightConverter x:Key="HeightConverter" />
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid Margin="0,0,0,15">
    <Border Background="#99132F54" CornerRadius="13" Margin="0,10,0,0" Width="470">
      <Border.Height>
        <MultiBinding Converter="{StaticResource HeightConverter}">
          <Binding Path="Height" RelativeSource="{RelativeSource AncestorType=Grid}" />
        </MultiBinding>
      </Border.Height>
      <StackPanel Orientation="Vertical" Margin="16,16,16,0">
        <StackPanel>
          <UXControls:UXTextBlock Text="{Binding [Camera.3], Source={x:Static lang:LangHelper.Instance}}" Margin="0,10,0,0" Style="{StaticResource ModuleCaptionStyle}" />
        </StackPanel>
        <Border Background="#99132F54" CornerRadius="6" Margin="0,22,0,0">
          <StackPanel Orientation="Vertical">
            <StackPanel Orientation="Vertical" Margin="18,25,18,18">
              <StackPanel Orientation="Horizontal">
                <UXControls:UXTextBlock Text="{Binding [WebCameraCapture.4], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource ModuleItemStyle}" />
              </StackPanel>
              <Grid Margin="0,15,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" BorderThickness="2" CornerRadius="5" Focusable="True" MouseLeftButtonDown="Resolution_4KUHD_Button_Click" Height="30">
                  <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Border_Test}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Resolution_IsSelected[0]}"  Value="True">
                          <Setter Property="Background"  Value="{StaticResource VbarItem_HiBkColor}" />
                          <Setter Property="BorderBrush" Value="{StaticResource VbarItem_HiBdColor}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <Grid>
                    <UXControls:UXTextBlock Text="{Binding [WebCameraCapture.5], Source={x:Static lang:LangHelper.Instance}}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" AutomationProperties.Name="Primary1" />
                  </Grid>
                </Border>
                <Border Grid.Column="1" BorderThickness="2" CornerRadius="5" Focusable="True" MouseLeftButtonDown="Resolution_FullHD_Button_Click" Height="30">
                  <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Border_Test}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Resolution_IsSelected[1]}"  Value="True">
                          <Setter Property="Background"  Value="{StaticResource VbarItem_HiBkColor}" />
                          <Setter Property="BorderBrush" Value="{StaticResource VbarItem_HiBdColor}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <Grid>
                    <UXControls:UXTextBlock Text="{Binding [WebCameraCapture.6], Source={x:Static lang:LangHelper.Instance}}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" AutomationProperties.Name="Primary1" />
                  </Grid>
                </Border>
                <Border Grid.Column="2" BorderThickness="2" CornerRadius="5" Focusable="True" MouseLeftButtonDown="Resolution_HD_Button_Click" Height="30">
                  <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Border_Test}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Resolution_IsSelected[2]}"  Value="True">
                          <Setter Property="Background"  Value="{StaticResource VbarItem_HiBkColor}" />
                          <Setter Property="BorderBrush" Value="{StaticResource VbarItem_HiBdColor}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <Grid>
                    <UXControls:UXTextBlock Text="{Binding [WebCameraCapture.7], Source={x:Static lang:LangHelper.Instance}}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" AutomationProperties.Name="Primary1" />
                  </Grid>
                </Border>
              </Grid>
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Background="#99132F54" CornerRadius="6" Margin="0,10,0,0">
          <StackPanel Orientation="Vertical">
            <StackPanel Orientation="Vertical" Margin="18,25,18,18">
              <StackPanel Orientation="Horizontal">
                <UXControls:UXTextBlock Text="{Binding [WebCameraCapture.8], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource ModuleItemStyle}" />
                <Image Margin="9,0,0,0" Source="/DDPM.UI.Common;component/Resources/info.png" Stretch="Uniform" Cursor="Hand" Width="16" Height="16">
                  <Image.ToolTip>
                    <ToolTip Style="{StaticResource InfoToolTipStyle}" Placement="Top" VerticalOffset="8" HorizontalOffset="6">
                      <TextBlock Width="350" Height="56" Text="{Binding [WebCameraCapture.9], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource TabInfoToolTipTextStyle}" TextWrapping="Wrap" />
                    </ToolTip>
                  </Image.ToolTip>
                </Image>
              </StackPanel>
              <Grid Margin="0,15,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" BorderThickness="2" CornerRadius="5" Focusable="True" MouseLeftButtonDown="FPS_24_Button_Click" Height="30">
                  <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Border_Test}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding FPS_IsSelected[0]}"  Value="True">
                          <Setter Property="Background"  Value="{StaticResource VbarItem_HiBkColor}" />
                          <Setter Property="BorderBrush" Value="{StaticResource VbarItem_HiBdColor}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <Grid>
                    <UXControls:UXTextBlock Text="24" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" AutomationProperties.Name="Primary1" />
                  </Grid>
                </Border>
                <Border Grid.Column="1" BorderThickness="2" CornerRadius="5" Focusable="True" MouseLeftButtonDown="FPS_30_Button_Click" Height="30">
                  <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Border_Test}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding FPS_IsSelected[1]}"  Value="True">
                          <Setter Property="Background"  Value="{StaticResource VbarItem_HiBkColor}" />
                          <Setter Property="BorderBrush" Value="{StaticResource VbarItem_HiBdColor}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <Grid>
                    <UXControls:UXTextBlock Text="30" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" AutomationProperties.Name="Primary1" />
                  </Grid>
                </Border>
                <Border Grid.Column="2" BorderThickness="2" CornerRadius="5" Focusable="True" MouseLeftButtonDown="FPS_60_Button_Click" Height="30">
                  <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Border_Test}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding FPS_IsSelected[2]}"  Value="True">
                          <Setter Property="Background"  Value="{StaticResource VbarItem_HiBkColor}" />
                          <Setter Property="BorderBrush" Value="{StaticResource VbarItem_HiBdColor}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <Grid>
                    <UXControls:UXTextBlock Text="60" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" AutomationProperties.Name="Primary1" />
                  </Grid>
                </Border>
              </Grid>
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Background="#99132F54" CornerRadius="6" Margin="0,10,0,0">
          <StackPanel Orientation="Vertical" Margin="18,12,0,02">
            <UXControls:UXCheckBox Name="ckboxCountdown" Margin="0" Content="{Binding [WebCameraCapture.0], Source={x:Static lang:LangHelper.Instance}}" IsChecked="{Binding WebcamCountdown}" Foreground="#F5F6F7" FontFamily="Roboto" />
            <UXControls:UXCheckBox Name="ckboxFramingGrid" Margin="0,15,0,12" Content="{Binding [WebCameraCapture.1], Source={x:Static lang:LangHelper.Instance}}" IsChecked="{Binding WebcamGrid}" Foreground="#F5F6F7" FontFamily="Roboto" />
          </StackPanel>
        </Border>
        <Border Background="#99132F54" CornerRadius="6" Margin="0,10,0,4000">
          <StackPanel Orientation="Vertical">
            <StackPanel Orientation="Vertical" Margin="18,25,0,18">
              <UXControls:UXTextBlock Text="{Binding [WebCameraCapture.10], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource ModuleItemStyle}" />
              <StackPanel Orientation="Horizontal" Margin="15,15,15,0">
                <UXControls:UXTextBox Name="txtCaptureFolder" AutomationProperties.Name="TextBoxDefault" Width="165" Height="40" Background="#141D28" Foreground="#7E7E7E" IsReadOnly="True" FontFamily="Roboto" FontSize="14" VerticalAlignment="Center" Padding="8,10,0,0" />
                <UXControls:UXButton Margin="8,0,8,0" ButtonType="Secondary" Click="Open_Click" Content="{Binding [WebCameraCapture.2], Source={x:Static lang:LangHelper.Instance}}" Width="97" Height="40" Foreground="White" BorderBrush="White" FontFamily="Roboto" Cursor="Hand" />
                <UXControls:UXButton ButtonType="Primary" Click="Change_Click" Content="{Binding [WebCameraCapture.3], Source={x:Static lang:LangHelper.Instance}}" Width="112" Height="40" FontFamily="Roboto" Cursor="Hand" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>