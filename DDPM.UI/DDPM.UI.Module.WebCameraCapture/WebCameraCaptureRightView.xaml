<UserControl x:Class="DDPM.UI.Module.WebCameraCapture.WebCameraCaptureRightView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             xmlns:plugin="clr-namespace:DDPM.UI.Plugin.ViewModels;assembly=DDPM.UI.Plugin.Common"
             xmlns:PluginCommon="clr-namespace:DDPM.UI.Plugin.Common;assembly=DDPM.UI.Plugin.Common"
             d:DataContext="{d:DesignInstance Type=plugin:WebCameraViewModel}"
             xmlns:common="clr-namespace:DDPM.UI.Common;assembly=DDPM.UI.Common"
             mc:Ignorable="d"
             d:DesignHeight="675" d:DesignWidth="554" VerticalAlignment="Top" HorizontalAlignment="Left">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DDPM.UI.Common;component/PluginStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!--<PluginCommon:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />-->
            <PluginCommon:ThicknessConverter x:Key="MarginConverter" />
            <PluginCommon:HeightConverter x:Key="HeightConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <UXControls:UXScrollViewer>
            <Border Background="#99132F54" CornerRadius="13" Margin="0,10,0,0" Width="470">
                <Border.Height>
                    <MultiBinding Converter="{StaticResource HeightConverter}">
                        <Binding Path="Height" RelativeSource="{RelativeSource AncestorType=Grid}" />
                    </MultiBinding>
                </Border.Height>
                <StackPanel>
                    <Grid Margin="14,16,14,16">
                        <UXControls:UXTextBlock Text="Capture" Margin="0,6,0,6" Style="{StaticResource ModuleCaptionStyle}" />
                    </Grid>
                    <Grid Margin="16,0,16,10">
                        <Border Background="#99132F54" CornerRadius="6">
                            <StackPanel Orientation="Vertical">
                                <StackPanel Orientation="Vertical" Margin="18,22,18,18">
                                    <StackPanel Orientation="Horizontal">
                                        <UXControls:UXTextBlock Text="Resolution" Style="{StaticResource ModuleItemStyle}" />
                                    </StackPanel>
                                    <Grid Margin="0,15,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" BorderThickness="2" CornerRadius="5" Focusable="True" MouseLeftButtonDown="Resolution_4KUHD_Button_Click" Height="30">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource Border_Test}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Resolution_IsSelected[0]}"  Value="True">
                                                            <Setter Property="Background"  Value="{StaticResource VbarItem_HiBkColor}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource VbarItem_HiBdColor}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <UXControls:UXTextBlock Text="4K UHD" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" AutomationProperties.Name="Primary1" />
                                            </Grid>
                                        </Border>
                                        <Border Grid.Column="1" BorderThickness="2" CornerRadius="5" Focusable="True" MouseLeftButtonDown="Resolution_FullHD_Button_Click" Height="30">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource Border_Test}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Resolution_IsSelected[1]}"  Value="True">
                                                            <Setter Property="Background"  Value="{StaticResource VbarItem_HiBkColor}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource VbarItem_HiBdColor}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <UXControls:UXTextBlock Text="Full HD" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" AutomationProperties.Name="Primary1" />
                                            </Grid>
                                        </Border>
                                        <Border Grid.Column="2" BorderThickness="2" CornerRadius="5" Focusable="True" MouseLeftButtonDown="Resolution_HD_Button_Click" Height="30">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource Border_Test}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Resolution_IsSelected[2]}"  Value="True">
                                                            <Setter Property="Background"  Value="{StaticResource VbarItem_HiBkColor}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource VbarItem_HiBdColor}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <UXControls:UXTextBlock Text="HD" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" AutomationProperties.Name="Primary1" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid Margin="16,0,16,10">
                        <Border Background="#99132F54" CornerRadius="6">
                            <StackPanel Orientation="Vertical">
                                <StackPanel Orientation="Vertical" Margin="18,22,18,18">
                                    <StackPanel Orientation="Horizontal">
                                        <UXControls:UXTextBlock Text="FPS" Style="{StaticResource ModuleItemStyle}" />
                                        <Image Margin="9,0,0,0" Source="/DDPM.UI.Common;component/Resources/info.png" Stretch="Uniform" Cursor="Hand" Width="16" Height="16">
                                            <Image.ToolTip>
                                                <ToolTip Style="{StaticResource InfoToolTipStyle}" Placement="Top" VerticalOffset="8" HorizontalOffset="6">
                                                    <TextBlock Width="350" Height="56" Text="Controls video clarity and style by adjusting the number of images captured per second" Style="{StaticResource TabInfoToolTipTextStyle}" />
                                                </ToolTip>
                                            </Image.ToolTip>
                                        </Image>
                                    </StackPanel>
                                    <Grid Margin="0,15,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" BorderThickness="2" CornerRadius="5" Focusable="True" MouseLeftButtonDown="FPS_24_Button_Click" Height="30">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource Border_Test}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding FPS_IsSelected[0]}"  Value="True">
                                                            <Setter Property="Background"  Value="{StaticResource VbarItem_HiBkColor}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource VbarItem_HiBdColor}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <UXControls:UXTextBlock Text="24" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" AutomationProperties.Name="Primary1" />
                                            </Grid>
                                        </Border>
                                        <Border Grid.Column="1" BorderThickness="2" CornerRadius="5" Focusable="True" MouseLeftButtonDown="FPS_30_Button_Click" Height="30">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource Border_Test}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding FPS_IsSelected[1]}"  Value="True">
                                                            <Setter Property="Background"  Value="{StaticResource VbarItem_HiBkColor}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource VbarItem_HiBdColor}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <UXControls:UXTextBlock Text="30" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" AutomationProperties.Name="Primary1" />
                                            </Grid>
                                        </Border>
                                        <Border Grid.Column="2" BorderThickness="2" CornerRadius="5" Focusable="True" MouseLeftButtonDown="FPS_60_Button_Click" Height="30">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource Border_Test}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding FPS_IsSelected[2]}"  Value="True">
                                                            <Setter Property="Background"  Value="{StaticResource VbarItem_HiBkColor}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource VbarItem_HiBdColor}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <UXControls:UXTextBlock Text="60" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" AutomationProperties.Name="Primary1" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid Margin="16,0,16,10">
                        <Border Background="#99132F54" CornerRadius="6">
                            <StackPanel Orientation="Vertical" Margin="18,22,0,18">
                                <UXControls:UXCheckBox Margin="0,0,0,8" Content="3-2-1 Countdown" IsChecked="{Binding Countdown_IsChecked}" Foreground="#F5F6F7" />
                                <UXControls:UXCheckBox Name="ckboxFramingGrid" Margin="0,8,0,8" Content="Framing Grid" IsChecked="{Binding FramingGrid_IsChecked}" Foreground="#F5F6F7" Checked="ChkBoxFramingGrid_Checked" Unchecked="ChkBoxFramingGrid_Unchecked" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid Margin="16,0,16,10">
                        <Border Background="#99132F54" CornerRadius="6">
                            <StackPanel Orientation="Vertical">
                                <StackPanel Orientation="Vertical" Margin="18,22,0,18">
                                    <StackPanel Orientation="Horizontal">
                                        <UXControls:UXTextBlock Text="Media Files Location" Style="{StaticResource ModuleItemStyle}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="15,15,15,0">
                                        <UXControls:UXTextBox Grid.Column="0" AutomationProperties.Name="TextBoxDefault" Width="165" Height="40" Background="#141D28" Foreground="#7E7E7E" IsReadOnly="True" />
                                        <UXControls:UXButton Grid.Column="1" Margin="8,0,8,0" ButtonType="Secondary" AutomationProperties.Name="Primary1" ButtonSize="Medium" Click="Open_Click" Content="Open" Width="112" Height="40" Foreground="White" BorderBrush="White" />
                                        <UXControls:UXButton Grid.Column="2" ButtonType="Primary" AutomationProperties.Name="Primary1" ButtonSize="Medium" Click="Change_Click" Content="Change" Width="112" Height="40" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </UXControls:UXScrollViewer>
    </Grid>
</UserControl>