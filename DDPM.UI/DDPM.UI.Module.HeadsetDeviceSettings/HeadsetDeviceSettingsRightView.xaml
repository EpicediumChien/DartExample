<UserControl x:Class="DDPM.UI.Module.HeadsetDeviceSettings.HeadsetDeviceSettingsRightView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             xmlns:plugin="clr-namespace:DDPM.UI.Plugin.ViewModels;assembly=DDPM.UI.Plugin.Common"
             xmlns:PluginCommon="clr-namespace:DDPM.UI.Plugin.Common;assembly=DDPM.UI.Plugin.Common"
             xmlns:lang="clr-namespace:DDPM.UI.Resources.Helper;assembly=DDPM.UI.Resources"
             d:DataContext="{d:DesignInstance Type=plugin:HeadsetViewModel}"
             xmlns:common="clr-namespace:DDPM.UI.Common;assembly=DDPM.UI.Common"
             mc:Ignorable="d"
             d:DesignHeight="655" d:DesignWidth="520">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DDPM.UI.Common;component/PluginStyles.xaml" />
                <ResourceDictionary Source="/DDPM.UI.Common;component/ModuleStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <ImageBrush x:Key="UnselectedNodeImage" ImageSource="pack://application:,,,/DDPM.UI.Common;component/Resources/Headset_Dot.png" />
            <ImageBrush x:Key="SelectedNodeImage" ImageSource="pack://application:,,,/DDPM.UI.Common;component/Resources/Headset_whitedot.png" />

            <SolidColorBrush x:Key="SplitItem_BkColor" Color="#FF132F54" />
            <SolidColorBrush x:Key="SplitItem_NormalBdColor" Color="#FF0B1E38" />
            <SolidColorBrush x:Key="SplitItem_SelectedColor" Color="#FF5CC1EE" />

            <LinearGradientBrush x:Key="SplitItem_HoverBdColor" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#FF0672CB" />
                <GradientStop Offset="0.5" Color="#FF0078D4" />
                <GradientStop Offset="1" Color="#FF6E69CF" />
            </LinearGradientBrush>

            <!-- Border Style of Normal State -->
            <Style x:Key="SplitItemBorder_Normal" TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource SplitItem_NormalBdColor}" />
                <Setter Property="BorderThickness" Value="4" />
                <Setter Property="Padding" Value="0" />
            </Style>

            <!-- Border Style of Hover State -->
            <Style x:Key="SplitItemBorder_Hover" TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource SplitItem_HoverBdColor}" />
                <Setter Property="BorderThickness" Value="4" />
                <Setter Property="Padding" Value="0" />
            </Style>

            <!-- Border Style of Selected State -->
            <Style x:Key="SplitItemBorder_Selected" TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource SplitItem_SelectedColor}" />
                <Setter Property="BorderThickness" Value="1.5" />
            </Style>

            <Style x:Key="CollaborationButtonPressedStyle" TargetType="UXControls:UXButton">
                <Setter Property="BorderBrush" Value="{StaticResource SplitItem_HoverBdColor}" />
            </Style>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <Style x:Key="DotStyle" TargetType="Ellipse">
                <Setter Property="Fill" Value="Blue" />
                <Setter Property="Width" Value="10" />
                <Setter Property="Height" Value="10" />
            </Style>

            <Style x:Key="LineStyle" TargetType="Path">
                <Setter Property="Stroke" Value="Blue" />
                <Setter Property="StrokeThickness" Value="2" />
            </Style>

            <LinearGradientBrush x:Key="GradientBrush" StartPoint="0,0" EndPoint="0,0.4">
                <GradientStop Color="Transparent" Offset="0.5" />
                <GradientStop Color="#0672CB" Offset="0" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="NormalBackground" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#0B1E38" Offset="0.0" />
                <GradientStop Color="#0B1E38" Offset="1.0" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="PressedBackground" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#0672CB" Offset="0.0" />
                <GradientStop Color="#0078D4" Offset="0.46" />
                <GradientStop Color="#6E69CF" Offset="1.1831" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="PressedBorderBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#55B4FD" Offset="0.0045" />
                <GradientStop Color="#6E69CF" Offset="1.0" />
            </LinearGradientBrush>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Border x:Name="MainBorder" Background="#99132F54" CornerRadius="13" Width="520" Height="655" Margin="0,10,0,0">
            <StackPanel x:Name="MainStackPanel" Orientation="Vertical" Margin="16">
                <Grid>
                    <UXControls:UXTextBlock x:Name="DeviceSettingsTextBlock" Style="{StaticResource ModuleCaptionStyle}" Text="{Binding [DeviceSettings], Source={x:Static lang:LangHelper.Instance}}" FontFamily="Roboto" FontSize="20" Foreground="White" Height="28" Width="200" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,20,20,20" />
                </Grid>

                <!-- Busy Light -->
                <Border x:Name="BusyLightOuterBorder" Background="#99132F54" CornerRadius="6" Width="488" Height="auto" VerticalAlignment="Top" Margin="0,0,0,0">
                    <StackPanel x:Name="BusyLightStackPanel" Orientation="Vertical" Margin="0,20,0,10">
                        <Grid x:Name="BusyLightGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <UXControls:UXTextBlock x:Name="BusyLightText" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="16" Foreground="White" Text="{Binding [HeadsetDeviceSettings.0], Source={x:Static lang:LangHelper.Instance}}" Margin="20,8,0,20" />
                            <Image x:Name="BusyLightImage" Grid.Column="1" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,10" Source="/DDPM.UI.Common;component/Resources/info.png" Stretch="Uniform">
                                <Image.ToolTip>
                                    <ToolTip x:Name="BusyLightToolTip" Style="{StaticResource InfoToolTipStyle}" Placement="Top" VerticalOffset="8" HorizontalOffset="6">
                                        <UXControls:UXTextBlock x:Name="BusyLightToolTipText" Style="{StaticResource TabInfoToolTipTextStyle}" Text="{Binding BusyLightToolTip}" />
                                    </ToolTip>
                                </Image.ToolTip>
                            </Image>
                            <UXControls:UXToggleSwitch x:Name="BusyLightToggleSwitch" FontSize="16" Content="{Binding Path=BusyLight_String, FallbackValue='OFF'}" IsChecked="{Binding Path=BusyLightStatus}" IsEnabled="{Binding Path=SupportedBusyLight}" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" VerticalContentAlignment="Center" Foreground="White" Margin="0,0,20,8" />
                        </Grid>
                        <Grid>
                            <!-- Voice Guidance -->
                            <Grid Visibility="{Binding VoiceGuidancePageShow, Converter={StaticResource BooleanToVisibilityConverter}}" x:Name="VoiceGuidanceGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <UXControls:UXTextBlock x:Name="VoiceGuidanceText" Grid.Column="0" Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="16" Foreground="White" Text="{Binding [HeadsetDeviceSettings.1], Source={x:Static lang:LangHelper.Instance}}" Margin="20,20,0,10" />
                                <Image x:Name="VoiceGuidanceImage" Grid.Column="1" Width="16" Height="16" HorizontalAlignment="Left" Source="/DDPM.UI.Common;component/Resources/info.png" Stretch="Uniform" Margin="8,20,0,10">
                                    <Image.ToolTip>
                                        <ToolTip x:Name="VoiceGuidanceToolTip" Style="{StaticResource InfoToolTipStyle}" Placement="Top" VerticalOffset="8" HorizontalOffset="6">
                                            <UXControls:UXTextBlock x:Name="VoiceGuidanceToolTipText" Style="{StaticResource TabInfoToolTipTextStyle}" Text="{Binding VoiceGuidanceToolTip}" />
                                        </ToolTip>
                                    </Image.ToolTip>
                                </Image>

                                <!-- Voice Guidance Buttons -->
                                <StackPanel x:Name="VoiceGuidanceStackPanel" Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,0">
                                    <UXControls:UXToggleSwitch x:Name="EssentialButton" Grid.Row="1" BorderBrush="#FF1E3F6C" BorderThickness="1.5" Width="224" Height="52" Margin="0,8,0,20" Padding="16" Background="{StaticResource SplitItem_NormalBdColor}" IsChecked="{Binding IsEssentialChecked, Mode=TwoWay}">
                                        <UXControls:UXToggleSwitch.Template>
                                            <ControlTemplate TargetType="UXControls:UXToggleSwitch">
                                                <Border x:Name="EssentialButtonBorder" Background="{StaticResource NormalBackground}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4,4,4,4">
                                                    <Grid>
                                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <UXControls:UXTextBlock Text="{Binding [HeadsetDeviceSettings.2], Source={x:Static lang:LangHelper.Instance}}" FontSize="14" Foreground="White" TextAlignment="Center" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="EssentialButtonBorder" Property="Background" Value="{StaticResource PressedBackground}" />
                                                        <Setter TargetName="EssentialButtonBorder" Property="BorderBrush" Value="{StaticResource PressedBorderBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </UXControls:UXToggleSwitch.Template>
                                    </UXControls:UXToggleSwitch>
                                    <UXControls:UXToggleSwitch x:Name="AllButton" BorderBrush="#FF1E3F6C" BorderThickness="1.5" Width="224" Height="52" Margin="8,8,0,20" Padding="16" Background="{StaticResource SplitItem_NormalBdColor}" IsChecked="{Binding IsAllChecked, Mode=TwoWay}">
                                        <UXControls:UXToggleSwitch.Template>
                                            <ControlTemplate TargetType="UXControls:UXToggleSwitch">
                                                <Border x:Name="AllButtonBorder" Background="{StaticResource NormalBackground}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4,4,4,4">
                                                    <Grid>
                                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <UXControls:UXTextBlock Text="{Binding [HeadsetDeviceSettings.3], Source={x:Static lang:LangHelper.Instance}}" FontSize="14" Foreground="White" TextAlignment="Center" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="AllButtonBorder" Property="Background" Value="{StaticResource PressedBackground}" />
                                                        <Setter TargetName="AllButtonBorder" Property="BorderBrush" Value="{StaticResource PressedBorderBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </UXControls:UXToggleSwitch.Template>
                                    </UXControls:UXToggleSwitch>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Download Dell Audio Section -->
                <Grid Visibility="{Binding DeviceSettingsDownloadDellAudioPageShow, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border x:Name="DownDellAudioBoard" Background="#99132F54" CornerRadius="6" Width="488" Height="auto" VerticalAlignment="Top" Margin="0,20,0,20">
                        <StackPanel x:Name="AdditionalSectionStackPanel" Orientation="Vertical" Margin="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Title -->
                                <UXControls:UXTextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{Binding [HeadsetDeviceSettings.4], Source={x:Static lang:LangHelper.Instance}}" FontSize="16" FontWeight="Bold" Foreground="White" Margin="8,20,0,20" />
                                <Image Grid.Row="0" x:Name="DownDellAudioCloseIcon" Source="/DDPM.UI.Common;component/Resources/Close.png" Stretch="Fill" VerticalAlignment="Center" Width="20" Height="20" MouseLeftButtonDown="CloseDescription" Cursor="Hand" Margin="410,20,0,20" />
                                <!-- Icon and Description -->
                                <Image Grid.Row="1" Source="pack://application:,,,/DDPM.UI.Common;component/Resources/Headset_DownDellAudio.png" Width="72" Height="72" HorizontalAlignment="Left" Margin="8,0,0,0" />
                                <TextBlock Grid.Row="1" TextWrapping="Wrap" FontSize="14" Foreground="White" Text="{Binding [HeadsetDeviceSettings.5], Source={x:Static lang:LangHelper.Instance}}" VerticalAlignment="Center" Width="368" HorizontalAlignment="Right" Margin="0,20,0,20" />

                                <UXControls:UXToggleSwitch x:Name="LearnmoreButton" Grid.Row="2" Grid.Column="0" BorderBrush="#FF1E3F6C" BorderThickness="1.5" Width="135" Height="40" Margin="8,8,0,0" HorizontalAlignment="Left" Background="{StaticResource SplitItem_NormalBdColor}" Click="LearnmoreButton_Click">
                                    <UXControls:UXToggleSwitch.Template>
                                        <ControlTemplate TargetType="UXControls:UXToggleSwitch">
                                            <Border x:Name="AllButtonBorder" Background="{StaticResource NormalBackground}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4,4,4,4">
                                                <Grid>
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <UXControls:UXTextBlock Text="{Binding [HeadsetDeviceSettings.6], Source={x:Static lang:LangHelper.Instance}}" FontSize="14" Foreground="White" TextAlignment="Center" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="AllButtonBorder" Property="Background" Value="{StaticResource PressedBackground}" />
                                                    <Setter TargetName="AllButtonBorder" Property="BorderBrush" Value="{StaticResource PressedBorderBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </UXControls:UXToggleSwitch.Template>
                                </UXControls:UXToggleSwitch>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>