<UserControl x:Class="DDPM.UI.Module.WebCameraPresenceDetection.WebCameraPresenceDetectionRightView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             xmlns:plugin="clr-namespace:DDPM.UI.Plugin.ViewModels;assembly=DDPM.UI.Plugin.Common"
             xmlns:PluginCommon="clr-namespace:DDPM.UI.Plugin.Common;assembly=DDPM.UI.Plugin.Common"
             d:DataContext="{d:DesignInstance Type=plugin:WebCameraViewModel}"
             xmlns:common="clr-namespace:DDPM.UI.Common;assembly=DDPM.UI.Common"
             xmlns:lang="clr-namespace:DDPM.UI.Resources.Helper;assembly=DDPM.UI.Resources"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="600" VerticalAlignment="Top" HorizontalAlignment="Left">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/DDPM.UI.Common;component/PluginStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <PluginCommon:HeightConverter x:Key="HeightConverter" />
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid Margin="0,0,0,15">
    <Border Background="#99132F54" CornerRadius="13" Margin="0,10,0,0" Width="470">
      <Border.Height>
        <MultiBinding Converter="{StaticResource HeightConverter}">
          <Binding Path="Height" RelativeSource="{RelativeSource AncestorType=Grid}" />
        </MultiBinding>
      </Border.Height>
      <StackPanel IsEnabled="{Binding IsNotAddingProfile}">
        <Grid Margin="16,16,14,16">
          <Grid>
            <UXControls:UXTextBlock Margin="0,10,0,6" Text="{Binding [WebCameraPresenceDetection.0], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource ModuleCaptionStyle}" />
            <Image Margin="0,0,55,0" Source="/DDPM.UI.Resources;component/Resources/Images/Undo2.png" Stretch="Fill"  
                 HorizontalAlignment="Right" Width="40" Height="40" Visibility="{Binding Undo2Visibility}"/>
            <Image Margin="0,0,5,0" Source="/DDPM.UI.Resources;component/Resources/Images/Redo2.png" Stretch="Fill"  
                 HorizontalAlignment="Right" Width="40" Height="40" Visibility="{Binding Redo2Visibility}"/>
            <Image Margin="0,0,55,0" Source="/DDPM.UI.Resources;component/Resources/Images/Undo.png" Stretch="Fill" MouseLeftButtonDown="Image_MouseLeftButtonDown" Tag="0"
                 HorizontalAlignment="Right" Width="40" Height="40" Visibility="{Binding UndoVisibility}" Cursor="Hand"/>
            <Image Margin="0,0,5,0" Source="/DDPM.UI.Resources;component/Resources/Images/Redo.png" Stretch="Fill" MouseLeftButtonDown="Image_MouseLeftButtonDown" Tag="1"
                 HorizontalAlignment="Right" Width="40" Height="40" Visibility="{Binding RedoVisibility}" Cursor="Hand"/>
          </Grid>
          <Image  Visibility="{Binding LockMaskVisible}" 
                                Source="pack://application:,,,/DDPM.UI.Common;component/Resources/Lock.png"
                                VerticalAlignment="Center" HorizontalAlignment="Left" Margin="85,0,0,0" Width="16" Height="16">
            <Image.ToolTip>
              <ToolTip>
                <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                  <Border.Resources>
                    <Style BasedOn="{StaticResource Tooltip_TextBlockStyle}" TargetType="TextBlock" />
                  </Border.Resources>
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding [ITLockToolTip.0], Source={x:Static lang:LangHelper.Instance}}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </ToolTip>
            </Image.ToolTip>
          </Image>

        </Grid>
        <Grid Margin="16,0,16,10" Visibility="{Binding UPD_Visibility}">
          <Border Background="#99132F54" CornerRadius="6">
            <StackPanel Orientation="Vertical">
              <Grid Margin="18,22,18,0">
                <StackPanel Orientation="Horizontal">
                  <UXControls:UXTextBlock Text="{Binding [WebCameraPresenceDetection.1], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource ModuleItemStyle}" />
                  <Image Margin="9,0,0,0" Source="/DDPM.UI.Common;component/Resources/info.png" Stretch="Uniform" Cursor="Hand" Width="16" Height="16">
                    <Image.ToolTip>
                      <ToolTip Style="{StaticResource InfoToolTipStyle}" Placement="Top" VerticalOffset="8" HorizontalOffset="6">
                        <TextBlock Text="{Binding [WebCameraPresenceDetection.2], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource TabInfoToolTipTextStyle}" />
                      </ToolTip>
                    </Image.ToolTip>
                  </Image>
                </StackPanel>
                <UXControls:UXToggleSwitch IsChecked="{Binding Path= IsChecked_ProximitySensor}" ContentTextVisibility="True" Content="{Binding Path=ProximitySensorStatus_String}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="White" IsTabStop="{Binding isTabStoppable}"/>
              </Grid>
              <Border Background="#132F54" CornerRadius="6" Margin="16">
                <StackPanel Orientation="Vertical">
                  <Grid Margin="18,20,18,0">
                    <StackPanel Orientation="Horizontal">
                      <UXControls:UXTextBlock Text="{Binding [WebCameraPresenceDetection.3], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource ModuleItemStyle}" />
                      <Image Margin="9,0,0,0" Source="/DDPM.UI.Common;component/Resources/info.png" Stretch="Uniform" Cursor="Hand" Width="16" Height="16">
                        <Image.ToolTip>
                          <ToolTip Style="{StaticResource InfoToolTipStyle}" Placement="Top" VerticalOffset="8" HorizontalOffset="6">
                            <TextBlock Text="{Binding [WebCameraPresenceDetection.4], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource TabInfoToolTipTextStyle}" />
                          </ToolTip>
                        </Image.ToolTip>
                      </Image>
                    </StackPanel>
                  <UXControls:UXToggleSwitch IsChecked="{Binding Path= IsChecked_WakeOnApproach}" IsEnabled="{Binding Path= IsChecked_ProximitySensor}" ContentTextVisibility="True" Content="{Binding Path=WakeOnApproachStatus_String}" HorizontalAlignment="Right" VerticalAlignment="Center"  Foreground="White" IsTabStop="{Binding isTabStoppable}" />
                  </Grid>
                  <StackPanel Orientation="Vertical" Margin="18,20,18,0">
                    <Grid>
                      <StackPanel Orientation="Horizontal">
                        <UXControls:UXTextBlock Text="{Binding [WebCameraPresenceDetection.5], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource ModuleItemStyle}" />
                        <Image Margin="9,0,0,0" Source="/DDPM.UI.Common;component/Resources/info.png" Stretch="Uniform" Cursor="Hand" Width="16" Height="16">
                          <Image.ToolTip>
                            <ToolTip Style="{StaticResource InfoToolTipStyle}" Placement="Top" VerticalOffset="8" HorizontalOffset="6">
                              <TextBlock Text="{Binding [WebCameraPresenceDetection.6], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource TabInfoToolTipTextStyle}" />
                            </ToolTip>
                          </Image.ToolTip>
                        </Image>
                      </StackPanel>
                    <UXControls:UXToggleSwitch IsChecked="{Binding Path= IsChecked_WalkAwayLock}" IsEnabled="{Binding Path= IsChecked_ProximitySensor}" ContentTextVisibility="True" Content="{Binding Path=WalkAwayLockStatus_String}" HorizontalAlignment="Right" VerticalAlignment="Center"  Foreground="White" IsTabStop="{Binding isTabStoppable}"/>
                    </Grid>
                  </StackPanel>
                  <StackPanel Orientation="Vertical" Margin="28,20,18,0">
                    <Grid>
                      <UXControls:UXTextBlock Text="{Binding [WebCameraPresenceDetection.7], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource ModuleItemStyle}" VerticalAlignment="Center" />
                      <ComboBox Style="{StaticResource DdpmComboBoxStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"  ItemsSource="{Binding Delay_ItemsCollection}"
                                        SelectedItem="{Binding SelectedDelay, Mode=TwoWay}"
                                        IsEnabled="{Binding Path= IsChecked_WalkAwayLock}"
                                        TabIndex="1" DisplayMemberPath="DisplayText" Width="184" Height="40" IsTabStop="{Binding isTabStoppable}"/>
                    </Grid>
                    <Grid Margin="0,20,0,0">
                      <UXControls:UXTextBlock Text="{Binding [WebCameraPresenceDetection.8], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource ModuleItemStyle}" VerticalAlignment="Center" />
                      <UXControls:UXToggleSwitch IsChecked="{Binding Path= IsChecked_Snooze}" IsEnabled="{Binding Path= IsChecked_WalkAwayLock}" ContentTextVisibility="True" Content="{Binding Path=SnoozeStatus_String}" HorizontalAlignment="Right" VerticalAlignment="Center"  Foreground="White" IsTabStop="{Binding isTabStoppable}"/>
                    </Grid>
                    <Grid Margin="0,20,0,15">
                      <UXControls:UXTextBlock Text="{Binding [WebCameraPresenceDetection.9], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource ModuleItemStyle}" VerticalAlignment="Center" />
                        <ComboBox Style="{StaticResource DdpmComboBoxStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"  ItemsSource="{Binding SnoozeLength_ItemsCollection}"
                                  SelectedItem="{Binding SelectedSnoozeLength, Mode=TwoWay}"
                                  IsEnabled="{Binding Path= IsChecked_WalkAwayLock}"
                                  TabIndex="1" DisplayMemberPath="DisplayText" Width="184" Height="40" IsTabStop="{Binding isTabStoppable}"/>
                    </Grid>
                </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <Border Background="#132F5499" Opacity="0.6"  Visibility="{Binding LockMaskVisible}"/>

        </Grid>
        <Grid VerticalAlignment="top" Margin="16,0,16,10" Visibility="{Binding UPD_Visibility}">
          <Border Background="#99132F54" CornerRadius="6" Margin="0,0,0,4000">
            <Grid Margin="18,22,18,18">
              <StackPanel Orientation="Horizontal">
                <UXControls:UXTextBlock Text="{Binding [WebCameraPresenceDetection.10], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource ModuleItemStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Image Margin="9,0,9,0" Source="/DDPM.UI.Common;component/Resources/info.png" Stretch="Uniform" Cursor="Hand" Width="16" Height="16">
                  <Image.ToolTip>
                    <ToolTip Style="{StaticResource InfoToolTipStyle}" Placement="Top" VerticalOffset="8" HorizontalOffset="6">
                      <TextBlock Text="{Binding [WebCameraPresenceDetection.11], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource TabInfoToolTipTextStyle}" />
                    </ToolTip>
                  </Image.ToolTip>
                </Image>
              </StackPanel>
              <UXControls:UXLink Content="{Binding [WindowsSettings], Source={x:Static lang:LangHelper.Instance}}" Click="CallWindowsHello_Click" IconPosition="IconRight" LinkSize="Medium" LinkColorScheme="Primary" LinkType="InLine" Icon="M29.86 29.86h-27.74v-27.72h13.88v-2.14h-16v32h32v-16h-2.12zM20.86 0v2.12h7.56l-15.060 15.060 1.52 1.5 14.98-15v7.46h2.14v-11.14z" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
          </Border>
        </Grid>
        
        <!-- MPS(1) -->
        <Grid Margin="16,0,16,10" Visibility="{Binding MPS_Setting_Visibility}">
                    <UXControls:UXTextBlock Text="To access Microsoft Presence Sensing features, visit Windows Settings" TextWrapping="WrapWithOverflow" Style="{StaticResource ModuleItemStyle}" TextBlock.FontSize="16" />            
        </Grid>  
          
        <Grid VerticalAlignment="top" Margin="16,0,16,10" Visibility="{Binding MPS_Setting_Visibility}">
          <Border Background="#99132F54" CornerRadius="6" Margin="0,0,0,4000">
            <Grid Margin="18,22,18,18">
              <StackPanel Orientation="Horizontal">
                <UXControls:UXTextBlock Text="Presence Detection" Style="{StaticResource ModuleItemStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" />                
              </StackPanel>
                <UXControls:UXLink Content="{Binding [WindowsSettings], Source={x:Static lang:LangHelper.Instance}}" Click="CallPresenceSensor_Click" IconPosition="IconRight" LinkSize="Medium" LinkColorScheme="Primary" LinkType="InLine" Icon="M29.86 29.86h-27.74v-27.72h13.88v-2.14h-16v32h32v-16h-2.12zM20.86 0v2.12h7.56l-15.060 15.060 1.52 1.5 14.98-15v7.46h2.14v-11.14z" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
          </Border>
        </Grid>
          
        <!-- MPS(2) -->
        <Grid Margin="16,0,16,10" Visibility="{Binding MPS_UpdateFW_Visibility}">              
              <UXControls:UXAlert Margin="0,0,0,0">
                  <UXControls:UXAlertItem AlertItemType="Info" Margin="8,8,8,8" Label=""
                      Message="To access presence sensing features, use the link below to download compitible webcam firmware" />
              </UXControls:UXAlert>             
        </Grid>  
          
        <Grid VerticalAlignment="top" Margin="16,0,16,10" Visibility="{Binding MPS_UpdateFW_Visibility}">
            <Border Background="#99132F54" CornerRadius="6" Margin="0,0,0,4000">
              <Grid Margin="18,22,18,18">
                <StackPanel Orientation="Horizontal">
                  <UXControls:UXTextBlock Text="Compatible Firmware" Style="{StaticResource ModuleItemStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" />                
                </StackPanel>
                  <UXControls:UXLink Content="Dell.com" Click="CallUpcdateMPSFW_Click" IconPosition="IconRight" LinkSize="Medium" LinkColorScheme="Primary" LinkType="InLine" Icon="M29.86 29.86h-27.74v-27.72h13.88v-2.14h-16v32h32v-16h-2.12zM20.86 0v2.12h7.56l-15.060 15.060 1.52 1.5 14.98-15v7.46h2.14v-11.14z" HorizontalAlignment="Right" VerticalAlignment="Center" />
              </Grid>
            </Border>
        </Grid>
          
      </StackPanel>
    </Border>
  </Grid>
</UserControl>