<UserControl x:Class="DDPM.UI.Module.WebCameraPresenceDetection.WebCameraPresenceDetectionRightView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             xmlns:plugin="clr-namespace:DDPM.UI.Plugin.ViewModels;assembly=DDPM.UI.Plugin.Common"
             xmlns:PluginCommon="clr-namespace:DDPM.UI.Plugin.Common;assembly=DDPM.UI.Plugin.Common"
             d:DataContext="{d:DesignInstance Type=plugin:WebCameraViewModel}"
             xmlns:common="clr-namespace:DDPM.UI.Common;assembly=DDPM.UI.Common"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="600" VerticalAlignment="Top" HorizontalAlignment="Left">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DDPM.UI.Common;component/PluginStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <PluginCommon:HeightConverter x:Key="HeightConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <UXControls:UXScrollViewer>
            <Border Background="#99132F54" CornerRadius="13" Margin="0,10,0,0" Width="470">
                <Border.Height>
                    <MultiBinding Converter="{StaticResource HeightConverter}">
                        <Binding Path="Height" RelativeSource="{RelativeSource AncestorType=Grid}" />
                    </MultiBinding>
                </Border.Height>
                <StackPanel>
                    <Grid Margin="14,16,14,16">
                        <UXControls:UXTextBlock Text="Presence Detection" Margin="0,6,0,6" Style="{StaticResource ModuleCaptionStyle}" />
                    </Grid>
                    <Grid Margin="16,0,16,10">
                        <Border Background="#99132F54" CornerRadius="6">
                            <StackPanel Orientation="Vertical">
                                <Grid Margin="18,22,18,0">
                                    <StackPanel Orientation="Horizontal">
                                        <UXControls:UXTextBlock Text="Proximity Sensor" Style="{StaticResource ModuleItemStyle}" />
                                        <Image Margin="9,0,0,0" Source="/DDPM.UI.Common;component/Resources/info.png" Stretch="Uniform" Cursor="Hand" Width="16" Height="16">
                                            <Image.ToolTip>
                                                <ToolTip Style="{StaticResource InfoToolTipStyle}" Placement="Top" VerticalOffset="8" HorizontalOffset="6">
                                                    <TextBlock Text="Detects your presence when you are in the field of view" Style="{StaticResource TabInfoToolTipTextStyle}" />
                                                </ToolTip>
                                            </Image.ToolTip>
                                        </Image>
                                    </StackPanel>
                                    <UXControls:UXToggleSwitch IsChecked="{Binding Path= IsChecked_ProximitySensor}" ContentTextVisibility="True" Content="{Binding Path=ProximitySensorStatus_String}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="White" />
                                </Grid>
                                <Border Background="#132F54" CornerRadius="6" Margin="16">
                                    <StackPanel Orientation="Vertical">
                                        <Grid Margin="18,20,18,0">
                                            <StackPanel Orientation="Horizontal">
                                                <UXControls:UXTextBlock Text="Wake on Approach" Style="{StaticResource ModuleItemStyle}" />
                                                <Image Margin="9,0,0,0" Source="/DDPM.UI.Common;component/Resources/info.png" Stretch="Uniform" Cursor="Hand" Width="16" Height="16">
                                                    <Image.ToolTip>
                                                        <ToolTip Style="{StaticResource InfoToolTipStyle}" Placement="Top" VerticalOffset="8" HorizontalOffset="6">
                                                            <TextBlock Text="Wakes up the PC as you approach" Style="{StaticResource TabInfoToolTipTextStyle}" />
                                                        </ToolTip>
                                                    </Image.ToolTip>
                                                </Image>
                                            </StackPanel>
                                            <UXControls:UXToggleSwitch IsChecked="{Binding Path= IsChecked_WakeOnApproach}" ContentTextVisibility="True" Content="{Binding Path=WakeOnApproachStatus_String}" HorizontalAlignment="Right" VerticalAlignment="Center"  Foreground="White" />
                                        </Grid>
                                        <StackPanel Orientation="Vertical" Margin="18,20,18,0">
                                            <Grid>
                                                <StackPanel Orientation="Horizontal">
                                                    <UXControls:UXTextBlock Text="Walk Away Lock" Style="{StaticResource ModuleItemStyle}" />
                                                    <Image Margin="9,0,0,0" Source="/DDPM.UI.Common;component/Resources/info.png" Stretch="Uniform" Cursor="Hand" Width="16" Height="16">
                                                        <Image.ToolTip>
                                                            <ToolTip Style="{StaticResource InfoToolTipStyle}" Placement="Top" VerticalOffset="8" HorizontalOffset="6">
                                                                <TextBlock Text="Locks the PC and turns off the display when you walk away" Style="{StaticResource TabInfoToolTipTextStyle}" />
                                                            </ToolTip>
                                                        </Image.ToolTip>
                                                    </Image>
                                                </StackPanel>
                                                <UXControls:UXToggleSwitch IsChecked="{Binding Path= IsChecked_WalkAwayLock}" ContentTextVisibility="True" Content="{Binding Path=WalkAwayLockStatus_String}" HorizontalAlignment="Right" VerticalAlignment="Center"  Foreground="White" />
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Orientation="Vertical" Margin="28,20,18,0">
                                            <Grid>
                                                <UXControls:UXTextBlock Text="Delay" Style="{StaticResource ModuleItemStyle}" VerticalAlignment="Center" />
                                                <ComboBox Style="{StaticResource DdpmComboBoxStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"  ItemsSource="{Binding Delay_ItemsCollection}"
                                                          SelectedItem="{Binding SelectedDelay, Mode=TwoWay}"
                                                          TabIndex="1" DisplayMemberPath="DisplayText" Width="184" Height="40" />
                                            </Grid>
                                            <Grid Margin="0,20,0,0">
                                                <UXControls:UXTextBlock Text="Snooze" Style="{StaticResource ModuleItemStyle}" VerticalAlignment="Center" />
                                                <UXControls:UXToggleSwitch IsChecked="{Binding Path= IsChecked_Snooze}" ContentTextVisibility="True" Content="{Binding Path=SnoozeStatus_String}" HorizontalAlignment="Right" VerticalAlignment="Center"  Foreground="White" />
                                            </Grid>
                                            <Grid Margin="0,20,0,15">
                                                <UXControls:UXTextBlock Text="Snooze Length" Style="{StaticResource ModuleItemStyle}" VerticalAlignment="Center" />
                                                <ComboBox Style="{StaticResource DdpmComboBoxStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"  ItemsSource="{Binding SnoozeLength_ItemsCollection}"
                                                          SelectedItem="{Binding SelectedSnoozeLength, Mode=TwoWay}"
                                                          TabIndex="1" DisplayMemberPath="DisplayText" Width="184" Height="40" />
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid VerticalAlignment="top" Margin="16,0,16,10">
                        <Border Background="#99132F54" CornerRadius="6">
                            <Grid Margin="18,22,18,18">
                                <StackPanel Orientation="Horizontal">
                                    <UXControls:UXTextBlock Text="Windows Hello" Style="{StaticResource ModuleItemStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image Margin="9,0,9,0" Source="/DDPM.UI.Common;component/Resources/info.png" Stretch="Uniform" Cursor="Hand" Width="16" Height="16">
                                        <Image.ToolTip>
                                            <ToolTip Style="{StaticResource InfoToolTipStyle}" Placement="Top" VerticalOffset="8" HorizontalOffset="6">
                                                <TextBlock Text="Signs you in with facial recognition. This link will direct you to Windows Settings." Style="{StaticResource TabInfoToolTipTextStyle}" />
                                            </ToolTip>
                                        </Image.ToolTip>
                                    </Image>
                                </StackPanel>
                                <UXControls:UXLink Content="Windows Settings" Click="CallWindowsHello_Click" IconPosition="IconRight" LinkSize="Medium" LinkColorScheme="Primary" LinkType="InLine" Icon="M29.86 29.86h-27.74v-27.72h13.88v-2.14h-16v32h32v-16h-2.12zM20.86 0v2.12h7.56l-15.060 15.060 1.52 1.5 14.98-15v7.46h2.14v-11.14z" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </UXControls:UXScrollViewer>
    </Grid>
</UserControl>