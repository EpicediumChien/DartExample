<UserControl x:Class="DDPM.UI.Module.SpeakerInteractions.SpeakerInteractionsRightView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             xmlns:plugin="clr-namespace:DDPM.UI.Plugin.ViewModels;assembly=DDPM.UI.Plugin.Common"
             xmlns:PluginCommon="clr-namespace:DDPM.UI.Plugin.Common;assembly=DDPM.UI.Plugin.Common"
             d:DataContext="{d:DesignInstance Type=plugin:SoundBarViewModel}"
             xmlns:common="clr-namespace:DDPM.UI.Common;assembly=DDPM.UI.Common"
             xmlns:lang="clr-namespace:DDPM.UI.Resources.Helper;assembly=DDPM.UI.Resources"
             mc:Ignorable="d"
             d:DesignHeight="655" d:DesignWidth="470">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DDPM.UI.Common;component/PluginStyles.xaml" />
                <!-- <ResourceDictionary Source="/DDPM.UI.Common;component/ModuleStyle.xaml" /> -->
            </ResourceDictionary.MergedDictionaries>

            <ImageBrush x:Key="UnselectedNodeImage" ImageSource="pack://application:,,,/DDPM.UI.Common;component/Resources/Headset_Dot.png" />
            <ImageBrush x:Key="SelectedNodeImage" ImageSource="pack://application:,,,/DDPM.UI.Common;component/Resources/Headset_whitedot.png" />

            <SolidColorBrush x:Key="SplitItem_BkColor" Color="#FF132F54" />
            <SolidColorBrush x:Key="SplitItem_NormalBdColor" Color="#FF0B1E38" />
            <SolidColorBrush x:Key="SplitItem_SelectedColor" Color="#FF5CC1EE" />

            <LinearGradientBrush x:Key="SplitItem_HoverBdColor" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#FF0672CB" />
                <GradientStop Offset="0.5" Color="#FF0078D4" />
                <GradientStop Offset="1" Color="#FF6E69CF" />
            </LinearGradientBrush>

            <!-- Border Style of Normal State -->
            <Style x:Key="SplitItemBorder_Normal" TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource SplitItem_NormalBdColor}" />
                <Setter Property="BorderThickness" Value="4" />
                <Setter Property="Padding" Value="0" />
            </Style>

            <!-- Border Style of Hover State -->
            <Style x:Key="SplitItemBorder_Hover" TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource SplitItem_HoverBdColor}" />
                <Setter Property="BorderThickness" Value="4" />
                <Setter Property="Padding" Value="0" />
            </Style>

            <!-- Border Style of Selected State -->
            <Style x:Key="SplitItemBorder_Selected" TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource SplitItem_SelectedColor}" />
                <Setter Property="BorderThickness" Value="1.5" />
            </Style>

            <Style x:Key="CollaborationButtonPressedStyle" TargetType="UXControls:UXButton">
                <Setter Property="BorderBrush" Value="{StaticResource SplitItem_HoverBdColor}" />
            </Style>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <Style x:Key="DotStyle" TargetType="Ellipse">
                <Setter Property="Fill" Value="Blue" />
                <Setter Property="Width" Value="10" />
                <Setter Property="Height" Value="10" />
            </Style>

            <Style x:Key="LineStyle" TargetType="Path">
                <Setter Property="Stroke" Value="Blue" />
                <Setter Property="StrokeThickness" Value="2" />
            </Style>

            <LinearGradientBrush x:Key="GradientBrush" StartPoint="0,0" EndPoint="0,0.4">
                <GradientStop Color="Transparent" Offset="0.5" />
                <GradientStop Color="#0672CB" Offset="0" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="NormalBackground" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#0B1E38" Offset="0.0" />
                <GradientStop Color="#0B1E38" Offset="1.0" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="PressedBackground" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#0672CB" Offset="0.0" />
                <GradientStop Color="#0078D4" Offset="0.46" />
                <GradientStop Color="#6E69CF" Offset="1.1831" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="PressedBorderBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#55B4FD" Offset="0.0045" />
                <GradientStop Color="#6E69CF" Offset="1.0" />
            </LinearGradientBrush>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Width="470" Margin="0,0,0,20">
        <!--Elsa 20250325 for PIMS-348388 change Margin="0,10,0,20" to Margin="-13,10,0,20"-->
        <Border CornerRadius="13" Width="470" Margin="-13,10,0,20">
            <StackPanel Orientation="Vertical" Margin="16">

                <Grid VerticalAlignment="Top" Margin="0,0,0,15">
                    <Border CornerRadius="6" Width="470" Height="auto" VerticalAlignment="Top">
                        <StackPanel Orientation="Vertical">
                            <Grid  VerticalAlignment="Top" Margin="20,0,0,0">
                                <UXControls:UXTextBlock x:Name="InteractionsTextBlock" Text="{Binding [SpeakerInteractions.0], Source={x:Static lang:LangHelper.Instance}}" FontFamily="Roboto" FontSize="20" Height="28" Width="200" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,20,20,20" />
                            </Grid>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel x:Name="ParentStackPanel">
                                    <UXControls:UXTextBlock  Text="{Binding [SpeakerInteractions.1], Source={x:Static lang:LangHelper.Instance}}" 
                                                             TextWrapping="WrapWithOverflow"  FontSize="14" Margin="15,0,10,20" 
                                                             x:Name="tbInteraction" Width="410" HorizontalAlignment="Left"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1">
                                    <UXControls:UXToggleSwitch x:Name="MicrosoftTeamsButton"  BorderThickness="1.5" Width="406" Height="56" Margin="16,0,4,8" Background="{StaticResource SplitItem_NormalBdColor}" IsChecked="{Binding IsMicrosoftTeamsChecked, Mode=TwoWay}" MouseMove="MicrosoftTeamsButton_MouseMove" MouseLeave="MicrosoftTeamsButton_MouseLeave">
                                        <UXControls:UXToggleSwitch.Template>
                                            <ControlTemplate TargetType="UXControls:UXToggleSwitch">
                                                <Border x:Name="MicrosoftTeamsBorder" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4,4,4,4">
                                                    <Grid>
                                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <UXControls:UXTextBlock x:Name="MicrosoftTeamsBorderTxt" Text="{Binding [SpeakerInteractions.2], Source={x:Static lang:LangHelper.Instance}}" FontSize="14" TextAlignment="Center" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <!--<Setter TargetName="MicrosoftTeamsBorder" Property="Background" Value="{StaticResource PressedBackground}" />
                                                        <Setter TargetName="MicrosoftTeamsBorder" Property="BorderBrush" Value="{StaticResource PressedBorderBrush}" />-->
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="MicrosoftTeamsBorder" Property="Background" Value="{StaticResource PressedBackground}" />
                                                        <Setter TargetName="MicrosoftTeamsBorder" Property="BorderBrush" Value="{StaticResource SplitItem_HoverBdColor}" />
                                                        <Setter TargetName="MicrosoftTeamsBorderTxt" Property="Foreground" Value="White" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </UXControls:UXToggleSwitch.Template>
                                    </UXControls:UXToggleSwitch>
                                </StackPanel>

                                <StackPanel Grid.Row="2">
                                    <UXControls:UXToggleSwitch x:Name="ZoomButton" BorderThickness="1.5" Width="406" Height="56" Margin="16,0,0,8" Background="{StaticResource SplitItem_NormalBdColor}" IsChecked="{Binding IsZoomChecked, Mode=TwoWay}" MouseMove="ZoomButton_MouseMove" MouseLeave="MicrosoftTeamsButton_MouseLeave">
                                        <UXControls:UXToggleSwitch.Template>
                                            <ControlTemplate TargetType="UXControls:UXToggleSwitch">
                                                <Border x:Name="ZoomButtonBorder"  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4,4,4,4">
                                                    <Grid>
                                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <UXControls:UXTextBlock x:Name="ZoomButtonBorderTxt" Text="Zoom" FontSize="14" TextAlignment="Center" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <!--<Setter TargetName="ZoomButtonBorder" Property="Background" Value="{StaticResource PressedBackground}" />
                                                        <Setter TargetName="ZoomButtonBorder" Property="BorderBrush" Value="{StaticResource PressedBorderBrush}" />-->
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ZoomButtonBorder" Property="Background" Value="{StaticResource PressedBackground}" />
                                                        <Setter TargetName="ZoomButtonBorder" Property="BorderBrush" Value="{StaticResource SplitItem_HoverBdColor}" />
                                                        <Setter TargetName="ZoomButtonBorderTxt" Property="Foreground" Value="White" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </UXControls:UXToggleSwitch.Template>
                                    </UXControls:UXToggleSwitch>
                                </StackPanel>

                                <StackPanel Grid.Row="3">
                                    <UXControls:UXToggleSwitch x:Name="GoogleMeetButton" Visibility="{Binding ControlGoogleMeetButtonShow, Converter={StaticResource BooleanToVisibilityConverter}}" BorderThickness="1.5" Width="406" Height="56" Margin="16,0,4,8" Background="{StaticResource SplitItem_NormalBdColor}" IsChecked="{Binding IsGoogleMeetChecked, Mode=TwoWay}" MouseMove="GoogleMeetButton_MouseMove" MouseLeave="MicrosoftTeamsButton_MouseLeave">
                                        <UXControls:UXToggleSwitch.Template>
                                            <ControlTemplate TargetType="UXControls:UXToggleSwitch">
                                                <Border x:Name="GoogleMeetButtonBorder" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4,4,4,4">
                                                    <Grid>
                                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <UXControls:UXTextBlock x:Name="GoogleMeetButtonBorderTxt" Text="{Binding [SpeakerInteractions.4], Source={x:Static lang:LangHelper.Instance}}" FontSize="14" TextAlignment="Center" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <!--<Setter TargetName="GoogleMeetButtonBorder" Property="Background" Value="{StaticResource PressedBackground}" />
                                                        <Setter TargetName="GoogleMeetButtonBorder" Property="BorderBrush" Value="{StaticResource PressedBorderBrush}" />-->
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="GoogleMeetButtonBorder" Property="Background" Value="{StaticResource PressedBackground}" />
                                                        <Setter TargetName="GoogleMeetButtonBorder" Property="BorderBrush" Value="{StaticResource SplitItem_HoverBdColor}" />
                                                        <Setter TargetName="GoogleMeetButtonBorderTxt" Property="Foreground" Value="White" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </UXControls:UXToggleSwitch.Template>
                                    </UXControls:UXToggleSwitch>
                                </StackPanel>

                                <!--<StackPanel Grid.Row="4">
                                    <UXControls:UXToggleSwitch x:Name="SkypeforBusinessButton" Visibility="{Binding ControlSkypeforBusinessButtonShow, Converter={StaticResource BooleanToVisibilityConverter}}" BorderBrush="#FF1B385F" BorderThickness="1.5" Width="406" Height="56" Margin="16,0,0,20" Background="{StaticResource SplitItem_NormalBdColor}" IsChecked="{Binding IsSkypeForBusinessChecked, Mode=TwoWay}" MouseMove="SkypeforBusinessButton_MouseMove">
                                        <UXControls:UXToggleSwitch.Template>
                                            <ControlTemplate TargetType="UXControls:UXToggleSwitch">
                                                <Border x:Name="SkypeforBusinessBorder" Background="{StaticResource NormalBackground}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4,4,4,4">
                                                    <Grid>
                                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <UXControls:UXTextBlock Text="{Binding [SpeakerInteractions.5], Source={x:Static lang:LangHelper.Instance}}" FontSize="14" Foreground="White" TextAlignment="Center" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    --><!--<Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="SkypeforBusinessBorder" Property="Background" Value="{StaticResource PressedBackground}" />
                                                    <Setter TargetName="SkypeforBusinessBorder" Property="BorderBrush" Value="{StaticResource PressedBorderBrush}" />
                                                    </Trigger>--><!--
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="SkypeforBusinessBorder" Property="Background" Value="{StaticResource PressedBackground}" />
                                                        <Setter TargetName="SkypeforBusinessBorder" Property="BorderBrush" Value="{StaticResource SplitItem_HoverBdColor}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </UXControls:UXToggleSwitch.Template>
                                    </UXControls:UXToggleSwitch>
                                </StackPanel>-->
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>