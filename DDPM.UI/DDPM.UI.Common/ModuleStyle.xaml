    <!-- Global font key to support roboto -->
    <!-- For Roboto Bold, please use FontWeight as Bold with "RobotoFont" -->
    <FontFamily x:Key="RobotoFont">
        pack://application:,,,/DDPM.UI.Resources;component/Resources/Fonts/#Roboto
    </FontFamily>
    <FontFamily x:Key="RobotoFontMedium">
        pack://application:,,,/DDPM.UI.Resources;component/Resources/Fonts/#Roboto Medium
    </FontFamily>

    <!-- #region Control Element Default Styles-->
    <!-- Common -->
    <LinearGradientBrush x:Key="DDPMBackground" ColorInterpolationMode="SRgbLinearInterpolation" EndPoint="1,1" MappingMode="RelativeToBoundingBox" 
                         SpreadMethod="Pad" StartPoint="0,0" Opacity="0.15">
        <LinearGradientBrush.RelativeTransform>
            <MatrixTransform Matrix="Identity" />
        </LinearGradientBrush.RelativeTransform>
        <LinearGradientBrush.Transform>
            <MatrixTransform Matrix="Identity" />
        </LinearGradientBrush.Transform>
        <GradientStop Color="#7F306CC7" Offset="0.0537" />
        <GradientStop Color="#7F0063B8" Offset="0.237" />
        <GradientStop Color="#E0003ACE" Offset="0.504" />
        <GradientStop Color="#7F674AB8" Offset="0.7923" />
        <GradientStop Color="#7F0063B8" Offset="0.9724" />
    </LinearGradientBrush>
    <!-- #region FakeTransparent: When you need a transparent color and need can response mouse click -->
    <Color x:Key="Color_FakeTransparent">#01FFFFFF</Color>
    <SolidColorBrush x:Key="FakeTransparent" Color="{StaticResource Color_FakeTransparent}" />
    <SolidColorBrush x:Key="Transparent" Color="{StaticResource Color_FakeTransparent}" />
