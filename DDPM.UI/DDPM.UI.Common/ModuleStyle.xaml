    <SolidColorBrush x:Key="PrimaryButton.Static.Border" Color="{StaticResource PrimaryButton.DefaultBkColor}"/>

    <SolidColorBrush x:Key="PrimaryButton.MouseOver.Background" Color="{StaticResource PrimaryButton.HoverBkColor}"/>
    <SolidColorBrush x:Key="PrimaryButton.MouseOver.Border" Color="{StaticResource PrimaryButton.HoverBkColor}"/>

    <SolidColorBrush x:Key="PrimaryButton.Pressed.Background" Color="{StaticResource PrimaryButton.PressedBkColor}"/>
    <SolidColorBrush x:Key="PrimaryButton.Pressed.Border" Color="{StaticResource PrimaryButton.PressedBkColor}"/>

