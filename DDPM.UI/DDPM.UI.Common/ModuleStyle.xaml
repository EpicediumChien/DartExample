    <!-- #region StatelessButton -->
    <!-- A custom style button which all of visual states are removed 
    The basic usage of this style is the Back Arraow (LeftArrow image/path icon) control
    For an Image it can be clicked with MouseLeftButtonDown with Image control.
    However it not clickable with keyboard ([Enter] key when in Narrator mode. we need make the
    Image as the conent of a Button control to support Narrator.
    -->
    <Style x:Key="StatelessButton" TargetType="Button">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup/>
                        </VisualStateManager.VisualStateGroups>

                        <ContentPresenter/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

