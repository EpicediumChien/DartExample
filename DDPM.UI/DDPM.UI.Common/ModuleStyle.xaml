    <!-- #region General Control Colors
    There are many buttons,headers use this brush as their background color in hover state.
    When you see the colors in Figma are:
    #0672CB    100%
    #0078D4    100%
    #6E69CF    100%
    Then you can use this color
    -->
    <LinearGradientBrush x:Key="Brush_GradientButtonCyan" StartPoint="0.5,1" EndPoint="0.5,0"
                         MappingMode="RelativeToBoundingBox">
        <LinearGradientBrush.RelativeTransform>
            <TransformGroup>
                <RotateTransform CenterX="0.5" CenterY="0.5" Angle="100" />
            </TransformGroup>
        </LinearGradientBrush.RelativeTransform>
        <LinearGradientBrush.GradientStops>
            <GradientStopCollection>
                <GradientStop Color="#FF0672CB" Offset="0" />
                <GradientStop Color="#FF0078D4" Offset="0.46" />
                <GradientStop Color="#FF6E69CF" Offset="1.1831" />
            </GradientStopCollection>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <!-- Linear Gradient Border Brush
    When you see the colors in Figma are:
    #55B4FD     100%
    #6E69CF     100%
    -->
    <LinearGradientBrush x:Key="Brush_GradientBorderCyan"
                         StartPoint="0.002248,0.0194" EndPoint="1.30867,0.254939">
