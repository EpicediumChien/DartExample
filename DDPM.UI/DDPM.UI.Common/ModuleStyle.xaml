<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Add reference to this ResourceDictionary
    Add below to your xaml file, For example, in your UserControl xaml:
    <UserControl.Resources>
    <ResourceDictionary>
    <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/DDPM.UI.Common;component/ModuleStyle.xaml" />
    </ResourceDictionary.MergedDictionaries>

    . . . your other resources...
    </ResourceDictionary>
    </UserControl.Resources>

    -->

    <!-- Common -->
    <!-- FakeTransparent: When you need a transparent color and need can response mouse click -->
    <Color x:Key="Color_FakeTransparent">#02000000</Color>
    <SolidColorBrush x:Key="FakeTransparent" Color="{StaticResource Color_FakeTransparent}" />

    <!--  Tooltip  -->
    <!-- Tooltip example

    <ToolTip>
    <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
    <Border.Resources>
    <Style TargetType="TextBlock" BasedOn="{StaticResource Tooltip_TextBlockStyle}" />
    </Border.Resources>

    <StackPanel>
    <StackPanel Orientation="Horizontal">
    <TextBlock Text="Firmware Version " />
    <TextBlock Text="{Binding SelectedHomeDevice.FwVer}" />
    </StackPanel>
    <StackPanel Orientation="Horizontal">
    <TextBlock Text="Service Tag " />
    <TextBlock Text="{Binding SelectedHomeDevice.ServiceTag}" />
    </StackPanel>
    </StackPanel>
    </Border>
    </ToolTip>

    -->
    <SolidColorBrush x:Key="Tooltip_BkColor" Color="#FF1D2C3B" />
    <SolidColorBrush x:Key="Tooltip_BdColor" Color="#FF293B4D" />
    <SolidColorBrush x:Key="Tooltip_TextColor" Color="#FFF5F6F7" />
    <sys:Double x:Key="Tooltip_FontSize">12</sys:Double>
    <Thickness x:Key="Tooltip_BdThick">1</Thickness>
    <CornerRadius x:Key="Tooltip_Radius">4</CornerRadius>
    <!-- Robert_Lin, 2024-6-24, Alex MC Yen reports that the padding top/bottom is too large
    Change the Padding from "12,16" to "12,8" -->
    <Thickness x:Key="Tooltip_Padding">12,8</Thickness>

    <Style x:Key="Tooltip_OutterBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Tooltip_BkColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource Tooltip_BdColor}" />
        <Setter Property="BorderThickness" Value="{StaticResource Tooltip_BdThick}" />
        <Setter Property="CornerRadius" Value="{StaticResource Tooltip_Radius}" />
        <Setter Property="Padding" Value="{StaticResource Tooltip_Padding}" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="8" Color="#2D000000" Opacity="0.4"
                                  Direction="315" ShadowDepth="3" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Tooltip_TextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Roboto"/>
        <Setter Property="Foreground" Value="{StaticResource Tooltip_TextColor}" />
        <Setter Property="FontSize" Value="{StaticResource Tooltip_FontSize}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="LineHeight" Value="20"/>
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--  ExpanderHeader  -->
    <sys:Double x:Key="ExpanderHeader_FontSize">20</sys:Double>
    <SolidColorBrush x:Key="ExpanderHeader_TextColor" Color="White" />

    <!-- RightView.Content Container Background Color

    <SolidColorBrush x:Key="RightViewContainerBkColor" Color="#9C193457" />
    -->
    <SolidColorBrush x:Key="RightViewContainerBkColor" Color="#9C193457" />
    <SolidColorBrush x:Key="GroupExpanderHeaderBottomLineColor" Color="#FF1E3F6C" />
    <SolidColorBrush x:Key="RightGroupBkColor" Color="#99193457" />
    <SolidColorBrush x:Key="RightPartBkColor" Color="#99193457" />
    <SolidColorBrush x:Key="RightPartBdColor" Color="#FF1B385F" />

    <SolidColorBrush x:Key="PercentageTextColor" Color="#FFA4B8CD" />

    <Style x:Key="RightGroupBorderStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16,16,16,0" />
        <Setter Property="Background" Value="{StaticResource RightGroupBkColor}" />
    </Style>

    <Style x:Key="RightPartBorderStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Background" Value="{StaticResource RightPartBkColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource RightPartBdColor}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>

    <!--
    Expander template for Group header
    Reference: https://learn.microsoft.com/en-us/dotnet/desktop/wpf/controls/expander-styles-and-templates?view=netframeworkdesktop-4.8&viewFallbackFrom=netdesktop-8.0
    -->
    <Style x:Key="ExpanderHeaderFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border>
                        <Rectangle
                            Margin="0"
                            SnapsToDevicePixels="true"
                            Stroke="Black"
                            StrokeDashArray="1 2"
                            StrokeThickness="1" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RightExpanderToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        BorderBrush="{StaticResource GroupExpanderHeaderBottomLineColor}"
                        BorderThickness="0,0,0,1">
                        <Grid Background="Transparent" SnapsToDevicePixels="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <UXControls:UXRadioButton
                                Name="SwManual"
                                Grid.Column="0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                IsChecked="{Binding IsChecked, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />

                            <ContentPresenter
                                Grid.Column="0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True"
                                SnapsToDevicePixels="True" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="RightExpanderTemp" TargetType="Expander">
        <Border
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            SnapsToDevicePixels="true">
            <DockPanel>
                <ToggleButton
                    x:Name="HeaderSite"
                    MinWidth="0"
                    MinHeight="0"
                    Margin="1"
                    Padding="{TemplateBinding Padding}"
                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                    Content="{TemplateBinding Header}"
                    ContentTemplate="{TemplateBinding HeaderTemplate}"
                    ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}"
                    DockPanel.Dock="Top"
                    FocusVisualStyle="{StaticResource ExpanderHeaderFocusVisual}"
                    FontFamily="{TemplateBinding FontFamily}"
                    FontSize="{TemplateBinding FontSize}"
                    FontStretch="{TemplateBinding FontStretch}"
                    FontStyle="{TemplateBinding FontStyle}"
                    FontWeight="{TemplateBinding FontWeight}"
                    Foreground="{TemplateBinding Foreground}"
                    IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                    Style="{StaticResource RightExpanderToggleButtonStyle}" />

                <ContentPresenter
                    x:Name="ExpandSite"
                    Margin="{TemplateBinding Padding}"
                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    DockPanel.Dock="Bottom"
                    Focusable="false"
                    Visibility="Collapsed" />
            </DockPanel>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="true">
                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="RightExpanderStyle" TargetType="Expander">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Template" Value="{StaticResource RightExpanderTemp}" />
    </Style>

    <!--
    UXComboBox
    <UXControls:UXComboBox  Background="{StaticResource UXComboBoxBackground}"
    BorderBrush="{StaticResource UXComboBoxBorderBrush}"
    BorderThickness="{StaticResource UXComboBoxBorderThickness}"
    Foreground="{StaticResource UXComboBoxForeground}"
    . . .
    -->
    <SolidColorBrush x:Key="UXComboBox_Background" Color="#FF293B4D" />
    <SolidColorBrush x:Key="UXComboBox_BorderBrush" Color="#FF40586D" />
    <SolidColorBrush x:Key="UXComboBox_Foreground" Color="#FFF5F6F7" />
    <Thickness
        x:Key="UXComboBox_BorderThickness"
        Bottom="1"
        Left="1"
        Right="1"
        Top="1" />

    <!--  **************** DdpmComboBoxStyle: Custom WPF ComboBox  ****************  -->

    <!--  Resources of DdpmComboBox  -->
    <!--  DdomCB_BdColor=(64,88,109,1) : the BorderBrush of the ComboBox ToggleButton part.  -->
    <SolidColorBrush x:Key="DdpmCB_BdColor" Color="#FF40586D" />
    <!--  DdpmCD_BkColor=(41,59,77,1): The background color of the DdpmComboBox  -->
    <SolidColorBrush x:Key="DdpmCB_BkColor" Color="#FF2F3B4D" />
    <!--  DdpmCB_TextColor=(255,255,255,1): The normal item text color of Text in Dropdown list  -->
    <SolidColorBrush x:Key="DdpmCB_TextColor" Color="White" />
    <!--  DdpmCB_HiTextColor=(49,162,227,1): The highlight item color of Text in Dropdown list  -->
    <SolidColorBrush x:Key="DdpmCB_HiTextColor" Color="#FFFF6C6C" />
    <!--  DdpmCB_SelTextColor=(49,162,227,1): The selected item color of Text in Dropdown list  -->
    <SolidColorBrush x:Key="DdpmCB_SelTextColor" Color="#FF31A2E3" />

    <!--  ToogleButton PART of DdpmComboBox  -->
    <!--
    [1] Draw the arrow down by default.
    [2] When the toggle is Checked, change the arrow to 'up'.
    [3] When mouse over on the toggle button, hi light the button background color.
    -->
    <ControlTemplate x:Key="DdpmComboBoxToggleButtonTemplate" TargetType="ToggleButton">
        <Grid x:Name="toggleBtnRoot" Background="#19000000">

            <!--  [1]  -->
            <Viewbox
                Grid.Column="1"
                Width="16"
                Height="16"
                Margin="0,0,8,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Stretch="Uniform">
                <Grid Width="20" Height="20">
                    <Path
                        Name="Arrow"
                        Data="M1,0 L0,1 L10,11 L20,1 L19,0 L10,9 z"
                        Fill="White" />
                </Grid>
            </Viewbox>
        </Grid>
        <ControlTemplate.Triggers>
            <!--  [2]  -->
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Arrow" Property="Data" Value="M1,11 L0,10 L10,0 L20,10 L19,11 L10,2 z" />
            </Trigger>
            <!--  [3]  -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="toggleBtnRoot" Property="Background" Value="#4CB1B0B0" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--  EditBox (TextBox) of DdpmComboBox  -->
    <!--
    It's unused, because that DdpmComboBox is not editable currently.
    -->
    <ControlTemplate x:Key="ComboBoxTextBox" TargetType="{x:Type TextBox}">
        <Border
            x:Name="PART_ContentHost"
            Background="{TemplateBinding Background}"
            Focusable="False" />
    </ControlTemplate>

    <!--  ComboBoxItem style of DdpmComboBox  -->
    <!--
    Define the hilight style when mouse selecting item
    -->
    <Style x:Key="DdpmComboBoxItemContainerStyle" TargetType="{x:Type ComboBoxItem}">
        <Setter Property="SnapsToDevicePixels" Value="true" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="OverridesDefaultStyle" Value="true" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border Name="Border" Padding="2,2,2,0" SnapsToDevicePixels="true"
                            Background="{StaticResource FakeTransparent}">
                        <ContentPresenter
                            Name="contentPresenter"
                            Margin="0,8,40,8"
                            VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="true">
                            <!-- -->
                            <Setter TargetName="Border" Property="Background" Value="#FF232D36" />

                            <!--
                            <Setter Property="Foreground" Value="{StaticResource DdpmCB_HiTextColor}" /> -->
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="false">
                            <Setter Property="Foreground" Value="#888888" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource DdpmCB_SelTextColor}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  DdpmComboBox Control Template  -->
    <!--
    [1] The margin between ComboBox and Popup is 12
    [2] Popup color and border style
    [3] The scrollbar is hidden in Popup => it's based on the design in Figma.
    [4] Color and border style of ComboBox itself.
    [5] ToggleButton is arranged to entire ComboBox area, templateRoot.Row[0]
    -->
    <ControlTemplate x:Key="DdpmComboBoxControlTemplate" TargetType="ComboBox">
        <Grid x:Name="templateRoot">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="0" />
                <!--  [1]  -->
            </Grid.RowDefinitions>

            <!--  [2] PART_Popup  -->
            <Popup
                Name="PART_Popup"
                Grid.Row="1"
                MinWidth="{Binding ActualWidth, ElementName=templateRoot}"
                Margin="0,0,0,0"
                AllowsTransparency="True"
                Focusable="False"
                IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                Placement="Bottom" VerticalOffset="8"
                PopupAnimation="Slide">

                <Border
                    Name="dropDownBorder"
                    Margin="0,0,0,0"
                    Background="{StaticResource DdpmCB_BkColor}"
                    BorderBrush="{StaticResource DdpmCB_BdColor}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <!--  [3] ScrollViewer of Popup  -->
                    <ScrollViewer
                        x:Name="DropDownScrollViewer"
                        Margin="4"
                        SnapsToDevicePixels="True"
                        VerticalScrollBarVisibility="Hidden">

                        <Grid x:Name="grid" RenderOptions.ClearTypeHint="Enabled">
                            <Canvas
                                x:Name="canvas"
                                Width="0"
                                Height="0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top">
                                <Rectangle
                                    x:Name="opaqueRect"
                                    Width="{Binding ActualWidth, ElementName=dropDownBorder}"
                                    Height="{Binding ActualHeight, ElementName=dropDownBorder}"
                                    Fill="{Binding Background, ElementName=dropDownBorder}" />
                            </Canvas>

                            <ItemsPresenter
                                x:Name="ItemsPresenter"
                                KeyboardNavigation.DirectionalNavigation="Contained"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Grid>
                    </ScrollViewer>
                </Border>
            </Popup>

            <!--  [4]  -->
            <Border
                Background="{StaticResource DdpmCB_BkColor}"
                BorderBrush="{StaticResource DdpmCB_BdColor}"
                BorderThickness="1"
                CornerRadius="4">
                <Grid>
                    <!--  Reserved Column 1 space for the up/down arrow  -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="32" />
                    </Grid.ColumnDefinitions>
                    <!--  [5] toggleButton  -->
                    <ToggleButton
                        Name="toggleButton"
                        Grid.ColumnSpan="2"
                        HorizontalAlignment="Stretch"
                        ClickMode="Press"
                        Focusable="True"
                        IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                        Template="{StaticResource DdpmComboBoxToggleButtonTemplate}" />

                    <ContentPresenter
                        x:Name="contentPresenter"
                        Grid.Column="0"
                        Margin="8,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="{TemplateBinding SelectionBoxItem}"
                        ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                        ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                        ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                        IsHitTestVisible="False" />
                </Grid>
            </Border>
        </Grid>

        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="false">
                <Setter Property="Foreground" Value="#888888" />
            </Trigger>
        </ControlTemplate.Triggers>
        <!-- Currently no need
        <ControlTemplate.Triggers>
        <Trigger Property="HasItems" Value="false">
        <Setter TargetName="dropDownBorder" Property="MinHeight" Value="95" />
        </Trigger>
        <Trigger Property="IsEnabled" Value="false">
        <Setter Property="Foreground" Value="#888888" />
        </Trigger>
        <Trigger Property="IsGrouping" Value="true">
        <Setter Property="ScrollViewer.CanContentScroll" Value="false" />
        </Trigger>

        <Trigger SourceName="PART_Popup" Property="Popup.AllowsTransparency" Value="true">
        <Setter TargetName="dropDownBorder" Property="CornerRadius" Value="4" />
        <Setter TargetName="dropDownBorder" Property="Margin" Value="0,32,0,0" />
        </Trigger>
        </ControlTemplate.Triggers>
        -->
    </ControlTemplate>

    <!--  DdpmCombox Style usage from here  -->
    <Style x:Key="DdpmComboBoxStyle" TargetType="ComboBox">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{StaticResource DdpmCB_BkColor}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template" Value="{StaticResource DdpmComboBoxControlTemplate}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource DdpmComboBoxItemContainerStyle}" />
    </Style>

    <DataTemplate x:Key="ComboBoxItemTemplate">
        <StackPanel Orientation="Vertical" Margin="8">
            <!-- Text binding -->
            <TextBlock Text="{Binding Type}" HorizontalAlignment="Center"/>
            <!-- Path Data binding -->
            <Path Data="{Binding PathData}" Margin="8" 
                  HorizontalAlignment="Center" Fill="White"/>
        </StackPanel>
    </DataTemplate>

    <!--  DdpmCombox Style usage from here  -->
    <Style x:Key="DdpmUSBKVMComboBoxStyle" TargetType="ComboBox">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="MinHeight" Value="80" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{StaticResource DdpmCB_BkColor}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template" Value="{StaticResource DdpmComboBoxControlTemplate}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource DdpmComboBoxItemContainerStyle}" />
        <Setter Property="ItemTemplate" Value="{StaticResource ComboBoxItemTemplate}"/>
    </Style>

    <!-- General Control Colors
    There are many buttons,headers use this brush as their background color in hover state.
    When you see the colors in Figma are:
    #0672CB    100%
    #0078D4    100%
    #6E69CF    100%
    Then you can use this color
    -->
    <LinearGradientBrush x:Key="Brush_GradientButtonCyan" StartPoint="0.5,1" EndPoint="0.5,0"
                         MappingMode="RelativeToBoundingBox">
        <LinearGradientBrush.RelativeTransform>
            <TransformGroup>
                <RotateTransform CenterX="0.5" CenterY="0.5" Angle="100" />
            </TransformGroup>
        </LinearGradientBrush.RelativeTransform>
        <LinearGradientBrush.GradientStops>
            <GradientStopCollection>
                <GradientStop Color="#FF0672CB" Offset="0" />
                <GradientStop Color="#FF0078D4" Offset="0.46" />
                <GradientStop Color="#FF6E69CF" Offset="1.1831" />
            </GradientStopCollection>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <!-- Linear Gradient Border Brush
    When you see the colors in Figma are:
    #55B4FD     100%
    #6E69CF     100%
    -->
    <LinearGradientBrush x:Key="Brush_GradientBorderCyan"
                         StartPoint="0.002248,0.0194" EndPoint="1.30867,0.254939">
        <LinearGradientBrush.GradientStops>
            <GradientStopCollection>
                <GradientStop Color="#FF55B4FD" Offset="0" />
                <GradientStop Color="#FF5051DA" Offset="1" />
            </GradientStopCollection>
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <!-- Buttons -->
    <!-- BlackButton -->
    <Style x:Key="BlackButtonBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource FakeTransparent}" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Height" Value="40" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#F5F6F7" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#1D2C38" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="BorderBrush" Value="#A3A3A3" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="BlackButtonText" TargetType="UXControls:UXTextBlock">
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="Roboto" />
        <Setter Property="FontSize" Value="14" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#6E6E6E" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Dashed Brush for Focus border -->
    <DrawingBrush x:Key="FocusDotBrush" Viewport="0,0,1,1" ViewportUnits="Absolute" TileMode="Tile">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#B6B6B6">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="0,0,50,50" />
                            <RectangleGeometry Rect="50,50,50,50" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <LinearGradientBrush x:Key="VbarItem_HiBdColor" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FF55B4FD" />
        <GradientStop Offset="1" Color="#FF6E69CF" />
    </LinearGradientBrush>
</ResourceDictionary>