        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{DynamicResource FakeTransparent}"
                        BorderThickness="0">
                        <Grid Background="Transparent" SnapsToDevicePixels="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- 
                                AutomationProperties.Name="Expander header readio button"
                NG:
                                AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource TemplateParent}}" => hang
                                AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource AncestorType=ToggleButton}}" => read class name (RadioButton)
                                AutomationProperties.Name="{Binding Content, ElementName=expHeaderContent}" => read class name (RadioButton)
                                 AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource AncestorType=Expander}}" => "StackPanel"
                                AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource AncestorType=HeaderedContentControl}}" => "RadioButton"
                                AutomationProperties.Name="{TemplateBinding Content}" "RadioButton"
               -->
                            <UXControls:UXRadioButton
                                Name="SwManual"
                                Grid.Column="0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Focusable="False"
                                KeyboardNavigation.TabNavigation="None"
                                AutomationProperties.Name="Expander header readio button"
                                IsChecked="{Binding IsChecked, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <UXControls:UXRadioButton.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                    </Style>
                                </UXControls:UXRadioButton.Resources>
                            </UXControls:UXRadioButton>

                            <ContentPresenter x:Name="expHeaderContent"
                                Grid.Column="0"
                                Content="{TemplateBinding Content}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True"
                                SnapsToDevicePixels="True" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

