<UserControl x:Class="DDPM.UI.Common.TabButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             mc:Ignorable="d"
             d:DesignHeight="60"
             d:DesignWidth="200">
  <Grid>
    <Border x:Name="Border" CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" BorderBrush="#0DFFFFFF"
                Background="{DynamicResource RightView_Header_BkColor}"
                Margin="0" MouseLeftButtonDown="OnClick">
      <UXControls:UXTextBlock TextWrapping="WrapWithOverflow" x:Name="TabCaption" Text="{Binding Caption, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" FontSize="{Binding CaptionSize, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" FontFamily="Roboto" FontWeight="Light"
                                    Margin="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
    </Border>
    <Image x:Name="InfoIcon" Margin="0,8,8,0" Source="/DDPM.UI.Common;component/Resources/info.png" Stretch="Fill" Visibility="Hidden"
               VerticalAlignment="Top" HorizontalAlignment="Right" Cursor="Hand" Width="16" Height="16">
      <Image.ToolTip>
        <!--Elsa 20250401 for PIMS-348390 add HorizontalOffset="2" MaxWidth="272" Opened="toolTip_Opened" -->
        <ToolTip x:Name="toolTip" Placement="Top" VerticalOffset="12" HorizontalOffset="2" MaxWidth="272" Opened="toolTip_Opened">
          <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
            <Border.Resources>
              <Style BasedOn="{StaticResource Tooltip_TextBlockStyle}" TargetType="TextBlock" />
            </Border.Resources>
            <StackPanel Orientation="Horizontal">
              <!--Elsa 20250401 for PIMS-348390 change MaxWidth="350" to MaxWidth="230" -->
              <TextBlock x:Name="txtToolTip" MaxWidth="230" TextWrapping="Wrap" DataContextChanged="TabCaption_DataContextChanged" />
            </StackPanel>
          </Border>
        </ToolTip>
      </Image.ToolTip>
    </Image>
  </Grid>
</UserControl>