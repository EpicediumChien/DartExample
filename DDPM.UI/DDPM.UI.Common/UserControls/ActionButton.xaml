<UserControl x:Class="DDPM.UI.Common.ActionButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             mc:Ignorable="d"
             d:DesignHeight="60"
             d:DesignWidth="200"
             BorderBrush="{DynamicResource Button_UXStyleColor_ForWhiteFrame}">
    <Grid>
        <Border x:Name="Border" Cursor="Hand"
                CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Background="{Binding Background, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=UserControl}}"
                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <UXControls:UXTextBlock x:Name="ButtonCaption"
                                    Text="{Binding Caption, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Foreground="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=Border}}"
                                    FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    VerticalAlignment="Center" HorizontalAlignment="Center" />
        </Border>
    </Grid>
</UserControl>