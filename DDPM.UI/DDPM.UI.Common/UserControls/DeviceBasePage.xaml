<UserControl x:Class="DDPM.UI.Common.UserControls.DeviceBasePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DDPM.UI.Common.UserControls"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             xmlns:common="clr-namespace:DDPM.UI.Common"
             xmlns:lang="clr-namespace:DDPM.UI.Resources.Helper;assembly=DDPM.UI.Resources" 
             xmlns:viewmodels="clr-namespace:DDPM.UI.Common.ViewModels" 
             d:DataContext="{d:DesignInstance Type=viewmodels:DeviceBasePageViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Loaded="UserControl_Loaded"

             SizeChanged="UserControl_SizeChanged" Unloaded="UserControl_Unloaded">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- <ResourceDictionary Source="/DDPM.UI.Common;component/ModuleStyle.xaml" /> -->
            </ResourceDictionary.MergedDictionaries>

            <Storyboard x:Key="StoryGotoTwoView">
                <DoubleAnimation Storyboard.TargetName="RightGrid" Storyboard.TargetProperty="Width"
                                 Duration="0:0:0.4" From="0" To="{Binding LeftFrameWidth}" FillBehavior="HoldEnd" />
            </Storyboard>

            <SolidColorBrush x:Key="PageBkColor" Color="#FF0D121A" />
            <SolidColorBrush x:Key="ToolipBkColor" Color="#FF1D2C3B" />
            <SolidColorBrush x:Key="ToolipBdColor" Color="#FF293B4D" />
            <SolidColorBrush x:Key="ToolipTextColor" Color="#FFF5F6F7" />

            <!-- Dashed Brush for Focus border -->
            <DrawingBrush x:Key="FocusDotBrush" Viewport="0,0,1,1" ViewportUnits="Absolute" TileMode="Tile">
                <DrawingBrush.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="#B6B6B6">
                            <GeometryDrawing.Geometry>
                                <GeometryGroup>
                                    <RectangleGeometry Rect="0,0,50,50" />
                                    <RectangleGeometry Rect="50,50,50,50" />
                                </GeometryGroup>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingBrush.Drawing>
            </DrawingBrush>

            <CollectionViewSource x:Key="ItemsViewSource" Source="{Binding VbarItems}" />
            <common:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <!--<UXControls:UXScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">-->
    <Grid>
            <!-- ImageSource Uri
        "pack://application:,,,/" + assemblyName + ";component/" + resourceName
        -->
        <Image x:Name="imgBkGlow" Visibility="Collapsed"
            Source="pack://application:,,,/DDPM.UI.Common;component/Resources/Background_Glow.png"
            Stretch="UniformToFill"/>

        <!-- Layers: buttom to top, 1,2,3, ... -->
        <!-- Layer 1 -->
        <Grid >
                <!-- Robert_Lin 2025-4-16 Use IsFullViewOpened to control show/hide -->
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Path=IsFullViewOpened}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

                <StackPanel Orientation="Horizontal" x:Name="topStackPanel">
                    <!-- LeftFrame -->
                    <Grid x:Name="LeftGrid">
                        <ContentControl Name="LeftFrame" Content="{Binding LeftView}" Margin="0"/>

                        <!-- Dummy layer, MarketName use this grid to binding its MaxWidth, do not remove or rename -->
                        <Grid Name="markeyNameWidthGrid" d:Background="DarkBlue">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Margin" Value="10,0,212,0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLandingMode}" Value="False">
                                            <Setter Property="Margin" Value="100,0,70,0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                        </Grid>

                        <!-- Layer 2 : Nav and Vbar -->
                        <Grid Name="gridNav">
                            <!-- #region OLD Nav layout design -->
                            <!-- Robert_Lin 2025-2-20 for EBG UX report issues, remark this after apply new solution                            
                            <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Margin="60,8,0,0" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition MaxHeight="90" />
                                    <RowDefinition Height="AUto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                 <Button Grid.Row="0" Grid.Column="0" Width="24" Height="24"
                                    VerticalAlignment="Center" Cursor="Hand"
                                    KeyboardNavigation.TabIndex="1" Style="{StaticResource StatelessButton}"
                                    AutomationProperties.Name="{Binding [Back], Source={x:Static lang:LangHelper.Instance}}" Click="leftArrow_Click"
                                    >
                                    <Grid >
                                        <Polyline Points="12,5 5,12 12,19"
                                                  Stroke="{DynamicResource TextBlock_ForegroundColor}" StrokeThickness="2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        <Polyline Points="5,12 19,12"
                                                  Stroke="{DynamicResource TextBlock_ForegroundColor}" StrokeThickness="2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Grid>
                                </Button>

                                <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
                                    <UXControls:UXTextBlock Grid.Row="0" Grid.Column="1" Name="marketName2"
                                                            Text="{Binding SelectedHomeDevice.LandingMarketName}"
                                                            HorizontalAlignment="Left" TextBlockType="Header2"
                                                            TextBlockSemanticColorType="DefaultHeader"
                                                            Focusable="True" KeyboardNavigation.TabIndex="2"
                                                            Foreground="{DynamicResource TextBlock_ForegroundColor}" 
                                                            FontSize="24" TextTrimming="WordEllipsis"
                                                            MaxWidth="{Binding Path=ActualWidth, ElementName=markeyNameWidthGrid}"
                                                            MaxHeight="90"/>
                                </Grid>

                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                    <StackPanel>
                                        <Grid x:Name="gridDisplayName">
                                            <UXControls:UXTextBlock Text="{Binding SelectedHomeDevice.DisplayName}" 
                                                                TextTrimming="CharacterEllipsis" x:Name="tbDisplayName2"
                                                                HorizontalAlignment="Left" 
                                                                Focusable="True" KeyboardNavigation.TabIndex="3"
                                                                MaxWidth="{Binding Path=ActualWidth, ElementName=markeyNameWidthGrid}"
                                                                Visibility="{Binding SelectedHomeDeviceTextVisibiliity}" FontSize="18" />
                                        </Grid>

                                        <ComboBox Style="{DynamicResource DdpmComboBoxStyle}" Height="40"
                                              Visibility="{Binding HomeDevicesComboBoxVisibility}"
                                              KeyboardNavigation.TabIndex="3" 
                                              DisplayMemberPath="DisplayName"
                                              ItemsSource="{Binding HomeDevices}"
                                              SelectedItem="{Binding SelectedHomeDevice, Mode=TwoWay}">
                                            <ComboBox.ItemContainerStyle>
                                                <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DdpmComboBoxItemContainerStyle}">
                                                    <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}"/>
                                                </Style>
                                            </ComboBox.ItemContainerStyle>
 
                                        </ComboBox>

                                    </StackPanel>
 
                                    <Viewbox Width="16" Height="16" Stretch="Uniform" Margin="8,0,0,10" VerticalAlignment="Center">
                                        <Grid Width="16" Height="16" Background="{StaticResource FakeTransparent}">
                                            <Grid.Resources>
                                                <Style TargetType="Path">
                                                    <Setter Property="Fill" Value="{DynamicResource InfoIconColor}"/>
                                                </Style>
                                            </Grid.Resources>
                                            <Path Data="M8 5.0498C8.55228 5.0498 9 4.60209 9 4.0498C9 3.49752 8.55228 3.0498 8 3.0498C7.44772 3.0498 7 3.49752 7 4.0498C7 4.60209 7.44772 5.0498 8 5.0498Z"/>
                                            <Path Data="M8.75 6.4502H7.25V12.6502H8.75V6.4502Z"/>
                                            <Path Data="M8 1C11.85 1 15 4.15 15 8C15 11.85 11.85 15 8 15C4.15 15 1 11.85 1 8C1 4.15 4.15 1 8 1ZM8 0C3.6 0 0 3.6 0 8C0 12.4 3.6 16 8 16C12.4 16 16 12.4 16 8C16 3.6 12.4 0 8 0Z"/>
                                            <Grid.ToolTip>
                                                <ToolTip Placement="Right" HorizontalOffset="-16" VerticalOffset="-90">
                                                    <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                                        <Border.Resources>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Tooltip_TextBlockStyle}" />
                                                        </Border.Resources>

                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding [FirmwareVersion], Source={x:Static lang:LangHelper.Instance}}" Name="tooltipFwVer2" Margin="0,0,8,0" />
                                                                <TextBlock Text="{Binding SelectedHomeDevice.FwVer}" />
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding [ServiceTag], Source={x:Static lang:LangHelper.Instance}}" Name="tooltipServiceTag2" Margin="0,0,8,0" />
                                                                <TextBlock Text="{Binding SelectedHomeDevice.ServiceTag}" />
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding [ManufactureMonth], Source={x:Static lang:LangHelper.Instance}}" Name="tooltipManufactureMonth2" Margin="0,0,8,0" />
                                                                <TextBlock Text="{Binding SelectedHomeDevice.MfgDate}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </ToolTip>
                                            </Grid.ToolTip>
                                        </Grid>
                                    </Viewbox>

                                </StackPanel>
                            </Grid>
                            -->
                        <!-- #endregion OLD Nav layout design -->
                            
                        <!-- #region NEW Nav layout Robert_Lin 2025-2-20 for EBG UX report issues -->
                        <!-- 
                            1. 3 rows, add row 1 as the margin between row 0 and row 2 (move from OLD row 1)
                            2. Row 1 (margin) is 4 in Figma, but after compare with actrual UI shown, set it to 6 will be better.
                            3. MarketName add SizeChanged handler to show tooltip if it's wrapped.
                            4. Remove some Margins which to let TextBlock/ComboBox/InfoIcon to align center.
                            5. Row 2, Models (One monitor=ModelName, multiple monitors=ComboBox) and DeviceInfoIcon,
                               In the same level of horz-StackPanel to easy to align center.
                            6. Fix the FontSize of ModelName after checked Figma.
                            7. Fix ModelName forground color.
                            -->
                        <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Margin="60,15,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition MaxHeight="90" />
                                <RowDefinition Height="6" />
                                <RowDefinition Height="AUto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            
                            <!-- #region leftArrow -->
                            <!-- Robert_Lin 2025-2-10 New leftArrow design with Steless Button which better to support Narrator -->
                            <Button Grid.Row="0" Grid.Column="0" Width="24" Height="24"
                                    Style="{StaticResource BackArrowButton}"
                                    VerticalAlignment="Center" HorizontalAlignment="Left" Cursor="Hand"
                                    KeyboardNavigation.TabIndex="11" 
                                    AutomationProperties.Name="{Binding [Back], Source={x:Static lang:LangHelper.Instance}}" 
                                    Click="leftArrow_Click"
                                    />

                            <!-- #endregion leftArrow -->
                            
                            <!-- #region MarketName -->
                            <!-- Robert_Lin, 2024-8-29 for DDPMW-2094, for NPI projects show MarketName else show "Display" 
                            The binding Text will be HomeDevice.LandingMarketName
                            Support text wrap, maxmum tow rows, ending with "..."
                            -->
                            <Grid Grid.Row="0" Grid.Column="1">
                                <!-- Test marketName, When the Text is trimmed, we should enable the tooltip to show the full text
                                                        Text="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Vestibulum orci erat, varius nec euismod sed, lacinia vitae purus"
                                -->
                                <UXControls:UXTextBlock Grid.Row="0" Grid.Column="1" Name="marketName"
                                                        d:Text="Monitor Market Name" d:MaxWidth="200"
                                                        Text="{Binding SelectedHomeDevice.LandingMarketName}"
                                                        FontWeight="Normal"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                                        TextBlockType="Header2" TextWrapping="Wrap"
                                                        TextBlockSemanticColorType="DefaultHeader"
                                                        Focusable="True" KeyboardNavigation.TabIndex="12"
                                                        Foreground="{DynamicResource DefaultTheme_TxtColor}" 
                                                        FontSize="24" TextTrimming="WordEllipsis"
                                                        MaxWidth="{Binding Path=ActualWidth, ElementName=markeyNameWidthGrid}"
                                                        MaxHeight="90" SizeChanged="marketNameText_SizeChanged"/>
                            </Grid>
                            <!-- #endregion MarketName -->

                            <!-- #region ModelName, ComboBox, and InfoIcon -->
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                
                                <!-- #region ModelName for signle monitor -->
                                <Grid Height="40">
                                    <!-- Robert_Lin, 2024-6-20, change to show DisplayName 
                                    DisplayName="{ModelName}", but when there are multiple same models, DisplayName="{ModelName} ({InstanceNo})"
                                    -->
                                    <UXControls:UXTextBlock Text="{Binding SelectedHomeDevice.DisplayName}"
                                                            d:Text="U2723QE"  d:MaxWidth="200" d:Visibility="Collapsed"
                                                            TextTrimming="CharacterEllipsis" x:Name="tbDisplayName"
                                                            HorizontalAlignment="Left"  VerticalAlignment="Center"
                                                            Focusable="True" KeyboardNavigation.TabIndex="13"
                                                            FontWeight="Normal"
                                                            MaxWidth="{Binding Path=ActualWidth, ElementName=markeyNameWidthGrid}"
                                                            Foreground="{DynamicResource ModelNumberText_TxtColor}"
                                                            Visibility="{Binding SelectedHomeDeviceTextVisibiliity}" FontSize="20" />
                                </Grid>
                                <!-- #endregion ModelName for signle monitor -->
                                
                                <!-- #region ComboBox of Models for multiple monitors -->
                                <!-- Derek_Du 2024-10-26 remove MinWidth="140"  for RWD -->
                                <ComboBox Style="{DynamicResource DdpmComboBoxStyle}" Height="40" d:Visibility="Visible"
                                          Visibility="{Binding HomeDevicesComboBoxVisibility}"
                                          HorizontalAlignment="Left" VerticalAlignment="Center"
                                          KeyboardNavigation.TabIndex="13" 
                                          DisplayMemberPath="DisplayName"
                                          ItemsSource="{Binding HomeDevices}"
                                          SelectedItem="{Binding SelectedHomeDevice, Mode=TwoWay}">
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DdpmComboBoxItemContainerStyle}">
                                            <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}"/>
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                </ComboBox>
                                <!-- #endregion ComboBox of Models for multiple monitors -->

                                <!-- #region DeviceInfoIcon -->
                                <!-- Robert_Lin 2025-3-11 Change it to Button to support Narrator and the tooltip text binding to  HomeDevice.DeviceInfoToolTipText -->
                                <Button Style="{StaticResource StatelessButton}" Width="16" Height="16" VerticalAlignment="Center" Margin="8,0,0,0"
                                        KeyboardNavigation.TabIndex="14"
                                        AutomationProperties.Name="{Binding SelectedHomeDevice.DeviceInfoToolTipText}">
                                    <!-- The (i) icon 16x16 -->
                                    <ContentControl Template="{StaticResource icon_Info}"/>
                                    
                                    <!-- ToolTip -->
                                    <Button.ToolTip>
                                        <!--Elsa 20250401 for PIMS-348390 change HorizontalOffset="0" to HorizontalOffset="2" -->
                                        <ToolTip BorderThickness="0" Background="Transparent" 
                                                 Placement="Top" HorizontalOffset="2" VerticalOffset="12">
                                            <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                                <TextBlock Text="{Binding SelectedHomeDevice.DeviceInfoToolTipText}"
                                                           Style="{StaticResource Tooltip_TextBlockStyle}" LineHeight="20"/>
                                            </Border>
                                        </ToolTip>
                                    </Button.ToolTip>
                                </Button>
                                <!-- OLD: Using Paths to draw -->
                                <Viewbox Width="16" Height="16" Stretch="Uniform" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                    <Grid Width="16" Height="16" Background="{StaticResource FakeTransparent}">
                                        <Grid.Resources>
                                            <Style TargetType="Path">
                                                <Setter Property="Fill" Value="{DynamicResource InfoIconColor}"/>
                                            </Style>
                                        </Grid.Resources>
                                        <Path Data="M8 5.0498C8.55228 5.0498 9 4.60209 9 4.0498C9 3.49752 8.55228 3.0498 8 3.0498C7.44772 3.0498 7 3.49752 7 4.0498C7 4.60209 7.44772 5.0498 8 5.0498Z"/>
                                        <Path Data="M8.75 6.4502H7.25V12.6502H8.75V6.4502Z"/>
                                        <Path Data="M8 1C11.85 1 15 4.15 15 8C15 11.85 11.85 15 8 15C4.15 15 1 11.85 1 8C1 4.15 4.15 1 8 1ZM8 0C3.6 0 0 3.6 0 8C0 12.4 3.6 16 8 16C12.4 16 16 12.4 16 8C16 3.6 12.4 0 8 0Z"/>
                                        <Grid.ToolTip>
                                            <ToolTip Placement="Right" HorizontalOffset="-16" VerticalOffset="-90">
                                                <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                                    <Border.Resources>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Tooltip_TextBlockStyle}" />
                                                    </Border.Resources>

                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding [FirmwareVersion], Source={x:Static lang:LangHelper.Instance}}" Name="tooltipFwVer" Margin="0,0,8,0" />
                                                            <TextBlock Text="{Binding SelectedHomeDevice.FwVer}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding [ServiceTag], Source={x:Static lang:LangHelper.Instance}}" Name="tooltipServiceTag" Margin="0,0,8,0" />
                                                            <TextBlock Text="{Binding SelectedHomeDevice.ServiceTag}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding [ManufactureMonth], Source={x:Static lang:LangHelper.Instance}}" Name="tooltipManufactureMonth" Margin="0,0,8,0" />
                                                            <TextBlock Text="{Binding SelectedHomeDevice.MfgDate}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </ToolTip>
                                        </Grid.ToolTip>
                                    </Grid>
                                </Viewbox>
                                <!-- #endregion DeviceInfoIcon -->
                            </StackPanel>
                            <!-- #endregion ModelName, ComboBox, and InfoIcon -->
                        </Grid>
                        <!-- #region NEW Nav layout Robert_Lin 2025-2-20 -->

                    </Grid>

                        <!-- Left vBar -->
                        <!-- ItemsSource="{Binding VbarItems}" -->
                        <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,0,0" 
                              x:Name="vBarLeft" Width="{Binding vBarWidthRWD}">
                            <ItemsControl Name="vbarListLeft" Margin="0,10,5,0" HorizontalAlignment="Right" 
                                          ItemsSource="{Binding Source={StaticResource ItemsViewSource}}"
                                          Focusable="False" KeyboardNavigation.TabNavigation="Continue" KeyboardNavigation.TabIndex="50">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <ContentPresenter />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                <ItemsControl.ItemContainerStyle>
                                    <Style>
                                        <Setter Property="FrameworkElement.Margin" Value="0,5" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>
                        </Grid>
                    </Grid>
                    <!--<UXControls:UXScrollViewer x:Name="topViewScrollViewer">-->
                    <!-- vBar + RightFrame -->
                    <StackPanel x:Name="stVbarRightFrame">
                        <!-- vBar -->
                        <!--Elsa 20250331 for PIMS-348388 change Margin="0,0,0,15" to Margin="0,0,0,16"-->
                        <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,0,16" x:Name="vBarRight" Visibility="Collapsed"
                              MouseEnter="vBar_MouseEnter" MouseLeave="vBar_MouseLeave">
                            <ItemsControl Name="vbarListRight" Margin="0,10,5,0" HorizontalAlignment="Right" 
                                          ItemsSource="{Binding Source={StaticResource ItemsViewSource}}"
                                      KeyboardNavigation.TabNavigation="Continue">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <ContentPresenter />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                <ItemsControl.ItemContainerStyle>
                                    <Style>
                                        <Setter Property="FrameworkElement.Margin" Value="0,5" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>
                        </Grid>


                        <!-- RightFrame -->
                        <Grid x:Name="RightGrid" HorizontalAlignment="Right" MinWidth="660">
                            <!--Elsa 20250331 for PIMS-348388 change Margin="10,0,0,20" to Margin="4,15,0,16"-->
                            <Border CornerRadius="13" Margin="4,15,0,16" Padding="16,0" 
                                    Background="{DynamicResource RightBaseBkColor}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- RightViewHeader control -->
                                    <common:RightViewHeaderCtrl Grid.Row="0" x:Name="rightViewHeaderCtrl" Margin="0,20,0,0"
                                    SelectedIndex="{Binding RightViewHeaderSelectedIndex, Mode=TwoWay}"
                                    ItemsSource="{Binding RightViewHeaders, Mode=TwoWay}"
                                    SelectionChanged="rightViewHeaderCtrl_SelectionChanged"/>

                                    <!-- RightFrame: will inject DdpmModule's RightView -->
                                    <!-- Robert_Lin, 2024-8-23, change Mode back to OneWay due to the RightView property in ViewModel
                                 is Get only, no Setter -->
                                    <!-- Robert_Lin, 2024-6-26, chage Mode to OneWay from TwoWay -->
                                    <ContentControl Grid.Row="1" Name="RightFrame"
                                    Content="{Binding RightView, Mode=OneWay}"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                    <!--</UXControls:UXScrollViewer>-->
                </StackPanel>

            </Grid>

            <!-- Layer : FullView -->
            <!-- Robert_Lin 2025-4-16, Binding to IsFullViewOpened to show/hide -->
            <ContentControl Name="FullFrame" Content="{Binding FullView}"
                            Visibility="{Binding IsFullViewOpened, Converter={StaticResource BoolToVisibilityConverter}}">
                <!--<ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FullView}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>-->
            </ContentControl>
        </Grid>
    <!--</UXControls:UXScrollViewer>-->
</UserControl>