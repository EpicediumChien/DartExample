<UserControl x:Class="DDPM.UI.Common.UserControls.DeviceBasePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DDPM.UI.Common.UserControls"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             xmlns:common="clr-namespace:DDPM.UI.Common"
             xmlns:lang="clr-namespace:DDPM.UI.Resources.Helper;assembly=DDPM.UI.Resources" 
             xmlns:viewmodels="clr-namespace:DDPM.UI.Common.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:DeviceBasePageViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Loaded="UserControl_Loaded"
             SizeChanged="UserControl_SizeChanged">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- <ResourceDictionary Source="/DDPM.UI.Common;component/ModuleStyle.xaml" /> -->
            </ResourceDictionary.MergedDictionaries>

            <Storyboard x:Key="StoryGotoTwoView">
                <DoubleAnimation Storyboard.TargetName="RightGrid" Storyboard.TargetProperty="Width"
                                 Duration="0:0:0.4" From="0" To="{Binding LeftFrameWidth}" FillBehavior="HoldEnd" />
            </Storyboard>

            <SolidColorBrush x:Key="PageBkColor" Color="#FF0D121A" />
            <SolidColorBrush x:Key="ToolipBkColor" Color="#FF1D2C3B" />
            <SolidColorBrush x:Key="ToolipBdColor" Color="#FF293B4D" />
            <SolidColorBrush x:Key="ToolipTextColor" Color="#FFF5F6F7" />

            <!-- Dashed Brush for Focus border -->
            <DrawingBrush x:Key="FocusDotBrush" Viewport="0,0,1,1" ViewportUnits="Absolute" TileMode="Tile">
                <DrawingBrush.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="#B6B6B6">
                            <GeometryDrawing.Geometry>
                                <GeometryGroup>
                                    <RectangleGeometry Rect="0,0,50,50" />
                                    <RectangleGeometry Rect="50,50,50,50" />
                                </GeometryGroup>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingBrush.Drawing>
            </DrawingBrush>

            <CollectionViewSource x:Key="ItemsViewSource" Source="{Binding VbarItems}" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <!-- ImageSource Uri
        "pack://application:,,,/" + assemblyName + ";component/" + resourceName
        -->
        <Image x:Name="imgBkGlow"
               Source="pack://application:,,,/DDPM.UI.Common;component/Resources/Background_Glow.png"
               Stretch="UniformToFill"/>

        <!-- Layers: buttom to top, 1,2,3, ... -->
        <!-- Layer 1 -->
        <Grid >
            
                <StackPanel Orientation="Horizontal" x:Name="topStackPanel">
                    <!-- LeftFrame -->
                    <Grid x:Name="LeftGrid">
                        <ContentControl Name="LeftFrame" Content="{Binding LeftView}" Margin="0"/>

                        <!-- Dummy layer, MarketName use this grid to binding its MaxWidth, do not remove or rename -->
                        <Grid Name="markeyNameWidthGrid">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Margin" Value="10,0,212,0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLandingMode}" Value="False">
                                            <Setter Property="Margin" Value="100,0,70,0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                        </Grid>

                        <!-- Layer 2 : Nav and Vbar -->
                        <Grid Name="gridNav">
                            <!-- Nav: Display Monitor market name, and LeftArrow back to DdpmHomePage -->
                            <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Margin="60,8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition MaxHeight="90" />
                                    <RowDefinition Height="AUto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- LeftArrow -->
                                <!-- OLD, Robert_Lin, 2024-6-10, change to using Polyline to draw -->
                                <!--
                            <UXControls:UXTextBlock Grid.Row="0" Grid.Column="0" Text="&#xe223; "
                            FontFamily="Segoe UI Symbol" FontSize="30"
                            HorizontalAlignment="Left" TextBlockType="Header2"
                            TextBlockSemanticColorType="Light" MouseLeftButtonDown="leftArrow_MouseLeftButtonDown" />
                            -->
                                <!-- Robert_Lin, 2024-6-10, new approach -->
                                <!-- Robert_Lin, 2024-8-8, change for support keyboard tab stop -->
                                <Border Focusable="True" KeyboardNavigation.TabNavigation="None"
                                    BorderBrush="{StaticResource FocusDotBrush}" PreviewKeyDown="bdLeftArrow_PreviewKeyDown">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Style.Triggers>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter Property="BorderThickness" Value="1" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <!--Robert_Lin, 2024-1030 fix PIMS-314264 Click no action when click non-arrow (Polylines) area => Grid.Background=FakeTransparent
                                    and remove Custor="Hand" 
                                    -->
                                    <Grid Width="24" Height="24"  MouseLeftButtonDown="leftArrow_MouseLeftButtonDown" Background="{StaticResource FakeTransparent}">
                                        <!--2024/06/19 Elie, Fix the issue where canot go back to homepage.-->
                                        <Polyline Points="12,5 5,12 12,19"
                                                  Stroke="{DynamicResource TextBlock_ForegroundColor}" StrokeThickness="2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        <Polyline Points="5,12 19,12"
                                                  Stroke="{DynamicResource TextBlock_ForegroundColor}" StrokeThickness="2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        <!-- Robert_Lin, 2024-1030 remove the hover effect -->
                                        <!--<Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Grid.Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect Color="White" Direction="315"
                                                                      ShadowDepth="4" BlurRadius="6"
                                                                      Opacity="0.7" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>-->
                                    </Grid>
                                </Border>

                                <!-- Monitor Market Name -->
                                <!-- Robert_Lin, 2024-8-29 Comment out for DDPMW-2094 
                            <UXControls:UXTextBlock Grid.Row="0" Grid.Column="1" Text="{Binding [Display], Source={x:Static lang:LangHelper.Instance}}" Name="marketName"
                                                    HorizontalAlignment="Left" TextBlockType="Header2"
                                                    TextBlockSemanticColorType="DefaultHeader"
                                                    Foreground="White"
                                                    FontSize="24" />
                            -->
                                <!-- Robert_Lin, 2024-8-29 for DDPMW-2094, for NPI projects show MarketName else show "Display" 
                            The binding Text will be HomeDevice.LandingMarketName
                            Support text wrap, maxmum tow rows, ending with "..."
                            -->
                                <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
                                    <UXControls:UXTextBlock Grid.Row="0" Grid.Column="1" Name="marketName"
                                            Text="{Binding SelectedHomeDevice.LandingMarketName}"
                                            HorizontalAlignment="Left" TextBlockType="Header2"
                                            TextBlockSemanticColorType="DefaultHeader"
                                            Foreground="{DynamicResource TextBlock_ForegroundColor}" TextTrimming="WordEllipsis"
                                            FontSize="24"
                                                MaxWidth="{Binding Path=ActualWidth, ElementName=markeyNameWidthGrid}"
                                                MaxHeight="90"/>
                                </Grid>



                                <!-- ComboBox to select Monitor -->
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                    <StackPanel>
                                        <!-- Robert_Lin, 2024-6-20, change to show DisplayName -->
                                        <Grid x:Name="gridDisplayName">
                                            <UXControls:UXTextBlock Text="{Binding SelectedHomeDevice.DisplayName}" 
                                                    TextTrimming="CharacterEllipsis" x:Name="tbDisplayName"
                                                    HorizontalAlignment="Left" 
                                                    MaxWidth="{Binding Path=ActualWidth, ElementName=markeyNameWidthGrid}"
                                                    Visibility="{Binding SelectedHomeDeviceTextVisibiliity}" FontSize="18" />
                                        </Grid>

                                        <!-- HomeDeviceComboBox - Option1: Using UXComboBox
                                    <UXControls:UXComboBox  x:Name="HomeDeviceComboBox"
                                    Visibility="{Binding HomeDevicesComboBoxVisibility}"
                                    Background="#FF293B4D" Width="200"
                                    ItemsSource="{Binding HomeDevices}"
                                    DisplayMemberPath="DeviceName"
                                    BorderBrush="#FF40586D" Foreground="White"
                                    SelectedItem="{Binding SelectedHomeDevice, Mode=TwoWay}">
                                    </UXControls:UXComboBox> -->
                                        <!-- HomeDeviceComboBox - Option1: Using WPF ComboBox -->
                                        <!-- Robert_Lin, 2024-6-20, change to show DisplayName -->
                                        <!-- Derek_Du 2024-10-26 remove MinWidth="140"  for RWD -->
                                        <ComboBox Style="{DynamicResource DdpmComboBoxStyle}" Height="40"
                                      Visibility="{Binding HomeDevicesComboBoxVisibility}"
                                      ItemsSource="{Binding HomeDevices}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedItem="{Binding SelectedHomeDevice, Mode=TwoWay}">
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- DeviceInfoIcon : Image will be loaded in C# code -->
                                    <Image Name="imgInfoIcon" Stretch="None" Margin="8,0,0,6" Visibility="Collapsed"
                               Source="pack://application:,,,/DDPM.UI.Common;component/Resources/Icon_Info.png">
                                        <Image.ToolTip>
                                            <!-- Placement="Top" HorizontalOffset="12" VerticalOffset="-28"
                                        -->
                                            <!-- Robert_Lin, 2024-6-26 fix tooltip placement. OLD:
                                        Placement="Top" HorizontalOffset="16"
                                        NEW: VerticalOffset="-90" may depend on the height of tooltop.
                                        -->
                                            <ToolTip Placement="Left" HorizontalOffset="-16" VerticalOffset="-90">
                                                <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                                    <Border.Resources>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Tooltip_TextBlockStyle}" />
                                                    </Border.Resources>

                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding [FirmwareVersion], Source={x:Static lang:LangHelper.Instance}}" />
                                                            <TextBlock Text="{Binding SelectedHomeDevice.FwVer}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding [ServiceTag], Source={x:Static lang:LangHelper.Instance}}" />
                                                            <TextBlock Text="{Binding SelectedHomeDevice.ServiceTag}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding [ManufactureMonth], Source={x:Static lang:LangHelper.Instance}}" />
                                                            <TextBlock Text="{Binding SelectedHomeDevice.MfgDate}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </ToolTip>
                                        </Image.ToolTip>
                                    </Image>

                                    <Viewbox Width="16" Height="16" Stretch="Uniform" Margin="8,0,0,10" VerticalAlignment="Center">
                                        <Grid Width="16" Height="16" Background="{StaticResource FakeTransparent}">
                                            <Path Data="M8 5.0498C8.55228 5.0498 9 4.60209 9 4.0498C9 3.49752 8.55228 3.0498 8 3.0498C7.44772 3.0498 7 3.49752 7 4.0498C7 4.60209 7.44772 5.0498 8 5.0498Z"
                                      Fill="#FFB6B6B6" />
                                            <Path Data="M8.75 6.4502H7.25V12.6502H8.75V6.4502Z"
                                      Fill="#FFB6B6B6" />
                                            <Path Data="M8 1C11.85 1 15 4.15 15 8C15 11.85 11.85 15 8 15C4.15 15 1 11.85 1 8C1 4.15 4.15 1 8 1ZM8 0C3.6 0 0 3.6 0 8C0 12.4 3.6 16 8 16C12.4 16 16 12.4 16 8C16 3.6 12.4 0 8 0Z"
                                      Fill="#FFB6B6B6" />
                                            <Grid.ToolTip>
                                                <ToolTip Placement="Right" HorizontalOffset="-16" VerticalOffset="-90">
                                                    <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                                        <Border.Resources>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Tooltip_TextBlockStyle}" />
                                                        </Border.Resources>

                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding [FirmwareVersion], Source={x:Static lang:LangHelper.Instance}}" Name="tooltipFwVer" Margin="0,0,8,0" />
                                                                <TextBlock Text="{Binding SelectedHomeDevice.FwVer}" />
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding [ServiceTag], Source={x:Static lang:LangHelper.Instance}}" Name="tooltipServiceTag" Margin="0,0,8,0" />
                                                                <TextBlock Text="{Binding SelectedHomeDevice.ServiceTag}" />
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding [ManufactureMonth], Source={x:Static lang:LangHelper.Instance}}" Name="tooltipManufactureMonth" Margin="0,0,8,0" />
                                                                <TextBlock Text="{Binding SelectedHomeDevice.MfgDate}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </ToolTip>
                                            </Grid.ToolTip>
                                        </Grid>
                                    </Viewbox>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- Left vBar -->
                        <!-- ItemsSource="{Binding VbarItems}" -->
                        <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,0,0" 
                              x:Name="vBarLeft" Width="{Binding vBarWidthRWD}">
                            <ItemsControl Name="vbarListLeft" Margin="0,10,5,0" HorizontalAlignment="Right" 
                                          ItemsSource="{Binding Source={StaticResource ItemsViewSource}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <ContentPresenter />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                <ItemsControl.ItemContainerStyle>
                                    <Style>
                                        <Setter Property="FrameworkElement.Margin" Value="0,5" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>
                        </Grid>
                    </Grid>
                <!--<UXControls:UXScrollViewer x:Name="topViewScrollViewer">-->
                    <!-- vBar + RightFrame -->
                    <StackPanel x:Name="stVbarRightFrame">
                        <!-- vBar -->
                        <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,0,15" x:Name="vBarRight" Visibility="Collapsed"
                              MouseEnter="vBar_MouseEnter" MouseLeave="vBar_MouseLeave">
                            <ItemsControl Name="vbarListRight" Margin="0,10,5,0" HorizontalAlignment="Right" 
                                          ItemsSource="{Binding Source={StaticResource ItemsViewSource}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <ContentPresenter />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                <ItemsControl.ItemContainerStyle>
                                    <Style>
                                        <Setter Property="FrameworkElement.Margin" Value="0,5" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>
                        </Grid>


                        <!-- RightFrame -->
                        <Grid x:Name="RightGrid" HorizontalAlignment="Right" MinWidth="660">
                            <Border CornerRadius="13" Margin="10,0,0,20" Padding="16,0" 
                                    Background="{DynamicResource RightBaseBkColor}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- RightViewHeader control -->
                                    <common:RightViewHeaderCtrl Grid.Row="0" x:Name="rightViewHeaderCtrl" Margin="0,20,0,0"
                                    SelectedIndex="{Binding RightViewHeaderSelectedIndex, Mode=TwoWay}"
                                    ItemsSource="{Binding RightViewHeaders, Mode=TwoWay}"
                                    SelectionChanged="rightViewHeaderCtrl_SelectionChanged"/>

                                    <!-- RightFrame: will inject DdpmModule's RightView -->
                                    <!-- Robert_Lin, 2024-8-23, change Mode back to OneWay due to the RightView property in ViewModel
                                 is Get only, no Setter -->
                                    <!-- Robert_Lin, 2024-6-26, chage Mode to OneWay from TwoWay -->
                                    <ContentControl Grid.Row="1" Name="RightFrame"
                                    Content="{Binding RightView, Mode=OneWay}"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                <!--</UXControls:UXScrollViewer>-->
            </StackPanel>
            
        </Grid>

        <!-- Layer : FullView -->
        <ContentControl Name="FullFrame" Content="{Binding FullView}">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding FullView}" Value="{x:Null}">
                            <!-- Debug to set always Visible -->
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>
    </Grid>
</UserControl>