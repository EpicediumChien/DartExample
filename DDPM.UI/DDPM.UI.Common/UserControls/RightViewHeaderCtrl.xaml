<UserControl x:Class="DDPM.UI.Common.RightViewHeaderCtrl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DDPM.UI.Common"
             xmlns:lang="clr-namespace:DDPM.UI.Resources.Helper;assembly=DDPM.UI.Resources"
             mc:Ignorable="d"
             d:DesignHeight="60" d:DesignWidth="600"
             Visibility="{Binding CtrlVisibility}">
    <UserControl.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="RightView_BkColor" Color="#99193457" />

            <!-- Unused -->
            <LinearGradientBrush x:Key="RightView_Header_HiColor" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#FF0672CB" />
                <GradientStop Offset="1" Color="#FF6E69CF" />
            </LinearGradientBrush>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Border Grid.Row="0" CornerRadius="4" Background="{DynamicResource RightView_Header_BkColor}"
                Height="30" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{Binding Col1Width}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Header[0] -->
                <Border Grid.Column="0" CornerRadius="4,0,0,4" MouseLeftButtonDown="header0_MouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Text1, Mode=TwoWay}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource RigthViewHeaderCtrl_TextBlock_HeaderTextStyle}">
                                    <Setter Property="Foreground" Value="{DynamicResource Vbar_FgBrush_Default}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding InternalSelectedIndex}" Value="0">
                                            <Setter Property="Foreground" Value="{DynamicResource RightView_Header_Text_HighlightColor}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Image Grid.Column="1" Visibility="{Binding Locker1}" Margin="0,0,20,0"
                               Source="pack://application:,,,/DDPM.UI.Common;component/Resources/Lock.png"
                               VerticalAlignment="Center" HorizontalAlignment="Center" Width="16" Height="16">
                            <Image.ToolTip>
                                <ToolTip>
                                    <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                        <Border.Resources>
                                            <Style BasedOn="{StaticResource Tooltip_TextBlockStyle}" TargetType="TextBlock" />
                                        </Border.Resources>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding [ITLockToolTip.0], Source={x:Static lang:LangHelper.Instance}}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </ToolTip>
                            </Image.ToolTip>
                        </Image>
                    </Grid>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding InternalSelectedIndex}" Value="0">
                                    <Setter Property="Background" Value="{StaticResource Brush_GradientButtonCyan}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <!-- Header[1] -->
                <Border Grid.Column="1" CornerRadius="0,0,0,0" MouseLeftButtonDown="header1_MouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Text2, Mode=TwoWay}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource RigthViewHeaderCtrl_TextBlock_HeaderTextStyle}">
                                    <Setter Property="Foreground" Value="{DynamicResource Vbar_FgBrush_Default}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding InternalSelectedIndex}" Value="1">
                                            <Setter Property="Foreground" Value="{DynamicResource RightView_Header_Text_HighlightColor}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Image Grid.Column="1" Visibility="{Binding Locker2}" Margin="0,0,20,0"
                               Source="pack://application:,,,/DDPM.UI.Common;component/Resources/Lock.png"
                               VerticalAlignment="Center" HorizontalAlignment="Center" Width="16" Height="16">
                            <Image.ToolTip>
                                <ToolTip>
                                    <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                        <Border.Resources>
                                            <Style BasedOn="{StaticResource Tooltip_TextBlockStyle}" TargetType="TextBlock" />
                                        </Border.Resources>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding [ITLockToolTip.0], Source={x:Static lang:LangHelper.Instance}}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </ToolTip>
                            </Image.ToolTip>
                        </Image>
                    </Grid>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding InternalSelectedIndex}" Value="1">
                                    <Setter Property="Background" Value="{StaticResource Brush_GradientButtonCyan}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <!-- Header[2] -->
                <Border Grid.Column="2" CornerRadius="0,4,4,0" MouseLeftButtonDown="header2_MouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Text3, Mode=TwoWay}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource RigthViewHeaderCtrl_TextBlock_HeaderTextStyle}">
                                    <Setter Property="Foreground" Value="{DynamicResource Vbar_FgBrush_Default}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding InternalSelectedIndex}" Value="2">
                                            <Setter Property="Foreground" Value="{DynamicResource RightView_Header_Text_HighlightColor}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Image Grid.Column="1" Visibility="{Binding Locker3}" Margin="0,0,20,0"
                               Source="pack://application:,,,/DDPM.UI.Common;component/Resources/Lock.png"
                               VerticalAlignment="Center" HorizontalAlignment="Center" Width="16" Height="16">
                            <Image.ToolTip>
                                <ToolTip>
                                    <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                        <Border.Resources>
                                            <Style BasedOn="{StaticResource Tooltip_TextBlockStyle}" TargetType="TextBlock" />
                                        </Border.Resources>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding [ITLockToolTip.0], Source={x:Static lang:LangHelper.Instance}}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </ToolTip>
                            </Image.ToolTip>
                        </Image>
                    </Grid>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding InternalSelectedIndex}" Value="2">
                                    <Setter Property="Background" Value="{StaticResource Brush_GradientButtonCyan}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>