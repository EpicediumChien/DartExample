<UserControl x:Class="DDPM.UI.Common.RightViewHeaderCtrl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DDPM.UI.Common"
             mc:Ignorable="d"
             d:DesignHeight="60" d:DesignWidth="600"
             Visibility="{Binding CtrlVisibility}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DDPM.UI.Common;component/ModuleStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="RightView_BkColor" Color="#99193457" />
            <SolidColorBrush x:Key="RightView_Header_BkColor" Color="#FF0A2343" />

            <!-- Unused -->
            <LinearGradientBrush x:Key="RightView_Header_HiColor" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#FF0672CB" />
                <GradientStop Offset="1" Color="#FF6E69CF" />
            </LinearGradientBrush>

            <Style x:Key="TextBlock_HeaderTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="14" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Border Grid.Row="0" CornerRadius="4" Background="{StaticResource RightView_Header_BkColor}"
                Height="30" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{Binding Col1Width}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Header[0] -->
                <Border Grid.Column="0" CornerRadius="4,0,0,4" MouseLeftButtonDown="header0_MouseLeftButtonDown">
                    <TextBlock Text="{Binding Text1, Mode=TwoWay}" Style="{StaticResource TextBlock_HeaderTextStyle}" />
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding InternalSelectedIndex}" Value="0">
                                    <Setter Property="Background" Value="{StaticResource Brush_GradientButtonCyan}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <!-- Header[1] -->
                <Border Grid.Column="1" CornerRadius="0,0,0,0" MouseLeftButtonDown="header1_MouseLeftButtonDown">
                    <TextBlock Text="{Binding Text2, Mode=TwoWay}" Style="{StaticResource TextBlock_HeaderTextStyle}" />
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding InternalSelectedIndex}" Value="1">
                                    <Setter Property="Background" Value="{StaticResource Brush_GradientButtonCyan}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <!-- Header[2] -->
                <Border Grid.Column="2" CornerRadius="0,4,4,0" MouseLeftButtonDown="header2_MouseLeftButtonDown">
                    <TextBlock Text="{Binding Text3, Mode=TwoWay}" Style="{StaticResource TextBlock_HeaderTextStyle}" />
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding InternalSelectedIndex}" Value="2">
                                    <Setter Property="Background" Value="{StaticResource Brush_GradientButtonCyan}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>