<UserControl x:Class="DDPM.UI.Common.VbarItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             xmlns:local="clr-namespace:DDPM.UI.Common"
             mc:Ignorable="d"
             HorizontalAlignment="Right"
             d:DataContext="{DynamicResource vmDesign}"
             xmlns:lang="clr-namespace:DDPM.UI.Resources.Helper;assembly=DDPM.UI.Resources"
             d:DesignHeight="72" d:DesignWidth="232"
             Height="73">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DDPM.UI.Common;component/PluginStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:VbarItemViewModel x:Key="vmDesign" Text="Robert" />
            <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Height="64"  VerticalAlignment="Top" Margin="0,0,12,0" HorizontalAlignment="Right"
          MouseEnter="rootGrid_MouseEnter" MouseLeave="rootGrid_MouseLeave"
          MouseLeftButtonDown="rootGrid_MouseLeftButtonDown">

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal">
                    <Storyboard>
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="LandingNormal" />
                <VisualState x:Name="LandingHover" />
                <VisualState x:Name="Hover">
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="bdRoot"
                                         Storyboard.TargetProperty="Width"
                                         Duration="0:0:0.5" To="212"
                                         FillBehavior="HoldEnd" />
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="ItemStates">
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Border Name="bdRoot" Width="212" BorderThickness="2" CornerRadius="13" ToolTipService.ShowOnDisabled="True"
                Focusable="True" GotFocus="bdRoot_GotFocus">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background"  Value="{DynamicResource Vbar_BkBrush_Default}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Vbar_BdBrush_Default}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSelected}"  Value="True">
                            <Setter Property="Background"  Value="{DynamicResource Brush_GradientButtonCyan}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource  Brush_GradientBorderCyan}" />
                        </DataTrigger>
                        <Trigger Property="IsEnabled"  Value="False">
                            <Setter Property="Background"  Value="{DynamicResource Vbar_BkBrush_Disabled}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Vbar_BdBrush_Disabled}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.ToolTip>
                <ToolTip Style="{StaticResource InfoToolTipStyle}" Placement="Left" VerticalOffset="0" HorizontalOffset="0" Visibility="{Binding TooltipVisibility}">
                    <TextBlock Style="{StaticResource TabInfoToolTipTextStyle}" Text="{Binding [Camera.12], Source={x:Static lang:LangHelper.Instance}}" />
                </ToolTip>
            </Border.ToolTip>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" Width="24" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center"
               Visibility="{Binding NoCanvasIcon, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}"
                       Source="{Binding Icon}" >
                </Image>
                <ContentControl x:Name="IconCanvasContent" Grid.Column="0">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Foreground" Value="{DynamicResource DefaultTheme_PathColor}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}"  Value="True">
                                    <Setter Property="Foreground"  Value="#FFFFFF" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
                <UXControls:UXTextBlock Grid.Column="1" Text="{Binding Text}" FontSize="14"
                                        VerticalAlignment="Center" HorizontalAlignment="Left"
                                        TextBlockType="Subtitle2" TextBlockSemanticColorType="Light">
                    <UXControls:UXTextBlock.Style>
                        <Style TargetType="UXControls:UXTextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Vbar_FgBrush_Default}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}"  Value="True">
                                    <Setter Property="Foreground"  Value="#FFFFFF" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </UXControls:UXTextBlock.Style>
                </UXControls:UXTextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>