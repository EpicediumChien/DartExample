<UserControl x:Class="DDPM.UI.Common.VbarItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             xmlns:local="clr-namespace:DDPM.UI.Common"
             mc:Ignorable="d"
             HorizontalAlignment="Right"
             d:DataContext="{DynamicResource vmDesign}"
             xmlns:lang="clr-namespace:DDPM.UI.Resources.Helper;assembly=DDPM.UI.Resources"
             d:DesignHeight="72" d:DesignWidth="232"
             Height="73">
  <UserControl.Resources>
    <ResourceDictionary>
    <ResourceDictionary.MergedDictionaries>
      <ResourceDictionary Source="/DDPM.UI.Common;component/PluginStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>
      
    <local:VbarItemViewModel x:Key="vmDesign"
                                 Text="Robert" />
    <SolidColorBrush x:Key="VbarItem_BkColor" Color="#99193457" />
    <SolidColorBrush x:Key="VbarItem_BkDisableColor" Color="#596067" />
    <SolidColorBrush x:Key="VbarItem_TextColor" Color="White" />

    <LinearGradientBrush x:Key="VbarItem_HiBkColor" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Offset="0" Color="#FF0672CB" />
      <GradientStop Offset="0.5" Color="#FF0078D2" />
      <GradientStop Offset="1" Color="#FF6E69CF" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="VbarItem_HiBdColor" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Offset="0" Color="#FF55B4FD" />
      <GradientStop Offset="1" Color="#FF6E69CF" />
    </LinearGradientBrush>
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid Height="64"  VerticalAlignment="Top" Margin="0,0,12,0" HorizontalAlignment="Right"
          MouseEnter="rootGrid_MouseEnter" MouseLeave="rootGrid_MouseLeave"
          MouseLeftButtonDown="rootGrid_MouseLeftButtonDown">

    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="CommonStates">
        <VisualState x:Name="Normal">
          <Storyboard>
          </Storyboard>
        </VisualState>
        <VisualState x:Name="LandingNormal" />
        <VisualState x:Name="LandingHover" />
        <VisualState x:Name="Hover">
          <Storyboard>
            <DoubleAnimation Storyboard.TargetName="bdRoot"
                                         Storyboard.TargetProperty="Width"
                                         Duration="0:0:0.5" To="212"
                                         FillBehavior="HoldEnd" />
          </Storyboard>
        </VisualState>
      </VisualStateGroup>
      <VisualStateGroup x:Name="ItemStates">
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <Border Name="bdRoot" Width="212" BorderThickness="2" CornerRadius="13" ToolTipService.ShowOnDisabled="True"
                Focusable="True" BorderBrush="{StaticResource VbarItem_BkColor}"
                GotFocus="bdRoot_GotFocus">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Background" Value="{StaticResource VbarItem_BkColor}" />
          <Setter Property="BorderBrush" Value="{StaticResource VbarItem_BkColor}" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected}"  Value="True">
              <Setter Property="Background"  Value="{StaticResource VbarItem_HiBkColor}" />
              <Setter Property="BorderBrush" Value="{StaticResource VbarItem_HiBdColor}" />
            </DataTrigger>
            <Trigger Property="IsEnabled"  Value="False">
              <Setter Property="Background"  Value="{StaticResource VbarItem_BkDisableColor}" />
              <Setter Property="BorderBrush" Value="{StaticResource VbarItem_BkDisableColor}" />
            </Trigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <Border.ToolTip>
        <ToolTip Style="{StaticResource InfoToolTipStyle}" Placement="Left" VerticalOffset="0" HorizontalOffset="0" Visibility="{Binding TooltipVisibility}">
          <TextBlock Style="{StaticResource TabInfoToolTipTextStyle}" Text="{Binding [Camera.12], Source={x:Static lang:LangHelper.Instance}}" />
        </ToolTip>
      </Border.ToolTip>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="64" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Image Grid.Column="0" Width="24" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center"
                       Source="{Binding Icon}" >
        </Image>
        <UXControls:UXTextBlock Grid.Column="1" Text="{Binding Text}" FontSize="14"
                                        VerticalAlignment="Center" HorizontalAlignment="Left"
                                        TextBlockType="Subtitle2" TextBlockSemanticColorType="Light"
                                        Foreground="{StaticResource VbarItem_TextColor}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>