<UserControl x:Class="DDPM.UI.Common.UserControls.AddCustomLayoutButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DDPM.UI.Common.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- <ResourceDictionary Source="/DDPM.UI.Common;component/ModuleStyle.xaml" /> -->
            </ResourceDictionary.MergedDictionaries>

            <LinearGradientBrush x:Key="Brush_Circle"
                         StartPoint="0,0" EndPoint="48.3739,20.2626">
                <LinearGradientBrush.GradientStops>
                    <GradientStopCollection>
                        <GradientStop Color="#FF0672CB" Offset="1" />
                        <GradientStop Color="#FF6E69CF" Offset="1" />
                    </GradientStopCollection>
                </LinearGradientBrush.GradientStops>
            </LinearGradientBrush>

        </ResourceDictionary>
        

    </UserControl.Resources>
    <Grid>
        <Border Width="30" Height="30" CornerRadius="15" HorizontalAlignment="Left"
                Background="{StaticResource Brush_Circle}" MouseLeftButtonDown="addButton_MouseLeftButtonDown">
            <Path Fill="White" Width="12" Height="12"
                  Data="M11.6836 5.0918H6.9082V0.316406H5.7168V5.0918H0.941406V6.2832H5.7168V11.0586H6.9082V6.2832H11.6836V5.0918Z"/>
        </Border>
    </Grid>
</UserControl>
