<UserControl x:Class="DDPM.UI.Common.UserControls.VbarItem1"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             xmlns:Common="clr-namespace:DDPM.UI.Common"
             xmlns:local="clr-namespace:DDPM.UI.Common.UserControls"
             mc:Ignorable="d"
             HorizontalAlignment="Right"
             Focusable="True"
             d:DesignHeight="74" d:DesignWidth="212" PreviewKeyDown="UserControl_PreviewKeyDown">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- <ResourceDictionary Source="/DDPM.UI.Common;component/ModuleStyle.xaml" /> -->
            </ResourceDictionary.MergedDictionaries>

            <!-- The Color resources are used for ColorAnimation in Story -->
            <!-- Background Color -->
            <Color x:Key="Vbar_BkColor_Default">#99132F54</Color>
            <Color x:Key="Vbar_BkColor_Disabled">#FF596067</Color>
            <Color x:Key="Vbar_BkColor_LockHover">#FFB6B6B6</Color>
            <!-- The Selected state is LinearGradientBrush see below in Brush section -->

            <!-- Border Color
            Disabled: the same with Vbar_BkColor_Disabled; Default: the same with Vbar_BkColor_Default.
            LandingHover, (non-selected) Hover will be Vbar_BdColor_Hover
            Selected and SelectedHover have the same BorderBrush:
            <Color x:Key="Vbar_BdColor_Hover">#991B385F</Color>
            -->
            <Color x:Key="Vbar_BdColor_Hover">#FF1B385F</Color>
            <Color x:Key="Vbar_BdColor_LockHover">#FF1B385F</Color>

            <!-- Foreground or Icon/Text Color -->
            <Color x:Key="Vbar_FgColor_Default">White</Color>
            <Color x:Key="Vbar_FgColor_Disabled">#FFF5F6F7</Color>

            <!-- The Brushes -->
            <!-- Landing Default -->
            <SolidColorBrush x:Key="Vbar_BkBrush_LandingDefault" Color="{StaticResource Vbar_BkColor_Default}" />
            <SolidColorBrush x:Key="Vbar_BdBrush_LandingDefault" Color="{StaticResource Vbar_BkColor_Default}" />
            <!-- Landing Hover -->
            <SolidColorBrush x:Key="Vbar_BkBrush_LandingHover" Color="{StaticResource Vbar_BkColor_Default}" />
            <SolidColorBrush x:Key="Vbar_BdBrush_LandingHover" Color="{StaticResource Vbar_BdColor_Hover}" />
            <!-- Default -->
            <SolidColorBrush x:Key="Vbar_BkBrush_Default" Color="{StaticResource Vbar_BkColor_Default}" />
            <SolidColorBrush x:Key="Vbar_BdBrush_Default" Color="{StaticResource Vbar_BkColor_Default}" />
            <!-- Hover -->
            <SolidColorBrush x:Key="Vbar_BkBrush_Hover" Color="{StaticResource Vbar_BkColor_Default}" />
            <SolidColorBrush x:Key="Vbar_BdBrush_Hover" Color="{StaticResource Vbar_BdColor_Hover}" />
            <!-- Disabled -->
            <SolidColorBrush x:Key="Vbar_BkBrush_Disabled" Color="{StaticResource Vbar_BkColor_Disabled}" />
            <SolidColorBrush x:Key="Vbar_BdBrush_Disabled" Color="{StaticResource Vbar_BkColor_Disabled}" />
            <!-- LockHover -->
            <SolidColorBrush x:Key="Vbar_BdBrush_LockHover" Color="{StaticResource Vbar_BdColor_LockHover}" />
            <SolidColorBrush x:Key="Vbar_BkBrush_LockHover" Color="{StaticResource Vbar_BkColor_LockHover}" />
            <!-- Selected
            BkBrush: Brush_GradientButtonCyan
            BdBrush: Brush_GradientBorderCyan
            -->
            <!-- Foreground -->
            <SolidColorBrush x:Key="Vbar_FgBrush_Default" Color="{StaticResource Vbar_FgColor_Default}" />
            <SolidColorBrush x:Key="Vbar_FgBrush_Disabled" Color="{StaticResource Vbar_FgColor_Disabled}" />

            <Common:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Robert_Lin, 2024-7-25, a new UserControl to replace VbarItem.
    1 Use a ControlTemplate as the content of Icon
    2 The Icon color can be changed with the {TemplateBinding Foreground} in the ControlTemplate
    3 Support Disabled state by changing the Foreground of the UserControl.
    4 No internal ViewModel, so the owner can be easily bind to this usercontrol, for example, ClickCommand
    5 Based on Dell UI team's requirements, add below states
    LandingHover and Hover (will show border), SelectedHover(will show linear gradient brush border)
    and Disabled state.
    -->

    <!-- Default: FgColor (Icon color and Text color) = White (Vbar_FgBrush_Default)
    When the UserControl is Disabled, change to foreground to gray (Vbar_FgBrush_Disabled).
    -->
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Foreground" Value="{StaticResource Vbar_FgBrush_Default}" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource Vbar_FgBrush_Disabled}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>

    <!-- rootGrid is used to handle hover and click events, and change its Width when in Hover state -->
    <Grid Name="rootGrid" HorizontalAlignment="Right" Margin="0,5,0,5"
          MouseEnter="rootGrid_MouseEnter" MouseLeave="rootGrid_MouseLeave"
          MouseLeftButtonDown="rootGrid_MouseLeftButtonDown">

        <!-- Most of States are handled (with Triggers) in bdOuter or inside it.
        In this VisualStateManager, we just handle the rootGrid.Width change animation.
        -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ItemStates">
                <VisualState x:Name="Default" />
                <VisualState x:Name="LandingDefault" />
                <VisualState x:Name="LandingLock" />

                <!-- In Landing mode, when hovering, show the Border color to (Vbar_BdColor_Hover) -->
                <VisualState x:Name="LandingHover">
                    <Storyboard>
                        <ColorAnimation Storyboard.TargetName="bdOuter"
                                        Storyboard.TargetProperty="BorderBrush.(SolidColorBrush.Color)"
                                        Duration="0:0:0.3" To="{StaticResource Vbar_BdColor_Hover}" />
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="LandingLockHover">
                    <Storyboard>
                        <ColorAnimation Storyboard.TargetName="bdOuter"
                                        Storyboard.TargetProperty="BorderBrush.(SolidColorBrush.Color)"
                                        Duration="0:0:0.3" To="{StaticResource Vbar_BdColor_LockHover}" />
                        <!--
                        <ColorAnimation Storyboard.TargetName="bdOuter"
                                        Storyboard.TargetProperty="Background.(SolidColorBrush.Color)"
                                        Duration="0:0:0.3" To="{StaticResource Vbar_BkColor_LockHover}" />
                        -->
                    </Storyboard>
                </VisualState>
                <!-- In non-Landing mode (default mode), when hovering will change rootGrid.Wdith and BdColor
                -->
                <VisualState x:Name="Hover">
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="bdOuter"
                                         Storyboard.TargetProperty="Width"
                                         Duration="0:0:0.5" To="212" FillBehavior="HoldEnd" />
                        <ColorAnimation Storyboard.TargetName="bdOuter"
                                        Storyboard.TargetProperty="BorderBrush.(SolidColorBrush.Color)"
                                        Duration="0:0:0.3" To="{StaticResource Vbar_BdColor_Hover}" />
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="LockHover">
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="bdOuter"
                                         Storyboard.TargetProperty="Width"
                                         Duration="0:0:0.5" To="212" FillBehavior="HoldEnd" />
                        <ColorAnimation Storyboard.TargetName="bdOuter"
                                        Storyboard.TargetProperty="Background.(SolidColorBrush.Color)"
                                        Duration="0:0:0.3" To="{StaticResource Vbar_BkColor_LockHover}" />
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Border x:Name="bdOuter" Height="64" BorderThickness="2" CornerRadius="13" Focusable="True">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource Vbar_BkBrush_Default}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Vbar_BdBrush_Default}" />
                    <Setter Property="Width" Value="212" />
                    <Style.Triggers>
                        <!-- Selected state -->
                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=UserControl}}"  Value="True">
                            <Setter Property="Background"  Value="{StaticResource Brush_GradientButtonCyan}" />
                            <Setter Property="BorderBrush" Value="{StaticResource  Brush_GradientBorderCyan}" />
                        </DataTrigger>
                        <!-- Disabled state -->
                        <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                            <Setter Property="Background"  Value="{StaticResource Vbar_BkBrush_Disabled}" />
                            <Setter Property="BorderBrush" Value="{StaticResource Vbar_BdBrush_Disabled}" />
                            <!--
                            <Setter Property="Width" Value="64" />
                            -->
                        </DataTrigger>
                        <!-- KeyboardFocus state -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource FocusDotBrush}" />
                        </Trigger>
                        <!-- Locked & Landing -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsLocked, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                                <Condition Binding="{Binding IsLandingMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Background"  Value="{StaticResource Vbar_BkBrush_Disabled}" />
                            <Setter Property="BorderBrush" Value="{StaticResource Vbar_BdBrush_Disabled}" />
                        </MultiDataTrigger>
                        <!-- Locked & NonLanding -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsLocked, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                                <Condition Binding="{Binding IsLandingMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Background"  Value="{StaticResource Vbar_BkBrush_Disabled}" />
                            <Setter Property="BorderBrush" Value="{StaticResource Vbar_BdBrush_Disabled}" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <!-- Content Grid -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Icon -->
                <ContentControl Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Template="{Binding VisualTemplate, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                <Image Grid.Column="0" Width="24" Height="24" Visibility="Visible"
                       VerticalAlignment="Center" HorizontalAlignment="Center"
                       Source="{Binding IconImage, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Opacity" Value="1" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=IsEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             Value="False">
                                    <Setter Property="Opacity" Value="0.5" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>

                <!-- Text -->
                <UXControls:UXTextBlock Grid.Column="1" FontSize="14"
                                        Text="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        VerticalAlignment="Center" HorizontalAlignment="Left" />
                
                <!-- LockIcon -->
                <Grid Grid.Column="1"
                      Visibility="{Binding IsLocked, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}"
                      VerticalAlignment="Center" HorizontalAlignment="Right" Width="16" Height="16"
                      Margin="0,0,20,0">
                    <Path Data="M12.1 6.40012V4.00012C12.2 1.80012 10.5 0.100122 8.30005 0.00012207H8.10005C5.90005 0.00012207 4.10005 1.80012 4.10005 4.00012V6.40012H1.80005V16.0001H14.1V6.40012H12.1ZM5.30005 4.00012C5.20005 2.50012 6.40005 1.30012 7.80005 1.20012H8.20005C9.80005 1.20012 11 2.50012 11 4.00012V6.40012H5.30005V4.00012ZM13.1 14.9001H3.00005V7.50012H13.1V14.9001Z M7.60005 12.5001H8.60005V9.30012H6.80005V10.3001H7.60005V12.5001Z"
                                     Fill="white" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>