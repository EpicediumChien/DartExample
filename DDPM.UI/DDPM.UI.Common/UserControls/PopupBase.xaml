<UserControl x:Class="DDPM.UI.Common.UserControls.PopupBase"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DDPM.UI.Common"
             xmlns:UXcontrols="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             mc:Ignorable="d" 
            ToolTipClosing="UserControl_ToolTipClosing">
    <!--Background="#293B4D"-->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <UXcontrols:UXTextBlock x:Name="Header" FontFamily="Roboto" FontSize="20" Margin="24,0,8,24"/>
        <UXcontrols:UXTextBlock x:Name="SubHeader" MaxWidth="372" MaxHeight="42" Grid.Row="1" FontFamily="Roboto" FontSize="15" Margin="24,0,24,8"
                       TextWrapping="WrapWithOverflow" />
        <StackPanel x:Name="ButtonPanel" Orientation="Horizontal" Grid.Row="2" Margin="0,20,0,10" Visibility="{Binding ShowButton}">
            <UXcontrols:UXButton x:Name="LeftButton" MaxHeight="40" MaxWidth="182" ButtonType="Secondary" HorizontalAlignment="Left" Margin="24,0,8,24"/>
            <UXcontrols:UXButton x:Name="RightButton" MaxHeight="40" MaxWidth="182" Margin="8,0,24,24" ButtonType="Primary" 
                       HorizontalAlignment="Right" IconPosition="IconRight" />
        </StackPanel>
    </Grid>
</UserControl>
