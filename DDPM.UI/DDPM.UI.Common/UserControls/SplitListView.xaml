<UserControl x:Class="DDPM.UI.Common.UserControls.SplitListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DDPM.UI.Common.UserControls"
             xmlns:lang="clr-namespace:DDPM.UI.Resources.Helper;assembly=DDPM.UI.Resources"
             
             KeyboardNavigation.TabNavigation="Continue"
             AutomationProperties.LiveSetting="Off"

             mc:Ignorable="d"
             d:DesignHeight="64" d:DesignWidth="616">
    <!-- 
               KeyboardNavigation.IsTabStop="True"
             KeyboardNavigation.TabNavigation="Continue"
  
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- <ResourceDictionary Source="/DDPM.UI.Common;component/ModuleStyle.xaml" /> -->
            </ResourceDictionary.MergedDictionaries>

            <!-- #region EzBtn Theme-->
            <!-- Key Resources for Dark/Light Theme, so move to ModuleStyle.xaml -->
            <!-- EzBtn (Left/Right Arrow button) Colors -->
            <!--<SolidColorBrush x:Key="EzBtn_BkColor_Default" Color="#FF193457" />-->
            <!--<SolidColorBrush x:Key="EzBtn_BkColor_Disabled" Color="#FF596067" />-->
            <!-- EzBtn_BkColor_Hover: Use Brush_GradientButtonCyan -->

            <!--<Color x:Key="EzBtn_BdColor">#FF132F54</Color>
            <SolidColorBrush x:Key="EzBtn_BdColor_Default" Color="#132F54" />
            <SolidColorBrush x:Key="EzBtn_BdColor_Disabled" Color="{StaticResource EzBtn_BdColor}" />
            <SolidColorBrush x:Key="EzBtn_BdColor_Hover" Color="{StaticResource EzBtn_BdColor}" />-->

            <!--<SolidColorBrush x:Key="EzBtn_Arrow_Default" Color="White" />-->
            <!--<SolidColorBrush x:Key="EzBtn_Arrow_Disabled" Color="#FFF5F6F7" />
            <SolidColorBrush x:Key="EzBtn_Arrow_Hover" Color="White" />-->
    
            <!-- #endregion EzBtn Theme -->        
            <Style x:Key="EzBtnStyle" TargetType="Border">
                <Setter Property="Width" Value="46" />
                <Setter Property="Height" Value="60" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="BorderBrush" Value="{DynamicResource EzBtn_BdColor_Default}" />
                <Setter Property="Background" Value="{DynamicResource EzBtn_BkColor_Default}" />
                <Setter Property="Effect" Value="{DynamicResource EzArrange_ShadowEffect}" />
                <!-- Removed, prevBtn and nextBtn will binding to different element
                <Style.Triggers>
                <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=Border}}"
                Value="False">
                <Setter Property="Background" Value="{StaticResource EzBtn_BkColor_Disabled}" />
                </DataTrigger>
                </Style.Triggers>
                -->
            </Style>

            <!-- Robert_Lin, 2024-7-6 Unused -->
            <!--
            <SolidColorBrush x:Key="SplitArrowBkColor" Color="#FF193457" />
            <SolidColorBrush x:Key="SplitArrowBdColor" Color="#FF132F54" />
            <SolidColorBrush x:Key="SplitArrowBkHoverColor" Color="#FF4F5967" />
            -->

            <!-- SplitListView Left/Right arrow path -->
            <SolidColorBrush x:Key="SplitArrowPathColor_Disabled" Color="#FF8996A6" />
            <SolidColorBrush x:Key="SplitArrowPathColor_Enabled" Color="White" />

            <!-- SplitListView Item Selected Border Color -->
            <LinearGradientBrush x:Key="SplitListViewItem_SelectedBdkColor" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#FF55B4FD" />
                <GradientStop Offset="1" Color="#FF5051DA" />
            </LinearGradientBrush>

            <!-- 
                <Setter Property="Width" Value="88" />
                <Setter Property="Height" Value="68" />
                <Setter Property="Focusable" Value="True"/>
                <Setter Property="KeyboardNavigation.IsTabStop" Value="True"/>
                <Setter Property="AutomationProperties.Name" Value="{Binding CustomName}"/>
            -->
            <Style x:Key="ContentControlStyle_SplitItem" TargetType="ContentControl">
                <Setter Property="Width" Value="88" />
                <Setter Property="Height" Value="68" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="KeyboardNavigation.TabNavigation" Value="Continue" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding DataContext.IsVertical, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                        <Setter Property="Width" Value="68"/>
                        <Setter Property="Height" Value="80"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- The style of prev and next navigation border -->
            <!-- Robert_Lin, 2024-7-6, Unused
            <Style x:Key="PrevNextBorderStyle" TargetType="Border">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="60" />
            <Setter Property="Background" Value="{StaticResource SplitArrowBkColor}" />
            <Setter Property="BorderBrush" Value="{StaticResource SplitArrowBdColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Effect">
            <Setter.Value>
            <DropShadowEffect BlurRadius="12" />
            </Setter.Value>
            </Setter>
            <Style.Triggers>
            <Trigger Property="IsMouseOver"  Value="True">
            <Setter Property="Background" Value="{StaticResource SplitArrowBkHoverColor}" />
            </Trigger>
            </Style.Triggers>
            </Style>
            -->
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- rootGrid
     KeyboardNavigation.TabNavigation="Continue"
    -->
    <Grid>
        <!-- Col0=prevBtn, Col2=nextBtn, Col1=Split items -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Robert_Lin, 2024-7-6, NEW, to fix UX team report issue: need to follow Figma design:
        1. Hover state color is not follow requirements
        2. Disable state arrow color is not follow requirements.
        3. The Linear Gradient brush direction is 100 degrees. (instead of 135)
        4. The button shadow effect need to follow requirements.
        -->
        <!-- prevBtn -->
        <Button Grid.Column="0" Name="prevButton"
                IsEnabled="{Binding IsPrevButtonEnabled}" Click="prevButton_Click"
                Focusable="True" KeyboardNavigation.IsTabStop="True" KeyboardNavigation.TabIndex="1"
                AutomationProperties.Name="{Binding [Left], Source={x:Static lang:LangHelper.Instance}}"
                AutomationProperties.IsOffscreenBehavior="Onscreen"
                >
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource StatelessButton}">
                    <Setter Property="AutomationProperties.ItemStatus" Value="Enabled"/>
                    <Setter Property="Opacity" Value="1"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                            <Setter Property="AutomationProperties.ItemStatus"
                                    Value="{Binding [RadiaMenu.1], Source={x:Static lang:LangHelper.Instance}}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsPrevButtonEnabled}" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <!-- 
                    IsEnabled="{Binding IsPrevButtonEnabled}">
            -->
            <Border Grid.Column="0" Name="prevBtn" 
                    >
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource EzBtnStyle}">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush_GradientButtonCyan}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsPrevButtonEnabled}" Value="False">
                                <Setter Property="Background" Value="{DynamicResource EzBtn_BkColor_Disabled}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource EzBtn_BdColor_Disabled}" />
                            </DataTrigger>
                         </Style.Triggers>
                    </Style>
                </Border.Style>
                <Viewbox Width="16" Height="16">
                    <Grid Width="16" Height="16">
                        <Path Name="ezBtnLeftArrow"
                          Data="M7.79 14.79L8.49 13.99L2.23 8.53004L16 8.53004L16 7.47004L2.23 7.47004L8.49 2.00004L7.79 1.20004L5.93601e-07 8.00004L7.79 14.79Z">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="{DynamicResource EzBtn_Arrow_Default}" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ElementName=prevButton, Path=IsMouseOver}" Value="True"/>
                                                <Condition Binding="{Binding IsPrevButtonEnabled}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.Setters>
                                                <Setter Property="Fill" Value="{DynamicResource EzBtn_Arrow_Hover}" />
                                            </MultiDataTrigger.Setters>
                                        </MultiDataTrigger>
                                        <!--<DataTrigger Binding="{Binding ElementName=prevButton, Path=IsMouseOver}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource EzBtn_Arrow_Hover}" />
                                        </DataTrigger>-->
                                        <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=Button}}"
                                                 Value="False">
                                            <Setter Property="Fill" Value="{DynamicResource EzBtn_Arrow_Disabled}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Grid>
                </Viewbox>
            </Border>
        </Button>
        <!-- nextBtn -->
        <!-- NEW for Narrator, change it as a Button -->
        <Button Grid.Column="2" Name="nextButton"
                IsEnabled="{Binding IsNexButtonEnabled}" Click="nextButton_Click"
                Focusable="True" KeyboardNavigation.IsTabStop="True" KeyboardNavigation.TabIndex="8"
                AutomationProperties.Name="{Binding [Right], Source={x:Static lang:LangHelper.Instance}}"
                AutomationProperties.IsOffscreenBehavior="Onscreen">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource StatelessButton}">
                    <Setter Property="AutomationProperties.ItemStatus" Value="Enabled"/>
                    <Setter Property="Opacity" Value="1"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                            <Setter Property="AutomationProperties.ItemStatus"
                                   Value="{Binding [RadiaMenu.1], Source={x:Static lang:LangHelper.Instance}}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsNextButtonEnabled}" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>

            <Border Name="nextBtn" IsEnabled="{Binding IsNextButtonEnabled}"
            >
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource EzBtnStyle}">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush_GradientButtonCyan}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsNextButtonEnabled}" Value="False">
                                <Setter Property="Background" Value="{DynamicResource EzBtn_BkColor_Disabled}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource EzBtn_BdColor_Disabled}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Viewbox Width="16" Height="16">
                    <Grid Width="16" Height="16">
                        <Path Name="ezBtnRightArrow"
                          Data="M8.21 1.20996L7.51 2.00996L13.77 7.46996H0V8.52996H13.77L7.51 14L8.21 14.8L16 7.99996L8.21 1.20996Z">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="{DynamicResource EzBtn_Arrow_Default}" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ElementName=nextBtn, Path=IsMouseOver}" Value="True"/>
                                                <Condition Binding="{Binding IsNextButtonEnabled}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.Setters>
                                                <Setter Property="Fill" Value="{DynamicResource EzBtn_Arrow_Hover}" />
                                            </MultiDataTrigger.Setters>
                                        </MultiDataTrigger>
                                        <!--<DataTrigger Binding="{Binding ElementName=nextButton, Path=IsMouseOver}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource EzBtn_Arrow_Hover}" />
                                        </DataTrigger>-->
                                        <DataTrigger Binding="{Binding ElementName=nextButton, Path=IsEnabled}" Value="False">
                                            <Setter Property="Fill" Value="{DynamicResource EzBtn_Arrow_Disabled}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Grid>
                </Viewbox>
            </Border>

        </Button>
        <!-- OLD:
        
        <Border Grid.Column="2" Name="nextBtn" IsEnabled="{Binding IsNextButtonEnabled}" MouseLeftButtonDown="nextBtn_MouseLeftButtonDown"
                                Focusable="True" KeyboardNavigation.IsTabStop="True" KeyboardNavigation.TabIndex="7"
        >
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource EzBtnStyle}">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                             <Setter Property="Background" Value="{DynamicResource Brush_GradientButtonCyan}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsNextButtonEnabled}" Value="False">
                            <Setter Property="Background" Value="{DynamicResource EzBtn_BkColor_Disabled}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource EzBtn_BdColor_Disabled}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Viewbox Width="16" Height="16">
                <Grid Width="16" Height="16">
                    <Path Name="ezBtnRightArrow"
                          Data="M8.21 1.20996L7.51 2.00996L13.77 7.46996H0V8.52996H13.77L7.51 14L8.21 14.8L16 7.99996L8.21 1.20996Z">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Fill" Value="{DynamicResource EzBtn_Arrow_Default}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=nextBtn, Path=IsMouseOver}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource EzBtn_Arrow_Hover}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ElementName=nextBtn, Path=IsEnabled}" Value="False">
                                        <Setter Property="Fill" Value="{DynamicResource EzBtn_Arrow_Disabled}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Grid>
            </Viewbox>
        </Border>
        -->

        <Grid Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ContentControl Grid.Column="0" Content="{Binding SplitItem0}" Style="{StaticResource ContentControlStyle_SplitItem}" KeyboardNavigation.TabIndex="2"/>
            <ContentControl Grid.Column="1" Content="{Binding SplitItem1}" Style="{StaticResource ContentControlStyle_SplitItem}" KeyboardNavigation.TabIndex="3"/>
            <ContentControl Grid.Column="2" Content="{Binding SplitItem2}" Style="{StaticResource ContentControlStyle_SplitItem}" KeyboardNavigation.TabIndex="4" />
            <ContentControl Grid.Column="3" Content="{Binding SplitItem3}" Style="{StaticResource ContentControlStyle_SplitItem}" KeyboardNavigation.TabIndex="5"/>
            <ContentControl Grid.Column="4" Content="{Binding SplitItem4}" Style="{StaticResource ContentControlStyle_SplitItem}" KeyboardNavigation.TabIndex="6" />

            <local:AddCustomLayoutButton x:Name="addButton" Grid.Column="{Binding AddButtonColumn}"
                                         Focusable="True" KeyboardNavigation.IsTabStop="True" KeyboardNavigation.TabIndex="7"
                                         HorizontalAlignment="Center" Margin="0,0,40,0">
                <local:AddCustomLayoutButton.Style>
                    <Style TargetType="local:AddCustomLayoutButton">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAddButtonVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </local:AddCustomLayoutButton.Style>
            </local:AddCustomLayoutButton>
        </Grid>
    </Grid>
</UserControl>