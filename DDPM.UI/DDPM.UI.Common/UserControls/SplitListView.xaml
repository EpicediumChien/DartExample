<UserControl x:Class="DDPM.UI.Common.UserControls.SplitListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DDPM.UI.Common.UserControls"
             mc:Ignorable="d"
             d:DesignHeight="64" d:DesignWidth="616">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DDPM.UI.Common;component/ModuleStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- EzBtn (Left/Right Arrow button) Colors -->
            <SolidColorBrush x:Key="EzBtn_BkColor_Default" Color="#FF193457" />
            <SolidColorBrush x:Key="EzBtn_BkColor_Disabled" Color="#FF596067" />
            <!-- EzBtn_BkColor_Hover: Use Brush_GradientButtonCyan -->

            <Color x:Key="EzBtn_BdColor">#FF132F54</Color>
            <SolidColorBrush x:Key="EzBtn_BdColor_Default" Color="{StaticResource EzBtn_BdColor}" />
            <SolidColorBrush x:Key="EzBtn_BdColor_Disabled" Color="{StaticResource EzBtn_BdColor}" />
            <SolidColorBrush x:Key="EzBtn_BdColor_Hover" Color="{StaticResource EzBtn_BdColor}" />

            <SolidColorBrush x:Key="EzBtn_Arrow_Default" Color="White" />
            <SolidColorBrush x:Key="EzBtn_Arrow_Disabled" Color="#FFF5F6F7" />
            <SolidColorBrush x:Key="EzBtn_Arrow_Hover" Color="White" />

            <Style x:Key="EzBtnStyle" TargetType="Border">
                <Setter Property="Width" Value="46" />
                <Setter Property="Height" Value="60" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="BorderBrush" Value="{StaticResource EzBtn_BdColor_Default}" />
                <Setter Property="Background" Value="{StaticResource EzBtn_BkColor_Default}" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="#7F000000" ShadowDepth="0" BlurRadius="12" Opacity="1" Direction="0" />
                    </Setter.Value>
                </Setter>
                <!-- Removed, prevBtn and nextBtn will binding to different element
                <Style.Triggers>
                <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=Border}}"
                Value="False">
                <Setter Property="Background" Value="{StaticResource EzBtn_BkColor_Disabled}" />
                </DataTrigger>
                </Style.Triggers>
                -->
            </Style>

            <!-- Robert_Lin, 2024-7-6 Unused -->
            <!--
            <SolidColorBrush x:Key="SplitArrowBkColor" Color="#FF193457" />
            <SolidColorBrush x:Key="SplitArrowBdColor" Color="#FF132F54" />
            <SolidColorBrush x:Key="SplitArrowBkHoverColor" Color="#FF4F5967" />
            -->

            <!-- SplitListView Left/Right arrow path -->
            <SolidColorBrush x:Key="SplitArrowPathColor_Disabled" Color="#FF8996A6" />
            <SolidColorBrush x:Key="SplitArrowPathColor_Enabled" Color="White" />

            <!-- SplitListView Item Selected Border Color -->
            <LinearGradientBrush x:Key="SplitListViewItem_SelectedBdkColor" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#FF55B4FD" />
                <GradientStop Offset="1" Color="#FF5051DA" />
            </LinearGradientBrush>

            <!-- 
                <Setter Property="Width" Value="88" />
                <Setter Property="Height" Value="68" />
            -->
            <Style x:Key="ContentControlStyle_SplitItem" TargetType="ContentControl">
                <Setter Property="Width" Value="88" />
                <Setter Property="Height" Value="68" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <!--
                <Setter Property="Template">
                <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                <Border BorderBrush="{StaticResource SplitListViewItem_SelectedBdkColor}"
                CornerRadius="6" Padding="4">
                <Border.Style>
                <Style TargetType="Border">
                <Setter Property="BorderThickness" Value="0" />
                <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="BorderThickness" Value="1.5" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="Yellow" />
                </Trigger>
                </Style.Triggers>
                </Style>
                </Border.Style>
                <ContentPresenter />
                </Border>
                </ControlTemplate>
                </Setter.Value>
                </Setter>
                -->
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsVertical}" Value="True">
                        <Setter Property="Width" Value="68"/>
                        <Setter Property="Height" Value="80"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- The style of prev and next navigation border -->
            <!-- Robert_Lin, 2024-7-6, Unused
            <Style x:Key="PrevNextBorderStyle" TargetType="Border">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="60" />
            <Setter Property="Background" Value="{StaticResource SplitArrowBkColor}" />
            <Setter Property="BorderBrush" Value="{StaticResource SplitArrowBdColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Effect">
            <Setter.Value>
            <DropShadowEffect BlurRadius="12" />
            </Setter.Value>
            </Setter>
            <Style.Triggers>
            <Trigger Property="IsMouseOver"  Value="True">
            <Setter Property="Background" Value="{StaticResource SplitArrowBkHoverColor}" />
            </Trigger>
            </Style.Triggers>
            </Style>
            -->
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- rootGrid -->
    <Grid>
        <!-- Col0=prevBtn, Col2=nextBtn, Col1=Split items -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- (Unused) Left, Prev Border
        <Border Grid.Column="0" Name="splitArrowPrev" Visibility="Collapsed"
        Style="{StaticResource PrevNextBorderStyle}"
        IsEnabled="{Binding IsPrevButtonEnabled}"
        MouseLeftButtonDown="splitArrowPrev_MouseLeftButtonDown">
        <Border.Effect>
        <DropShadowEffect BlurRadius="10" />
        </Border.Effect>

        <Viewbox Width="16" Height="16">
        <Grid Width="16" Height="16">
        <Path Name="splitLeftArrowPath"
        Data="M0,8 L7.77914,1.17791 L8.46626,2 L2.3313,7.5 L16,7.5 L16,8.5 L2.3313,8.5 L8.46626,14 L7.77914,14.7975 Z">
        <Path.Style>
        <Style TargetType="Path">
        <Setter Property="Fill" Value="{StaticResource SplitArrowPathColor_Enabled}" />
        <Style.Triggers>
        <DataTrigger Binding="{Binding ElementName=splitArrowPrev, Path=IsEnabled}" Value="False">
        <Setter Property="Fill" Value="{StaticResource SplitArrowPathColor_Disabled}" />
        </DataTrigger>
        </Style.Triggers>
        </Style>
        </Path.Style>
        </Path>
        </Grid>
        </Viewbox>
        </Border>
        -->
        <!-- (Unused)
        IsEnabled="{Binding IsNextButtonEnabled}"
        Width="46" Height="60" Background="{StaticResource SplitArrowBkColor}"
        BorderBrush="{StaticResource SplitArrowBdColor}" BorderThickness="1" CornerRadius="6"
        -->
        <!-- Robert_Lin, 2024-7-6, Unused
        <Border Grid.Column="2" Name="splitArrowNext" Visibility="Collapsed"
        Style="{StaticResource PrevNextBorderStyle}"
        IsEnabled="{Binding IsNextButtonEnabled}"
        MouseLeftButtonDown="splitArrowNext_MouseLeftButtonDown">
        <Border.Effect>
        <DropShadowEffect Color="#7F000000" ShadowDepth="0" BlurRadius="12" Opacity="1" Direction="0" />
        </Border.Effect>

        <Viewbox Width="16" Height="16">
        <Grid Width="16" Height="16">
        <Path Name="splitRightArrowPath"
        Data="M0,7.5 L13.7548,7.5 L7.50968,2 L8.20645,1.2129 L16,8 L8.20645,14.8387 L7.48387,14 L13.7806,8.5 L0,8.5 Z"
        Fill="{StaticResource SplitArrowPathColor_Enabled}">
        <Path.Style>
        <Style TargetType="Path">
        <Setter Property="Fill" Value="{StaticResource SplitArrowPathColor_Enabled}" />
        <Style.Triggers>
        <DataTrigger Binding="{Binding ElementName=splitArrowNext, Path=IsEnabled}" Value="False">
        <Setter Property="Fill" Value="{StaticResource SplitArrowPathColor_Disabled}" />
        </DataTrigger>
        </Style.Triggers>
        </Style>
        </Path.Style>
        </Path>
        </Grid>
        </Viewbox>
        </Border>        -->

        <!-- Robert_Lin, 2024-7-6, NEW, to fix UX team report issue: need to follow Figma design:
        1. Hover state color is not follow requirements
        2. Disable state arrow color is not follow requirements.
        3. The Linear Gradient brush direction is 100 degrees. (instead of 135)
        4. The button shadow effect need to follow requirements.
        -->
        <!-- prevBtn -->
        <Border Grid.Column="0" Name="prevBtn" IsEnabled="{Binding IsPrevButtonEnabled}"
                MouseLeftButtonDown="prevBtn_MouseLeftButtonDown">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource EzBtnStyle}">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <!--
                            <Setter Property="Background" Value="{StaticResource EzBtn_BkColor_Hover}" />
                            -->
                            <Setter Property="Background" Value="{StaticResource Brush_GradientButtonCyan}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsPrevButtonEnabled}" Value="False">
                            <Setter Property="Background" Value="{StaticResource EzBtn_BkColor_Disabled}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Viewbox Width="16" Height="16">
                <Grid Width="16" Height="16">
                    <Path Name="ezBtnLeftArrow"
                          Data="M7.79 14.79L8.49 13.99L2.23 8.53004L16 8.53004L16 7.47004L2.23 7.47004L8.49 2.00004L7.79 1.20004L5.93601e-07 8.00004L7.79 14.79Z">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Fill" Value="{StaticResource EzBtn_Arrow_Default}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=prevBtn, Path=IsMouseOver}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource EzBtn_Arrow_Hover}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=Border}}"
                                                 Value="False">
                                        <Setter Property="Fill" Value="{StaticResource EzBtn_Arrow_Disabled}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Grid>
            </Viewbox>
        </Border>
        <!-- nextBtn -->
        <Border Grid.Column="2" Name="nextBtn" IsEnabled="{Binding IsNextButtonEnabled}" MouseLeftButtonDown="nextBtn_MouseLeftButtonDown">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource EzBtnStyle}">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <!--
                            <Setter Property="Background" Value="{StaticResource EzBtn_BkColor_Hover}" />
                            -->
                            <Setter Property="Background" Value="{StaticResource Brush_GradientButtonCyan}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsNextButtonEnabled}" Value="False">
                            <Setter Property="Background" Value="{StaticResource EzBtn_BkColor_Disabled}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Viewbox Width="16" Height="16">
                <Grid Width="16" Height="16">
                    <Path Name="ezBtnRightArrow"
                          Data="M8.21 1.20996L7.51 2.00996L13.77 7.46996H0V8.52996H13.77L7.51 14L8.21 14.8L16 7.99996L8.21 1.20996Z">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Fill" Value="{StaticResource EzBtn_Arrow_Default}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=nextBtn, Path=IsMouseOver}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource EzBtn_Arrow_Hover}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ElementName=nextBtn, Path=IsEnabled}" Value="False">
                                        <Setter Property="Fill" Value="{StaticResource EzBtn_Arrow_Disabled}" />
                                    </DataTrigger>
                                    <!--
                                    <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=Border}}"
                                    Value="False">
                                    <Setter Property="Fill" Value="{StaticResource EzBtn_Arrow_Disabled}" />
                                    </DataTrigger>
                                    -->
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Grid>
            </Viewbox>
        </Border>

        <Grid Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ContentControl Grid.Column="0" Content="{Binding SplitItem0}" Style="{StaticResource ContentControlStyle_SplitItem}" />
            <ContentControl Grid.Column="1" Content="{Binding SplitItem1}" Style="{StaticResource ContentControlStyle_SplitItem}" />
            <ContentControl Grid.Column="2" Content="{Binding SplitItem2}" Style="{StaticResource ContentControlStyle_SplitItem}" />
            <ContentControl Grid.Column="3" Content="{Binding SplitItem3}" Style="{StaticResource ContentControlStyle_SplitItem}" />
            <ContentControl Grid.Column="4" Content="{Binding SplitItem4}" Style="{StaticResource ContentControlStyle_SplitItem}" />
        </Grid>
    </Grid>
</UserControl>