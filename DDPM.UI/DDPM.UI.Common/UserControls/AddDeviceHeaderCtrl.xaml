              <Path Data="M0.5 9.43705V12.5872C0.5 14.4641 2.03569 15.9998 3.91263 15.9998C5.78958 15.9998 7.32527 14.4641 7.32527 12.5872C7.32527 12.5609 7.31214 9.67331 7.29902 9.05641C7.01025 9.42392 6.60336 9.79144 6.13085 10.0802V12.5872C6.13085 13.8078 5.13331 14.7923 3.92576 14.7923C2.71821 14.7923 1.72067 13.7947 1.72067 12.5872V9.43705C1.72067 8.21637 2.71821 7.23196 3.92576 7.23196C4.26702 7.23196 4.60829 7.32384 4.9758 7.53385C5.22518 7.25821 5.36957 6.91695 5.36957 6.56256V6.3788C4.8708 6.14254 4.39828 6.02441 3.92576 6.02441C3.25636 6.02441 2.62633 6.24755 1.98318 6.72007C1.85193 6.82507 1.72067 6.91695 1.61567 7.02195C1.61567 7.02195 1.60254 7.03508 1.58942 7.0482C1.48441 7.15321 1.37941 7.25821 1.28753 7.37634C0.775636 8.01949 0.513126 8.71514 0.513126 9.45017L0.5 9.43705Z"
                                  Fill="{Binding Tag, RelativeSource={RelativeSource AncestorType=Canvas}}" />
            </Canvas>
            <TextBlock Text="{Binding Text2, Mode=TwoWay}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" 
                                   Focusable="True" KeyboardNavigation.TabIndex="22"
                                   TextTrimming="WordEllipsis" x:Name="header1Text" MaxWidth="150">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource DefaultTheme_TxtColor}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding InternalSelectedIndex}" Value="1">
                      <Setter Property="Foreground" Value="#FFFFFF" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
          <!--<Border.Style>
            <Style TargetType="Border">
              <Setter Property="Background" Value="Transparent" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding InternalSelectedIndex}" Value="1">
                  <Setter Property="Background" Value="{StaticResource RightView_Header_HiColor}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>-->
        </Border>


        <!-- Header[2] -->
        <Border Name="header2Border" Grid.Column="2" CornerRadius="0,4,4,0" MouseLeftButtonDown="header2_MouseLeftButtonDown"
                      Focusable="False" PreviewKeyDown="header2_PreviewKeyDown" MouseEnter="HeaderBorder_MouseEnter" MouseLeave="HeaderBorder_MouseLeave" Tag="2">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Canvas Name="Canvas1" Width="17" Height="16" Margin="0,0,5,0" >
              <Canvas.Style>
                <Style TargetType="Canvas">
                  <Setter Property="Tag" Value="{DynamicResource DefaultTheme_PathColor}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding InternalSelectedIndex}" Value="2">
