<UserControl x:Class="DDPM.UI.Common.AddDeviceHeaderCtrl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DDPM.UI.Common" xmlns:common="clr-namespace:DDPM.Easy.Common;assembly=DDPM.Easy.Common" d:DataContext="{d:DesignInstance Type=common:SplitCtrlVM}"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Visibility="{Binding CtrlVisibility}"
             SizeChanged="UserControl_SizeChanged" >
  <!-- 
              Focusable="True" KeyboardNavigation.TabNavigation="Continue" 
   
    -->

  <Grid>
    <Border Grid.Row="0" CornerRadius="4" Background="{DynamicResource RightView_Header_BkColor}" Height="30" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="{Binding Col1Width}" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Header[0] -->
        <Border Name ="header0Border" Grid.Column="0" CornerRadius="4,0,0,4" MouseLeftButtonDown="header0_MouseLeftButtonDown"
                        Focusable="False" PreviewKeyDown="header0_PreviewKeyDown" MouseEnter="HeaderBorder_MouseEnter" MouseLeave="HeaderBorder_MouseLeave" Tag="0">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Canvas Width="16" Height="16" Margin="0,0,5,0">
              <Canvas.Style>
                <Style TargetType="Canvas">
                  <Setter Property="Tag" Value="{DynamicResource DefaultTheme_PathColor}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding InternalSelectedIndex}" Value="0">
                      <Setter Property="Tag" Value="#FFFFFF" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Canvas.Style>
              <Path Data="M8 15.9498V9.3998L5.2 11.9998L4.5 11.2998L8 8.0498V7.9498L4.5 4.6998L5.2 3.9998L8 6.5998V0.0498047L12.85 4.8998L9.5 7.9998L12.85 11.0998L8 15.9498ZM9 8.8998V13.5498L11.4 11.1498L9 8.8998ZM9 2.4498V7.0998L11.4 4.8498L9 2.4498Z" 
                                  Fill="{Binding Tag, RelativeSource={RelativeSource AncestorType=Canvas}}" >
              </Path>
            </Canvas>
            <TextBlock Name="header0Text" Text="{Binding Text1, Mode=TwoWay}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"
                                   Focusable="True" KeyboardNavigation.TabIndex="21">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource DefaultTheme_TxtColor}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding InternalSelectedIndex}" Value="0">
                      <Setter Property="Foreground" Value="#FFFFFF" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
          <!--<Border.Style>
            <Style TargetType="Border">
              <Setter Property="Background" Value="Transparent" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding InternalSelectedIndex}" Value="0">
                  <Setter Property="Background" Value="{StaticResource RightView_Header_HiColor}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>-->
        </Border>

        <!-- Header[1] -->
        <Border Grid.Column="1" CornerRadius="0,0,0,0" MouseLeftButtonDown="header1_MouseLeftButtonDown" x:Name="header1Border"
                        Focusable="False" PreviewKeyDown="header1_PreviewKeyDown" MouseEnter="HeaderBorder_MouseEnter" MouseLeave="HeaderBorder_MouseLeave" Tag="1">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" x:Name="header1SP">
            <Canvas Width="8" Height="16" Margin="0,0,5,0">
              <Canvas.Style>
                <Style TargetType="Canvas">
                  <Setter Property="Tag" Value="{DynamicResource DefaultTheme_PathColor}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding InternalSelectedIndex}" Value="1">
                      <Setter Property="Tag" Value="#FFFFFF" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Canvas.Style>
