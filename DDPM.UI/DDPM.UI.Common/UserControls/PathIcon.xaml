<UserControl x:Class="DDPM.UI.Common.UserControls.PathIcon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DDPM.UI.Common.UserControls"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             Width="32" Height="32"
             d:DesignHeight="32" d:DesignWidth="32" 
             
             PreviewKeyDown="UserControl_PreviewKeyDown" MouseLeftButtonDown="UserControl_MouseLeftButtonDowm">
    <!-- 
    KeyboardNavigation.TabNavigation="None"
    -->
    
    <UserControl.Resources>
        <ResourceDictionary>
            <!-- Style to hide tool tips that have an empty content. -->
            <Style TargetType="ToolTip">
                <Style.Triggers>
                    <Trigger Property="Content" Value="{x:Static sys:String.Empty}">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Trigger>
                    <Trigger Property="Content" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Robert_Lin, 2024-8-2, DDPMW-579, Breathe & glow effect -->
            <!-- It will be triggered (Start/Stop) from code behind, in PathIcon.xaml.cs
            To start the Storyboard:
            Storyboard _storyboard = Resource["glowAnimation"] as Storyboard; //or use TryFindResource( )
            _storyboard.Begin(indication); //where "indication" is the name of "Border" contains the indication
            indication.Visibility = Visibility.Visible;
            To stop the Storyboard:
            indication.Visibility = Visibility.Collapsed;
            _storyboard.Stop();
            -->
            <!-- Robert_Lin, 2024-12-9, PIMS-299696
                 Gear icon indication blinking not only twice to show availability of FW update.
            Expected Blinking story: When a trigget event comming:
            Time (sec) 0  0.5  1.0 1.5 2.0       
            Opacity    1-> 0 -> 1-> 0 ->1 -> 1 ....
            -->
            <Storyboard x:Key="glowAnimation" >
                <DoubleAnimation Storyboard.TargetProperty="(Border.Opacity)" 
                                                       From="1" To="0" Duration="0:0:0.5"/>
                <DoubleAnimation Storyboard.TargetProperty="(Border.Opacity)" 
                                                       BeginTime="0:0:0.5"
                                                       From="0" To="1" Duration="0:0:0.5"/>
                <DoubleAnimation Storyboard.TargetProperty="(Border.Opacity)" 
                                                        BeginTime="0:0:1"
                                                      From="1" To="0" Duration="0:0:0.5"/>
                <DoubleAnimation Storyboard.TargetProperty="(Border.Opacity)" 
                                                       BeginTime="0:0:1.5"
                                                       From="0" To="1" Duration="0:0:0.5"/>
            </Storyboard>
            <!-- OLD: 
            <Storyboard x:Key="glowAnimation" RepeatBehavior="Forever">
                <DoubleAnimation Storyboard.TargetProperty="(Border.Opacity)"
                                 From="1" To="0" Duration="0:0:2" />
                <DoubleAnimation Storyboard.TargetProperty="(Border.Opacity)"
                                 BeginTime="0:0:2" From="0" To="1" Duration="0:0:2" />
            </Storyboard>
            -->
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="Path_Grid" MouseLeftButtonUp="Path_MouseLeftButtonDown">
        <!-- Make hover state -->
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Background" Value="{DynamicResource FakeTransparent}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource MouseHover_BkColor}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>

