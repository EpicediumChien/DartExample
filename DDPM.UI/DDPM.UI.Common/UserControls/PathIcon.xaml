<UserControl x:Class="DDPM.UI.Common.UserControls.PathIcon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DDPM.UI.Common.UserControls"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             Width="32" Height="32"
             IsTabStop="True"
             d:DesignHeight="32" d:DesignWidth="32">
    <UserControl.Resources>
        <ResourceDictionary>
            <!-- Style to hide tool tips that have an empty content. -->
            <Style TargetType="ToolTip">
                <Style.Triggers>
                    <Trigger Property="Content" Value="{x:Static sys:String.Empty}">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Trigger>
                    <Trigger Property="Content" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Robert_Lin, 2024-8-2, DDPMW-579, Breathe & glow effect -->
            <!-- It will be triggered (Start/Stop) from code behind, in PathIcon.xaml.cs
            To start the Storyboard:
            Storyboard _storyboard = Resource["glowAnimation"] as Storyboard; //or use TryFindResource( )
            _storyboard.Begin(indication); //where "indication" is the name of "Border" contains the indication
            indication.Visibility = Visibility.Visible;
            To stop the Storyboard:
            indication.Visibility = Visibility.Collapsed;
            _storyboard.Stop();
            -->
            <Storyboard x:Key="glowAnimation" RepeatBehavior="Forever">
                <DoubleAnimation Storyboard.TargetProperty="(Border.Opacity)"
                                 From="1" To="0" Duration="0:0:2" />
                <DoubleAnimation Storyboard.TargetProperty="(Border.Opacity)"
                                 BeginTime="0:0:2" From="0" To="1" Duration="0:0:2" />
            </Storyboard>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="Path_Grid" MouseLeftButtonUp="Path_MouseLeftButtonDown">
        <!-- Make hover state -->
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Background" Value="{DynamicResource FakeTransparent}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource MouseHover_BkColor}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>

        <Path x:Name="TitleBarPathIcon" Data="{Binding Path=PathData, RelativeSource={RelativeSource AncestorType=UserControl}}"
              HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Robert_Lin, 2024-8-2 Add Disabled state -->
            <!--<Path.Fill>
                <Binding Path="IsMouseOver" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type Grid}}" Converter="{StaticResource PathIconColorConverter}"/>
            </Path.Fill>-->
            <Path.Style>
                <Style TargetType="Path">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="Fill" Value="{DynamicResource PathIcon_Color}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Path.Style>

            <!--
            <Path.ToolTip>
            <ToolTip>
            <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
            <Border.Resources>
            <Style TargetType="TextBlock" BasedOn="{StaticResource Tooltip_TextBlockStyle}" />
            </Border.Resources>

            <TextBlock Text="{Binding TooltipText, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            </Border>
            </ToolTip>
            </Path.ToolTip>
            -->
        </Path>

        <!-- Layer when it get the keyboard focused -->
        <Path Data="{Binding Path=PathData, RelativeSource={RelativeSource AncestorType=UserControl}}"
              Fill="#FF0077C0"
              HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Robert_Lin, 2024-8-2 Add Disabled state -->
            <Path.Style>
                <Style TargetType="Path">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Path.Style>
        </Path>

        <!-- Robert_Lin, 2024-8-2 Add a breathe & glows Animation -->
        <Border Name="indication" Width="6" Height="6" CornerRadius="3" Background="#E67F01"
                HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,10,0,0"
                Visibility="Collapsed">
        </Border>
    </Grid>
</UserControl>