<UserControl x:Class="DDPM.UI.Common.EAEM.SplitCtrl5A"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DDPM.UI.Common.EAEM"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SplitStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource SplitCtrl_OutterBorder}">
        <Grid Name="g0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Name="g1" Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Name="cell_5A1" Grid.Column="0" BorderBrush="{StaticResource BorderColor_SplitNormal}" BorderThickness="0" />

                <Border Name="cell_5A2" Grid.Column="2" BorderBrush="{StaticResource BorderColor_SplitNormal}" BorderThickness="0" />

                <Border Name="cell_5A3" Grid.Column="4" BorderBrush="{StaticResource BorderColor_SplitNormal}" BorderThickness="0" />

                <Rectangle Name="v1" Grid.Column="1"
                           Width="{StaticResource ThickSplitter}"
                           Style="{StaticResource RectangleStyle_Splitter}" />
                <Rectangle Name="v2" Grid.Column="3"
                           Width="{StaticResource ThickSplitter}"
                           Style="{StaticResource RectangleStyle_Splitter}" />
            </Grid>

            <Grid Name="g2" Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Name="cell_5A4" Grid.Column="0" BorderBrush="{StaticResource BorderColor_SplitNormal}" BorderThickness="0" />

                <Border Name="cell_5A5" Grid.Column="2" BorderBrush="{StaticResource BorderColor_SplitNormal}" BorderThickness="0" />

                <Rectangle Name="v3" Grid.Column="1"
                           Width="{StaticResource ThickSplitter}"
                           Style="{StaticResource RectangleStyle_Splitter}" />
            </Grid>

            <Rectangle Name="h1" Grid.Row="1"
                       Height="{StaticResource ThickSplitter}"
                       Style="{StaticResource RectangleStyle_Splitter}" />
        </Grid>
    </Border>
</UserControl>