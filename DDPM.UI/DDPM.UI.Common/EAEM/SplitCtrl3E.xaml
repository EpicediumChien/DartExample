<UserControl x:Class="DDPM.UI.Common.EAEM.SplitCtrl3E"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DDPM.UI.Common.EAEM"
             mc:Ignorable="d"
             d:Background="Black"
             d:DesignHeight="60" d:DesignWidth="80">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SplitStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource SplitCtrl_OutterBorder}">

        <Grid Name="g0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.Resources>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource FakeTransparent}"/>
                </Style>
            </Grid.Resources>

            <Border Name="cell_3e1" Grid.Column="0" Grid.Row="0" Grid.RowSpan="3" BorderBrush="{DynamicResource SplitSplitter_Icon}" />
            <Border Name="cell_3e2" Grid.Column="2" Grid.Row="0" BorderBrush="{DynamicResource SplitSplitter_Icon}" />
            <Border Name="cell_3e3" Grid.Column="2" Grid.Row="2" BorderBrush="{DynamicResource SplitSplitter_Icon}" />

            <Rectangle Name="v1" Grid.Column="1" Grid.Row="0" Grid.RowSpan="3"
                       Width="{StaticResource ThickSplitter}"
                       Style="{StaticResource RectangleStyle_Splitter}" />
            <Rectangle Name="h1" Grid.Column="2" Grid.Row="1"
                       Height="{StaticResource ThickSplitter}"
                       Style="{StaticResource RectangleStyle_Splitter}" />
        </Grid>
    </Border>
</UserControl>