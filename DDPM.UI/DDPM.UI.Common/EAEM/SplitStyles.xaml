<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- #region Key Resource for Theme -->
    <!--<SolidColorBrush x:Key="SplitItem_BkColor" Color="#FF132F54" />-->
    <SolidColorBrush x:Key="BorderColor_SplitNormal" Color="#FFF2F2F2" />

    <!-- #endregion Key Resource for Theme -->
    
    <SolidColorBrush x:Key="FakeTransparent" Color="#02000000" />
    <SolidColorBrush x:Key="SplitItem_NormalBdColor" Color="#02000000" />
    <SolidColorBrush x:Key="SplitItem_SelectedColor" Color="#FF5CC1EE" />

    <!-- Splitter -->
    <Style x:Key="RectangleStyle_Splitter" TargetType="Rectangle">
        <Setter Property="Fill" Value="{DynamicResource SplitSplitter_Icon}" />
    </Style>

    <sys:Double x:Key="ThickSplitter">1</sys:Double>

    <sys:Double x:Key="SplitItem_bdThick">1</sys:Double>
    <Thickness x:Key="SplitItem_bdThickness"
               Left="{StaticResource SplitItem_bdThick}"
               Top="{StaticResource SplitItem_bdThick}"
               Right="{StaticResource SplitItem_bdThick}"
               Bottom="{StaticResource SplitItem_bdThick}" />

    <sys:Double x:Key="SplitItem_BdRadius">3</sys:Double>
    <CornerRadius x:Key="SplitItem_CornerRadius"
                  TopLeft="{StaticResource SplitItem_BdRadius}"
                  TopRight="{StaticResource SplitItem_BdRadius}"
                  BottomRight="{StaticResource SplitItem_BdRadius}"
                  BottomLeft="{StaticResource SplitItem_BdRadius}" />

    <Style x:Key="SplitCtrl_OutterBorder" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource SplitSplitter_Icon}" />
        <Setter Property="BorderThickness" Value="{StaticResource SplitItem_bdThickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource SplitItem_CornerRadius}" />
    </Style>
</ResourceDictionary>