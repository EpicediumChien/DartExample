<UserControl x:Class="DDPM.UI.Common.EAEM.SplitCtrl4D"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DDPM.UI.Common.EAEM"
             mc:Ignorable="d"
             d:Background="Black"
             d:DesignHeight="60" d:DesignWidth="80">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SplitStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource SplitCtrl_OutterBorder}">

        <Grid Name="g0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.Resources>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource FakeTransparent}"/>
                </Style>
            </Grid.Resources>

            <Border Name="cell_4d1" Grid.Column="0" BorderBrush="{DynamicResource SplitSplitter_Icon}" />
            <Border Name="cell_4d2" Grid.Column="2" BorderBrush="{DynamicResource SplitSplitter_Icon}" />

            <Border Name="cell_4d3" Grid.Column="4" BorderBrush="{DynamicResource SplitSplitter_Icon}" />

            <Border Name="cell_4d4" Grid.Column="6" BorderBrush="{DynamicResource SplitSplitter_Icon}" />

            <Rectangle Name="v1" Grid.Column="1"
                       Width="{StaticResource ThickSplitter}"
                       Style="{StaticResource RectangleStyle_Splitter}" />
            <Rectangle Name="v2" Grid.Column="3"
                       Width="{StaticResource ThickSplitter}"
                       Style="{StaticResource RectangleStyle_Splitter}" />
            <Rectangle Name="v3" Grid.Column="5"
                       Width="{StaticResource ThickSplitter}"
                       Style="{StaticResource RectangleStyle_Splitter}" />
        </Grid>
    </Border>
</UserControl>