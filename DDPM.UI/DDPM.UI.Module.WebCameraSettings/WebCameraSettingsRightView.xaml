                        </Grid>
                      </Border>
                      <Border Grid.Column="1" BorderThickness="2" CornerRadius="5" Focusable="True" MouseLeftButtonDown="Priority_FrameRate_Button_Click" Height="30">
                        <Border.Style>
                          <Style TargetType="Border" BasedOn="{StaticResource Border_Test}">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Priority_IsSelected[1]}"  Value="True">
                                <Setter Property="Background"  Value="{StaticResource VbarItem_HiBkColor}" />
                                <Setter Property="BorderBrush" Value="{StaticResource VbarItem_HiBdColor}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <Grid>
                          <UXControls:UXTextBlock Text="{Binding [WebCameraSettings.21], Source={x:Static lang:LangHelper.Instance}}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" AutomationProperties.Name="Primary1" />
                        </Grid>
                      </Border>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,7">
                      <Grid>
                        <Border Width="406" Height="73" CornerRadius="5" Background="#364861">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="38" />
                              <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="7" />
                                <ColumnDefinition />
                              </Grid.ColumnDefinitions>
                              <Border Grid.Column="0" CornerRadius="5,0,0,5" Background="#E67F01" Width="7" />
                              <Image Grid.Column="1" Width="18" Height="15" Margin="5,0,0,0" Source="/DDPM.UI.Common;component/Resources/Warring_Whit.png" />
                            </Grid>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                              <TextBlock Foreground="White" FontSize="13">
                                                            <Run Text="{Binding [WebCameraSettings.22], Source={x:Static lang:LangHelper.Instance},Mode=OneWay}" />
                                                            <Hyperlink Click="Hyperlink_Click">
                                                                <Hyperlink.Style><Style TargetType="Hyperlink">
                                                                        <Style.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter Property="Foreground" Value="#31A2E3" />
                                                                            </Trigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Hyperlink.Style>
                                                                <Run Text="{Binding [WebCameraSettings.23], Source={x:Static lang:LangHelper.Instance},Mode=OneWay}" />
                                                            </Hyperlink>
                                                            <Run Text="{Binding [WebCameraSettings.24], Source={x:Static lang:LangHelper.Instance},Mode=OneWay}" />
                              </TextBlock>
                            </StackPanel>
                          </Grid>
                        </Border>
                      </Grid>
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </Border>
