<UserControl x:Class="DDPM.UI.Module.WebCameraSettings.WebCameraSettingsRightView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             xmlns:plugin="clr-namespace:DDPM.UI.Plugin.ViewModels;assembly=DDPM.UI.Plugin.Common"
             xmlns:PluginCommon="clr-namespace:DDPM.UI.Plugin.Common;assembly=DDPM.UI.Plugin.Common"
             d:DataContext="{d:DesignInstance Type=plugin:WebCameraViewModel}"
             xmlns:common="clr-namespace:DDPM.UI.Common;assembly=DDPM.UI.Common"
             xmlns:lang="clr-namespace:DDPM.UI.Resources.Helper;assembly=DDPM.UI.Resources"
             mc:Ignorable="d"
             d:DesignHeight="675" d:DesignWidth="554" Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <PluginCommon:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <PluginCommon:ThicknessConverter x:Key="MarginConverter" />
            <PluginCommon:BooleanToInverseConverter x:Key="BooleanToInverseConverter" />
            <PluginCommon:CenterToolTipConverter x:Key="CenterToolTipConverter" />
            <PluginCommon:HeightConverter x:Key="HeightConverter" />
            <Style x:Key="TextBlockStyle1" TargetType="{x:Type UXControls:UXTextBlock}">
                <Setter Property="Foreground" Value="#FFFFFF" />
                <Setter Property="FontFamily" Value="Roboto" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="Medium" />
            </Style>
            <Style x:Key="ToggleSwitch1" TargetType="{x:Type UXControls:UXToggleSwitch}">
                <Setter Property="Foreground" Value="#FFFFFF" />
                <Setter Property="FontFamily" Value="Roboto" />
                <Setter Property="FontSize" Value="16" />
            </Style>
            <Style x:Key="DisableToolTipStyle" TargetType="ToolTip" BasedOn="{StaticResource InfoToolTipStyle}">
                <Setter Property="Placement" Value="Top" />
                <Setter Property="VerticalOffset" Value="45" />
                <Setter Property="HorizontalOffset">
                    <Setter.Value>
                        <MultiBinding Converter="{StaticResource CenterToolTipConverter}">
                            <Binding RelativeSource="{RelativeSource Self}" Path="PlacementTarget.ActualWidth" />
                            <Binding RelativeSource="{RelativeSource Self}" Path="ActualWidth" />
                        </MultiBinding>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <!--Elsa 20250331 for PIMS-348388 change Width="470" to Width="auto",change Margin="0,0,0,15" to Margin="0,0,6,16"-->
    <Grid Margin="0,0,6,16">
        <Border CornerRadius="13" Margin="0,10,10,0" Width="auto">
            <Border.Height>
                <MultiBinding Converter="{StaticResource HeightConverter}">
                    <Binding Path="Height" RelativeSource="{RelativeSource AncestorType=Grid}" />
                </MultiBinding>
            </Border.Height>
            <StackPanel Margin="16,16,2,0" Orientation="Vertical">
                <Grid>
                    <UXControls:UXTextBlock Margin="0,10,0,6" Text="{Binding [WebCameraSettings.0], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource ModuleCaptionStyle}" />

                    <Border Margin="0,0,67,0" Background="{StaticResource Webcam_UndoRedo_DisableBkColor}" HorizontalAlignment="Right" Width="40" Height="40" Visibility="{Binding Undo2Visibility}">
                        <ContentControl Template="{StaticResource icon_Undo}" Foreground="{DynamicResource Webcam_UndoRedo_DisableFgColor}"
                                        HorizontalAlignment="Center" VerticalContentAlignment="Center"/>
                    </Border>

                    <Border Margin="0,0,17,0" Background="{StaticResource Webcam_UndoRedo_DisableBkColor}" HorizontalAlignment="Right" Width="40" Height="40" Visibility="{Binding Redo2Visibility}">
                        <ContentControl Template="{StaticResource icon_Redo}" Foreground="{DynamicResource Webcam_UndoRedo_DisableFgColor}"
                                        HorizontalAlignment="Center" VerticalContentAlignment="Center"/>
                    </Border>

                    <Border Margin="0,0,67,0" Background="{DynamicResource Webcam_UndoRedo_BkColor}" HorizontalAlignment="Right" Width="40" Height="40" Visibility="{Binding UndoVisibility}"
                            MouseLeftButtonDown="Image_MouseLeftButtonDown" Tag="0" Cursor="Hand">
                        <ContentControl Template="{StaticResource icon_Undo}" Foreground="{DynamicResource DefaultTheme_PathColor}"
                                        HorizontalAlignment="Center" VerticalContentAlignment="Center"/>
                    </Border>

                    <Border Margin="0,0,17,0" Background="{DynamicResource Webcam_UndoRedo_BkColor}" HorizontalAlignment="Right" Width="40" Height="40" Visibility="{Binding RedoVisibility}"
                            MouseLeftButtonDown="Image_MouseLeftButtonDown" Tag="1" Cursor="Hand">
                        <ContentControl Template="{StaticResource icon_Redo}" Foreground="{DynamicResource DefaultTheme_PathColor}"
                                        HorizontalAlignment="Center" VerticalContentAlignment="Center"/>
                    </Border>
                </Grid>
                <DockPanel Margin="0,16,0,4000">
                    <DockPanel.Height>
                        <MultiBinding Converter="{StaticResource HeightConverter}" ConverterParameter="85">
                            <Binding Path="ActualHeight" RelativeSource="{RelativeSource AncestorType=Border, AncestorLevel=1}" />
                        </MultiBinding>
                    </DockPanel.Height>
                    <!--20250410 Chewlin Fix Gradient showing when content is too long issue ADD UseFadingScrolling="False" -->
                    <UXControls:UXScrollViewer UseFadingScrolling="False">
                        <StackPanel>
                            <Border Name="bdrAlert1" Background="#364861" CornerRadius="4" Margin="0,0,0,15" BorderThickness="7,0,0,0" BorderBrush="#0E92F2" Visibility="{Binding MessageBoxVisibility}"
>
                                <StackPanel Orientation="Horizontal">
                                    <ContentControl Template="{StaticResource icon_Info}" Margin="10,0,0,0" Width="18" Height="18" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                    <UXControls:UXTextBlock Name="txtMessage" FontSize="13" Background="#364861" Foreground="#F5F6F7" TextWrapping="Wrap" Width="362" 
                                          Text="{Binding [Camera.13], Source={x:Static lang:LangHelper.Instance}}"
                                          VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5,15,0,13" LineHeight="21" Padding="2,3,10,2">
                                    </UXControls:UXTextBlock>
                                    <Image x:Name="CloseIcon" Source="/DDPM.UI.Common;component/Resources/Close.png" Stretch="Fill" Focusable="True"
                         VerticalAlignment="Center" HorizontalAlignment="Right" Width="15" Height="15" MouseLeftButtonDown="CloseMessageBox" Cursor="Hand">
                                    </Image>
                                </StackPanel>
                            </Border>
                            <Border CornerRadius="6" Visibility="{Binding BackgroundBlurVisibility}">
                                <StackPanel Orientation="Vertical">
                                    <Grid Margin="16,25,16,0">
                                        <StackPanel Orientation="Horizontal">
                                            <!-- Derek for PIMS-332102 -->
                                            <UXControls:UXTextBlock MaxWidth="270" TextTrimming="CharacterEllipsis" Text="{Binding [WebCameraSettings.28], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource ModuleItemStyle}" />
                                            <Border ToolTipService.Placement="Left" Background="{StaticResource FakeTransparent}">
                                                <ContentControl Template="{StaticResource icon_Info}" Margin="10,0,0,0" Width="18" Height="18" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                                <Border.ToolTip>
                                                    <ToolTip Placement="Bottom" VerticalOffset="15" HorizontalOffset="220">
                                                        <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                                            <TextBlock Text="{Binding [WebCameraSettings.29], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource Tooltip_TextBlockStyle}" MaxWidth="350" TextWrapping="Wrap" Padding="5,0,5,0" />
                                                        </Border>
                                                    </ToolTip>
                                                </Border.ToolTip>
                                            </Border>
                                        </StackPanel>
                                        <UXControls:UXToggleSwitch Click="BgBlurSwitch_Click" IsChecked="{Binding Path= IsBgBlurOn}" Content="{Binding Path=IsBgBlurText}" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontFamily="Roboto" FontSize="16" IsEnabled="{Binding IsNotRecording}"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                        <Border x:Name="btnBgBlur0" CornerRadius="5,0,0,5" Focusable="True" MouseLeftButtonDown="SetBgBlur_Click" Height="30" Width="192" Tag="7" IsEnabled="{Binding IsBgBlurOn}">
                                            <Border.Style>
                                                <Style TargetType="Border" >
                                                    <Setter Property="Background" Value="{DynamicResource RightView_Header_BkColor}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding BgBlur}"  Value="7">
                                                            <Setter Property="Background"  Value="{StaticResource VbarItem_HiBkColor}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource VbarItem_HiBdColor}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding BgBlur}"  Value="1">
                                                            <Setter Property="Cursor" Value="Hand" />
                                                        </DataTrigger>
                                                        <Trigger Property="IsEnabled"  Value="false">
                                                            <Setter Property="Opacity"  Value="0.5" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <UXControls:UXTextBlock Text="{Binding [WebCameraSettings.30], Source={x:Static lang:LangHelper.Instance}}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"  FontFamily="Roboto">
                                                <UXControls:UXTextBlock.Style>
                                                    <Style TargetType="UXControls:UXTextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource DefaultTheme_TxtColor}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding BgBlur}"  Value="7">
                                                                <Setter Property="Foreground"  Value="#FFFFFF" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </UXControls:UXTextBlock.Style>
                                            </UXControls:UXTextBlock>
                                        </Border>
                                        <Border x:Name="btnBgBlur1" CornerRadius="0,5,5,0" Focusable="True" MouseLeftButtonDown="SetBgBlur_Click" Height="30" Width="192" Tag="1" IsEnabled="{Binding IsBgBlurOn}">
                                            <Border.Style>
                                                <Style TargetType="Border" >
                                                    <Setter Property="Background" Value="{DynamicResource RightView_Header_BkColor}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding BgBlur}"  Value="1">
                                                            <Setter Property="Background"  Value="{StaticResource VbarItem_HiBkColor}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource VbarItem_HiBdColor}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding BgBlur}"  Value="7">
                                                            <Setter Property="Cursor" Value="Hand" />
                                                        </DataTrigger>
                                                        <Trigger Property="IsEnabled"  Value="false">
                                                            <Setter Property="Opacity"  Value="0.5" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <UXControls:UXTextBlock Text="{Binding [WebCameraSettings.31], Source={x:Static lang:LangHelper.Instance}}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"  FontFamily="Roboto">
                                                <UXControls:UXTextBlock.Style>
                                                    <Style TargetType="UXControls:UXTextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource DefaultTheme_TxtColor}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding BgBlur}"  Value="1">
                                                                <Setter Property="Foreground"  Value="#FFFFFF" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </UXControls:UXTextBlock.Style>
                                            </UXControls:UXTextBlock>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border CornerRadius="6" Visibility="{Binding AutoFramingVisibility}">
                                <StackPanel Orientation="Vertical">
                                    <Grid Margin="16,25,16,0">
                                        <StackPanel Orientation="Horizontal">
                                            <!-- Derek for PIMS-332102 -->
                                            <UXControls:UXTextBlock MaxWidth="270" TextTrimming="CharacterEllipsis" Text="{Binding [WebCameraSettings.1], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource ModuleItemStyle}" />
                                            <!--Elsa 20250401 for PIMS-348390 remove ToolTipService.Placement="Left" -->
                                            <Border Background="{StaticResource FakeTransparent}">
                                                <ContentControl Template="{StaticResource icon_Info}" Margin="10,0,0,0" Width="18" Height="18" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                                <Border.ToolTip>
                                                    <!--Elsa 20250401 for PIMS-348390 change Placement="Bottom" to Placement="Top",change VerticalOffset="15" to VerticalOffset="14",change HorizontalOffset="220" to HorizontalOffset="13",add MaxWidth="272" Opened="toolTip_Opened" -->
                                                    <ToolTip Placement="Top" VerticalOffset="14" HorizontalOffset="13" MaxWidth="272" Opened="toolTip_Opened">
                                                        <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                                            <!--Elsa 20250401 for PIMS-348390 change MaxWidth="350" to MaxWidth="230" -->
                                                            <TextBlock Text="{Binding [WebCameraSettings.2], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource Tooltip_TextBlockStyle}" MaxWidth="230" TextWrapping="Wrap" Padding="5,0,5,0" />
                                                        </Border>
                                                    </ToolTip>
                                                </Border.ToolTip>
                                            </Border>
                                        </StackPanel>
                                        <UXControls:UXToggleSwitch Click="AutoFrameSwitch_Click" IsChecked="{Binding Path= IsAutoFramingOn}" Content="{Binding Path=IsAutoFramingOnText}" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontFamily="Roboto" FontSize="16" IsEnabled="{Binding IsNotRecording}"/>
                                    </Grid>
                                    <Grid Margin="32,12,16,0" Visibility="{Binding AutoFramingTransitionVisibility}">
                                        <StackPanel Orientation="Horizontal">
                                            <UXControls:UXTextBlock Margin="0,8,0,8" Text="{Binding [WebCameraSettings.3], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource ModuleItemStyle}" IsEnabled="{Binding Path= IsAutoFramingOn}" />
                                            <!--Elsa 20250401 for PIMS-348390 change ToolTipService.Placement="Center" to ToolTipService.Placement="Top" ToolTipService.VerticalOffset="45" to ToolTipService.VerticalOffset="22"-->
                                            <Border ToolTipService.Placement="Top" ToolTipService.VerticalOffset="22" Background="{StaticResource FakeTransparent}">
                                                <ContentControl Template="{StaticResource icon_Info}" Margin="10,0,0,0" Width="18" Height="18" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                                <Border.ToolTip>
                                                    <!--Elsa 20250401 for PIMS-348390 add HorizontalOffset="13" MaxWidth="272" Opened="toolTip_Opened" -->
                                                    <ToolTip HorizontalOffset="13" MaxWidth="272" Opened="toolTip_Opened">
                                                        <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                                            <!--Elsa 20250401 for PIMS-348390 change MaxWidth="350" to MaxWidth="230" -->
                                                            <TextBlock Text="{Binding [WebCameraSettings.4], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource Tooltip_TextBlockStyle}" MaxWidth="230" TextWrapping="Wrap" Padding="5,0,5,0"/>
                                                        </Border>
                                                    </ToolTip>
                                                </Border.ToolTip>
                                            </Border>
                                        </StackPanel>
                                        <UXControls:UXToggleSwitch IsChecked="{Binding Path= IsAutoFramingTransitionOn}" Content="{Binding Path=IsAutoFramingTransitionOnText}" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Roboto" FontSize="16" IsEnabled="{Binding IsAutoFramingOn}" />
                                    </Grid>
                                    <StackPanel Orientation="Vertical" Margin="32,22,16,16" Visibility="{Binding AutoFramingSensitivityVisibility}">
                                        <StackPanel Orientation="Horizontal">
                                            <UXControls:UXTextBlock Text="{Binding [WebCameraSettings.5], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource ModuleItemStyle}" IsEnabled="{Binding IsAutoFramingOn}" />
                                            <!--Elsa 20250401 for PIMS-348390 change ToolTipService.Placement="Center" to ToolTipService.Placement="Top" ToolTipService.VerticalOffset="45" to ToolTipService.VerticalOffset="14"-->
                                            <Border ToolTipService.Placement="Top" ToolTipService.VerticalOffset="14" Background="{StaticResource FakeTransparent}">
                                                <ContentControl Template="{StaticResource icon_Info}" Margin="10,0,0,0" Width="18" Height="18" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                                <Border.ToolTip>
                                                    <!--Elsa 20250401 for PIMS-348390 add HorizontalOffset="13" MaxWidth="272" Opened="toolTip_Opened" -->
                                                    <ToolTip HorizontalOffset="13" MaxWidth="272" Opened="toolTip_Opened">
                                                        <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                                            <!--Elsa 20250401 for PIMS-348390 change MaxWidth="350" to MaxWidth="230" -->
                                                            <TextBlock Text="{Binding [WebCameraSettings.6], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource Tooltip_TextBlockStyle}" MaxWidth="230" TextWrapping="Wrap" Padding="5,0,5,0" />
                                                        </Border>
                                                    </ToolTip>
                                                </Border.ToolTip>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                            <Border x:Name="btnAFS0" CornerRadius="5,0,0,5" Focusable="True" MouseLeftButtonDown="AutoFramingSensitivity_Click" Height="30" Width="192" Tag="1" IsEnabled="{Binding IsAutoFramingOn}">
                                                <Border.Style>
                                                    <Style TargetType="Border" >
                                                        <Setter Property="Background" Value="{DynamicResource RightView_Header_BkColor}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding AutoFramingSensitivity}"  Value="1">
                                                                <Setter Property="Background"  Value="{StaticResource VbarItem_HiBkColor}" />
                                                                <Setter Property="BorderBrush" Value="{StaticResource VbarItem_HiBdColor}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding AutoFramingSensitivity}"  Value="2">
                                                                <Setter Property="Cursor" Value="Hand" />
                                                            </DataTrigger>
                                                            <Trigger Property="IsEnabled"  Value="false">
                                                                <Setter Property="Opacity"  Value="0.5" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <!--20250410 Chewlin for PIMS-348246 change FontSize="14" to "16" ,ADD FontWeight="Medium" -->
                                                <UXControls:UXTextBlock Text="{Binding [WebCameraSettings.7], Source={x:Static lang:LangHelper.Instance}}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Medium" FontFamily="Roboto">
                                                    <UXControls:UXTextBlock.Style>
                                                        <Style TargetType="UXControls:UXTextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource DefaultTheme_TxtColor}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding AutoFramingSensitivity}"  Value="1">
                                                                    <Setter Property="Foreground"  Value="#FFFFFF" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </UXControls:UXTextBlock.Style>
                                                </UXControls:UXTextBlock>
                                            </Border>
                                            <Border x:Name="btnAFS1" CornerRadius="0,5,5,0" Focusable="True" MouseLeftButtonDown="AutoFramingSensitivity_Click" Height="30" Width="192" Tag="2" IsEnabled="{Binding IsAutoFramingOn}">
                                                <Border.Style>
                                                    <Style TargetType="Border" >
                                                        <Setter Property="Background" Value="{DynamicResource RightView_Header_BkColor}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding AutoFramingSensitivity}"  Value="2">
                                                                <Setter Property="Background"  Value="{StaticResource VbarItem_HiBkColor}" />
                                                                <Setter Property="BorderBrush" Value="{StaticResource VbarItem_HiBdColor}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding AutoFramingSensitivity}"  Value="1">
                                                                <Setter Property="Cursor" Value="Hand" />
                                                            </DataTrigger>
                                                            <Trigger Property="IsEnabled"  Value="false">
                                                                <Setter Property="Opacity"  Value="0.5" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <!--20250410 Chewlin for PIMS-348246 change FontSize="14" to "16" ,ADD FontWeight="Medium" -->
                                                <UXControls:UXTextBlock Text="{Binding [WebCameraSettings.8], Source={x:Static lang:LangHelper.Instance}}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Medium" FontFamily="Roboto">
                                                    <UXControls:UXTextBlock.Style>
                                                        <Style TargetType="UXControls:UXTextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource DefaultTheme_TxtColor}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding AutoFramingSensitivity}"  Value="2">
                                                                    <Setter Property="Foreground"  Value="#FFFFFF" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </UXControls:UXTextBlock.Style>
                                                </UXControls:UXTextBlock>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Orientation="Vertical" Margin="32,2,16,16" Visibility="{Binding AutoFramingSizeVisibility}">
                                        <StackPanel Orientation="Horizontal">
                                            <UXControls:UXTextBlock Text="{Binding [WebCameraSettings.9], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource ModuleItemStyle}" IsEnabled="{Binding IsAutoFramingOn}" />
                                            <Border Background="{StaticResource FakeTransparent}">
                                                <ContentControl Template="{StaticResource icon_Info}" Margin="10,0,0,0" Width="18" Height="18" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                                <Border.ToolTip>
                                                    <!--Elsa 20250401 for PIMS-348390 change Placement="Center" to Placement="Top" VerticalOffset="40" to VerticalOffset="14", add HorizontalOffset="13" MaxWidth="272" Opened="toolTip_Opened" -->
                                                    <ToolTip Placement="Top" VerticalOffset="14" HorizontalOffset="13" MaxWidth="272" Opened="toolTip_Opened">
                                                        <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                                            <!--Elsa 20250401 for PIMS-348390 change MaxWidth="350" to MaxWidth="230" -->
                                                            <TextBlock Text="{Binding [WebCameraSettings.27], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource Tooltip_TextBlockStyle}" MaxWidth="230" TextWrapping="Wrap" Padding="5,0,5,0" />
                                                        </Border>
                                                    </ToolTip>
                                                </Border.ToolTip>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                            <Border x:Name="btnFS0" CornerRadius="5,0,0,5" Focusable="True" MouseLeftButtonDown="AutoFramingSize_Click" Height="30" Width="192" Tag="2" IsEnabled="{Binding IsAutoFramingOn}">
                                                <Border.Style>
                                                    <Style TargetType="Border" >
                                                        <Setter Property="Background" Value="{DynamicResource RightView_Header_BkColor}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding AutoFramingFrameSize}"  Value="2">
                                                                <Setter Property="Background"  Value="{StaticResource VbarItem_HiBkColor}" />
                                                                <Setter Property="BorderBrush" Value="{StaticResource VbarItem_HiBdColor}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding AutoFramingFrameSize}"  Value="1">
                                                                <Setter Property="Cursor" Value="Hand" />
                                                            </DataTrigger>
                                                            <Trigger Property="IsEnabled"  Value="false">
                                                                <Setter Property="Opacity"  Value="0.5" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <!--20250410 Chewlin for PIMS-348246 change FontSize="14" to "16" ,ADD FontWeight="Medium" -->
                                                <UXControls:UXTextBlock Text="{Binding [WebCameraSettings.10], Source={x:Static lang:LangHelper.Instance}}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Medium" FontFamily="Roboto">
                                                    <UXControls:UXTextBlock.Style>
                                                        <Style TargetType="UXControls:UXTextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource DefaultTheme_TxtColor}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding AutoFramingFrameSize}"  Value="2">
                                                                    <Setter Property="Foreground"  Value="#FFFFFF" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </UXControls:UXTextBlock.Style>
                                                </UXControls:UXTextBlock>
                                            </Border>
                                            <Border x:Name="btnFS1" CornerRadius="0,5,5,0" Focusable="True" MouseLeftButtonDown="AutoFramingSize_Click" Height="30" Width="192" Tag="1" IsEnabled="{Binding IsAutoFramingOn}">
                                                <Border.Style>
                                                    <Style TargetType="Border" >
                                                        <Setter Property="Background" Value="{DynamicResource RightView_Header_BkColor}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding AutoFramingFrameSize}" Value="1">
                                                                <Setter Property="Background"  Value="{StaticResource VbarItem_HiBkColor}" />
                                                                <Setter Property="BorderBrush" Value="{StaticResource VbarItem_HiBdColor}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding AutoFramingFrameSize}" Value="2">
                                                                <Setter Property="Cursor" Value="Hand" />
                                                            </DataTrigger>
                                                            <Trigger Property="IsEnabled"  Value="false">
                                                                <Setter Property="Opacity"  Value="0.5" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <!--20250410 Chewlin for PIMS-348246 change FontSize="14" to "16" ,ADD FontWeight="Medium" -->
                                                <UXControls:UXTextBlock Text="{Binding [WebCameraSettings.11], Source={x:Static lang:LangHelper.Instance}}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Medium" FontFamily="Roboto">
                                                    <UXControls:UXTextBlock.Style>
                                                        <Style TargetType="UXControls:UXTextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource DefaultTheme_TxtColor}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding AutoFramingFrameSize}" Value="1">
                                                                    <Setter Property="Foreground"  Value="#FFFFFF" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </UXControls:UXTextBlock.Style>
                                                </UXControls:UXTextBlock>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
