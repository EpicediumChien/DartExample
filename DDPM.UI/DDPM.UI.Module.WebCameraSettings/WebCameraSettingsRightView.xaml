<UserControl x:Class="DDPM.UI.Module.WebCameraSettings.WebCameraSettingsRightView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             xmlns:plugin="clr-namespace:DDPM.UI.Plugin.ViewModels;assembly=DDPM.UI.Plugin.Common"
             xmlns:PluginCommon="clr-namespace:DDPM.UI.Plugin.Common;assembly=DDPM.UI.Plugin.Common"
             d:DataContext="{d:DesignInstance Type=plugin:WebCameraViewModel}"
             xmlns:common="clr-namespace:DDPM.UI.Common;assembly=DDPM.UI.Common"
             xmlns:lang="clr-namespace:DDPM.UI.Resources.Helper;assembly=DDPM.UI.Resources"
             mc:Ignorable="d"
             d:DesignHeight="675" d:DesignWidth="554" VerticalAlignment="Top" HorizontalAlignment="Left" Loaded="UserControl_Loaded">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/DDPM.UI.Common;component/PluginStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <PluginCommon:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
      <PluginCommon:ThicknessConverter x:Key="MarginConverter" />
      <PluginCommon:BooleanToInverseConverter x:Key="BooleanToInverseConverter" />
      <PluginCommon:CenterToolTipConverter x:Key="CenterToolTipConverter" />
      <PluginCommon:HeightConverter x:Key="HeightConverter" />
      <Style x:Key="TextBlockStyle1" TargetType="{x:Type UXControls:UXTextBlock}">
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontFamily" Value="Roboto" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Medium" />
      </Style>
      <Style x:Key="ToggleSwitch1" TargetType="{x:Type UXControls:UXToggleSwitch}">
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontFamily" Value="Roboto" />
        <Setter Property="FontSize" Value="16" />
      </Style>
      <Style x:Key="DisableToolTipStyle" TargetType="ToolTip" BasedOn="{StaticResource InfoToolTipStyle}">
        <Setter Property="Placement" Value="Top" />
        <Setter Property="VerticalOffset" Value="45" />
        <Setter Property="HorizontalOffset">
          <Setter.Value>
            <MultiBinding Converter="{StaticResource CenterToolTipConverter}">
              <Binding RelativeSource="{RelativeSource Self}" Path="PlacementTarget.ActualWidth" />
              <Binding RelativeSource="{RelativeSource Self}" Path="ActualWidth" />
            </MultiBinding>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid Margin="0,0,0,15">
    <Border Background="#99132F54" CornerRadius="13" Margin="0,10,0,0" Width="470">
      <Border.Height>
        <MultiBinding Converter="{StaticResource HeightConverter}">
          <Binding Path="Height" RelativeSource="{RelativeSource AncestorType=Grid}" />
        </MultiBinding>
      </Border.Height>
      <StackPanel Margin="16,16,2,0" Orientation="Vertical">
        <Grid>
          <UXControls:UXTextBlock Margin="0,10,0,6" Text="{Binding [WebCameraSettings.0], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource ModuleCaptionStyle}" />
          <Image Margin="0,0,67,0" Source="/DDPM.UI.Resources;component/Resources/Images/Undo2.png" Stretch="Fill"  
                 HorizontalAlignment="Right" Width="40" Height="40" Visibility="{Binding Undo2Visibility}"/>
          <Image Margin="0,0,17,0" Source="/DDPM.UI.Resources;component/Resources/Images/Redo2.png" Stretch="Fill"  
                 HorizontalAlignment="Right" Width="40" Height="40" Visibility="{Binding Redo2Visibility}"/>
          <Image Margin="0,0,67,0" Source="/DDPM.UI.Resources;component/Resources/Images/Undo.png" Stretch="Fill" MouseLeftButtonDown="Image_MouseLeftButtonDown" Tag="0"
                 HorizontalAlignment="Right" Width="40" Height="40" Visibility="{Binding UndoVisibility}" Cursor="Hand"/>
          <Image Margin="0,0,17,0" Source="/DDPM.UI.Resources;component/Resources/Images/Redo.png" Stretch="Fill" MouseLeftButtonDown="Image_MouseLeftButtonDown" Tag="1"
                 HorizontalAlignment="Right" Width="40" Height="40" Visibility="{Binding RedoVisibility}" Cursor="Hand"/>
        </Grid>
        <DockPanel Margin="0,16,0,4000">
          <DockPanel.Height>
            <MultiBinding Converter="{StaticResource HeightConverter}" ConverterParameter="85">
              <Binding Path="ActualHeight" RelativeSource="{RelativeSource AncestorType=Border, AncestorLevel=1}" />
            </MultiBinding>
          </DockPanel.Height>
          <UXControls:UXScrollViewer>
            <StackPanel>
              <Border Name="bdrAlert1" Background="#364861" CornerRadius="4" Margin="0,0,0,15" BorderThickness="7,0,0,0" BorderBrush="#0E92F2" Visibility="{Binding MessageBoxVisibility}"
>
                <StackPanel Orientation="Horizontal">
                  <Image x:Name="InfoIcon" Margin="10,0,0,0" Source="/DDPM.UI.Resources;component/Resources/Images/info.png" Stretch="Fill"
                               VerticalAlignment="Center" HorizontalAlignment="Left" Width="18" Height="18">
                  </Image>
                  <UXControls:UXTextBlock Name="txtMessage" FontSize="13" Background="#364861" Foreground="#F5F6F7" TextWrapping="Wrap" Width="362" 
                                          Text="{Binding [Camera.13], Source={x:Static lang:LangHelper.Instance}}"
                                          VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5,15,0,13" LineHeight="21" Padding="2,3,10,2">
                  </UXControls:UXTextBlock>
                  <Image x:Name="CloseIcon" Source="/DDPM.UI.Common;component/Resources/Close.png" Stretch="Fill" Focusable="True"
                         VerticalAlignment="Center" HorizontalAlignment="Right" Width="15" Height="15" MouseLeftButtonDown="CloseMessageBox" Cursor="Hand">
                  </Image>
                </StackPanel>
              </Border>
              <Border Background="#99132F54" CornerRadius="6" Visibility="{Binding AutoFramingVisibility}">
                <StackPanel Orientation="Vertical">
                  <Grid Margin="16,25,16,0">
                    <StackPanel Orientation="Horizontal">
                      <UXControls:UXTextBlock  Text="{Binding [WebCameraSettings.1], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource ModuleItemStyle}" />
                      <Image Margin="9,0,0,0" Source="/DDPM.UI.Common;component/Resources/info.png" Stretch="Uniform" Cursor="Hand" Width="16" Height="16">
                        <Image.ToolTip>
                          <ToolTip Style="{StaticResource InfoToolTipStyle}" Placement="Top" VerticalOffset="8" HorizontalOffset="6">
                            <TextBlock Text="{Binding [WebCameraSettings.2], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource TabInfoToolTipTextStyle}" MaxWidth="350" />
                          </ToolTip>
                        </Image.ToolTip>
                      </Image>
                    </StackPanel>
                    <UXControls:UXToggleSwitch IsChecked="{Binding Path= IsAutoFramingOn}" Content="{Binding Path=IsAutoFramingOnText}" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Roboto" FontSize="16" />
                  </Grid>
                  <Grid Margin="32,12,16,0" Visibility="{Binding AutoFramingTransitionVisibility}">
                    <StackPanel Orientation="Horizontal">
                      <UXControls:UXTextBlock Margin="0,8,0,8" Text="{Binding [WebCameraSettings.3], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource ModuleItemStyle}" IsEnabled="{Binding Path= IsAutoFramingOn}" />
                      <Image Margin="9,0,0,0" Source="/DDPM.UI.Common;component/Resources/info.png" Stretch="Uniform" Cursor="Hand" Width="16" Height="16">
                        <Image.ToolTip>
                          <ToolTip Style="{StaticResource InfoToolTipStyle}" Placement="Top" VerticalOffset="8" HorizontalOffset="6">
                            <TextBlock Text="{Binding [WebCameraSettings.4], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource TabInfoToolTipTextStyle}" MaxWidth="350" />
                          </ToolTip>
                        </Image.ToolTip>
                      </Image>
                    </StackPanel>
                    <UXControls:UXToggleSwitch IsChecked="{Binding Path= IsAutoFramingTransitionOn}" Content="{Binding Path=IsAutoFramingTransitionOnText}" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Roboto" FontSize="16" IsEnabled="{Binding IsAutoFramingOn}" />
                  </Grid>
                  <StackPanel Orientation="Vertical" Margin="32,22,16,16" Visibility="{Binding AutoFramingSensitivityVisibility}">
                    <StackPanel Orientation="Horizontal">
                      <UXControls:UXTextBlock Text="{Binding [WebCameraSettings.5], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource ModuleItemStyle}" IsEnabled="{Binding IsAutoFramingOn}" />
                      <Image Margin="9,0,0,0" Source="/DDPM.UI.Common;component/Resources/info.png" Stretch="Uniform" Cursor="Hand" Width="16" Height="16">
                        <Image.ToolTip>
                          <ToolTip Style="{StaticResource InfoToolTipStyle}" Placement="Top" VerticalOffset="8" HorizontalOffset="6">
                            <TextBlock Text="{Binding [WebCameraSettings.6], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource TabInfoToolTipTextStyle}" MaxWidth="350" />
                          </ToolTip>
                        </Image.ToolTip>
                      </Image>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                      <Border x:Name="btnAFS0" CornerRadius="5,0,0,5" Focusable="True" MouseLeftButtonDown="AutoFramingSensitivity_Click" Height="30" Width="192" Tag="0" IsEnabled="{Binding IsAutoFramingOn}">
                        <Border.Style>
                          <Style TargetType="Border" BasedOn="{StaticResource Border_Test}">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding AutoFramingSensitivity}"  Value="0">
                                <Setter Property="Background"  Value="{StaticResource VbarItem_HiBkColor}" />
                                <Setter Property="BorderBrush" Value="{StaticResource VbarItem_HiBdColor}" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding AutoFramingSensitivity}"  Value="1">
                                <Setter Property="Cursor" Value="Hand" />
                              </DataTrigger>
                              <Trigger Property="IsEnabled"  Value="false">
                                <Setter Property="Opacity"  Value="0.5" />
                              </Trigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <UXControls:UXTextBlock Text="{Binding [WebCameraSettings.7], Source={x:Static lang:LangHelper.Instance}}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontFamily="Roboto" />
                      </Border>
                      <Border x:Name="btnAFS1" CornerRadius="0,5,5,0" Focusable="True" MouseLeftButtonDown="AutoFramingSensitivity_Click" Height="30" Width="192" Tag="1" IsEnabled="{Binding IsAutoFramingOn}">
                        <Border.Style>
                          <Style TargetType="Border" BasedOn="{StaticResource Border_Test}">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding AutoFramingSensitivity}"  Value="1">
                                <Setter Property="Background"  Value="{StaticResource VbarItem_HiBkColor}" />
                                <Setter Property="BorderBrush" Value="{StaticResource VbarItem_HiBdColor}" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding AutoFramingSensitivity}"  Value="0">
                                <Setter Property="Cursor" Value="Hand" />
                              </DataTrigger>
                              <Trigger Property="IsEnabled"  Value="false">
                                <Setter Property="Opacity"  Value="0.5" />
                              </Trigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <UXControls:UXTextBlock Text="{Binding [WebCameraSettings.8], Source={x:Static lang:LangHelper.Instance}}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontFamily="Roboto" />
                      </Border>
                    </StackPanel>
                  </StackPanel>
                  <StackPanel Orientation="Vertical" Margin="32,2,16,16" Visibility="{Binding AutoFramingSizeVisibility}">
                    <StackPanel Orientation="Horizontal">
                      <UXControls:UXTextBlock Text="{Binding [WebCameraSettings.9], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource ModuleItemStyle}" IsEnabled="{Binding IsAutoFramingOn}" />
                      <Image Margin="9,0,0,0" Source="/DDPM.UI.Common;component/Resources/info.png" Stretch="Uniform" Cursor="Hand" Width="16" Height="16">
                        <Image.ToolTip>
                          <ToolTip Style="{StaticResource InfoToolTipStyle}" Placement="Top" VerticalOffset="8" HorizontalOffset="6">
                            <TextBlock Text="{Binding [WebCameraSettings.27], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource TabInfoToolTipTextStyle}" />
                          </ToolTip>
                        </Image.ToolTip>
                      </Image>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                      <Border x:Name="btnFS0" CornerRadius="5,0,0,5" Focusable="True" MouseLeftButtonDown="AutoFramingSize_Click" Height="30" Width="192" Tag="0" IsEnabled="{Binding IsAutoFramingOn}">
                        <Border.Style>
                          <Style TargetType="Border" BasedOn="{StaticResource Border_Test}">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding AutoFramingFrameSize}"  Value="0">
                                <Setter Property="Background"  Value="{StaticResource VbarItem_HiBkColor}" />
                                <Setter Property="BorderBrush" Value="{StaticResource VbarItem_HiBdColor}" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding AutoFramingFrameSize}"  Value="1">
                                <Setter Property="Cursor" Value="Hand" />
                              </DataTrigger>
                              <Trigger Property="IsEnabled"  Value="false">
                                <Setter Property="Opacity"  Value="0.5" />
                              </Trigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <UXControls:UXTextBlock Text="{Binding [WebCameraSettings.10], Source={x:Static lang:LangHelper.Instance}}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontFamily="Roboto" />
                      </Border>
                      <Border x:Name="btnFS1" CornerRadius="0,5,5,0" Focusable="True" MouseLeftButtonDown="AutoFramingSize_Click" Height="30" Width="192" Tag="1" IsEnabled="{Binding IsAutoFramingOn}">
                        <Border.Style>
                          <Style TargetType="Border" BasedOn="{StaticResource Border_Test}">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding AutoFramingFrameSize}" Value="1">
                                <Setter Property="Background"  Value="{StaticResource VbarItem_HiBkColor}" />
                                <Setter Property="BorderBrush" Value="{StaticResource VbarItem_HiBdColor}" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding AutoFramingFrameSize}" Value="0">
                                <Setter Property="Cursor" Value="Hand" />
                              </DataTrigger>
                              <Trigger Property="IsEnabled"  Value="false">
                                <Setter Property="Opacity"  Value="0.5" />
                              </Trigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <UXControls:UXTextBlock Text="{Binding [WebCameraSettings.11], Source={x:Static lang:LangHelper.Instance}}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontFamily="Roboto" />
                      </Border>
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border x:Name="bdrFOV" Background="#99132F54" CornerRadius="6" Margin="0,10,0,0" Visibility="{Binding FOVVisibility}">
                <StackPanel Orientation="Vertical">
                  <StackPanel Orientation="Vertical" Margin="16,25,16,16">
                    <StackPanel Orientation="Horizontal">
                      <UXControls:UXTextBlock Text="{Binding [WebCameraSettings.12], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource ModuleItemStyle}" IsEnabled="{Binding IsAutoFramingOn, Converter={StaticResource BooleanToInverseConverter}}"/>
                      <Image Margin="9,0,0,0" Source="/DDPM.UI.Common;component/Resources/info.png" Stretch="Uniform" Cursor="Hand" Width="16" Height="16">
                        <Image.ToolTip>
                          <ToolTip Style="{StaticResource InfoToolTipStyle}" Placement="Top" VerticalOffset="8" HorizontalOffset="6">
                            <TextBlock Text="{Binding [WebCameraSettings.13], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource TabInfoToolTipTextStyle}" MaxWidth="350" />
                          </ToolTip>
                        </Image.ToolTip>
                      </Image>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                      <Border x:Name="btnFOV0" CornerRadius="5,0,0,5" Focusable="True" Tag="0" MouseLeftButtonDown="FOV_Click" Height="30" IsEnabled="{Binding IsAutoFramingOn, Converter={StaticResource BooleanToInverseConverter}}">
                        <Border.Style>
                          <Style TargetType="Border" BasedOn="{StaticResource Border_Test}">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding FOV_IsSelected[0]}" Value="true">
                                <Setter Property="Background"  Value="{StaticResource VbarItem_HiBkColor}" />
                                <Setter Property="Cursor" Value="Arrow" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding FOV_IsSelected[0]}" Value="false">
                                <Setter Property="Cursor" Value="Hand" />
                              </DataTrigger>
                              <Trigger Property="IsEnabled"  Value="false">
                                <Setter Property="Opacity"  Value="0.5" />
                              </Trigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <Grid>
                          <UXControls:UXTextBlock Name="txtFOV0" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontFamily="Roboto" />
                        </Grid>
                      </Border>
                      <Border x:Name="btnFOV1"  Focusable="True" Tag="1" MouseLeftButtonDown="FOV_Click" Height="30" IsEnabled="{Binding IsAutoFramingOn, Converter={StaticResource BooleanToInverseConverter}}">
                        <Border.Style>
                          <Style TargetType="Border" BasedOn="{StaticResource Border_Test}">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding FOV_IsSelected[1]}" Value="true">
                                <Setter Property="Background"  Value="{StaticResource VbarItem_HiBkColor}" />
                                <Setter Property="Cursor" Value="Arrow" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding FOV_IsSelected[1]}" Value="false">
                                <Setter Property="Cursor" Value="Hand" />
                              </DataTrigger>
                              <Trigger Property="IsEnabled"  Value="false">
                                <Setter Property="Opacity"  Value="0.5" />
                              </Trigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <Grid>
                          <UXControls:UXTextBlock Name="txtFOV1" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontFamily="Roboto" />
                        </Grid>
                      </Border>
                      <Border x:Name="btnFOV2" Focusable="True" Tag="2" MouseLeftButtonDown="FOV_Click" Height="30" IsEnabled="{Binding IsAutoFramingOn, Converter={StaticResource BooleanToInverseConverter}}">
                        <Border.Style>
                          <Style TargetType="Border" BasedOn="{StaticResource Border_Test}">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding FOV_IsSelected[2]}" Value="true">
                                <Setter Property="Background"  Value="{StaticResource VbarItem_HiBkColor}" />
                                <Setter Property="Cursor" Value="Arrow" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding FOV_IsSelected[2]}" Value="false">
                                <Setter Property="Cursor" Value="Hand" />
                              </DataTrigger>
                              <Trigger Property="IsEnabled"  Value="false">
                                <Setter Property="Opacity"  Value="0.5" />
                              </Trigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <Grid>
                          <UXControls:UXTextBlock Name="txtFOV2" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontFamily="Roboto" />
                        </Grid>
                      </Border>
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Background="#99132F54" CornerRadius="6" Margin="0,10,0,0" Visibility="{Binding ZoomVisibility}">
                <StackPanel Orientation="Vertical">
                  <StackPanel Orientation="Vertical" Margin="16,25,16,0">
                    <UXControls:UXTextBlock Text="{Binding [WebCameraSettings.15], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource ModuleItemStyle}" IsEnabled="{Binding IsAutoFramingOn, Converter={StaticResource BooleanToInverseConverter}}"/>
                    <Grid Margin="0,15,0,20">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                      </Grid.ColumnDefinitions>
                      <Image Grid.Column="0" Source="/DDPM.UI.Resources;component/Resources/Images/ZoomOutS.png" Stretch="Uniform" Width="16" />
                      <UXControls:UXSlider Name="ZoomSlider" Grid.Column="1" Margin="0,0,0,0" Width="360" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"  
                                           IsMoveToPointEnabled="True" IsEnabled="{Binding IsAutoFramingOn, Converter={StaticResource BooleanToInverseConverter}}"
                                           Value="{Binding Zoom}"  Thumb.DragStarted="ZoomSlider_DragStarted" Thumb.DragCompleted="ZoomSlider_DragCompleted"/>
                      <Image Grid.Column="2" Source="/DDPM.UI.Resources;component/Resources/Images/ZoomInS.png" Height="16" Stretch="Uniform" />
                    </Grid>
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Background="#99132F54" CornerRadius="6" Margin="0,10,0,0" Visibility="{Binding AutofocusVisibility}">
                <StackPanel Orientation="Vertical">
                  <Grid Margin="16,25,16,0">
                    <StackPanel Orientation="Horizontal">
                      <UXControls:UXTextBlock Grid.Column="0" Text="{Binding [WebCameraSettings.16], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource ModuleItemStyle}" />
                      <Image Margin="9,0,9,0" Source="/DDPM.UI.Common;component/Resources/info.png" Stretch="Uniform" Cursor="Hand" Width="16" Height="16" HorizontalAlignment="Left">
                        <Image.ToolTip>
                          <ToolTip Style="{StaticResource InfoToolTipStyle}" Placement="Top" VerticalOffset="8" HorizontalOffset="6">
                            <TextBlock Text="{Binding [WebCameraSettings.17], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource TabInfoToolTipTextStyle}" MaxWidth="350" />
                          </ToolTip>
                        </Image.ToolTip>
                      </Image>
                    </StackPanel>
                    <UXControls:UXToggleSwitch IsChecked="{Binding Path= IsFocusOn}" Content="{Binding Path=IsFocusOnText}" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Roboto" FontSize="16" />
                  </Grid>
                  <StackPanel Orientation="Vertical" Margin="16,16,16,16">
                    <UXControls:UXSlider Name="AutofocusSlider" Width="402" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" AutoToolTipPlacement="None" IsEnabled="{Binding IsFocusOn, Converter={StaticResource BooleanToInverseConverter}}"
                                         Value="{Binding Focus}" IsMoveToPointEnabled="True" IsSnapToTickEnabled="True" Thumb.DragStarted="AutofocusSlider_DragStarted" Thumb.DragCompleted="AutofocusSlider_DragCompleted" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Background="#99132F54" CornerRadius="6" Margin="0,10,0,0" Visibility="{Binding PriorityVisibility}">
                <StackPanel Orientation="Vertical" Margin="16,22,16,10">
                  <StackPanel Orientation="Horizontal">
                    <UXControls:UXTextBlock Text="{Binding [WebCameraSettings.18], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource ModuleItemStyle}" />
                    <Image Margin="9,0,0,0" Source="/DDPM.UI.Common;component/Resources/info.png" Stretch="Uniform" Cursor="Hand" Width="16" Height="16">
                      <Image.ToolTip>
                        <ToolTip Style="{StaticResource InfoToolTipStyle}" Placement="Top" VerticalOffset="8" HorizontalOffset="6">
                          <TextBlock Text="{Binding [WebCameraSettings.19], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource TabInfoToolTipTextStyle}" MaxWidth="350"/>
                        </ToolTip>
                      </Image.ToolTip>
                    </Image>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,18,0,8">
                    <Border x:Name="btnPriority0" CornerRadius="5,0,0,5" Focusable="True" MouseLeftButtonDown="Priority_Click" Height="30" Width="201" Tag="0" IsEnabled="{Binding IsHDROn, Converter={StaticResource BooleanToInverseConverter}}">
                      <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Border_Test}">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Priority}"  Value="0">
                              <Setter Property="Background"  Value="{StaticResource VbarItem_HiBkColor}" />
                              <Setter Property="BorderBrush" Value="{StaticResource VbarItem_HiBdColor}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Priority}"  Value="1">
                              <Setter Property="Cursor" Value="Hand" />
                            </DataTrigger>
                            <Trigger Property="IsEnabled"  Value="false">
                              <Setter Property="Opacity"  Value="0.5" />
                            </Trigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <UXControls:UXTextBlock Text="{Binding [WebCameraSettings.20], Source={x:Static lang:LangHelper.Instance}}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontFamily="Roboto" />
                    </Border>
                    <Border x:Name="btnPriority1" CornerRadius="0,5,5,0" Focusable="True" MouseLeftButtonDown="Priority_Click" Height="30" Width="201" Tag="1" IsEnabled="{Binding IsHDROn, Converter={StaticResource BooleanToInverseConverter}}">
                      <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Border_Test}">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Priority}"  Value="1">
                              <Setter Property="Background"  Value="{StaticResource VbarItem_HiBkColor}" />
                              <Setter Property="BorderBrush" Value="{StaticResource VbarItem_HiBdColor}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Priority}"  Value="0">
                              <Setter Property="Cursor" Value="Hand" />
                            </DataTrigger>
                            <Trigger Property="IsEnabled"  Value="false">
                              <Setter Property="Opacity"  Value="0.5" />
                            </Trigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <UXControls:UXTextBlock Text="{Binding [WebCameraSettings.21], Source={x:Static lang:LangHelper.Instance}}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontFamily="Roboto" />
                    </Border>
                  </StackPanel>
                  <Border Name="bdrAlert2" Background="#364861" CornerRadius="4" Margin="0,12,0,8" BorderThickness="7,0,0,0" BorderBrush="#E67F01" Visibility="{Binding IsHDROn, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                      <Image x:Name="InfoIcon2" Margin="8,0,0,0" Source="/DDPM.UI.Resources;component/Resources/Images/Alert.png" Stretch="Fill"
