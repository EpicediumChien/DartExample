<UserControl x:Class="DDPM.UI.Plugin.SettingsPlugin.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DDPM.UI.Plugin.SettingsPlugin"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:commonModel="clr-namespace:DDPM.UI.Common.Models;assembly=DDPM.UI.Common"
             xmlns:lang="clr-namespace:DDPM.UI.Resources.Helper;assembly=DDPM.UI.Resources"
             mc:Ignorable="d" Loaded="UserControl_Loaded"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <UserControl.Resources>
        <sys:String x:Key="lorem">
            Lorem ipsum dolor sit amet consectetur. Fermentum cras imperdiet duis
        </sys:String>
        
    </UserControl.Resources>
    <Grid Margin="60,00,100,29" >
        <Grid.RowDefinitions>
            <RowDefinition Height="40"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,8,0,0">
            <!-- Robert_Lin 2025-3-5 -->
            <!-- OLD:
            <UXControls:UXTextBlock Grid.Row="0"
                                Grid.Column="0"
                                Text="&#xe223; "
                                FontFamily="Segoe UI Symbol"
                                FontSize="30"
                                     Focusable="True" AutomationProperties.Name="{Binding [Back], Source={x:Static lang:LangHelper.Instance}}" 
                                     PreviewKeyDown="leftArrow_PreviewKeyDown"
                                HorizontalAlignment="Left"
                                TextBlockType="Header2"
                                TextBlockSemanticColorType="Light"
                                MouseLeftButtonDown="leftArrow_MouseLeftButtonDown"
                                Foreground="{DynamicResource DefaultTheme_TxtColor}"  />
            
            -->
            <!-- NEW: -->
            <Button Width="24" Height="24" Margin="0,0,16,0"
                    Style="{StaticResource StatelessButton}"
                    VerticalAlignment="Stretch" HorizontalAlignment="Left" Cursor="Hand"
                    KeyboardNavigation.TabIndex="11" 
                    AutomationProperties.Name="{Binding [Back], Source={x:Static lang:LangHelper.Instance}}" 
                    Click="backArrowButton_Click" 
                    >
                <Grid Background="{StaticResource FakeTransparent}" >
                    <ContentControl Template="{StaticResource icon_BackArrow}" Foreground="{DynamicResource TextBlock_ForegroundColor}"/>
                </Grid>
            </Button>

            <UXControls:UXTextBlock Text="{Binding [Settings], Source={x:Static lang:LangHelper.Instance}}"
                                VerticalAlignment="Top" HorizontalAlignment="Left" TextBlockType="Header2"
                                FontSize="24" FontFamily="{StaticResource RobotoFont}" Focusable="True"
                                Foreground="{DynamicResource DefaultTheme_TxtColor}" />
        </StackPanel>
        <Grid Margin="40,44,0,0" Grid.Row="1">
            <Grid >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--0614 Bruce 將按鈕改成UXTextBlock，事件也變更，讓風格更像figma，不影響功能作動-->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    
                    <!-- #region General -->
                    <!-- 
                            Focusable="True"
                            AutomationProperties.Name="{Binding [General], Source={x:Static lang:LangHelper.Instance}}"
                    -->
                    <Border Margin="0,0,8,8"
                            Grid.Row="0"
                            Width="212" Height="64"
                            BorderThickness="2"
                            CornerRadius="13"
                            x:Name="Vbar_0"
                            MouseLeftButtonDown="GeneralButton_Click" 
                            PreviewKeyDown="GeneralButton_PreviewKeyDown">
                        <Border.Style>
                            <Style TargetType="Border"
                                   BasedOn="{StaticResource BorderBase}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected[0]}"
                                                 Value="True">
                                        <Setter Property="Background"
                                                Value="{DynamicResource VbarItem_HiBkColor}" />
                                        <Setter Property="BorderBrush"
                                                Value="{DynamicResource VbarItem_HiBdColor}" />
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <!-- Check if the item is not selected -->
                                            <Condition Binding="{Binding IsSelected[0]}" Value="False" />
                                            <!-- Check if the mouse is over the item -->
                                            <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="{DynamicResource Vbar_BkBrush_Hover}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Vbar_BkBrush_Hover}" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <!-- Robert_Lin 2025-1-15 PIMS-333535] L10N: i18N: DDPM 2.0: GUI: TP1: es-ES, fr-CA, it-IT, pl-PL, pt-PT, ru-RU, tr-TR, ua-UK: Clipping found in stringID: About
                            Text will be clipped in the UI. Remove all Width settings, let the text wrap and VertialAllinment=Center 
                            
                            Test Text: Lorem ipsum dolor sit amet consectetur.
                            
                            -->
                            <!--<Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>-->
                            <!-- 
                                                    Text="{Binding [General], Source={x:Static lang:LangHelper.Instance}}"
                                                    Text="Lorem ipsum dolor sit amet consectetur. Fermentum cras imperdiet duis"
                            -->
                            <UXControls:UXTextBlock Grid.Row="0" Grid.Column="0" Focusable="True"
                                                    FontSize="14"
                                                    Margin="20,0"
                                                    Text="{Binding [General], Source={x:Static lang:LangHelper.Instance}}"
                                                    TextWrapping="Wrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxHeight="40"
                                                    >
                                <UXControls:UXTextBlock.Style>
                                    <Style TargetType="UXControls:UXTextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource DefaultTheme_TxtColor}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected[0]}" Value="True">
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </UXControls:UXTextBlock.Style>
                            </UXControls:UXTextBlock>
                        </Grid>
                    </Border>
                    <!-- #end region General -->
                    
                    <!-- #region Updates -->
                    <!-- 
                            Focusable="True"
                    -->
                    <Border Margin="0,0,8,8"
                            Grid.Row="1"
                            Width="212" Height="64"
                            BorderThickness="2"
                            CornerRadius="13"
                            x:Name="Vbar_1"
                            MouseLeftButtonDown="UpdatesButton_Click" PreviewKeyDown="UpdatesButton_PreviewKeyDown">
                        <Border.Style>
                            <Style TargetType="Border"
                                   BasedOn="{StaticResource BorderBase}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected[1]}"
                                                 Value="True">
                                        <Setter Property="Background"
                                                Value="{DynamicResource VbarItem_HiBkColor}" />
                                        <Setter Property="BorderBrush"
                                                Value="{DynamicResource VbarItem_HiBdColor}" />
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <!-- Check if the item is not selected -->
                                            <Condition Binding="{Binding IsSelected[1]}" Value="False" />
                                            <!-- Check if the mouse is over the item -->
                                            <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="{DynamicResource Vbar_BkBrush_Hover}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Vbar_BkBrush_Hover}" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <!-- Robert_Lin 2025-1-15 for PIMS-333535 
                            OLD:
                            
                              <Grid.ColumnDefinitions>
                               <ColumnDefinition Width="170" />
                               <ColumnDefinition />
                           </Grid.ColumnDefinitions>
                         -->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- 
                            
                                                    Text="{Binding [Updates], Source={x:Static lang:LangHelper.Instance}}"
                            -->
                            <UXControls:UXTextBlock Grid.Column="0" Focusable="True"
                                                    FontSize="14"
                                                    Margin="20,0"
                                                    Text="{Binding [Updates], Source={x:Static lang:LangHelper.Instance}}"
                                                     TextWrapping="Wrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxHeight="40"
                                                   Opacity="{Binding UpdatesPageUI_Opacity}">
                                <UXControls:UXTextBlock.Style>
                                    <Style TargetType="UXControls:UXTextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource DefaultTheme_TxtColor}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected[1]}" Value="True">
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </UXControls:UXTextBlock.Style>
                            </UXControls:UXTextBlock>
                            <Grid Grid.Column="1"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" Margin="0,0,16,0"
                                  Visibility="{Binding IsAnyUpdate}">
                                <Path Data="M7.5 10.5L7.5 3.5H8.5V10.5H7.5Z M7.5 11.5V12.5H8.5V11.5H7.5Z M0 8C0 3.58172 3.58172 0 8 0C12.4183 0 16 3.58172 16 8C16 12.4183 12.4183 16 8 16C3.58172 16 0 12.4183 0 8ZM8 1C4.13401 1 1 4.13401 1 8C1 11.866 4.13401 15 8 15C11.866 15 15 11.866 15 8C15 4.13401 11.866 1 8 1Z"
                                      Fill="#E67F01" />
                            </Grid>
                            <Grid Grid.Column="1"
                                  Visibility="{Binding UpdatesPageUI_LockTooltip}"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center" Margin="0,0,16,0"
                                  Width="16"
                                  Height="16">
                                <Path Data="M12.1 6.40012V4.00012C12.2 1.80012 10.5 0.100122 8.30005 0.00012207H8.10005C5.90005 0.00012207 4.10005 1.80012 4.10005 4.00012V6.40012H1.80005V16.0001H14.1V6.40012H12.1ZM5.30005 4.00012C5.20005 2.50012 6.40005 1.30012 7.80005 1.20012H8.20005C9.80005 1.20012 11 2.50012 11 4.00012V6.40012H5.30005V4.00012ZM13.1 14.9001H3.00005V7.50012H13.1V14.9001Z M7.60005 12.5001H8.60005V9.30012H6.80005V10.3001H7.60005V12.5001Z">
                                    <Path.ToolTip>
                                        <ToolTip>
                                            <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                                <Border.Resources>
                                                    <Style BasedOn="{StaticResource Tooltip_TextBlockStyle}" TargetType="TextBlock" />
                                                </Border.Resources>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding [ITLockToolTip.0], Source={x:Static lang:LangHelper.Instance}}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </ToolTip>
                                    </Path.ToolTip>
                                </Path>
                            </Grid>
                        </Grid>
                    </Border>
                    <!-- #endregion Updates -->

                    <!-- #region Analytics -->
                    <!-- 
                            Focusable="True"
                    -->
                    <Border Margin="0,0,8,8"
                            Grid.Row="2"
                            Width="212" Height="64"
                            BorderThickness="2"
                            CornerRadius="13"
                            x:Name="Vbar_2"
                            MouseLeftButtonDown="AnalyticsButton_Click" PreviewKeyDown="AnalyticsButton_PreviewKeyDown">
                        <Border.Style>
                            <Style TargetType="Border"
                                   BasedOn="{StaticResource BorderBase}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected[2]}"
                                                 Value="True">
                                        <Setter Property="Background"
                                                Value="{DynamicResource VbarItem_HiBkColor}" />
                                        <Setter Property="BorderBrush"
                                                Value="{DynamicResource VbarItem_HiBdColor}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding AnalyticsPage_IsEnable}"
                                                 Value="False">
                                        <Setter Property="Background"
                                                Value="#596067" />
                                        <Setter Property="BorderBrush"
                                                Value="#596067" />
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <!-- Check if the item is not selected -->
                                            <Condition Binding="{Binding IsSelected[2]}" Value="False" />
                                            <!-- Check if the mouse is over the item -->
                                            <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="{DynamicResource Vbar_BkBrush_Hover}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Vbar_BkBrush_Hover}" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- 
                                                    Text="{Binding [Analytics], Source={x:Static lang:LangHelper.Instance}}"
                            -->
                            <UXControls:UXTextBlock Grid.Column="0" Focusable="True"
                                                    Width="212"
                                                    FontSize="14"
                                                    Margin="20,0"
                                                    Text="{Binding [Analytics], Source={x:Static lang:LangHelper.Instance}}"
                                                    TextWrapping="Wrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxHeight="40"
                                                    Opacity="{Binding AnalyticsPage_Opacity}">
                                <UXControls:UXTextBlock.Style>
                                    <Style TargetType="UXControls:UXTextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource DefaultTheme_TxtColor}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected[2]}" Value="True">
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </UXControls:UXTextBlock.Style>
                            </UXControls:UXTextBlock>
                            <Grid Grid.Column="1"
                                  Visibility="{Binding AnalyticsPage_LockTooltip}"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center" Margin="0,0,16,0"
                                  Width="16"
                                  Height="16">
                                <Path Data="M12.1 6.40012V4.00012C12.2 1.80012 10.5 0.100122 8.30005 0.00012207H8.10005C5.90005 0.00012207 4.10005 1.80012 4.10005 4.00012V6.40012H1.80005V16.0001H14.1V6.40012H12.1ZM5.30005 4.00012C5.20005 2.50012 6.40005 1.30012 7.80005 1.20012H8.20005C9.80005 1.20012 11 2.50012 11 4.00012V6.40012H5.30005V4.00012ZM13.1 14.9001H3.00005V7.50012H13.1V14.9001Z M7.60005 12.5001H8.60005V9.30012H6.80005V10.3001H7.60005V12.5001Z">
                                    <Path.ToolTip>
                                        <ToolTip>
                                            <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                                <Border.Resources>
                                                    <Style BasedOn="{StaticResource Tooltip_TextBlockStyle}" TargetType="TextBlock" />
                                                </Border.Resources>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding [ITLockToolTip.0], Source={x:Static lang:LangHelper.Instance}}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </ToolTip>
                                    </Path.ToolTip>
                                </Path>
                            </Grid>
                        </Grid>
                    </Border>
                    <!-- #end region Analytics -->
                    
                    <!-- #region Widget Settings -->
                    <!-- 
                            Focusable="True"
                    -->
                    <Border Margin="0,0,8,8"
                            Grid.Row="3"
                            Width="212" Height="64"
                            BorderThickness="2"
                            CornerRadius="13"
                            x:Name="Vbar_3"
                            MouseLeftButtonDown="WidgetSettingsButton_Click" PreviewKeyDown="WidgetSettingsButton_PreviewKeyDown">
                        <Border.Style>
                            <Style TargetType="Border"
                                   BasedOn="{StaticResource BorderBase}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected[3]}"
                                                 Value="True">
                                        <Setter Property="Background"
                                                Value="{DynamicResource VbarItem_HiBkColor}" />
                                        <Setter Property="BorderBrush"
                                                Value="{DynamicResource VbarItem_HiBdColor}" />
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <!-- Check if the item is not selected -->
                                            <Condition Binding="{Binding IsSelected[3]}" Value="False" />
                                            <!-- Check if the mouse is over the item -->
                                            <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="{DynamicResource Vbar_BkBrush_Hover}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Vbar_BkBrush_Hover}" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <!-- 
                                                    Text="{Binding [Widget_Settings], Source={x:Static lang:LangHelper.Instance}}"
                            -->
                            <UXControls:UXTextBlock Width="212" Focusable="True"
                                                    FontSize="14"
                                                    Grid.Column="0"
                                                    Margin="20,0"
                                                    Text="{Binding [Widget_Settings], Source={x:Static lang:LangHelper.Instance}}"
                                                     TextWrapping="Wrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxHeight="40"
                                                    >
                                <UXControls:UXTextBlock.Style>
                                    <Style TargetType="UXControls:UXTextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource DefaultTheme_TxtColor}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected[3]}" Value="True">
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </UXControls:UXTextBlock.Style>
                            </UXControls:UXTextBlock>
                        </Grid>
                    </Border>
                    <!-- #endregion Widget Settings -->
                    
                    <!-- #region About -->
                    <!-- Robert_Lin, 2025-2-9 for Narrator, for each Item, we let keyboard navigation tab stop on TextBlock only -->
                    <!-- 
                            Focusable="True"
                    -->
                    <Border Margin="0,0,8,8"
                            Grid.Row="4"
                            Width="212" Height="64"
                            BorderThickness="2"
                            CornerRadius="13"
                            x:Name="Vbar_4"
                            MouseLeftButtonDown="AboutButton_Click" PreviewKeyDown="AboutButton_PreviewKeyDown">
                        <Border.Style>
                            <Style TargetType="Border"
                                   BasedOn="{StaticResource BorderBase}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected[4]}"
                                                 Value="True">
                                        <Setter Property="Background"
                                                Value="{DynamicResource VbarItem_HiBkColor}" />
                                        <Setter Property="BorderBrush"
                                                Value="{DynamicResource VbarItem_HiBdColor}" />
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <!-- Check if the item is not selected -->
                                            <Condition Binding="{Binding IsSelected[4]}" Value="False" />
                                            <!-- Check if the mouse is over the item -->
                                            <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="{DynamicResource Vbar_BkBrush_Hover}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Vbar_BkBrush_Hover}" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <!-- 
                            
                                                      Text="{Binding [About], Source={x:Static lang:LangHelper.Instance}}"
                          -->
                            <UXControls:UXTextBlock Grid.Row="4" Focusable="True"
                                                    Width="212"
                                                    FontSize="14"
                                                     Margin="20,0"
                                                      Text="{Binding [About], Source={x:Static lang:LangHelper.Instance}}"
                                                     TextWrapping="Wrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxHeight="40"
                                                   >
                                <UXControls:UXTextBlock.Style>
                                    <Style TargetType="UXControls:UXTextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource DefaultTheme_TxtColor}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected[4]}" Value="True">
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </UXControls:UXTextBlock.Style>
                            </UXControls:UXTextBlock>
                        </Grid>
                    </Border>
                    <!-- #region About -->
                </Grid>

                <!--- Robert_Lin 2025-3-6 PIMS-348208 S-348208 Multiple Instances of Incorrect Padding (too much space) in Settings
                Move from bottom of this file.
                -->
                <!--20250331 Chewlin for PIMS-348208 change Margin="4,0,0,0" to Margin="4,4,4,4"-->
                <Grid Grid.Column="1">
                    <ContentControl Content="{Binding FullView}"  />
                </Grid>

            </Grid>
            <!--- Robert_Lin 2025-3-6 PIMS-348208 S-348208 Multiple Instances of Incorrect Padding (too much space) in Settings
            Move blow Grid into upper Grid Column 1
            OLD:
            <Grid Grid.Column="1" Margin="222,0,0,0"  >
                <ContentControl Content="{Binding FullView}"  />
            </Grid>
            -->
        </Grid>
    </Grid>
</UserControl>