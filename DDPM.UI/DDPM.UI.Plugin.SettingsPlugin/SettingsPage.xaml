<UserControl x:Class="DDPM.UI.Plugin.SettingsPlugin.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DDPM.UI.Plugin.SettingsPlugin"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:commonModel="clr-namespace:DDPM.UI.Common.Models;assembly=DDPM.UI.Common"
             xmlns:lang="clr-namespace:DDPM.UI.Resources.Helper;assembly=DDPM.UI.Resources"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ModuleStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Header control -->
            <RowDefinition Height="*" />
            <!-- Right Frame -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <UXControls:UXTextBlock Grid.Row="0" Grid.Column="0" Text="&#xe223; "
                                FontFamily="Segoe UI Symbol" FontSize="30"
                                HorizontalAlignment="Left" TextBlockType="Header2"
                                TextBlockSemanticColorType="Light"
                                MouseLeftButtonDown="leftArrow_MouseLeftButtonDown" />
        <UXControls:UXTextBlock Grid.Row="0" Grid.Column="1" Text="{Binding [Settings], Source={x:Static lang:LangHelper.Instance}}"
                                HorizontalAlignment="Left" TextBlockType="Header2"
                                TextBlockSemanticColorType="DefaultHeader"
                                Foreground="White"
                                FontSize="28" />
        <Grid Grid.Row="1" Grid.Column="1" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!--0614 Bruce 將按鈕改成UXTextBlock，事件也變更，讓風格更像figma，不影響功能作動-->
                    <Border Margin="4" Grid.Row="0" Width="212" BorderThickness="2" CornerRadius="13" Focusable="True" MouseLeftButtonDown="GeneralButton_Click">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Border_Test}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected[0]}"  Value="True">
                                        <Setter Property="Background"  Value="{StaticResource VbarItem_HiBkColor}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource VbarItem_HiBdColor}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <UXControls:UXTextBlock Grid.Row="0" FontSize="14" Margin="8,25,145,25" Foreground="White" Text="{Binding [General], Source={x:Static lang:LangHelper.Instance}}" AutomationProperties.Name="Primary1" />
                        </Grid>
                    </Border>
                    <Border Margin="4" Grid.Row="1" Width="212" BorderThickness="2" CornerRadius="13" Focusable="True" MouseLeftButtonDown="UpdatesButton_Click">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Border_Test}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected[1]}"  Value="True">
                                        <Setter Property="Background"  Value="{StaticResource VbarItem_HiBkColor}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource VbarItem_HiBdColor}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <UXControls:UXTextBlock Grid.Column="0" FontSize="14" Margin="8,25,5,25" Foreground="White" Text="{Binding [Updates], Source={x:Static lang:LangHelper.Instance}}" AutomationProperties.Name="Primary1" />
                            <Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsAnyUpdate}">
                                <Path Data="M7.5 10.5L7.5 3.5H8.5V10.5H7.5Z M7.5 11.5V12.5H8.5V11.5H7.5Z M0 8C0 3.58172 3.58172 0 8 0C12.4183 0 16 3.58172 16 8C16 12.4183 12.4183 16 8 16C3.58172 16 0 12.4183 0 8ZM8 1C4.13401 1 1 4.13401 1 8C1 11.866 4.13401 15 8 15C11.866 15 15 11.866 15 8C15 4.13401 11.866 1 8 1Z" Fill="#E67F01" />
                            </Grid>
                        </Grid>
                    </Border>
                    <Border Margin="4" Grid.Row="2" Width="212" BorderThickness="2" CornerRadius="13" Focusable="True" MouseLeftButtonDown="AnalyticsButton_Click">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Border_Test}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected[2]}"  Value="True">
                                        <Setter Property="Background"  Value="{StaticResource VbarItem_HiBkColor}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource VbarItem_HiBdColor}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <UXControls:UXTextBlock Grid.Row="2" Width="212" FontSize="14" Margin="8,25,145,25" Foreground="White" Text="{Binding [Analytics], Source={x:Static lang:LangHelper.Instance}}" AutomationProperties.Name="Primary1" />
                        </Grid>
                    </Border>
                    <Border Margin="4" Grid.Row="3" Width="212" BorderThickness="2" CornerRadius="13" Focusable="True" MouseLeftButtonDown="QuickSettingsButton_Click">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Border_Test}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected[3]}"  Value="True">
                                        <Setter Property="Background"  Value="{StaticResource VbarItem_HiBkColor}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource VbarItem_HiBdColor}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <UXControls:UXTextBlock Width="212" FontSize="14" Margin="8,25,-12,25" Foreground="White" Text="{Binding [QuickSettings], Source={x:Static lang:LangHelper.Instance}}" AutomationProperties.Name="Primary1" />
                        </Grid>
                    </Border>
                    <Border Margin="4" Grid.Row="4" Width="212" BorderThickness="2" CornerRadius="13" Focusable="True" MouseLeftButtonDown="AboutButton_Click">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Border_Test}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected[4]}"  Value="True">
                                        <Setter Property="Background"  Value="{StaticResource VbarItem_HiBkColor}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource VbarItem_HiBdColor}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <UXControls:UXTextBlock Grid.Row="4" Width="212" FontSize="14" Margin="8,25,145,25" Foreground="White" Text="{Binding [About], Source={x:Static lang:LangHelper.Instance}}" AutomationProperties.Name="Primary1" />
                        </Grid>
                    </Border>
                </Grid>
                <Grid Grid.Column="1">
                    <ContentControl Content="{Binding FullView}" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>