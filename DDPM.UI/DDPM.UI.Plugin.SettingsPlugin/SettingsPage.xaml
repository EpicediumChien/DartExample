<UserControl x:Class="DDPM.UI.Plugin.SettingsPlugin.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DDPM.UI.Plugin.SettingsPlugin"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:commonModel="clr-namespace:DDPM.UI.Common.Models;assembly=DDPM.UI.Common"
             xmlns:lang="clr-namespace:DDPM.UI.Resources.Helper;assembly=DDPM.UI.Resources"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Header control -->
            <RowDefinition Height="*" />
            <!-- Right Frame -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <UXControls:UXTextBlock Grid.Row="0"
                                Grid.Column="0"
                                Text="&#xe223; "
                                FontFamily="Segoe UI Symbol"
                                FontSize="30"
                                HorizontalAlignment="Left"
                                TextBlockType="Header2"
                                TextBlockSemanticColorType="Light"
                                MouseLeftButtonDown="leftArrow_MouseLeftButtonDown"
                                Foreground="{DynamicResource DefaultTheme_TxtColor}" />
        <UXControls:UXTextBlock Grid.Row="0" Grid.Column="1" Text="{Binding [Settings], Source={x:Static lang:LangHelper.Instance}}"
                                HorizontalAlignment="Left" TextBlockType="Header2"
                                FontSize="28"
                                Foreground="{DynamicResource DefaultTheme_TxtColor}" />
        <Grid Grid.Row="1" Grid.Column="1" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!--0614 Bruce 將按鈕改成UXTextBlock，事件也變更，讓風格更像figma，不影響功能作動-->
                    <Border Margin="0,4,4,4"
                            Grid.Row="0"
                            Width="212"
                            BorderThickness="2"
                            CornerRadius="13"
                            Focusable="True"
                            MouseLeftButtonDown="GeneralButton_Click">
                        <Border.Style>
                            <Style TargetType="Border"
                                   BasedOn="{StaticResource BorderBase}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected[0]}"
                                                 Value="True">
                                        <Setter Property="Background"
                                                Value="{StaticResource VbarItem_HiBkColor}" />
                                        <Setter Property="BorderBrush"
                                                Value="{StaticResource VbarItem_HiBdColor}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <UXControls:UXTextBlock Grid.Row="0"
                                                    FontSize="14"
                                                    Margin="8,25,145,25"
                                                    Text="{Binding [General], Source={x:Static lang:LangHelper.Instance}}"
                                                    AutomationProperties.Name="Primary1">
                                <UXControls:UXTextBlock.Style>
                                    <Style TargetType="UXControls:UXTextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource DefaultTheme_TxtColor}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected[0]}" Value="True">
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </UXControls:UXTextBlock.Style>
                            </UXControls:UXTextBlock>
                        </Grid>
                    </Border>
                    <Border Margin="0,4,4,4"
                            Grid.Row="1"
                            Width="212"
                            BorderThickness="2"
                            CornerRadius="13"
                            Focusable="True"
                            MouseLeftButtonDown="UpdatesButton_Click">
                        <Border.Style>
                            <Style TargetType="Border"
                                   BasedOn="{StaticResource BorderBase}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected[1]}"
                                                 Value="True">
                                        <Setter Property="Background"
                                                Value="{StaticResource VbarItem_HiBkColor}" />
                                        <Setter Property="BorderBrush"
                                                Value="{StaticResource VbarItem_HiBdColor}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding UpdatesPageUI_IsEnable}"
                                                 Value="False">
                                        <Setter Property="Background"
                                                Value="#596067" />
                                        <Setter Property="BorderBrush"
                                                Value="#596067" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <UXControls:UXTextBlock Grid.Column="0"
                                                    FontSize="14"
                                                    Margin="8,25,5,25"
                                                    Text="{Binding [Updates], Source={x:Static lang:LangHelper.Instance}}"
                                                    AutomationProperties.Name="Primary1"
                                                    Opacity="{Binding UpdatesPageUI_Opacity}">
                                <UXControls:UXTextBlock.Style>
                                    <Style TargetType="UXControls:UXTextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource DefaultTheme_TxtColor}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected[1]}" Value="True">
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </UXControls:UXTextBlock.Style>
                            </UXControls:UXTextBlock>
                            <Grid Grid.Column="1"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Visibility="{Binding IsAnyUpdate}">
                                <Path Data="M7.5 10.5L7.5 3.5H8.5V10.5H7.5Z M7.5 11.5V12.5H8.5V11.5H7.5Z M0 8C0 3.58172 3.58172 0 8 0C12.4183 0 16 3.58172 16 8C16 12.4183 12.4183 16 8 16C3.58172 16 0 12.4183 0 8ZM8 1C4.13401 1 1 4.13401 1 8C1 11.866 4.13401 15 8 15C11.866 15 15 11.866 15 8C15 4.13401 11.866 1 8 1Z"
                                      Fill="#E67F01" />
                            </Grid>
                            <Grid Grid.Column="1"
                                  Visibility="{Binding UpdatesPageUI_LockTooltip}"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center"
                                  Width="16"
                                  Height="16">
                                <Path Data="M12.1 6.40012V4.00012C12.2 1.80012 10.5 0.100122 8.30005 0.00012207H8.10005C5.90005 0.00012207 4.10005 1.80012 4.10005 4.00012V6.40012H1.80005V16.0001H14.1V6.40012H12.1ZM5.30005 4.00012C5.20005 2.50012 6.40005 1.30012 7.80005 1.20012H8.20005C9.80005 1.20012 11 2.50012 11 4.00012V6.40012H5.30005V4.00012ZM13.1 14.9001H3.00005V7.50012H13.1V14.9001Z M7.60005 12.5001H8.60005V9.30012H6.80005V10.3001H7.60005V12.5001Z" />
                            </Grid>
                        </Grid>
                    </Border>
                    <Border Margin="0,4,4,4"
                            Grid.Row="2"
                            Width="212"
                            BorderThickness="2"
                            CornerRadius="13"
                            Focusable="True"
                            MouseLeftButtonDown="AnalyticsButton_Click">
                        <Border.Style>
                            <Style TargetType="Border"
                                   BasedOn="{StaticResource BorderBase}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected[2]}"
                                                 Value="True">
                                        <Setter Property="Background"
                                                Value="{StaticResource VbarItem_HiBkColor}" />
                                        <Setter Property="BorderBrush"
                                                Value="{StaticResource VbarItem_HiBdColor}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding AnalyticsPage_IsEnable}"
                                                 Value="False">
                                        <Setter Property="Background"
                                                Value="#596067" />
                                        <Setter Property="BorderBrush"
                                                Value="#596067" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <UXControls:UXTextBlock Grid.Column="0"
                                                    Width="212"
                                                    FontSize="14"
                                                    Margin="8,25,0,25"
                                                    Text="{Binding [Analytics], Source={x:Static lang:LangHelper.Instance}}"
                                                    AutomationProperties.Name="Primary1"
                                                    Opacity="{Binding AnalyticsPage_Opacity}">
                                <UXControls:UXTextBlock.Style>
                                    <Style TargetType="UXControls:UXTextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource DefaultTheme_TxtColor}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected[2]}" Value="True">
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </UXControls:UXTextBlock.Style>
                            </UXControls:UXTextBlock>
                            <Grid Grid.Column="1"
                                  Visibility="{Binding AnalyticsPage_LockTooltip}"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center"
                                  Width="16"
                                  Height="16">
                                <Path Data="M12.1 6.40012V4.00012C12.2 1.80012 10.5 0.100122 8.30005 0.00012207H8.10005C5.90005 0.00012207 4.10005 1.80012 4.10005 4.00012V6.40012H1.80005V16.0001H14.1V6.40012H12.1ZM5.30005 4.00012C5.20005 2.50012 6.40005 1.30012 7.80005 1.20012H8.20005C9.80005 1.20012 11 2.50012 11 4.00012V6.40012H5.30005V4.00012ZM13.1 14.9001H3.00005V7.50012H13.1V14.9001Z M7.60005 12.5001H8.60005V9.30012H6.80005V10.3001H7.60005V12.5001Z" />
                            </Grid>
                        </Grid>
                    </Border>
                    <Border Margin="0,4,4,4"
                            Grid.Row="3"
                            Width="212"
                            BorderThickness="2"
                            CornerRadius="13"
                            Focusable="True"
                            MouseLeftButtonDown="WidgetSettingsButton_Click">
                        <Border.Style>
                            <Style TargetType="Border"
                                   BasedOn="{StaticResource BorderBase}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected[3]}"
                                                 Value="True">
                                        <Setter Property="Background"
                                                Value="{StaticResource VbarItem_HiBkColor}" />
                                        <Setter Property="BorderBrush"
                                                Value="{StaticResource VbarItem_HiBdColor}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <UXControls:UXTextBlock Width="212"
                                                    FontSize="14"
                                                    Margin="8,25,-12,25"
                                                    Text="Widget Settings"
                                                    AutomationProperties.Name="Primary1">
                                <UXControls:UXTextBlock.Style>
                                    <Style TargetType="UXControls:UXTextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource DefaultTheme_TxtColor}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected[3]}" Value="True">
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </UXControls:UXTextBlock.Style>
                            </UXControls:UXTextBlock>
                        </Grid>
                    </Border>
                    <Border Margin="0,4,4,4"
                            Grid.Row="4"
                            Width="212"
                            BorderThickness="2"
                            CornerRadius="13"
                            Focusable="True"
                            MouseLeftButtonDown="AboutButton_Click">
                        <Border.Style>
                            <Style TargetType="Border"
                                   BasedOn="{StaticResource BorderBase}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected[4]}"
                                                 Value="True">
                                        <Setter Property="Background"
                                                Value="{StaticResource VbarItem_HiBkColor}" />
                                        <Setter Property="BorderBrush"
                                                Value="{StaticResource VbarItem_HiBdColor}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <UXControls:UXTextBlock Grid.Row="4"
                                                    Width="212"
                                                    FontSize="14"
                                                    Margin="8,25,145,25"
                                                    Text="{Binding [About], Source={x:Static lang:LangHelper.Instance}}"
                                                    AutomationProperties.Name="Primary1">
                                <UXControls:UXTextBlock.Style>
                                    <Style TargetType="UXControls:UXTextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource DefaultTheme_TxtColor}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected[4]}" Value="True">
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </UXControls:UXTextBlock.Style>
                            </UXControls:UXTextBlock>
                        </Grid>
                    </Border>
                </Grid>
                <Grid Grid.Column="1">
                    <ContentControl Content="{Binding FullView}" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>