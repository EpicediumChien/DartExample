<UserControl x:Class="DDPM.UI.Plugin.SettingsPlugin.UpdatesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DDPM.UI.Plugin.SettingsPlugin"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:commonModel="clr-namespace:DDPM.UI.Common.Models;assembly=DDPM.UI.Common"
             xmlns:SAAlert="clr-namespace:DDPM.SA.Common.Alert;assembly=DDPM.SA.Common"
             xmlns:lang="clr-namespace:DDPM.UI.Resources.Helper;assembly=DDPM.UI.Resources"
             mc:Ignorable="d" 
             Margin="5,4,0,29"
             d:DesignHeight="450"
             d:DesignWidth="800"
             SizeChanged="UserControl_SizeChanged">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="ModuleStyle.xaml" />-->
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid 
          Opacity="{Binding UpdatesPageUI_Opacity}">
        <UXControls:UXScrollViewer>
            <Border Style="{StaticResource GroupBorderStyle}" CornerRadius="13">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource PartBorderStyle}" BorderThickness="0" CornerRadius="13" Grid.Row="1" Margin="20" />
                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <UXControls:UXTextBlock Foreground="{DynamicResource DefaultTheme_TxtColor}" FontSize="20" Grid.Row="0" Text="{Binding [Updates.0], Source={x:Static lang:LangHelper.Instance}}" TextBlockType="Header1" HorizontalAlignment="Left" Margin="20,20,8,8" />
                        <UXControls:UXTextBlock Foreground="{DynamicResource DefaultTheme_TxtColor}" FontSize="16" Grid.Row="1" TextWrapping="WrapWithOverflow" Text="{Binding [Updates.1], Source={x:Static lang:LangHelper.Instance}}" TextBlockType="Subtitle1" HorizontalAlignment="Left" Margin="20,8,8,8" />
                    </Grid>
                    <Grid Grid.Row="1" x:Name="UpdatesPageUI">
                        <StackPanel Margin="24">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Margin="0,0,0,24" Orientation="Horizontal" x:Name="spFWUpdate">
                                    <Button Width="176"
                                            Height="40"
                                            Click="CheckUpdate_Click"
                                            Cursor="Hand"
                                            Margin="20,20,8,8"
                                            Visibility="Visible"
                                            x:Name="btnFWU"
                                            HorizontalAlignment="Left"
                                            AutomationProperties.Name="Primary1"
                                            Content="{Binding [Updates.2], Source={x:Static lang:LangHelper.Instance}}"
                                            Style="{StaticResource Button_WhiteFrame}" >
                                    </Button>
                                    <StackPanel Orientation="Horizontal">
                                        <Grid  Height="20"
                                               Margin="16,20,4,0"
                                               HorizontalAlignment="Left">
                                            <Path Data="M7.99994 1.26C9.05321 1.26151 10.0914 1.51022 11.031 1.98612C11.9707 2.46201 12.7855 3.1518 13.4099 4H10.2799V5.05H15.3299V0H14.2599V3.32C13.275 2.01027 11.9036 1.04304 10.3392 0.554923C8.77488 0.0668019 7.09673 0.0824552 5.54176 0.599671C3.9868 1.11689 2.63361 2.10953 1.67331 3.4374C0.713006 4.76528 0.194123 6.36128 0.189941 8H1.25994C1.25994 6.21244 1.97005 4.4981 3.23404 3.2341C4.49804 1.97011 6.21238 1.26 7.99994 1.26Z M14.7399 8C14.7358 9.41548 14.2861 10.7937 13.4546 11.9393C12.6231 13.0848 11.4521 13.9395 10.1076 14.3821C8.76312 14.8248 7.31339 14.8329 5.96403 14.4053C4.61466 13.9777 3.43416 13.1362 2.58994 12H5.71994V11H0.719941V16H1.73994V12.68C2.72484 13.9897 4.09632 14.957 5.66066 15.4451C7.225 15.9332 8.90316 15.9175 10.4581 15.4003C12.0131 14.8831 13.3663 13.8905 14.3266 12.5626C15.2869 11.2347 15.8058 9.63872 15.8099 8H14.7399Z" />
                                        </Grid>
                                        <UXControls:UXTextBlock FontSize="14"
                                                                Foreground="{DynamicResource DefaultTheme_TxtColor}"
                                                                Text="{Binding Path=LastCheckDate}"
                                                                TextBlockType="Caption"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Center"
                                                                Margin="4,21,8,8" />
                                    </StackPanel>
                                </StackPanel>
                                <!-- change to stackpanel as above for RWD  Derek 10/15 -->
                                <!-- 
                                <Grid Grid.Row="0" Margin="0,0,0,24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource BorderUnpair}" Width="176" MouseLeftButtonDown="CheckUpdate_Click" Cursor="Hand" Margin="20,20,8,8" Visibility="Visible" x:Name="btnFWU">
                                        <Grid>
                                            <UXControls:UXTextBlock Text="{Binding [Updates.2], Source={x:Static lang:LangHelper.Instance}}" Foreground="#F5F6F7" VerticalAlignment="Center" HorizontalAlignment="Center" FontFamily="Roboto" FontSize="14"/>
                                        </Grid>
                                    </Border>
                                    <Image Grid.Column="1" Source="Resources\double arrow.png" Height="20" Margin="16,0,4,0" />
                                    <UXControls:UXTextBlock Grid.Column="2" FontSize="14" Text="{Binding Path=LastCheckDate}" TextBlockType="Caption" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,8,8,8" />
                                </Grid> -->
                                <StackPanel Grid.Row="1" Margin="0,0,0,24" Visibility="{Binding NoUpdateAlert}" x:Name="spSAAlert">
                                    <!-- Updates.3 for testing Derek 10/12 -->
                                    <SAAlert:AlertBase Height="53" x:Name="alertBase" Margin="20,16,0,0" AlertType="Info" Message="{Binding [Updates.3], Source={x:Static lang:LangHelper.Instance}}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Margin="0,0,0,24" Visibility="{Binding NoNetwork}">
                                    <UXControls:UXAlert Margin="20,16,16,17" HorizontalAlignment="Stretch">
                                        <UXControls:UXAlertItem AlertItemType="Critical" Margin="8,8,8,8" Label="" Message="{Binding [Updates.4], Source={x:Static lang:LangHelper.Instance}}" />
                                    </UXControls:UXAlert>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Margin="0,0,0,24" Visibility="{Binding Critical_UpdateList}">
                                    <UXControls:UXTextBlock Foreground="{DynamicResource DefaultTheme_TxtColor}" Margin="20,16,0,0" FontSize="16" Grid.Row="0" Text="{Binding [Critical], Source={x:Static lang:LangHelper.Instance}}" TextBlockType="Header1" HorizontalAlignment="Left" />
                                    <ListBox PreviewMouseWheel="HandlePreviewMouseWheel" Height="auto" ItemsSource="{Binding Critical_UpdateList_UI}" Name="listTopics" Background="Transparent" BorderThickness="0" Margin="20,0,0,0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <UXControls:UXCheckBox FontSize="14"
                                                                           IsEnabled="{Binding IsEnableCheckBox}"
                                                                           Content="{Binding UpdateInfo}"
                                                                           IsChecked="{Binding IsCheckUpdate}"
                                                                           Foreground="{DynamicResource TextBlock_ForegroundColor}"
                                                                           Margin="0,20,0,20" />
                                                        <UXControls:UXAlert Visibility="{Binding UXAlertItemVisibility}" Margin="0,17,16,17">
                                                            <UXControls:UXAlertItem Background="#364861" AlertItemType="Info"  Message="{Binding UXAlertItemMessage}" Opacity="0.6" />
                                                        </UXControls:UXAlert>
                                                        <UXControls:UXAlert Visibility="{Binding UXAlertItemVisibility_2}"
                                                                        Margin="0,17,16,17">
                                                            <UXControls:UXAlertItem Background="#364861"
                                                                                AlertItemType="Info"
                                                                                Message="{Binding UXAlertItemMessage_2}"
                                                                                Opacity="0.6" />
                                                        </UXControls:UXAlert>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                <StackPanel  Grid.Row="2" Margin="0,0,0,24" Visibility="{Binding Recommended_UpdateList}">
                                    <UXControls:UXTextBlock Foreground="{DynamicResource DefaultTheme_TxtColor}" FontSize="16" Grid.Row="0" Text="Recommended" TextBlockType="Header1" HorizontalAlignment="Left" Margin="20,16,0,0" />
                                    <ListBox PreviewMouseWheel="HandlePreviewMouseWheel" Height="auto" ItemsSource="{Binding Recommended_UpdateList_UI}" Background="Transparent" BorderThickness="0" Margin="20,0,0,0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <UXControls:UXCheckBox FontSize="14"
                                                                           IsEnabled="{Binding IsEnableCheckBox}"
                                                                           Content="{Binding UpdateInfo}"
                                                                           IsChecked="{Binding IsCheckUpdate}"
                                                                           Foreground="{DynamicResource TextBlock_ForegroundColor}"
                                                                           Margin="0,20,0,20" />
                                                    <UXControls:UXAlert Visibility="{Binding UXAlertItemVisibility}" Margin="0,17,16,17" HorizontalAlignment="Stretch">
                                                        <UXControls:UXAlertItem Background="#364861" AlertItemType="Info"  Message="{Binding UXAlertItemMessage}" Opacity="0.6" />
                                                    </UXControls:UXAlert>
                                                    <UXControls:UXAlert Visibility="{Binding UXAlertItemVisibility_2}"
                                                                        Margin="0,17,16,17" HorizontalAlignment="Stretch">
                                                        <UXControls:UXAlertItem Background="#364861"
                                                                                AlertItemType="Info"
                                                                                Message="{Binding UXAlertItemMessage_2}"
                                                                                Opacity="0.6" />
                                                    </UXControls:UXAlert>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                                <StackPanel Grid.Row="3" Visibility="{Binding Optional_UpdateList}">
                                    <UXControls:UXTextBlock Foreground="{DynamicResource DefaultTheme_TxtColor}" FontSize="16" Grid.Row="0" Text="{Binding [Optional], Source={x:Static lang:LangHelper.Instance}}" TextBlockType="Header1" HorizontalAlignment="Left" Margin="20,4,4,4" />
                                    <ListBox PreviewMouseWheel="HandlePreviewMouseWheel" Height="auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" ItemsSource="{Binding Optional_UpdateList_UI}" Background="Transparent" BorderThickness="0" Margin="20,0,0,0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <UXControls:UXCheckBox FontSize="14"
                                                                           IsEnabled="{Binding IsEnableCheckBox}"
                                                                           Content="{Binding UpdateInfo}"
                                                                           IsChecked="{Binding IsCheckUpdate}"
                                                                           Foreground="{DynamicResource TextBlock_ForegroundColor}"
                                                                           Margin="0,20,0,20" />
                                                        <UXControls:UXAlert Visibility="{Binding UXAlertItemVisibility}" Margin="0,17,16,17" HorizontalAlignment="Stretch">
                                                            <UXControls:UXAlertItem Background="#364861" AlertItemType="Info"  Message="{Binding UXAlertItemMessage}" Opacity="0.6" />
                                                        </UXControls:UXAlert>
                                                        <UXControls:UXAlert Visibility="{Binding UXAlertItemVisibility_2}"
                                                                        Margin="0,17,16,17" HorizontalAlignment="Stretch">
                                                            <UXControls:UXAlertItem Background="#364861"
                                                                                AlertItemType="Info"
                                                                                Message="{Binding UXAlertItemMessage_2}"
                                                                                Opacity="0.6" />
                                                        </UXControls:UXAlert>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                <Grid Grid.Row="4" Margin="4" Visibility="{Binding IsAnyUpdate}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Width="195"
                                            Height="40"
                                            AutomationProperties.Name="Primary1"
                                            Style="{DynamicResource Buttom_BlueFrame}"
                                            Click="DownloadAndInstall_Click"
                                            Content="{Binding [Updates.5], Source={x:Static lang:LangHelper.Instance}}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Margin="20,8,8,8" />
                                    <UXControls:UXBusyIndicator x:Name="DownloadUXBusyIndicator" Grid.Column="1" BusyIndicatorType="Secondary" HorizontalAlignment="Left" IsActive="False" Visibility="Hidden"/>
                                    <!--<UXControls:UXTextBlock x:Name="DownloadUXTextBlock" Grid.Column="2" Text="{Binding [Updates.6], Source={x:Static lang:LangHelper.Instance}}" TextBlockType="Header1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0" Visibility="Hidden"/>-->
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </UXControls:UXScrollViewer>
        <Border Name="DisableAll"
                Background="#4C24273C">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility"
                            Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBusy_UpdatePage}"
                                     Value="True">
                            <Setter Property="Visibility"
                                    Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <!--  Add a UXBusyIndicator from Robert  -->
            <UXControls:UXBusyIndicator Width="64"
                                        Height="64"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        BusyIndicatorType="Secondary"
                                        IsActive="{Binding IsBusy_UpdatePage}" />
        </Border>
        <Border Background="#132F54"
         Opacity="0.2"
         CornerRadius="13" Visibility="{Binding UpdatesPageUI_LockTooltip}"/>
    </Grid>
</UserControl>