<UserControl x:Class="DDPM.UI.Plugin.SettingsPlugin.AnalyticsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DDPM.UI.Plugin.SettingsPlugin"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             mc:Ignorable="d" Margin="5,4,60,120"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Border Background="#99132F54" CornerRadius="13">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="150"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <UXControls:UXTextBlock Text="{Binding strTitle}" Foreground="White" Margin="20" FontSize="24" Grid.Row="0"/>
                <Border Background="#99132F54" CornerRadius="13" Grid.Row="1" Margin="20,0,20,0" >
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*" x:Name="privacy_policy_height"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <UXControls:UXTextBlock Text="{Binding strContent}" 
                                                Grid.Row="0" Margin="20,14,0,0" Foreground="White" FontSize="18"/>
                        <UXControls:UXButton Name="url_btn" Content="{Binding strUrlBtnContent}" ButtonType="Secondary" Margin="20,0,20,0" Foreground="White" 
                                             FontSize="16" Grid.Row="1" Width="250" HorizontalAlignment="Left" Click="url_btn_Click" BorderBrush="White"/>
                        <UXControls:UXCheckBox Name="chk_analytics" Content="{Binding strCheckBtnText}" HorizontalAlignment="Left" 
                                               IsEnabled="{Binding isCheckEnable}" IsChecked="{Binding isConsentChecked}"
                                               Margin="20,0,0,0" Grid.Row="2" FontSize="20" Foreground="White"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
