<UserControl x:Class="DDPM.UI.Plugin.SettingsPlugin.Settings_About"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             xmlns:local="clr-namespace:DDPM.UI.Plugin.SettingsPlugin" d:DataContext="{d:DesignInstance Type=local:SettingsPageViewModel}"
             xmlns:lang="clr-namespace:DDPM.UI.Resources.Helper;assembly=DDPM.UI.Resources"
             mc:Ignorable="d"
             Margin="5,4,0,29"
             d:DesignHeight="450"
             d:DesignWidth="800">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DDPM.UI.Common;component/PluginStyles.xaml" />
                <!-- <ResourceDictionary Source="/DDPM.UI.Common;component/ModuleStyle.xaml" /> -->
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <UXControls:UXScrollViewer>
            <!-- Robert_Lin 2025-3-6 PIMS-348208 S-348208 Multiple Instances of Incorrect Padding (too much space) in Settings 
            Fix Margins of UI elements 
            -->
            <Border Style="{StaticResource GroupBorderStyle}"
                    CornerRadius="13">
                <StackPanel>
                    <!-- Robert_Lin 2025-3-6, OLD: <Grid Margin="20,20,8,8">
                    Add to UXTextBlock: VerticalAlignment="Center" -->
                    <Grid Margin="0,0,0,0" Height="28">
                        <UXControls:UXTextBlock Text="{Binding [About], Source={x:Static lang:LangHelper.Instance}}"
                                                FontSize="20" Focusable="True" TextBlockType="Header1"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource DefaultTheme_TxtColor}"/>
                    </Grid>

                    <!-- Robert_Lin 2025-3-6, OLD: <Grid Margin="20,20,8,8"> -->
                    <Grid Margin="0,24,0,24">
                        <!-- PartBorderStyle Padding="16" -->
                        <Border Style="{StaticResource PartBorderStyle}"
                                BorderThickness="0" CornerRadius="6">
                            <!-- OLD: Margin="15,0,0,0" -->
                            <StackPanel Orientation="Vertical"
                                        Margin="8">
                                <!-- OLD: Margin="0,5,0,0"  -->
                                <UXControls:UXTextBlock Margin="0,0,0,0" Focusable="True"
                                                        FontSize="16"
                                                        Text="{Binding SWVersion}"
                                                        Foreground="{DynamicResource DefaultTheme_TxtColor}" />
                                <UXControls:UXTextBlock Margin="0,5,0,0" Focusable="True"
                                                        FontSize="16"
                                                        Text="{Binding DriverVersion}"
                                                        Foreground="{DynamicResource DefaultTheme_TxtColor}" />
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,0">
                                    <!-- Derek 2025/01/11 for PIMS-334386 -->
                                    <!-- OLD: Margin="0,20,5,20" -->
                                    <Button Style="{DynamicResource Button_WhiteFrame}"
                                            MinWidth="176"
                                            Height="40"
                                            Click="ThirdPartyLicenses_Click"
                                            Cursor="Hand"
                                            Margin="0,20,5,0"
                                            Visibility="Visible"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            FontFamily="Roboto"
                                            FontSize="14">
                                        <Button.Content>
                                            <TextBlock Margin="10,0,10,0" Text ="{Binding [Third_Party_Licenses], Source={x:Static lang:LangHelper.Instance}}"/>
                                        </Button.Content>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <!-- OLD:
                     <Grid Margin="20,20,8,8">
                    Add to UXTextBlock: VerticalAlignment="Center" -->
                    <Grid Margin="0,0,8,0" Height="28">
                        <UXControls:UXTextBlock Text="{Binding [Help], Source={x:Static lang:LangHelper.Instance}}"
                                                FontSize="20" Focusable="True" VerticalAlignment="Center" TextBlockType="Header1"
                                                Foreground="{DynamicResource DefaultTheme_TxtColor}"/>
                    </Grid>
                    <!-- OLD:
                     <Grid Margin="20,20,8,8">
                   -->
                    <Grid Margin="0,24,8,8">
                        <Border Style="{StaticResource PartBorderStyle}"
                                BorderThickness="0" CornerRadius="6">
                            <!-- OLD: Margin="15,0,0,0" -->
                            <StackPanel Orientation="Vertical"
                                        Margin="8">
                                <!-- OLD:  Margin="0,20,0,0" -->
                                <UXControls:UXTextBlock Margin="0,0,0,0" Focusable="True"
                                                        FontSize="16"
                                                        Text="{Binding [Need_help], Source={x:Static lang:LangHelper.Instance}}"
                                                        Foreground="{DynamicResource DefaultTheme_TxtColor}"
                                                        TextWrapping="WrapWithOverflow"/>
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,0">
                                    <!-- Derek 20250111 for PIMS-334386 -->
                                    <!-- OLD: Margin="0,20,5,20" -->
                                    <Button Style="{DynamicResource Button_WhiteFrame}"
                                            MinWidth="176"
                                            Height="40"
                                            Click="LearnMore_Click"
                                            Cursor="Hand"
                                            Margin="0,20,5,0"
                                            Visibility="Visible"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            FontFamily="Roboto"
                                            FontSize="14">
                                        <Button.Content>
                                            <TextBlock Margin="10,0,10,0" Text="{Binding [Learn_more], Source={x:Static lang:LangHelper.Instance}}"/>
                                        </Button.Content>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </UXControls:UXScrollViewer>
    </Grid>
</UserControl>
