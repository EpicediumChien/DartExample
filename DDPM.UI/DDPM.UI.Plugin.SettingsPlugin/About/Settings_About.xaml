<UserControl x:Class="DDPM.UI.Plugin.SettingsPlugin.Settings_About"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             xmlns:local="clr-namespace:DDPM.UI.Plugin.SettingsPlugin" d:DataContext="{d:DesignInstance Type=local:SettingsPageViewModel}"
             xmlns:lang="clr-namespace:DDPM.UI.Resources.Helper;assembly=DDPM.UI.Resources"
             mc:Ignorable="d"
             Margin="5,4,60,29"
             d:DesignHeight="450"
             d:DesignWidth="800">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DDPM.UI.Common;component/PluginStyles.xaml" />
                <!-- <ResourceDictionary Source="/DDPM.UI.Common;component/ModuleStyle.xaml" /> -->
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <UXControls:UXScrollViewer>
            <Border Style="{StaticResource GroupBorderStyle}"
                    CornerRadius="13">
                <StackPanel>
                    <Grid Margin="20,20,8,8">
                        <UXControls:UXTextBlock Text="{Binding [About], Source={x:Static lang:LangHelper.Instance}}"
                                                FontSize="20"
                                                TextBlockType="Header1"
                                                Foreground="{DynamicResource DefaultTheme_TxtColor}"/>
                    </Grid>
                    <Grid Margin="20,20,8,8">
                        <Border Style="{StaticResource PartBorderStyle}"
                                CornerRadius="6">
                            <StackPanel Orientation="Vertical"
                                        Margin="15,0,0,0">
                                <UXControls:UXTextBlock Margin="0,5,0,0"
                                                        FontSize="16"
                                                        Text="{Binding SWVersion}"
                                                        Foreground="{DynamicResource DefaultTheme_TxtColor}" />
                                <UXControls:UXTextBlock Margin="0,5,0,0"
                                                        FontSize="16"
                                                        Text="{Binding DriverVersion}"
                                                        Foreground="{DynamicResource DefaultTheme_TxtColor}" />
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,0">
                                    <Button Style="{DynamicResource Button_WhiteFrame}"
                                            Width="176"
                                            Height="40"
                                            Click="ThirdPartyLicenses_Click"
                                            Cursor="Hand"
                                            Margin="0,20,5,20"
                                            Visibility="Visible"
                                                                    VerticalAlignment="Center"
                                                                    HorizontalAlignment="Center"
                                                                    FontFamily="Roboto"
                                                                    FontSize="14"
                                            Content="{Binding [Third_Party_Licenses], Source={x:Static lang:LangHelper.Instance}}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid Margin="20,20,8,8">
                        <UXControls:UXTextBlock Text="{Binding [Help], Source={x:Static lang:LangHelper.Instance}}"
                                                FontSize="20"
                                                Foreground="{DynamicResource DefaultTheme_TxtColor}"/>
                    </Grid>
                    <Grid Margin="20,20,8,8">
                        <Border Style="{StaticResource PartBorderStyle}"
                                CornerRadius="6">
                            <StackPanel Orientation="Vertical"
                                        Margin="15,0,0,0">
                                <UXControls:UXTextBlock Margin="0,20,0,0"
                                                        FontSize="16"
                                                        Text="{Binding [Need_help], Source={x:Static lang:LangHelper.Instance}}"
                                                        Foreground="{DynamicResource DefaultTheme_TxtColor}"
                                                        TextWrapping="WrapWithOverflow"/>
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,0">
                                    <Button Style="{DynamicResource Button_WhiteFrame}"
                                            Width="176"
                                            Height="40"
                                            Click="LearnMore_Click"
                                            Cursor="Hand"
                                            Margin="0,20,5,20"
                                            Visibility="Visible"
                                            Content="{Binding [Learn_more], Source={x:Static lang:LangHelper.Instance}}"
                                                                    VerticalAlignment="Center"
                                                                    HorizontalAlignment="Center"
                                                                    FontFamily="Roboto"
                                            FontSize="14" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </UXControls:UXScrollViewer>
    </Grid>
</UserControl>
