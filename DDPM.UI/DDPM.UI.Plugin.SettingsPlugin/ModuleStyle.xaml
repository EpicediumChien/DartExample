    <SolidColorBrush x:Key="Tooltip_BkColor" Color="#FF1D2C3B" />
    <SolidColorBrush x:Key="Tooltip_BdColor" Color="#FF293B4D" />
    <SolidColorBrush x:Key="Tooltip_TextColor" Color="#FFF5F6F7" />
    <sys:Double x:Key="Tooltip_FontSize">12</sys:Double>
    <Thickness x:Key="Tooltip_BdThick">1</Thickness>
    <CornerRadius x:Key="Tooltip_Radius">4</CornerRadius>
    <Thickness x:Key="Tooltip_Padding">12,8</Thickness>

    <Style x:Key="Tooltip_OutterBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Tooltip_BkColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource Tooltip_BdColor}" />
        <Setter Property="BorderThickness" Value="{StaticResource Tooltip_BdThick}" />
        <Setter Property="CornerRadius" Value="{StaticResource Tooltip_Radius}" />
        <Setter Property="Padding" Value="{StaticResource Tooltip_Padding}" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="8" Color="#2D000000" Opacity="0.4"
                              Direction="315" ShadowDepth="3" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Tooltip_TextBlockStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Tooltip_TextColor}" />
        <Setter Property="FontSize" Value="{StaticResource Tooltip_FontSize}" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>