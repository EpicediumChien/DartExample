<UserControl x:Class="DDPM.UI.Plugin.SettingsPlugin.Settings_WidgetSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             xmlns:local="clr-namespace:DDPM.UI.Plugin.SettingsPlugin"
             xmlns:lang="clr-namespace:DDPM.UI.Resources.Helper;assembly=DDPM.UI.Resources"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800"
             SizeChanged="UserControl_SizeChanged">
    <!--20250331 Chewlin for PIMS-348208 Remove above Margin="5,4,0,29"-->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DDPM.UI.Common;component/PluginStyles.xaml" />
                <!-- <ResourceDictionary Source="/DDPM.UI.Common;component/ModuleStyle.xaml" /> -->
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <!-- Robert_Lin 2025-3-6 PIMS-348208 S-348208 Multiple Instances of Incorrect Padding (too much space) in Settings 
            Fix Margins of UI elements 
            -->
        <Border Style="{StaticResource GroupBorderStyle}"
                    CornerRadius="13">
            <!--20250331 Chewlin for PIMS-348208 ADD ScrollViewer.VerticalScrollBarVisibility="Disabled"-->
            <UXControls:UXScrollViewer ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- OLD:  <Grid Margin="20,20,8,8">
                    NEW: Add to UXTextBlock: VerticalAlignment="Center"
                    -->
                    <Grid Margin="0,0,0,0" Height="28">
                        <UXControls:UXTextBlock Text="{Binding [Widget_Settings], Source={x:Static lang:LangHelper.Instance}}"
                                                FontSize="20" Focusable="True" VerticalAlignment="Center"
                                                TextBlockType="Header1"
                                                TextWrapping="WrapWithOverflow"
                                                Foreground="{DynamicResource DefaultTheme_TxtColor}"/>
                    </Grid>
                    <!-- OLD: <Grid Margin="20,20,8,8"> -->
                    <Grid Margin="0,24,0,0">
                        <Border Style="{StaticResource PartBorderStyle}" BorderThickness="0" x:Name="borderContent"
                                CornerRadius="6">
                            <!-- OLD:
                            <StackPanel Orientation="Vertical" Margin="15,0,0,0">
                            -->
                            <StackPanel Orientation="Vertical">
                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Robert_Lin 2025-3-6 Add  HorizontalAlignment="Left"  FontWeight="Medium" -->
                                    <UXControls:UXTextBlock Grid.Column="0" x:Name="activateTextBlock" Focusable="True"
                                                            Text="{Binding [Activate_Quick_Access_widget_during_Zoom_conference_calls], Source={x:Static lang:LangHelper.Instance}}"
                                                            FontSize="16" HorizontalAlignment="Left" FontWeight="Medium"
                                                            FontFamily="Roboto"
                                                            TextBlockType="Caption"
                                                            TextWrapping="WrapWithOverflow"
                                                            Foreground="{DynamicResource DefaultTheme_TxtColor}"/>

                                    <UXControls:UXToggleSwitch Grid.Column="1" Height="Auto"
                                                               FontSize="14"
                                                               IsChecked="{Binding Path= GlobalSettingParam.GlobalSetting_WidgetSettings.EnableQuickAccessWidget}"
                                                               ContentTextVisibility="True"
                                                               Content="{Binding Path=EnableQuickAccessWidget_String}"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextBlock_ForegroundColor}"
                                                               Click="EnableQuickAccessWidget_Click" />
                                </Grid>
                                <UXControls:UXTextBlock Text="{Binding [Widget_will_automatically_appear_when_meeting_begins], Source={x:Static lang:LangHelper.Instance}}"
                                                        FontSize="14" Focusable="True"
                                                        TextBlockType="Caption"
                                                        TextWrapping="WrapWithOverflow"
                                                        Foreground="{DynamicResource DefaultTheme_TxtColor}"/>
                                <!-- OLD:   <Grid Height="40" Margin="0,9">-->
                                <Grid Height="40"
                                      Margin="0,16,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <!-- 定义一行 and Add VerticalAlignment="Center" chewlin Fix PIMS-348202 20250312-->
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Robert_Lin 2025-3-6 Add  HorizontalAlignment="Left"  FontWeight="Medium" FontFamily="Roboto" -->
                                    <UXControls:UXTextBlock Grid.Column="0" Focusable="True"
                                                            x:Name="enableShortcutTextBlock"
                                                            Text="{Binding [Enable_shortcut_reminder_for_Quick_Accesswidget], Source={x:Static lang:LangHelper.Instance}}"
                                                            FontSize="16"  HorizontalAlignment="Left" FontWeight="Medium"              
                                                            FontFamily="Roboto"
                                                            TextBlockType="Caption"
                                                            TextWrapping="WrapWithOverflow"
                                                            VerticalAlignment="Center"
                                                            Foreground="{DynamicResource DefaultTheme_TxtColor}" />
                                    <UXControls:UXToggleSwitch Grid.Column="1"
                                                               FontSize="14"
                                                               IsChecked="{Binding Path= GlobalSettingParam.GlobalSetting_WidgetSettings.EnableQuickAccessWidget_Reminder}"
                                                               ContentTextVisibility="True"
                                                               Content="{Binding Path=EnableQuickAccessWidget_Reminder_String}"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextBlock_ForegroundColor}"
                                                               Click="QuickAccessWidget_Reminder_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </UXControls:UXScrollViewer>
        </Border>
    </Grid>
</UserControl>
