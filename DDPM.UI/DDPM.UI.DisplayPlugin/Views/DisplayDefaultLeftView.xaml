<UserControl x:Class="DDPM.UI.Plugin.DisplayPlugin.Views.DisplayDefaultLeftView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:DDPMUserControls="clr-namespace:DDPM.UI.Common;assembly=DDPM.UI.Common"
             xmlns:common="clr-namespace:DDPM.UI.Common;assembly=DDPM.UI.Common"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DDPM.UI.Plugin.DisplayPlugin.Views"
             xmlns:lang="clr-namespace:DDPM.UI.Resources.Helper;assembly=DDPM.UI.Resources"
             mc:Ignorable="d"
             xmlns:plugin="clr-namespace:DDPM.UI.Plugin.ViewModels;assembly=DDPM.UI.Plugin.Common"
             d:DesignHeight="650" d:DesignWidth="900"
             SizeChanged="UserControl_SizeChanged">
    <UserControl.Resources>

        <ResourceDictionary>
            <SolidColorBrush x:Key="ToolipBkColor" Color="#FF1D2C3B" />
            <SolidColorBrush x:Key="ToolipBdColor" Color="#FF293B4D" />
            <SolidColorBrush x:Key="ToolipTextColor" Color="#FFF5F6F7" />

            <!-- 20240617  jim add -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DDPM.UI.Common;component/PluginStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <!-- Robert_Lin 2024-9-30 fix for Monitor Product image size is 1000x1000
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        -->

        <Grid Grid.Row="0" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Viewbox Margin="0" Grid.Row="0" Stretch="Uniform">

                    <!-- Width="1378" Height="735"
                -->
                    <Grid>
                        <Image Grid.Column="0" Source="{Binding DeviceImage}" Stretch="UniformToFill" Margin="0" x:Name="devImg">

                            <!-- Robert_Lin, 2024-9-30 The LeftView Product image don't need to show tooltip -->
                            <!-- 
                        <Image.ToolTip>
                            <ToolTip Placement="Center"  HorizontalOffset="8" VerticalOffset="-8"
                                     ToolTipService.HasDropShadow="True"
                                     ToolTipService.InitialShowDelay="1000"
                                     ToolTipService.BetweenShowDelay="2000">
                                <Border Background="{StaticResource ToolipBkColor}"
                                        BorderBrush="{StaticResource ToolipBdColor}"
                                        CornerRadius="4" Padding="8,12">
                                    <Border.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource ToolipTextColor}" />
                                            <Setter Property="FontSize" Value="12" />
                                        </Style>
                                    </Border.Resources>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DeviceName}" />
                                    </StackPanel>
                                </Border>
                            </ToolTip>
                        </Image.ToolTip>
                        -->
                        </Image>
                    </Grid>
                </Viewbox>
            </Grid>


            <!-- 2024-6-20 Robert_Lin, move this stackPanel inside image box
            1 Change StackPanel Grid.Row=1 to 0; 2. Add VerticalAlignment=Bottom to StackPanel
            -->
            <!--  20240617  jim add -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                <DDPMUserControls:BatteryIndicator Grid.Row="1"
                                                   Margin="0,0,0,70" HorizontalAlignment="Center"
                                                   BatteryLevel="{Binding BatteryLevel}" BatteryStatus="{Binding BatteryStatus}"
                                                   ConnectionType="{Binding ConnectionType}" VerticalAlignment="Bottom" Text1="{Binding Text1}"
                                                   NoBattery="{Binding NoBattery}" />

                <!-- Robert_Lin,2024-11-25 Add LightMode support -->
                <!-- 
                <Border Grid.Row="1" Style="{StaticResource BorderUnpair}"  Width="176" MouseLeftButtonDown="Restore_Click"  Cursor="Hand" Margin="8,0,0,70" Visibility="Visible" x:Name="btnRestore"
                        BorderBrush="{DynamicResource Button_UXStyleColor_ForWhiteFrame}">
                -->
                <Border Grid.Row="1" Style="{StaticResource BorderUnpair}"  Width="176" MouseLeftButtonDown="Restore_Click"  Cursor="Hand" Margin="8,0,0,70" Visibility="Visible" x:Name="btnRestore"
                        BorderBrush="{DynamicResource SecondaryButton_DefaultBdColor}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- 
                        <UXControls:UXTextBlock Name="txtRestore" Foreground="#F5F6F7" VerticalAlignment="Center" Grid.Column="0"
                                                HorizontalAlignment="Center" FontFamily="Roboto" FontSize="14" />
                        -->
                        <UXControls:UXTextBlock Name="txtRestore" Foreground="{DynamicResource SecondaryButton_DefaultTextColor}" VerticalAlignment="Center" Grid.Column="0"
                                                HorizontalAlignment="Center" FontFamily="Roboto" FontSize="14" />
                        <Image Grid.Column="1" Name="RestoreLockIcon" Visibility="Collapsed" Margin="0,0,6,0"
                        Source="pack://application:,,,/DDPM.UI.Common;component/Resources/Lock.png"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Width="12" Height="12">
                            <Image.ToolTip>
                                <ToolTip>
                                    <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                        <Border.Resources>
                                            <Style BasedOn="{StaticResource Tooltip_TextBlockStyle}" TargetType="TextBlock" />
                                        </Border.Resources>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding [ITLockToolTip.0], Source={x:Static lang:LangHelper.Instance}}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </ToolTip>
                            </Image.ToolTip>
                        </Image>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>