<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <system:Double x:Key="BasicTilePluginMaxTooltipWidth">280</system:Double>

    <!--Color for the TelemetryConsent html text -->
    <Color x:Key="ColorDarkThemeForeground">#C5D4E3</Color>
    <Color x:Key="ColorLightThemeForeground">#636363</Color>

    <!--Style for UXIconComboBox-->
    <Style x:Key="IconComboBoxStyle" TargetType="controls:UXIconComboBox" BasedOn="{StaticResource UXIconComboBoxBaseStyle}">
        <Setter Property="IconWidth" Value="15.7" />
        <Setter Property="IconHeight" Value="8.55" />
        <Setter Property="VerticalOffset" Value="4" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Margin" Value="0,0,-10,0" />
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <controls:UXComboBoxButton HorizontalAlignment="Left"
                                               IsTabStop="True"
                                               Focusable="True"
                                               Background="Transparent"
                                               Command="{Binding Command}"
                                               CommandParameter="{Binding CommandParameter}"
                                               CommandTarget ="{Binding CommandTarget}"
                                               Content="{Binding Header}"
                                               Margin="24,13,24,13">
                    </controls:UXComboBoxButton>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical"  Margin="0,10,0,10" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Tag" Value="{DynamicResource {x:Static SystemParameters.MenuDropAlignmentKey}}" />
        <Style.Triggers>
            <!--Left Handed - Menu appear to the right of your hand-->
            <DataTrigger Binding="{Binding Path=Tag , RelativeSource= {x:Static RelativeSource.Self}}" Value="False">
                <Setter Property="HorizontalOffset" Value="-144" />
            </DataTrigger>
            <!--Right Handed - Menu appear to the left of your hand-->
            <DataTrigger Binding="{Binding Path=Tag , RelativeSource= {x:Static RelativeSource.Self}}" Value="True">
                <Setter Property="HorizontalOffset" Value="12" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>