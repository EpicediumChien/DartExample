<UserControl
    x:Class="DDPM.UI.Module.Brightness.BrightnessRightView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:DDPM.UI.Module.Brightness"
    xmlns:lang="clr-namespace:DDPM.UI.Resources.Helper;assembly=DDPM.UI.Resources"
    xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
    d:DesignHeight="950"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- <ResourceDictionary Source="/DDPM.UI.Common;component/ModuleStyle.xaml" /> -->
            </ResourceDictionary.MergedDictionaries>

            <!--<local:RadioBoolToIntConverter x:Key="radioBoolToIntConverter" />-->

            <local:BooleanToBrushConverter
                x:Key="BooleanToBrushConverter"
                FalseBrush="White"
                TrueBrush="Gray" />

            <local:CustomBooleanToBrushConverter
                x:Key="CustomBooleanToBrushConverter"
                FalseBrushDarkTheme="{DynamicResource TextBlock_ForegroundColor}"
                FalseBrushLightTheme="{DynamicResource TextBlock_ForegroundColor}"
                TrueBrush="Gray" />

            <local:InverseBooleanConverter x:Key="InverseBooleanConverter" />

            <local:BoolReverseToVisibilityConverter x:Key="boolReverseToVisibilityConverter" />

            <local:BoolReverseConverter x:Key="boolReverseConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Foreground" Value="{DynamicResource RightView_Text_FgColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource RightView_Btn_BdColor}" />
        </Style>
    </UserControl.Style>

    <!-- Robert_Lin 2025-2-18 Modify for Narrator:
         1 Rewrite/modify all proerties of KayboardNavigation.*, AutomationProperties.*
         2 
    -->
    <!-- <Grid>
     KeyboardNavigation.DirectionalNavigation="{Binding TabSTOP}" KeyboardNavigation.TabNavigation="{Binding TabSTOP}"
    -->
    <Grid>
        <!--20250324 Chewlin Fix Gradient showing when content is too long issue ADD UseFadingScrolling="False" -->
        <!--Elsa 202504011 for PIMS-348407 add VerticalScrollBarVisibility="Auto"-->
        <UXControls:UXScrollViewer HorizontalScrollBarVisibility="Hidden" UseFadingScrolling="False" VerticalScrollBarVisibility="Auto" >
            <Grid>
                <StackPanel>
                    <Grid>
                        <!--20250402 Remove Width="648" for Fix open HDR ON brightness and contrast show value number clipping issue-->
                        <Border d:Visibility="Visible"
                            
                            Height="53"
                            Margin="0,5,0,15"
                            Background="{DynamicResource DefaultTheme_DialogBoxBkColor}"
                            CornerRadius="5"
                            Visibility="{Binding GreayoutAlart}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="7" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Grid.Column="0"
                                        Width="7"
                                        Background="#0E92F2"
                                        CornerRadius="5,0,0,5" />
                                    <Grid
                                        Grid.Column="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                        <Path Data="M9 1.125C13.3313 1.125 16.875 4.66875 16.875 9C16.875 13.3312 13.3313 16.875 9 16.875C4.66875 16.875 1.125 13.3312 1.125 9C1.125 4.66875 4.66875 1.125 9 1.125ZM9 0C4.05 0 0 4.05 0 9C0 13.95 4.05 18 9 18C13.95 18 18 13.95 18 9C18 4.05 13.95 0 9 0Z" Fill="white" />
                                        <Path Data="M9.5625 7.3125L8.4375 7.3125L8.4375 14.2875L9.5625 14.2875L9.5625 7.3125Z" Fill="white" />
                                        <Path Data="M9 5.40039C9.46599 5.40039 9.84375 5.02263 9.84375 4.55664C9.84375 4.09065 9.46599 3.71289 9 3.71289C8.53401 3.71289 8.15625 4.09065 8.15625 4.55664C8.15625 5.02263 8.53401 5.40039 9 5.40039Z" Fill="white" />
                                    </Grid>
                                </Grid>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock FontFamily="Roboto" FontSize="13" Focusable="True" KeyboardNavigation.TabIndex="101"
                                               Foreground="{DynamicResource DefaultTheme_TxtColor}">
                                        <Run Text="{Binding [Brightness.1], Source={x:Static lang:LangHelper.Instance}, Mode=OneWay}" />
                                        <Hyperlink Click="Hyperlink_Click">
                                            <Run Text="{Binding [Brightness.2], Source={x:Static lang:LangHelper.Instance}, Mode=OneWay}" />
                                        </Hyperlink>
                                        <Run Text="{Binding [Brightness.3], Source={x:Static lang:LangHelper.Instance}, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!--#region Brightness\Contrast RightGroupBorder.Manual  -->
                    <Border
                        IsEnabled="{Binding BrightnessEnable}"
                        Opacity="{Binding BrightnessOpacity}"
                        Style="{DynamicResource RightGroupBorderStyle}"
                        Visibility="{Binding isNormalBrightness}">

                        <!-- 
                            KeyboardNavigation.TabNavigation="None"
                            Focusable="False" KeyboardNavigation.IsTabStop="False"
        
                        -->
                        <Expander
                            Name="Expander_Manual"
                            Expanded="Expander_Manual_Expanded"
                            AutomationProperties.Name="{Binding [Manual], Source={x:Static lang:LangHelper.Instance}}"
                            Style="{StaticResource RightExpanderStyle}" PreviewKeyDown="brightnewwManulExpander_PreviewKeyDown">
                            <!--  IsExpanded="{Binding ExpanderGroup, Mode=TwoWay, Converter={StaticResource radioBoolToIntConverter}, ConverterParameter=0}">  -->
                            <Expander.Header>
                                <!--  Group Header: Manual  -->
                                <Grid Height="60">
                                    <UXControls:UXTextBlock
                                        Margin="30,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        FontSize="20"
                                        Foreground="{DynamicResource TextBlock_ForegroundColor}"
                                        Text="{Binding [Manual], Source={x:Static lang:LangHelper.Instance}}"
                                        TextBlockSemanticColorType="Light"
                                        Focusable="True" KeyboardNavigation.TabIndex="110"
                                        TextBlockType="Caption" />
                                </Grid>
                            </Expander.Header>
                            <Expander.Content>
                                <StackPanel>
                                    <!--  RightPartBorder  -->
                                    <!--20250325 Chewlin for Fix PIMSPIMS-348382 ADD FontFamily="Roboto" -->
                                    <Border Margin="0,20,0,0" Style="{DynamicResource RightPartBorderStyle}">
                                        <StackPanel>
                                            <!--  Row: "Brightness"  -->
                                            <Grid Height="40">
                                                <UXControls:UXTextBlock
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    FontSize="16"
                                                    FontFamily="Roboto"
                                                    Foreground="{DynamicResource TextBlock_ForegroundColor}"
                                                    Text="{Binding [Brightness], Source={x:Static lang:LangHelper.Instance}}"
                                                    Focusable="True" KeyboardNavigation.TabIndex="112"
                                                    TextBlockSemanticColorType="Light"
                                                    TextBlockType="Display1" />
                                            </Grid>
                                            <!--  Row: Brightness Slider  -->
                                            <Grid Height="60">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!--<Image
                                                Grid.Column="0"
                                                Width="20"
                                                Height="20"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Source="{DynamicResource BrightnessImage}"
                                                Stretch="UniformToFill" />-->
                                                <ContentControl Grid.Column="0"
                                                                Width="16"
                                                                Height="16"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Template="{StaticResource icon_Brightness}"
                                                                Focusable="True" KeyboardNavigation.IsTabStop="True"
                                                                AutomationProperties.Name="{Binding [Manual], Source={x:Static lang:LangHelper.Instance}}"
                                                                Foreground="{DynamicResource DefaultTheme_PathColor}" />
                                                <UXControls:UXSlider
                                                    Name="B_slider"
                                                    Grid.Column="1"
                                                    Margin="8,0"
                                                    HorizontalContentAlignment="Stretch"
                                                    AutoToolTipPlacement="None"
                                                    KeyboardNavigation.TabIndex="113"
                                                    AutomationProperties.AutomationId="UXSlider_HorizontalToolTipNone"
                                                    AutomationProperties.Name="{Binding [Manual], Source={x:Static lang:LangHelper.Instance}}"
                                                    IsSnapToTickEnabled="True"
                                                    LargeChange="1"
                                                    Maximum="100"
                                                    Minimum="0"
                                                    SmallChange="1"
                                                    Value="{Binding Path=BrightnessValue, Mode=TwoWay}" />

                                                <UXControls:UXTextBlock
                                                    Name="BrightnessTextBlock"
                                                    Grid.Column="2"
                                                    Focusable="True" KeyboardNavigation.TabIndex="114"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource PercentageTextColor}"
                                                    Text="{Binding Path=BrightnessValue, StringFormat={}{0}%}"
                                                    TextBlockSemanticColorType="Light"
                                                    TextBlockType="Body2" />
                                            </Grid>
                                            <!--  Row: "Contrast"  -->
                                            <!--20250325 Chewlin for Fix PIMSPIMS-348382 ADD FontFamily="Roboto" -->
                                            <Grid Height="40">
                                                <UXControls:UXTextBlock
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    FontSize="16"
                                                    FontFamily="Roboto"
                                                    Foreground="{DynamicResource TextBlock_ForegroundColor}"
                                                    Text="{Binding [Contrast], Source={x:Static lang:LangHelper.Instance}}"
                                                    Focusable="True" KeyboardNavigation.TabIndex="116"
                                                    TextBlockSemanticColorType="Light"
                                                    TextBlockType="Display1" />
                                            </Grid>
                                            <!--  Row: Contrast Slider  -->
                                            <Grid Height="60">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!--<Image
                                                Grid.Column="0"
                                                Width="20"
                                                Height="20"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Source="{DynamicResource ContrastImage}"
                                                Stretch="UniformToFill" />-->
                                                <ContentControl Grid.Column="0"
                                                                Width="16"
                                                                Height="16"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Focusable="True" KeyboardNavigation.IsTabStop="True"
                                                                AutomationProperties.Name="{Binding [Contrast], Source={x:Static lang:LangHelper.Instance}}"
                                                                Template="{StaticResource icon_Contrast}"
                                                                Foreground="{DynamicResource DefaultTheme_PathColor}" />
                                                <UXControls:UXSlider
                                                    Name="C_slider"
                                                    Grid.Column="1"
                                                    Margin="8,0"
                                                    HorizontalContentAlignment="Stretch"
                                                    AutoToolTipPlacement="None"
                                                    KeyboardNavigation.TabIndex="118"
                                                    AutomationProperties.AutomationId="UXSlider_HorizontalToolTipNone"
                                                    AutomationProperties.Name="{Binding [Contrast], Source={x:Static lang:LangHelper.Instance}}"
                                                    IsSnapToTickEnabled="True"
                                                    LargeChange="1"
                                                    Maximum="100"
                                                    Minimum="0"
                                                    SmallChange="1"
                                                    Value="{Binding Path=ContrastValue, Mode=TwoWay}" />

                                                <UXControls:UXTextBlock
                                                    Name="ContrastTextBlock"
                                                    Grid.Column="2"
                                                    Focusable="True" KeyboardNavigation.TabIndex="119"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource PercentageTextColor}"
                                                    Text="{Binding Path=ContrastValue, StringFormat={}{0}%}"
                                                    TextBlockSemanticColorType="Light"
                                                    TextBlockType="Body2" />
                                            </Grid>
                                            <!--  Row: Buttons  -->
                                            <Grid>
                                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                                    <UXControls:UXButton
                                                        Name="btnManualBrightnessContrast"
                                                        MinWidth="111"
                                                        Height="40"
                                                        Margin="8,0,0,16"
                                                        Padding="24,8"
                                                        ButtonSemanticColorType="Neutral"
                                                        ButtonType="Secondary"
                                                        Click="Hotkey_Click"
                                                        CornerRadius="2"
                                                        KeyboardNavigation.TabIndex="122"
                                                        IsEnabled="{Binding ManualBCHotkeyBtn}"
                                                        Style="{StaticResource Button_WhiteFrame}">
                                                        <Button.Content>
                                                            <TextBlock Padding="10,0,10,0" Text="{Binding [Hotkeys], Source={x:Static lang:LangHelper.Instance}}"/>
                                                        </Button.Content>
                                                    </UXControls:UXButton>
                                                    <UXControls:UXButton
                                                        MinWidth="111"
                                                        Height="40"
                                                        Margin="8,0,0,16"
                                                        Padding="24,8"
                                                        ButtonSemanticColorType="Destructive"
                                                        ButtonType="Primary"
                                                        Click="Reset_Click"
                                                        KeyboardNavigation.TabIndex="123"
                                                        Content="{Binding [Reset], Source={x:Static lang:LangHelper.Instance}}"
                                                        CornerRadius="2"
                                                        Foreground="{DynamicResource RightView_Btn_TextColor}" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!--  synchronize  -->
                                    <Grid
                                        Height="60"
                                        IsEnabled="{Binding BrightnessEnable}"
                                        Opacity="{Binding BrightnessOpacity}"
                                        Visibility="{Binding isShowSynchronize}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <UXControls:UXTextBlock
                                            Name="SynchronizeTextBlock"
                                            Grid.Column="0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            FontSize="16"
                                            Foreground="{DynamicResource TextBlock_ForegroundColor}"
                                            Text="{Binding [Brightness.4], Source={x:Static lang:LangHelper.Instance}}"
                                            Focusable="True" KeyboardNavigation.TabIndex="125"
                                            TextBlockSemanticColorType="Light"
                                            TextBlockType="Display1" />

                                        <!--<Image
                                            Grid.Column="1"
                                            Width="16"
                                            Height="16"
                                            Margin="4,0"
                                            Source="pack://application:,,,/DDPM.UI.Common;component/Resources/Icon_Info.png"
                                            Stretch="Uniform">
                                            <Image.ToolTip>
                                                --><!--Elsa 20250401 for PIMS-348390 add Placement="Top" VerticalOffset="12" HorizontalOffset="2" MaxWidth="272" Opened="toolTip_Opened"--><!--
                                                <ToolTip Placement="Top" VerticalOffset="12" HorizontalOffset="2" MaxWidth="272" Opened="toolTip_Opened">
                                                    <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                                        <Border.Resources>
                                                            <Style BasedOn="{StaticResource Tooltip_TextBlockStyle}" TargetType="TextBlock" />
                                                        </Border.Resources>
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                --><!--Elsa 20250401 for PIMS-348390 add MaxWidth="230" TextWrapping="WrapWithOverflow"--><!--
                                                                <TextBlock Text="{Binding [Brightness.5], Source={x:Static lang:LangHelper.Instance}}" MaxWidth="230" TextWrapping="WrapWithOverflow"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </ToolTip>
                                            </Image.ToolTip>
                                        </Image>-->
                                        <Button Grid.Column="1" Style="{StaticResource StatelessButton}" Width="16" Height="16" VerticalAlignment="Center" Margin="8,0,0,0" KeyboardNavigation.TabIndex="14" AutomationProperties.Name="{Binding SelectedHomeDevice.DeviceInfoToolTipText}">
                                            <!-- The (i) icon 16x16 -->
                                            <ContentControl Template="{StaticResource icon_Info}"/>

                                            <!-- ToolTip -->
                                            <Button.ToolTip>
                                                <!--Elsa 20250401 for PIMS-348390 change HorizontalOffset="0" to HorizontalOffset="2" -->
                                                <ToolTip BorderThickness="0" Background="Transparent" Placement="Top" HorizontalOffset="2" VerticalOffset="12">
                                                    <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                                        <TextBlock Text="{Binding [Brightness.5], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource Tooltip_TextBlockStyle}" LineHeight="20"/>
                                                    </Border>
                                                </ToolTip>
                                            </Button.ToolTip>
                                        </Button>

                                        <Image
                                            Grid.Column="1"
                                            Width="16"
                                            Height="16"
                                            Margin="90,0,20,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Source="pack://application:,,,/DDPM.UI.Common;component/Resources/Lock.png"
                                            Visibility="{Binding synchronizeLock}">
                                            <Image.ToolTip>
                                                <ToolTip>
                                                    <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                                        <Border.Resources>
                                                            <Style BasedOn="{StaticResource Tooltip_TextBlockStyle}" TargetType="TextBlock" />
                                                        </Border.Resources>
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding [ITLockToolTip.0], Source={x:Static lang:LangHelper.Instance}}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </ToolTip>
                                            </Image.ToolTip>
                                        </Image>

                                        <UXControls:UXToggleSwitch
                                            Name="SynchronizeSwitch"
                                            Grid.Column="2"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            KeyboardNavigation.TabIndex="127"
                                            AutomationProperties.LabeledBy="{Binding ElementName=SynchronizeTextBlock}"
                                            AutomationProperties.Name="{Binding [Brightness.4], Source={x:Static lang:LangHelper.Instance}}"
                                            Click="SynchronizeSwitch_Click"
                                            Content="{Binding Path=IsSynchronize_String}"
                                            ContentPlacement="Left"
                                            ContentTextVisibility="True"
                                            Foreground="{DynamicResource TextBlock_ForegroundColor}"
                                            IsChecked="{Binding Path=IsSynchronize}"
                                            IsEnabled="{Binding IsSynchronizeDisabled, Converter={StaticResource InverseBooleanConverter}}" />
                                    </Grid>
                                </StackPanel>
                            </Expander.Content>
                        </Expander>
                    </Border>
                    <!--#endregion-->

                    <!--#region RightGroupBorder.Manual.Luminance  -->
                    <Border
                        Name="LuminanceRightGroupBorder"
                        IsEnabled="{Binding BrightnessEnable}"
                        Opacity="{Binding BrightnessOpacity}"
                        Style="{DynamicResource RightGroupBorderStyle}"
                        Visibility="{Binding isLuminanceSupport}">

                        <Expander
                            Name="Expander_Manual_Luminance"
                            Expanded="Expander_Manual_Expanded_Luminance"
                            Style="{StaticResource RightExpanderStyle}">
                            <Expander.Header>
                                <!--  Group Header: Manual.Luminance  -->
                                <Grid Height="60">
                                    <UXControls:UXTextBlock
                                        Margin="30,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        FontSize="20"
                                        Foreground="{DynamicResource TextBlock_ForegroundColor}"
                                        Text="{Binding [Manual], Source={x:Static lang:LangHelper.Instance}}"
                                        TextBlockSemanticColorType="Light"
                                        TextBlockType="Caption" />
                                </Grid>
                            </Expander.Header>
                            <Expander.Content>
                                <StackPanel>
                                    <!--  RightPartBorder  -->
                                    <Border Margin="0,20,0,0" Style="{DynamicResource RightPartBorderStyle}">
                                        <StackPanel>
                                            <!--  Row: "Luminance"  -->
                                            <Grid Height="40">
                                                <UXControls:UXTextBlock
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    FontSize="16"
                                                    Foreground="{DynamicResource TextBlock_ForegroundColor}"
                                                    Text="{Binding [Luminance], Source={x:Static lang:LangHelper.Instance}}"
                                                    TextBlockSemanticColorType="Light"
                                                    TextBlockType="Display1" />
                                            </Grid>
                                            <!--  Row: Luminance Slider  -->
                                            <Grid Height="60">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!--<Image
                                                    Grid.Column="0"
                                                    Width="20"
                                                    Height="20"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Source="{DynamicResource LuminanceImage}" />-->
                                                <!--icon_Luminance-->
                                                <ContentControl Grid.Column="0"
                                                                Width="16"
                                                                Height="16"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Template="{StaticResource icon_Luminance}"
                                                                Focusable="True" KeyboardNavigation.IsTabStop="True"
                                                                Foreground="{DynamicResource DefaultTheme_PathColor}" />

                                                <UXControls:UXSlider
                                                    Name="LuminanceSlider"
                                                    Grid.Column="1"
                                                    Margin="8,0"
                                                    HorizontalContentAlignment="Stretch"
                                                    AutoToolTipPlacement="None"
                                                    AutomationProperties.AutomationId="UXSlider_HorizontalToolTipNone"
                                                    AutomationProperties.Name="SliderToolTipNone"
                                                    IsSnapToTickEnabled="True"
                                                    LargeChange="1"
                                                    Maximum="{Binding Path=LuminanceMaxValue}"
                                                    Minimum="45"
                                                    SmallChange="1"
                                                    Value="{Binding Path=LuminanceValue, Mode=TwoWay}" />

                                                <UXControls:UXTextBlock
                                                    Name="LuminanceTextBlock"
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource PercentageTextColor}"
                                                    Text="{Binding Path=LuminanceValue, StringFormat={}{0} cd/m2}"
                                                    TextBlockSemanticColorType="Light"
                                                    TextBlockType="Body2" />
                                            </Grid>
                                            <!--  Row: Buttons  -->
                                            <Grid>
                                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                                    <UXControls:UXButton
                                                        Name="btnManualLuminance"
                                                        Width="111"
                                                        Height="40"
                                                        Margin="8,0,0,16"
                                                        Padding="24,8"
                                                        ButtonSemanticColorType="Neutral"
                                                        ButtonType="Secondary"
                                                        Click="Hotkey_Click"
                                                        Content="{Binding [Hotkeys], Source={x:Static lang:LangHelper.Instance}}"
                                                        CornerRadius="2"
                                                        Style="{StaticResource Button_WhiteFrame}" />
                                                    <UXControls:UXButton
                                                        Width="111"
                                                        Height="40"
                                                        Margin="8,0,0,16"
                                                        Padding="24,8"
                                                        ButtonSemanticColorType="Destructive"
                                                        ButtonType="Primary"
                                                        Click="Reset_Click"
                                                        Content="{Binding [Reset], Source={x:Static lang:LangHelper.Instance}}"
                                                        CornerRadius="2"
                                                        Foreground="{DynamicResource RightView_Btn_TextColor}" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!--  synchronize  -->
                                    <Grid
                                        Height="60"
                                        IsEnabled="{Binding BrightnessEnable}"
                                        Opacity="{Binding BrightnessOpacity}"
                                        Visibility="{Binding isShowSynchronize}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <UXControls:UXTextBlock
                                            Name="SynchronizeTextBlock_Luminance"
                                            Grid.Column="0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            FontSize="16"
                                            Foreground="{DynamicResource TextBlock_ForegroundColor}"
                                            Text="{Binding [Brightness.4], Source={x:Static lang:LangHelper.Instance}}"
                                            TextBlockSemanticColorType="Light"
                                            TextBlockType="Display1" />

                                        <!--<Image
                                            Grid.Column="1"
                                            Width="16"
                                            Height="16"
                                            Margin="4,0"
                                            Source="pack://application:,,,/DDPM.UI.Common;component/Resources/Icon_Info.png"
                                            Stretch="Uniform">
                                            <Image.ToolTip>
                                                <ToolTip>
                                                    <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                                        <Border.Resources>
                                                            <Style BasedOn="{StaticResource Tooltip_TextBlockStyle}" TargetType="TextBlock" />
                                                        </Border.Resources>
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding [Brightness.5], Source={x:Static lang:LangHelper.Instance}}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </ToolTip>
                                            </Image.ToolTip>
                                        </Image>-->
                                        <Button Grid.Column="1" Style="{StaticResource StatelessButton}" Width="16" Height="16" VerticalAlignment="Center" Margin="8,0,0,0" KeyboardNavigation.TabIndex="14" AutomationProperties.Name="{Binding SelectedHomeDevice.DeviceInfoToolTipText}">
                                            <!-- The (i) icon 16x16 -->
                                            <ContentControl Template="{StaticResource icon_Info}"/>

                                            <!-- ToolTip -->
                                            <Button.ToolTip>
                                                <!--Elsa 20250401 for PIMS-348390 change HorizontalOffset="0" to HorizontalOffset="2" -->
                                                <ToolTip BorderThickness="0" Background="Transparent" Placement="Top" HorizontalOffset="2" VerticalOffset="12">
                                                    <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                                        <TextBlock Text="{Binding [Brightness.5], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource Tooltip_TextBlockStyle}" LineHeight="20"/>
                                                    </Border>
                                                </ToolTip>
                                            </Button.ToolTip>
                                        </Button>

                                        <Image
                                            Grid.Column="1"
                                            Width="16"
                                            Height="16"
                                            Margin="90,0,20,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
