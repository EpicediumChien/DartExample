                                                        Name="preset2_LuminanceTextBlock"
                                                        Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        Foreground="{DynamicResource PercentageTextColor}"
                                                        Text="{Binding Path=PR2LuminanceValue, StringFormat={}{0} cd/m2}"
                                                        TextBlockSemanticColorType="Light"
                                                        TextBlockType="Body2" />
                                                </Grid>

                                                <!--  Row: Buttons  -->
                                                <Grid>
                                                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                                        <UXControls:UXButton
                                                            Name="PR2_Luminance_Preview_UXButton"
                                                            Width="173"
                                                            Height="40"
                                                            Padding="24,8"
                                                            ButtonSemanticColorType="Neutral"
                                                            ButtonType="Secondary"
                                                            Click="PR2_Luminance_Preview_UXButton_Click"
                                                            Content="{Binding PR2_Luminance_ButtonContent}"
                                                            CornerRadius="2"
                                                            IsEnabled="{Binding IsPR1_Luminance_Preview, Converter={StaticResource boolReverseConverter}}"
                                                            Style="{StaticResource Button_WhiteFrame}" />
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <Grid
                                        Height="60"
                                        IsEnabled="{Binding BrightnessEnable}"
                                        Opacity="{Binding BrightnessOpacity}"
                                        Visibility="{Binding isShowSynchronize}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <UXControls:UXTextBlock
                                            Name="Scheduled_Luminance_SynchronizeTextBlock"
                                            Grid.Column="0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            FontSize="16"
                                            Foreground="{DynamicResource TextBlock_ForegroundColor}"
                                            Text="{Binding [Brightness.4], Source={x:Static lang:LangHelper.Instance}}"
                                            TextBlockSemanticColorType="Light"
                                            TextBlockType="Display1" />

                                        <!--<Image
                                            Grid.Column="1"
                                            Width="16"
                                            Height="16"
                                            Margin="4,0"
                                            Source="pack://application:,,,/DDPM.UI.Common;component/Resources/Icon_Info.png"
                                            Stretch="Uniform">
                                            <Image.ToolTip>
                                                <ToolTip>
                                                    <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                                        <Border.Resources>
                                                            <Style BasedOn="{StaticResource Tooltip_TextBlockStyle}" TargetType="TextBlock" />
                                                        </Border.Resources>
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding [Brightness.21], Source={x:Static lang:LangHelper.Instance}}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </ToolTip>
                                            </Image.ToolTip>
                                        </Image>-->
                                        <Button Grid.Column="1" Style="{StaticResource StatelessButton}" Width="16" Height="16" VerticalAlignment="Center" Margin="8,0,0,0" KeyboardNavigation.TabIndex="14" AutomationProperties.Name="{Binding SelectedHomeDevice.DeviceInfoToolTipText}">
                                            <!-- The (i) icon 16x16 -->
                                            <ContentControl Template="{StaticResource icon_Info}"/>

                                            <!-- ToolTip -->
                                            <Button.ToolTip>
                                                <!--Elsa 20250401 for PIMS-348390 change HorizontalOffset="0" to HorizontalOffset="2" -->
                                                <ToolTip BorderThickness="0" Background="Transparent" Placement="Top" HorizontalOffset="2" VerticalOffset="12">
                                                    <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                                        <TextBlock Text="{Binding [Brightness.21], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource Tooltip_TextBlockStyle}" LineHeight="20"/>
                                                    </Border>
                                                </ToolTip>
                                            </Button.ToolTip>
                                        </Button>
                                        <Image
                                            Grid.Column="1"
                                            Width="16"
                                            Height="16"
                                            Margin="90,0,20,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Source="pack://application:,,,/DDPM.UI.Common;component/Resources/Lock.png"
                                            Visibility="{Binding synchronizeLock}">
                                            <Image.ToolTip>
                                                <ToolTip>
                                                    <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                                        <Border.Resources>
                                                            <Style BasedOn="{StaticResource Tooltip_TextBlockStyle}" TargetType="TextBlock" />
                                                        </Border.Resources>
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding [ITLockToolTip.0], Source={x:Static lang:LangHelper.Instance}}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </ToolTip>
                                            </Image.ToolTip>
                                        </Image>

                                        <UXControls:UXToggleSwitch
                                            Name="ScheduledLuminanceSynchronizeSwitch"
                                            Grid.Column="2"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            AutomationProperties.Name="ToggleSwitchLeft"
                                            Click="Synchronize_LuminanceScheduledSwitch_Click"
                                            Content="{Binding Path=IsSynchronize_Scheduled_String}"
                                            ContentPlacement="Left"
                                            ContentTextVisibility="True"
                                            Foreground="{DynamicResource TextBlock_ForegroundColor}"
                                            IsChecked="{Binding Path=IsSynchronize_Scheduled}"
                                            IsEnabled="{Binding IsSynchronizeDisabled, Converter={StaticResource InverseBooleanConverter}}" />
                                    </Grid>
                                </StackPanel>
                            </Expander.Content>
                        </Expander>
                    </Border>
                    <!--#endregion-->
                </StackPanel>

                <Border Name="DisableAll" Background="#4C24273C"  d:Visibility="Collapsed">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <UXControls:UXBusyIndicator
                        Width="64"
                        Height="64"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        BusyIndicatorType="Secondary"
                        IsActive="{Binding IsBusy}" />
                        <UXControls:UXTextBlock Margin="0, 20, 0, 0" Text="{Binding [HomePage.0], Source={x:Static lang:LangHelper.Instance}}" Foreground="#FF797F84" />
                    </StackPanel>
                </Border>
                <Border Name="DisableAll2" Background="#4C24273C"  d:Visibility="Collapsed">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusyALS}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <UXControls:UXBusyIndicator
                        Width="64"
                        Height="64"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        BusyIndicatorType="Secondary"
                        IsActive="{Binding IsBusyALS}" />
                        <UXControls:UXTextBlock Margin="0, 20, 0, 0" Text="{Binding [HomePage.0], Source={x:Static lang:LangHelper.Instance}}" Foreground="#FF797F84" />
                    </StackPanel>
                </Border>
            </Grid>
        </UXControls:UXScrollViewer>
        <Border d:Visibility="Collapsed"
            Background="#132F54"
            CornerRadius="13"
            Opacity="0.6"
            Visibility="{Binding LockMaskVisible}" />
    </Grid>
</UserControl>