<UserControl
    x:Class="DDPM.UI.Module.Brightness.BrightnessRightView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:DDPM.UI.Resources.Helper;assembly=DDPM.UI.Resources"
    xmlns:local="clr-namespace:DDPM.UI.Module.Brightness"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="950"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- <ResourceDictionary Source="/DDPM.UI.Common;component/ModuleStyle.xaml" /> -->
            </ResourceDictionary.MergedDictionaries>

            <!--<local:RadioBoolToIntConverter x:Key="radioBoolToIntConverter" />-->

            <local:BooleanToBrushConverter
                x:Key="BooleanToBrushConverter"
                FalseBrush="White"
                TrueBrush="Gray" />

            <local:CustomBooleanToBrushConverter
                x:Key="CustomBooleanToBrushConverter"
                FalseBrushDarkTheme="{DynamicResource TextBlock_ForegroundColor}"
                FalseBrushLightTheme="{DynamicResource TextBlock_ForegroundColor}"
                TrueBrush="Gray" />

            <local:InverseBooleanConverter x:Key="InverseBooleanConverter" />

            <local:BoolReverseToVisibilityConverter x:Key="boolReverseToVisibilityConverter" />

            <local:BoolReverseConverter x:Key="boolReverseConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Foreground" Value="{DynamicResource RightView_Text_FgColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource RightView_Btn_BdColor}" />
        </Style>
    </UserControl.Style>

    <Grid KeyboardNavigation.DirectionalNavigation="{Binding TabSTOP}" KeyboardNavigation.TabNavigation="{Binding TabSTOP}">
        <UXControls:UXScrollViewer HorizontalScrollBarVisibility="Hidden">
            <Grid>
                <StackPanel>
                    <Grid>
                        <Border
                            Width="648"
                            Height="53"
                            Margin="0,5,0,15"
                            Background="#364861"
                            CornerRadius="5"
                            Visibility="{Binding GreayoutAlart}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="7" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Grid.Column="0"
                                        Width="7"
                                        Background="#0E92F2"
                                        CornerRadius="5,0,0,5" />
                                    <Grid
                                        Grid.Column="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                        <Path Data="M9 1.125C13.3313 1.125 16.875 4.66875 16.875 9C16.875 13.3312 13.3313 16.875 9 16.875C4.66875 16.875 1.125 13.3312 1.125 9C1.125 4.66875 4.66875 1.125 9 1.125ZM9 0C4.05 0 0 4.05 0 9C0 13.95 4.05 18 9 18C13.95 18 18 13.95 18 9C18 4.05 13.95 0 9 0Z" Fill="white" />
                                        <Path Data="M9.5625 7.3125L8.4375 7.3125L8.4375 14.2875L9.5625 14.2875L9.5625 7.3125Z" Fill="white" />
                                        <Path Data="M9 5.40039C9.46599 5.40039 9.84375 5.02263 9.84375 4.55664C9.84375 4.09065 9.46599 3.71289 9 3.71289C8.53401 3.71289 8.15625 4.09065 8.15625 4.55664C8.15625 5.02263 8.53401 5.40039 9 5.40039Z" Fill="white" />
                                    </Grid>
                                </Grid>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock FontFamily="Roboto" FontSize="13">
                                        <Run Text="{Binding [Brightness.1], Source={x:Static lang:LangHelper.Instance}, Mode=OneWay}" />
                                        <Hyperlink Click="Hyperlink_Click">
                                            <Run Text="{Binding [Brightness.2], Source={x:Static lang:LangHelper.Instance}, Mode=OneWay}" />
                                        </Hyperlink>
                                        <Run Text="{Binding [Brightness.3], Source={x:Static lang:LangHelper.Instance}, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!--  RightGroupBorder.Manual  -->
                    <Border
                        IsEnabled="{Binding BrightnessEnable}"
                        Opacity="{Binding BrightnessOpacity}"
                        Style="{DynamicResource RightGroupBorderStyle}"
                        Visibility="{Binding isNormalBrightness}">

                        <Expander
                            Name="Expander_Manual"
                            Expanded="Expander_Manual_Expanded"
                            Style="{StaticResource RightExpanderStyle}">
                            <!--  IsExpanded="{Binding ExpanderGroup, Mode=TwoWay, Converter={StaticResource radioBoolToIntConverter}, ConverterParameter=0}">  -->
                            <Expander.Header>
                                <!--  Group Header: Manual  -->
                                <Grid Height="60">
                                    <UXControls:UXTextBlock
                                        Margin="30,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        FontSize="20"
                                        Foreground="{DynamicResource TextBlock_ForegroundColor}"
                                        Text="{Binding [Manual], Source={x:Static lang:LangHelper.Instance}}"
                                        TextBlockSemanticColorType="Light"
                                        TextBlockType="Caption" />
                                </Grid>
                            </Expander.Header>
                            <Expander.Content>
                                <StackPanel>
                                    <!--  RightPartBorder  -->
                                    <Border Margin="0,20,0,0" Style="{DynamicResource RightPartBorderStyle}">
                                        <StackPanel>
                                            <!--  Row: "Brightness"  -->
                                            <Grid Height="40">
                                                <UXControls:UXTextBlock
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    FontSize="16"
                                                    Foreground="{DynamicResource TextBlock_ForegroundColor}"
                                                    Text="{Binding [Brightness], Source={x:Static lang:LangHelper.Instance}}"
                                                    TextBlockSemanticColorType="Light"
                                                    TextBlockType="Display1" />
                                            </Grid>
                                            <!--  Row: Brightness Slider  -->
                                            <Grid Height="60">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!--<Image
                                                    Grid.Column="0"
                                                    Width="20"
                                                    Height="20"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Source="{DynamicResource BrightnessImage}"
                                                    Stretch="UniformToFill" />-->
                                                <ContentControl Grid.Column="0"
                                                                Width="20"
                                                                Height="20"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Template="{StaticResource icon_Brightness}"
                                                                Foreground="{DynamicResource DefaultTheme_PathColor}" />
                                                <UXControls:UXSlider
                                                    Name="B_slider"
                                                    Grid.Column="1"
                                                    Margin="8,0"
                                                    HorizontalContentAlignment="Stretch"
                                                    AutoToolTipPlacement="None"
                                                    AutomationProperties.AutomationId="UXSlider_HorizontalToolTipNone"
                                                    AutomationProperties.Name="SliderToolTipNone"
                                                    IsSnapToTickEnabled="True"
                                                    LargeChange="1"
                                                    Maximum="100"
                                                    Minimum="0"
                                                    SmallChange="1"
                                                    Value="{Binding Path=BrightnessValue, Mode=TwoWay}" />

                                                <UXControls:UXTextBlock
                                                    Name="BrightnessTextBlock"
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource PercentageTextColor}"
                                                    Text="{Binding Path=BrightnessValue, StringFormat={}{0}%}"
                                                    TextBlockSemanticColorType="Light"
                                                    TextBlockType="Body2" />
                                            </Grid>
                                            <!--  Row: "Contrast"  -->
                                            <Grid Height="40">
                                                <UXControls:UXTextBlock
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    FontSize="16"
                                                    Foreground="{DynamicResource TextBlock_ForegroundColor}"
                                                    Text="{Binding [Contrast], Source={x:Static lang:LangHelper.Instance}}"
                                                    TextBlockSemanticColorType="Light"
                                                    TextBlockType="Display1" />
                                            </Grid>
                                            <!--  Row: Contrast Slider  -->
                                            <Grid Height="60">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!--<Image
                                                    Grid.Column="0"
                                                    Width="20"
                                                    Height="20"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Source="{DynamicResource ContrastImage}"
                                                    Stretch="UniformToFill" />-->
                                                <ContentControl Grid.Column="0"
                                                                Width="20"
                                                                Height="20"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Template="{StaticResource icon_Contrast}"
                                                                Foreground="{DynamicResource DefaultTheme_PathColor}" />
                                                <UXControls:UXSlider
                                                    Name="C_slider"
                                                    Grid.Column="1"
                                                    Margin="8,0"
                                                    HorizontalContentAlignment="Stretch"
                                                    AutoToolTipPlacement="None"
                                                    AutomationProperties.AutomationId="UXSlider_HorizontalToolTipNone"
                                                    AutomationProperties.Name="SliderToolTipNone"
                                                    IsSnapToTickEnabled="True"
                                                    LargeChange="1"
                                                    Maximum="100"
                                                    Minimum="0"
                                                    SmallChange="1"
                                                    Value="{Binding Path=ContrastValue, Mode=TwoWay}" />

                                                <UXControls:UXTextBlock
                                                    Name="ContrastTextBlock"
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource PercentageTextColor}"
                                                    Text="{Binding Path=ContrastValue, StringFormat={}{0}%}"
                                                    TextBlockSemanticColorType="Light"
                                                    TextBlockType="Body2" />
                                            </Grid>
                                            <!--  Row: Buttons  -->
                                            <Grid>
                                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                                    <UXControls:UXButton
                                                        Name="btnManualBrightnessContrast"
                                                        Width="111"
                                                        Height="40"
                                                        Margin="8,0,0,16"
                                                        Padding="24,8"
                                                        ButtonSemanticColorType="Neutral"
                                                        ButtonType="Secondary"
                                                        Click="Hotkey_Click"
                                                        Content="{Binding [Hotkeys], Source={x:Static lang:LangHelper.Instance}}"
                                                        CornerRadius="2"
                                                        IsEnabled="{Binding ManualBCHotkeyBtn}"
                                                        Style="{StaticResource Button_WhiteFrame}" />
                                                    <UXControls:UXButton
                                                        Width="111"
                                                        Height="40"
                                                        Margin="8,0,0,16"
                                                        Padding="24,8"
                                                        ButtonSemanticColorType="Destructive"
                                                        ButtonType="Primary"
                                                        Click="Reset_Click"
                                                        Content="{Binding [Reset], Source={x:Static lang:LangHelper.Instance}}"
                                                        CornerRadius="2"
                                                        Foreground="{DynamicResource RightView_Btn_TextColor}" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!--  synchronize  -->
                                    <Grid
                                        Height="60"
                                        IsEnabled="{Binding BrightnessEnable}"
                                        Opacity="{Binding BrightnessOpacity}"
                                        Visibility="{Binding isShowSynchronize}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <UXControls:UXTextBlock
                                            Name="SynchronizeTextBlock"
                                            Grid.Column="0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            FontSize="16"
                                            Foreground="{DynamicResource TextBlock_ForegroundColor}"
                                            Text="{Binding [Brightness.4], Source={x:Static lang:LangHelper.Instance}}"
                                            TextBlockSemanticColorType="Light"
                                            TextBlockType="Display1" />

                                        <Image
                                            Grid.Column="1"
                                            Width="16"
                                            Height="16"
                                            Margin="4,0"
                                            Cursor="Hand"
                                            Source="pack://application:,,,/DDPM.UI.Common;component/Resources/Icon_Info.png"
                                            Stretch="Uniform">
                                            <Image.ToolTip>
                                                <ToolTip>
                                                    <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                                        <Border.Resources>
                                                            <Style BasedOn="{StaticResource Tooltip_TextBlockStyle}" TargetType="TextBlock" />
                                                        </Border.Resources>
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding [Brightness.5], Source={x:Static lang:LangHelper.Instance}}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </ToolTip>
                                            </Image.ToolTip>
                                        </Image>

                                        <Image
                                            Grid.Column="1"
                                            Width="16"
                                            Height="16"
                                            Margin="90,0,20,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Source="pack://application:,,,/DDPM.UI.Common;component/Resources/Lock.png"
                                            Visibility="{Binding synchronizeLock}" />

                                        <UXControls:UXToggleSwitch
                                            Name="SynchronizeSwitch"
                                            Grid.Column="2"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            AutomationProperties.Name="ToggleSwitchLeft"
                                            Click="SynchronizeSwitch_Click"
                                            Content="{Binding Path=IsSynchronize_String}"
                                            ContentPlacement="Left"
                                            ContentTextVisibility="True"
                                            Foreground="{DynamicResource TextBlock_ForegroundColor}"
                                            IsChecked="{Binding Path=IsSynchronize}"
                                            IsEnabled="{Binding IsSynchronizeDisabled, Converter={StaticResource InverseBooleanConverter}}" />
                                    </Grid>
                                </StackPanel>
                            </Expander.Content>
                        </Expander>
                    </Border>

                    <!--  RightGroupBorder.Manual.Luminance  -->
                    <Border
                        Name="LuminanceRightGroupBorder"
                        IsEnabled="{Binding BrightnessEnable}"
                        Opacity="{Binding BrightnessOpacity}"
                        Style="{DynamicResource RightGroupBorderStyle}"
                        Visibility="{Binding isLuminanceSupport}">

                        <Expander
                            Name="Expander_Manual_Luminance"
                            Expanded="Expander_Manual_Expanded_Luminance"
                            Style="{StaticResource RightExpanderStyle}">
                            <Expander.Header>
                                <!--  Group Header: Manual.Luminance  -->
                                <Grid Height="60">
                                    <UXControls:UXTextBlock
                                        Margin="30,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        FontSize="20"
                                        Foreground="{DynamicResource TextBlock_ForegroundColor}"
                                        Text="{Binding [Manual], Source={x:Static lang:LangHelper.Instance}}"
                                        TextBlockSemanticColorType="Light"
                                        TextBlockType="Caption" />
                                </Grid>
                            </Expander.Header>
                            <Expander.Content>
                                <StackPanel>
                                    <!--  RightPartBorder  -->
                                    <Border Margin="0,20,0,0" Style="{DynamicResource RightPartBorderStyle}">
                                        <StackPanel>
                                            <!--  Row: "Luminance"  -->
                                            <Grid Height="40">
                                                <UXControls:UXTextBlock
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    FontSize="16"
                                                    Foreground="{DynamicResource TextBlock_ForegroundColor}"
                                                    Text="{Binding [Luminance], Source={x:Static lang:LangHelper.Instance}}"
                                                    TextBlockSemanticColorType="Light"
                                                    TextBlockType="Display1" />
                                            </Grid>
                                            <!--  Row: Luminance Slider  -->
                                            <Grid Height="60">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Image
                                                    Grid.Column="0"
                                                    Width="20"
                                                    Height="20"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Source="{DynamicResource LuminanceImage}" />

                                                <UXControls:UXSlider
                                                    Name="LuminanceSlider"
                                                    Grid.Column="1"
                                                    Margin="8,0"
                                                    HorizontalContentAlignment="Stretch"
                                                    AutoToolTipPlacement="None"
                                                    AutomationProperties.AutomationId="UXSlider_HorizontalToolTipNone"
                                                    AutomationProperties.Name="SliderToolTipNone"
                                                    IsSnapToTickEnabled="True"
                                                    LargeChange="1"
                                                    Maximum="{Binding Path=LuminanceMaxValue}"
                                                    Minimum="45"
                                                    SmallChange="1"
                                                    Value="{Binding Path=LuminanceValue, Mode=TwoWay}" />

                                                <UXControls:UXTextBlock
                                                    Name="LuminanceTextBlock"
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource PercentageTextColor}"
                                                    Text="{Binding Path=LuminanceValue, StringFormat={}{0} cd/m2}"
                                                    TextBlockSemanticColorType="Light"
                                                    TextBlockType="Body2" />
                                            </Grid>
                                            <!--  Row: Buttons  -->
                                            <Grid>
                                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                                    <UXControls:UXButton
                                                        Name="btnManualLuminance"
                                                        Width="111"
                                                        Height="40"
                                                        Margin="8,0,0,16"
                                                        Padding="24,8"
                                                        ButtonSemanticColorType="Neutral"
                                                        ButtonType="Secondary"
                                                        Click="Hotkey_Click"
                                                        Content="{Binding [Hotkeys], Source={x:Static lang:LangHelper.Instance}}"
                                                        CornerRadius="2"
                                                        Style="{StaticResource Button_WhiteFrame}" />
                                                    <UXControls:UXButton
                                                        Width="111"
                                                        Height="40"
                                                        Margin="8,0,0,16"
                                                        Padding="24,8"
                                                        ButtonSemanticColorType="Destructive"
                                                        ButtonType="Primary"
                                                        Click="Reset_Click"
                                                        Content="{Binding [Reset], Source={x:Static lang:LangHelper.Instance}}"
                                                        CornerRadius="2"
                                                        Foreground="{DynamicResource RightView_Btn_TextColor}" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!--  synchronize  -->
                                    <Grid
                                        Height="60"
                                        IsEnabled="{Binding BrightnessEnable}"
                                        Opacity="{Binding BrightnessOpacity}"
                                        Visibility="{Binding isShowSynchronize}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <UXControls:UXTextBlock
                                            Name="SynchronizeTextBlock_Luminance"
                                            Grid.Column="0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            FontSize="16"
                                            Foreground="{DynamicResource TextBlock_ForegroundColor}"
                                            Text="{Binding [Brightness.4], Source={x:Static lang:LangHelper.Instance}}"
                                            TextBlockSemanticColorType="Light"
                                            TextBlockType="Display1" />

                                        <Image
                                            Grid.Column="1"
                                            Width="16"
                                            Height="16"
                                            Margin="4,0"
                                            Cursor="Hand"
                                            Source="pack://application:,,,/DDPM.UI.Common;component/Resources/Icon_Info.png"
                                            Stretch="Uniform">
                                            <Image.ToolTip>
                                                <ToolTip>
                                                    <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                                        <Border.Resources>
                                                            <Style BasedOn="{StaticResource Tooltip_TextBlockStyle}" TargetType="TextBlock" />
                                                        </Border.Resources>
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding [Brightness.5], Source={x:Static lang:LangHelper.Instance}}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </ToolTip>
                                            </Image.ToolTip>
                                        </Image>

                                        <Image
                                            Grid.Column="1"
                                            Width="16"
                                            Height="16"
                                            Margin="90,0,20,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Source="pack://application:,,,/DDPM.UI.Common;component/Resources/Lock.png"
                                            Visibility="{Binding synchronizeLock}" />

                                        <UXControls:UXToggleSwitch
                                            Name="SynchronizeSwitch_Luminance"
                                            Grid.Column="2"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            AutomationProperties.Name="ToggleSwitchLeft"
                                            Click="Synchronize_LuminanceSwitch_Click"
                                            Content="{Binding Path=IsSynchronize_String}"
                                            ContentPlacement="Left"
                                            ContentTextVisibility="True"
                                            Foreground="{DynamicResource TextBlock_ForegroundColor}"
                                            IsChecked="{Binding Path=IsSynchronize}"
                                            IsEnabled="{Binding IsSynchronizeDisabled, Converter={StaticResource InverseBooleanConverter}}" />
                                    </Grid>
                                </StackPanel>
                            </Expander.Content>
                        </Expander>
                    </Border>

                    <!--  RightGroupBorder.Auto  -->
                    <Border
                        Margin="0,16,0,0"
                        IsEnabled="{Binding BrightnessEnable}"
                        Opacity="{Binding BrightnessOpacity}"
                        Style="{DynamicResource RightGroupBorderStyle}"
                        Visibility="{Binding isAlsSupported}">
                        <Expander
                            Name="Expander_Auto"
                            Expanded="Expander_Auto_Expanded"
                            Style="{StaticResource RightExpanderStyle}">
                            <!--  IsExpanded="{Binding ExpanderGroup, Mode=TwoWay, Converter={StaticResource radioBoolToIntConverter}, ConverterParameter=1}">  -->
                            <Expander.Header>
                                <!--  Group Header: Manual  -->
                                <Grid Height="60">
                                    <UXControls:UXTextBlock
                                        Margin="30,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        FontSize="20"
                                        Foreground="{DynamicResource TextBlock_ForegroundColor}"
                                        Text="{Binding [Auto], Source={x:Static lang:LangHelper.Instance}}"
                                        TextBlockSemanticColorType="Light"
                                        TextBlockType="Caption" />
                                    <Image
                                        Grid.Column="1"
                                        Width="16"
                                        Height="16"
                                        Margin="90,0,20,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Source="pack://application:,,,/DDPM.UI.Common;component/Resources/Lock.png"
                                        Visibility="{Binding AutoALSLock}" />
                                </Grid>
                            </Expander.Header>

                            <StackPanel Margin="0,20,0,0">

                                <!--  synchronize  -->
                                <Grid IsEnabled="{Binding BrightnessEnable}" Opacity="{Binding BrightnessOpacity}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid
                                        x:Name="AutoBriGrid"
                                        Grid.Row="0"
                                        Height="50">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AutoALSLock}" Value="Visible">
                                                        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding AutoALSLock}" Value="Collapsed">
                                                        <Setter Property="KeyboardNavigation.TabNavigation" Value="Local" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <UXControls:UXTextBlock
                                            Name="AutoBrightnessText"
                                            Grid.Column="0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            FontSize="16"
                                            Foreground="{DynamicResource TextBlock_ForegroundColor}"
                                            Text="{Binding [Brightness.6], Source={x:Static lang:LangHelper.Instance}}"
                                            TextBlockSemanticColorType="Light"
                                            TextBlockType="Display1" />

                                        <Image
                                            Grid.Column="1"
                                            Width="16"
                                            Height="16"
                                            Margin="4,0"
                                            Source="pack://application:,,,/DDPM.UI.Common;component/Resources/Icon_Info.png"
                                            Stretch="Uniform">
                                            <Image.ToolTip>
                                                <ToolTip>
                                                    <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                                        <Border.Resources>
                                                            <Style BasedOn="{StaticResource Tooltip_TextBlockStyle}" TargetType="TextBlock" />
                                                        </Border.Resources>
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding [Brightness.7], Source={x:Static lang:LangHelper.Instance}}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </ToolTip>
                                            </Image.ToolTip>
                                        </Image>
                                        <Image
                                            Grid.Column="2"
                                            Width="16"
                                            Height="16"
                                            Margin="8,0,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Source="pack://application:,,,/DDPM.UI.Common;component/Resources/Lock.png"
                                            Visibility="{Binding AutoBrightnessLock}" />
                                        <UXControls:UXToggleSwitch
                                            Name="AutoBrightnessSwitch"
                                            Grid.Column="3"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            AutomationProperties.Name="ToggleSwitchLeft"
                                            Content="{Binding Path=AutoBrightness_String}"
                                            ContentPlacement="Left"
                                            ContentTextVisibility="True"
                                            Foreground="{DynamicResource TextBlock_ForegroundColor}"
                                            IsChecked="{Binding Path=AutoBrightnessStatus}"
                                            IsEnabled="{Binding Path=SupportedAutoBrightness}"
                                            IsTabStop="False" />
                                        <!--  遮罩  -->
                                        <Border
