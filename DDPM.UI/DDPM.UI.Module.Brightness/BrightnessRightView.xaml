                                                        <ColumnDefinition Width="30*" />
                                                        <ColumnDefinition Width="15" />
                                                        <ColumnDefinition Width="30*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Grid Grid.Column="0">

                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="24" />
                                                            <RowDefinition Height="40" />
                                                        </Grid.RowDefinitions>

                                                        <UXControls:UXTextBlock
                                                            Grid.Row="0"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            FontSize="16"
                                                            Foreground="{DynamicResource TextBlock_ForegroundColor}"
                                                            Text="{Binding [Brightness.18], Source={x:Static lang:LangHelper.Instance}}"
                                                            TextBlockSemanticColorType="Light"
                                                            TextBlockType="Display1" />

                                                        <UXControls:UXTextBox
                                                            Name="PR2_Luminance_Name_UXTextBox"
                                                            Grid.Row="1"
                                                            VerticalContentAlignment="Center"
                                                            BorderBrush="#7E7E7E"
                                                            BorderThickness="1"
                                                            FontSize="14"
                                                            IsEnabled="{Binding IsPR_Luminance_Preview, Converter={StaticResource boolReverseConverter}}"
                                                            MaxLength="30"
                                                            PreviewTextInput="InputName_PreviewTextInput"
                                                            Text="{Binding PR2Name}"
                                                            TextChanged="PR2Name_TextChanged" />
                                                    </Grid>

                                                    <Grid Grid.Column="1" />

                                                    <Grid Grid.Column="2">

                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="24" />
                                                            <RowDefinition Height="40" />
                                                        </Grid.RowDefinitions>

                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="70" />
                                                            <ColumnDefinition Width="5" />
                                                            <ColumnDefinition Width="70" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <UXControls:UXTextBlock
                                                            Grid.Row="0"
                                                            Grid.Column="0"
                                                            Grid.ColumnSpan="4"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            FontSize="16"
                                                            Foreground="{DynamicResource Brightness_TimeText_ForegroundColor}"
                                                            Text="{Binding [Brightness.15], Source={x:Static lang:LangHelper.Instance}}"
                                                            TextBlockSemanticColorType="Light"
                                                            TextBlockType="Display1" />

                                                        <UXControls:UXComboBox
                                                            Name="PR2_Luminance_Hour_UXComboBox"
                                                            Grid.Row="1"
                                                            Grid.Column="0"
                                                            Height="40"
                                                            MinWidth="70"
                                                            IsEnabled="{Binding IsPR_Luminance_Preview, Converter={StaticResource boolReverseConverter}}"
                                                            ItemsSource="{Binding hOurs}"
                                                            SelectedItem="{Binding hOurs2, Mode=TwoWay}"
                                                            SelectionChanged="ComboBox_SelectionChanged"
                                                            Style="{StaticResource DdpmComboBoxStyle}" />

                                                        <Grid Grid.Column="1" />

                                                        <UXControls:UXComboBox
                                                            Name="PR2_Luminance_Min_UXComboBox"
                                                            Grid.Row="1"
                                                            Grid.Column="2"
                                                            Height="40"
                                                            MinWidth="70"
                                                            IsEnabled="{Binding IsPR_Luminance_Preview, Converter={StaticResource boolReverseConverter}}"
                                                            ItemsSource="{Binding mIns}"
                                                            SelectedItem="{Binding mIns2, Mode=TwoWay}"
                                                            SelectionChanged="ComboBox_SelectionChanged"
                                                            Style="{StaticResource DdpmComboBoxStyle}" />

                                                        <UXControls:UXTextBlock
                                                            Grid.Row="1"
                                                            Grid.Column="3"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            FontSize="16"
                                                            Foreground="{DynamicResource TextBlock_ForegroundColor}"
                                                            Text="{Binding [PM], Source={x:Static lang:LangHelper.Instance}}"
                                                            TextBlockSemanticColorType="Light"
                                                            TextBlockType="Display1" />
                                                    </Grid>

                                                    <Grid Grid.Column="3" />

                                                    <Grid Grid.Column="4">

                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="24" />
                                                            <RowDefinition Height="40" />
                                                        </Grid.RowDefinitions>

                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="116" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel
                                                            Grid.Row="0"
                                                            Grid.Column="0"
                                                            Grid.ColumnSpan="2"
                                                            Orientation="Horizontal">

                                                            <UXControls:UXTextBlock
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Center"
                                                                FontSize="16"
                                                                Foreground="{DynamicResource Brightness_TimeText_ForegroundColor}"
                                                                Text="{Binding [Brightness.16], Source={x:Static lang:LangHelper.Instance}}"
                                                                TextBlockSemanticColorType="Light"
                                                                TextBlockType="Display1" />

                                                            <Image
                                                                Width="16"
                                                                Height="16"
                                                                Margin="10,0"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Center"
                                                                Source="pack://application:,,,/DDPM.UI.Common;component/Resources/Icon_Info.png"
                                                                Stretch="Uniform">
                                                                <Image.ToolTip>
                                                                    <ToolTip>
                                                                        <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                                                            <Border.Resources>
                                                                                <Style BasedOn="{StaticResource Tooltip_TextBlockStyle}" TargetType="TextBlock" />
                                                                            </Border.Resources>
                                                                            <StackPanel>
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <TextBlock Text="{Binding [Brightness.17], Source={x:Static lang:LangHelper.Instance}}" />
                                                                                </StackPanel>
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </ToolTip>
                                                                </Image.ToolTip>
                                                            </Image>
                                                        </StackPanel>

                                                        <UXControls:UXComboBox
                                                            Name="PR2_Luminance_Duration_UXComboBox"
                                                            Grid.Row="1"
                                                            Grid.Column="0"
                                                            Height="40"
                                                            MinWidth="70"
                                                            IsEnabled="{Binding IsPR_Luminance_Preview, Converter={StaticResource boolReverseConverter}}"
                                                            ItemsSource="{Binding dUration}"
                                                            SelectedItem="{Binding dUration2, Mode=TwoWay}"
                                                            SelectionChanged="ComboBox_SelectionChanged"
                                                            Style="{StaticResource DdpmComboBoxStyle}" />

                                                        <UXControls:UXTextBlock
                                                            Grid.Row="1"
                                                            Grid.Column="1"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            FontSize="16"
                                                            Foreground="{DynamicResource TextBlock_ForegroundColor}"
                                                            Text="{Binding [Min], Source={x:Static lang:LangHelper.Instance}}"
                                                            TextBlockSemanticColorType="Light"
                                                            TextBlockType="Display1" />
                                                    </Grid>
                                                </Grid>

                                                <!--  Row: "Brightness"  -->

                                                <Grid Height="40">
                                                    <UXControls:UXTextBlock
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        FontSize="16"
                                                        Foreground="{DynamicResource TextBlock_ForegroundColor}"
                                                        Text="{Binding [Luminance], Source={x:Static lang:LangHelper.Instance}}"
                                                        TextBlockSemanticColorType="Light"
                                                        TextBlockType="Display1" />
                                                </Grid>

                                                <!--  Row: Brightness Slider  -->
                                                <Grid Height="60">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Image
                                                        Grid.Column="0"
                                                        Width="20"
                                                        Height="20"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Source="{Binding LuminanceImage}" />

                                                    <UXControls:UXSlider
                                                        Name="preset2_LuminanceSlider"
                                                        Grid.Column="1"
                                                        Margin="8,0"
                                                        HorizontalContentAlignment="Stretch"
                                                        IsEnabled="{Binding IsPR_Luminance_Preview, Converter={StaticResource boolReverseConverter}}"
                                                        IsSnapToTickEnabled="True"
                                                        LargeChange="1"
                                                        Maximum="{Binding Path=LuminanceMaxValue}"
                                                        Minimum="45"
                                                        SmallChange="1"
                                                        Value="{Binding Path=PR2LuminanceValue, Mode=TwoWay}" />

                                                    <UXControls:UXTextBlock
                                                        Name="preset2_LuminanceTextBlock"
                                                        Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        Foreground="{DynamicResource PercentageTextColor}"
                                                        Text="{Binding Path=PR2LuminanceValue, StringFormat={}{0} cd/m2}"
                                                        TextBlockSemanticColorType="Light"
                                                        TextBlockType="Body2" />
                                                </Grid>

                                                <!--  Row: Buttons  -->
                                                <Grid>
                                                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                                        <UXControls:UXButton
                                                            Name="PR2_Luminance_Preview_UXButton"
                                                            Width="173"
                                                            Height="40"
                                                            Padding="24,8"
                                                            ButtonSemanticColorType="Neutral"
                                                            ButtonType="Secondary"
                                                            Click="PR2_Luminance_Preview_UXButton_Click"
                                                            Content="{Binding PR2_Luminance_ButtonContent}"
                                                            CornerRadius="2"
                                                            IsEnabled="{Binding IsPR1_Luminance_Preview, Converter={StaticResource boolReverseConverter}}"
                                                            Style="{StaticResource Button_WhiteFrame}" />
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <Grid
                                        Height="60"
                                        IsEnabled="{Binding BrightnessEnable}"
                                        Opacity="{Binding BrightnessOpacity}"
                                        Visibility="{Binding isShowSynchronize}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <UXControls:UXTextBlock
                                            Name="Scheduled_Luminance_SynchronizeTextBlock"
                                            Grid.Column="0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            FontSize="16"
                                            Foreground="{DynamicResource TextBlock_ForegroundColor}"
                                            Text="{Binding [Brightness.4], Source={x:Static lang:LangHelper.Instance}}"
                                            TextBlockSemanticColorType="Light"
                                            TextBlockType="Display1" />

                                        <Image
                                            Grid.Column="1"
                                            Width="16"
                                            Height="16"
                                            Margin="4,0"
                                            Cursor="Hand"
                                            Source="pack://application:,,,/DDPM.UI.Common;component/Resources/Icon_Info.png"
                                            Stretch="Uniform">
                                            <Image.ToolTip>
                                                <ToolTip>
                                                    <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                                        <Border.Resources>
                                                            <Style BasedOn="{StaticResource Tooltip_TextBlockStyle}" TargetType="TextBlock" />
                                                        </Border.Resources>
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding [Brightness.21], Source={x:Static lang:LangHelper.Instance}}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </ToolTip>
                                            </Image.ToolTip>
                                        </Image>

                                        <Image
                                            Grid.Column="1"
                                            Width="16"
                                            Height="16"
                                            Margin="90,0,20,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Source="pack://application:,,,/DDPM.UI.Common;component/Resources/Lock.png"
                                            Visibility="{Binding synchronizeLock}" />

                                        <UXControls:UXToggleSwitch
                                            Name="ScheduledLuminanceSynchronizeSwitch"
                                            Grid.Column="2"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            AutomationProperties.Name="ToggleSwitchLeft"
                                            Click="Synchronize_LuminanceScheduledSwitch_Click"
                                            Content="{Binding Path=IsSynchronize_Scheduled_String}"
                                            ContentPlacement="Left"
                                            ContentTextVisibility="True"
                                            Foreground="{DynamicResource TextBlock_ForegroundColor}"
                                            IsChecked="{Binding Path=IsSynchronize_Scheduled}"
                                            IsEnabled="{Binding IsSynchronizeDisabled, Converter={StaticResource InverseBooleanConverter}}" />
                                    </Grid>
                                </StackPanel>
                            </Expander.Content>
                        </Expander>
                    </Border>
                </StackPanel>

                <Border Name="DisableAll" Background="#4C24273C">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <UXControls:UXBusyIndicator
                        Width="64"
                        Height="64"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        BusyIndicatorType="Secondary"
                        IsActive="{Binding IsBusy}" />
                </Border>
                <Border Name="DisableAll2" Background="#4C24273C">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusyALS}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <UXControls:UXBusyIndicator
                        Width="64"
                        Height="64"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        BusyIndicatorType="Secondary"
                        IsActive="{Binding IsBusyALS}" />
                </Border>
            </Grid>
        </UXControls:UXScrollViewer>
        <Border
            Background="#132F54"
            CornerRadius="13"
            Opacity="0.6"
            Visibility="{Binding LockMaskVisible}" />
    </Grid>
</UserControl>