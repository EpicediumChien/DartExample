<UserControl x:Class="DDPM.UI.Module.EzMemory.EzMemoryFirst"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DDPM.UI.Module.EzMemory"
             xmlns:lang="clr-namespace:DDPM.UI.Resources.Helper;assembly=DDPM.UI.Resources"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF" 
             xmlns:commonCtrl="clr-namespace:DDPM.UI.Common.UserControls;assembly=DDPM.UI.Common" 
             xmlns:viewmodels="clr-namespace:DDPM.UI.Common.ViewModels;assembly=DDPM.UI.Common"
             d:DataContext="{d:DesignInstance Type=viewmodels:EzArrangeViewModel}"
             mc:Ignorable="d" 
             Background="#FF0D121A"
             d:DesignHeight="671" 
             d:DesignWidth="1378">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DDPM.UI.Common;component/ModuleStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <Style x:Key="UXTextBlock_Caption" TargetType="UXControls:UXTextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Margin" Value="0,0,8,0" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Image x:Name="imgBkGlow"
               Source="pack://application:,,,/DDPM.UI.Common;component/Resources/Background_Glow.png"
               Stretch="UniformToFill"
               HorizontalAlignment="Center" 
               VerticalAlignment="Center" />

        <StackPanel>
            <Grid Margin="0" Visibility="{Binding PeripheralVisibility}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="552" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid x:Name="LeftGrid" Grid.Column="0" Margin="76, 60, 0, 0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="120" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Progress Bar -->
                    <Grid Grid.Row="0">
                        <ProgressBar x:Name="EzMemoryProgressbar" Background="#293B4D" BorderBrush="Transparent" BorderThickness="0" HorizontalAlignment="Left" Height="5" Width="281" Minimum="0" Maximum="3" Value="1">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar">
                                    <Setter Property="Foreground" Value="#A4B8CD" />
                                </Style>
                            </ProgressBar.Style>

                            <ProgressBar.Triggers>
                                <EventTrigger RoutedEvent="ProgressBar.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Value" From="0" To="{Binding ProgressValue}" Duration="0:0:1" FillBehavior="HoldEnd" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </ProgressBar.Triggers>
                        </ProgressBar>
                    </Grid>

                    <!-- Feature Highlight Title -->
                    <Grid Grid.Row="1" Margin="0, 50, 0, 0" Width="auto" Height="28" HorizontalAlignment="Left">
                        <UXControls:UXTextBlock x:Name="TitleText" Text="EASY MEMORY SETUP" Foreground="#DAF5FD" FontSize="20" LineHeight="28" />
                    </Grid>

                    <!-- Customizable Keys Title -->
                    <Grid Grid.Row="2" Margin="0, 8, 0, 0" Width="476" HorizontalAlignment="Left">
                        <UXControls:UXTextBlock x:Name="MainText" Text="" Foreground="#F5F6F7" FontSize="60" TextWrapping="Wrap"/>
                    </Grid>

                    <!-- Description Text -->
                    <Grid Grid.Row="3" Margin="0, 16, 0, 0" Width="476" HorizontalAlignment="Left">
                        <UXControls:UXTextBlock x:Name="SubText" Text="" Foreground="#F5F6F7" FontSize="15" TextWrapping="Wrap" />
                    </Grid>

                    <!-- Buttons -->
                    <Grid Grid.Row="4" Margin="0, 0, 0, 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- First Button Group -->
                        <Grid Grid.Column="0" Margin="0,170,0,0">
                            <StackPanel Orientation="Horizontal">
                                <UXControls:UXButton x:Name="ArrowButton" Visibility="{Binding ArrowButtonVisibility}" Width="48" Height="40" ButtonType="Secondary" ButtonSize="Medium" IconAnimation="Move" Margin="0" Padding="16,8" Foreground="#F5F6F7" BorderBrush="#F5F6F7" Click="ArrowButton_Click">
                                    <Path Data="M3.62037 11.6746L3.34146 12L3.62037 12.3254L9.62037 19.3254L10.3796 18.6746L5.08711 12.5L21 12.5L21 11.5L5.08711 11.5L10.3796 5.32538L9.62037 4.67459L3.62037 11.6746Z" Fill="#F5F6F7" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </UXControls:UXButton>

                                <!-- Next Button -->
                                <UXControls:UXButton x:Name="NextBtn" IconPosition="IconRight" HorizontalContentAlignment="Center" ButtonType="Primary" Padding="40, 8" ButtonSize="Medium" VerticalContentAlignment="Center" Margin="10, 0, 0, 0" IconAnimation="Move" Width="164" Height="40" Click="NextBtn_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <UXControls:UXTextBlock Margin="8,0" Text="{Binding [Kvm.1], Source={x:Static lang:LangHelper.Instance}}" Foreground="White"/>
                                        <Path x:Name="ArrowPath" Margin="0,2" Data="M17.3796 8.3256L17.6585 8.0002L17.3796 7.67481L11.3796 0.674805L10.6204 1.3256L15.9129 7.5002H0V8.5002H15.9129L10.6204 14.6748L11.3796 15.3256L17.3796 8.3256Z" Fill="white">
                                            <Path.RenderTransform>
                                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                            </Path.RenderTransform>
                                        </Path>
                                    </StackPanel>
                                    <UXControls:UXButton.Triggers>
                                        <EventTrigger RoutedEvent="MouseEnter">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="ArrowPath" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" From="1" To="1.2" Duration="0:0:1" AutoReverse="True" RepeatBehavior="Forever" />
                                                    <DoubleAnimation Storyboard.TargetName="ArrowPath" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" From="1" To="1.2" Duration="0:0:1" AutoReverse="True" RepeatBehavior="Forever" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="MouseLeave">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="ArrowPath" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2" />
                                                    <DoubleAnimation Storyboard.TargetName="ArrowPath" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </UXControls:UXButton.Triggers>
                                </UXControls:UXButton>
                            </StackPanel>
                        </Grid>

                        <!-- Second Button Group -->
                        <Grid Grid.Column="1" Margin="0,170,0,0">
                            <UXControls:UXButton x:Name="CancelBtn" Visibility="{Binding SkipButtonVisibility}" ButtonType="Tertiary" Width="90" Height="40" ButtonSize="Medium" Margin="10, 0" Content="Cancel" IconAnimation="Move" Click="CancelBtn_Click"/>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- Keyboard Image and Settings -->
                <Grid x:Name="RightGridPage1" Visibility="{Binding RightGridPage1Visibility}" Grid.Column="1" Width="657" Margin="64, 16, 96, 0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel HorizontalAlignment="Left">
                        <UXControls:UXTextBlock x:Name="NameProfileText" Grid.Row="0" Margin="0, 48, 0, 0" Text="Name the profile" Foreground="#DAF5FD" FontSize="16" />
                        <UXControls:UXTextBox x:Name="InputText" Grid.Row="1" Margin="0, 8, 0, 0" Width="260" Height="40" Text="{Binding InputText}" Foreground="#F5F6F7" FontSize="14"/>
                        <UXControls:UXTextBlock x:Name="SelectText" Grid.Row="2" Margin="0, 24, 0, 0" Text="Select a layout" Foreground="#F5F6F7" FontSize="16" />
                    </StackPanel>

                    <UXControls:UXScrollViewer Grid.Row="3" Margin="0,16,0,0" Height="400">
                        <Grid>
                            <StackPanel>
                                <Border Style="{StaticResource RightPartBorderStyle}">
                                    <StackPanel>
                                        <!-- Recent -->
                                        <Grid Height="40">
                                            <UXControls:UXTextBlock Text="{Binding [Recent], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource UXTextBlock_Caption}" />
                                        </Grid>
                                        <!-- -->
                                        <commonCtrl:SplitListView Name="splitListView_Recent" Margin="0,4" ItemClickCommand="{Binding ListViewItemClickCommand}" />
                                        <!--<ezCommon:EzListView />-->
                                        <!-- Custom -->
                                        <StackPanel Orientation="Horizontal" Height="40" Margin="0,16,0,0">
                                            <UXControls:UXTextBlock Text="{Binding [Custom], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource UXTextBlock_Caption}" />
                                            <Viewbox Width="16" Height="16" Stretch="Uniform">
                                                <Grid Width="16" Height="16" Background="{StaticResource FakeTransparent}">
                                                    <Grid.ToolTip>
                                                        <ToolTip>
                                                            <Border Style="{StaticResource Tooltip_OutterBorderStyle}" MaxWidth="360">
                                                                <Grid>
                                                                    <TextBlock Name="customListTooltipText" Style="{StaticResource Tooltip_TextBlockStyle}" TextWrapping="Wrap"/>
                                                                </Grid>
                                                            </Border>
                                                        </ToolTip>
                                                    </Grid.ToolTip>
                                                    <Path Data="M8 5.0498C8.55228 5.0498 9 4.60209 9 4.0498C9 3.49752 8.55228 3.0498 8 3.0498C7.44772 3.0498 7 3.49752 7 4.0498C7 4.60209 7.44772 5.0498 8 5.0498Z" Fill="#FFB6B6B6" />
                                                    <Path Data="M8.75 6.4502H7.25V12.6502H8.75V6.4502Z" Fill="#FFB6B6B6" />
                                                    <Path Data="M8 1C11.85 1 15 4.15 15 8C15 11.85 11.85 15 8 15C4.15 15 1 11.85 1 8C1 4.15 4.15 1 8 1ZM8 0C3.6 0 0 3.6 0 8C0 12.4 3.6 16 8 16C12.4 16 16 12.4 16 8C16 3.6 12.4 0 8 0Z" Fill="#FFB6B6B6" />
                                                </Grid>
                                            </Viewbox>
                                        </StackPanel>
                                        <commonCtrl:SplitListView Name="splitListView_Custom" Margin="0,4" ItemClickCommand="{Binding ListViewItemClickCommand}" />
                                        <!-- 2 Windows -->
                                        <Grid Height="40" Margin="0,16,0,0">
                                            <UXControls:UXTextBlock Text="{Binding [Windows], Source={x:Static lang:LangHelper.Instance},StringFormat={}2 {0}}" Style="{StaticResource UXTextBlock_Caption}" />
                                        </Grid>
                                        <commonCtrl:SplitListView Name="splitListView_2w" Margin="0,4" ItemClickCommand="{Binding ListViewItemClickCommand}" />
                                        <!-- 3 Windows -->
                                        <Grid Height="40" Margin="0,16,0,0">
                                            <UXControls:UXTextBlock Text="{Binding [Windows], Source={x:Static lang:LangHelper.Instance},StringFormat={}3 {0}}" Style="{StaticResource UXTextBlock_Caption}" />
                                        </Grid>
                                        <commonCtrl:SplitListView Name="splitListView_3w" Margin="0,4" ItemClickCommand="{Binding ListViewItemClickCommand}" />
                                        <!--4 Windows-->
                                        <Grid Height="40" Margin="0,16,0,0">
                                            <UXControls:UXTextBlock Text="{Binding [Windows], Source={x:Static lang:LangHelper.Instance},StringFormat={}4 {0}}" Style="{StaticResource UXTextBlock_Caption}" />
                                        </Grid>
                                        <commonCtrl:SplitListView Name="splitListView_4w" Margin="0,4" ItemClickCommand="{Binding ListViewItemClickCommand}" />
                                        <!--5 Windows-->                                      
                                        <Grid Height="40" Margin="0,16,0,0">
                                            <UXControls:UXTextBlock Text="{Binding [Windows], Source={x:Static lang:LangHelper.Instance},StringFormat={}5 {0}}" Style="{StaticResource UXTextBlock_Caption}" />
                                        </Grid>
                                        <commonCtrl:SplitListView Name="splitListView_5w" Margin="0,4" ItemClickCommand="{Binding ListViewItemClickCommand}" />
                                        <!--6 Windows-->                                        
                                        <Grid Height="40" Margin="0,16,0,0">
                                            <UXControls:UXTextBlock Text="{Binding [Windows], Source={x:Static lang:LangHelper.Instance},StringFormat={}6 {0}}" Style="{StaticResource UXTextBlock_Caption}" />
                                        </Grid>
                                        <commonCtrl:SplitListView Name="splitListView_6w" Margin="0,4" ItemClickCommand="{Binding ListViewItemClickCommand}" />
                                         
                                        <!--7 Windows or more-->                                         
                                        <Grid Height="40">
                                            <UXControls:UXTextBlock Text="{Binding [EzArrange.1], Source={x:Static lang:LangHelper.Instance},StringFormat={}7 {0}}" Style="{StaticResource UXTextBlock_Caption}" />
                                        </Grid>
                                        <commonCtrl:SplitListView Name="splitListView_7w" Margin="0,4" ItemClickCommand="{Binding ListViewItemClickCommand}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </UXControls:UXScrollViewer>
                </Grid>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
