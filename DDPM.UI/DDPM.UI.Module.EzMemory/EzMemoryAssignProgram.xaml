<UserControl x:Class="DDPM.UI.Module.EzMemory.EzMemoryAssignProgram"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DDPM.UI.Module.EzMemory"
             xmlns:lang="clr-namespace:DDPM.UI.Resources.Helper;assembly=DDPM.UI.Resources"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF" 
             xmlns:commonCtrl="clr-namespace:DDPM.UI.Common.UserControls;assembly=DDPM.UI.Common" 
             xmlns:viewmodels="clr-namespace:DDPM.UI.Common.ViewModels;assembly=DDPM.UI.Common"
             d:DataContext="{d:DesignInstance Type=viewmodels:EzArrangeViewModel}"
             mc:Ignorable="d" 
             Background="#FF0D121A"
             d:DesignHeight="671" 
             d:DesignWidth="1378"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- <ResourceDictionary Source="/DDPM.UI.Common;component/ModuleStyle.xaml" /> -->
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <Style x:Key="UXTextBlock_Caption" TargetType="UXControls:UXTextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Margin" Value="0,0,8,0" />
            </Style>

            <Style x:Key="DynamicButtonStyle" TargetType="UXControls:UXButton">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="UXControls:UXButton">
                            <Grid>
                                <Image x:Name="PART_Image" Source="pack://application:,,,/DDPM.UI.Common;component/Resources/EzRemove.png" Width="30" Height="30"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>

                <Style.Triggers>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="UXControls:UXButton">
                                    <Grid>
                                        <Image x:Name="PART_Image" Source="pack://application:,,,/DDPM.UI.Common;component/Resources/EzAdd.png" Width="30" Height="30"/>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>
                </Style.Triggers>
            </Style>



            <!--<Style x:Key="TransparentButtonStyle" TargetType="UXControls:UXButton">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="UXControls:UXButton">
                            <Grid>
                                <Image Source="pack://application:,,,/DDPM.UI.Common;component/Resources/EzAdd.png" Width="30" Height="30"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                -->
            <!-- 透明遮罩 -->
            <!--
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="Transparent"/>
                    </Trigger>
                </Style.Triggers>
            </Style>-->

            <local:WindowGridVisibilityConverter x:Key="WindowGridVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Image x:Name="imgBkGlow"
               Source="pack://application:,,,/DDPM.UI.Common;component/Resources/Background_Glow.png"
               Stretch="UniformToFill"
               HorizontalAlignment="Center" 
               VerticalAlignment="Center" />

        <StackPanel>
            <Grid Margin="0" Visibility="{Binding PeripheralVisibility}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="552" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid x:Name="LeftGrid" Grid.Column="0" Margin="76, 60, 0, 0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="120" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Progress Bar -->
                    <Grid Grid.Row="0">
                        <ProgressBar x:Name="EzMemoryProgressbar" Background="#293B4D" BorderBrush="Transparent" BorderThickness="0" HorizontalAlignment="Left" Height="5" Width="281" Minimum="0" Maximum="3" Value="2">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar">
                                    <Setter Property="Foreground" Value="#A4B8CD" />
                                </Style>
                            </ProgressBar.Style>

                            <ProgressBar.Triggers>
                                <EventTrigger RoutedEvent="ProgressBar.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Value" From="1" To="{Binding ProgressValue}" Duration="0:0:1" FillBehavior="HoldEnd" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </ProgressBar.Triggers>
                        </ProgressBar>
                    </Grid>

                    <!-- Feature Highlight Title -->
                    <Grid Grid.Row="1" Margin="0, 50, 0, 0" Width="auto" Height="28" HorizontalAlignment="Left">
                        <UXControls:UXTextBlock x:Name="TitleText" Text="EASY MEMORY SETUP" Foreground="#DAF5FD" FontSize="20" LineHeight="28" />
                    </Grid>

                    <!-- Customizable Keys Title -->
                    <Grid Grid.Row="2" Margin="0, 8, 0, 0" Width="476" HorizontalAlignment="Left">
                        <UXControls:UXTextBlock x:Name="MainText" Text="" Foreground="#F5F6F7" FontSize="60" TextWrapping="Wrap"/>
                    </Grid>

                    <!-- Description Text -->
                    <Grid Grid.Row="3" Margin="0, 16, 0, 0" Width="476" HorizontalAlignment="Left">
                        <UXControls:UXTextBlock x:Name="SubText" Text="" Foreground="#F5F6F7" FontSize="15" TextWrapping="Wrap" />
                    </Grid>

                    <!-- Buttons -->
                    <Grid Grid.Row="4" Margin="0, 0, 0, 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- First Button Group -->
                        <Grid Grid.Column="0" Margin="0,170,0,0">
                            <StackPanel Orientation="Horizontal">
                                <UXControls:UXButton x:Name="ArrowButton" Visibility="{Binding ArrowButtonVisibility}" Width="48" Height="40" ButtonType="Secondary" ButtonSize="Medium" IconAnimation="Move" Margin="0" Padding="16,8" Foreground="#F5F6F7" BorderBrush="#F5F6F7" Click="ArrowButton_Click">
                                    <Path Data="M3.62037 11.6746L3.34146 12L3.62037 12.3254L9.62037 19.3254L10.3796 18.6746L5.08711 12.5L21 12.5L21 11.5L5.08711 11.5L10.3796 5.32538L9.62037 4.67459L3.62037 11.6746Z" Fill="#F5F6F7" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </UXControls:UXButton>

                                <!-- Next Button -->
                                <UXControls:UXButton x:Name="NextBtn" IconPosition="IconRight" HorizontalContentAlignment="Center" ButtonType="Primary" Padding="40, 8" ButtonSize="Medium" VerticalContentAlignment="Center" Margin="10, 0, 0, 0" IconAnimation="Move" Width="164" Height="40" Click="NextBtn_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <UXControls:UXTextBlock Margin="8,0" Text="{Binding [Kvm.1], Source={x:Static lang:LangHelper.Instance}}" Foreground="White"/>
                                        <Path x:Name="ArrowPath" Margin="0,2" Data="M17.3796 8.3256L17.6585 8.0002L17.3796 7.67481L11.3796 0.674805L10.6204 1.3256L15.9129 7.5002H0V8.5002H15.9129L10.6204 14.6748L11.3796 15.3256L17.3796 8.3256Z" Fill="white">
                                            <Path.RenderTransform>
                                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                            </Path.RenderTransform>
                                        </Path>
                                    </StackPanel>
                                    <UXControls:UXButton.Triggers>
                                        <EventTrigger RoutedEvent="MouseEnter">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="ArrowPath" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" From="1" To="1.2" Duration="0:0:1" AutoReverse="True" RepeatBehavior="Forever" />
                                                    <DoubleAnimation Storyboard.TargetName="ArrowPath" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" From="1" To="1.2" Duration="0:0:1" AutoReverse="True" RepeatBehavior="Forever" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="MouseLeave">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="ArrowPath" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2" />
                                                    <DoubleAnimation Storyboard.TargetName="ArrowPath" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </UXControls:UXButton.Triggers>
                                </UXControls:UXButton>
                            </StackPanel>
                        </Grid>

                        <!-- Second Button Group -->
                        <Grid Grid.Column="1" Margin="0,170,0,0">
                            <UXControls:UXButton x:Name="CancelBtn" Visibility="{Binding SkipButtonVisibility}" ButtonType="Tertiary" Width="90" Height="40" ButtonSize="Medium" Margin="10, 0" Content="Cancel" IconAnimation="Move" Click="CancelBtn_Click"/>
                        </Grid>
                    </Grid>
                </Grid>

                <Path Grid.Column="1" Data="M360.797,1 H3.06681 C1.92534,1 1,1.93342 1,3.08485 V207.053 C1,208.205 1.92534,209.138 3.06681,209.138 H360.797 C361.938,209.138 362.863,208.205 362.863,207.053 V3.08485 C362.863,1.93342 361.938,1 360.797,1 Z"
          Stroke="White" StrokeThickness="0.646185" StrokeMiterLimit="10" Margin="210,65,0,0"/>
                <Path Grid.Column="1" Data="M191.376,261.044 V209.071 H170.818 V261.044 C170.819,261.746 171.099,262.419 171.595,262.914 C172.092,263.41 172.765,263.689 173.467,263.689 H188.731 C189.432,263.689 190.105,263.41 190.601,262.914 C191.098,262.418 191.376,261.746 191.376,261.044 Z"
          Stroke="White" StrokeThickness="0.323092" StrokeMiterLimit="10" Margin="210,65,0,0"/>
                <Path Grid.Column="1" Data="M170.821,260.406 H108.458 C108.087,260.406 107.722,260.504 107.401,260.69 C107.08,260.876 106.813,261.144 106.629,261.466 C106.444,261.788 106.348,262.153 106.35,262.524 C106.351,262.895 106.451,263.259 106.638,263.579 L114.07,276.269 C114.256,276.586 114.521,276.85 114.841,277.033 C115.16,277.216 115.521,277.313 115.89,277.313 H246.638 C246.996,277.314 247.347,277.223 247.66,277.05 C247.972,276.877 248.235,276.627 248.424,276.323 L256.378,263.634 C256.578,263.315 256.689,262.948 256.699,262.572 C256.709,262.196 256.618,261.824 256.436,261.494 C256.254,261.165 255.987,260.89 255.663,260.699 C255.339,260.507 254.969,260.406 254.593,260.406 H191.379"
          Stroke="White" StrokeThickness="0.258474" StrokeMiterLimit="10" Margin="210,65,0,0"/>
                <Path Grid.Column="1" Data="M107.41,264.905 L113.384,278.212 C113.623,278.742 114.009,279.192 114.497,279.508 C114.985,279.824 115.554,279.992 116.136,279.993 H246.147 C246.706,279.993 247.254,279.837 247.729,279.544 C248.205,279.25 248.59,278.83 248.841,278.331 L255.593,264.922"
          Stroke="White" StrokeThickness="0.258474" StrokeMiterLimit="10" Margin="210,65,0,0"/>

                <Canvas x:Name="MainCanvas" Grid.Column="1" Background="#193457" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="216,70,0,0" Width="351.525" Height="197.733"/>
                <ContentControl Name="EMsplitCtrl" Grid.Column="1" Background="#193457" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="216,70,0,0" Width="351.525" Height="197.733"/>

                <!-- Only 2 -->
                <!--<Grid x:Name="RightGridPage2" Visibility="Hidden" Grid.Column="1" Width="657" Margin="64, 96, 96, 0">-->
                <Grid x:Name="RightGridPage2" Visibility="{Binding IsRightGridPage2Visible, Converter={StaticResource BooleanToVisibilityConverter}}" Grid.Column="1" Width="657" Margin="64, 110, 96, 0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Monitor Outline Image -->
                    <!--<Image Grid.Row="0" Source="pack://application:,,,/DDPM.UI.Common;component/Resources/Monitor_Outline.png" HorizontalAlignment="Center" VerticalAlignment="Center" Width="361.86" Height="280" />-->

                    <!-- Bottom Control Panel -->
                    <Border Grid.Row="1" Background="#1B385F" CornerRadius="10" Margin="0,246,0,0" Padding="16" Width="415" Height="auto" HorizontalAlignment="Center">
                        <StackPanel>
                            <!-- Window 1 Control -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <UXControls:UXTextBlock Text="{Binding [EazyMemory.21], Source={x:Static lang:LangHelper.Instance}, Mode=OneWay}" VerticalAlignment="Center" Foreground="White" FontSize="14" Grid.Column="0" />
                                <Border BorderThickness="1.5" CornerRadius="3" BorderBrush="White" Background="#141D2B" Margin="80,0,0,0">
                                    <UXControls:UXTextBox x:Name="Window1_1TextBlock" Grid.Column="1" Width="250" Height="40" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White" Background="#141D2B" TextWrapping="NoWrap" Text="{Binding Window2_1AppName, Mode=TwoWay}" Tag="{Binding ElementName=Window2_1TextBlock}"/>
                                </Border>
                                <UXControls:UXButton Grid.Column="2" x:Name="AddButton2_1" Margin="16,0,0,0" Style="{StaticResource DynamicButtonStyle}" Tag="{Binding Text, ElementName=Window1_1TextBlock}" Click="AddButton1_Click"/>
                            </Grid>

                            <!-- Window 2 Control -->
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <UXControls:UXTextBlock Text="{Binding [EazyMemory.22], Source={x:Static lang:LangHelper.Instance}, Mode=OneWay}" VerticalAlignment="Center" Foreground="White" FontSize="14" Grid.Column="0" />
                                <Border BorderThickness="1.5" CornerRadius="3" BorderBrush="White" Background="#141D2B" Margin="80,0,0,0">
                                    <UXControls:UXTextBox x:Name="Window1_2TextBlock" Grid.Column="1" Width="250" Height="40" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White" Background="#141D2B" TextAlignment="Left" TextWrapping="NoWrap" Text="{Binding Window2_2AppName, Mode=TwoWay}" Tag="{Binding ElementName=Window2_2TextBlock}"/>
                                </Border>
                                <UXControls:UXButton Grid.Column="2" x:Name="AddButton2_2" Margin="16,0,0,0" Style="{StaticResource DynamicButtonStyle}" Tag="{Binding Text, ElementName=Window1_2TextBlock}" Click="AddButton1_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>


                <!-- Total -->
                <!--<Grid x:Name="RightGridPageTotal" Visibility="Hidden" Grid.Column="1" Width="657" Margin="64, 72, 96, 0">-->
                <Grid x:Name="RightGridPageTotal" Visibility="{Binding IsRightGridPageTotalVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Grid.Column="1" Width="657" Margin="64, 92, 96, 0">
                    <StackPanel>
                        <Border x:Name="RightBorderManyPage" Grid.Row="6" Background="#1B385F" CornerRadius="10" Margin="0,215,0,-262" Padding="16" Width="630" Height="Auto" HorizontalAlignment="Center" Opacity="0.8">
                            <!--Window 1 Control-->

                            <Grid Margin="0,-8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!--Windows 1 Row1-->

                                <Grid x:Name="WindowGrid_1" Grid.Column="0" Visibility="{Binding SelectedValue, Converter={StaticResource WindowGridVisibilityConverter}, ConverterParameter=1}">
                                    <DockPanel x:Name="DockPanel1">
                                        <UXControls:UXTextBlock x:Name="Window1Label" Text="{Binding [EazyMemory.21], Source={x:Static lang:LangHelper.Instance}, Mode=OneWay}" Width="76" Height="24" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="White" FontSize="14"/>
                                        <Border BorderThickness="1.5" CornerRadius="3" BorderBrush="White" Background="#141D2B">
                                            <UXControls:UXTextBox x:Name="Window1TextBlock" Width="150" Height="40" Margin="0,0,0,0" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White" Background="#141D2B" TextWrapping="NoWrap" Text="{Binding Window1AppName, Mode=TwoWay}" Tag="{Binding ElementName=Window1TextBlock}"/>
                                        </Border>
                                        <UXControls:UXButton x:Name="AddButton1" Style="{StaticResource DynamicButtonStyle}" Tag="{Binding Text, ElementName=Window1TextBlock}" Margin="16,0,16,0" Click="AddButton1_Click" />
                                    </DockPanel>
                                </Grid>


                                <!--Windows 2-->

                                <Grid x:Name="WindowGrid_2" Grid.Column="1" Visibility="{Binding SelectedValue, Converter={StaticResource WindowGridVisibilityConverter}, ConverterParameter=2}">
                                    <DockPanel Visibility="Visible">
                                        <UXControls:UXTextBlock Grid.Column="1" x:Name="Window2Label" Text="{Binding [EazyMemory.22], Source={x:Static lang:LangHelper.Instance}, Mode=OneWay}" Width="76" Height="24" Margin="16,0,8,0" VerticalAlignment="Center" Foreground="White" FontSize="14" />
                                        <Border BorderThickness="1.5" CornerRadius="3" BorderBrush="White" Background="#141D2B">
                                            <UXControls:UXTextBox x:Name="Window2TextBlock" Width="150" Height="40" Margin="0,0,0,0" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White" Background="#141D2B" TextWrapping="NoWrap" Text="{Binding Window2AppName, Mode=TwoWay}" Tag="{Binding ElementName=Window2TextBlock}"/>
                                        </Border>
                                        <UXControls:UXButton Grid.Column="1" x:Name="AddButton2" Style="{StaticResource DynamicButtonStyle}" Tag="{Binding Text, ElementName=Window2TextBlock}" Margin="16,0,0,0" Click="AddButton1_Click"/>
                                    </DockPanel>
                                </Grid>


                                <!--Windows 3 Row2-->

                                <Grid x:Name="WindowGrid_3" Grid.Column="0" Grid.Row="2" Visibility="{Binding SelectedValue, Converter={StaticResource WindowGridVisibilityConverter}, ConverterParameter=3}">
                                    <DockPanel Visibility="Visible">
                                        <UXControls:UXTextBlock x:Name="Window3Label" Text="{Binding [EazyMemory.23], Source={x:Static lang:LangHelper.Instance}, Mode=OneWay}" Width="76" Height="24" Margin="0,16,8,0" VerticalAlignment="Center" Foreground="White" FontSize="14" />
                                        <Border BorderThickness="1.5" CornerRadius="3" BorderBrush="White" Margin="0,16,8,0" Background="#141D2B">
                                            <UXControls:UXTextBox x:Name="Window3TextBlock" Width="150" Height="40" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White" Background="#141D2B" TextWrapping="NoWrap" Text="{Binding Window3AppName, Mode=TwoWay}" Tag="{Binding ElementName=Window3TextBlock}"/>
                                        </Border>
                                        <UXControls:UXButton  x:Name="AddButton3" Style="{StaticResource DynamicButtonStyle}" Tag="{Binding Text, ElementName=Window3TextBlock}" Margin="8,16,16,0" Click="AddButton1_Click"/>
                                    </DockPanel>
                                </Grid>


                                <!--Windows 4-->

                                <Grid x:Name="WindowGrid_4" Grid.Column="1" Grid.Row="2" Visibility="{Binding SelectedValue, Converter={StaticResource WindowGridVisibilityConverter}, ConverterParameter=4}">
                                    <DockPanel>
                                        <UXControls:UXTextBlock x:Name="Window4Label" Text="{Binding [EazyMemory.24], Source={x:Static lang:LangHelper.Instance}, Mode=OneWay}" Width="76" Height="24" Margin="16,16,0,0" VerticalAlignment="Center" Foreground="White" FontSize="14" />
                                        <Border BorderThickness="1.5" CornerRadius="3" BorderBrush="White" Margin="8,16,0,0" Background="#141D2B">
                                            <UXControls:UXTextBox x:Name="Window4TextBlock" Width="150" Height="40" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White" Background="#141D2B" TextWrapping="NoWrap" Text="{Binding Window4AppName, Mode=TwoWay}" Tag="{Binding ElementName=Window4TextBlock}"/>
                                        </Border>
                                        <UXControls:UXButton x:Name="AddButton4" Style="{StaticResource DynamicButtonStyle}" Tag="{Binding Text, ElementName=Window4TextBlock}" Margin="16,16,0,0"  Click="AddButton1_Click"/>
                                    </DockPanel>
                                </Grid>


                                <!--Windows 5 Row3-->

                                <Grid x:Name="WindowGrid_5" Grid.Column="0" Grid.Row="3" Visibility="{Binding SelectedValue, Converter={StaticResource WindowGridVisibilityConverter}, ConverterParameter=5}">
                                    <DockPanel >
                                        <UXControls:UXTextBlock x:Name="Window5Label" Text="{Binding [EazyMemory.25], Source={x:Static lang:LangHelper.Instance}, Mode=OneWay}" Width="76" Height="24" Margin="0,16,8,0" VerticalAlignment="Center" Foreground="White" FontSize="14" />
                                        <Border BorderThickness="1.5" CornerRadius="3" BorderBrush="White" Margin="0,16,0,0" Background="#141D2B">
                                            <UXControls:UXTextBox x:Name="Window5TextBlock" Width="150" Height="40" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White" Background="#141D2B" TextWrapping="NoWrap" Text="{Binding Window5AppName, Mode=TwoWay}" Tag="{Binding ElementName=Window5TextBlock}"/>
                                        </Border>
                                        <UXControls:UXButton x:Name="AddButton5" Style="{StaticResource DynamicButtonStyle}" Tag="{Binding Text, ElementName=Window5TextBlock}" Margin="16,16,16,0" Click="AddButton1_Click"/>
                                    </DockPanel>
                                </Grid>


                                <!--Windows 6-->

                                <Grid x:Name="WindowGrid_6" Grid.Column="1" Grid.Row="3" Visibility="{Binding SelectedValue, Converter={StaticResource WindowGridVisibilityConverter}, ConverterParameter=6}">
                                    <DockPanel >
                                        <UXControls:UXTextBlock x:Name="Window6Label" Text="{Binding [EazyMemory.26], Source={x:Static lang:LangHelper.Instance}, Mode=OneWay}" Width="76" Height="24" Margin="16,16,0,0" VerticalAlignment="Center" Foreground="White" FontSize="14" />
                                        <Border BorderThickness="1.5" CornerRadius="3" BorderBrush="White" Margin="8,16,8,0" Background="#141D2B">
                                            <UXControls:UXTextBox x:Name="Window6TextBlock" Width="150" Height="40" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White" Background="#141D2B" TextWrapping="NoWrap" Text="{Binding Window6AppName, Mode=TwoWay}" Tag="{Binding ElementName=Window6TextBlock}"/>
                                        </Border>
                                        <UXControls:UXButton  x:Name="AddButton6" Style="{StaticResource DynamicButtonStyle}" Tag="{Binding Text, ElementName=Window6TextBlock}" Margin="8,16,0,0" Click="AddButton1_Click"/>
                                    </DockPanel>
                                </Grid>


                                <!--Windows 7 Row4-->

                                <Grid  x:Name="WindowGrid_7" Grid.Column="0" Grid.Row="4" Visibility="{Binding SelectedValue, Converter={StaticResource WindowGridVisibilityConverter}, ConverterParameter=7}">
                                    <DockPanel>
                                        <UXControls:UXTextBlock x:Name="Window7Label" Text="{Binding [EazyMemory.27], Source={x:Static lang:LangHelper.Instance}, Mode=OneWay}" Width="76" Height="24" Margin="0,16,8,0" VerticalAlignment="Center" Foreground="White" FontSize="14" />
                                        <Border BorderThickness="1.5" CornerRadius="3" BorderBrush="White" Margin="0,16,0,0" Background="#141D2B">
                                            <UXControls:UXTextBox x:Name="Window7TextBlock" Width="150" Height="40" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White" Background="#141D2B" TextWrapping="NoWrap" Text="{Binding Window7AppName, Mode=TwoWay}" Tag="{Binding ElementName=Window7TextBlock}"/>
                                        </Border>
                                        <UXControls:UXButton  x:Name="AddButton7" Style="{StaticResource DynamicButtonStyle}" Tag="{Binding Text, ElementName=Window7TextBlock}" Margin="16,16,16,0" Click="AddButton1_Click"/>
                                    </DockPanel>
