<UserControl x:Class="DDPM.UI.Module.EzMemory.EzMemoryAssignProgram"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DDPM.UI.Module.EzMemory"
             xmlns:lang="clr-namespace:DDPM.UI.Resources.Helper;assembly=DDPM.UI.Resources"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF" 
             xmlns:commonCtrl="clr-namespace:DDPM.UI.Common.UserControls;assembly=DDPM.UI.Common" 
             xmlns:viewmodels="clr-namespace:DDPM.UI.Common.ViewModels;assembly=DDPM.UI.Common"
             d:DataContext="{d:DesignInstance Type=viewmodels:EzMemoryViewModel}"
             mc:Ignorable="d" 
             Background="#FF0D121A"
             d:DesignHeight="671" 
             d:DesignWidth="1378">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DDPM.UI.Common;component/ModuleStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <Style x:Key="UXTextBlock_Caption" TargetType="UXControls:UXTextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Margin" Value="0,0,8,0" />
            </Style>

            <Style x:Key="TransparentButtonStyle" TargetType="UXControls:UXButton">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="UXControls:UXButton">
                            <Grid>
                                <Image Source="pack://application:,,,/DDPM.UI.Common;component/Resources/EzAdd.png" Width="30" Height="30"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <!-- 透明遮罩 -->
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="Transparent"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <local:WindowGridVisibilityConverter x:Key="WindowGridVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Image x:Name="imgBkGlow"
               Source="pack://application:,,,/DDPM.UI.Common;component/Resources/Background_Glow.png"
               Stretch="UniformToFill"
               HorizontalAlignment="Center" 
               VerticalAlignment="Center" />

        <StackPanel>
            <Grid Margin="0" Visibility="{Binding PeripheralVisibility}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="552" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid x:Name="LeftGrid" Grid.Column="0" Margin="76, 60, 0, 0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="120" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Progress Bar -->
                    <Grid Grid.Row="0">
                        <ProgressBar x:Name="EzMemoryProgressbar" Background="#293B4D" BorderBrush="Transparent" BorderThickness="0" HorizontalAlignment="Left" Height="5" Width="281" Minimum="0" Maximum="3" Value="2">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar">
                                    <Setter Property="Foreground" Value="#A4B8CD" />
                                </Style>
                            </ProgressBar.Style>

                            <ProgressBar.Triggers>
                                <EventTrigger RoutedEvent="ProgressBar.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Value" From="1" To="{Binding ProgressValue}" Duration="0:0:1" FillBehavior="HoldEnd" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </ProgressBar.Triggers>
                        </ProgressBar>
                    </Grid>

                    <!-- Feature Highlight Title -->
                    <Grid Grid.Row="1" Margin="0, 50, 0, 0" Width="auto" Height="28" HorizontalAlignment="Left">
                        <UXControls:UXTextBlock x:Name="TitleText" Text="EASY MEMORY SETUP" Foreground="#DAF5FD" FontSize="20" LineHeight="28" />
                    </Grid>

                    <!-- Customizable Keys Title -->
                    <Grid Grid.Row="2" Margin="0, 8, 0, 0" Width="476" HorizontalAlignment="Left">
                        <UXControls:UXTextBlock x:Name="MainText" Text="" Foreground="#F5F6F7" FontSize="60" TextWrapping="Wrap"/>
                    </Grid>

                    <!-- Description Text -->
                    <Grid Grid.Row="3" Margin="0, 16, 0, 0" Width="476" HorizontalAlignment="Left">
                        <UXControls:UXTextBlock x:Name="SubText" Text="" Foreground="#F5F6F7" FontSize="15" TextWrapping="Wrap" />
                    </Grid>

                    <!-- Buttons -->
                    <Grid Grid.Row="4" Margin="0, 0, 0, 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- First Button Group -->
                        <Grid Grid.Column="0" Margin="0,170,0,0">
                            <StackPanel Orientation="Horizontal">
                                <UXControls:UXButton x:Name="ArrowButton" Visibility="{Binding ArrowButtonVisibility}" Width="48" Height="40" ButtonType="Secondary" ButtonSize="Medium" IconAnimation="Move" Margin="0" Padding="16,8" Foreground="#F5F6F7" BorderBrush="#F5F6F7" Click="ArrowButton_Click">
                                    <Path Data="M3.62037 11.6746L3.34146 12L3.62037 12.3254L9.62037 19.3254L10.3796 18.6746L5.08711 12.5L21 12.5L21 11.5L5.08711 11.5L10.3796 5.32538L9.62037 4.67459L3.62037 11.6746Z" Fill="#F5F6F7" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </UXControls:UXButton>

                                <!-- Next Button -->
                                <UXControls:UXButton x:Name="NextBtn" IconPosition="IconRight" HorizontalContentAlignment="Center" ButtonType="Primary" Padding="40, 8" ButtonSize="Medium" VerticalContentAlignment="Center" Margin="10, 0, 0, 0" IconAnimation="Move" Width="164" Height="40" Click="NextBtn_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <UXControls:UXTextBlock Margin="8,0" Text="{Binding [Kvm.1], Source={x:Static lang:LangHelper.Instance}}" Foreground="White"/>
                                        <Path x:Name="ArrowPath" Margin="0,2" Data="M17.3796 8.3256L17.6585 8.0002L17.3796 7.67481L11.3796 0.674805L10.6204 1.3256L15.9129 7.5002H0V8.5002H15.9129L10.6204 14.6748L11.3796 15.3256L17.3796 8.3256Z" Fill="white">
                                            <Path.RenderTransform>
                                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                            </Path.RenderTransform>
                                        </Path>
                                    </StackPanel>
                                    <UXControls:UXButton.Triggers>
                                        <EventTrigger RoutedEvent="MouseEnter">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="ArrowPath" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" From="1" To="1.2" Duration="0:0:1" AutoReverse="True" RepeatBehavior="Forever" />
                                                    <DoubleAnimation Storyboard.TargetName="ArrowPath" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" From="1" To="1.2" Duration="0:0:1" AutoReverse="True" RepeatBehavior="Forever" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="MouseLeave">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="ArrowPath" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2" />
                                                    <DoubleAnimation Storyboard.TargetName="ArrowPath" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </UXControls:UXButton.Triggers>
                                </UXControls:UXButton>
                            </StackPanel>
                        </Grid>

                        <!-- Second Button Group -->
                        <Grid Grid.Column="1" Margin="0,170,0,0">
                            <UXControls:UXButton x:Name="CancelBtn" Visibility="{Binding SkipButtonVisibility}" ButtonType="Tertiary" Width="90" Height="40" ButtonSize="Medium" Margin="10, 0" Content="Cancel" IconAnimation="Move" Click="CancelBtn_Click"/>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- Only 2 -->
                <!--<Grid x:Name="RightGridPage2" Visibility="Hidden" Grid.Column="1" Width="657" Margin="64, 96, 96, 0">-->
                <Grid x:Name="RightGridPage2" Visibility="{Binding IsRightGridPage2Visible, Converter={StaticResource BooleanToVisibilityConverter}}" Grid.Column="1" Width="657" Margin="64, 96, 96, 0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Monitor Outline Image -->
                    <Image Grid.Row="0" Source="pack://application:,,,/DDPM.UI.Common;component/Resources/Monitor_Outline.png" HorizontalAlignment="Center" VerticalAlignment="Center" Width="361.86" Height="280" />

                    <!-- Bottom Control Panel -->
                    <Border Grid.Row="1" Background="#1B385F" CornerRadius="10" Margin="0,16,0,0" Padding="16" Width="415" Height="auto" HorizontalAlignment="Center">
                        <StackPanel>
                            <!-- Window 1 Control -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <UXControls:UXTextBlock Text="Window2_1" VerticalAlignment="Center" Foreground="White" FontSize="14" Grid.Column="0" />
                                <Border BorderThickness="1.5" CornerRadius="3" BorderBrush="White" Margin="80,0,0,0">
                                    <UXControls:UXTextBlock Grid.Column="1" Width="250" Height="40" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White" Background="#141D2B" Text="{Binding Window2_1AppName}" Tag="{Binding ElementName=Window2_1TextBlock}"/>
                                </Border>
                                <UXControls:UXButton Grid.Column="2" x:Name="AddButton2_1" Margin="16,0,0,0" Style="{StaticResource TransparentButtonStyle}" Click="AddButton1_Click"/>
                            </Grid>

                            <!-- Window 2 Control -->
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <UXControls:UXTextBlock Text="Window2_2" VerticalAlignment="Center" Foreground="White" FontSize="14" Grid.Column="0" />
                                <Border BorderThickness="1.5" CornerRadius="3" BorderBrush="White" Margin="80,0,0,0">
                                    <UXControls:UXTextBlock Grid.Column="1" Width="250" Height="40" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White" Background="#141D2B" TextAlignment="Left"  Text="{Binding Window2_2AppName}" Tag="{Binding ElementName=Window2_2TextBlock}"/>
                                </Border>
                                <UXControls:UXButton Grid.Column="2" x:Name="AddButton2_2" Margin="16,0,0,0" Style="{StaticResource TransparentButtonStyle}" Click="AddButton1_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>


                <!-- Total -->
                <!--<Grid x:Name="RightGridPageTotal" Visibility="Hidden" Grid.Column="1" Width="657" Margin="64, 72, 96, 0">-->
                <Grid x:Name="RightGridPageTotal" Visibility="{Binding IsRightGridPageTotalVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Grid.Column="1" Width="657" Margin="64, 72, 96, 0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Monitor Outline Image -->
                    <Image Grid.Row="0" Source="pack://application:,,,/DDPM.UI.Common;component/Resources/Monitor_Outline.png" HorizontalAlignment="Center" VerticalAlignment="Center" Width="361.86" Height="280" />

                    <!-- Bottom Control Panel -->
                    <Border x:Name="RightBorderManyPage" Grid.Row="1" Background="#1B385F" CornerRadius="10" Margin="0,-48,0,0" Padding="16" Width="630" Height="Auto" HorizontalAlignment="Center" Opacity="0.8">
                        <StackPanel >
                            <!-- Window 1 Control -->
                            <Grid Margin="0,-8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                
                                <!--Windows 1 Row1-->
                                <Grid x:Name="WindowGrid_1" Grid.Column="0" Visibility="{Binding SelectedValue, Converter={StaticResource WindowGridVisibilityConverter}, ConverterParameter=1}">
                                    <DockPanel x:Name="DockPanel1">
                                        <UXControls:UXTextBlock x:Name="Window1Label" Text="Window 1" Width="76" Height="24" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="White" FontSize="14"/>
                                        <Border BorderThickness="1.5" CornerRadius="3" BorderBrush="White" >
                                            <UXControls:UXTextBlock x:Name="Window1TextBlock" Width="150" Height="40" Margin="0,0,0,0" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White" Background="#141D2B" Text="{Binding Window1AppName}" Tag="{Binding ElementName=Window1TextBlock}"/>
                                        </Border>
                                        <UXControls:UXButton x:Name="AddButton1" Style="{StaticResource TransparentButtonStyle}" Margin="16,0,16,0" Click="AddButton1_Click" />
                                    </DockPanel>
                                </Grid>
                                
                                <!--Windows 2-->
                                <Grid x:Name="WindowGrid_2" Grid.Column="1" Visibility="{Binding SelectedValue, Converter={StaticResource WindowGridVisibilityConverter}, ConverterParameter=2}">
                                    <DockPanel Visibility="Visible">
                                        <UXControls:UXTextBlock Grid.Column="3" x:Name="Window2Label" Text="Window 2" Width="76" Height="24" Margin="16,0,8,0" VerticalAlignment="Center" Foreground="White" FontSize="14" />
                                        <Border BorderThickness="1.5" CornerRadius="3" BorderBrush="White" >
                                            <UXControls:UXTextBlock x:Name="Window2TextBlock" Width="150" Height="40" Margin="0,0,0,0" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White" Background="#141D2B" Text="{Binding Window2AppName}" Tag="{Binding ElementName=Window2TextBlock}"/>
                                        </Border>
                                        <UXControls:UXButton Grid.Column="5" x:Name="AddButton2" Style="{StaticResource TransparentButtonStyle}" Margin="16,0,0,0" Click="AddButton1_Click"/>
                                    </DockPanel>
                                </Grid>

                                <!--Windows 3 Row2-->
                                <Grid x:Name="WindowGrid_3" Grid.Column="0" Grid.Row="2" Visibility="{Binding SelectedValue, Converter={StaticResource WindowGridVisibilityConverter}, ConverterParameter=3}">
                                    <DockPanel Visibility="Visible">
                                        <UXControls:UXTextBlock x:Name="Window3Label" Text="Window 3" Width="76" Height="24" Margin="0,16,8,0" VerticalAlignment="Center" Foreground="White" FontSize="14" />
                                        <Border BorderThickness="1.5" CornerRadius="3" BorderBrush="White" Margin="0,16,8,0">
                                            <UXControls:UXTextBlock x:Name="Window3TextBlock" Width="150" Height="40" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White" Background="#141D2B" Text="{Binding Window3AppName}" Tag="{Binding ElementName=Window3TextBlock}"/>
                                        </Border>
                                        <UXControls:UXButton  x:Name="AddButton3" Style="{StaticResource TransparentButtonStyle}" Margin="8,16,16,0" Click="AddButton1_Click"/>
                                    </DockPanel>
                                </Grid>
                                        
                                <!--Windows 4-->
                                <Grid x:Name="WindowGrid_4" Grid.Column="1" Grid.Row="2" Visibility="{Binding SelectedValue, Converter={StaticResource WindowGridVisibilityConverter}, ConverterParameter=4}">
                                    <DockPanel>
                                        <UXControls:UXTextBlock x:Name="Window4Label" Text="Window 4" Width="76" Height="24" Margin="16,16,0,0" VerticalAlignment="Center" Foreground="White" FontSize="14" />
                                        <Border BorderThickness="1.5" CornerRadius="3" BorderBrush="White" Margin="8,16,0,0" >
                                            <UXControls:UXTextBlock x:Name="Window4TextBlock" Width="150" Height="40" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White" Background="#141D2B" Text="{Binding Window4AppName}" Tag="{Binding ElementName=Window4TextBlock}"/>
                                        </Border>
                                        <UXControls:UXButton x:Name="AddButton4" Style="{StaticResource TransparentButtonStyle}" Margin="16,16,0,0"  Click="AddButton1_Click"/>
                                    </DockPanel>
                                </Grid>
                                
                                <!--Windows 5 Row3-->
                                <Grid x:Name="WindowGrid_5" Grid.Column="0" Grid.Row="3" Visibility="{Binding SelectedValue, Converter={StaticResource WindowGridVisibilityConverter}, ConverterParameter=5}">
                                    <DockPanel >
                                        <UXControls:UXTextBlock x:Name="Window5Label" Text="Window 5" Width="76" Height="24" Margin="0,16,8,0" VerticalAlignment="Center" Foreground="White" FontSize="14" />
                                        <Border BorderThickness="1.5" CornerRadius="3" BorderBrush="White" Margin="0,16,0,0">
                                            <UXControls:UXTextBlock x:Name="Window5TextBlock" Width="150" Height="40" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White" Background="#141D2B" Text="{Binding Window5AppName}" Tag="{Binding ElementName=Window5TextBlock}"/>
                                        </Border>
                                        <UXControls:UXButton x:Name="AddButton5" Style="{StaticResource TransparentButtonStyle}" Margin="16,16,16,0" Click="AddButton1_Click"/>
                                    </DockPanel>
                                </Grid>

                                <!--Windows 6-->
                                <Grid x:Name="WindowGrid_6" Grid.Column="1" Grid.Row="3" Visibility="{Binding SelectedValue, Converter={StaticResource WindowGridVisibilityConverter}, ConverterParameter=6}">
                                    <DockPanel >
                                        <UXControls:UXTextBlock x:Name="Window6Label" Text="Window 6" Width="76" Height="24" Margin="16,16,0,0" VerticalAlignment="Center" Foreground="White" FontSize="14" />
                                        <Border BorderThickness="1.5" CornerRadius="3" BorderBrush="White" Margin="8,16,8,0">
                                            <UXControls:UXTextBlock x:Name="Window6TextBlock" Width="150" Height="40" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White" Background="#141D2B" Text="{Binding Window6AppName}" Tag="{Binding ElementName=Window6TextBlock}"/>
                                        </Border>
                                        <UXControls:UXButton  x:Name="AddButton6" Style="{StaticResource TransparentButtonStyle}" Margin="8,16,0,0" Click="AddButton1_Click"/>
                                    </DockPanel>
                                </Grid>
                                
                                <!--Windows 7 Row4-->
                                <Grid  x:Name="WindowGrid_7" Grid.Column="0" Grid.Row="4" Visibility="{Binding SelectedValue, Converter={StaticResource WindowGridVisibilityConverter}, ConverterParameter=7}">
                                    <DockPanel>
                                        <UXControls:UXTextBlock x:Name="Window7Label" Text="Window 7" Width="76" Height="24" Margin="0,16,8,0" VerticalAlignment="Center" Foreground="White" FontSize="14" />
                                        <Border BorderThickness="1.5" CornerRadius="3" BorderBrush="White" Margin="0,16,0,0">
                                            <UXControls:UXTextBlock x:Name="Window7TextBlock" Width="150" Height="40" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White" Background="#141D2B" Text="{Binding Window7AppName}" Tag="{Binding ElementName=Window7TextBlock}"/>
                                        </Border>
                                        <UXControls:UXButton  x:Name="AddButton7" Style="{StaticResource TransparentButtonStyle}" Margin="16,16,16,0" Click="AddButton1_Click"/>
                                    </DockPanel>
                                </Grid>

                                <!--Windows 8-->
                                <Grid x:Name="WindowGrid_8" Grid.Column="1" Grid.Row="4" Visibility="{Binding SelectedValue, Converter={StaticResource WindowGridVisibilityConverter}, ConverterParameter=8}">
                                    <DockPanel>
                                        <UXControls:UXTextBlock x:Name="Window8Label" Text="Window 8" Width="76" Height="24" Margin="16,16,0,0" VerticalAlignment="Center" Foreground="White" FontSize="14" />
                                        <Border BorderThickness="1.5" CornerRadius="3" BorderBrush="White" Margin="8,16,8,0">
                                            <UXControls:UXTextBlock x:Name="Window8TextBlock" Width="150" Height="40" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White" Background="#141D2B" Text="{Binding Window8AppName}" Tag="{Binding ElementName=Window8TextBlock}"/>
                                        </Border>
                                        <UXControls:UXButton x:Name="AddButton8" Style="{StaticResource TransparentButtonStyle}" Margin="8,16,0,0" Click="AddButton1_Click"/>
                                    </DockPanel>
                                </Grid>

                                <!--Windows 9 Row5-->
                                <Grid x:Name="WindowGrid_9" Grid.Column="0" Grid.Row="5" Visibility="{Binding SelectedValue, Converter={StaticResource WindowGridVisibilityConverter}, ConverterParameter=9}">
                                    <DockPanel>
                                        <UXControls:UXTextBlock x:Name="Window9Label" Text="Window 9" Width="76" Height="24" Margin="0,16,8,0" VerticalAlignment="Center" Foreground="White" FontSize="14" />
                                        <Border BorderThickness="1.5" CornerRadius="3" BorderBrush="White" Margin="0,16,0,0">
                                            <UXControls:UXTextBlock x:Name="Window9TextBlock" Width="150" Height="40" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White" Background="#141D2B" Text="{Binding Window9AppName}" Tag="{Binding ElementName=Window9TextBlock}"/>
                                        </Border>
                                        <UXControls:UXButton  x:Name="AddButton9" Style="{StaticResource TransparentButtonStyle}" Margin="16,16,16,0" Click="AddButton1_Click"/>
                                    </DockPanel>
                                </Grid>

                                <!--Windows 10-->
                                <Grid x:Name="WindowGrid_10" Grid.Column="1" Grid.Row="5" Visibility="{Binding SelectedValue, Converter={StaticResource WindowGridVisibilityConverter}, ConverterParameter=10}">
                                    <DockPanel>
                                        <UXControls:UXTextBlock x:Name="Window10Label" Text="Window 10" Width="76" Height="24" Margin="16,16,0,0" VerticalAlignment="Center" Foreground="White" FontSize="14" />
                                        <Border BorderThickness="1.5" CornerRadius="3" BorderBrush="White" Margin="8,16,8,0">
                                            <UXControls:UXTextBlock x:Name="Window10TextBlock" Width="150" Height="40" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White" Background="#141D2B" Text="{Binding Window10AppName}" Tag="{Binding ElementName=Window10TextBlock}"/>
                                        </Border>
                                        <UXControls:UXButton x:Name="AddButton10" Style="{StaticResource TransparentButtonStyle}" Margin="8,16,0,0" Click="AddButton1_Click"/>
                                 </DockPanel>
                                </Grid>

                                <!--Windows 11 Row6-->
                                <Grid x:Name="WindowGrid_11" Grid.Column="0" Grid.Row="6" Visibility="{Binding SelectedValue, Converter={StaticResource WindowGridVisibilityConverter}, ConverterParameter=11}">
                                    <DockPanel>
                                        <UXControls:UXTextBlock x:Name="Window11Label" Text="Window 11" Width="76" Height="24" Margin="0,16,8,0" VerticalAlignment="Center" Foreground="White" FontSize="14" />
                                        <Border BorderThickness="1.5" CornerRadius="3" BorderBrush="White" Margin="0,16,0,0">
                                            <UXControls:UXTextBlock x:Name="Window11TextBlock" Width="150" Height="40" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White" Background="#141D2B" Text="{Binding Window11AppName}" Tag="{Binding ElementName=Window11TextBlock}"/>
                                        </Border>
                                        <UXControls:UXButton x:Name="AddButton11" Style="{StaticResource TransparentButtonStyle}" Margin="16,16,16,0" Click="AddButton1_Click"/>
                                    </DockPanel>
                                </Grid>
                                        <!--Windows 12-->
                                <Grid x:Name="WindowGrid_12" Grid.Column="1" Grid.Row="6" Visibility="{Binding SelectedValue, Converter={StaticResource WindowGridVisibilityConverter}, ConverterParameter=12}">
                                    <DockPanel >
                                        <UXControls:UXTextBlock x:Name="Window12Label" Text="Window 12" Width="76" Height="24" Margin="16,16,0,0" VerticalAlignment="Center" Foreground="White" FontSize="14" />
                                        <Border BorderThickness="1.5" CornerRadius="3" BorderBrush="White" Margin="8,16,8,0">
                                            <UXControls:UXTextBlock x:Name="Window12TextBlock" Width="150" Height="40" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White" Background="#141D2B" Text="{Binding Window12AppName}" Tag="{Binding ElementName=Window12TextBlock}"/>
                                        </Border>
                                        <UXControls:UXButton x:Name="AddButton12" Style="{StaticResource TransparentButtonStyle}" Margin="8,16,0,0" Click="AddButton1_Click"/>
                                    </DockPanel>
                                </Grid>
                                
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>

