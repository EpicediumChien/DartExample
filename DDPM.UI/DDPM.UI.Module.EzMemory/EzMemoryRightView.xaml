<UserControl x:Class="DDPM.UI.Module.EzMemory.EzMemoryRightView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             xmlns:local="clr-namespace:DDPM.UI.Module.EzMemory"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel>
        <Button Width="200" Height="160" Content="EzMemoryRightView" />
        <CheckBox Name="ck" Content="AddDeviceIcon" IsChecked="True" Click="CheckBox_Click_1" Foreground="White"/>
        <CheckBox Name="ckSettings" Content="SettingsIcon" IsChecked="True" Click="ckSettings_Click" Foreground="White"/>
    </StackPanel>
</UserControl>