<UserControl x:Class="DDPM.UI.Module.EzMemory.EzMemoryLaunchOption"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DDPM.UI.Module.EzMemory"
             xmlns:lang="clr-namespace:DDPM.UI.Resources.Helper;assembly=DDPM.UI.Resources"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF" 
             xmlns:commonCtrl="clr-namespace:DDPM.UI.Common.UserControls;assembly=DDPM.UI.Common" 
             xmlns:viewmodels="clr-namespace:DDPM.UI.Common.ViewModels;assembly=DDPM.UI.Common"
             d:DataContext="{d:DesignInstance Type=viewmodels:EzArrangeViewModel}"
             mc:Ignorable="d" 
             Background="#FF0D121A"
             d:DesignHeight="671" 
             d:DesignWidth="1378">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DDPM.UI.Common;component/ModuleStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <Style x:Key="UXTextBlock_Caption" TargetType="UXControls:UXTextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Margin" Value="0,0,8,0" />
            </Style>

            <Style x:Key="DdpmComboBoxStyleEzMemory" TargetType="ComboBox">
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
                <Setter Property="MinWidth" Value="81" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Background" Value="{StaticResource DdpmCB_BkColor}" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template" Value="{StaticResource DdpmComboBoxControlTemplate}" />
                <Setter Property="ItemContainerStyle" Value="{StaticResource DdpmComboBoxItemContainerStyle}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Image x:Name="imgBkGlow"
               Source="pack://application:,,,/DDPM.UI.Common;component/Resources/Background_Glow.png"
               Stretch="UniformToFill"
               HorizontalAlignment="Center" 
               VerticalAlignment="Center" />

        <StackPanel>
            <Grid Margin="0" Visibility="{Binding PeripheralVisibility}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="552" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid x:Name="LeftGrid" Grid.Column="0" Margin="76, 60, 0, 0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="120" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Progress Bar -->
                    <Grid Grid.Row="0">
                        <ProgressBar x:Name="EzMemoryProgressbar" Background="#293B4D" BorderBrush="Transparent" BorderThickness="0" HorizontalAlignment="Left" Height="5" Width="281" Minimum="0" Maximum="3" Value="3">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar">
                                    <Setter Property="Foreground" Value="#A4B8CD" />
                                </Style>
                            </ProgressBar.Style>

                            <ProgressBar.Triggers>
                                <EventTrigger RoutedEvent="ProgressBar.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Value" From="2" To="{Binding ProgressValue}" Duration="0:0:1" FillBehavior="HoldEnd" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </ProgressBar.Triggers>
                        </ProgressBar>
                    </Grid>

                    <!-- Feature Highlight Title -->
                    <Grid Grid.Row="1" Margin="0, 50, 0, 0" Width="auto" Height="28" HorizontalAlignment="Left">
                        <UXControls:UXTextBlock x:Name="TitleText" Text="EASY MEMORY SETUP" Foreground="#DAF5FD" FontSize="20" LineHeight="28" />
                    </Grid>

                    <!-- Customizable Keys Title -->
                    <Grid Grid.Row="2" Margin="0, 8, 0, 0" Width="476" HorizontalAlignment="Left">
                        <UXControls:UXTextBlock x:Name="MainText" Text="" Foreground="#F5F6F7" FontSize="60" TextWrapping="Wrap"/>
                    </Grid>

                    <!-- Description Text -->
                    <Grid Grid.Row="3" Margin="0, 16, 0, 0" Width="476" HorizontalAlignment="Left">
                        <UXControls:UXTextBlock x:Name="SubText" Text="" Foreground="#F5F6F7" FontSize="15" TextWrapping="Wrap" />
                    </Grid>

                    <!-- Buttons -->
                    <Grid Grid.Row="4" Margin="0, 0, 0, 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- First Button Group -->
                        <Grid Grid.Column="0" Margin="0,170,0,0">
                            <StackPanel Orientation="Horizontal">
                                <UXControls:UXButton x:Name="ArrowButton" Visibility="{Binding ArrowButtonVisibility}" Width="48" Height="40" ButtonType="Secondary" ButtonSize="Medium" IconAnimation="Move" Margin="0" Padding="16,8" Foreground="#F5F6F7" BorderBrush="#F5F6F7" Click="ArrowButton_Click">
                                    <Path Data="M3.62037 11.6746L3.34146 12L3.62037 12.3254L9.62037 19.3254L10.3796 18.6746L5.08711 12.5L21 12.5L21 11.5L5.08711 11.5L10.3796 5.32538L9.62037 4.67459L3.62037 11.6746Z" Fill="#F5F6F7" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </UXControls:UXButton>

                                <!-- Next Button -->
                                <UXControls:UXButton x:Name="FinishBtn" IconPosition="IconRight" HorizontalContentAlignment="Center" ButtonType="Primary" Padding="40, 8" ButtonSize="Medium" VerticalContentAlignment="Center" Margin="10, 0, 0, 0" IconAnimation="Move" Width="164" Height="40" Click="FinishBtn_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <UXControls:UXTextBlock Margin="8,0" Text="{Binding [EazyMemory.16], Source={x:Static lang:LangHelper.Instance}, Mode=OneWay}" Foreground="White"/>
                                        <Path x:Name="ArrowPath" Margin="0,2" Data="M17.3796 8.3256L17.6585 8.0002L17.3796 7.67481L11.3796 0.674805L10.6204 1.3256L15.9129 7.5002H0V8.5002H15.9129L10.6204 14.6748L11.3796 15.3256L17.3796 8.3256Z" Fill="white">
                                            <Path.RenderTransform>
                                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                            </Path.RenderTransform>
                                        </Path>
                                    </StackPanel>
                                    <UXControls:UXButton.Triggers>
                                        <EventTrigger RoutedEvent="MouseEnter">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="ArrowPath" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" From="1" To="1.2" Duration="0:0:1" AutoReverse="True" RepeatBehavior="Forever" />
                                                    <DoubleAnimation Storyboard.TargetName="ArrowPath" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" From="1" To="1.2" Duration="0:0:1" AutoReverse="True" RepeatBehavior="Forever" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="MouseLeave">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="ArrowPath" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2" />
                                                    <DoubleAnimation Storyboard.TargetName="ArrowPath" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </UXControls:UXButton.Triggers>
                                </UXControls:UXButton>
                            </StackPanel>
                        </Grid>

                        <!-- Second Button Group -->
                        <Grid Grid.Column="1" Margin="0,170,0,0">
                            <UXControls:UXButton x:Name="CancelBtn" Visibility="{Binding SkipButtonVisibility}" ButtonType="Tertiary" Width="90" Height="40" ButtonSize="Medium" Margin="10, 0" Content="{Binding [EazyMemory.17], Source={x:Static lang:LangHelper.Instance}, Mode=OneWay}" IconAnimation="Move" Click="CancelBtn_Click"/>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- Keyboard Image and Settings -->
                <Grid x:Name="RightGridPage2" Visibility="{Binding RightGridPage2Visibility}" Grid.Column="1"  Margin="64, 96, 96, 0">
                    <!-- Launch Option Selection Panel with CSS-based adjustments -->
                    <Border Background="#132F54" BorderBrush="#1E3F6C" BorderThickness="1" CornerRadius="6" Margin="200,90,0,0" Padding="16,16,16,32" Width="353" Height="auto" HorizontalAlignment="Center" VerticalAlignment="Top">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0">
                            <!-- Title -->
                                <UXControls:UXTextBlock x:Name="TitleTB" Grid.Row="0" Text="{Binding [EazyMemory.12], Source={x:Static lang:LangHelper.Instance}, Mode=OneWay}" FontSize="16" Foreground="White" Margin="0,0,0,8" />

                            <!-- Radio Buttons for Manual or Automatic Launch -->
                                <StackPanel Orientation="Vertical" Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Width="305" Height="28">
                                        <UXControls:UXRadioButton x:Name="ManulRB" Grid.Row="1" Content="{Binding [EazyMemory.14], Source={x:Static lang:LangHelper.Instance}, Mode=OneWay}" FontSize="16" Height="36" Foreground="White" Margin="8,2,0,2" IsChecked="{Binding IsManualLaunch}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Width="305" Height="28">
                                        <UXControls:UXRadioButton x:Name="AutoRB" Grid.Row="2" Content="{Binding [EazyMemory.15], Source={x:Static lang:LangHelper.Instance}, Mode=OneWay}" FontSize="16" Height="36" Foreground="White" Margin="8,2,0,2" IsChecked="{Binding IsAutoLaunch}" />
                                </StackPanel>

                                <!-- Time Picker Controls (Disabled when manually select is checked) -->
                                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="46,8,0,0" >
                                        <UXControls:UXComboBox x:Name="HourCB" FontSize="14" Background="#293B4D" Width="81" Height="40" Style="{StaticResource DdpmComboBoxStyleEzMemory}" BorderThickness="0.3" Margin="0,0,4,0" ItemsSource="{Binding HourList}"  SelectedItem="{Binding SelectedHour}"/>

                                        <!-- 添加時間選項 -->
                                        <UXControls:UXComboBox x:Name="MinuteCB" FontSize="14" Background="#293B4D" Width="81" Height="40" Style="{StaticResource DdpmComboBoxStyleEzMemory}" BorderThickness="0.3" Margin="4,0,4,0" VerticalAlignment="Top" HorizontalContentAlignment="Center" ItemsSource="{Binding MinuteList}" SelectedItem="{Binding SelectedMinute}"/>

                                        <UXControls:UXComboBox x:Name="AMPMCB" Background="#293B4D" Width="81" Height="40" FontSize="14" Style="{StaticResource DdpmComboBoxStyleEzMemory}" BorderThickness="0.3" Margin="4,0,4,0" ItemsSource="{Binding AMPMList}" SelectedItem="{Binding SelectedAMPM}" />

                                    </StackPanel>
                            </StackPanel>

                            <!-- Launch during PC startup Checkbox -->
                                <StackPanel Grid.Row="4" Orientation="Horizontal">
                                    <UXControls:UXCheckBox x:Name="StartupCB" Content="{Binding [EazyMemory.13], Source={x:Static lang:LangHelper.Instance}, Mode=OneWay}" FontSize="18" Foreground="White" Margin="0,16,0,0" IsChecked="{Binding IsLaunchAtStartup}" Checked="StartupCB_Checked"/>
                                </StackPanel>
                            </StackPanel>
                            </Grid>
                    </Border>

                </Grid>


            </Grid>
        </StackPanel>
    </Grid>
</UserControl>


