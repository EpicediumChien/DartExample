<UserControl x:Class="DDPM.UI.Module.EzMemory.EzMemoryLaunchOption"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DDPM.UI.Module.EzMemory"
             xmlns:lang="clr-namespace:DDPM.UI.Resources.Helper;assembly=DDPM.UI.Resources"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF" 
             xmlns:commonCtrl="clr-namespace:DDPM.UI.Common.UserControls;assembly=DDPM.UI.Common" 
             xmlns:viewmodels="clr-namespace:DDPM.UI.Common.ViewModels;assembly=DDPM.UI.Common"
             xmlns:common="clr-namespace:DDPM.UI.Common;assembly=DDPM.UI.Common"
             d:DataContext="{d:DesignInstance Type=viewmodels:EzArrangeViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="671" 
             d:DesignWidth="1378">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- <ResourceDictionary Source="/DDPM.UI.Common;component/ModuleStyle.xaml" /> -->
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <Style x:Key="UXTextBlock_Caption" TargetType="UXControls:UXTextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Margin" Value="0,0,8,0" />
            </Style>

            <Style x:Key="DdpmComboBoxStyleEzMemory" TargetType="ComboBox">
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
                <Setter Property="MinWidth" Value="81" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Height" Value="40" />

                <Setter Property="Background" Value="{DynamicResource DdpmCB_BkColor}" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template" Value="{DynamicResource DdpmComboBoxControlTemplate}" />
                <Setter Property="ItemContainerStyle" Value="{DynamicResource DdpmComboBoxItemContainerStyle}" />

                <!-- Robert_Lin 2025-1-10 These ComboBoxes will be enabled only when Automatically radio button is checked -->
                <Setter Property="IsEnabled" Value="{Binding IsAutoLaunch}"/>
            </Style>

            
            <!-- Robert_Lin, 2025-1-14 Move to ModuleStyle.xaml -->
            <!-- Convert Text to MaxHeight, ConverterParameter='16,3' means FontSize=16, MaxLines=3
                 The Converter will calcuate the height of the FontSize (FontFamily="Roboto").
                 And return MaxHeigh of MaxLines (that is, MaxHeight = Text Height * (MaxLines+0.5))
            -->
            <common:MaxHeightConverter x:Key="MaxHeightConverter" />
            
            <!-- Robert_Lin 2025-1-14 Max3LinesRadioButtonStyle, FontFamily=Roboto, FontSize=16, MaxLines=3
                 Radio button requiremens: Adjust the box to fit the text for the radio button. It should not exceed 3 lines. If it does, shorten with “...”
                 The clickable Circle will be at top line.
            -->
            <Style x:Key="Max3LinesRadioButtonStyle" TargetType="UXControls:UXRadioButton" BasedOn="{StaticResource {x:Type UXControls:UXRadioButton}}">
                <Setter Property="VerticalAlignment" Value="Top"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="MaxHeight"
                        Value="{Binding Content, RelativeSource={RelativeSource Self}, Converter={StaticResource MaxHeightConverter}, ConverterParameter='16,3'}">
                </Setter>
                <Style.Resources>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="TextWrapping" Value="Wrap"/>
                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        <Setter Property="FontFamily" Value="Roboto"/>
                        <Setter Property="FontSize" Value="16"/>
                    </Style>
                </Style.Resources>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Image x:Name="imgBkGlow" Visibility="Collapsed"
               Source="pack://application:,,,/DDPM.UI.Common;component/Resources/Background_Glow.png"
               Stretch="UniformToFill"
               HorizontalAlignment="Center" 
               VerticalAlignment="Center" />

        <StackPanel x:Name="MainPanel" VerticalAlignment="Top" HorizontalAlignment="Center">
            <Grid Margin="0" Visibility="{Binding PeripheralVisibility}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="552" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid x:Name="LeftGrid" Grid.Column="0" Margin="76, 60, 0, 0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="120" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Progress Bar -->
                    <Grid Grid.Row="0">
                        <ProgressBar x:Name="EzMemoryProgressbar" Background="{DynamicResource ProgressBar_BkColor}" BorderBrush="Transparent" BorderThickness="0" HorizontalAlignment="Left" Height="5" Width="281" Minimum="0" Maximum="3" Value="3">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar">
                                    <Setter Property="Foreground" Value="#A4B8CD" />
                                </Style>
                            </ProgressBar.Style>

                            <ProgressBar.Triggers>
                                <EventTrigger RoutedEvent="ProgressBar.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Value" From="2" To="{Binding ProgressValue}" Duration="0:0:1" FillBehavior="HoldEnd" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </ProgressBar.Triggers>
                        </ProgressBar>
                    </Grid>

                    <!-- Feature Highlight Title -->
                    <Grid Grid.Row="1" Margin="0, 50, 0, 0" Width="auto" Height="28" HorizontalAlignment="Left">
                        <UXControls:UXTextBlock x:Name="TitleText" Text="{Binding [EazyMemory.39], Source={x:Static lang:LangHelper.Instance}}" Foreground="{DynamicResource DefaultTheme_PbHeaderColor}" FontSize="20" LineHeight="28" />
                    </Grid>

                    <!-- Customizable Keys Title -->
                    <Grid Grid.Row="2" Margin="0, 8, 0, 0" Width="476" HorizontalAlignment="Left">
                        <UXControls:UXTextBlock x:Name="MainText" Text="" FontSize="60" TextWrapping="Wrap"/>
                    </Grid>

                    <!-- Description Text -->
                    <Grid Grid.Row="3" Margin="0, 16, 0, 0" Width="476" HorizontalAlignment="Left">
                        <UXControls:UXTextBlock x:Name="SubText" Text="" FontSize="15" TextWrapping="Wrap" />
                    </Grid>

                    <!-- Buttons -->
                    <!-- Robert_Lin 2025-1-15 [PIMS-332070] L10N: i18N: DDPM 2.0: GUI: TP1: de-DE, pt-BR, pt-PT, ru-RU, ua-UK: 
                         Arrow icon and StringID: Finish were cut off
                    Root cause: the Finish button need to expand the width to fit the text. Need to change Grid layout to WrapPanel.
                    
                    OLD:
                    <Grid Grid.Row="4" Margin="0, 0, 0, 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                    
                        <Grid Grid.Column="0" Margin="0,170,0,0">
                            <StackPanel Orientation="Horizontal">
                                <UXControls:UXButton x:Name="ArrowButton" Visibility="{Binding ArrowButtonVisibility}" Width="48" Height="40" ButtonType="Secondary" ButtonSize="Medium" IconAnimation="Move" Margin="0" Padding="16,8" Click="ArrowButton_Click">
                                    <Path Data="M3.62037 11.6746L3.34146 12L3.62037 12.3254L9.62037 19.3254L10.3796 18.6746L5.08711 12.5L21 12.5L21 11.5L5.08711 11.5L10.3796 5.32538L9.62037 4.67459L3.62037 11.6746Z" Fill="{DynamicResource DefaultTheme_PbHeaderColor}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </UXControls:UXButton>
                               <UXControls:UXButton x:Name="FinishBtn" IconPosition="IconRight" HorizontalContentAlignment="Center" ButtonType="Primary" Padding="40, 8" ButtonSize="Medium" VerticalContentAlignment="Center" Margin="10, 0, 0, 0" IconAnimation="Move" Width="164" Height="40" Click="FinishBtn_Click">
                                   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                       <UXControls:UXTextBlock Margin="8,0" Text="{Binding [EazyMemory.16], Source={x:Static lang:LangHelper.Instance}, Mode=OneWay}" Foreground="White"/>
                                       <Path x:Name="ArrowPath" Margin="0,2" Data="M17.3796 8.3256L17.6585 8.0002L17.3796 7.67481L11.3796 0.674805L10.6204 1.3256L15.9129 7.5002H0V8.5002H15.9129L10.6204 14.6748L11.3796 15.3256L17.3796 8.3256Z" Fill="white">
                                           <Path.RenderTransform>
                                               <ScaleTransform ScaleX="1" ScaleY="1"/>
                                           </Path.RenderTransform>
                                       </Path>
                                   </StackPanel>
                                   <UXControls:UXButton.Triggers>
                                       <EventTrigger RoutedEvent="MouseEnter">
                                           <BeginStoryboard>
                                               <Storyboard>
                                                   <DoubleAnimation Storyboard.TargetName="ArrowPath" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" From="1" To="1.2" Duration="0:0:1" AutoReverse="True" RepeatBehavior="Forever" />
                                                   <DoubleAnimation Storyboard.TargetName="ArrowPath" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" From="1" To="1.2" Duration="0:0:1" AutoReverse="True" RepeatBehavior="Forever" />
                                               </Storyboard>
                                           </BeginStoryboard>
                                       </EventTrigger>
                                       <EventTrigger RoutedEvent="MouseLeave">
                                           <BeginStoryboard>
                                               <Storyboard>
                                                   <DoubleAnimation Storyboard.TargetName="ArrowPath" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2" />
                                                   <DoubleAnimation Storyboard.TargetName="ArrowPath" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2" />
                                               </Storyboard>
                                           </BeginStoryboard>
                                       </EventTrigger>
                                   </UXControls:UXButton.Triggers>
                               </UXControls:UXButton>
                           </StackPanel>
                        </Grid>
                        <Grid Grid.Column="1" Margin="0,170,0,0">
                           <UXControls:UXButton x:Name="CancelBtn" Visibility="{Binding SkipButtonVisibility}" ButtonType="Tertiary" Width="90" Height="40" ButtonSize="Medium" Margin="10, 0" Content="{Binding [EazyMemory.17], Source={x:Static lang:LangHelper.Instance}, Mode=OneWay}" IconAnimation="Move" Click="CancelBtn_Click"/>
                       </Grid>
                   </Grid>
 
                    -->
                    <WrapPanel Grid.Row="4" Margin="0,170,0,0">
                        <!-- #region Back Button -->
                        <UXControls:UXButton x:Name="ArrowButton" Visibility="{Binding ArrowButtonVisibility}" 
                                             Width="48" Height="40" ButtonType="Secondary" ButtonSize="Medium" 
                                             IconAnimation="Move" Margin="0,0,0,0" Padding="16,8" Click="ArrowButton_Click">
                            <Path Data="M3.62037 11.6746L3.34146 12L3.62037 12.3254L9.62037 19.3254L10.3796 18.6746L5.08711 12.5L21 12.5L21 11.5L5.08711 11.5L10.3796 5.32538L9.62037 4.67459L3.62037 11.6746Z" Fill="{DynamicResource DefaultTheme_PbHeaderColor}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </UXControls:UXButton>
                        <!-- #endregion Back Button -->
                        
                        <!-- #region Finish Button -->
                        <UXControls:UXButton x:Name="FinishBtn" IconPosition="IconRight" HorizontalContentAlignment="Center" 
                                             ButtonType="Primary" Padding="40, 8" ButtonSize="Medium" 
                                             Margin="10,0,10,0" IconAnimation="Move" Height="40" d:Width="164"
                                             Click="FinishBtn_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <UXControls:UXTextBlock Margin="8,0" Text="{Binding [EazyMemory.16], Source={x:Static lang:LangHelper.Instance}, Mode=OneWay}" Foreground="White"/>
                                <Path x:Name="ArrowPath" Margin="0,2" Data="M17.3796 8.3256L17.6585 8.0002L17.3796 7.67481L11.3796 0.674805L10.6204 1.3256L15.9129 7.5002H0V8.5002H15.9129L10.6204 14.6748L11.3796 15.3256L17.3796 8.3256Z" Fill="white">
                                    <Path.RenderTransform>
                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                    </Path.RenderTransform>
                                </Path>
                            </StackPanel>
                            <UXControls:UXButton.Triggers>
                                <EventTrigger RoutedEvent="MouseEnter">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ArrowPath" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" From="1" To="1.2" Duration="0:0:1" AutoReverse="True" RepeatBehavior="Forever" />
                                            <DoubleAnimation Storyboard.TargetName="ArrowPath" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" From="1" To="1.2" Duration="0:0:1" AutoReverse="True" RepeatBehavior="Forever" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ArrowPath" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2" />
                                            <DoubleAnimation Storyboard.TargetName="ArrowPath" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </UXControls:UXButton.Triggers>
                        </UXControls:UXButton>
                        <!-- #endregion Finish Button -->
                        
                        <!-- #region Cancel Button -->
                        <UXControls:UXButton x:Name="CancelBtn" Visibility="{Binding SkipButtonVisibility}" ButtonType="Tertiary"
                                             d:Width="90"  Height="40" ButtonSize="Medium" Margin="0,0,0,0" 
                                             Content="{Binding [EazyMemory.17], Source={x:Static lang:LangHelper.Instance}, Mode=OneWay}" 
                                             IconAnimation="Move" Click="CancelBtn_Click"/>
                        <!-- #endregion Cancel Button -->
                    </WrapPanel>
                    
                    <!-- Robert_Lin 2025-1-15 OLD Code, can be removed -->
                    <Grid Grid.Row="4" Margin="0, 0, 0, 0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- First Button Group -->
                        <Grid Grid.Column="0" Margin="0,170,0,0">
                            <StackPanel Orientation="Horizontal">
                                <UXControls:UXButton x:Name="ArrowButton_OLD" Visibility="{Binding ArrowButtonVisibility}" Width="48" Height="40" ButtonType="Secondary" ButtonSize="Medium" IconAnimation="Move" Margin="0" Padding="16,8" Click="ArrowButton_Click">
                                    <Path Data="M3.62037 11.6746L3.34146 12L3.62037 12.3254L9.62037 19.3254L10.3796 18.6746L5.08711 12.5L21 12.5L21 11.5L5.08711 11.5L10.3796 5.32538L9.62037 4.67459L3.62037 11.6746Z" Fill="{DynamicResource DefaultTheme_PbHeaderColor}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </UXControls:UXButton>

                                <!-- Next Button -->
                                <UXControls:UXButton x:Name="FinishBtn_OLD" IconPosition="IconRight" HorizontalContentAlignment="Center" ButtonType="Primary" Padding="40, 8" ButtonSize="Medium" VerticalContentAlignment="Center" Margin="10, 0, 0, 0" IconAnimation="Move" Width="164" Height="40" Click="FinishBtn_Click">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <UXControls:UXTextBlock Margin="8,0" Text="{Binding [EazyMemory.16], Source={x:Static lang:LangHelper.Instance}, Mode=OneWay}" Foreground="White"/>
                                        <Path x:Name="ArrowPath_OLD" Margin="0,2" Data="M17.3796 8.3256L17.6585 8.0002L17.3796 7.67481L11.3796 0.674805L10.6204 1.3256L15.9129 7.5002H0V8.5002H15.9129L10.6204 14.6748L11.3796 15.3256L17.3796 8.3256Z" Fill="white">
                                            <Path.RenderTransform>
                                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                            </Path.RenderTransform>
                                        </Path>
                                    </StackPanel>
                                    <UXControls:UXButton.Triggers>
                                        <EventTrigger RoutedEvent="MouseEnter">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="ArrowPath" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" From="1" To="1.2" Duration="0:0:1" AutoReverse="True" RepeatBehavior="Forever" />
                                                    <DoubleAnimation Storyboard.TargetName="ArrowPath" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" From="1" To="1.2" Duration="0:0:1" AutoReverse="True" RepeatBehavior="Forever" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="MouseLeave">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="ArrowPath" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2" />
                                                    <DoubleAnimation Storyboard.TargetName="ArrowPath" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </UXControls:UXButton.Triggers>
                                </UXControls:UXButton>
                            </StackPanel>
                        </Grid>

                        <!-- Second Button Group -->
                        <Grid Grid.Column="1" Margin="0,170,0,0">
                            <UXControls:UXButton x:Name="CancelBtn_OLD" Visibility="{Binding SkipButtonVisibility}" ButtonType="Tertiary" Width="90" Height="40" ButtonSize="Medium" Margin="10, 0" Content="{Binding [EazyMemory.17], Source={x:Static lang:LangHelper.Instance}, Mode=OneWay}" IconAnimation="Move" Click="CancelBtn_Click"/>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- Keyboard Image and Settings -->
                <Grid x:Name="RightGridPage2" Visibility="{Binding RightGridPage2Visibility}" Grid.Column="1"  Margin="64, 96, 96, 0">
                    <!-- Launch Option Selection Panel with CSS-based adjustments -->
                    <Border BorderThickness="1" CornerRadius="6" Margin="200,90,0,0" Padding="16,16,16,32" Width="353" Height="auto" HorizontalAlignment="Center" VerticalAlignment="Top">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0">
                                <!-- Title -->
                                <UXControls:UXTextBlock x:Name="TitleTB" Grid.Row="0" Text="{Binding [EazyMemory.12], Source={x:Static lang:LangHelper.Instance}, Mode=OneWay}" FontSize="16"  Margin="0,0,0,8" />

                                <!-- Radio Buttons for Manual or Automatic Launch -->
                                <StackPanel Orientation="Vertical" Margin="0,8,0,0">
                                    <!-- Robert_Lin 2025-1-13 for PIMS-332061 es-XL, ru-RU: Clipping issue found in StringID: EazyMemory.15
                                        RadioBtton requiremens: Adjust the box to fit the text for the radio button. It should not exceed 3 lines. If it does, shorten with “...”
                                   
                                                                    MaxHeight="{Binding [EazyMemory.14], Source={x:Static lang:LangHelper.Instance}, Converter={StaticResource MaxHeightConverter}, ConverterParameter='16,3'}"
                                  
                                    -->
                                    <Grid Margin="0,8,0,0">
                                        <UXControls:UXRadioButton x:Name="ManulRB" Margin="8,2,0,2" IsChecked="{Binding IsManualLaunch}" Style="{StaticResource Max3LinesRadioButtonStyle}"
                                                                  Content="{Binding [EazyMemory.14], Source={x:Static lang:LangHelper.Instance}, Mode=OneWay}"
                                                                  />
                                    </Grid>
                                    
                                    <!--<StackPanel Orientation="Horizontal" Margin="0,8,0,0" Width="305" Height="28" Visibility="Collapsed">
                                         <UXControls:UXRadioButton x:Name="ManulRB" Grid.Row="1" Content="{Binding [EazyMemory.14], Source={x:Static lang:LangHelper.Instance}, Mode=OneWay}" 
                                                                FontSize="16" Margin="8,2,0,2" IsChecked="{Binding IsManualLaunch}" Height="36"  
                                                                MaxHeight="{Binding [EazyMemory.14], Source={x:Static lang:LangHelper.Instance}, Converter={StaticResource MaxHeightConverter}, ConverterParameter='16,3'}"
                                                                >
                                            <UXControls:UXRadioButton.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent" />
                                                </Style>
                                            </UXControls:UXRadioButton.Resources>
                                         </UXControls:UXRadioButton>
                                    </StackPanel>-->

                                    <Grid Margin="0,8,0,0">
                                        <!-- 
                                              <UXControls:UXRadioButton x:Name="AutoRB" VerticalAlignment="Top"
                                                                 FontSize="16" Margin="8,2,0,2" IsChecked="{Binding IsAutoLaunch}"
                                                                 MaxHeight="{Binding [EazyMemory.15], Source={x:Static lang:LangHelper.Instance}, Converter={StaticResource MaxHeightConverter}, ConverterParameter='16,3'}"
                                                                 >
                                 
                                        -->
                                        <UXControls:UXRadioButton x:Name="AutoRB" Margin="8,2,0,2" IsChecked="{Binding IsAutoLaunch}" Style="{StaticResource Max3LinesRadioButtonStyle}"
                                                                  Content="{Binding [EazyMemory.15], Source={x:Static lang:LangHelper.Instance}, Mode=OneWay}"
                                                                  />
                                    </Grid>

                                    <!--<StackPanel Orientation="Horizontal" Margin="0,8,0,0" Width="305" Height="28">
                                        <UXControls:UXRadioButton x:Name="AutoRB2" Grid.Row="2" Content="{Binding [EazyMemory.15], Source={x:Static lang:LangHelper.Instance}, Mode=OneWay}" FontSize="16" Height="36"  Margin="8,2,0,2" IsChecked="{Binding IsAutoLaunch}">
                                            <UXControls:UXRadioButton.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent" />
                                                </Style>
                                            </UXControls:UXRadioButton.Resources>
                                        </UXControls:UXRadioButton>
                                    </StackPanel>-->

                                    <!-- Time Picker Controls (Disabled when manually select is checked) -->
                                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="46,8,0,0" >
                                        <UXControls:UXComboBox x:Name="HourCB" FontSize="14" Width="81" Height="40" Style="{StaticResource DdpmComboBoxStyleEzMemory}" BorderThickness="0.3" Margin="0,0,4,0" ItemsSource="{Binding HourList}"  SelectedItem="{Binding SelectedHour}"/>

                                        <!-- 添加時間選項 -->
                                        <UXControls:UXComboBox x:Name="MinuteCB" FontSize="14" Width="81" Height="40" Style="{StaticResource DdpmComboBoxStyleEzMemory}" BorderThickness="0.3" Margin="4,0,4,0" VerticalAlignment="Top" HorizontalContentAlignment="Center" ItemsSource="{Binding MinuteList}" SelectedItem="{Binding SelectedMinute}"/>

                                        <UXControls:UXComboBox x:Name="AMPMCB" Width="81" Height="40" FontSize="14" Style="{StaticResource DdpmComboBoxStyleEzMemory}" BorderThickness="0.3" Margin="4,0,4,0" ItemsSource="{Binding AMPMList}" SelectedItem="{Binding SelectedAMPM}" />

                                    </StackPanel>
                                </StackPanel>

                                <!-- Launch during PC startup Checkbox -->
                                <StackPanel Grid.Row="4" Orientation="Horizontal">
                                    <UXControls:UXCheckBox x:Name="StartupCB" Content="{Binding [EazyMemory.13], Source={x:Static lang:LangHelper.Instance}, Mode=OneWay}" FontSize="18"  Margin="0,16,0,0" IsChecked="{Binding IsLaunchAtStartup}" Checked="StartupCB_Checked"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>


