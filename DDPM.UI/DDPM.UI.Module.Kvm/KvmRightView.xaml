<UserControl x:Class="DDPM.UI.Module.Kvm.KvmRightView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             xmlns:local="clr-namespace:DDPM.UI.Module.Kvm"
             xmlns:lang="clr-namespace:DDPM.UI.Resources.Helper;assembly=DDPM.UI.Resources"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- <ResourceDictionary Source="/DDPM.UI.Common;component/ModuleStyle.xaml" /> -->
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <UXControls:UXScrollViewer>
            <Border CornerRadius="13">
                <StackPanel Margin="16,16,16,0">
                    <Grid>
                        <UXControls:UXTextBlock Text="{Binding [Kvm.24], Source={x:Static lang:LangHelper.Instance}}"
                                                FontSize="20"
                                                TextBlockSemanticColorType="Light"
                                                TextBlockType="Caption"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left"
                                                Height="28"
                                                Foreground="White" />
                    </Grid>
                    <Grid Margin="0,16,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,8" Background="{DynamicResource DefaultTheme_GridBkColor}">
                            <UXControls:UXRadioButton AutomationProperties.AutomationId="LargeRB1"
                                                      GroupName="KVMSelect"
                                                      Content="{Binding [Kvm.19], Source={x:Static lang:LangHelper.Instance}}" IsChecked="{Binding isNoKVM}"
                                                      RadioButtonSize="Large"
                                                      HorizontalAlignment="Left"
                                                      Margin="16"
                                                      Foreground="White"
                                                      Checked="SelectNoKVM" />
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,8,0,8" Background="{DynamicResource DefaultTheme_GridBkColor}" Visibility="{Binding SupportUSBKVM}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="16,16,16,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <UXControls:UXRadioButton Grid.Column="0" AutomationProperties.AutomationId="LargeRB1"
                                                          GroupName="KVMSelect"
                                                          Content="{Binding [Kvm.20], Source={x:Static lang:LangHelper.Instance}}" IsChecked="{Binding isUSBKVM}"
                                                          RadioButtonSize="Large" HorizontalAlignment="Left"
                                                          IsEnabled="{Binding isUSBKVMEanble}" Opacity="{Binding USBKVM_Opacity}"
                                                          Checked="SelectUSBKVM" />
                                <Grid Grid.Column="1" Margin="8" VerticalAlignment="Center" Visibility="{Binding LockUSBKVM_Visibility}" Background="#00000000">
                                    <Path Data="M11.0998 6.4V4C11.1998 1.8 9.4998 0.1 7.2998 0H7.0998C4.89981 0 3.0998 1.8 3.0998 4V6.4H0.799805V16H13.0998V6.4H11.0998ZM4.2998 4C4.19981 2.5 5.3998 1.3 6.7998 1.2H7.1998C8.7998 1.2 9.9998 2.5 9.9998 4V6.4H4.2998V4ZM12.0998 14.9H1.9998V7.5H12.0998V14.9Z" />
                                    <Path Data="M6.5998 12.5H7.5998V9.3H5.7998V10.3H6.5998V12.5Z" />
                                    <Grid.ToolTip>
                                        <ToolTip>
                                            <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                                <Border.Resources>
                                                    <Style BasedOn="{StaticResource Tooltip_TextBlockStyle}" TargetType="TextBlock" />
                                                </Border.Resources>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding [ITLockToolTip.0], Source={x:Static lang:LangHelper.Instance}}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </ToolTip>
                                    </Grid.ToolTip>
                                </Grid>
                            </Grid>
                            <Grid Grid.Row="1">
                                <UXControls:UXTextBlock Text="{Binding [Kvm.25], Source={x:Static lang:LangHelper.Instance},StringFormat={} •  {0}}"
                                                        TextBlockType="Subtitle2"
                                                        HorizontalAlignment="Left"
                                                        Margin="16,4,16,4"
                                                        Opacity="{Binding USBKVM_Opacity}"/>
                            </Grid>
                            <Grid Grid.Row="2">
                                <UXControls:UXTextBlock Text="{Binding [Kvm.26], Source={x:Static lang:LangHelper.Instance},StringFormat={} •  {0}}"
                                                        TextBlockType="Subtitle2"
                                                        HorizontalAlignment="Left"
                                                        Margin="16,4,16,16"
                                                        Opacity="{Binding USBKVM_Opacity}"/>
                            </Grid>
                            <Grid Grid.Row="3" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <UXControls:UXButton ButtonType="Primary"
                                                         AutomationProperties.Name="Primary1"
                                                         x:Name="USBKVM"
                                                         ButtonSize="Medium"
                                                         Content="{Binding [Kvm.21], Source={x:Static lang:LangHelper.Instance}}"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Margin="16" Padding="40,8"
                                                         Background="#0672CB" Opacity="{Binding USBKVMButtonOpacity}"
                                                         Foreground="White"
                                                         Click="OpenUSBKVM"
                                                         Visibility="Collapsed"
                                                         IsEnabled="{Binding isUSBKVMButton}"/>
                                    <UXControls:UXButton ButtonType="Primary"
                                                         AutomationProperties.Name="Primary1"
                                                         x:Name="ONUSBKVM"
                                                         ButtonSize="Medium"
                                                         Content="{Binding [Kvm.22], Source={x:Static lang:LangHelper.Instance}}"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Margin="16" Padding="40,8"
                                                         Background="#0672CB" Opacity="{Binding USBKVMButtonOpacity}"
                                                         Foreground="White"
                                                         Click="OpenUSBKVM"
                                                         Visibility="Collapsed"
                                                         IsEnabled="{Binding isUSBKVMButton}"/>
                                    <UXControls:UXButton ButtonType="Secondary"
                                                         x:Name="USBKVMHotkeys"
                                                         ButtonSize="Medium"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Margin="16" Padding="32,0"
                                                         Visibility="Collapsed" Click="USBKVMHotkeys_Click">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <UXControls:UXTextBlock Margin="8" Text="{Binding [Hotkeys], Source={x:Static lang:LangHelper.Instance}}" Foreground="White" />
                                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Background="#00000000">
                                                <Path Data="M8 0C6.41775 0 4.87103 0.469192 3.55544 1.34824C2.23985 2.22729 1.21447 3.47672 0.608967 4.93853C0.00346625 6.40034 -0.15496 8.00887 0.153721 9.56072C0.462403 11.1126 1.22433 12.538 2.34315 13.6569C3.46197 14.7757 4.88743 15.5376 6.43928 15.8463C7.99113 16.155 9.59966 15.9965 11.0615 15.391C12.5233 14.7855 13.7727 13.7602 14.6518 12.4446C15.5308 11.129 16 9.58225 16 8C16 5.87827 15.1571 3.84344 13.6569 2.34315C12.1566 0.842855 10.1217 0 8 0ZM8 14.93C6.62938 14.93 5.28953 14.5236 4.1499 13.7621C3.01027 13.0006 2.12203 11.9183 1.59752 10.652C1.073 9.3857 0.935766 7.99231 1.20316 6.64802C1.47056 5.30374 2.13058 4.06893 3.09975 3.09975C4.06893 2.13057 5.30374 1.47055 6.64803 1.20316C7.99232 0.935762 9.38571 1.073 10.652 1.59751C11.9183 2.12203 13.0006 3.01027 13.7621 4.1499C14.5236 5.28953 14.93 6.62938 14.93 8C14.9274 9.83714 14.1964 11.5983 12.8973 12.8973C11.5983 14.1964 9.83714 14.9274 8 14.93Z
                                                      M7.36 3.36H8.64V4.64H7.36V3.36Z
                                                      M7.36 6.24H8.64V12.64H7.36V6.24Z">
                                                </Path>
                                                <Grid.ToolTip>
                                                    <ToolTip>
                                                        <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                                            <Border.Resources>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Tooltip_TextBlockStyle}" />
                                                            </Border.Resources>
                                                            <StackPanel>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock x:Name="KvmHotkeyTooltip" Text="{Binding KvmHotkeyTooltip,Mode=TwoWay}" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </ToolTip>
                                                </Grid.ToolTip>
                                            </Grid>
                                        </StackPanel>
                                    </UXControls:UXButton>
                                </StackPanel>
                            </Grid>
                        </Grid>
                        <Grid Grid.Row="2" Margin="0,8,0,16" Background="{DynamicResource DefaultTheme_GridBkColor}"
                              Visibility="{Binding SupportNKVM}" >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="16,16,16,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <UXControls:UXRadioButton Grid.Column="0" AutomationProperties.AutomationId="LargeRB1"
                                                          GroupName="KVMSelect"
                                                          Content="{Binding [Kvm.23], Source={x:Static lang:LangHelper.Instance}}" IsChecked="{Binding isNKVM}"
                                                          RadioButtonSize="Large" HorizontalAlignment="Left"
                                                          IsEnabled="{Binding isNKVMEanble}" Opacity="{Binding NKVM_Opacity}"
                                                          Checked="SelectNKVM" />
                                <Grid Grid.Column="1" Margin="8" VerticalAlignment="Center" Visibility="{Binding LockNKVM_Visibility}" Background="#00000000">
                                    <Path Data="M11.0998 6.4V4C11.1998 1.8 9.4998 0.1 7.2998 0H7.0998C4.89981 0 3.0998 1.8 3.0998 4V6.4H0.799805V16H13.0998V6.4H11.0998ZM4.2998 4C4.19981 2.5 5.3998 1.3 6.7998 1.2H7.1998C8.7998 1.2 9.9998 2.5 9.9998 4V6.4H4.2998V4ZM12.0998 14.9H1.9998V7.5H12.0998V14.9Z" />
                                    <Path Data="M6.5998 12.5H7.5998V9.3H5.7998V10.3H6.5998V12.5Z" />
                                    <Grid.ToolTip>
                                        <ToolTip>
                                            <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                                <Border.Resources>
                                                    <Style BasedOn="{StaticResource Tooltip_TextBlockStyle}" TargetType="TextBlock" />
                                                </Border.Resources>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding [ITLockToolTip.0], Source={x:Static lang:LangHelper.Instance}}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </ToolTip>
                                    </Grid.ToolTip>
                                </Grid>
                            </Grid>
                            <Grid Grid.Row="1">
                                <UXControls:UXTextBlock Text="{Binding [Kvm.28], Source={x:Static lang:LangHelper.Instance},StringFormat={} •  {0}}"
                                                        TextBlockType="Subtitle2"
                                                        HorizontalAlignment="Left"
                                                        Margin="16,8,16,4" Opacity="{Binding NKVM_Opacity}"/>
                            </Grid>
                            <Grid Grid.Row="2">
                                <UXControls:UXTextBlock Text="{Binding [Kvm.29], Source={x:Static lang:LangHelper.Instance},StringFormat={} •  {0}}"
                                                        TextBlockType="Subtitle2"
                                                        HorizontalAlignment="Left"
                                                        Margin="16,4,16,4" Opacity="{Binding NKVM_Opacity}"/>
                            </Grid>
                            <Grid Grid.Row="3">
                                <UXControls:UXTextBlock Text="{Binding [Kvm.30], Source={x:Static lang:LangHelper.Instance},StringFormat={} •  {0}}"
                                                        TextBlockType="Subtitle2"
                                                        HorizontalAlignment="Left"
                                                        Margin="16,4,16,16" Opacity="{Binding NKVM_Opacity}"/>
                            </Grid>
                            <Grid Grid.Row="4">
                                <UXControls:UXButton ButtonType="Tertiary"
                                                     Name="NetworkKVM"
                                                     ButtonSize="Medium"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     Margin="16" Padding="32,0"
                                                     Background="#0672CB"
                                                     Visibility="Collapsed" Click="OpenNKVM">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <UXControls:UXTextBlock Margin="8" Text="{Binding [Kvm.31], Source={x:Static lang:LangHelper.Instance}}" Foreground="White" />
                                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Background="#00000000">
                                            <Path Data="M8 0C6.41775 0 4.87103 0.469192 3.55544 1.34824C2.23985 2.22729 1.21447 3.47672 0.608967 4.93853C0.00346625 6.40034 -0.15496 8.00887 0.153721 9.56072C0.462403 11.1126 1.22433 12.538 2.34315 13.6569C3.46197 14.7757 4.88743 15.5376 6.43928 15.8463C7.99113 16.155 9.59966 15.9965 11.0615 15.391C12.5233 14.7855 13.7727 13.7602 14.6518 12.4446C15.5308 11.129 16 9.58225 16 8C16 5.87827 15.1571 3.84344 13.6569 2.34315C12.1566 0.842855 10.1217 0 8 0ZM8 14.93C6.62938 14.93 5.28953 14.5236 4.1499 13.7621C3.01027 13.0006 2.12203 11.9183 1.59752 10.652C1.073 9.3857 0.935766 7.99231 1.20316 6.64802C1.47056 5.30374 2.13058 4.06893 3.09975 3.09975C4.06893 2.13057 5.30374 1.47055 6.64803 1.20316C7.99232 0.935762 9.38571 1.073 10.652 1.59751C11.9183 2.12203 13.0006 3.01027 13.7621 4.1499C14.5236 5.28953 14.93 6.62938 14.93 8C14.9274 9.83714 14.1964 11.5983 12.8973 12.8973C11.5983 14.1964 9.83714 14.9274 8 14.93Z
                                                        M7.36 3.36H8.64V4.64H7.36V3.36Z
                                                        M7.36 6.24H8.64V12.64H7.36V6.24Z">
                                            </Path>
                                            <Grid.ToolTip>
                                                <ToolTip>
                                                    <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                                        <Border.Resources>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Tooltip_TextBlockStyle}" />
                                                        </Border.Resources>
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding [Kvm.32], Source={x:Static lang:LangHelper.Instance}}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </ToolTip>
                                            </Grid.ToolTip>
                                        </Grid>
                                    </StackPanel>
                                </UXControls:UXButton>
                            </Grid>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>
        </UXControls:UXScrollViewer>
        <Border Name="DisableAll" Background="#4C24273C">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <!-- Add a UXBusyIndicator from Robert -->
            <UXControls:UXBusyIndicator BusyIndicatorType="Secondary" Width="64" Height="64"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        IsActive="{Binding IsBusy}" />
        </Border>
        <!--<Button Width="200" Height="160" Content="KvmRightView" />-->
    </Grid>
</UserControl>