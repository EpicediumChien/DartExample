<UserControl x:Class="DDPM.UI.Module.Kvm.PBPSplitCtrl4A"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DDPM.UI.Module.Kvm"
             xmlns:lang="clr-namespace:DDPM.UI.Resources.Helper;assembly=DDPM.UI.Resources"
             mc:Ignorable="d"
             d:Background="Black"
             d:DesignHeight="306" d:DesignWidth="544">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SplitStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource SplitCtrl_OutterBorder}">

        <Grid Name="g0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Column="0" Grid.Row="0" Background="#00000000" MouseLeftButtonDown="PBP_MouseLeftDown1">
                <Border Name="cell_4a1" BorderBrush="{StaticResource  BorderColor_SplitNormal}" />
                <Border Name="pbp4_1" BorderBrush="#E6AC28" BorderThickness="3"
                        CornerRadius="{StaticResource SplitItem_CornerRadius}" Visibility="{Binding Border1Visibility}" />
                <Path Margin="8,0" HorizontalAlignment="Right" VerticalAlignment="Center" Fill="#E6AC28" Data="M11.8811 8L4.12109 0L4.12109 16L11.8811 8Z" Visibility="{Binding Border1Visibility}" MouseLeftButtonDown="PBP_SwapClick1" />
                <Path Margin="0,8" HorizontalAlignment="Center" VerticalAlignment="Bottom" Fill="#E6AC28" Data="M8 11.8801L16 4.12012L0 4.12012L8 11.8801Z" Visibility="{Binding Border1Visibility}" MouseLeftButtonDown="PBP_SwapClick4" />
                <Path Margin="8,8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="#E6AC28" Data="M14.0569 14.0571L14.2266 2.91309L2.91285 14.2268L14.0569 14.0571Z" Visibility="{Binding Border1Visibility}" MouseLeftButtonDown="PBP_SwapClick3" />
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Background="#A4B8CD" Padding="4" Text="{Binding PC1_Input}" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="1" Text="{Binding [Kvm.0], Source={x:Static lang:LangHelper.Instance},StringFormat={}{0}1}" Foreground="{DynamicResource TextBlock_ForegroundColor}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Grid>
            <Grid Grid.Column="2" Grid.Row="0" Background="#00000000" MouseLeftButtonDown="PBP_MouseLeftDown2">
                <Border Name="cell_4a2"  BorderBrush="{StaticResource BorderColor_SplitNormal}" />
                <Border Name="pbp4_2"
                        BorderBrush="#E6AC28" BorderThickness="3"
                        CornerRadius="{StaticResource SplitItem_CornerRadius}" Visibility="{Binding Border2Visibility}" />
                <Path Margin="4,0" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="#E6AC28" Data="M4.11891 8L11.8789 16L11.8789 0L4.11891 8Z" Visibility="{Binding Border2Visibility}" MouseLeftButtonDown="PBP_SwapClick1" />
                <Path Margin="0,8" HorizontalAlignment="Center" VerticalAlignment="Bottom" Fill="#E6AC28" Data="M8 11.8801L16 4.12012L0 4.12012L8 11.8801Z" Visibility="{Binding Border2Visibility}" MouseLeftButtonDown="PBP_SwapClick2" />
                <Path Margin="0,8" HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="#E6AC28" Data="M8.57084 14.0569L19.7148 14.2266L8.40114 2.91285L8.57084 14.0569Z" Visibility="{Binding Border2Visibility}" MouseLeftButtonDown="PBP_SwapClick5" />
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Background="#A4B8CD" Padding="4" Text="{Binding PC2_Input}" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="1" Text="{Binding [Kvm.0], Source={x:Static lang:LangHelper.Instance},StringFormat={}{0}2}" Foreground="{DynamicResource TextBlock_ForegroundColor}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Grid>
            <Grid Grid.Column="0" Grid.Row="2" Background="#00000000" MouseLeftButtonDown="PBP_MouseLeftDown4">
                <Border Name="cell_4a3"  BorderBrush="{StaticResource BorderColor_SplitNormal}" />
                <Border Name="pbp4_4" BorderBrush="#E6AC28" BorderThickness="3"
                        CornerRadius="{StaticResource SplitItem_CornerRadius}" Visibility="{Binding Border4Visibility}" />
                <Path Margin="8,0" HorizontalAlignment="Right" VerticalAlignment="Center" Fill="#E6AC28" Data="M11.8811 8L4.12109 0L4.12109 16L11.8811 8Z" Visibility="{Binding Border4Visibility}" MouseLeftButtonDown="PBP_SwapClick6" />
                <Path Margin="0,4" HorizontalAlignment="Center" VerticalAlignment="Top" Fill="#E6AC28" Data="M8 4.11988L0 11.8799L16 11.8799L8 4.11988Z" Visibility="{Binding Border4Visibility}" MouseLeftButtonDown="PBP_SwapClick4" />
                <Path Margin="8,0" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="#E6AC28" Data="M14.0581 8.5701L2.91406 8.40039L14.2278 19.7141L14.0581 8.5701Z" Visibility="{Binding Border4Visibility}" MouseLeftButtonDown="PBP_SwapClick5" />
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Background="#A4B8CD" Padding="4" Text="{Binding PC4_Input}" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="1" Text="{Binding [Kvm.0], Source={x:Static lang:LangHelper.Instance},StringFormat={}{0}4}" Foreground="{DynamicResource TextBlock_ForegroundColor}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Grid>
            <Grid Grid.Column="2" Grid.Row="2" Background="#00000000" MouseLeftButtonDown="PBP_MouseLeftDown3">
                <Border Name="cell_4a4"  BorderBrush="{StaticResource BorderColor_SplitNormal}" />
                <Border Name="pbp4_3" BorderBrush="#E6AC28" BorderThickness="3"
                        CornerRadius="{StaticResource SplitItem_CornerRadius}" Visibility="{Binding Border3Visibility}" Grid.RowSpan="2" />
                <Path Margin="4,0" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="#E6AC28" Data="M4.11891 8L11.8789 16L11.8789 0L4.11891 8Z" Visibility="{Binding Border3Visibility}" MouseLeftButtonDown="PBP_SwapClick6" Grid.Row="1" />
                <Path Margin="0,4" HorizontalAlignment="Center" VerticalAlignment="Top" Fill="#E6AC28" Data="M8 4.11988L0 11.8799L16 11.8799L8 4.11988Z" Visibility="{Binding Border3Visibility}" MouseLeftButtonDown="PBP_SwapClick2" Grid.RowSpan="2" />
                <Path Margin="0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="#E6AC28" Data="M8.56814 8.57084L8.39844 19.7148L19.7121 8.40114L8.56814 8.57084Z" Visibility="{Binding Border3Visibility}" MouseLeftButtonDown="PBP_SwapClick3" Grid.RowSpan="2" />
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Background="#A4B8CD" Padding="4" Text="{Binding PC3_Input}" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="1" Text="{Binding [Kvm.0], Source={x:Static lang:LangHelper.Instance},StringFormat={}{0}3}" Foreground="{DynamicResource TextBlock_ForegroundColor}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Grid>

            <Rectangle Name="v1" Grid.Column="1" Grid.Row="0" Grid.RowSpan="3"
                       Width="{StaticResource ThickSplitter}"
                       Style="{StaticResource RectangleStyle_Splitter}" />
            <Rectangle Name="h1"  Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="3"
                       Height="{StaticResource ThickSplitter}"
                       Style="{StaticResource RectangleStyle_Splitter}" />
        </Grid>
    </Border>
</UserControl>