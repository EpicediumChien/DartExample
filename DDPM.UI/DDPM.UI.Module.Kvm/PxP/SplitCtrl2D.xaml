<UserControl x:Class="DDPM.UI.Module.Kvm.PBPSplitCtrl2D"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DDPM.UI.Module.Kvm"
             xmlns:lang="clr-namespace:DDPM.UI.Resources.Helper;assembly=DDPM.UI.Resources"
             mc:Ignorable="d"
             d:Background="Black"
             d:DesignHeight="306" d:DesignWidth="544">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SplitStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource SplitCtrl_OutterBorder}">

        <Grid Name="g0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="7*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="#00000000" MouseLeftButtonDown="PBP_MouseLeftDown1">
                <Border Name="cell_2a1" BorderBrush="{StaticResource BorderColor_SplitNormal}" BorderThickness="0,0,0,0" />
                <Border Name="pbp2_1"
                        BorderBrush="#E6AC28" BorderThickness="3"
                        CornerRadius="{StaticResource SplitItem_CornerRadius}" Visibility="{Binding Border1Visibility}" />
                <Path Margin="16,0" HorizontalAlignment="Right" VerticalAlignment="Center" Fill="#E6AC28" Data="M11.8811 8L4.12109 0L4.12109 16L11.8811 8Z" Visibility="{Binding Border1Visibility}" MouseLeftButtonDown="PBP_SwapClick" />
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Background="#A4B8CD">
                        <TextBlock Padding="4" Text="{Binding PC1_Input}" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding [Kvm.0], Source={x:Static lang:LangHelper.Instance},StringFormat={}{0}1}" Foreground="{DynamicResource TextBlock_ForegroundColor}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Grid>
            <Grid Grid.Column="2" Background="#00000000" MouseLeftButtonDown="PBP_MouseLeftDown2">
                <Border Name="cell_2a2" BorderBrush="{StaticResource BorderColor_SplitNormal}" BorderThickness="0,0,0,0" />
                <Border Name="pbp2_2"
                        BorderBrush="#E6AC28" BorderThickness="3"
                        CornerRadius="{StaticResource SplitItem_CornerRadius}" Visibility="{Binding Border2Visibility}" />
                <Path Margin="8,0" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="#E6AC28" Data="M4.11891 8L11.8789 16L11.8789 0L4.11891 8Z" Visibility="{Binding Border2Visibility}" MouseLeftButtonDown="PBP_SwapClick" />
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Background="#A4B8CD">
                        <TextBlock Padding="4" Text="{Binding PC2_Input}" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding [Kvm.0], Source={x:Static lang:LangHelper.Instance},StringFormat={}{0}2}" Foreground="{DynamicResource TextBlock_ForegroundColor}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Grid>

            <Rectangle Name="v1" Grid.Column="1" Width="1"
                       Style="{StaticResource RectangleStyle_Splitter}" />
        </Grid>
    </Border>
</UserControl>