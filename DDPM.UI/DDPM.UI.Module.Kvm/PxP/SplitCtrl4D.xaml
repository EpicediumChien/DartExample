<UserControl x:Class="DDPM.UI.Module.Kvm.PBPSplitCtrl4D"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DDPM.UI.Module.Kvm"
             mc:Ignorable="d" 
             d:Background="Black"
             d:DesignHeight="306" d:DesignWidth="544">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SplitStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

    </UserControl.Resources>

    <Border Style="{StaticResource SplitCtrl_OutterBorder}">

        <Grid Name="g0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Background="#00000000" MouseLeftButtonDown="PBP_MouseLeftDown1">
                <Border Name="cell_4d1"  BorderBrush="{StaticResource BorderColor_SplitNormal}"/>
                <Border Name="pbp4_1"
BorderBrush="#E6AC28" BorderThickness="3"
CornerRadius="{StaticResource SplitItem_CornerRadius}" Visibility="{Binding Border1Visibility}"/>
                <Path Fill="#E6AC28" Data="M124.8811 153 L117.12109 145 L117.12109 161 L124.8811 153 Z" Visibility="{Binding Border1Visibility}" MouseLeftButtonDown="PBP_SwapClick1"/>
                <Grid Margin="30,120">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Background="#A4B8CD">
                        <TextBlock Text="{Binding PC1_Input}" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="PC1" Foreground="White" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
            <Grid Grid.Column="2" Background="#00000000" MouseLeftButtonDown="PBP_MouseLeftDown2">
                <Border Name="cell_4d2"  BorderBrush="{StaticResource BorderColor_SplitNormal}" />
                <Border Name="pbp4_2"
BorderBrush="#E6AC28" BorderThickness="3"
CornerRadius="{StaticResource SplitItem_CornerRadius}" Visibility="{Binding Border2Visibility}"/>
                <Path Fill="#E6AC28" Data="M9.11891 153 L16.8789 145 L16.8789 161 L9.11891 153Z" Visibility="{Binding Border2Visibility}" MouseLeftButtonDown="PBP_SwapClick1"/>
                <Path Fill="#E6AC28" Data="M124.8811 153 L117.12109 145 L117.12109 161 L124.8811 153 Z" Visibility="{Binding Border2Visibility}" MouseLeftButtonDown="PBP_SwapClick2"/>
                <Grid Margin="30,120">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Background="#A4B8CD">
                        <TextBlock Text="{Binding PC2_Input}" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="PC2" Foreground="White" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
            <Grid Grid.Column="4" Background="#00000000" MouseLeftButtonDown="PBP_MouseLeftDown3">
                <Border Name="cell_4d3"  BorderBrush="{StaticResource BorderColor_SplitNormal}"/>
                <Border Name="pbp4_3"
BorderBrush="#E6AC28" BorderThickness="3"
CornerRadius="{StaticResource SplitItem_CornerRadius}" Visibility="{Binding Border3Visibility}"/>
                <Path Fill="#E6AC28" Data="M9.11891 153 L16.8789 145 L16.8789 161 L9.11891 153Z" Visibility="{Binding Border3Visibility}" MouseLeftButtonDown="PBP_SwapClick2"/>
                <Path Fill="#E6AC28" Data="M124.8811 153 L117.12109 145 L117.12109 161 L124.8811 153 Z" Visibility="{Binding Border3Visibility}" MouseLeftButtonDown="PBP_SwapClick6"/>
                <Grid Margin="30,120">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Background="#A4B8CD">
                        <TextBlock Text="{Binding PC3_Input}" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="PC3" Foreground="White" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
            <Grid Grid.Column="6" Background="#00000000" MouseLeftButtonDown="PBP_MouseLeftDown4">
                <Border Name="cell_4d4"  BorderBrush="{StaticResource BorderColor_SplitNormal}" />
                <Border Name="pbp4_4"
BorderBrush="#E6AC28" BorderThickness="3"
CornerRadius="{StaticResource SplitItem_CornerRadius}" Visibility="{Binding Border4Visibility}"/>
                <Path Fill="#E6AC28" Data="M9.11891 153 L16.8789 145 L16.8789 161 L9.11891 153Z" Visibility="{Binding Border4Visibility}" MouseLeftButtonDown="PBP_SwapClick6"/>
                <Grid Margin="30,120">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Background="#A4B8CD">
                        <TextBlock Text="{Binding PC4_Input}" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="PC4" Foreground="White" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Grid>

            <Rectangle Name="v1" Grid.Column="1" 
                   Width="{StaticResource ThickSplitter}"
                   Style="{StaticResource RectangleStyle_Splitter}"/>
            <Rectangle Name="v2" Grid.Column="3" 
                   Width="{StaticResource ThickSplitter}"
                   Style="{StaticResource RectangleStyle_Splitter}"/>
            <Rectangle Name="v3" Grid.Column="5" 
                   Width="{StaticResource ThickSplitter}"
                   Style="{StaticResource RectangleStyle_Splitter}"/>


        </Grid>
    </Border>
</UserControl>
