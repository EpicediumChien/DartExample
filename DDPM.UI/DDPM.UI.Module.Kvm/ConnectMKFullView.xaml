<UserControl x:Class="DDPM.UI.Module.Kvm.ConnectMKFullView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             xmlns:local="clr-namespace:DDPM.UI.Module.Kvm"
             xmlns:lang="clr-namespace:DDPM.UI.Resources.Helper;assembly=DDPM.UI.Resources"
             mc:Ignorable="d" Background="#FF0D121A"
             d:DesignHeight="671" d:DesignWidth="1378"
             SizeChanged="UserControl_SizeChanged">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ModuleStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Storyboard x:Key="StoryGotoTwoView">
                <DoubleAnimation Storyboard.TargetName="RightGrid" Storyboard.TargetProperty="Width"
                                 Duration="0:0:0.4" From="0" To="{Binding LeftFrameWidth}" FillBehavior="HoldEnd" />
            </Storyboard>

            <SolidColorBrush x:Key="PageBkColor" Color="#FF0D121A" />
            <SolidColorBrush x:Key="ToolipBkColor" Color="#FF1D2C3B" />
            <SolidColorBrush x:Key="ToolipBdColor" Color="#FF293B4D" />
            <SolidColorBrush x:Key="ToolipTextColor" Color="#FFF5F6F7" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Image x:Name="imgBkGlow"
               Source="pack://application:,,,/DDPM.UI.Common;component/Resources/Background_Glow.png"
               Stretch="UniformToFill"
               HorizontalAlignment="Center" VerticalAlignment="Center" />
        <StackPanel>
            <Grid Margin="24" x:Name="splitGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="552" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Margin="76, 60, 0, 0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- Progress Bar -->
                    <Grid Grid.Row="0">
                        <ProgressBar x:Name="WalkThroughProgressbar" Background="#293B4D" BorderBrush="Transparent" BorderThickness="0" HorizontalAlignment="Left" Height="5" Width="281" Minimum="0" Maximum="3" Value="{Binding ToProgressValue}">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar">
                                    <Setter Property="Foreground" Value="#A4B8CD" />
                                </Style>
                            </ProgressBar.Style>

                            <ProgressBar.Triggers>
                                <EventTrigger RoutedEvent="ProgressBar.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Value" From="{Binding FromProgressValue}" To="{Binding ToProgressValue}" Duration="0:0:1" FillBehavior="HoldEnd" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </ProgressBar.Triggers>
                        </ProgressBar>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0, 50, 0, 0" Width="400" Height="30" HorizontalAlignment="Left">
                        <UXControls:UXTextBlock Text="{Binding [Kvm.2], Source={x:Static lang:LangHelper.Instance}}"
                                                Foreground="{DynamicResource DefaultTheme_PbHeaderColor}"
                                                FontSize="20" LineHeight="28" />
                    </Grid>
                    <Grid Grid.Row="2" Margin="0, 8, 0 ,0" Width="476" Height="150" HorizontalAlignment="Left">
                        <UXControls:UXTextBlock Text="{Binding [Kvm.3], Source={x:Static lang:LangHelper.Instance}}"
                                                FontSize="48" LineHeight="76" />
                    </Grid>
                    <Grid Grid.Row="3" Margin="0, 16, 0, 0" Width="476" Height="120" HorizontalAlignment="Left">
                        <UXControls:UXTextBlock Text="{Binding [Kvm.4], Source={x:Static lang:LangHelper.Instance}}"
                                                FontSize="16" LineHeight="24" />
                    </Grid>
                    <Grid Grid.Row="4" Margin="0, 93, 0 ,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <UXControls:UXButton ButtonType="Secondary" Width="48" Height="40"
                                                 ButtonSize="Medium"
                                                 IconAnimation="Move"
                                                 Click="BackInputFullView"
                                                 Margin="0" Padding="16,8"
                                                 FontSize="14">
                                <Path Data="M0.620372 7.67441L0.341461 7.9998L0.620372 8.3252L6.62037 15.3252L7.37963 14.6744L2.08711 8.4998L18 8.4998L18 7.4998L2.08711 7.4998L7.37963 1.3252L6.62037 0.674405L0.620372 7.67441Z" Fill="#F5F6F7"/>
                            </UXControls:UXButton>
                        </Grid>
                        <Grid Grid.Column="1">
                            <!--<UXControls:UXButton IconPosition="IconRight"
                                                 ButtonType="Primary"
                                                 ButtonSize="Medium"
                                                 Content="{Binding [Kvm.1], Source={x:Static lang:LangHelper.Instance}}"
                                                 ContentStringFormat="{}{0} ⭢"
                                                 IconAnimation="Move"
                                                 Click="OpenPxPFullView"
                                                 HorizontalContentAlignment="Center"
                                                 VerticalContentAlignment="Center"
                                                 Padding="40,8" Margin="10,0" Width="164" Height="40" />-->
                            <UXControls:UXButton IconPosition="IconRight"
                                        ButtonType="Primary"
                                        ButtonSize="Medium"
                                        ContentStringFormat="{}{0}"
                                        IconAnimation="Move"
                                        Click="OpenPxPFullView" Visibility="{Binding isPxP}"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Padding="40,8" Margin="10,0" Width="164" Height="40">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <UXControls:UXTextBlock Margin="8,0" Text="{Binding [Kvm.1], Source={x:Static lang:LangHelper.Instance}}" Foreground="White"/>
                                    <Path Data="M17.3796 8.3256L17.6585 8.0002L17.3796 7.67481L11.3796 0.674805L10.6204 1.3256L15.9129 7.5002H0V8.5002H15.9129L10.6204 14.6748L11.3796 15.3256L17.3796 8.3256Z" Fill="white"/>
                                </StackPanel>
                            </UXControls:UXButton>
                            <UXControls:UXButton IconPosition="IconRight"
                                                ButtonType="Primary"
                                                ButtonSize="Medium"
                                                Content="{Binding [Finish], Source={x:Static lang:LangHelper.Instance}}"
                                                ContentStringFormat="{}{0} ⭢"
                                                IconAnimation="Move"
                                                Click="USBKVMFinish"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                Padding="40,8" Margin="10,0" Width="164" Height="40"
                                                Visibility="{Binding NoPxP}" />
                        </Grid>
                        <Grid Grid.Column="2">
                            <UXControls:UXButton ButtonSize="Medium" Width="90" Height="40"
                                                 ButtonType="Tertiary"
                                                 Content="{Binding [Close], Source={x:Static lang:LangHelper.Instance}}"
                                                 IconAnimation="Move" Visibility="{Binding isPxP}"
                                                 Click="CloseUSBKVM" />
                        </Grid>
                    </Grid>
                </Grid>
                <Grid Grid.Column="1" Margin="259, 0, 259, 0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!--<Image Grid.Row="0" Source="pack://application:,,,/DDPM.UI.Common;component/Resources/USBKVM_MK_1.png" />-->
