<UserControl x:Class="DDPM.UI.Module.Kvm.ConnectMKFullView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             xmlns:local="clr-namespace:DDPM.UI.Module.Kvm"
             mc:Ignorable="d" Background="#FF0D121A"
             d:DesignHeight="671" d:DesignWidth="1378">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ModuleStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Storyboard x:Key="StoryGotoTwoView">
                <DoubleAnimation Storyboard.TargetName="RightGrid" Storyboard.TargetProperty="Width"
        Duration="0:0:0.4" From="0" To="{Binding LeftFrameWidth}" FillBehavior="HoldEnd"/>
            </Storyboard>

            <SolidColorBrush x:Key="PageBkColor" Color="#FF0D121A"/>
            <SolidColorBrush x:Key="ToolipBkColor" Color="#FF1D2C3B"/>
            <SolidColorBrush x:Key="ToolipBdColor" Color="#FF293B4D"/>
            <SolidColorBrush x:Key="ToolipTextColor" Color="#FFF5F6F7"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Image x:Name="imgBkGlow" 
                Source="pack://application:,,,/DDPM.UI.Common;component/Resources/Background_Glow.png" 
                Stretch="UniformToFill"
                HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <StackPanel>
            <Grid Margin="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="552"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Margin="76, 60, 0, 0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Image Source="pack://application:,,,/DDPM.UI.Common;component/Resources/Progressbar2.png" 
                               HorizontalAlignment="Left" Height="5" Width="281"/>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0, 50, 0, 0" Width="400" HorizontalAlignment="Left">
                        <UXControls:UXTextBlock Text="USB KVM SETUP" 
                                                Foreground="#DAF5FD" 
                                                FontSize="20" LineHeight="28"/>
                    </Grid>
                    <Grid Grid.Row="2" Margin="0, 8, 0 ,0" Width="476" HorizontalAlignment="Left">
                        <UXControls:UXTextBlock Text="Connect Mouse &#x000A;and Keyboard" 
                                                Foreground="#F5F6F7" 
                                                FontSize="48" LineHeight="76"/>
                    </Grid>
                    <Grid Grid.Row="3" Margin="0, 16, 0, 0" Width="476" HorizontalAlignment="Left">
                        <UXControls:UXTextBlock Text="For Mouse and Keyboard, connect to rear of monitor (USB-A). &#x000A;Note: You can also connect other USB Peripherals such as &#x000A;Webcam." 
                                                Foreground="#F5F6F7" 
                                                FontSize="16" LineHeight="24"/>
                    </Grid>
                    <Grid Grid.Row="4" Margin="0, 133, 0 ,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <UXControls:UXButton ButtonType="Secondary" Width="48" Height="40"
                                                 ButtonSize="Medium"
                                                 IconAnimation="Move"
                                                 Click="BackInputFullView"
                                                 Margin="0" Padding="16,8" Foreground="#F5F6F7"
                                                 Content=" ⭠ " FontSize="14" BorderBrush="#F5F6F7"/>
                        </Grid>
                        <Grid Grid.Column="1">
                            <UXControls:UXButton IconPosition="IconRight" 
                                                 ButtonType="Primary" 
                                                 ButtonSize="Medium" 
                                                 Content="Next ⭢" 
                                                 IconAnimation="Move" 
                                                 Click="OpenPxPFullView"
                                                 HorizontalContentAlignment="Center" 
                                                 VerticalContentAlignment="Center" 
                                                 Padding="40,8" Margin="10,0" Width="164" Height="40"/>
                        </Grid>
                        <Grid Grid.Column="2">
                            <UXControls:UXButton ButtonSize="Medium" Width="90" Height="40"
                                                 ButtonType="Tertiary"
                                                 Content="Close" 
                                                 IconAnimation="Move" 
                                                 Click="CloseUSBKVM"/>
                        </Grid>
                    </Grid>
                </Grid>
                <Grid Grid.Column="1" Margin="259, 0, 259, 0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Image Grid.Row="0" Source="pack://application:,,,/DDPM.UI.Common;component/Resources/USBKVM_MK_1.png"/>
                    <Grid Grid.Row="1">
                        <UXControls:UXTextBlock Text="     USB-A" FontSize="14" LineHeight="18" Foreground="White" Width="87" Height="28.39" Padding="4"/>
                    </Grid>
                    <Image Grid.Row="2" Source="pack://application:,,,/DDPM.UI.Common;component/Resources/USB-A.png"/>
                    <Image Grid.Row="3" Source="pack://application:,,,/DDPM.UI.Common;component/Resources/USBKVM_MK_2.png"/>
                    <!--<Image Source="pack://application:,,,/DDPM.UI.Common;component/Resources/Connect_M_K.png" 
                           HorizontalAlignment="Center"/>-->
                </Grid>
            </Grid>
        </StackPanel>
        <!--<StackPanel>
            <TextBlock Text="This is Test1 FullView" FontSize="24" Foreground="Cyan"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Test1Value="/>
                <TextBox Text="{Binding Test1Value}" Width="100"/>
                <TextBlock Text="Test2Value=" Margin="20,0,0,0"/>
                <TextBox Text="{Binding Test2Value}" Width="100"/>

            </StackPanel>
            <Button Content="Go to next page" Command="{Binding GotoNextCommand}"/>
            <Button Content="Close FullView" Command="{Binding CloseFullViewCommand}"/>
        </StackPanel>-->

    </Grid>
</UserControl>
