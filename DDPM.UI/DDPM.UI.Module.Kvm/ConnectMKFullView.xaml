                        <Path Data="M151.966 1H1.8672C1.38826 1 1 1.39184 1 1.87521V87.5003C1 87.9837 1.38826 88.3755 1.8672 88.3755H151.966C152.445 88.3755 152.833 87.9837 152.833 87.5003V1.87521C152.833 1.39184 152.445 1 151.966 1Z" StrokeMiterLimit="10"/>
