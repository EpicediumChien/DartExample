                        <Path Data="M72.2545 110.354H46.0877C45.9319 110.355 45.779 110.396 45.6442 110.474C45.5095 110.552 45.3978 110.664 45.3203 110.8C45.2429 110.935 45.2024 111.088 45.2031 111.244C45.2038 111.399 45.2456 111.552 45.3242 111.687L48.4425 117.014C48.5204 117.147 48.6318 117.258 48.7658 117.335C48.8997 117.412 49.0515 117.452 49.206 117.452H104.066C104.216 117.452 104.364 117.414 104.495 117.342C104.626 117.269 104.736 117.164 104.815 117.037L108.153 111.71C108.237 111.576 108.283 111.422 108.288 111.264C108.292 111.106 108.254 110.95 108.177 110.811C108.101 110.673 107.989 110.558 107.853 110.478C107.717 110.397 107.562 110.355 107.404 110.354H80.8803" StrokeThickness="0.4" StrokeMiterLimit="10"/>
