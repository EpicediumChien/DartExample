                        <Path Data="M2.67578 87.4043L11.9211 107.998C12.2902 108.818 12.8883 109.514 13.6436 110.003C14.3989 110.492 15.2793 110.753 16.1792 110.754H217.378C218.243 110.753 219.09 110.512 219.826 110.058C220.562 109.604 221.158 108.955 221.546 108.183L231.996 87.4307" StrokeThickness="0.4" StrokeMiterLimit="10"/>
                    </Grid>
                    <!--<Image Source="{Binding DeviceImage}" Stretch="Uniform">
                    <Image.ToolTip>
                    <ToolTip Placement="Center"  HorizontalOffset="8" VerticalOffset="-8"
                    ToolTipService.HasDropShadow="True"
                    ToolTipService.InitialShowDelay="1000"
                    ToolTipService.BetweenShowDelay="2000">
                    <Border Background="{StaticResource ToolipBkColor}"
                    BorderBrush="{StaticResource ToolipBdColor}"
                    CornerRadius="4" Padding="8,12">
                    <Border.Resources>
                    <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource ToolipTextColor}" />
                    <Setter Property="FontSize" Value="12" />
                    </Style>
                    </Border.Resources>
                    <StackPanel>
                    <TextBlock Text="{Binding DeviceName}" />
                    </StackPanel>
                    </Border>
                    </ToolTip>
                    </Image.ToolTip>
                    </Image>-->
                </Grid>
            </Viewbox>

            <!-- 2024-6-20 Robert_Lin, move this stackPanel inside image box
            1 Change StackPanel Grid.Row=1 to 0; 2. Add VerticalAlignment=Bottom to StackPanel
            -->
            <!-- Robert_Lin 2025-2-11 PIMS-345550 Dark stabilizer toggle hotkey /Open Network KVMstatement is cutted when change Windows
                  display language
            The "Modify PIP/PBP" button is truncated : Change StackPanel to WrapPanel
            -->
            <!--  20240617  jim add -->
            <WrapPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Margin="0, 20, 0, 0">
                <DDPMUserControls:BatteryIndicator Grid.Row="1" HorizontalAlignment="Center" Height="40"

                                                   ConnectionType="{Binding ConnectionType}" VerticalAlignment="Bottom" Text1="{Binding Text1}" />

                <Button Margin="8, 0" MaxWidth="230" MinHeight="40" VerticalAlignment="Top"
                        Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding LeftButtonEnable}"
                        Click="EditInput_Click">
                    <TextBlock Text="{Binding [Kvm.13], Source={x:Static lang:LangHelper.Instance}}" 
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               MaxHeight="40"/>
                </Button>
                <Button MaxWidth="180" MinHeight="40" VerticalAlignment="Top"
                        Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding LeftButtonEnable}"
                        Click="EditPXP_Click" Visibility="{Binding isPxP}">
                    <TextBlock Text="{Binding [Kvm.14], Source={x:Static lang:LangHelper.Instance}}" 
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               MaxHeight="40"/>
                </Button>
            </WrapPanel>
        </Grid>
    </Grid>
</UserControl>