<UserControl x:Class="DDPM.UI.Module.Kvm.KvmLeftView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:DDPMUserControls="clr-namespace:DDPM.UI.Common;assembly=DDPM.UI.Common"
             xmlns:common="clr-namespace:DDPM.UI.Common;assembly=DDPM.UI.Common"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DDPM.UI.Module.Kvm"
             xmlns:lang="clr-namespace:DDPM.UI.Resources.Helper;assembly=DDPM.UI.Resources"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800" Width="500" Height="500">
    <UserControl.Resources>

        <ResourceDictionary>
            <SolidColorBrush x:Key="ToolipBkColor" Color="#FF1D2C3B" />
            <SolidColorBrush x:Key="ToolipBdColor" Color="#FF293B4D" />
            <SolidColorBrush x:Key="ToolipTextColor" Color="#FFF5F6F7" />

            <!-- 20240617  jim add -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DDPM.UI.Common;component/PluginStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Viewbox Margin="32" Grid.Row="0" VerticalAlignment="Center">

                <!-- Width="1378" Height="735"
                -->
                <Grid Margin="32">
                    <Border Grid.Row="0" Width="362" Height="204" CornerRadius="4" BorderThickness="1"
                            Background="#193457" BorderBrush="Gray" VerticalAlignment="Top">
                        <ContentControl Content="{Binding VideoSwapContent}" Margin="6" />
                    </Border>
                    <!--<Image Source="{Binding DeviceImage}" Stretch="Uniform">
                    <Image.ToolTip>
                    <ToolTip Placement="Center"  HorizontalOffset="8" VerticalOffset="-8"
                    ToolTipService.HasDropShadow="True"
                    ToolTipService.InitialShowDelay="1000"
                    ToolTipService.BetweenShowDelay="2000">
                    <Border Background="{StaticResource ToolipBkColor}"
                    BorderBrush="{StaticResource ToolipBdColor}"
                    CornerRadius="4" Padding="8,12">
                    <Border.Resources>
                    <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource ToolipTextColor}" />
                    <Setter Property="FontSize" Value="12" />
                    </Style>
                    </Border.Resources>
                    <StackPanel>
                    <TextBlock Text="{Binding DeviceName}" />
                    </StackPanel>
                    </Border>
                    </ToolTip>
                    </Image.ToolTip>
                    </Image>-->
                </Grid>
            </Viewbox>

            <!-- 2024-6-20 Robert_Lin, move this stackPanel inside image box
            1 Change StackPanel Grid.Row=1 to 0; 2. Add VerticalAlignment=Bottom to StackPanel
            -->
            <!--  20240617  jim add -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Margin="0, 70">
                <DDPMUserControls:BatteryIndicator Grid.Row="1" HorizontalAlignment="Center" Width="84" Height="40"

                                                   ConnectionType="{Binding ConnectionType}" VerticalAlignment="Bottom" Text1="{Binding Text1}" />

                <UXControls:UXButton Margin="8, 0" Width="171" Height="40" VerticalAlignment="Top"
                                     ButtonType="Secondary" ButtonSize="Medium"
                                     Foreground="#F5F6F7" BorderBrush="#F5F6F7"
                                     FontSize="14" Content="{Binding [Kvm.13], Source={x:Static lang:LangHelper.Instance}}"
                                     Click="EditInput_Click" />
                <UXControls:UXButton Width="146" Height="40" VerticalAlignment="Top"
                                     ButtonType="Secondary" ButtonSize="Medium"
                                     Foreground="#F5F6F7" BorderBrush="#F5F6F7"
                                     FontSize="14" Content="{Binding [Kvm.14], Source={x:Static lang:LangHelper.Instance}}"
                                     Click="EditPXP_Click" Visibility="{Binding isPxP}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>