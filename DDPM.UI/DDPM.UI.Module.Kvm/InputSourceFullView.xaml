<UserControl x:Class="DDPM.UI.Module.Kvm.InputSourceFullView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             xmlns:local="clr-namespace:DDPM.UI.Module.Kvm"
             xmlns:lang="clr-namespace:DDPM.UI.Resources.Helper;assembly=DDPM.UI.Resources"
             mc:Ignorable="d" Background="{DynamicResource mainWindowBkColor}"
             d:DesignHeight="671" d:DesignWidth="1278" Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <Storyboard x:Key="StoryGotoTwoView">
                <DoubleAnimation Storyboard.TargetName="RightGrid" Storyboard.TargetProperty="Width"
                                 Duration="0:0:0.4" From="0" To="{Binding LeftFrameWidth}" FillBehavior="HoldEnd" />
            </Storyboard>

            <SolidColorBrush x:Key="PageBkColor" Color="#FF0D121A" />
            <SolidColorBrush x:Key="ToolipBkColor" Color="#FF1D2C3B" />
            <SolidColorBrush x:Key="ToolipBdColor" Color="#FF293B4D" />
            <SolidColorBrush x:Key="ToolipTextColor" Color="#FFF5F6F7" />

            <!-- DataTemplate for displaying text and Path -->
            <DataTemplate x:Key="ComboBoxItemTemplate">
                <StackPanel Orientation="Horizontal">
                    <!-- Path Data binding -->
                    <Path Data="{Binding PathData}" 
              Fill="Black" 
              Width="24" Height="24" 
              Stretch="Uniform" 
              Margin="0,0,5,0"/>
                    <!-- Text binding -->
                    <TextBlock Text="{Binding Text}" VerticalAlignment="Center"/>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Image x:Name="imgBkGlow"
               Source="pack://application:,,,/DDPM.UI.Common;component/Resources/Background_Glow.png"
               Stretch="UniformToFill"
               HorizontalAlignment="Center" VerticalAlignment="Center" />
        <StackPanel>
            <Grid Margin="24" x:Name="splitGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" MinWidth="645" />
                </Grid.ColumnDefinitions>
                <Grid x:Name="LeftGrid" Grid.Column="0" Margin="76, 60, 0, 0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- Progress Bar -->
                    <Grid Grid.Column="0" Grid.Row="0">
                        <ProgressBar x:Name="WalkThroughProgressbar" Background="#293B4D" BorderBrush="Transparent" BorderThickness="0" HorizontalAlignment="Left" Height="5" Width="281" Minimum="0" Maximum="3" Value="{Binding ToProgressValue}">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar">
                                    <Setter Property="Foreground" Value="#A4B8CD" />
                                </Style>
                            </ProgressBar.Style>

                            <ProgressBar.Triggers>
                                <EventTrigger RoutedEvent="ProgressBar.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Value" From="{Binding FromProgressValue}" To="{Binding ToProgressValue}" Duration="0:0:1" FillBehavior="HoldEnd" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </ProgressBar.Triggers>
                        </ProgressBar>
                    </Grid>
                    <Grid Grid.Column="0" Grid.Row="1" Margin="0, 50, 0, 0" HorizontalAlignment="Left">
                        <UXControls:UXTextBlock x:Name="GridTxt_Row1" Text="{Binding [Kvm.2], Source={x:Static lang:LangHelper.Instance}}"
                                                Foreground="{DynamicResource DefaultTheme_PbHeaderColor}"
                                                FontSize="20" LineHeight="28" />
                    </Grid>
                    <Grid Grid.Column="0" Grid.Row="2" Margin="0, 8, 0 ,0" HorizontalAlignment="Left">
                        <!-- Elsa 20250108 For PIMS [PIMS-334050] change FontSize="48" LineHeight="76" to FontSize="42" LineHeight="40" add TextWrapping="WrapWithOverflow" -->
                        <UXControls:UXTextBlock  x:Name="GridTxt_Row2" Text="{Binding [Kvm.6], Source={x:Static lang:LangHelper.Instance}}"
                                                FontSize="64" LineHeight="40" TextWrapping="WrapWithOverflow"/>
                    </Grid>
                    <!--<Grid Grid.Column="0" Grid.Row="3" Margin="0, 16, 0, 0" Width="476" Height="120" HorizontalAlignment="Left">-->
                    <!-- Elsa 20250108 For PIMS [PIMS-334050] change FontSize="16" to FontSize="15" and add TextWrapping="WrapWithOverflow" -->
                    <UXControls:UXTextBlock Grid.Column="0" Grid.Row="3" Margin="0, 16, 0, 0" Height="120" HorizontalAlignment="Left" x:Name="GridTxt_Row3"
                            Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                            Text="{Binding [Kvm.7], Source={x:Static lang:LangHelper.Instance}}" 
                                                FontSize="16" LineHeight="24" TextTrimming="None" TextWrapping="WrapWithOverflow"/>
                    <!--</Grid>-->
                    <Grid Grid.Row="4" Margin="0, 90, 0 ,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <!--<UXControls:UXProgressButton CompletedIconPosition="IconRight" PausedIconPosition="IconRight" RunningIconPosition="IconRight" NormalIconPosition="IconRight" AutomationProperties.Name="ProgressContent" Width="120"
                            NormalContent="Next"
                            ProgressButtonState="Normal"
                            Click="OpenMKFullView" />-->
                            <!-- Elsa 20250108 For PIMS [PIMS-334050] change Width="164" to MinWidth="164"-->
                            <UXControls:UXButton IconPosition="IconRight" HorizontalContentAlignment="Center"
                                                 ButtonType="Primary" Padding="40, 8"
                                                 ButtonSize="Medium" VerticalContentAlignment="Center"
                                                 IconAnimation="Move" MinWidth="164" Height="40"
                                                 ContentStringFormat="{}{0}"
                                                 Click="OpenMKFullView" Visibility="{Binding SetInput}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path x:Name="LeftArrow" Visibility="Visible" Data="M2.6204 8.3256L2.3415 8.0002L2.6204 7.67481L8.6204 0.674805L9.3796 1.3256L4.0871 7.5002H20V8.5002H4.0871L9.3796 14.6748L8.6204 15.3256L2.6204 8.3256Z" Fill="white"/>
                                    <UXControls:UXTextBlock Margin="8,0" Text="{Binding [Kvm.1], Source={x:Static lang:LangHelper.Instance}}" Foreground="White" FontSize="14"/>
                                    <Path x:Name="RightArrow" Visibility="Visible" Data="M17.3796 8.3256L17.6585 8.0002L17.3796 7.67481L11.3796 0.674805L10.6204 1.3256L15.9129 7.5002H0V8.5002H15.9129L10.6204 14.6748L11.3796 15.3256L17.3796 8.3256Z" Fill="white"/>
                                </StackPanel>
                            </UXControls:UXButton>
                            <UXControls:UXButton IconPosition="IconRight" HorizontalContentAlignment="Center"
                                                 ButtonType="Primary" Padding="40, 8"
                                                 ButtonSize="Medium" VerticalContentAlignment="Center"
                                                 Content="{Binding [Save], Source={x:Static lang:LangHelper.Instance}}" FontSize="14"
                                                 IconAnimation="Move" MinWidth="164" Height="40"
                                                 Click="SaveInput" Visibility="{Binding EditInput}" />
                        </Grid>
                        <Grid Grid.Column="1">
                            <UXControls:UXButton ButtonType="Tertiary" MinWidth="90" Height="40"
                                                 ButtonSize="Medium" Margin="10, 0"
                                                 Content="{Binding [Close], Source={x:Static lang:LangHelper.Instance}}" FontSize="14"
                                                 IconAnimation="Move"
                                                 Click="CloseUSBKVM" Visibility="{Binding SetInput}" />
                            <UXControls:UXButton ButtonType="Tertiary" MinWidth="90" Height="40"
                                                 ButtonSize="Medium" Margin="10, 0"
                                                 Content="{Binding [Cancel], Source={x:Static lang:LangHelper.Instance}}" FontSize="14"
                                                 IconAnimation="Move"
                                                 Click="CloseUSBKVM" Visibility="{Binding EditInput}" />
                        </Grid>
                    </Grid>
                </Grid>
                <Grid Grid.Column="1" Margin="0, 60, 0, 0" HorizontalAlignment="Center" VerticalAlignment="Center"
                      MinWidth="424">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="20, 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Margin="0, 0, 8, 0" Background="{DynamicResource DefaultTheme_USBKVMPCGridBkColor}" CornerRadius="13" 
                                BorderBrush="{DynamicResource DefaultTheme_USBKVMComboBdColor}" BorderThickness="2">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="16, 16, 16, 0">
                                    <UXControls:UXTextBlock Text="{Binding [Kvm.0], Source={x:Static lang:LangHelper.Instance},StringFormat={}{0}1}"
                                                        Foreground="{DynamicResource DefaultTheme_USBKVMPCColor}"
                                                        FontSize="16" LineHeight="24"
                                                        HorizontalAlignment="Center" />
                                </Grid>
                                <Grid Grid.Row="1" Margin="16, 2, 16, 8">
                                    <UXControls:UXTextBox Text="{Binding InputName1}" BorderThickness="1" 
                                                        VerticalContentAlignment="Center" MaxLength="30" 
                                                        PreviewTextInput="UXTextBox_PreviewTextInput"
                                                        TextChanged="UXTextBox_TextChanged1"/>
                                </Grid>
                                <Grid Grid.Row="2" Margin="16, 8, 16, 16">
                                    <StackPanel x:Name="Ports_StackPanel_0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Orientation" Value="Horizontal" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMoreThanPC2}" Value="True">
                                                        <Setter Property="Orientation" Value="Vertical" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <StackPanel>
                                            <UXControls:UXTextBlock Text="{Binding [Video], Source={x:Static lang:LangHelper.Instance}}"
                                                                Foreground="{DynamicResource DefaultTheme_USBKVMPCColor}"
                                                                FontSize="16" LineHeight="24"
                                                                HorizontalAlignment="Center"
                                                                Margin="0, 0, 0, 2"/>
                                            <ComboBox AutomationProperties.Name="SelectedCheck"
                                                    Style="{StaticResource DdpmUSBKVMComboBoxStyle}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    ItemsSource="{Binding PC1InputsList}"
                                                    SelectedItem="{Binding PC1Inputs_Selected, Mode=TwoWay}"
                                                    DisplayMemberPath="inputDisplayText" MinWidth="133" MinHeight="80"
                                                    Background="{DynamicResource DefaultTheme_USBKVMComboBkColor}"
                                                    BorderBrush="{DynamicResource DefaultTheme_USBKVMComboBdColor}" BorderThickness="1.5" />
                                        </StackPanel>
                                        <StackPanel x:Name="SecondPort_StackPanel_0">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Margin" Value="8, 0, 0, 0" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMoreThanPC2}" Value="True">
                                                            <Setter Property="Margin" Value="0, 16, 0, 0" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <UXControls:UXTextBlock Text="{Binding [USB], Source={x:Static lang:LangHelper.Instance}}"
                                                                Foreground="{DynamicResource DefaultTheme_USBKVMPCColor}"
                                                                FontSize="16" LineHeight="24"
                                                                HorizontalAlignment="Center" />
                                            <ComboBox AutomationProperties.Name="SelectedCheck"
                                                    Style="{StaticResource DdpmUSBKVMComboBoxStyle}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    ItemsSource="{Binding USBsList}"
                                                    SelectedItem="{Binding PC1USB_Selected, Mode=TwoWay}"
                                                    DisplayMemberPath="inputDisplayText" MinWidth="133" MinHeight="80"
                                                    Background="{DynamicResource DefaultTheme_USBKVMComboBkColor}"
                                                    BorderBrush="{DynamicResource DefaultTheme_USBKVMComboBdColor}" BorderThickness="1.5"
                                                    IsEnabled="{Binding PC1USB_Enable}" Opacity="{Binding PC1USB_Opacity}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Margin="0, 0, 8, 0" Background="{DynamicResource DefaultTheme_USBKVMPCGridBkColor}" CornerRadius="13"
                                BorderBrush="{DynamicResource DefaultTheme_USBKVMComboBdColor}" BorderThickness="2">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="16, 16, 16, 0">
                                    <UXControls:UXTextBlock Text="{Binding [Kvm.0], Source={x:Static lang:LangHelper.Instance},StringFormat={}{0}2}"
                                                        Foreground="{DynamicResource DefaultTheme_USBKVMPCColor}"
                                                        FontSize="16" LineHeight="24"
                                                        HorizontalAlignment="Center" />
                                </Grid>
                                <Grid Grid.Row="1" Margin="16, 2, 16, 8">
                                    <UXControls:UXTextBox Text="{Binding InputName2}"
                                                      BorderBrush="#7E7E7E" BorderThickness="1" VerticalContentAlignment="Center" MaxLength="30"
                                                      PreviewTextInput="UXTextBox_PreviewTextInput"
                                                      TextChanged="UXTextBox_TextChanged2"/>
                                </Grid>
                                <Grid Grid.Row="2"  Margin="16, 8, 16, 0">
                                    <StackPanel x:Name="Ports_StackPanel_1">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Orientation" Value="Horizontal" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMoreThanPC2}" Value="True">
                                                        <Setter Property="Orientation" Value="Vertical" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <StackPanel>
                                            <UXControls:UXTextBlock Text="{Binding [Video], Source={x:Static lang:LangHelper.Instance}}"
                                                        Foreground="{DynamicResource DefaultTheme_USBKVMPCColor}"
                                                        FontSize="16" LineHeight="24"
                                                        HorizontalAlignment="Center" />
                                            <ComboBox AutomationProperties.Name="SelectedCheck" Style="{StaticResource DdpmUSBKVMComboBoxStyle}"
                                                HorizontalAlignment="Center" VerticalAlignment="Top"
                                                ItemsSource="{Binding PC2InputsList}" 
                                                SelectedItem="{Binding PC2Inputs_Selected, Mode=TwoWay}"
                                                DisplayMemberPath="inputDisplayText" MinWidth="133" MinHeight="80"
                                                Background="{DynamicResource DefaultTheme_USBKVMComboBkColor}"
                                                BorderBrush="{DynamicResource DefaultTheme_USBKVMComboBdColor}" BorderThickness="1.5" />
                                        </StackPanel>
                                        <StackPanel x:Name="SecondPort_StackPanel_1">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Margin" Value="8, 0, 0, 0" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMoreThanPC2}" Value="True">
                                                            <Setter Property="Margin" Value="0, 16, 0, 0" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <UXControls:UXTextBlock Text="{Binding [USB], Source={x:Static lang:LangHelper.Instance}}"
                                                        Foreground="{DynamicResource DefaultTheme_USBKVMPCColor}"
                                                        FontSize="16" LineHeight="24"
                                                        HorizontalAlignment="Center" />
                                            <ComboBox AutomationProperties.Name="SelectedCheck" Style="{StaticResource DdpmUSBKVMComboBoxStyle}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  ItemsSource="{Binding USBsList}" 
                                                  SelectedItem="{Binding PC2USB_Selected, Mode=TwoWay}"
                                                  DisplayMemberPath="inputDisplayText" MinWidth="133" MinHeight="80"
                                                  Background="{DynamicResource DefaultTheme_USBKVMComboBkColor}"
                                                  BorderBrush="{DynamicResource DefaultTheme_USBKVMComboBdColor}" BorderThickness="1.5"
                                                  IsEnabled="{Binding PC2USB_Enable}" Opacity="{Binding PC2USB_Opacity}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Background="{DynamicResource DefaultTheme_USBKVMPCGridBkColor}" Margin="0, 0, 8, 0" CornerRadius="13"
                                BorderBrush="{DynamicResource DefaultTheme_USBKVMComboBdColor}" BorderThickness="2" Visibility="{Binding PC3_Visibility}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="16, 16, 16, 0">
                                    <UXControls:UXTextBlock Text="{Binding [Kvm.0], Source={x:Static lang:LangHelper.Instance},StringFormat={}{0}3}"
                                                            Foreground="{DynamicResource DefaultTheme_USBKVMPCColor}"
                                                            FontSize="16" LineHeight="24"
                                                            HorizontalAlignment="Center" />
                                </Grid>
                                <Grid Grid.Row="1" Margin="16, 2, 16, 8">
                                    <UXControls:UXTextBox Text="{Binding InputName3}"
                                                          BorderBrush="#7E7E7E" BorderThickness="1" VerticalContentAlignment="Center" MaxLength="30"
                                                          PreviewTextInput="UXTextBox_PreviewTextInput"
                                                          TextChanged="UXTextBox_TextChanged3"/>
                                </Grid>
                                <Grid Grid.Row="2" Margin="16, 8, 16, 0">
                                    <UXControls:UXTextBlock Text="{Binding [Video], Source={x:Static lang:LangHelper.Instance}}"
                                                            Foreground="{DynamicResource DefaultTheme_USBKVMPCColor}"
                                                            FontSize="16" LineHeight="24"
                                                            HorizontalAlignment="Center" />
                                </Grid>
                                <Grid Grid.Row="3" Margin="16, 2, 16, 8">
                                    <ComboBox AutomationProperties.Name="SelectedCheck" Style="{StaticResource DdpmUSBKVMComboBoxStyle}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              ItemsSource="{Binding PC3InputsList}"
                                              SelectedItem="{Binding PC3Inputs_Selected, Mode=TwoWay}"
                                              DisplayMemberPath="inputDisplayText" MinWidth="133" MinHeight="80"
                                              Background="{DynamicResource DefaultTheme_USBKVMComboBkColor}"
                                              BorderBrush="{DynamicResource DefaultTheme_USBKVMComboBdColor}" BorderThickness="1.5" />
                                </Grid>
                                <Grid Grid.Row="4" Margin="16, 8, 16, 0">
                                    <UXControls:UXTextBlock Text="{Binding [USB], Source={x:Static lang:LangHelper.Instance}}"
                                                            Foreground="{DynamicResource DefaultTheme_USBKVMPCColor}"
                                                            FontSize="16"
                                                            HorizontalAlignment="Center" />
                                </Grid>
                                <Grid Grid.Row="5" Margin="16, 2, 16, 16">
                                    <ComboBox AutomationProperties.Name="SelectedCheck" Style="{StaticResource DdpmUSBKVMComboBoxStyle}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              ItemsSource="{Binding USBsList}" Width="103"
                                              SelectedItem="{Binding PC3USB_Selected, Mode=TwoWay}"
                                              DisplayMemberPath="inputDisplayText" MinWidth="133" MinHeight="80"
                                              Background="{DynamicResource DefaultTheme_USBKVMComboBkColor}"
                                              BorderBrush="{DynamicResource DefaultTheme_USBKVMComboBdColor}" BorderThickness="1.5"
                                              IsEnabled="{Binding PC3USB_Enable}" Opacity="{Binding PC3USB_Opacity}"/>
                                </Grid>
                            </Grid>
                        </Border>
                        <Border Grid.Column="3" Background="{DynamicResource DefaultTheme_USBKVMPCGridBkColor}" CornerRadius="13"
                                BorderBrush="{DynamicResource DefaultTheme_USBKVMComboBdColor}" BorderThickness="2" Visibility="{Binding PC4_Visibility}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="16, 16, 16, 0">
                                    <UXControls:UXTextBlock Text="{Binding [Kvm.0], Source={x:Static lang:LangHelper.Instance},StringFormat={}{0}4}"
                                                            Foreground="{DynamicResource DefaultTheme_USBKVMPCColor}"
                                                            FontSize="16" LineHeight="24"
                                                            HorizontalAlignment="Center" />
                                </Grid>
                                <Grid Grid.Row="1" Margin="16, 2, 16, 8">
                                    <UXControls:UXTextBox Text="{Binding InputName4}"
                                                          BorderBrush="#7E7E7E" BorderThickness="1" MaxLength="30"
                                                          PreviewTextInput="UXTextBox_PreviewTextInput"
                                                          TextChanged="UXTextBox_TextChanged4"/>
                                </Grid>
                                <Grid Grid.Row="2" Margin="16, 8, 16, 0">
                                    <UXControls:UXTextBlock Text="{Binding [Video], Source={x:Static lang:LangHelper.Instance}}"
                                                            Foreground="{DynamicResource DefaultTheme_USBKVMPCColor}"
                                                            FontSize="16" LineHeight="24"
                                                            HorizontalAlignment="Center" />
                                </Grid>
                                <Grid Grid.Row="3" Margin="16, 2, 16, 8">
                                    <ComboBox AutomationProperties.Name="SelectedCheck" Style="{StaticResource DdpmUSBKVMComboBoxStyle}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              ItemsSource="{Binding PC4InputsList}"
                                              SelectedItem="{Binding PC4Inputs_Selected, Mode=TwoWay}"
                                              DisplayMemberPath="inputDisplayText" MinWidth="133" MinHeight="80"
                                              Background="{DynamicResource DefaultTheme_USBKVMComboBkColor}"
                                              BorderBrush="{DynamicResource DefaultTheme_USBKVMComboBdColor}" BorderThickness="1.5" />
                                </Grid>
                                <Grid Grid.Row="4" Margin="16, 8, 16, 0">
                                    <UXControls:UXTextBlock Text="{Binding [USB], Source={x:Static lang:LangHelper.Instance}}"
                                                            Foreground="{DynamicResource DefaultTheme_USBKVMPCColor}"
                                                            FontSize="16" LineHeight="24"
                                                            HorizontalAlignment="Center" />
                                </Grid>
                                <Grid Grid.Row="5" Margin="16, 2, 16, 16">
                                    <ComboBox AutomationProperties.Name="SelectedCheck" Style="{StaticResource DdpmUSBKVMComboBoxStyle}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    ItemsSource="{Binding USBsList}" Width="103"
                                    SelectedItem="{Binding PC4USB_Selected, Mode=TwoWay}"
                                    DisplayMemberPath="inputDisplayText" MinWidth="133" MinHeight="80" 
                                    Background="{DynamicResource DefaultTheme_USBKVMComboBkColor}"
                                    BorderBrush="{DynamicResource DefaultTheme_USBKVMComboBdColor}" BorderThickness="1.5"
                                    IsEnabled="{Binding PC4USB_Enable}" Opacity="{Binding PC4USB_Opacity}"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                    <Grid Grid.Row="1" HorizontalAlignment="Center">
                        <!--<Image Source="pack://application:,,,/DDPM.UI.Common;component/Resources/USBKVM_4PCs.png" />-->
                        <Image Source="{Binding PCImage}" Stretch="Uniform" />
                    </Grid>
                </Grid>
            </Grid>
        </StackPanel>
        <!--<StackPanel>
        <TextBlock Text="This is Test1 FullView" FontSize="24" Foreground="Cyan" />
        <StackPanel Orientation="Horizontal">
        <TextBlock Text="Test1Value=" />
        <TextBox Text="{Binding Test1Value}" Width="100" />
        <TextBlock Text="Test2Value=" Margin="20,0,0,0" />
        <TextBox Text="{Binding Test2Value}" Width="100" />
        </StackPanel>
        <Button Content="Go to next page" Command="{Binding GotoNextCommand}" />
        <Button Content="Close FullView" Command="{Binding CloseFullViewCommand}" />
        </StackPanel>-->
    </Grid>
</UserControl>
