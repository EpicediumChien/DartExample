<UserControl x:Class="DDPM.UI.Module.WebCameraColorImage.WebCameraColorImageRightView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             xmlns:plugin="clr-namespace:DDPM.UI.Plugin.ViewModels;assembly=DDPM.UI.Plugin.Common"
             xmlns:PluginCommon="clr-namespace:DDPM.UI.Plugin.Common;assembly=DDPM.UI.Plugin.Common"
             d:DataContext="{d:DesignInstance Type=plugin:WebCameraViewModel}"
             xmlns:common="clr-namespace:DDPM.UI.Common;assembly=DDPM.UI.Common"
             xmlns:lang="clr-namespace:DDPM.UI.Resources.Helper;assembly=DDPM.UI.Resources"
             mc:Ignorable="d"
             d:DesignHeight="675" d:DesignWidth="554" VerticalAlignment="Top" HorizontalAlignment="Left">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/DDPM.UI.Common;component/PluginStyles.xaml" />
        <!--<ResourceDictionary Source="/DDPM.UI.Common;component/MOduleStyle.xaml" />-->
      </ResourceDictionary.MergedDictionaries>
      <PluginCommon:BooleanToInverseConverter x:Key="BooleanToInverseConverter" />
      <PluginCommon:ThicknessConverter x:Key="MarginConverter" />
      <PluginCommon:HeightConverter x:Key="HeightConverter" />
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid Margin="0,0,0,15">
    <Border Background="#99132F54" CornerRadius="13" Margin="0,10,0,0" Width="470">
      <Border.Height>
        <MultiBinding Converter="{StaticResource HeightConverter}">
          <Binding Path="Height" RelativeSource="{RelativeSource AncestorType=Grid}" />
        </MultiBinding>
      </Border.Height>
      <StackPanel Margin="16,16,2,0" Orientation="Vertical">
        <UXControls:UXTextBlock Text="{Binding [Camera.1], Source={x:Static lang:LangHelper.Instance}}" Margin="0,10,0,6" Style="{StaticResource ModuleCaptionStyle}" />
        <DockPanel Margin="0,16,0,4000">
          <DockPanel.Height>
            <MultiBinding Converter="{StaticResource HeightConverter}" ConverterParameter="85">
              <Binding Path="ActualHeight" RelativeSource="{RelativeSource AncestorType=Border, AncestorLevel=1}" />
            </MultiBinding>
          </DockPanel.Height>
          <UXControls:UXScrollViewer>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
              </Grid.RowDefinitions>
              <Grid Grid.Row="0" Margin="0,0,0,10" Visibility="{Binding HDRVisibility}">
                <Border Background="#99132F54" CornerRadius="6">
                  <Grid Margin="16,0,16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,25">
                      <UXControls:UXTextBlock Text="{Binding [WebCameraColorImage.0], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource ModuleItemStyle}" />
                      <Image Margin="9,0,0,0" Source="/DDPM.UI.Common;component/Resources/info.png" Stretch="Uniform" Cursor="Hand" Width="16" Height="16">
                        <Image.ToolTip>
                          <ToolTip Style="{StaticResource InfoToolTipStyle}" Placement="Top" VerticalOffset="8" HorizontalOffset="6">
                            <TextBlock Text="{Binding [WebCameraColorImage.1], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource TabInfoToolTipTextStyle}" MaxWidth="350" TextWrapping="Wrap" />
                          </ToolTip>
                        </Image.ToolTip>
                      </Image>
                      <Image Visibility="{Binding LockMaskVisible}" 
                             Source="pack://application:,,,/DDPM.UI.Common;component/Resources/Lock.png"
                             VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5,0,0,0" Width="16" Height="16">
                        <Image.ToolTip>
                          <ToolTip>
                            <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                              <Border.Resources>
                                <Style BasedOn="{StaticResource Tooltip_TextBlockStyle}" TargetType="TextBlock" />
                              </Border.Resources>
                              <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                  <TextBlock Text="{Binding [ITLockToolTip.0], Source={x:Static lang:LangHelper.Instance}}" />
                                </StackPanel>
                              </StackPanel>
                            </Border>
                          </ToolTip>
                        </Image.ToolTip>
                      </Image>
                    </StackPanel>
                    <UXControls:UXToggleSwitch IsChecked="{Binding Path= IsHDROn}" Content="{Binding Path=IsHDROnText}" HorizontalAlignment="Right" VerticalAlignment="Center"  Foreground="White" IsTabStop="{Binding IsTabStoppable}" FontFamily="Roboto" FontSize="16"/>
                  </Grid>
                </Border>
                <Border Background="#132F5499" Opacity="0.6" Visibility="{Binding LockMaskVisible}"/>
              </Grid>
              <Grid Grid.Row="1" Margin="0,0,0,10" Visibility="{Binding AutoWhiteBalanceVisibility}">
                <Border Background="#99132F54" CornerRadius="6">
                  <StackPanel Margin="18,25,16,14">
                    <Grid>
                      <UXControls:UXTextBlock Text="{Binding [WebCameraColorImage.2], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource ModuleItemStyle}" />
                      <UXControls:UXToggleSwitch Name="AWB_ToggleSwitch" IsChecked="{Binding Path= IsAutoWhiteBalanceOn}" Content="{Binding Path=IsAutoWhiteBalanceOnText}" HorizontalAlignment="Right" VerticalAlignment="Center"  Foreground="White" FontFamily="Roboto" FontSize="16" />
                    </Grid>
                    <UXControls:UXSlider Name="AWBSlider" Margin="0,15,0,0" Height="14" AutoToolTipPlacement="None" Thumb.DragStarted="AWBSlider_DragStarted" Thumb.DragCompleted="AWBSlider_DragCompleted"
                                         Value="{Binding AutoWhiteBalance}" IsMoveToPointEnabled="True" IsSnapToTickEnabled="True" IsEnabled="{Binding IsAutoWhiteBalanceOn, Converter={StaticResource BooleanToInverseConverter}}"/>
                  </StackPanel>
                </Border>
              </Grid>
              <Grid Name="BSCS" Grid.Row="2" Margin="0,0,0,10" Visibility="Collapsed">
                <Border Background="#99132F54" CornerRadius="6">
                  <StackPanel Orientation="Vertical" Margin="18,8,16,14">
                    <StackPanel x:Name="spBrightness" Orientation="Vertical" Margin="0,18,0,0" Visibility="Collapsed">
                      <UXControls:UXTextBlock Text="{Binding [WebCameraColorImage.3], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource ModuleItemStyle}" />
                      <UXControls:UXSlider Name="BrightnessSlider" Margin="0,15,0,9" Thumb.DragStarted="BrightnessSlider_DragStarted" Thumb.DragCompleted="BrightnessSlider_DragCompleted"
                                           IsMoveToPointEnabled="True" IsSnapToTickEnabled="True" Value="{Binding Path=Brightness}"/>
                    </StackPanel>
                    <StackPanel x:Name="spSharpness" Orientation="Vertical" Margin="0,18,0,0" Visibility="Collapsed">
                      <UXControls:UXTextBlock Text="{Binding [WebCameraColorImage.4], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource ModuleItemStyle}" />
                      <UXControls:UXSlider Name="SharpnessSlider" Margin="0,15,0,9" Thumb.DragStarted="SharpnessSlider_DragStarted" Thumb.DragCompleted="SharpnessSlider_DragCompleted"
                                           IsMoveToPointEnabled="True" IsSnapToTickEnabled="True" Value="{Binding Sharpness}" />
                    </StackPanel>
                    <StackPanel x:Name="spContrast" Orientation="Vertical" Margin="0,18,0,0" Visibility="Collapsed">
                      <UXControls:UXTextBlock Text="{Binding [WebCameraColorImage.5], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource ModuleItemStyle}" />
                      <UXControls:UXSlider Name="ContrastSlider" Margin="0,15,0,9" Thumb.DragStarted="ContrastSlider_DragStarted" Thumb.DragCompleted="ContrastSlider_DragCompleted"
                                           IsMoveToPointEnabled="True" IsSnapToTickEnabled="True" Value="{Binding Contrast}"/>
                    </StackPanel>
                    <StackPanel x:Name="spSaturation" Orientation="Vertical" Margin="0,18,0,0" Visibility="Collapsed">
                      <UXControls:UXTextBlock Text="{Binding [WebCameraColorImage.6], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource ModuleItemStyle}" />
                      <UXControls:UXSlider Name="SaturationSlider" Margin="0,15,0,0" Thumb.DragStarted="SaturationSlider_DragStarted" Thumb.DragCompleted="SaturationSlider_DragCompleted"
                                           IsMoveToPointEnabled="True" IsSnapToTickEnabled="True" Value="{Binding Saturation}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </Grid>
              <Grid Grid.Row="3" Margin="0,0,0,0">
                <Border Background="#99132F54" CornerRadius="6" VerticalAlignment="Top">
                  <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Vertical" Margin="18,21,16,21">
                      <StackPanel Orientation="Horizontal">
                        <UXControls:UXTextBlock Text="{Binding [WebCameraColorImage.7], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource ModuleItemStyle}" />
                        <Image Margin="9,0,0,0" Source="/DDPM.UI.Common;component/Resources/info.png" Stretch="Uniform" Cursor="Hand" Width="16" Height="16">
                          <Image.ToolTip>
                            <ToolTip Style="{StaticResource InfoToolTipStyle}" Placement="Top" VerticalOffset="8" HorizontalOffset="6">
                              <TextBlock Text="{Binding [WebCameraColorImage.8], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource TabInfoToolTipTextStyle}" MaxWidth="350" TextWrapping="Wrap"/>
                            </ToolTip>
                          </Image.ToolTip>
                        </Image>

                        <Image Visibility="{Binding LockMaskVisible}" 
                                                Source="pack://application:,,,/DDPM.UI.Common;component/Resources/Lock.png"
                                                VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5,0,0,0" Width="16" Height="16">
                          <Image.ToolTip>
                            <ToolTip>
                              <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                <Border.Resources>
                                  <Style BasedOn="{StaticResource Tooltip_TextBlockStyle}" TargetType="TextBlock" />
                                </Border.Resources>
                                <StackPanel>
                                  <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding [ITLockToolTip.0], Source={x:Static lang:LangHelper.Instance}}" />
                                  </StackPanel>
                                </StackPanel>
                              </Border>
                            </ToolTip>
                          </Image.ToolTip>
                        </Image>

                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Border x:Name="btnAntiFlicker0" CornerRadius="5,0,0,5" MouseLeftButtonDown="AntiFlicker_Click" Height="30" Width="201" Tag="1" >
                          <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Border_Test}">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding AntiFlicker}"  Value="1">
                                  <Setter Property="Background"  Value="{StaticResource VbarItem_HiBkColor}" />
                                  <Setter Property="BorderBrush" Value="{StaticResource VbarItem_HiBdColor}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding AntiFlicker}"  Value="2">
                                  <Setter Property="Cursor" Value="Hand" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                          <UXControls:UXTextBlock Text="{Binding [WebCameraColorImage.9], Source={x:Static lang:LangHelper.Instance},StringFormat={}50{0}}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontFamily="Roboto" />
                        </Border>
                        <Border x:Name="btnAntiFlicker1" CornerRadius="0,5,5,0" MouseLeftButtonDown="AntiFlicker_Click" Height="30" Width="201" Tag="2">
                          <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Border_Test}">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding AntiFlicker}"  Value="2">
                                  <Setter Property="Background"  Value="{StaticResource VbarItem_HiBkColor}" />
                                  <Setter Property="BorderBrush" Value="{StaticResource VbarItem_HiBdColor}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding AntiFlicker}"  Value="1">
                                  <Setter Property="Cursor" Value="Hand" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                          <UXControls:UXTextBlock Text="{Binding [WebCameraColorImage.9], Source={x:Static lang:LangHelper.Instance},StringFormat={}60{0}}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontFamily="Roboto" />
                        </Border>
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>
                </Border>
                <Border Background="#132F5499" Opacity="0.6" Visibility="{Binding LockMaskVisible}"/>
              </Grid>

            </Grid>
          </UXControls:UXScrollViewer>
        </DockPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>