<UserControl x:Class="DDPM.UI.Module.AddKnM_Wired.AddKnM_WiredRightView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DDPM.UI.Module.AddKnM_Wired"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             xmlns:lang="clr-namespace:DDPM.UI.Resources.Helper;assembly=DDPM.UI.Resources"
             mc:Ignorable="d"
             d:DesignHeight="527" d:DesignWidth="958">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <Style x:Key="TextStyle1" TargetType="UXControls:UXTextBlock">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontFamily" Value="Roboto" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="LineHeight" Value="24" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>
            <Style x:Key="Border1" TargetType="Border">
                <Setter Property="Background" Value="#99132F54" />
                <Setter Property="CornerRadius" Value="13" />
                <Setter Property="Width" Value="926" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="BorderBrush" Value="#132F54" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <StackPanel Orientation="Vertical">
            <UXControls:UXTextBlock Name="txtCaption" FontFamily="Roboto" FontSize="20" FontWeight="Normal"
                                    Margin="18,14,0,0" Foreground="White"
                                    VerticalAlignment="Top" HorizontalAlignment="Left" Text="{Binding [WiredConnection], Source={x:Static lang:LangHelper.Instance}}"/>
            <Border Style="{StaticResource Border1}" Margin="16,23,16,0" Width="Auto">
                <Grid>
                    <StackPanel Orientation="Vertical" Margin="0,0,0,13">
                        <Image Margin="14,14" Source="/DDPM.UI.Resources;component/Resources/Images/WiredConnection.png" Stretch="Uniform"
                               HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="" Width="46" Height="46" />
                        <UXControls:UXTextBlock Name="txtStep1" Margin="15,10,10,10" Style="{StaticResource TextStyle1}" 
                                                Text="{Binding [AddDevice.KnM.13], Source={x:Static lang:LangHelper.Instance}}"
                                                TextWrapping="WrapWithOverflow"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>