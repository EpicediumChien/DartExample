<UserControl x:Class="DDPM.UI.Module.WebCameraMicrophone.WebCameraMicrophoneRightView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DDPM.UI.Module.WebCameraMicrophone"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             xmlns:plugin="clr-namespace:DDPM.UI.Plugin.ViewModels;assembly=DDPM.UI.Plugin.Common"
             xmlns:PluginCommon="clr-namespace:DDPM.UI.Plugin.Common;assembly=DDPM.UI.Plugin.Common"
             d:DataContext="{d:DesignInstance Type=plugin:WebCameraViewModel}"
             xmlns:common="clr-namespace:DDPM.UI.Common;assembly=DDPM.UI.Common"
             xmlns:lang="clr-namespace:DDPM.UI.Resources.Helper;assembly=DDPM.UI.Resources"
             mc:Ignorable="d"
             d:DesignHeight="647"
             Cursor="{Binding CurrentCursor}"
             >
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/DDPM.UI.Common;component/PluginStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <!--<PluginCommon:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />-->
      <PluginCommon:ThicknessConverter x:Key="MarginConverter" />
      <PluginCommon:HeightConverter x:Key="HeightConverter" />
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid Margin="0,0,0,15">
    <Border Name="ParentBorder" Background="#99132F54" CornerRadius="13" Margin="0,10,0,0" Width="470">
      <Border.Height>
        <MultiBinding Converter="{StaticResource HeightConverter}">
          <Binding Path="Height" RelativeSource="{RelativeSource AncestorType=Grid}" />
        </MultiBinding>
      </Border.Height>
      <StackPanel Orientation="Vertical" Margin="16,16,2,0" IsEnabled="{Binding IsNotAddingProfile}">
        <Grid>
          <UXControls:UXTextBlock Margin="0,10,0,6" Text="{Binding [WebCameraMicrophone.0], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource ModuleCaptionStyle}" />
          <Image Margin="0,0,67,0" Source="/DDPM.UI.Resources;component/Resources/Images/Undo2.png" Stretch="Fill"  
                 HorizontalAlignment="Right" Width="40" Height="40" Visibility="{Binding Undo2Visibility}"/>
          <Image Margin="0,0,17,0" Source="/DDPM.UI.Resources;component/Resources/Images/Redo2.png" Stretch="Fill"  
                 HorizontalAlignment="Right" Width="40" Height="40" Visibility="{Binding Redo2Visibility}"/>
          <Image Margin="0,0,67,0" Source="/DDPM.UI.Resources;component/Resources/Images/Undo.png" Stretch="Fill" MouseLeftButtonDown="Image_MouseLeftButtonDown" Tag="0"
                 HorizontalAlignment="Right" Width="40" Height="40" Visibility="{Binding UndoVisibility}" Cursor="Hand"/>
          <Image Margin="0,0,17,0" Source="/DDPM.UI.Resources;component/Resources/Images/Redo.png" Stretch="Fill" MouseLeftButtonDown="Image_MouseLeftButtonDown" Tag="1"
                 HorizontalAlignment="Right" Width="40" Height="40" Visibility="{Binding RedoVisibility}" Cursor="Hand"/>
        </Grid>
        <Border Background="#99132F54" CornerRadius="6" Height="72" Margin="0,20,16,5000">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="200" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
              <StackPanel Orientation="Horizontal">
                <UXControls:UXTextBlock Text="{Binding [WebCameraMicrophone.1], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource ModuleItemStyle}" VerticalAlignment="Center" Margin="15,0,0,0" />
                <Image Margin="9,0,0,0" Source="/DDPM.UI.Common;component/Resources/info.png" Stretch="Uniform" Cursor="Hand" Width="16" Height="16">
                  <Image.ToolTip>
                    <ToolTip Style="{StaticResource InfoToolTipStyle}" Placement="Top" VerticalOffset="8" HorizontalOffset="6">
                      <TextBlock Text="{Binding [WebCameraMicrophone.2], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource TabInfoToolTipTextStyle}" TextWrapping="Wrap" Width="345" />
                    </ToolTip>
                  </Image.ToolTip>
                </Image>

                <Image  Visibility="{Binding LockMaskVisible}" 
                    Source="pack://application:,,,/DDPM.UI.Common;component/Resources/Lock.png"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5,0,0,0" Width="16" Height="16">
                  <Image.ToolTip>
                    <ToolTip>
                      <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                        <Border.Resources>
                          <Style BasedOn="{StaticResource Tooltip_TextBlockStyle}" TargetType="TextBlock" />
                        </Border.Resources>
                        <StackPanel>
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding [ITLockToolTip.0], Source={x:Static lang:LangHelper.Instance}}" />
                          </StackPanel>
                        </StackPanel>
                      </Border>
                    </ToolTip>
                  </Image.ToolTip>
                </Image>

              </StackPanel>
            </Grid>
            <Grid Grid.Column="1">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0" VerticalAlignment="Center">
                <Image Margin="0,0,10,0" Source="/DDPM.UI.Common;component/Resources/Warring.png" Stretch="Uniform" Cursor="Hand" Width="16" Height="16" VerticalAlignment="Top">
                  <Image.ToolTip>
                    <ToolTip Style="{StaticResource InfoToolTipStyle}" Placement="Left" VerticalOffset="0" HorizontalOffset="0">
                      <TextBlock Text="{Binding [WebCameraMicrophone.3], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource TabInfoToolTipTextStyle}" TextWrapping="Wrap" Width="345" />
                    </ToolTip>
                  </Image.ToolTip>
                </Image>
                <UXControls:UXToggleSwitch Name="tsMicOn" Click="UXToggleSwitch_Click" IsChecked="{Binding Path= IsMicEnumerationOn}" Content="{Binding Path=IsMicEnumerationOnText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           IsEnabled="{Binding IsMicEnumerationOnEnabled}" Margin="0,0,16,0" IsTabStop="{Binding isTabStoppable}" />
              </StackPanel>
            </Grid>
          </Grid>
        </Border>
        <Border Background="#132F5499" Opacity="0.6"  Visibility="{Binding LockMaskVisible}"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>