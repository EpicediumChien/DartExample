                                   <Image.ToolTip>
                                       <ToolTip Placement="Right" VerticalOffset="-85" HorizontalOffset="-15">
                                           <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                               <Border.Resources>
                                                   <Style BasedOn="{StaticResource Tooltip_TextBlockStyle}" TargetType="TextBlock" />
                                               </Border.Resources>
                                               <StackPanel Orientation="Horizontal">
                                                   <TextBlock Text="{Binding [WebCameraMicrophone.2], Source={x:Static lang:LangHelper.Instance}}" TextWrapping="Wrap" Width="345" />
                                               </StackPanel>
                                           </Border>
                                       </ToolTip>
                                   </Image.ToolTip>
                               </Image>
