                                                   <TextBlock Text="{Binding [WebCameraMicrophone.3], Source={x:Static lang:LangHelper.Instance}}" TextWrapping="Wrap" Width="345" />
                                               </StackPanel>
                                           </Border>
                                       </ToolTip>
                                   </Border.ToolTip>
                               </Border>
                               <Border  Visibility="{Binding LockMaskVisible}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5,0,0,0" 
                                        Width="16" Height="16">
                                   <ContentControl Template="{StaticResource icon_Lock}" Foreground="{DynamicResource DefaultTheme_PathColor}" Width="16" Height="16"/>
                                   <Border.ToolTip>
                                       <ToolTip Placement="MousePoint" VerticalOffset="-50" HorizontalOffset="-5">
                                           <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                               <Border.Resources>
                                                   <Style BasedOn="{StaticResource Tooltip_TextBlockStyle}" TargetType="TextBlock" />
