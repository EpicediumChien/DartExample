          <!-- Robert_Lin 2025-1-15 PIMS-333711 it-IT: Clipping found in stringID: WebCameraMicrophone.1 
                           Grid change to 5 columns:
                           Col0: (Auto) TextBlock Wrap, Max 2 lines
                           Col1: (Auto) info_Icon
                           Col2: (Auto) lock Icon
                           Col3: (*) reserved space
                           Col4: (Auto) Warning icon
                           Col5: (Auto) ToggleSwitch
                   
                           -->

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" HorizontalAlignment="Left">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <!-- #region Text "Camera Microphone" 
                               Text="{Binding [WebCameraMicrophone.1], Source={x:Static lang:LangHelper.Instance}}" 
                               FontFamily="Roboto" FontSize="16"
                       
                                            MaxHeight="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource MaxHeightConverter}, ConverterParameter='16,2'}"
                               Test Text:
                                                    Text="{Binding [WebCameraMicrophone.1], Source={x:Static lang:LangHelper.Instance}}" 
                                           Text="Lorem ipsum dolor sit amet consectetur. Fermentum cras imperdiet duis varius facilisi nulla. Volutpat accumsan massa at" 
                                           Text="Lorem ipsum dolor sit amet consecte" 
                              -->
              <UXControls:UXTextBlock Grid.Column="0" 
                                                    Style="{StaticResource ModuleItemStyle}" Margin="15,0,0,0"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center" 
                                                    Text="{Binding [WebCameraMicrophone.1], Source={x:Static lang:LangHelper.Instance}}" 
                                                    MaxHeight="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource MaxHeightConverter}, ConverterParameter='16,2'}"
                                                    TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>

              <!-- #endregion Text "Camera Microphone" -->

              <!-- #region info Icon -->
              <Border Grid.Column="1" Background="{StaticResource FakeTransparent}" Margin="8,0,0,0"
                               HorizontalAlignment="Left">
                <ContentControl Template="{StaticResource icon_Info}" Width="16" Height="16"/>
                <Border.ToolTip>
                  <ToolTip Placement="Right" VerticalOffset="-40" HorizontalOffset="-15">
                    <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                      <Border.Resources>
                        <Style BasedOn="{StaticResource Tooltip_TextBlockStyle}" TargetType="TextBlock" />
                      </Border.Resources>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding [WebCameraMicrophone.3], Source={x:Static lang:LangHelper.Instance}}" TextWrapping="Wrap" Width="345" />
                      </StackPanel>
                    </Border>
                  </ToolTip>
                </Border.ToolTip>
              </Border>
              <!-- #region info Icon -->

              <!-- #region Lock Icon -->
              <Border Grid.Column="2"  Visibility="{Binding LockMaskVisible}" VerticalAlignment="Center" Margin="4,0,0,0" 
                                   Width="16" Height="16">
                <ContentControl Template="{StaticResource icon_Lock}" Foreground="{DynamicResource DefaultTheme_PathColor}" Width="16" Height="16"/>
                <Border.ToolTip>
                  <ToolTip Placement="MousePoint" VerticalOffset="-50" HorizontalOffset="-5">
                    <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                      <Border.Resources>
                        <Style BasedOn="{StaticResource Tooltip_TextBlockStyle}" TargetType="TextBlock" />
                      </Border.Resources>
                      <StackPanel>
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding [ITLockToolTip.0], Source={x:Static lang:LangHelper.Instance}}" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </ToolTip>
                </Border.ToolTip>
              </Border>
              <!-- #endregion Lock Icon -->

            </Grid>

            <!-- #region Wraning Icon -->
            <Image Grid.Column="1" Name="imgWarn" Margin="0,0,10,0" Source="/DDPM.UI.Common;component/Resources/Warring.png" Stretch="Uniform" Width="16" Height="16" VerticalAlignment="Center">
              <Image.ToolTip>
                <ToolTip Placement="Right" VerticalOffset="-85" HorizontalOffset="15">
                  <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                    <Border.Resources>
                      <Style BasedOn="{StaticResource Tooltip_TextBlockStyle}" TargetType="TextBlock" />
                    </Border.Resources>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding [WebCameraMicrophone.2], Source={x:Static lang:LangHelper.Instance}}" TextWrapping="Wrap" Width="345" />
                    </StackPanel>
                  </Border>
                </ToolTip>
              </Image.ToolTip>
            </Image>
            <!-- #endregion Wraning Icon -->
            <Grid Grid.Column="2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>


              <!-- #region ToggleSwitch -->
              <UXControls:UXToggleSwitch Grid.Column="5" Name="tsMicOn" Click="UXToggleSwitch_Click" IsChecked="{Binding Path= IsMicEnumerationOn}" Content="{Binding Path=IsMicEnumerationOnText}" 
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                        IsEnabled="{Binding IsMicEnumerationOnEnabled}" Margin="0,0,16,0" IsTabStop="{Binding isTabStoppable}" />
              <!-- #endregion ToggleSwitch -->


            </Grid>
          </Grid>
        </Border>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>