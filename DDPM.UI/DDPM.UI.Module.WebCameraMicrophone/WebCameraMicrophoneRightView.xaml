<UserControl x:Class="DDPM.UI.Module.WebCameraMicrophone.WebCameraMicrophoneRightView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DDPM.UI.Module.WebCameraMicrophone"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             xmlns:plugin="clr-namespace:DDPM.UI.Plugin.ViewModels;assembly=DDPM.UI.Plugin.Common"
             xmlns:PluginCommon="clr-namespace:DDPM.UI.Plugin.Common;assembly=DDPM.UI.Plugin.Common"
             d:DataContext="{d:DesignInstance Type=plugin:WebCameraViewModel}"
             xmlns:common="clr-namespace:DDPM.UI.Common;assembly=DDPM.UI.Common"
             xmlns:lang="clr-namespace:DDPM.UI.Resources.Helper;assembly=DDPM.UI.Resources"
             mc:Ignorable="d"
             d:DesignHeight="647"
             VerticalAlignment="Top" HorizontalAlignment="Left">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/DDPM.UI.Common;component/PluginStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <!--<PluginCommon:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />-->
      <PluginCommon:ThicknessConverter x:Key="MarginConverter" />
      <PluginCommon:HeightConverter x:Key="HeightConverter" />
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid Margin="0,0,0,15">
    <Border Name="ParentBorder" Background="#99132F54" CornerRadius="13" Margin="0,10,0,0" Width="470">
      <Border.Height>
        <MultiBinding Converter="{StaticResource HeightConverter}">
          <Binding Path="Height" RelativeSource="{RelativeSource AncestorType=Grid}" />
        </MultiBinding>
      </Border.Height>
      <StackPanel Orientation="Vertical" Margin="16,16,16,0">
        <StackPanel Margin="0">
          <UXControls:UXTextBlock Text="{Binding [WebCameraMicrophone.0], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource ModuleCaptionStyle}"
                                  Margin="0,10,0,0"  VerticalAlignment="Top" HorizontalAlignment="Left" />
        </StackPanel>
        <Border Background="#99132F54" CornerRadius="6" Height="72" Margin="0,20,0,5000">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="200" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
              <StackPanel Orientation="Horizontal">
                <UXControls:UXTextBlock Text="{Binding [WebCameraMicrophone.1], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource ModuleItemStyle}" VerticalAlignment="Center" Margin="15,0,0,0" />
                <Image Margin="9,0,0,0" Source="/DDPM.UI.Common;component/Resources/info.png" Stretch="Uniform" Cursor="Hand" Width="16" Height="16">
                  <Image.ToolTip>
                    <ToolTip Style="{StaticResource InfoToolTipStyle}" Placement="Top" VerticalOffset="8" HorizontalOffset="6">
                      <TextBlock Text="{Binding [WebCameraMicrophone.2], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource TabInfoToolTipTextStyle}" />
                    </ToolTip>
                  </Image.ToolTip>
                </Image>
              </StackPanel>
            </Grid>
            <Grid Grid.Column="1">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0" VerticalAlignment="Top">
                <Image Margin="9,0,0,0" Source="/DDPM.UI.Common;component/Resources/Warring.png" Stretch="Uniform" Cursor="Hand" Width="16" Height="16" VerticalAlignment="Top">
                  <Image.ToolTip>
                    <ToolTip Style="{StaticResource InfoToolTipStyle}" Placement="Top" VerticalOffset="8" HorizontalOffset="6">
                      <TextBlock Text="Enables your camera's microphone. Camera will restart quickly when turning ON/OFF this feature." Style="{StaticResource TabInfoToolTipTextStyle}" />
                    </ToolTip>
                  </Image.ToolTip>
                </Image>
                <UXControls:UXToggleSwitch IsChecked="{Binding Path= IsChecked_Microphone}" ContentTextVisibility="True" Content="{Binding Path=MicrophoneStatus_String}" HorizontalAlignment="Right" VerticalAlignment="Center"  Foreground="White" />
              </StackPanel>
            </Grid>
          </Grid>
        </Border>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>