<UserControl x:Class="DDPM.UI.Module.Illumination.IlluminationRightView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             xmlns:common="clr-namespace:DDPM.UI.Common;assembly=DDPM.UI.Common"
             xmlns:plugin="clr-namespace:DDPM.UI.Plugin.ViewModels;assembly=DDPM.UI.Plugin.Common"
             xmlns:PluginCommon="clr-namespace:DDPM.UI.Plugin.Common;assembly=DDPM.UI.Plugin.Common"
             xmlns:lang="clr-namespace:DDPM.UI.Resources.Helper;assembly=DDPM.UI.Resources"
             d:DataContext="{d:DesignInstance Type=plugin:KeyboardViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="647" d:DesignWidth="507">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/DDPM.UI.Common;component/PluginStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <PluginCommon:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </ResourceDictionary>
  </UserControl.Resources>
  <!--Elsa 20250331 for PIMS-348388 change Width="520" to Width="auto",change Margin="0,10,10,15" to Margin="0,10,16,16" -->
  <Border CornerRadius="13" Width="auto" Margin="0,10,16,16">
    <Grid Margin="0,0,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="70" />
        <RowDefinition Height="178" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid Height="60" VerticalAlignment="top" Grid.Row="0">
        <UXControls:UXTextBlock Text="{Binding [Illumination.1], Source={x:Static lang:LangHelper.Instance}}" 
                                        FontFamily="{StaticResource RobotoFont}" FontSize="20" Foreground="{DynamicResource DefaultTheme_TxtColor}"
                                        TextBlockSemanticColorType="Light" Margin="18,24,0,0"
                                        TextBlockType="Caption"
                                        VerticalAlignment="Top" HorizontalAlignment="Left" />
      </Grid>
      <Border CornerRadius="6" Width="480" VerticalAlignment="Top" Margin="0" Grid.Row="1">
        <Grid VerticalAlignment="top">
          <Grid.RowDefinitions>
            <RowDefinition Height="90" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
          </Grid.RowDefinitions>
          <Grid VerticalAlignment="top" Grid.Row="0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
              <common:TabButton Name="TabOff" Margin="0" HasInfoIcon="true"
                                              Width="147" Height="58" Focused="{Binding TabOffFocused}"
                                              Caption="{Binding TabOffCaption}" Command="{Binding TabOffClickedCommand}"
                                              TabInfo="{Binding TabOffInfoTip}" TooltipOffsetH="2"/>
              <common:TabButton Name="TabAdaptiveLight" Margin="5,0,0,0" HasInfoIcon="true"
                                              Width="147" Height="58" Focused="{Binding TabAdaptiveLightFocused}"
                                              Caption="{Binding TabAdaptiveLightCaption}" Command="{Binding TabAdaptiveLightClickedCommand}"
                                              TabInfo="{Binding TabAdaptiveLightInfoTip}" />
              <common:TabButton Name="TabManual" Margin="5,0,0,0" HasInfoIcon="true"
                                              Width="147" Height="58"  Focused="{Binding TabManualFocused}"
                                              Caption="{Binding TabManualCaption}" Command="{Binding TabManualClickedCommand}"
                                              TabInfo="{Binding TabManualInfoTip}" />
            </StackPanel>
          </Grid>
          <Grid Height="40" VerticalAlignment="top" Grid.Row="1" Margin="0,12,0,0" Visibility="{Binding IsSliderVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <UXControls:UXTextBlock Text="{Binding [Illumination.1], Source={x:Static lang:LangHelper.Instance}}" FontSize="16" Foreground="{DynamicResource DefaultTheme_TxtColor}" FontWeight="Medium"
                                                TextBlockSemanticColorType="Light" Margin="20,0,0,0"
                                                TextBlockType="Caption"
                                                VerticalAlignment="Top" HorizontalAlignment="Left" />
          </Grid>
          <Grid VerticalAlignment="top" Grid.Row="2" Visibility="{Binding IsSliderVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,18">
              <UXControls:UXSlider Value="{Binding BackLightingLevel}" Maximum="4" Width="400" Thumb.DragCompleted="BackLightingSlider_DragCompleted" Thumb.DragStarted="BackLightingSlider_DragStarted" KeyUp="UXSlider_KeyUp" PreviewKeyDown="UXSlider_PreviewKeyDown"
                                   IsSnapToTickEnabled="True"/>
              <UXControls:UXTextBlock Text="{Binding BackLightingLevelText}" FontWeight="Light" FontSize="14" Foreground="{DynamicResource DefaultTheme_ProcessBarTxtColor}" Margin="10,0,0,0" />
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Border>
</UserControl>