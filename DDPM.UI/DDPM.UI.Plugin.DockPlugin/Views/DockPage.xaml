<UserControl x:Class="DDPM.UI.Plugin.DockPlugin.Views.DockPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DDPM.UI.Plugin.DockPlugin.Views"
             xmlns:common="clr-namespace:DDPM.UI.Common;assembly=DDPM.UI.Common"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             xmlns:plugin="clr-namespace:DDPM.UI.Plugin.ViewModels;assembly=DDPM.UI.Plugin.Common"
             xmlns:DDPMUserControls="clr-namespace:DDPM.UI.Common;assembly=DDPM.UI.Common"
             xmlns:lang="clr-namespace:DDPM.UI.Resources.Helper;assembly=DDPM.UI.Resources"
             d:DataContext="{d:DesignInstance Type=plugin:DockPageViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DDPM.UI.Common;component/PluginStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Storyboard x:Key="StoryGotoTwoView">
                <DoubleAnimation Storyboard.TargetName="RightGrid" Storyboard.TargetProperty="Width"
                                 Duration="0:0:0.4" From="{Binding RightFrameWidthFrom}" To="{Binding RightFrameWidthTo}" FillBehavior="HoldEnd" />
            </Storyboard>
            <Storyboard x:Key="StoryShrink">
                <DoubleAnimation Storyboard.TargetName="largeImage" Storyboard.TargetProperty="MaxWidth" From="620" To="500" Duration="0:0:0.4" AutoReverse="False" />
                <!--<DoubleAnimation Storyboard.TargetName="BottomGrid" Storyboard.TargetProperty="MaxHeight" From="540" To="500" Duration="0:0:0.4" AutoReverse="False" />-->
            </Storyboard>
            <Storyboard x:Key="StoryEnlarge">
                <DoubleAnimation Storyboard.TargetName="largeImage" Storyboard.TargetProperty="MaxWidth" Duration="0:0:0.4" From="500" To="620" />
                <!--<DoubleAnimation Storyboard.TargetName="BottomGrid" Storyboard.TargetProperty="MaxHeight" Duration="0:0:0.4" From="500" To="540" />-->
            </Storyboard>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <UXControls:UXScrollViewer x:Name="topViewScrollViewer">
            <StackPanel Orientation="Horizontal" x:Name="topStackPanel">
                <!-- LeftFrame -->

                <!-- vBar + RightFrame -->
                <StackPanel x:Name="stVbarRightFrame">
                    <!--Vbar-->

                    <!-- RightFrame -->
                    <!-- Right side: Header + RightView -->
                </StackPanel>
            </StackPanel>
        </UXControls:UXScrollViewer>
        
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!--Layer 2 : Nav and Vbar-->
            <Grid Grid.Column="0">
                <Border Background="#00FF0000" MouseLeftButtonDown="Mainframe_MouseLeftButtonDown" />
                <!--Image-->
                <Grid>
                    <Viewbox Name="largeImage" Margin="30,60" MaxWidth="620">
                        <Grid>
                            <Grid>
                                <Image Source="{Binding ImageFilePath}" Stretch="Uniform" MouseLeftButtonDown="LargeImage_MouseLeftButtonDown" MaxWidth="620" />
                            </Grid>
                        </Grid>
                    </Viewbox>
                </Grid>
                <!--Vbar-->
                <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Name="VbarGrid">
                    <ItemsControl Name="vbarList" Margin="0,10,0,0"
                                  HorizontalAlignment="Right" VerticalAlignment="Top"
                                  ItemsSource="{Binding VbarItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <ContentPresenter />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Grid>
            <!--Name & Model-->
            <Grid VerticalAlignment="Top" HorizontalAlignment="Left">
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Image Margin="64,21,0,0" Source="/DDPM.UI.Resources;component/Resources/Images/arrow-left.png" Stretch="Fill"
                               VerticalAlignment="Top" HorizontalAlignment="Left" Cursor="" Width="24" Height="24">
                            <Image.InputBindings>
                                <MouseBinding Gesture="LeftClick" Command="{Binding GoBackClickedCommand, Mode=OneTime}" />
                            </Image.InputBindings>
                        </Image>
                        <UXControls:UXTextBlock Text="{Binding Name}" Margin="12,19,0,0" HorizontalAlignment="Left"
                                                Style="{StaticResource ProductNameTextStyle}" Cursor="" VerticalAlignment="Top" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <UXControls:UXTextBlock Text="{Binding Model}" Margin="101,18,0,0" HorizontalAlignment="Left"
                                                Style="{StaticResource ModelNumberTextStyle}" />
                        <Image Margin="9,22.5,0,0" Source="/DDPM.UI.Resources;component/Resources/Images/info.png" Stretch="Fill"
                               VerticalAlignment="Top" Cursor="" Width="16" Height="16">
                            <!--<Image.InputBindings>
                                <MouseBinding Gesture="LeftClick" Command="{Binding ShowInfoClickedCommand}" />
                            </Image.InputBindings>-->
                            <Image.ToolTip>
                                <ToolTip Style="{StaticResource InfoToolTipStyle}" Placement="Top" VerticalOffset="6" HorizontalOffset="8">
                                    <TextBlock Style="{StaticResource InfoToolTipTextStyle}" Text="{Binding FirmwareVersion2}" />
                                </ToolTip>
                            </Image.ToolTip>
                        </Image>
                    </StackPanel>
                </StackPanel>
            </Grid>
            <!--Battery-->
            <Grid VerticalAlignment="Bottom">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Border Style="{StaticResource BorderConnection}" Margin="-70,0,0,8" Visibility="Collapsed" x:Name="DongleConnection" Height="130">
                            <StackPanel Orientation="Vertical">
                                <StackPanel Orientation="Horizontal" Margin="20,18,0,0">
                                    <UXControls:UXTextBlock Name="txt3" Text="3" Style="{StaticResource ConnectionStyle3}" />
                                    <Image Margin="4,0,0,0" Width="16" Height="16" Source="/DDPM.UI.Resources;component/Resources/Images/Dongle.png" />
                                    <UXControls:UXTextBlock Name="txtSystemName3" Foreground="#F5F6F7" VerticalAlignment="Center"
                                                            HorizontalAlignment="Center" FontFamily="Roboto" FontSize="14" />
                                </StackPanel>
                                <Line X1="15" Y1="10" X2="235" Y2="10" Stroke="#1B385F" StrokeThickness="2" />
                                <UXControls:UXTextBlock Name="txtFirmware" Style="{StaticResource ConnectionStyle3}" Margin="20,13,0,0" />
                                <UXControls:UXTextBlock Name="txtSlot" Style="{StaticResource ConnectionStyle3}" Margin="20,15,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource BorderConnection}" Margin="-70,0,0,8" Visibility="Collapsed" x:Name="BLConnection" Height="92" VerticalAlignment="Bottom">
                            <StackPanel Orientation="Vertical">
                                <StackPanel Orientation="Horizontal" Margin="20,18,0,0">
                                    <UXControls:UXTextBlock Name="txt1" Text="1" />
                                    <Image x:Name="imgBL1" Margin="4,0,0,0" Width="16" Height="16" />
                                    <UXControls:UXTextBlock Name="txtSystemName1" Margin="4,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="20,18,0,0">
                                    <UXControls:UXTextBlock Name="txt2" Text="2" />
                                    <Image x:Name="imgBL2" Margin="4,0,0,0" Width="16" Height="16" />
                                    <UXControls:UXTextBlock Name="txtSystemName2" Margin="4,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <DDPMUserControls:BatteryIndicator  Margin="0,0,0,70" HorizontalAlignment="Center" BatteryLevel="{Binding BatteryLevel}" BatteryStatus="{Binding BatteryStatus}" ConnectionType="{Binding ConnectionType}" NoBattery="{Binding NoBattery}" VerticalAlignment="Bottom" /><!--0617 Bruce 新增判斷判斷是否有支援電池裝置-->
                        <Border Style="{StaticResource BorderUnpair}" Width="176" MouseLeftButtonDown="FWUpdate_Click" Cursor="Hand" Margin="8,0,0,70" Visibility="Visible" x:Name="btnFWU"><!--0614 Bruce 修改按鈕名稱-->
                            <Grid>
                                <UXControls:UXTextBlock Name="txtFWUpdate" Foreground="#F5F6F7" VerticalAlignment="Center"
                                                        HorizontalAlignment="Center" FontFamily="Roboto" FontSize="14" Text="{Binding [UpdateFirmware], Source={x:Static lang:LangHelper.Instance}}"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>