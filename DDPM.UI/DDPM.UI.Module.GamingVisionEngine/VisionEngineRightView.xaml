<UserControl x:Class="DDPM.UI.Module.GamingVisionEngine.VisionEngineRightView" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DDPM.UI.Module.GamingVisionEngine"
             xmlns:lang="clr-namespace:DDPM.UI.Resources.Helper;assembly=DDPM.UI.Resources"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             d:DesignHeight="800" d:DesignWidth="800" mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- <ResourceDictionary Source="/DDPM.UI.Common;component/ModuleStyle.xaml" /> -->
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <UXControls:UXScrollViewer>
            <Grid>
                <Border Style="{StaticResource RightGroupBorderStyle}">
                    <StackPanel>
                        <UXControls:UXTextBlock HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                FontSize="20"
                                                Foreground="{DynamicResource TextBlock_ForegroundColor}"
                                                Text="{Binding [VisionEngine], Source={x:Static lang:LangHelper.Instance}}" TextBlockSemanticColorType="Light" TextBlockType="Caption" />
                        <StackPanel Margin="15" Height="150">
                            <ItemsControl ItemsSource="{Binding VisionEngineList}" IsEnabled="{Binding VisionEngineIsEnable}" Name="listTopics" Background="Transparent" BorderThickness="0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <UXControls:UXCheckBox FontSize="14"
                                                                   Content="{Binding DisplayText}"
                                                                   IsChecked="{Binding VisionEngine_Enable}"
                                                                   Foreground="{DynamicResource TextBlock_ForegroundColor}"
                                                                   Click="UXCheckBox_Click" Unchecked="UXCheckBox_Unchecked" Background="Transparent"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <Grid>
                            <UXControls:UXTextBlock HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    FontSize="20"
                                                    Foreground="{DynamicResource TextBlock_ForegroundColor}"
                                                    Text="{Binding [Toggle_Vision_Engine], Source={x:Static lang:LangHelper.Instance}}" TextBlockSemanticColorType="Light" TextBlockType="Caption" />
                            <UXControls:UXTextBox Width="200"
                                                  Height="40"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  FontSize="14"
                                                  Foreground="{DynamicResource TextBlock_ForegroundColor}"
                                                  Name="tbVisionEngineToggle" AcceptsReturn="True" PreviewKeyDown="tbVisionEngineToggle_PreviewKeyDown" PreviewKeyUp="tbVisionEngineToggle_PreviewKeyUp" GotFocus="tbVisionEngineToggle_GotFocus" LostFocus="tbVisionEngineToggle_LostFocus" ContextMenuOpening="tbVisionEngineToggle_ContextMenuOpening" ContextMenu="{x:Null}" Text="{Binding VisionEngineToggleKey,Mode=TwoWay}" />
                        </Grid>
                        <TextBox Width="1" Height="1" Name="tbCleanFocus" Panel.ZIndex="-99" />
                    </StackPanel>
                </Border>
                <Border Name="DisableAll" Background="#4C24273C">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <!--  Add a UXBusyIndicator from Robert  -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <UXControls:UXBusyIndicator Width="64" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center" BusyIndicatorType="Secondary" IsActive="{Binding IsBusy}" />
                        <UXControls:UXTextBlock Margin="0, 20, 0, 0" Text="{Binding [HomePage.0], Source={x:Static lang:LangHelper.Instance}}" Foreground="#FF797F84" />
                    </StackPanel>
                </Border>
            </Grid>
        </UXControls:UXScrollViewer>
    </Grid>
</UserControl>