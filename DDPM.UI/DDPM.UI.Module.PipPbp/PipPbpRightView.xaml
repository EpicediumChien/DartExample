<UserControl x:Class="DDPM.UI.Module.PipPbp.PipPbpRightView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             xmlns:local="clr-namespace:DDPM.UI.Module.PipPbp"
             xmlns:commonCtrl="clr-namespace:DDPM.UI.Common.UserControls;assembly=DDPM.UI.Common"
             xmlns:PluginCommon="clr-namespace:DDPM.UI.Plugin.Common;assembly=DDPM.UI.Plugin.Common"
             xmlns:eaem="clr-namespace:DDPM.UI.Common.EAEM;assembly=DDPM.UI.Common"
             xmlns:lang="clr-namespace:DDPM.UI.Resources.Helper;assembly=DDPM.UI.Resources"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="800"
             Loaded="UserControl_Loaded"
             GotFocus="UserControl_GotFocus"
             LostFocus="UserControl_LostFocus"
             Unloaded="UserControl_Unloaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- <ResourceDictionary Source="/DDPM.UI.Common;component/ModuleStyle.xaml" /> -->
                <!--<ResourceDictionary Source="/DDPM.UI.Common;component/ButtonStyle.xaml" />-->
            </ResourceDictionary.MergedDictionaries>

            <!-- #region Unused_1 Robert_Lin, 2024-11-30, Unused, will reference to ModuleStyle.xaml -->
            <!-- 
            <Color x:Key="Color_FakeTransparent">#02000000</Color>
            <SolidColorBrush x:Key="FakeTransparent" Color="{StaticResource Color_FakeTransparent}" />

            <SolidColorBrush x:Key="ToolipBkColor" Color="#FF1D2C3B" />
            <SolidColorBrush x:Key="ToolipBdColor" Color="#FF293B4D" />
            <SolidColorBrush x:Key="ToolipTextColor" Color="#FFF5F6F7" />

            <Style x:Key="BlackButtonBorder" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource FakeTransparent}" />
                <Setter Property="CornerRadius" Value="2" />
                <Setter Property="Height" Value="40" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="#F5F6F7" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#1D2C38" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="BorderBrush" Value="#A3A3A3" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            -->
            <!-- #endregion Unused_1 Robert_Lin, 2024-11-30, Unused, will reference to ModuleStyle.xaml -->

            <PluginCommon:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <!-- Robert_lin, 2024-11-30, LightMode, Remove all Foreground settings, will apply to App Resource Defaults -->
        <UXControls:UXScrollViewer>
            <Grid>
                <!-- #region Main Content -->
                <StackPanel>
                    <!-- #region PIP/PBP Section -->
                    <Border Style="{StaticResource RightGroupBorderStyle}">
                        <StackPanel>
                            <!-- PipPbpSectionHeader -->
                            <!-- Robert_lin, 2024-11-30, LightMode, Remove all Foreground settings, will apply to App Resource Defaults -->
                            <UXControls:UXTextBlock Text="{Binding [PIPorPBP], Source={x:Static lang:LangHelper.Instance}}"
                                                    Focusable="True" KeyboardNavigation.TabIndex="101"
                                                    FontSize="20" />

                            <!-- FullScreen divTitle-->
                            <!-- Robert_lin, 2024-11-30, LightMode, Remove all Foreground settings, will apply to App Resource Defaults -->
                            <UXControls:UXTextBlock Text="{Binding [Fullscreen], Source={x:Static lang:LangHelper.Instance}}" Margin="0,12"
                                                    Focusable="True" Name="labelFullscreen" KeyboardNavigation.TabIndex="102"
                                                    FontSize="14" />
                            <!-- Fullscreen SplitItem List -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <!-- AutomationProperties.Name="{Binding Desciption, ElementName=pipOff}"
                                -->
                                <commonCtrl:SplitItem Name="pipOff" Width="88" Height="68"
                                                      KeyboardNavigation.TabIndex="103" 
                                                      ClickCommand="{Binding FullScreenClickCommand}"/>
                             </StackPanel>

                            <!-- PIP divTitle-->
                            <!-- 2024-11-14 Robert_Lin, PIMS-313776, Monitor has not PIP capability, need to hide PIP div
                                 Add a StackPanel for Pip div, and will hide the Pip div (Grid) when mnitor has not the PIP capability.
                            -->
                            <StackPanel Name="pipDiv"
                                        Visibility="{Binding HasCapabiliy_AnyPip, Converter={StaticResource BoolToVisibilityConverter}}">

                                <!-- Robert_lin, 2024-11-30, LightMode, Remove all Foreground settings, will apply to App Resource Defaults -->
                                <UXControls:UXTextBlock Text="{Binding [PipPbp.0], Source={x:Static lang:LangHelper.Instance}}" Margin="0,12"
                                                        Focusable="True" KeyboardNavigation.TabIndex="104"
                                                        FontSize="14" />
                                <!-- PIP SplitItem List -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <commonCtrl:SplitItem Width="88" Height="68" Name="pipSmall"
                                                          KeyboardNavigation.TabIndex="105"
                                                          ClickCommand="{Binding PipSmallClickCommand}"
                                                          Visibility="{Binding DataContext.HasCapability_PipSmall, Converter={StaticResource BoolToVisibilityConverter}, RelativeSource={RelativeSource AncestorType=UserControl}}"/>


                                    <commonCtrl:SplitItem Width="88" Height="68" Margin="8,0" Name="pipLarge"
                                                           KeyboardNavigation.TabIndex="106"
                                                         ClickCommand="{Binding PipLargeClickCommand}"
                                                          Visibility="{Binding DataContext.HasCapability_PipLarge, Converter={StaticResource BoolToVisibilityConverter}, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

                                    <!-- Toggle between positions button 
                                <UXControls:UXButton Content="{Binding [PipPbp.7], Source={x:Static lang:LangHelper.Instance}}" Height="40" CornerRadius="2" Padding="12,8"
                                                     Margin="4,0" IsEnabled="{Binding IsPipItemSelected}"
                                                     ButtonType="Secondary" ButtonSemanticColorType="Neutral" Foreground="Gray"
                                                     Command="{Binding PipTogglePositionClickCommand}" />
                                -->
                                    <!-- Using Custom WPF buton, defined in ButtonStyle.xaml -->
                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            Content="{Binding [PipPbp.7], Source={x:Static lang:LangHelper.Instance}}"
                                            KeyboardNavigation.TabIndex="107"
                                            Height="40" Margin="4,0" IsEnabled="{Binding IsPipItemSelected}"
                                            Command="{Binding PipTogglePositionClickCommand}" 
                                            Visibility="{Binding HasCapability_PipTogglePosition, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- PBP divTitle-->
                            <!-- Robert_lin, 2024-11-30, LightMode, Remove all Foreground settings, will apply to App Resource Defaults -->
                            <UXControls:UXTextBlock Text="{Binding [PipPbp.1], Source={x:Static lang:LangHelper.Instance}}" Margin="0,12"
                                                    Focusable="True" KeyboardNavigation.TabIndex="108"
                                                    FontSize="14" />
                            <!-- PBP SplitItem List -->
                            <commonCtrl:SplitListView Name="spliListView_Pbp" Margin="0,4"
                                                      KeyboardNavigation.TabIndex="109" KeyboardNavigation.TabNavigation="Continue"
                                                      ItemClickCommand="{Binding PbpItemClickCommand}" />
                        </StackPanel>
                    </Border>
                    <!-- #endregion PIP/PBP Section -->

                    <!-- #region Video Swap ComboBoxes -->
                    <Border Style="{StaticResource RightGroupBorderStyle}" Margin="0,16,0,0"
                            Visibility="{Binding IsVideoSwapComboBoxesVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <StackPanel.Resources>
                                <!-- Robert_lin, 2024-11-30, LightMode, Remove all Foreground settings, will apply to App Resource Defaults -->
                                <Style TargetType="{x:Type UXControls:UXTextBlock}">
                                    <Setter Property="Foreground" Value="{DynamicResource DefaultTheme_TxtColor}" />
                                    <Setter Property="FontSize" Value="16" />
                                    <Setter Property="Margin" Value="16,12,0,12" />
                                    <Setter Property="HorizontalAlignment" Value="Left" />
                                </Style>
                            </StackPanel.Resources>

                            <UXControls:UXTextBlock Text="{Binding [VideoSwap], Source={x:Static lang:LangHelper.Instance}}" FontSize="20" Margin="4,16,0,20"
                                                    Focusable="True" KeyboardNavigation.TabIndex="151"/>

                            <!-- Main Input -->
                            <Grid Height="50">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <UXControls:UXTextBlock Text="{Binding [PipPbp.2], Source={x:Static lang:LangHelper.Instance}}" Grid.Column="0"
                                                        Focusable="True" KeyboardNavigation.TabIndex="152" Name="labelInput1"/>
                                <!-- Robert_Lin, 2024-11-13 PIMS-319966, Change InputSurce
                                -->
                                <ComboBox Grid.Column="2" Style="{StaticResource DdpmComboBoxStyle}"
                                          Width="184" Margin="0" VerticalAlignment="Center"
                                          KeyboardNavigation.TabIndex="153" AutomationProperties.LabeledBy="{Binding ElementName=labelInput1}"
                                          KeyboardNavigation.TabNavigation="Continue"
                                          DisplayMemberPath="DisplayName"
                                          ItemsSource="{Binding VideoSwapItems}"
                                          SelectedItem="{Binding MainInputSource, Mode=TwoWay}" >
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DdpmComboBoxItemContainerStyle}">
                                            <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}"/>
                                        </Style>
                                    </ComboBox.ItemContainerStyle>

                                </ComboBox>
                            </Grid>

                            <!-- Sub1 Input, visible only when have Sub1 -->
                            <Grid Height="50">
                                <!-- Robert_Lin, 2024-8-28 always visible with VideoSwapComboBoxes Border -->
                                <!-- 
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSub1Input}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                -->
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <UXControls:UXTextBlock Text="{Binding [PipPbp.3], Source={x:Static lang:LangHelper.Instance}}" Grid.Column="0"
                                                        Focusable="True" KeyboardNavigation.TabIndex="154" Name="labelInput2"/>
                                <ComboBox Grid.Column="2" Style="{StaticResource DdpmComboBoxStyle}"
                                          Width="184" Margin="0" VerticalAlignment="Center"
                                            KeyboardNavigation.TabIndex="155" AutomationProperties.LabeledBy="{Binding ElementName=labelInput2}"
                                          KeyboardNavigation.TabNavigation="Continue"
                                          DisplayMemberPath="DisplayName"
                                          ItemsSource="{Binding VideoSwapItems}"
                                          SelectedItem="{Binding Sub1InputSource, Mode=TwoWay}" >
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DdpmComboBoxItemContainerStyle}">
                                            <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}"/>
                                        </Style>
                                    </ComboBox.ItemContainerStyle>

                                </ComboBox>
                            </Grid>

                            <!-- Sub2 Input, visible only when have Sub2 -->
                            <Grid Height="50">
                                <!-- Robert_Lin, 2024-8-28 always visible with VideoSwapComboBoxes Border -->
                                <!-- 
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSub2Input}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                -->
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <UXControls:UXTextBlock Text="{Binding [PipPbp.4], Source={x:Static lang:LangHelper.Instance}}" Grid.Column="0" 
                                                         Focusable="True" KeyboardNavigation.TabIndex="156" Name="labelInput3"/>
                                <ComboBox Grid.Column="2" Style="{StaticResource DdpmComboBoxStyle}"
                                          KeyboardNavigation.TabIndex="157" AutomationProperties.LabeledBy="{Binding ElementName=labelInput3}"
                                         Width="184" Margin="0" VerticalAlignment="Center"
                                          KeyboardNavigation.TabNavigation="Continue"
                                          DisplayMemberPath="DisplayName"
                                          ItemsSource="{Binding VideoSwapItems}"
                                          SelectedItem="{Binding Sub2InputSource, Mode=TwoWay}" >
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DdpmComboBoxItemContainerStyle}">
                                            <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}"/>
                                        </Style>
                                    </ComboBox.ItemContainerStyle>

                                </ComboBox>
                            </Grid>

                            <!-- Sub3 Input, visible only when have Sub2 -->
                            <Grid Height="50">
                                <!-- Robert_Lin, 2024-8-28, Visible only when SplitCount==4 -->
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SplitCount}" Value="4">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <UXControls:UXTextBlock Text="{Binding [PipPbp.5], Source={x:Static lang:LangHelper.Instance}}" Grid.Column="0" 
                                                         Focusable="True" KeyboardNavigation.TabIndex="158" Name="labelInput4"/>
                                <ComboBox Grid.Column="2" Style="{StaticResource DdpmComboBoxStyle}"
                                           KeyboardNavigation.TabIndex="159" AutomationProperties.LabeledBy="{Binding ElementName=labelInput4}"
                                          KeyboardNavigation.TabNavigation="Continue"
                                         Width="184"  Margin="0" VerticalAlignment="Center"
                                          DisplayMemberPath="DisplayName"
                                          ItemsSource="{Binding VideoSwapItems}"
                                          SelectedItem="{Binding Sub3InputSource, Mode=TwoWay}" />
                            </Grid>
                            <!-- Add a margin space at bottom -->
                            <Grid Height="12" />
                        </StackPanel>
                    </Border>
                    <!-- #endregion Video Swap ComboBoxes -->

                    <!-- #region Buttons
                    IsEnabled="{Binding IsUsbSwitchButtonEnabled}"
                    -->
                    <StackPanel Margin="0,16,0,24" Orientation="Horizontal" HorizontalAlignment="Center">
                        <!-- Video Swap Button 
                        <Border Name="VideoSwapButton" Style="{StaticResource BlackButtonBorder}"
                                Width="132" Margin="0,0,4,0"
                                IsEnabled="{Binding IsVideoSwapButtonEnabled, Mode=OneWay}"
                                Visibility="{Binding IsVideoSwapButtonVisible, Converter={StaticResource BoolToVisibilityConverter}}" 
                                MouseLeftButtonDown="videoSwapButton_MouseLeftButtonDown">

                            <UXControls:UXTextBlock Name="VideoSwapButtonText" Text="{Binding [VideoSwap], Source={x:Static lang:LangHelper.Instance}}"
                                                    Foreground="#FFFFFF" FontSize="14"
                                                    VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        -->
                        <!-- Using custom WPF style, defined in ButtonStyle.xaml 
                                Content="{Binding [VideoSwap], Source={x:Static lang:LangHelper.Instance}}"
                                Content="VideoSwap"
                        Robert_Lin, 2024-12-6 remove Height setter to avoid text been cut off
                        Width="132" 
                        -->
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Content="{Binding [VideoSwap], Source={x:Static lang:LangHelper.Instance}}"
                                KeyboardNavigation.TabIndex="161"
                                Margin="0,0,4,0"
                                IsEnabled="{Binding IsVideoSwapButtonEnabled, Mode=OneWay}"
                                Visibility="{Binding IsVideoSwapButtonVisible, Converter={StaticResource BoolToVisibilityConverter}}" 
                                MouseLeftButtonDown="videoSwapButton_MouseLeftButtonDown"
                                Click="videoSwapButton_Click"/>

                        <!-- USB Switch Button -->
                        <!-- Using Border + TextBlock solution 
                        <Border Name="UsbSwitchButton" Style="{StaticResource BlackButtonBorder}" Width="132"
                                Margin="4,0,0,0"
                                IsEnabled="{Binding IsUsbSwitchButtonEnabled, Mode=OneWay}"
                                Visibility="{Binding IsUsbSwitchButtonVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                MouseLeftButtonDown="usbSwitchButton_MouseLeftButtonDown">
                            <UXControls:UXTextBlock Style="{StaticResource BlackButtonText}"
                                                    Name="UsbSwitchButtonText" Text="{Binding [PipPbp.6], Source={x:Static lang:LangHelper.Instance}}" />
                        </Border>
                        Robert_Lin, 2024-12-6 remove Height setter to avoid text been cut off
                        Width="132" 
                        -->
                        <!-- Using Custom WPF button, defined in ButtonStyle.xaml -->
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Content="{Binding [PipPbp.6], Source={x:Static lang:LangHelper.Instance}}"
                                KeyboardNavigation.TabIndex="162"
                                Margin="4,0,0,0"
                                IsEnabled="{Binding IsUsbSwitchButtonEnabled, Mode=OneWay}"
                                Visibility="{Binding IsUsbSwitchButtonVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                MouseLeftButtonDown="usbSwitchButton_MouseLeftButtonDown" Click="usbSwitchButton_Click"/>
                    </StackPanel>
                    <!-- #endregion Buttons -->
                </StackPanel>
                <!-- #endregion Main Content -->

                <!-- #region FullView BusyIndicator  -->
                <Border Name="DisableAll" Background="#4C24273C">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <!-- Add a UXBusyIndicator from Robert -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <UXControls:UXBusyIndicator BusyIndicatorType="Secondary" Width="64" Height="64"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                IsActive="{Binding IsBusy}" />
                        <UXControls:UXTextBlock Margin="0, 20, 0, 0" Text="{Binding [HomePage.0], Source={x:Static lang:LangHelper.Instance}}" Foreground="#FF797F84" />
                    </StackPanel>
                </Border>
                <!-- #endregion  FullView BusyIndicator -->
            </Grid>
        </UXControls:UXScrollViewer>
    </Grid>
</UserControl>