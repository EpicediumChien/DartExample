<UserControl x:Class="DDPM.UI.Module.PipPbp.PipPbpLeftView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF" 
             xmlns:local="clr-namespace:DDPM.UI.Module.PipPbp"
             mc:Ignorable="d"  
             d:DesignHeight="450" d:DesignWidth="800" Loaded="UserControl_Loaded">
    
    <StackPanel Background="Green" Margin="20,200,120,0">

        <UXControls:UXComboBox SelectedIndex="0" Width="200">
            <TextBlock Text="1"/>
            <TextBlock Text="2"/>
            <TextBlock Text="3"/>

            <UXControls:UXComboBox.Style>
                <Style TargetType="{x:Type UXControls:UXComboBox}">
                    <Setter Property="Foreground" Value="Red"/>
                </Style>
            </UXControls:UXComboBox.Style>
        </UXControls:UXComboBox>

        <UXControls:UXComboBox SelectedIndex="0" Foreground="Blue" Width="200">
            <TextBlock Text="A"/>
            <TextBlock Text="B"/>
            <TextBlock Text="C"/>
        </UXControls:UXComboBox>

        <Button Content="FullView Test" Click="fullViewTestButton_Click"/>


    </StackPanel>
</UserControl>
