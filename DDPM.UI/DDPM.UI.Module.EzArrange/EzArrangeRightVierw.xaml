<UserControl x:Class="DDPM.UI.Module.EzArrange.EzArrangeRightVierw"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             xmlns:local="clr-namespace:DDPM.UI.Module.EzArrange"
             xmlns:commonCtrl="clr-namespace:DDPM.UI.Common.UserControls;assembly=DDPM.UI.Common"
             xmlns:ezCommon="clr-namespace:DDPM.Easy.Common;assembly=DDPM.Easy.Common"
             xmlns:lang="clr-namespace:DDPM.UI.Resources.Helper;assembly=DDPM.UI.Resources"
             mc:Ignorable="d"
             d:DesignHeight="1000" d:DesignWidth="800" Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DDPM.UI.Common;component/ModuleStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="UXTextBlock_Caption" TargetType="UXControls:UXTextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Margin" Value="0,0,8,0" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <UXControls:UXScrollViewer>
            <Grid>
                <StackPanel>
                    <Border Style="{StaticResource RightGroupBorderStyle}">
                        <StackPanel>

                            <!-- Recent -->
                            <Grid Height="40">
                                <UXControls:UXTextBlock Text="{Binding [Recent], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource UXTextBlock_Caption}" />
                            </Grid>
                            <!-- -->
                            <commonCtrl:SplitListView Name="splitListView_Recent" Margin="0,4"
                                                      ItemClickCommand="{Binding ListViewItemClickCommand}" />
                            <!--
                            <ezCommon:EzListView />
                            -->
                            <!-- Custom -->
                            <StackPanel Orientation="Horizontal" Height="40" Margin="0,16,0,0">
                                <UXControls:UXTextBlock Text="{Binding [Custom], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource UXTextBlock_Caption}" />
                                <Viewbox Width="16" Height="16" Stretch="Uniform">
                                    <Grid Width="16" Height="16" Background="{StaticResource FakeTransparent}">
                                        <Grid.ToolTip>
                                            <ToolTip>
                                                <Border Style="{StaticResource Tooltip_OutterBorderStyle}"
                                                    MaxWidth="360">
                                                    <Grid>
                                                        <TextBlock Name="customListTooltipText"
                                                               Style="{StaticResource Tooltip_TextBlockStyle}"
                                                               TextWrapping="Wrap"/>
                                                    </Grid>
                                                </Border>
                                            </ToolTip>
                                        </Grid.ToolTip>
                                        <Path Data="M8 5.0498C8.55228 5.0498 9 4.60209 9 4.0498C9 3.49752 8.55228 3.0498 8 3.0498C7.44772 3.0498 7 3.49752 7 4.0498C7 4.60209 7.44772 5.0498 8 5.0498Z"
                                              Fill="#FFB6B6B6" />
                                        <Path Data="M8.75 6.4502H7.25V12.6502H8.75V6.4502Z"
                                              Fill="#FFB6B6B6" />
                                        <Path Data="M8 1C11.85 1 15 4.15 15 8C15 11.85 11.85 15 8 15C4.15 15 1 11.85 1 8C1 4.15 4.15 1 8 1ZM8 0C3.6 0 0 3.6 0 8C0 12.4 3.6 16 8 16C12.4 16 16 12.4 16 8C16 3.6 12.4 0 8 0Z"
                                              Fill="#FFB6B6B6" />
                                    </Grid>
                                </Viewbox>
                            </StackPanel>
                            <commonCtrl:SplitListView Name="splitListView_Custom" Margin="0,4"
                                                      ItemClickCommand="{Binding ListViewItemClickCommand}" />
                            <!-- 2 Windows -->
                            <Grid Height="40" Margin="0,16,0,0">
                                <UXControls:UXTextBlock Text="{Binding [Windows], Source={x:Static lang:LangHelper.Instance},StringFormat={}2 {0}}" Style="{StaticResource UXTextBlock_Caption}" />
                            </Grid>
                            <commonCtrl:SplitListView Name="splitListView_2w" Margin="0,4"
                                                      ItemClickCommand="{Binding ListViewItemClickCommand}" />
                            <!-- 3 Windows -->
                            <Grid Height="40" Margin="0,16,0,0">
                                <UXControls:UXTextBlock Text="{Binding [Windows], Source={x:Static lang:LangHelper.Instance},StringFormat={}3 {0}}" Style="{StaticResource UXTextBlock_Caption}" />
                            </Grid>
                            <commonCtrl:SplitListView Name="splitListView_3w" Margin="0,4"
                                                      ItemClickCommand="{Binding ListViewItemClickCommand}" />
                            <!-- 4 Windows -->
                            <Grid Height="40" Margin="0,16,0,0">
                                <UXControls:UXTextBlock Text="{Binding [Windows], Source={x:Static lang:LangHelper.Instance},StringFormat={}4 {0}}" Style="{StaticResource UXTextBlock_Caption}" />
                            </Grid>
                            <commonCtrl:SplitListView Name="splitListView_4w" Margin="0,4"
                                                      ItemClickCommand="{Binding ListViewItemClickCommand}" />
                            <!-- 5 Windows -->
                            <Grid Height="40" Margin="0,16,0,0">
                                <UXControls:UXTextBlock Text="{Binding [Windows], Source={x:Static lang:LangHelper.Instance},StringFormat={}5 {0}}" Style="{StaticResource UXTextBlock_Caption}" />
                            </Grid>
                            <commonCtrl:SplitListView Name="splitListView_5w" Margin="0,4"
                                                      ItemClickCommand="{Binding ListViewItemClickCommand}" />
                            <!-- 6 Windows -->
                            <Grid Height="40" Margin="0,16,0,0">
                                <UXControls:UXTextBlock Text="{Binding [Windows], Source={x:Static lang:LangHelper.Instance},StringFormat={}6 {0}}" Style="{StaticResource UXTextBlock_Caption}" />
                            </Grid>
                            <commonCtrl:SplitListView Name="splitListView_6w" Margin="0,4"
                                                      ItemClickCommand="{Binding ListViewItemClickCommand}" />
                            <!-- 7 Windows or more -->
                            <Grid Height="40">
                                <UXControls:UXTextBlock Text="{Binding [EzArrange.1], Source={x:Static lang:LangHelper.Instance},StringFormat={}7 {0}}" Style="{StaticResource UXTextBlock_Caption}" />
                            </Grid>
                            <commonCtrl:SplitListView Name="splitListView_7w" Margin="0,4"
                                                      ItemClickCommand="{Binding ListViewItemClickCommand}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </UXControls:UXScrollViewer>
    </Grid>
</UserControl>