<UserControl x:Class="DDPM.UI.Module.Gaming.GamingRightView" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DDPM.UI.Module.Gaming"
             xmlns:lang="clr-namespace:DDPM.UI.Resources.Helper;assembly=DDPM.UI.Resources"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:PluginCommon="clr-namespace:DDPM.UI.Plugin.Common;assembly=DDPM.UI.Plugin.Common"
             d:DesignHeight="800" d:DesignWidth="800" mc:Ignorable="d">
 
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DDPM.UI.Common;component/PluginStyles.xaml" />
                <!-- <ResourceDictionary Source="/DDPM.UI.Common;component/ModuleStyle.xaml" /> -->
            </ResourceDictionary.MergedDictionaries>
            <PluginCommon:CenterToolTipConverter x:Key="CenterToolTipConverter" />
            <Style x:Key="btnToolTipStyle" TargetType="ToolTip" BasedOn="{StaticResource InfoToolTipStyle}">
                <Setter Property="Placement" Value="Top" />
                <Setter Property="VerticalOffset" Value="-5" />
                <Setter Property="Width" Value="200"></Setter>
                <Setter Property="HorizontalOffset">
                    <Setter.Value>
                        <MultiBinding Converter="{StaticResource CenterToolTipConverter}">
                            <Binding RelativeSource="{RelativeSource Self}" Path="PlacementTarget.ActualWidth" />
                            <Binding RelativeSource="{RelativeSource Self}" Path="ActualWidth" />
                        </MultiBinding>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>

    </UserControl.Resources>
    <Grid>
        <UXControls:UXScrollViewer>
            <Grid>
                <StackPanel>
                    <Border Style="{DynamicResource RightGroupBorderStyle}">
                        <StackPanel>
                            <Grid Height="40" Margin="0,8" Visibility="{Binding IsSupported_GameEnhanceMode}" IsEnabled="{Binding GameEnhanceMode_IsEnable}" Opacity="{Binding GameEnhanceMode_Opacity}">
                                <UXControls:UXTextBlock HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        FontSize="16"
                                                        Foreground="{DynamicResource TextBlock_ForegroundColor}"
                                                        Text="{Binding [Game_Enhance_Mode], Source={x:Static lang:LangHelper.Instance}}" TextBlockSemanticColorType="Light" TextBlockType="Caption" />
                                <ComboBox Width="200" HorizontalAlignment="Right" VerticalAlignment="Center" DisplayMemberPath="DisplayText" ItemsSource="{Binding GameEnhanceMode_ItemsCollection}" SelectedItem="{Binding SelectedGameEnhancementMode, Mode=TwoWay}" Style="{StaticResource DdpmComboBoxStyle}" TabIndex="1" />
                            </Grid>
                            <Grid Height="40" Margin="0,8" Visibility="{Binding IsSupported_ResponseTime}" IsEnabled="{Binding ResponseTime_IsEnable}" Opacity="{Binding ResponseTime_Opacity}">
                                <UXControls:UXTextBlock HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        FontSize="16"
                                                        Foreground="{DynamicResource TextBlock_ForegroundColor}"
                                                        Text="{Binding [Response_Time], Source={x:Static lang:LangHelper.Instance}}" TextBlockSemanticColorType="Light" TextBlockType="Caption" />
                                <ComboBox Width="200" HorizontalAlignment="Right" VerticalAlignment="Center" DisplayMemberPath="DisplayText" ItemsSource="{Binding ResponseTime_ItemsCollection}" SelectedItem="{Binding SelectedResponseTime, Mode=TwoWay}" Style="{StaticResource DdpmComboBoxStyle}" TabIndex="1" />
                            </Grid>
                            <Grid Height="40" Margin="0,8">
                                <StackPanel Orientation="Horizontal">
                                    <UXControls:UXTextBlock HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            FontSize="16"
                                                            Foreground="{DynamicResource TextBlock_ForegroundColor}"
                                                            Text="{Binding [DisplayProperties.2], Source={x:Static lang:LangHelper.Instance}}"
                                                            TextBlockSemanticColorType="Light"
                                                            TextBlockType="Caption" />
                                    <Grid VerticalAlignment="Center"
                                          Margin="15,0,0,0"
                                          Visibility="{Binding RefreshRateUI_LockTooltip}">
                                        <Path Data="M12.1 6.40012V4.00012C12.2 1.80012 10.5 0.100122 8.30005 0.00012207H8.10005C5.90005 0.00012207 4.10005 1.80012 4.10005 4.00012V6.40012H1.80005V16.0001H14.1V6.40012H12.1ZM5.30005 4.00012C5.20005 2.50012 6.40005 1.30012 7.80005 1.20012H8.20005C9.80005 1.20012 11 2.50012 11 4.00012V6.40012H5.30005V4.00012ZM13.1 14.9001H3.00005V7.50012H13.1V14.9001Z M7.60005 12.5001H8.60005V9.30012H6.80005V10.3001H7.60005V12.5001Z"
                                              Fill="white" />
                                    </Grid>
                                </StackPanel>
                                <ComboBox Width="200"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          DisplayMemberPath="DisplayText"
                                          ItemsSource="{Binding Resolution_ItemsCollection}"
                                          SelectedItem="{Binding SelectedResolution, Mode=TwoWay}"
                                          Style="{StaticResource DdpmComboBoxStyle}"
                                          TabIndex="1"
                                          IsEnabled="{Binding RefreshRateUI_IsEnable}"
                                          Opacity="{Binding RefreshRateUI_Opacity}" />

                            </Grid>
                            <Grid Height="40" Margin="0,8" IsEnabled="{Binding HDRType_IsEnable}" Opacity="{Binding HDRType_Opacity}" Visibility="{Binding IsAWSeries}">
                                <UXControls:UXTextBlock HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        FontSize="16"
                                                        Foreground="{DynamicResource TextBlock_ForegroundColor}"
                                                        Text="{Binding [SmartHDR], Source={x:Static lang:LangHelper.Instance}}" TextBlockSemanticColorType="Light" TextBlockType="Caption" />
                                <ComboBox Width="200" HorizontalAlignment="Right" VerticalAlignment="Center" DisplayMemberPath="DisplayText" ItemsSource="{Binding HDRType_ItemsCollection}" SelectedItem="{Binding SelectedHDRType, Mode=TwoWay}" Style="{StaticResource DdpmComboBoxStyle}" TabIndex="1" />
                            </Grid>
                            <Grid Height="40" Margin="0,8" Visibility="{Binding IsSupported_DarkStabilizer}" IsEnabled="{Binding DarkStabilizer_IsEnable}" Opacity="{Binding DarkStabilizer_Opacity}">
                                <UXControls:UXTextBlock HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        FontSize="16"
                                                        Foreground="{DynamicResource TextBlock_ForegroundColor}"
                                                        Text="{Binding [Dark_Stabilizer], Source={x:Static lang:LangHelper.Instance}}" TextBlockSemanticColorType="Light" TextBlockType="Caption" />
                                <ComboBox Width="200" HorizontalAlignment="Right" VerticalAlignment="Center" DisplayMemberPath="DisplayText" ItemsSource="{Binding DarkStabilizer_ItemsCollection}" SelectedItem="{Binding SelectedDarkStabilizer, Mode=TwoWay}" Style="{StaticResource DdpmComboBoxStyle}" TabIndex="1" />
                            </Grid>
                            <Grid Height="40" Margin="0,8" Visibility="{Binding IsSupported_DarkStabilizer}" IsEnabled="{Binding DarkStabilizer_IsEnable}" Opacity="{Binding DarkStabilizer_Opacity}">
                                <!-- Elsa 20250109 For PIMS [PIMS-335204][PIMS-335209] add Width="350" ToolTipService.Placement="Center" ToolTipService.VerticalOffset="-30" TextTrimming="CharacterEllipsis" -->
                                <UXControls:UXTextBlock HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Width="350" ToolTipService.Placement="Center" ToolTipService.VerticalOffset="-30"
                                                        TextTrimming="CharacterEllipsis"
                                                        FontSize="16"
                                                        Foreground="{DynamicResource TextBlock_ForegroundColor}"
                                                        Text="{Binding [Dark_Stabilizer_Toggle], Source={x:Static lang:LangHelper.Instance}}" TextBlockSemanticColorType="Light" TextBlockType="Caption" >
                                    <!-- Elsa 20250109 For PIMS [PIMS-335204][PIMS-335209] add <UXControls:UXTextBlock.ToolTip> -->
                                    <UXControls:UXTextBlock.ToolTip>
                                        <ToolTip Style="{StaticResource InfoToolTipStyle}">
                                            <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                                <TextBlock MaxWidth="350" TextWrapping="WrapWithOverflow" Style="{StaticResource Tooltip_TextBlockStyle}" Text="{Binding [Dark_Stabilizer_Toggle], Source={x:Static lang:LangHelper.Instance}}" />
                                            </Border>
                                        </ToolTip>
                                    </UXControls:UXTextBlock.ToolTip>
                                </UXControls:UXTextBlock>
                                <UXControls:UXTextBox Width="200"
                                                      Height="40"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      FontSize="14"
                                                      Foreground="{DynamicResource TextBlock_ForegroundColor}"
                                                      Name="tbDarkStabilizerToggle"
                                                      AcceptsReturn="True"
                                                      PreviewKeyDown="tbDarkStabilizerToggle_PreviewKeyDown"
                                                      PreviewKeyUp="tbDarkStabilizerToggle_PreviewKeyUp"
                                                      GotFocus="tbDarkStabilizerToggle_GotFocus"
                                                      LostFocus="tbDarkStabilizerToggle_LostFocus"
                                                      ContextMenuOpening="tbDarkStabilizerToggle_ContextMenuOpening"
                                                      ContextMenu="{x:Null}"
                                                      Text="{Binding DarkStabilizerToggleKey,Mode=TwoWay}" 
                                                      InputLanguageManager.InputLanguage="en-US"
                                                      InputLanguageManager.RestoreInputLanguage="True"/>
                            </Grid>
                            <Grid Height="40" Margin="0,8" Visibility="{Binding IsSupported_DualResolution}">
                                <UXControls:UXTextBlock HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        FontSize="16"
                                                        Foreground="{DynamicResource TextBlock_ForegroundColor}"
                                                        Text="{Binding [Dual_Resolution], Source={x:Static lang:LangHelper.Instance}}" TextBlockSemanticColorType="Light" TextBlockType="Caption" />
                                <ComboBox Width="200" HorizontalAlignment="Right" VerticalAlignment="Center" DisplayMemberPath="DisplayText" ItemsSource="{Binding DualResolution_ItemsCollection}" SelectedItem="{Binding SelectedDualResolution, Mode=TwoWay}" Style="{StaticResource DdpmComboBoxStyle}" TabIndex="1" />
                            </Grid>
                            <Grid Height="40" Margin="0,8" Visibility="{Binding IsSupported_DualResolution}">
                                <!-- Elsa 20250109 For PIMS [PIMS-335204][PIMS-335209] add Width="350" ToolTipService.Placement="Center" ToolTipService.VerticalOffset="-30" TextTrimming="CharacterEllipsis" -->
                                <UXControls:UXTextBlock HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        FontSize="16"
                                                        Width="350" ToolTipService.Placement="Center" ToolTipService.VerticalOffset="-30"
                                                        TextTrimming="CharacterEllipsis"
                                                        Foreground="{DynamicResource TextBlock_ForegroundColor}"
                                                        Text="{Binding [Dual_Resolution_Toggle], Source={x:Static lang:LangHelper.Instance}}" TextBlockSemanticColorType="Light" TextBlockType="Caption" >
                                    <!-- Elsa 20250109 For PIMS [PIMS-335204][PIMS-335209] add <UXControls:UXTextBlock.ToolTip> -->
                                    <UXControls:UXTextBlock.ToolTip>
                                        <ToolTip Style="{StaticResource InfoToolTipStyle}">
                                            <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                                <TextBlock MaxWidth="350" TextWrapping="WrapWithOverflow" Style="{StaticResource Tooltip_TextBlockStyle}" Text="{Binding [Dual_Resolution_Toggle], Source={x:Static lang:LangHelper.Instance}}" />
                                            </Border>
                                        </ToolTip>
                                    </UXControls:UXTextBlock.ToolTip>
                                </UXControls:UXTextBlock>
                                <!-- Elsa 20250109 For PIMS [PIMS-335204][PIMS-335209] change Width="260" to Width="200" -->
                                <UXControls:UXTextBox Width="200"
                                                      Height="40"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      FontSize="14"
                                                      Foreground="{DynamicResource TextBlock_ForegroundColor}"
                                                      Name="tbDualResolutionToggle"
                                                      AcceptsReturn="True"
                                                      PreviewKeyDown="tbDualResolutionToggle_PreviewKeyDown"
                                                      PreviewKeyUp="tbDualResolutionToggle_PreviewKeyUp"
                                                      GotFocus="tbDualResolutionToggle_GotFocus"
                                                      LostFocus="tbDualResolutionToggle_LostFocus"
                                                      ContextMenuOpening="tbDualResolutionToggle_ContextMenuOpening"
                                                      ContextMenu="{x:Null}"
                                                      Text="{Binding DualResolutionToggleKey,Mode=TwoWay}" 
                                                      InputLanguageManager.InputLanguage="en-US"
                                                      InputLanguageManager.RestoreInputLanguage="True"/>
                            </Grid>
                            <Grid Height="40" Margin="0,8" IsEnabled="{Binding HDRType_IsEnable}" Opacity="{Binding HDRType_Opacity}" Visibility="{Binding IsGameSeries}">
                                <UXControls:UXTextBlock HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        FontSize="16"
                                                        Foreground="{DynamicResource TextBlock_ForegroundColor}"
                                                        Text="{Binding [SmartHDR], Source={x:Static lang:LangHelper.Instance}}" TextBlockSemanticColorType="Light" TextBlockType="Caption" />
                                <ComboBox Width="200" HorizontalAlignment="Right" VerticalAlignment="Center" DisplayMemberPath="DisplayText" ItemsSource="{Binding HDRType_ItemsCollection}" SelectedItem="{Binding SelectedHDRType, Mode=TwoWay}" Style="{StaticResource DdpmComboBoxStyle}" TabIndex="1" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <Border Name="DisableAll" Background="#4C24273C">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <!--  Add a UXBusyIndicator from Robert  -->
                    <UXControls:UXBusyIndicator Width="64" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center" BusyIndicatorType="Secondary" IsActive="{Binding IsBusy}" />
                </Border>
                <TextBox Width="1" Height="1" Name="tbCleanFocus" Panel.ZIndex="-99" />
            </Grid>
        </UXControls:UXScrollViewer>
    </Grid>
</UserControl>