<UserControl x:Class="DDPM.UI.Module.RtkHubPortInfo.RtkHubPortInfoRightView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             xmlns:plugin="clr-namespace:DDPM.UI.Plugin.ViewModels;assembly=DDPM.UI.Plugin.Common"
             xmlns:PluginCommon="clr-namespace:DDPM.UI.Plugin.Common;assembly=DDPM.UI.Plugin.Common"
             xmlns:lang="clr-namespace:DDPM.UI.Resources.Helper;assembly=DDPM.UI.Resources"
             d:DataContext="{d:DesignInstance Type=plugin:RtkHubViewModel}"
             xmlns:common="clr-namespace:DDPM.UI.Common;assembly=DDPM.UI.Common"
             mc:Ignorable="d"
             d:DesignHeight="655" d:DesignWidth="520">
    <UserControl.Resources>
        <ResourceDictionary>

            <SolidColorBrush x:Key="SplitItem_BkColor" Color="#FF132F54" />
            <SolidColorBrush x:Key="SplitItem_NormalBdColor" Color="#FF0B1E38" />
            <SolidColorBrush x:Key="SplitItem_SelectedColor" Color="#FF5CC1EE" />
            <SolidColorBrush x:Key="SplitItem_SelectedColor2" Color="#31A2E3" />
            <LinearGradientBrush x:Key="SplitItem_HoverBdColor" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#FF0672CB" />
                <GradientStop Offset="0.5" Color="#FF0078D4" />
                <GradientStop Offset="1" Color="#FF6E69CF" />
            </LinearGradientBrush>

            <!-- Border Style of Normal State -->
            <Style x:Key="SplitItemBorder_Normal" TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource SplitItem_NormalBdColor}" />
                <Setter Property="BorderThickness" Value="4" />
                <Setter Property="Padding" Value="0" />
            </Style>

            <!-- Border Style of Hover State -->
            <Style x:Key="SplitItemBorder_Hover" TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource SplitItem_HoverBdColor}" />
                <Setter Property="BorderThickness" Value="4" />
                <Setter Property="Padding" Value="0" />
            </Style>

            <!-- Border Style of Selected State -->
            <Style x:Key="SplitItemBorder_Selected" TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource SplitItem_SelectedColor}" />
                <Setter Property="BorderThickness" Value="1.5" />
            </Style>

            <Style x:Key="CollaborationButtonPressedStyle" TargetType="UXControls:UXButton">
                <Setter Property="BorderBrush" Value="{StaticResource SplitItem_HoverBdColor}" />
            </Style>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <Style x:Key="DotStyle" TargetType="Ellipse">
                <Setter Property="Fill" Value="Blue" />
                <Setter Property="Width" Value="10" />
                <Setter Property="Height" Value="10" />
            </Style>

            <Style x:Key="LineStyle" TargetType="Path">
                <Setter Property="Stroke" Value="Blue" />
                <Setter Property="StrokeThickness" Value="2" />
            </Style>

            <LinearGradientBrush x:Key="GradientBrush" StartPoint="0,0" EndPoint="0,0.4">
                <GradientStop Color="Transparent" Offset="0.5" />
                <GradientStop Color="#0672CB" Offset="0" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="NormalBackground" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#0B1E38" Offset="0.0" />
                <GradientStop Color="#0B1E38" Offset="1.0" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="PressedBackground" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#0672CB" Offset="0.0" />
                <GradientStop Color="#0078D4" Offset="0.46" />
                <GradientStop Color="#6E69CF" Offset="1.1831" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="PressedBorderBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#55B4FD" Offset="0.0045" />
                <GradientStop Color="#6E69CF" Offset="1.0" />
            </LinearGradientBrush>
            
            <!-- 狀態邊框用 -->
            <SolidColorBrush x:Key="StatusBorderBlueBrush"  Color="#0672CB"/>
            <SolidColorBrush x:Key="StatusBorderGreenBrush" Color="#7AA809"/>

            <!-- DeviceName 的超連結樣式 -->
            <Style x:Key="HyperlinkTextStyle" TargetType="UXControls:UXTextBlock">
                <Setter Property="Foreground" Value="{StaticResource SplitItem_SelectedColor2}" />
                <Setter Property="TextDecorations" Value="Underline" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <UXControls:UXScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" UseFadingScrolling="False">
        <Grid Margin="0,0,0,15">
            <Border x:Name="MainBorder" CornerRadius="13" Width="auto" Margin="0,10,16,1">
                <StackPanel x:Name="MainStackPanel" Orientation="Vertical" Margin="16, 24, 16, 16">
                    <Grid>
                        <UXControls:UXTextBlock x:Name="DeviceSettingsTextBlock" 
                                                Style="{StaticResource ModuleCaptionStyle}" 
                                                Text="{Binding [RtkHub.01], Source={x:Static lang:LangHelper.Instance}}" 
                                                FontFamily="{StaticResource RobotoFont}" FontSize="20" Height="28" Width="550" 
                                                VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                HorizontalAlignment="Left" 
                                                Margin="0,6,20,8" />
                    </Grid>
                    <Border x:Name="USBPortStatusOuterBorder" CornerRadius="6" Width="auto" Height="auto" VerticalAlignment="Top" Margin="0,0,0,0">
                        <StackPanel x:Name="BusyLightStackPanel" Margin="0,0,0,0">
                            <Grid x:Name="BusyLightGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><!-- header -->
                                    <RowDefinition Height="Auto" /><!-- labels -->
                                    <RowDefinition Height="Auto" /><!-- USB-A -->
                                    <RowDefinition Height="Auto" /><!-- USB-C1 -->
                                    <RowDefinition Height="Auto" /><!-- USB-C2 -->
                                    <RowDefinition Height="*" />   <!-- filler -->
                                    <RowDefinition Height="*" />   <!-- filler -->
                                    <RowDefinition Height="*" />   <!-- filler -->
                                </Grid.RowDefinitions>
                                <UXControls:UXTextBlock x:Name="UsbPortStatusTextBlock" Grid.Column="0" Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Text="{Binding [RtkHub.02], Source={x:Static lang:LangHelper.Instance}}" Margin="20,8,0,20" />
                                <!-- Row 1 -->
                                <UXControls:UXTextBlock x:Name="InputTextBlock"         Grid.Column="0" Grid.Row="1" HorizontalAlignment="Left"   VerticalAlignment="Center" FontSize="14" Text="{Binding [RtkHub.03], Source={x:Static lang:LangHelper.Instance}}" Margin="20,0,0,20" />
                                <UXControls:UXTextBlock x:Name="DeviceNameTextBlock"    Grid.Column="1" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="14" Text="{Binding [RtkHub.04], Source={x:Static lang:LangHelper.Instance}}" Margin="20,0,0,20" />
                                <UXControls:UXTextBlock x:Name="StatusTextBlock"        Grid.Column="3" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="14" Text="{Binding [RtkHub.05], Source={x:Static lang:LangHelper.Instance}}" Margin="0,0,0,20" />

                                <!-- ******************** Row2: USB-A ******************** -->
                                <Border Grid.Row="2" Grid.Column="0" Margin="20,8,0,20" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="M2 19C0.895431 19 0 19.8954 0 21V29.5V32C0 33.1046 0.895432 34 2 34H50C51.1046 34 52 33.1046 52 32V26.5V21C52 19.8954 51.1046 19 50 19H2ZM8.5 26C8.22386 26 8 26.2239 8 26.5C8 26.7761 8.22386 27 8.5 27H43.5C43.7761 27 44 26.7761 44 26.5C44 26.2239 43.7761 26 43.5 26H8.5Z"  VerticalAlignment="Center"/>
                                        <UXControls:UXTextBlock x:Name="USBATextBlock" Text="{Binding [RtkHub.16], Source={x:Static lang:LangHelper.Instance}}" FontSize="14" VerticalAlignment="Center" Margin="8,16,0,0"/>
                                    </StackPanel>
                                </Border>
                                <!-- USB-A DeviceNameTextBlock -->
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" >
                                    <UXControls:UXTextBlock x:Name="USBADeviceNameTextBlock" MaxWidth="150" MaxHeight="70" TextTrimming="CharacterEllipsis" Style="{StaticResource HyperlinkTextStyle}" Text="Lorem ipsum dolor sit amet consectetur. Lorem ipsum dolor sit11111111111111111111111111111111111111111111111111111" TextWrapping="Wrap" FontSize="14" Margin="24,0,0,8" />
                                </StackPanel>
                                <!-- USB-A StatusTextBlock -->
                                <Border Grid.Row="2" Grid.Column="3" BorderBrush="{StaticResource StatusBorderBlueBrush}" BorderThickness="1" CornerRadius="4" Padding="4" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                        <UXControls:UXTextBlock x:Name="USBAStatusTextBlock" Text="{Binding [RtkHub.06], Source={x:Static lang:LangHelper.Instance}}" FontSize="14"/>
                                    </StackPanel>
                                </Border>

                                <!-- ******************** Row3: USB-C1 ******************** -->
                                <Border Grid.Row="3" Grid.Column="0" Margin="20,8,0,20" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="M16.5 21C13.4624 21 11 23.4624 11 26.5C11 29.5376 13.4624 32 16.5 32H35.5C38.5376 32 41 29.5376 41 26.5C41 23.4624 38.5376 21 35.5 21H16.5ZM17.5 26C17.2239 26 17 26.2239 17 26.5C17 26.7761 17.2239 27 17.5 27H34.5C34.7761 27 35 26.7761 35 26.5C35 26.2239 34.7761 26 34.5 26H17.5Z"  VerticalAlignment="Center"/>
                                        <UXControls:UXTextBlock x:Name="USBC1TextBlock" Text="{Binding [RtkHub.17], Source={x:Static lang:LangHelper.Instance}}" FontSize="14" VerticalAlignment="Center" Margin="18,16,0,0"/>
                                        <Button Style="{StaticResource StatelessButton}" Width="16" Height="16" VerticalAlignment="Center" Margin="8,16,0,0">
                                            <ContentControl Template="{StaticResource icon_Info}"/>
                                            <Button.ToolTip>
                                                <ToolTip BorderThickness="0" Background="Transparent" Placement="Top" HorizontalOffset="2" VerticalOffset="12">
                                                    <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                                        <TextBlock Text="{Binding [RtkHub.19], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource Tooltip_TextBlockStyle}" LineHeight="20"/>
                                                    </Border>
                                                </ToolTip>
                                            </Button.ToolTip>
                                        </Button>
                                    </StackPanel>
                                </Border>
                                 <!--USB-C1 DeviceNameTextBlock--> 
                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <UXControls:UXTextBlock x:Name="USBC1DeviceNameTextBlock" MaxWidth="150" MaxHeight="70" TextTrimming="CharacterEllipsis" Style="{StaticResource HyperlinkTextStyle}" Text="Lorem ipsum dolor sit amet consectetur. Lorem ipsum dolor sit11111111111111111111111111111111111111111111111111111" TextWrapping="Wrap" FontSize="14" Margin="24,0,0,8" />
                                </StackPanel>
                                 <!--USB-C1 StatusTextBlock--> 
                                <Border Grid.Row="3" Grid.Column="3" BorderBrush="{StaticResource StatusBorderGreenBrush}" BorderThickness="1" CornerRadius="4" Padding="4" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                        <UXControls:UXTextBlock x:Name="USBC1StatusTextBlock" Text="{Binding [RtkHub.07], Source={x:Static lang:LangHelper.Instance}}" FontSize="14"/>
                                    </StackPanel>
                                </Border>



                                <!-- ******************** Row4: USB-C2 ******************** -->
                                <Border Grid.Row="4" Grid.Column="0" Margin="20,8,0,20" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="M16.5 21C13.4624 21 11 23.4624 11 26.5C11 29.5376 13.4624 32 16.5 32H35.5C38.5376 32 41 29.5376 41 26.5C41 23.4624 38.5376 21 35.5 21H16.5ZM17.5 26C17.2239 26 17 26.2239 17 26.5C17 26.7761 17.2239 27 17.5 27H34.5C34.7761 27 35 26.7761 35 26.5C35 26.2239 34.7761 26 34.5 26H17.5Z" Margin="0,0,0,0" VerticalAlignment="Center"/>
                                        <UXControls:UXTextBlock x:Name="USBC2TextBlock" Text="{Binding [RtkHub.18], Source={x:Static lang:LangHelper.Instance}}" FontSize="14" VerticalAlignment="Center" Margin="18,16,0,0"/>

                                        <Button Style="{StaticResource StatelessButton}" Width="16" Height="16" VerticalAlignment="Center" Margin="8,16,0,0">
                                            <ContentControl Template="{StaticResource icon_Info}"/>
                                            <Button.ToolTip>
                                                <ToolTip BorderThickness="0" Background="Transparent" Placement="Top" HorizontalOffset="2" VerticalOffset="12">
                                                    <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                                        <TextBlock Text="{Binding [RtkHub.20], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource Tooltip_TextBlockStyle}" LineHeight="20"/>
                                                    </Border>
                                                </ToolTip>
                                            </Button.ToolTip>
                                        </Button>
                                    </StackPanel>
                                </Border>
                                <!-- USB-C2 DeviceNameTextBlock -->
                                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <UXControls:UXTextBlock x:Name="USBC2DeviceNameTextBlock" MaxWidth="150" MaxHeight="70" TextTrimming="CharacterEllipsis" Style="{StaticResource HyperlinkTextStyle}" Text="Lorem ipsum dolor sit amet consectetur. Lorem ipsum dolor sit11111111111111111111111111111111111111111111111111111" TextWrapping="Wrap" FontSize="14" Margin="24,0,0,0" />
                                </StackPanel>
                                <!-- USB-C2 StatusTextBlock -->
                                <Border Grid.Row="4" Grid.Column="3" BorderThickness="1" CornerRadius="4" Padding="4" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,0" >
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <UXControls:UXTextBlock x:Name="USBC2StatusTextBlock" Text="{Binding [RtkHub.22], Source={x:Static lang:LangHelper.Instance}}" FontSize="14"/>
                                        <Button Style="{StaticResource StatelessButton}" Width="16" Height="16" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <ContentControl Template="{StaticResource icon_Info}"/>
                                            <Button.ToolTip>
                                                <ToolTip BorderThickness="0" Background="Transparent" Placement="Top" HorizontalOffset="2" VerticalOffset="12">
                                                    <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                                        <TextBlock Text="{Binding [RtkHub.21], Source={x:Static lang:LangHelper.Instance}}" Style="{StaticResource Tooltip_TextBlockStyle}" LineHeight="20"/>
                                                    </Border>
                                                </ToolTip>
                                            </Button.ToolTip>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- ******************** Row5: Alert ******************** -->
                                <UXControls:UXAlert Grid.Row="5" Grid.ColumnSpan="5" Margin="20,16,16,8" Focusable="True" KeyboardNavigation.TabIndex="118" AutomationProperties.Name="{Binding [RtkHub.08], Source={x:Static lang:LangHelper.Instance}}">
                                    <UXControls:UXAlertItem AlertItemType="Info" Margin="8,8,8,8" Label="" Message="{Binding [RtkHub.08], Source={x:Static lang:LangHelper.Instance}}" />
                                </UXControls:UXAlert>


                                <UXControls:UXAlert Grid.Row="6" Grid.ColumnSpan="5" Margin="20,16,16,8" Focusable="True" KeyboardNavigation.TabIndex="118" AutomationProperties.Name="{Binding [RtkHub.12], Source={x:Static lang:LangHelper.Instance}}">
                                    <UXControls:UXAlertItem AlertItemType="Warning" Margin="8,8,8,8" Label="" Message="{Binding [RtkHub.12], Source={x:Static lang:LangHelper.Instance}}" />
                                </UXControls:UXAlert>

                                <UXControls:UXAlert Grid.Row="7" Grid.ColumnSpan="5" Margin="20,16,16,16" Focusable="True" KeyboardNavigation.TabIndex="118" AutomationProperties.Name="{Binding [RtkHub.13], Source={x:Static lang:LangHelper.Instance}}">
                                    <UXControls:UXAlertItem AlertItemType="Critical" Margin="8,8,8,16" Label="" Message="{Binding [RtkHub.13], Source={x:Static lang:LangHelper.Instance}}"  />
                                </UXControls:UXAlert>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </UXControls:UXScrollViewer>
</UserControl>