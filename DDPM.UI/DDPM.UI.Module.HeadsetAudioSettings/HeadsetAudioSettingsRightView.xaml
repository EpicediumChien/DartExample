                                                            <Button Style="{StaticResource StatelessButton}" Width="16" Height="16" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,12,12,0" KeyboardNavigation.TabIndex="14" AutomationProperties.Name="{Binding SelectedHomeDevice.DeviceInfoToolTipText}">
                                                                <!-- The (i) icon 16x16 -->
