<UserControl x:Class="DDPM.UI.Module.HeadsetAudioSettings.HeadsetAudioSettingsRightView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:local="clr-namespace:DDPM.UI.Module.HeadsetAudioSettings"
             xmlns:d="http://schemas.microsoft.com/expression/bleand/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:plugin="clr-namespace:DDPM.UI.Plugin.ViewModels;assembly=DDPM.UI.Plugin.Common"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             xmlns:common="clr-namespace:DDPM.UI.Common;assembly=DDPM.UI.Common"
             xmlns:lang="clr-namespace:DDPM.UI.Resources.Helper;assembly=DDPM.UI.Resources"
             d:DataContext="{d:DesignInstance Type=plugin:HeadsetViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="655" d:DesignWidth="520">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--<ResourceDictionary Source="/DDPM.UI.Common;component/PluginStyles.xaml" />-->
                <!-- <ResourceDictionary Source="/DDPM.UI.Common;component/ModuleStyle.xaml" /> -->
            </ResourceDictionary.MergedDictionaries>

            <ImageBrush x:Key="UnselectedNodeImage" ImageSource="pack://application:,,,/DDPM.UI.Common;component/Resources/Headset_Dot.png" />
            <ImageBrush x:Key="SelectedNodeImage" ImageSource="pack://application:,,,/DDPM.UI.Common;component/Resources/Headset_whitedot.png" />

            <SolidColorBrush x:Key="SplitItem_BkColor" Color="#FF132F54" />
            <SolidColorBrush x:Key="SplitItem_NormalBdColor" Color="#FF0B1E38" />
            <SolidColorBrush x:Key="SplitItem_SelectedColor" Color="#FF5CC1EE" />

            <LinearGradientBrush x:Key="SplitItem_HoverBdColor" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#FF0672CB" />
                <GradientStop Offset="0.5" Color="#FF0078D4" />
                <GradientStop Offset="1" Color="#FF6E69CF" />
            </LinearGradientBrush>

            <!-- Border Style of Normal State -->
            <Style x:Key="SplitItemBorder_Normal" TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource SplitItem_NormalBdColor}" />
                <Setter Property="BorderThickness" Value="4" />
                <Setter Property="Padding" Value="0" />
            </Style>

            <!-- Border Style of Hover State -->
            <Style x:Key="SplitItemBorder_Hover" TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource SplitItem_HoverBdColor}" />
                <Setter Property="BorderThickness" Value="4" />
                <Setter Property="Padding" Value="0" />
            </Style>

            <!-- Border Style of Selected State -->
            <Style x:Key="SplitItemBorder_Selected" TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource SplitItem_SelectedColor}" />
                <Setter Property="BorderThickness" Value="1.5" />
            </Style>

            <Style x:Key="CollaborationButtonPressedStyle" TargetType="UXControls:UXButton">
                <Setter Property="BorderBrush" Value="{StaticResource SplitItem_HoverBdColor}" />
            </Style>

            <Style x:Key="DotStyle" TargetType="Ellipse">
                <Setter Property="Fill" Value="Blue" />
                <Setter Property="Width" Value="10" />
                <Setter Property="Height" Value="10" />
            </Style>

            <Style x:Key="LineStyle" TargetType="Path">
                <Setter Property="Stroke" Value="Blue" />
                <Setter Property="StrokeThickness" Value="2" />
            </Style>

            <LinearGradientBrush x:Key="GradientBrush" StartPoint="0,0" EndPoint="0,0.4">
                <GradientStop Color="Transparent" Offset="0.5" />
                <GradientStop Color="#0672CB" Offset="0" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="NormalBackground" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#0B1E38" Offset="0.0" />
                <GradientStop Color="#0B1E38" Offset="1.0" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="PressedBackground" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#0672CB" Offset="0.0" />
                <GradientStop Color="#0078D4" Offset="0.46" />
                <GradientStop Color="#6E69CF" Offset="1.1831" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="PressedBorderBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#55B4FD" Offset="0.0045" />
                <GradientStop Color="#6E69CF" Offset="1.0" />
            </LinearGradientBrush>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <local:CollaborationCheckedToVisibilityConverter x:Key="CollaborationCheckedToVisibilityConverter" />
            <local:ValueToVisibilityConverter x:Key="ValueToVisibilityConverter" />
            <local:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <local:BooleanToInverseForegroundConverter x:Key="BooleanToInverseForegroundConverter" />
            <local:BooleanToForegroundConverter x:Key="BooleanToForegroundConverter" />
            <local:BooleanToOpacityConverter x:Key="BooleanToOpacityConverter" />
            <Style x:Key="ToggleButtonTextStyle" TargetType="TextBlock">
                <Style.Triggers>

                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsDarkTheme}" Value="True" />
                            <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Foreground" Value="White" />
                    </MultiDataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsDarkTheme}" Value="True" />
                            <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" Value="False" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Foreground" Value="White" />
                    </MultiDataTrigger>

                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsDarkTheme}" Value="False" />
                            <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Foreground" Value="White" />
                    </MultiDataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsDarkTheme}" Value="False" />
                            <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" Value="False" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Foreground" Value="Black" />
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ToggleButtonPathStyle" TargetType="Path">
                <Style.Triggers>

                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsDarkTheme}" Value="True" />
                            <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Fill" Value="White" />
                    </MultiDataTrigger>

                </Style.Triggers>
            </Style>

            <Style x:Key="ToggleButtonBorderStyle" TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                        <Setter Property="Background" Value="{StaticResource PressedBackground}" />
                        <Setter Property="BorderBrush" Value="{StaticResource PressedBorderBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>


        </ResourceDictionary>
    </UserControl.Resources>
    <!--20250414 Chewlin for PIMS-348204 ADD UseFadingScrolling="False"-->
    <UXControls:UXScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" UseFadingScrolling="False">
        <Grid x:Name="MainGrid">
            <!--Elsa 20250331 for PIMS-348388 change Width="520" to Width="auto" Margin="0,10,10,0" to Margin="0,10,0,16", 20250409 remove Style="{DynamicResource RightGroupBorderStyleForAudio}" Margin="0,10,0,16", add Border.Style -->
            <Border x:Name="MainBorder" CornerRadius="13" Width="auto" Height="auto"  >
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource DefaultTheme_BdBkColor}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorLevel=1,AncestorType=UXControls:UXScrollViewer},Path=ComputedVerticalScrollBarVisibility}" Value="Visible">
                                <Setter Property="Margin" Value="0,10,0,16"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorLevel=1,AncestorType=UXControls:UXScrollViewer},Path=ComputedVerticalScrollBarVisibility}" Value="Collapsed">
                                <Setter Property="Margin" Value="0,10,16,16"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel x:Name="MainStackPanel" Orientation="Vertical" Margin="16, 24, 16, 16">
                    <Grid x:Name="TitleGrid" VerticalAlignment="Top" Margin="0,0,0,0">
                        <!-- Derek 0107 for PIMS-335202 change Width="200" to Width="550"  -->
                        <UXControls:UXTextBlock x:Name="AudioSettingsTextBlock" 
                                    Text="{Binding [AudioSettings], Source={x:Static lang:LangHelper.Instance}}" 
                                                FontFamily="Roboto" FontSize="20"
                                                Foreground="{DynamicResource TextBlock_ForegroundColor}" 
                                                Height="28" Width="550" TextTrimming="CharacterEllipsis"
                                                VerticalAlignment="Center" 
                                                HorizontalAlignment="Left"
                                                Margin="0,6,20,22" />
                        <!-- LIne height is 28 and real width is 40-->
                    </Grid>

                    <!-- Control the noise I hear -->
                    <Grid x:Name="NoiseControlGrid" VerticalAlignment="Top" Margin="0,0,0,20">
                        <!--Elsa 20250409 change Width="488" to Width="auto" -->
                        <Border Visibility="{Binding ControlTheNoiseIHearPageShow, Converter={StaticResource BooleanToVisibilityConverter}}" x:Name="NoiseControlBorder" Style="{DynamicResource RightGroupBorderStyleForAudio}" CornerRadius="6" Width="auto" Height="Auto" VerticalAlignment="Top">
                            <StackPanel x:Name="NoiseControlStackPanel" Orientation="Vertical">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="8">
                                    <UXControls:UXTextBlock x:Name="NoiseControlTextBlock" Text="{Binding [HeadsetAudioSettings.0], Source={x:Static lang:LangHelper.Instance}}" Foreground="{DynamicResource TextBlock_ForegroundColor}" FontSize="16" Margin="8,20,8,20" />
                                    <!--<Image Width="16" Height="16" Margin="0" Source="pack://application:,,,/DDPM.UI.Common;component/Resources/Icon_Info.png" Stretch="Uniform">
                                        <Image.ToolTip>
                                            --><!--Elsa 20250401 for PIMS-348390 change Placement="Left" to Placement="Top",add VerticalOffset="12" MaxWidth="272" Opened="toolTip_Opened"--><!--
