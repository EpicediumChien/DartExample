                                                                <!-- The (i) icon 16x16 -->
                                                                <ContentControl Template="{StaticResource icon_Info}"/>
                                                                <!-- ToolTip -->
                                                                <Button.ToolTip>
                                                                    <!--Elsa 20250401 for PIMS-348390 change HorizontalOffset="0" to HorizontalOffset="2" -->
                                                                    <ToolTip BorderThickness="0" Background="Transparent" Placement="Top" HorizontalOffset="2" VerticalOffset="12" MaxWidth="272">
                                                                        <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                                                            <TextBlock Text="{Binding NoiseCancellingInfoTip}" Style="{StaticResource Tooltip_TextBlockStyle}" LineHeight="20" MaxWidth="230" TextWrapping="WrapWithOverflow"/>
                                                                        </Border>
                                                                    </ToolTip>
                                                                </Button.ToolTip>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="ActiveNoiseCancellingButtonBorder" Property="Background" Value="{StaticResource PressedBackground}" />
                                                            <Setter TargetName="ActiveNoiseCancellingButtonBorder" Property="BorderBrush" Value="{StaticResource PressedBorderBrush}" />
                                                            <Setter TargetName="ActiveNoiseCancellingTextBlock" Property="Foreground" Value="White" />
                                                            <Setter TargetName="ActiveNoiseCancellingPath" Property="Fill" Value="White" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </UXControls:UXToggleSwitch.Template>
                                        </UXControls:UXToggleSwitch>

