                                                <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                                    <Border.Resources>
                                                        <Style BasedOn="{StaticResource Tooltip_TextBlockStyle}" TargetType="TextBlock" />
                                                    </Border.Resources>
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            --><!-- Derek for PIMS-335198 -->
                                                            <!--Elsa 20250401 for PIMS-348390 change MaxWidth="350" to MaxWidth="230" --><!--
                                                            <TextBlock Text="{Binding NoiseControlToolTip}" MaxWidth="230" TextWrapping="WrapWithOverflow"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </ToolTip>
                                        </Image.ToolTip>
                                    </Image>-->
                                    <Button Style="{StaticResource StatelessButton}" Width="16" Height="16" VerticalAlignment="Center" KeyboardNavigation.TabIndex="14" AutomationProperties.Name="{Binding SelectedHomeDevice.DeviceInfoToolTipText}">
                                        <!-- The (i) icon 16x16 -->
                                        <ContentControl Template="{StaticResource icon_Info}"/>
                                        <!-- ToolTip -->
                                        <Button.ToolTip>
                                            <!--Elsa 20250401 for PIMS-348390 change HorizontalOffset="0" to HorizontalOffset="2" -->
                                            <ToolTip BorderThickness="0" Background="Transparent" Placement="Top" HorizontalOffset="2" VerticalOffset="12" Opened="toolTip_Opened" MaxWidth="272">
                                                <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                                    <TextBlock Text="{Binding NoiseControlToolTip}" Style="{StaticResource Tooltip_TextBlockStyle}" LineHeight="20" MaxWidth="230" TextWrapping="WrapWithOverflow"/>
                                                </Border>
                                            </ToolTip>
                                        </Button.ToolTip>
                                    </Button>
                                    <Image Name="LockIcon" Visibility="{Binding isAncModeLocked}" Margin="10,0,0,0"
                                           Source="pack://application:,,,/DDPM.UI.Common;component/Resources/Lock.png"
                                           VerticalAlignment="Center" HorizontalAlignment="Center" Width="16" Height="16">
                                        <Image.ToolTip>
                                            <ToolTip>
                                                <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                                    <Border.Resources>
                                                        <Style BasedOn="{StaticResource Tooltip_TextBlockStyle}" TargetType="TextBlock" />
                                                    </Border.Resources>
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding [ITLockToolTip.0], Source={x:Static lang:LangHelper.Instance}}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </ToolTip>
                                        </Image.ToolTip>
                                    </Image>
                                </StackPanel>
                                <Border x:Name="AncModeLockBorder" CornerRadius="13" >
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Opacity" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding isAncModeLocked}" Value="Visible">
                                                    <Setter Property="Opacity" Value="0.6" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding isAncModeLocked}" Value="Collapsed">
                                                    <Setter Property="Opacity" Value="1" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
