<UserControl x:Class="DDPM.UI.Plugin.WebCameraPlugin.LaunchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             xmlns:common="clr-namespace:DDPM.UI.Common;assembly=DDPM.UI.Common"
             xmlns:DDPMUserControls="clr-namespace:DDPM.UI.Common;assembly=DDPM.UI.Common"
             xmlns:lang="clr-namespace:DDPM.UI.Resources.Helper;assembly=DDPM.UI.Resources"
             mc:Ignorable="d"
             xmlns:PluginCommon="clr-namespace:DDPM.UI.Plugin.Common;assembly=DDPM.UI.Plugin.Common"
             xmlns:plugin="clr-namespace:DDPM.UI.Plugin.ViewModels;assembly=DDPM.UI.Plugin.Common"
             d:DataContext="{d:DesignInstance Type=plugin:WebCameraViewModel}"
             d:DesignHeight="735" d:DesignWidth="1378"
             Cursor="{Binding CurrentCursor}"
             Unloaded="LaunchView_Unloaded">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/DDPM.UI.Common;component/PluginStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <PluginCommon:CenterToolTipConverter x:Key="CenterToolTipConverter" />
      <Storyboard x:Key="StoryGotoTwoView">
        <DoubleAnimation Storyboard.TargetName="RightGrid" Storyboard.TargetProperty="Width"
                                 Duration="0:0:0.4" From="{Binding RightFrameWidthFrom}" To="{Binding RightFrameWidthTo}" FillBehavior="HoldEnd" />
      </Storyboard>
      <Storyboard x:Key="StoryShrink">
        <DoubleAnimation Storyboard.TargetName="largeImage" Storyboard.TargetProperty="MaxWidth" From="900" To="540" Duration="0:0:0.4" AutoReverse="False" />
        <!--<DoubleAnimation Storyboard.TargetName="BottomGrid" Storyboard.TargetProperty="MaxHeight" From="540" To="500" Duration="0:0:0.4" AutoReverse="False" />-->
      </Storyboard>
      <Storyboard x:Key="StoryEnlarge">
        <DoubleAnimation Storyboard.TargetName="largeImage" Storyboard.TargetProperty="MaxWidth" Duration="0:0:0.4" From="540" To="900" />
        <!--<DoubleAnimation Storyboard.TargetName="BottomGrid" Storyboard.TargetProperty="MaxHeight" Duration="0:0:0.4" From="500" To="540" />-->
      </Storyboard>
      <Style x:Key="Border1" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#99193457" />
        <Setter Property="Border.CornerRadius" Value="2" />
        <Setter Property="Width" Value="40" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="#1B385F" />
      </Style>
      <Style x:Key="Border2" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#283547" />
        <Setter Property="Border.CornerRadius" Value="4" />
        <Setter Property="Width" Value="184" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#31A2E3" />
      </Style>
      <Style x:Key="Border3" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#283547" />
        <Setter Property="Border.CornerRadius" Value="4" />
        <Setter Property="Width" Value="184" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#324255" />
      </Style>
      <Style x:Key="TextBlockStyle1" TargetType="UXControls:UXTextBlock">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontFamily" Value="Roboto" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <Style x:Key="btnToolTipStyle" TargetType="ToolTip" BasedOn="{StaticResource InfoToolTipStyle}">
        <Setter Property="Placement" Value="Top" />
        <Setter Property="VerticalOffset" Value="-5" />
        <Setter Property="HorizontalOffset">
          <Setter.Value>
            <MultiBinding Converter="{StaticResource CenterToolTipConverter}">
              <Binding RelativeSource="{RelativeSource Self}" Path="PlacementTarget.ActualWidth" />
              <Binding RelativeSource="{RelativeSource Self}" Path="ActualWidth" />
            </MultiBinding>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <!-- Right side: Header + RightView -->
      <Grid Grid.Column="1" Name="RightGrid" Width="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- RightViewHeader -->
        <common:RightViewHeaderCtrl Grid.Row="0" Name="rightViewHeaderCtrl"
                                            SelectedIndex="{Binding RightViewHeaderSelectedIndex, Mode=TwoWay}"
                                            ItemsSource="{Binding RightViewHeaders, Mode=TwoWay}"
                                            SelectionChanged="RightViewHeaderCtrl_SelectionChanged" />
        <ContentControl Grid.Row="1" Name="RightFrame" Content="{Binding RightView, Mode=TwoWay}" />
      </Grid>
      <!--Layer 2 : Nav and Vbar-->
      <Grid Grid.Column="0" Height="auto">
        <Border Background="#00FF0000" MouseLeftButtonDown="Mainframe_MouseLeftButtonDown" />
        <!--Image-->
        <Grid>
          <Viewbox Name="largeImage" Margin="30,0" MaxHeight="500">
            <Grid>
              <Grid>
                <Image Name="imgDevice" Source="{Binding ImageFilePath}" Stretch="Uniform" MaxWidth="500" />
              </Grid>
              <Grid Width="704" Height="396" x:Name="gridPreview" Margin="0,0,0,12">
                <StackPanel ZIndex ="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock Name="CountdownText" Foreground="WhiteSmoke" FontSize="120" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </StackPanel>
                <!-- Add your camera preview control here -->
                <!-- For example, you can use an Image control or a MediaElement -->

                <!-- Add grid lines -->

                <!-- Your camera preview control goes here -->
                <Image Grid.Row="0"  Grid.RowSpan="3" Grid.Column="0" Grid.ColumnSpan="3" Name="CameraImage" Width="704" Height="396" Stretch="Fill" />

                <!-- Add vertical grid line -->
                <Grid Visibility="{Binding IsChecked_FramingGrid}">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>

                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Rectangle Grid.Row="0" Grid.Column="0" Width="1" Fill="Black" HorizontalAlignment="Right" />
                  <Rectangle Grid.Row="0" Grid.Column="1" Width="1" Fill="Black" HorizontalAlignment="Right" />

                  <Rectangle Grid.Row="1" Grid.Column="0" Width="1"  Fill="Black" HorizontalAlignment="Right" />
                  <Rectangle Grid.Row="1" Grid.Column="1" Width="1" Fill="Black" HorizontalAlignment="Right" />

                  <Rectangle Grid.Row="2" Grid.Column="0" Width="1" Fill="Black" HorizontalAlignment="Right" />
                  <Rectangle Grid.Row="2" Grid.Column="1" Width="1" Fill="Black" HorizontalAlignment="Right" />

                  <!-- Add horizontal grid line -->
                  <Rectangle Grid.Row="0" Grid.Column="0" Height="1" Fill="Black" VerticalAlignment="Bottom" />
                  <Rectangle Grid.Row="0" Grid.Column="1" Height="1" Fill="Black" VerticalAlignment="Bottom" />
                  <Rectangle Grid.Row="0" Grid.Column="2" Height="1" Fill="Black" VerticalAlignment="Bottom" />

                  <Rectangle Grid.Row="1" Grid.Column="0" Height="1" Fill="Black" VerticalAlignment="Bottom" />
                  <Rectangle Grid.Row="1" Grid.Column="1" Height="1" Fill="Black" VerticalAlignment="Bottom" />
                  <Rectangle Grid.Row="1" Grid.Column="2" Height="1" Fill="Black" VerticalAlignment="Bottom" />
                </Grid>
              </Grid>
            </Grid>
          </Viewbox>
        </Grid>
        <!--Vbar-->
        <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Name="VbarGrid">
          <ItemsControl Name="vbarList" Margin="0,10,0,0"
                                  HorizontalAlignment="Right" VerticalAlignment="Top"
                                  ItemsSource="{Binding VbarItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <ContentPresenter />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Grid>
      <!--Name & Model-->
      <Grid VerticalAlignment="Top" HorizontalAlignment="Left">
        <StackPanel Orientation="Vertical">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
            <Image Margin="64,21,0,0" Source="/DDPM.UI.Resources;component/Resources/Images/arrow-left.png" Stretch="Fill"
                               VerticalAlignment="Top" HorizontalAlignment="Left" Cursor="" Width="24" Height="24">
              <Image.InputBindings>
                <MouseBinding Gesture="LeftClick" Command="{Binding GoBackClickedCommand, Mode=OneTime}" />
              </Image.InputBindings>
            </Image>
            <UXControls:UXTextBlock Text="{Binding Name}" Margin="12,19,0,0" HorizontalAlignment="Left"
                                                Style="{StaticResource ProductNameTextStyle}" Cursor="" VerticalAlignment="Top" />
          </StackPanel>
          <StackPanel Orientation="Horizontal">
            <UXControls:UXTextBlock Text="{Binding Model}" Margin="101,18,0,0" HorizontalAlignment="Left"
                                                Style="{StaticResource ModelNumberTextStyle}" />
            <Image Margin="9,22.5,0,0" Source="/DDPM.UI.Resources;component/Resources/Images/info18.png" Stretch="Fill"
                               VerticalAlignment="Top" Cursor="" Width="16" Height="16">
              <Image.InputBindings>
                <MouseBinding Gesture="RightDoubleClick" Command="{Binding ShowInfoClickedCommand}" />
              </Image.InputBindings>
              <Image.ToolTip>
                <ToolTip Style="{StaticResource InfoToolTipStyle}" Placement="Top" VerticalOffset="6" HorizontalOffset="8">
                  <TextBlock Style="{StaticResource InfoToolTipTextStyle}" Text="{Binding FirmwareVersion2}" />
                </ToolTip>
              </Image.ToolTip>
            </Image>
          </StackPanel>
        </StackPanel>
      </Grid>
      <!--Battery-->
      <Grid VerticalAlignment="Bottom">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <DDPMUserControls:BatteryIndicator  Margin="0,0,0,70" HorizontalAlignment="Center" ConnectionType="{Binding ConnectionType}" VerticalAlignment="Bottom" />
          <StackPanel Orientation="Horizontal" Visibility="{Binding FunctionsVisibility}">
            <Border Style="{StaticResource Border1}" Cursor="Hand" Margin="8,0,0,70" Visibility="Visible" x:Name="btnFolder" Height="40" VerticalAlignment="Bottom" MouseLeftButtonDown="btnFolder_Click">
              <Border.ToolTip>
                <ToolTip Style="{StaticResource btnToolTipStyle}">
                  <TextBlock Style="{StaticResource KeyToolTipTextStyle}" Text="{Binding [Camera.7], Source={x:Static lang:LangHelper.Instance}}" />
                </ToolTip>
              </Border.ToolTip>
              <Image Margin="0" Source="/DDPM.UI.Resources;component/Resources/Images/Folder.png" Stretch="Fill" Width="17" Height="16" />
            </Border>
            <Border Style="{StaticResource Border1}" Cursor="Hand" Margin="8,0,0,70" Visibility="Collapsed" x:Name="btnPause" Height="40" VerticalAlignment="Bottom" MouseLeftButtonDown="btnPause_Click">
              <Border.ToolTip>
                <ToolTip Style="{StaticResource btnToolTipStyle}">
                  <TextBlock Style="{StaticResource KeyToolTipTextStyle}" Text="{Binding [Camera.9], Source={x:Static lang:LangHelper.Instance}}" />
                </ToolTip>
              </Border.ToolTip>
              <Image Margin="0" Source="/DDPM.UI.Resources;component/Resources/Images/Pause.png" Stretch="Fill" Width="17" Height="16" />
            </Border>
            <Border Style="{StaticResource Border1}" Cursor="Hand" Margin="8,0,0,70" Visibility="Collapsed" x:Name="btnPlay" Height="40" VerticalAlignment="Bottom" MouseLeftButtonDown="btnPlay_Click">
              <Border.ToolTip>
                <ToolTip Style="{StaticResource btnToolTipStyle}">
                  <TextBlock Style="{StaticResource KeyToolTipTextStyle}" Text="{Binding [Camera.10], Source={x:Static lang:LangHelper.Instance}}" />
                </ToolTip>
              </Border.ToolTip>
              <Image Margin="0" Source="/DDPM.UI.Resources;component/Resources/Images/Play.png" Stretch="Fill" Width="13" Height="14" />
            </Border>
            <Border Style="{StaticResource Border1}" Cursor="Hand" Margin="8,0,0,70" Visibility="Visible" x:Name="btnRecord" MouseLeftButtonDown="btnRecord_Click" Height="40" VerticalAlignment="Bottom">
              <Border.ToolTip>
                <ToolTip Style="{StaticResource btnToolTipStyle}">
                  <TextBlock Style="{StaticResource KeyToolTipTextStyle}" Text="{Binding [Camera.8], Source={x:Static lang:LangHelper.Instance}}" />
                </ToolTip>
              </Border.ToolTip>
              <Image Margin="0" Source="/DDPM.UI.Resources;component/Resources/Images/RedCircle.png" Stretch="Fill" Width="17" Height="16" />
            </Border>
            <Border Style="{StaticResource Border1}" Cursor="Hand" Margin="8,0,0,70" Visibility="Collapsed" x:Name="btnStop" MouseLeftButtonDown="btnStop_Click" Height="40" VerticalAlignment="Bottom">
              <Border.ToolTip>
                <ToolTip Style="{StaticResource btnToolTipStyle}">
                  <TextBlock Style="{StaticResource KeyToolTipTextStyle}" Text="{Binding [Camera.11], Source={x:Static lang:LangHelper.Instance}}" />
                </ToolTip>
              </Border.ToolTip>
              <Image Margin="0" Source="/DDPM.UI.Resources;component/Resources/Images/RedSquare.png" Stretch="Fill" Width="17" Height="16" />
            </Border>
            <StackPanel Orientation="Vertical">
              <StackPanel Name="spPresets" Orientation="Vertical" Visibility="Collapsed">
                <Border Margin="8,0,0,6" Style="{StaticResource Border3}">
                  <DockPanel Name="SearchPanel" Margin="15,2,2,8" MaxHeight="160">
                    <UXControls:UXScrollViewer x:Name="svAction" VerticalScrollBarVisibility="Auto">
                      <ItemsControl Name="ProfileItems">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Grid Height="30" Margin="0,5,0,0">
                              <StackPanel Orientation="Horizontal" Width="110" HorizontalAlignment="Left">
                                <UXControls:UXTextBlock Cursor="Hand" Margin="0" Tag="{Binding ID}" Text="{Binding Caption}" HorizontalAlignment="Left" MouseLeftButtonDown="ProfileSelected" FontFamily="Roboto" FontSize="14" VerticalAlignment="Center" />
                                <Image Margin="8,0,0,0" Source="/DDPM.UI.Resources;component/Resources/Images/info.png" Visibility="{Binding TooltipVisibility}" Stretch="Fill" Width="16" Height="16" HorizontalAlignment="Right" MouseLeftButtonDown="DeletePreset">
                                  <Image.ToolTip>
                                    <ToolTip Style="{StaticResource InfoToolTipStyle}" Placement="Top" VerticalOffset="6" HorizontalOffset="8">
                                      <TextBlock Style="{StaticResource TabInfoToolTipTextStyle}" Text="{Binding Tooltip}"/>
                                    </ToolTip>
                                  </Image.ToolTip>
                                </Image>
                              </StackPanel>
                              <StackPanel Margin="0,0,0,0" Orientation="Horizontal" Visibility="{Binding ButtonVisibility}" HorizontalAlignment="Right">
                                <Image Margin="0" Source="/DDPM.UI.Resources;component/Resources/Images/Pen.png" Cursor="Hand" Stretch="Fill" Width="16" Height="16" HorizontalAlignment="Right" MouseLeftButtonDown="EditPreset" />
                                <Image Margin="8,0,0,0" Source="/DDPM.UI.Resources;component/Resources/Images/TrashCan.png" Cursor="Hand" Stretch="Fill" Width="16" Height="16" HorizontalAlignment="Right" MouseLeftButtonDown="DeletePreset" />
                              </StackPanel>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </UXControls:UXScrollViewer>
                  </DockPanel>
                </Border>
                <Border Margin="8,0,0,12" Style="{StaticResource Border3}" Cursor="Hand" Height="36">
                  <UXControls:UXTextBlock Name="txtAddPreset" Style="{StaticResource TextBlockStyle1}" HorizontalAlignment="Center" />
                </Border>
              </StackPanel>
              <Border Margin="8,0,0,70" Style="{StaticResource Border2}" Cursor="Hand" x:Name="btnPreset" MouseLeftButtonDown="btnPreset_Click">
                <Grid>
                  <Image Margin="10,12,0,12" Source="/DDPM.UI.Resources;component/Resources/Images/CameraPreset.png" Stretch="Fill" Width="17" Height="16" HorizontalAlignment="Left" />
                  <UXControls:UXTextBlock Name="txtPreset" Margin="35,0,0,0" Style="{StaticResource TextBlockStyle1}" />
                  <Image Name="imgDown" Source="/DDPM.UI.Resources;component/Resources/Images/Down.png" Stretch="Uniform" Margin="0,0,10,0"
                         Style="{StaticResource ActionArrowStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand" Width="12" Height="12"/>
                </Grid>
              </Border>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Grid>
      <!--Alert-->
      <Grid VerticalAlignment="Center">
        <Border Name="bdrAlert" Background="#364861" CornerRadius="4" Margin="0" BorderThickness="7,0,0,0" BorderBrush="#0E92F2" Width="317" Visibility="{Binding AlertVisibility}" >
          <StackPanel Orientation="Horizontal">
            <Image x:Name="InfoIcon" Margin="10,0,0,0" Source="/DDPM.UI.Resources;component/Resources/Images/info18.png" Stretch="Fill"
                               VerticalAlignment="Center" HorizontalAlignment="Left" Width="18" Height="18">
            </Image>
            <UXControls:UXTextBlock Name="txtAlert" AutomationProperties.Name="Description" FontSize="13" Background="#364861" Foreground="#F5F6F7" TextWrapping="Wrap" Width="260" Text="{Binding AlertText}"
                                    VerticalAlignment="Top" HorizontalAlignment="Left" Margin="8,0,0,0" LineHeight="19.5" Padding="0,18,0,16" FontFamily="Roboto" FontWeight="Normal" />
          </StackPanel>
        </Border>
      </Grid>
      <!--Timer-->
      <Grid VerticalAlignment="Bottom" HorizontalAlignment="Center">
        <UXControls:UXTextBlock Name="txtTimer" AutomationProperties.Name="Description" FontSize="16" Background="Transparent" Foreground="#FBA433" TextWrapping="Wrap" Text="00:00:00"
                                VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,0,0,118" FontFamily="Roboto" FontWeight="Normal" Visibility="Collapsed" />
      </Grid>
    </Grid>
  </Grid>
</UserControl>