<Window x:Class="DDPM.UI.Plugin.WalkThroughPlugin.WalkThroughBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DDPM.UI.Plugin.WalkThroughPlugin" 
        mc:Ignorable="d"
        xmlns:controls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
        xmlns:lang="clr-namespace:DDPM.UI.Resources.Helper;assembly=DDPM.UI.Resources"
        Title="WalkThroughBox"   
        ResizeMode="NoResize"  
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="419"
        Height="226">
    <Border BorderThickness="0" Background="{DynamicResource WalkThroughBox_BkColor}" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <controls:UXTextBlock Name="HeaderText" Grid.Row="0" Margin="36,36,45,24" FontFamily="Roboto" FontSize="20"  Text="{Binding strTitle}" />
            <controls:UXTextBlock Name="SubHeaderText" Grid.Row="1" MaxWidth="372" MaxHeight="54" Margin="36,-75,24,8" FontFamily="Roboto" FontSize="16"  Text="{Binding strContent}" TextWrapping="WrapWithOverflow" />

            <!-- Button panel with ArrowButton, NextBtn, and SkipBtn -->
            <StackPanel Name="ButtonPanel" Grid.Row="2" Margin="0,20,0,10" Orientation="Horizontal" Visibility="{Binding isButtonsShown}">
                <controls:UXButton x:Name="ArrowButton" Visibility="{Binding ArrowButtonVisibility}" Width="48" Height="40" ButtonType="Secondary" ButtonSize="Medium" IconAnimation="Move" Margin="36,-144,0,0" Padding="16,8" Foreground="#F5F6F7" BorderBrush="{DynamicResource DefaultTheme_PbHeaderColor}" Click="ArrowButton_Click">
                    <Path Data="M3.62037 11.6746L3.34146 12L3.62037 12.3254L9.62037 19.3254L10.3796 18.6746L5.08711 12.5L21 12.5L21 11.5L5.08711 11.5L10.3796 5.32538L9.62037 4.67459L3.62037 11.6746Z" Fill="{DynamicResource DefaultTheme_PbHeaderColor}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </controls:UXButton>

                <!-- Next Button -->
                <controls:UXButton x:Name="NextBtn" IconPosition="IconRight" HorizontalContentAlignment="Center" ButtonType="Primary" Padding="40, 8" ButtonSize="Medium" VerticalContentAlignment="Center" Margin="16,-144,0,0" IconAnimation="Move" Width="164" Height="40" Click="NextBtn_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <controls:UXTextBlock Margin="8,0" Text="{Binding [NextStr_0], Source={x:Static lang:LangHelper.Instance}, Mode=OneWay}" Foreground="White"/>
                        <Path x:Name="ArrowPath" Margin="0,2" Data="M17.3796 8.3256L17.6585 8.0002L17.3796 7.67481L11.3796 0.674805L10.6204 1.3256L15.9129 7.5002H0V8.5002H15.9129L10.6204 14.6748L11.3796 15.3256L17.3796 8.3256Z" Fill="white">
                            <Path.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Path.RenderTransform>
                        </Path>
                    </StackPanel>

                    <!-- Mouse enter animation -->
                    <controls:UXButton.Triggers>
                        <EventTrigger RoutedEvent="MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="ArrowPath" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" From="1" To="1.2" Duration="0:0:1" AutoReverse="True" RepeatBehavior="Forever" />
                                    <DoubleAnimation Storyboard.TargetName="ArrowPath" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" From="1" To="1.2" Duration="0:0:1" AutoReverse="True" RepeatBehavior="Forever" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="ArrowPath" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2" />
                                    <DoubleAnimation Storyboard.TargetName="ArrowPath" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </controls:UXButton.Triggers>
                </controls:UXButton>

                <!-- Skip Button -->
                <controls:UXButton x:Name="SkipBtn" Visibility="{Binding SkipButtonVisibility}" ButtonType="Tertiary" Width="90" Height="40" ButtonSize="Medium" Margin="10, -144, 0, 0" Content="{Binding [WalkThrough.1], Source={x:Static lang:LangHelper.Instance}, Mode=OneWay}" IconAnimation="Move" Click="SkipBtn_Click" />
            </StackPanel>

            <!-- ProgressBar -->
            <Grid Grid.Row="3">
                <ProgressBar x:Name="WalkThroughProgressbar" Margin="36,-80,0,0" Background="{DynamicResource ProgressBar_BkColor}" BorderThickness="0" HorizontalAlignment="Left" Height="5" Width="353" Minimum="0" Maximum="{Binding CurrentAnimationPage}" Value="{Binding ProgressValue}">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Foreground" Value="#A4B8CD" />
                        </Style>
                    </ProgressBar.Style>

                    <ProgressBar.Triggers>
                        <EventTrigger RoutedEvent="ProgressBar.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Value" From="0" To="{Binding ProgressValue}" Duration="0:0:1" FillBehavior="HoldEnd" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ProgressBar.Triggers>
                </ProgressBar>
            </Grid>
        </Grid>
    </Border>
</Window>
