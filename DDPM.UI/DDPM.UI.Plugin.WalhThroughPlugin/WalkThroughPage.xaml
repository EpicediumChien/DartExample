<UserControl x:Class="DDPM.UI.Plugin.WalkThroughPlugin.WalkThroughPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:common="clr-namespace:DDPM.UI.Common;assembly=DDPM.UI.Common"
             xmlns:lang="clr-namespace:DDPM.UI.Resources.Helper;assembly=DDPM.UI.Resources"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             mc:Ignorable="d"     
             d:DesignHeight="671" 
             d:DesignWidth="1378">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=UserControl}}" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}}">
        <!--<Image x:Name="imgBkGlow"
               Source="pack://application:,,,/DDPM.UI.Common;component/Resources/Background_Glow.png"
               Stretch="UniformToFill"
               HorizontalAlignment="Center" VerticalAlignment="Center" />-->
        <!--<Image x:Name="imgBkGlow" Source="pack://application:,,,/DDPM.UI.Common;component/Resources/Background_Glow.png" Stretch="UniformToFill" HorizontalAlignment="Center"  VerticalAlignment="Center" />-->
        <StackPanel VerticalAlignment="Center">
            <!--ConsentPageVisibility-->
            <Grid Margin="0" Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                      Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      Visibility="{Binding ConsentPageVisibility, FallbackValue=Collapsed}"
                      VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border CornerRadius="4" Height="320" Width="801" BorderBrush="#2D000000" BorderThickness="0.5" Background="{StaticResource FakeTransparent}">
                    <Border.Effect>
                        <DropShadowEffect Color="#2D000000" BlurRadius="5" ShadowDepth="1" Opacity="0.4"/>
                    </Border.Effect>
                </Border>
                <Border CornerRadius="4" Height="320" Width="801" Background="{DynamicResource DDPMBackground}">
                    <Grid>
                        <!--<Image Source="/DDPM.UI.Resources;component/Resources/Images/ConsentBg.png" Stretch="Fill" Opacity="0.2" />-->
                        <StackPanel Orientation="Vertical" Margin="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <UXControls:UXTextBlock Name="txtCaption" VerticalAlignment="Center" FontWeight="Light" HorizontalAlignment="Center" FontFamily="Roboto" FontSize="40" Margin="0" Text="{Binding [Consent.1], Source={x:Static lang:LangHelper.Instance}}" />
                            <UXControls:UXTextBlock Name="txtCaption2" VerticalAlignment="Center" FontWeight="Light" HorizontalAlignment="Center" FontFamily="Roboto" FontSize="40" Margin="0,0,0,10" Text="{Binding [AppName], Source={x:Static lang:LangHelper.Instance}}" />
                            <UXControls:UXTextBlock Name="txtMessage" VerticalAlignment="Center" FontWeight="Normal" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" FontFamily="Roboto" FontSize="16" LineHeight="24" Width="660" >
                                <Run Name="txt1" FontFamily="Roboto" FontWeight="Normal" Text="{Binding [Consent.2], Source={x:Static lang:LangHelper.Instance}, Mode=OneWay}"/>
                                <Run Name="txt2" FontFamily="Roboto" FontWeight="Normal" Cursor="Hand" TextDecorations="Underline" MouseLeftButtonDown="OpenPrivacy" Text="{Binding [Analytics.2], Source={x:Static lang:LangHelper.Instance}, Mode=OneWay}" />
                            </UXControls:UXTextBlock>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30,0,0">
                                <Button x:Name="txtNo" Style="{StaticResource SecondaryButtonStyle}" Click="No_MouseLeftButtonDown" Content="{Binding [ConsentNo], Source={x:Static lang:LangHelper.Instance}}" />
                                <Button x:Name="txtYes" Style="{StaticResource PrimaryButtonStyle}" Margin="12,0,0,0" Click="Yes_MouseLeftButtonDown" Content="{Binding [ConsentYes], Source={x:Static lang:LangHelper.Instance}}" />
                                <!--<UXControls:UXButton Name="txtNo" MinWidth="136.5" MinHeight="40" HorizontalAlignment="Center" ButtonType="Secondary" Click="No_MouseLeftButtonDown" Content="N/A" FontFamily="Roboto" FontSize="14" FontWeight="Medium" CornerRadius="2"/>
                                    <UXControls:UXButton Name="txtYes" MinWidth="136.5" MinHeight="40" Margin="12,0,0,0" ButtonType="Primary" HorizontalAlignment="Center" Click="Yes_MouseLeftButtonDown" Content="N/A" FontFamily="Roboto" FontSize="14" FontWeight="Medium" CornerRadius="2" />-->
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </StackPanel>

        <StackPanel VerticalAlignment="Center">
            <Grid Margin="0" Visibility="{Binding PeripheralVisibility}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" MinWidth="670" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="76, 60, 0, 0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Progress Bar -->
                    <!--<Grid Grid.Row="0">-->
                    <ProgressBar Grid.Row="0" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                                 x:Name="WalkThroughProgressbar" Background="{DynamicResource ProgressBar_BkColor}" BorderThickness="0" HorizontalAlignment="Left" Height="5" Minimum="0" Maximum="{Binding CurrentAnimationPage}" Value="{Binding ProgressValue}">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Foreground" Value="#A4B8CD" />
                            </Style>
                        </ProgressBar.Style>

                        <ProgressBar.Triggers>
                            <EventTrigger RoutedEvent="ProgressBar.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Value" From="0" To="{Binding ProgressValue}" Duration="0:0:1" FillBehavior="HoldEnd" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ProgressBar.Triggers>
                    </ProgressBar>
                    <!--</Grid>-->

                    <!-- Feature Highlight Title -->
                    <!--<Grid Grid.Row="1" Margin="0, 50, 0, 0" Width="196" HorizontalAlignment="Left">-->
                    <UXControls:UXTextBlock Grid.Row="1" Margin="0, 50, 0, 0" HorizontalAlignment="Left" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                                                Foreground="{DynamicResource DefaultTheme_PbHeaderColor}" Text="{Binding [WalkThrough.0], Source={x:Static lang:LangHelper.Instance}, Mode=OneWay}" FontSize="20" LineHeight="28" />
                    <!--</Grid>-->

                    <!-- Customizable Keys Title -->
                    <!--<Grid Grid.Row="2" Margin="0, 8, 0, 0" Width="476" HorizontalAlignment="Left">-->
                    <UXControls:UXTextBlock Grid.Row="2" Margin="0, 8, 0, 0" HorizontalAlignment="Left" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                                                x:Name="MainText" Text="{Binding MainText}" FontSize="58" TextWrapping="Wrap"/>
                    <!--</Grid>-->

                    <!-- Description Text -->
                    <!--<Grid Grid.Row="3" Margin="0, 16, 0, 0" Width="476" HorizontalAlignment="Left">-->
                    <UXControls:UXTextBlock Grid.Row="3" Margin="0, 16, 0, 0" HorizontalAlignment="Left" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                                                x:Name="SubText" Text="{Binding SubText}"  FontSize="15"  TextWrapping="Wrap" />
                    <!--</Grid>-->
                </Grid>

                <!-- Buttons -->
                <Grid Grid.Column="0" Margin="72,532, 0, 76">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- First Button Group -->
                    <Grid Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <UXControls:UXButton x:Name="ArrowButton" Visibility="{Binding ArrowButtonVisibility}" Width="48" Height="40" ButtonType="Secondary" ButtonSize="Medium" IconAnimation="Move" Margin="0" Padding="16,8" Click="ArrowButton_Click">
                                <Path Data="M3.62037 11.6746L3.34146 12L3.62037 12.3254L9.62037 19.3254L10.3796 18.6746L5.08711 12.5L21 12.5L21 11.5L5.08711 11.5L10.3796 5.32538L9.62037 4.67459L3.62037 11.6746Z" Fill="{DynamicResource DefaultTheme_PbHeaderColor}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </UXControls:UXButton>
                            <!-- Next Button -->
                            <!--<UXControls:UXButton x:Name="NextBtn" IconPosition="IconRight" HorizontalContentAlignment="Center" ButtonType="Primary" Padding="40, 8" ButtonSize="Medium" VerticalContentAlignment="Center" Content="{Binding [Kvm.1], Source={x:Static lang:LangHelper.Instance}}" ContentStringFormat="{}{0} ⭢" Margin="10, 0, 0, 0" IconAnimation="Move" Width="164" Height="40" Click="NextBtn_Click" />-->
                            <!-- Elsa 20250116 change Width="164" to MinWidth="164" for Next Button's Text clipping -->
                            <UXControls:UXButton x:Name="NextBtn" IconPosition="IconRight" HorizontalContentAlignment="Center" ButtonType="Primary" Padding="20, 8" ButtonSize="Medium" VerticalContentAlignment="Center" Margin="10, 0, 0, 0" IconAnimation="Move" MinWidth="164" Height="40" Click="NextBtn_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <UXControls:UXTextBlock Margin="8,0" Text="{Binding [Kvm.1], Source={x:Static lang:LangHelper.Instance}}" Foreground="White"
                                                            Visibility="{Binding SkipButtonVisibility}"/>
                                    <UXControls:UXTextBlock Margin="8,0" Text="{Binding [Finish], Source={x:Static lang:LangHelper.Instance}}" Foreground="White"
                                                            Visibility="{Binding FinishButtonVisibility}"/>
                                    <Path x:Name="ArrowPath" Margin="0,2" Data="M17.3796 8.3256L17.6585 8.0002L17.3796 7.67481L11.3796 0.674805L10.6204 1.3256L15.9129 7.5002H0V8.5002H15.9129L10.6204 14.6748L11.3796 15.3256L17.3796 8.3256Z" Fill="white"
                                          Visibility="{Binding SkipButtonVisibility}">
                                        <Path.RenderTransform>
                                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                                        </Path.RenderTransform>
                                    </Path>
                                </StackPanel>

                                <!-- 滑鼠進入觸發 -->
                                <UXControls:UXButton.Triggers>
                                    <EventTrigger RoutedEvent="MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <!-- 放大縮小 -->
                                                <DoubleAnimation Storyboard.TargetName="ArrowPath" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" From="1" To="1.2" Duration="0:0:1" AutoReverse="True" RepeatBehavior="Forever" />
                                                <DoubleAnimation Storyboard.TargetName="ArrowPath" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" From="1" To="1.2" Duration="0:0:1" AutoReverse="True" RepeatBehavior="Forever" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>

                                    <!-- 定滑鼠離開停止 -->
                                    <EventTrigger RoutedEvent="MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <!-- 停止，縮回原大小 -->
                                                <DoubleAnimation Storyboard.TargetName="ArrowPath" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="ArrowPath" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </UXControls:UXButton.Triggers>
                            </UXControls:UXButton>
                        </StackPanel>
                    </Grid>

                    <!-- Second Button Group -->
                    <!-- Elsa 20250116 change Width="90" to MinWidth="90" forSecond Button's Text clipping -->
                    <Grid Grid.Column="1">
                        <UXControls:UXButton x:Name="SkipBtn" Visibility="{Binding SkipButtonVisibility}" ButtonType="Tertiary" MinWidth="90" Height="40" ButtonSize="Medium" Margin="10, 0" Content="{Binding [WalkThrough.1], Source={x:Static lang:LangHelper.Instance}}" IconAnimation="Move" Click="SkipBtn_Click"/>
                    </Grid>
                </Grid>

                <!-- Keyboard Image -->
                <Grid Grid.Column="1" Margin="64, 64, 96, 0" HorizontalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Image x:Name="MainImage" Grid.Row="0" Source="{Binding DeviceImage}" HorizontalAlignment="Center"  VerticalAlignment="Center" Width="670"  Height="535" />
                </Grid>
            </Grid>
        </StackPanel>

        <StackPanel VerticalAlignment="Center">
            <Grid Margin="0" Visibility="{Binding DDPMVisibility}" Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}" 
                  Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="1378" Height="735">
                    <!-- 第一張圖片 -->
                    <Image x:Name="img1" Width="550" Height="292" Source="{Binding Img1Source}" Stretch="UniformToFill" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="146,368,0,0" />

                    <!-- 第二張圖片，位於第一張圖片之上 -->
                    <Image x:Name="img2" Width="683" Height="343" Source="{Binding Img2Source}" Stretch="UniformToFill" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="561,317,0,0" />
                </Grid>
                
                <!-- 避免圖片遮到按鈕 -->
                <Grid Margin="0, 0, 0, 0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Customizable Keys Title -->
                    <Grid Grid.Row="0" Margin="0, 20, 0, 0" Width="Auto" Height="Auto" HorizontalAlignment="Center">
                        <UXControls:UXTextBlock x:Name="AppMainText" Text="{Binding [WalkThroughDDPM_Main.0], Source={x:Static lang:LangHelper.Instance}, Mode=OneWay}" FontSize="64" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                    </Grid>

                    <!-- Description Text -->
                    <Grid Grid.Row="1" Margin="0, 16, 0, 0" Width="Auto" Height="Auto" HorizontalAlignment="Center">
                        <UXControls:UXTextBlock x:Name="AppSubText" Text="{Binding [WalkThroughDDPM_Sub.0], Source={x:Static lang:LangHelper.Instance}, Mode=OneWay}"  FontSize="18" TextWrapping="Wrap" />
                    </Grid>


                    <!-- First Button Group -->
                    <Grid Grid.Row="2" Margin="0, 16, 0, 0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <!-- Next Button -->
                            <!-- Elsa 20250116 change Width="194" to MinWidth="194" for Next Button's text clipping -->
                            <UXControls:UXButton x:Name="MainNextBtn" IconPosition="IconRight" HorizontalContentAlignment="Center" ButtonType="Primary" Padding="40, 8" ButtonSize="Medium" VerticalContentAlignment="Center" Margin="-5, 0, 0, 0" IconAnimation="Move" MinWidth="194" Height="40" Click="MainNextBtn_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <UXControls:UXTextBlock Margin="8,0" Text="{Binding [WalkThrough.2], Source={x:Static lang:LangHelper.Instance}}" Foreground="White"/>
                                    <Path x:Name="MainArrowPath" Margin="0,2" Data="M17.3796 8.3256L17.6585 8.0002L17.3796 7.67481L11.3796 0.674805L10.6204 1.3256L15.9129 7.5002H0V8.5002H15.9129L10.6204 14.6748L11.3796 15.3256L17.3796 8.3256Z" Fill="white">
                                        <Path.RenderTransform>
                                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                                        </Path.RenderTransform>
                                    </Path>
                                </StackPanel>

                                <!-- 滑鼠進入觸發 -->
                                <UXControls:UXButton.Triggers>
                                    <EventTrigger RoutedEvent="MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <!-- 放大縮小 -->
                                                <DoubleAnimation Storyboard.TargetName="MainArrowPath" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" From="1" To="1.2" Duration="0:0:1" AutoReverse="True" RepeatBehavior="Forever" />
                                                <DoubleAnimation Storyboard.TargetName="MainArrowPath" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" From="1" To="1.2" Duration="0:0:1" AutoReverse="True" RepeatBehavior="Forever" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>

                                    <!-- 定滑鼠離開停止 -->
                                    <EventTrigger RoutedEvent="MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <!-- 停止，縮回原大小 -->
                                                <DoubleAnimation Storyboard.TargetName="MainArrowPath" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="MainArrowPath" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </UXControls:UXButton.Triggers>
                            </UXControls:UXButton>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Keyboard Image -->
                <Grid Grid.Row="3" Margin="64, 64, 96, 0" HorizontalAlignment="Center">
                    <Image x:Name="MainAppImage1" Grid.Row="0" Source="{Binding AppDeviceImage}" HorizontalAlignment="Center"  VerticalAlignment="Center" Width="721"  Height="384" />
                    <Image x:Name="MainAppImage2" Grid.Row="0" Source="{Binding AppDeviceImage}" HorizontalAlignment="Center"  VerticalAlignment="Center" Width="682"  Height="364" />
                </Grid>
            </Grid>
        </StackPanel>
        <StackPanel VerticalAlignment="Center">
            <Grid Margin="0" Visibility="{Binding OtherVisibility}">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="1378" Height="735">
                    <Image x:Name="img3" Width="1378" Height="671" Source="{Binding Img3Source}" Stretch="UniformToFill" VerticalAlignment="Top"  />
                </Grid>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
