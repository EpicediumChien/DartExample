<UserControl x:Class="DDPM.UI.Module.DisplayOthers.DisplayOthersRightView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             xmlns:lang="clr-namespace:DDPM.UI.Resources.Helper;assembly=DDPM.UI.Resources"
             xmlns:local="clr-namespace:DDPM.UI.Module.DisplayOthers"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800" Loaded="Window_Loaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- <ResourceDictionary Source="/DDPM.UI.Common;component/ModuleStyle.xaml" /> -->
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <!--Elsa 202504011 for PIMS-348407 add VerticalScrollBarVisibility="Auto"-->
        <UXControls:UXScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource RightGroupBorderStyle}">
                    <StackPanel>
                        <StackPanel.Resources>
                            <Style TargetType="{x:Type UXControls:UXTextBlock}">
                                <Setter Property="Foreground" Value="{DynamicResource DefaultTheme_TxtColor}" />
                                <Setter Property="FontSize" Value="16" />
                                <Setter Property="Margin" Value="16,12,0,12" />
                                <Setter Property="HorizontalAlignment" Value="Left" />
                            </Style>
                        </StackPanel.Resources>
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <UXControls:UXTextBlock Grid.Column="0" Text="{Binding [PowerNap], Source={x:Static lang:LangHelper.Instance}}"
                                                                TextBlockSemanticColorType="Light" TextBlockType="Caption"
                                                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                FontSize="20" LineHeight="28" />
                                        <Grid Grid.Column="1" Margin="8,0" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#00000000">
                                            <Path Data="M8 0C6.41775 0 4.87103 0.469192 3.55544 1.34824C2.23985 2.22729 1.21447 3.47672 0.608967 4.93853C0.00346625 6.40034 -0.15496 8.00887 0.153721 9.56072C0.462403 11.1126 1.22433 12.538 2.34315 13.6569C3.46197 14.7757 4.88743 15.5376 6.43928 15.8463C7.99113 16.155 9.59966 15.9965 11.0615 15.391C12.5233 14.7855 13.7727 13.7602 14.6518 12.4446C15.5308 11.129 16 9.58225 16 8C16 5.87827 15.1571 3.84344 13.6569 2.34315C12.1566 0.842855 10.1217 0 8 0ZM8 14.93C6.62938 14.93 5.28953 14.5236 4.1499 13.7621C3.01027 13.0006 2.12203 11.9183 1.59752 10.652C1.073 9.3857 0.935766 7.99231 1.20316 6.64802C1.47056 5.30374 2.13058 4.06893 3.09975 3.09975C4.06893 2.13057 5.30374 1.47055 6.64803 1.20316C7.99232 0.935762 9.38571 1.073 10.652 1.59751C11.9183 2.12203 13.0006 3.01027 13.7621 4.1499C14.5236 5.28953 14.93 6.62938 14.93 8C14.9274 9.83714 14.1964 11.5983 12.8973 12.8973C11.5983 14.1964 9.83714 14.9274 8 14.93Z
                                                        M7.36 3.36H8.64V4.64H7.36V3.36Z M7.36 6.24H8.64V12.64H7.36V6.24Z" 
                                         HorizontalAlignment="Left" Width="16">
                                            </Path>
                                            <Grid.ToolTip>
                                                <!--Elsa 20250407 for PIMS-348390 change Placement="Center" to Placement="Top" VerticalOffset="45" to VerticalOffset="12",add HorizontalOffset="2" MaxWidth="272 -->
                                                <ToolTip Placement="Top" VerticalOffset="12" HorizontalOffset="2" MaxWidth="272">
                                                    <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                                        <Border.Resources>
                                                            <Style BasedOn="{StaticResource Tooltip_TextBlockStyle}" TargetType="TextBlock" />
                                                        </Border.Resources>
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <!--Elsa 20250407 for PIMS-348390 add MaxWidth="230" TextWrapping="WrapWithOverflow" -->
                                                                <TextBlock Text="{Binding [DisplayOthers.3], Source={x:Static lang:LangHelper.Instance}}" MaxWidth="230" TextWrapping="WrapWithOverflow" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </ToolTip>
                                            </Grid.ToolTip>
                                        </Grid>
                                        <Grid Grid.Column="2" VerticalAlignment="Center" Margin="8" Background="#00000000" Visibility="{Binding LockPowerNap_Visibility}">
                                            <Path Data="M11.0998 6.4V4C11.1998 1.8 9.4998 0.1 7.2998 0H7.0998C4.89981 0 3.0998 1.8 3.0998 4V6.4H0.799805V16H13.0998V6.4H11.0998ZM4.2998 4C4.19981 2.5 5.3998 1.3 6.7998 1.2H7.1998C8.7998 1.2 9.9998 2.5 9.9998 4V6.4H4.2998V4ZM12.0998 14.9H1.9998V7.5H12.0998V14.9Z"/>
                                            <Path Data="M6.5998 12.5H7.5998V9.3H5.7998V10.3H6.5998V12.5Z" />
                                            <Grid.ToolTip>
                                                <ToolTip>
                                                    <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                                        <Border.Resources>
                                                            <Style BasedOn="{StaticResource Tooltip_TextBlockStyle}" TargetType="TextBlock" />
                                                        </Border.Resources>
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding [ITLockToolTip.0], Source={x:Static lang:LangHelper.Instance}}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </ToolTip>
                                            </Grid.ToolTip>
                                        </Grid>
                                    </Grid>
                                    <UXControls:UXToggleSwitch Grid.Column="1" ContentPlacement="Left" ContentTextVisibility="True"
                                                               Content="{Binding PowerNap_text}" IsChecked="{Binding PowerNap_Enable}" HorizontalAlignment="Right"
                                                               IsEnabled="{Binding isLockPowerNapEnable}" Opacity="{Binding LockPowerNap_Opacity}"
                                                               FontSize="16" Height="20" />
                                </Grid>
                                <Grid Grid.Row="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <UXControls:UXTextBlock Grid.Row="0"
                                                            Text="{Binding [DisplayOthers.4], Source={x:Static lang:LangHelper.Instance}}"
                                                            FontSize="16" LineHeight="28"
                                                            TextBlockSemanticColorType="Light" TextBlockType="Caption"
                                                            IsEnabled="{Binding isLockPowerNapEnable}" Opacity="{Binding LockPowerNap_Opacity}"
                                                            TextWrapping="WrapWithOverflow" />
                                    <Grid Grid.Row="1" Margin="16,0" IsEnabled="{Binding PowerNap_Enable}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <UXControls:UXRadioButton Grid.Row="0"
                                                                  AutomationProperties.AutomationId="LargeRB1"
                                                                  Content="{Binding [DisplayOthers.0], Source={x:Static lang:LangHelper.Instance}}"
                                                                  RadioButtonSize="Large" Foreground="{DynamicResource DefaultTheme_TxtColor}"
                                                                  HorizontalAlignment="Left"
                                                                  IsEnabled="{Binding isLockPowerNapEnable}" Opacity="{Binding LockPowerNap_Opacity}"
                                                                  FontSize="16" IsChecked="{Binding Reducebrt_Checked}">
                                            <UXControls:UXRadioButton.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent" />
                                                </Style>
                                            </UXControls:UXRadioButton.Resources>
                                        </UXControls:UXRadioButton>
                                        <UXControls:UXRadioButton Grid.Row="1"
                                                                  AutomationProperties.AutomationId="LargeRB1"
                                                                  Content="{Binding [DisplayOthers.1], Source={x:Static lang:LangHelper.Instance}}"
                                                                  RadioButtonSize="Large" Foreground="{DynamicResource DefaultTheme_TxtColor}"
                                                                  HorizontalAlignment="Left"
                                                                  IsEnabled="{Binding isLockPowerNapEnable}" Opacity="{Binding LockPowerNap_Opacity}"
                                                                  FontSize="16" IsChecked="{Binding PutTosleep_Checked}">
                                            <UXControls:UXRadioButton.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent" />
                                                </Style>
                                            </UXControls:UXRadioButton.Resources>
                                        </UXControls:UXRadioButton>
                                    </Grid>
                                </Grid>
                            </Grid>
                            <UXControls:UXButton Grid.Row="1"
                                                 ButtonType="Secondary" ButtonSize="Medium"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 IsEnabled="{Binding isLockPowerNapEnable}" Opacity="{Binding LockPowerNap_Opacity}"
                                                 Click="tbOpenScreensaverSettings_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <UXControls:UXTextBlock Text="{Binding [DisplayOthers.5], Source={x:Static lang:LangHelper.Instance}}" Margin="8"                                                           
                                                            VerticalAlignment="Center" Foreground="{DynamicResource Button_UXStyleColor_ForWhiteFrame}"/>
                                    <Image Source="{DynamicResource popup_ArrowCorner}" Stretch="Uniform"
                                           Margin="8" Width="16" Height="16" />
                                </StackPanel>
                            </UXControls:UXButton>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource RightGroupBorderStyle}" Margin="0,16,0,0">
                    <StackPanel>
                        <StackPanel.Resources>
                            <Style TargetType="{x:Type UXControls:UXTextBlock}">
                                <Setter Property="Foreground" Value="{DynamicResource DefaultTheme_TxtColor}" />
                                <Setter Property="FontSize" Value="16" />
                                <Setter Property="Margin" Value="16,12,0,12" />
                                <Setter Property="HorizontalAlignment" Value="Left" />
                            </Style>
                        </StackPanel.Resources>
                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <!-- Elsa 20250116 change ColumnDefinition Width="*" to Width="Auto" for others-Application Settings tooltip issue  -->
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Elsa 20250116 add Name="textblock1" for others-Application Settings tooltip issue  -->
                                    <UXControls:UXTextBlock Name="textblock1" Margin="30,0,0,0" Grid.Column="0" Text="{Binding [DisplayOthers.6], Source={x:Static lang:LangHelper.Instance}}"
                                                            TextBlockSemanticColorType="Light" TextBlockType="Caption" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                            FontSize="20" LineHeight="28" TextTrimming="CharacterEllipsis" />
                                    <!-- Elsa 20250116 change HorizontalAlignment="Center" to HorizontalAlignment="Left" for others-Application Settings tooltip issue  -->
                                    <Grid Grid.Column="1" Margin="8,0" HorizontalAlignment="Left" VerticalAlignment="Center" Background="#00000000">
                                        <Path Data="M8 0C6.41775 0 4.87103 0.469192 3.55544 1.34824C2.23985 2.22729 1.21447 3.47672 0.608967 4.93853C0.00346625 6.40034 -0.15496 8.00887 0.153721 9.56072C0.462403 11.1126 1.22433 12.538 2.34315 13.6569C3.46197 14.7757 4.88743 15.5376 6.43928 15.8463C7.99113 16.155 9.59966 15.9965 11.0615 15.391C12.5233 14.7855 13.7727 13.7602 14.6518 12.4446C15.5308 11.129 16 9.58225 16 8C16 5.87827 15.1571 3.84344 13.6569 2.34315C12.1566 0.842855 10.1217 0 8 0ZM8 14.93C6.62938 14.93 5.28953 14.5236 4.1499 13.7621C3.01027 13.0006 2.12203 11.9183 1.59752 10.652C1.073 9.3857 0.935766 7.99231 1.20316 6.64802C1.47056 5.30374 2.13058 4.06893 3.09975 3.09975C4.06893 2.13057 5.30374 1.47055 6.64803 1.20316C7.99232 0.935762 9.38571 1.073 10.652 1.59751C11.9183 2.12203 13.0006 3.01027 13.7621 4.1499C14.5236 5.28953 14.93 6.62938 14.93 8C14.9274 9.83714 14.1964 11.5983 12.8973 12.8973C11.5983 14.1964 9.83714 14.9274 8 14.93Z
                                                    M7.36 3.36H8.64V4.64H7.36V3.36Z
                                                    M7.36 6.24H8.64V12.64H7.36V6.24Z" 
                                              HorizontalAlignment="Left" Width="16">
                                        </Path>
                                        <Grid.ToolTip>
                                            <!--Elsa 20250407 for PIMS-348390 change Placement="Center" to Placement="Top" VerticalOffset="45" to VerticalOffset="12",add HorizontalOffset="2" MaxWidth="272 -->
                                            <ToolTip Placement="Top" VerticalOffset="12" HorizontalOffset="2" MaxWidth="272" >
                                                <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                                    <Border.Resources>
                                                        <Style BasedOn="{StaticResource Tooltip_TextBlockStyle}" TargetType="TextBlock" />
                                                    </Border.Resources>
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <!--Elsa 20250407 for PIMS-348390 change MaxWidth="350" to MaxWidth="230" -->
                                                            <TextBlock MaxWidth="230" TextWrapping="WrapWithOverflow" Text="{Binding Tooltip_Settings}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </ToolTip>
                                        </Grid.ToolTip>
                                    </Grid>
                                    <Grid Grid.Column="2" VerticalAlignment="Center" Margin="8" Background="#00000000" 
                                          Visibility="{Binding LockSettings_Visibility}">
                                        <Path Data="M11.0998 6.4V4C11.1998 1.8 9.4998 0.1 7.2998 0H7.0998C4.89981 0 3.0998 1.8 3.0998 4V6.4H0.799805V16H13.0998V6.4H11.0998ZM4.2998 4C4.19981 2.5 5.3998 1.3 6.7998 1.2H7.1998C8.7998 1.2 9.9998 2.5 9.9998 4V6.4H4.2998V4ZM12.0998 14.9H1.9998V7.5H12.0998V14.9Z"
                                              Fill="White"/>
                                        <Path Data="M6.5998 12.5H7.5998V9.3H5.7998V10.3H6.5998V12.5Z" />
                                        <Grid.ToolTip>
                                            <ToolTip>
                                                <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                                    <Border.Resources>
                                                        <Style BasedOn="{StaticResource Tooltip_TextBlockStyle}" TargetType="TextBlock" />
                                                    </Border.Resources>
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding [ITLockToolTip.0], Source={x:Static lang:LangHelper.Instance}}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </ToolTip>
                                        </Grid.ToolTip>
                                    </Grid>
                                </Grid>
                                <Grid Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>
                                    <UXControls:UXButton Grid.Column="1" Margin="8" ButtonType="Secondary" ButtonSize="Medium"
                                                         Content="{Binding [Import], Source={x:Static lang:LangHelper.Instance}}" HorizontalAlignment="Right" VerticalAlignment="Center" 
                                                         IsEnabled="{Binding isSettingsEnable}" Opacity="{Binding Settings_Opacity}"
                                                         FontSize="14" Name="import" Click="import_Click" />
                                    <UXControls:UXButton Grid.Column="2" Margin="8" ButtonType="Secondary" ButtonSize="Medium"
                                                         Content="{Binding [Export], Source={x:Static lang:LangHelper.Instance}}" HorizontalAlignment="Right" VerticalAlignment="Center" 
                                                         IsEnabled="{Binding isSettingsEnable}" Opacity="{Binding Settings_Opacity}"
                                                         FontSize="14" Name="export" Click="export_Click" />
                                </Grid>
                            </Grid>
                            <UXControls:UXCheckBox Grid.Row="1" Margin="24, 8, 8, 0" CheckBoxSize="Large"
                                                   Content="{Binding [ImpExp_Message.0], Source={x:Static lang:LangHelper.Instance}}"
                                                   HorizontalAlignment="Left" FontSize="14" Foreground="{DynamicResource TextBlock_ForegroundColor}"
                                                   IsEnabled="{Binding isSettingsEnable}" Opacity="{Binding Settings_Opacity}"
                                                   IsChecked="{Binding AutoApply_Checked}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </UXControls:UXScrollViewer>
        <Border Name="DisableAll" Background="#4C24273C">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <!-- Add a UXBusyIndicator from Robert -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <UXControls:UXBusyIndicator BusyIndicatorType="Secondary" Width="64" Height="64"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsActive="{Binding IsBusy}" />
                <UXControls:UXTextBlock Margin="0, 20, 0, 0" Text="{Binding [HomePage.0], Source={x:Static lang:LangHelper.Instance}}" Foreground="#FF797F84" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>