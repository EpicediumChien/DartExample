<UserControl x:Class="DDPM.UI.Module.MonitorAudio.MonitorAudioRightView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             xmlns:lang="clr-namespace:DDPM.UI.Resources.Helper;assembly=DDPM.UI.Resources"
             xmlns:local="clr-namespace:DDPM.UI.Module.MonitorAudio"
             mc:Ignorable="d"
             d:DesignHeight="800"
             d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DDPM.UI.Common;component/PluginStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <UXControls:UXScrollViewer VerticalScrollBarVisibility="Auto"
                                   UseFadingScrolling="False">
            <Grid>
                <StackPanel>
                    <Border Style="{StaticResource RightGroupBorderStyle}">
                        <StackPanel Orientation="Vertical"
                                    Margin="16">
                            <!--  Row: "Brightness"  -->
                            <Grid Height="40">
                                <UXControls:UXTextBlock HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        FontSize="16"
                                                        FontFamily="Roboto"
                                                        Foreground="{DynamicResource TextBlock_ForegroundColor}"
                                                        Text="{Binding [Volume], Source={x:Static lang:LangHelper.Instance}}"
                                                        Focusable="True"
                                                        KeyboardNavigation.TabIndex="112"
                                                        TextBlockSemanticColorType="Light"
                                                        TextBlockType="Display1" />
                            </Grid>
                            <!--  Row: Volume Slider  -->
                            <Grid Height="60">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M3.00007 5.5H0.320068V10.5H3.00007L6.25007 14.1L8.41007 14.51V1.51L6.25007 1.9L3.00007 5.5ZM7.34007 2.78V13.23L6.80007 13.12L3.48007 9.47H1.38007V6.56H3.48007L6.80007 2.88L7.34007 2.78Z M11.2401 0.449997L10.7301 1.34C11.9043 2.01077 12.8804 2.9801 13.5593 4.14972C14.2381 5.31933 14.5957 6.64764 14.5957 8C14.5957 9.35235 14.2381 10.6807 13.5593 11.8503C12.8804 13.0199 11.9043 13.9892 10.7301 14.66L11.2401 15.55C12.5725 14.7906 13.6803 13.6921 14.4509 12.3661C15.2214 11.04 15.6273 9.53367 15.6273 8C15.6273 6.46632 15.2214 4.95997 14.4509 3.63392C13.6803 2.30787 12.5725 1.20938 11.2401 0.449997Z M12.5001 8C12.5087 7.09207 12.29 6.19642 11.8638 5.3947C11.4376 4.59297 10.8175 3.91067 10.0601 3.41L9.52007 4.28C10.1393 4.68188 10.6472 5.23345 10.9968 5.88367C11.3464 6.5339 11.5264 7.26178 11.5201 8C11.5299 8.72692 11.3586 9.44484 11.0216 10.089C10.6847 10.7332 10.1927 11.2834 9.59007 11.69L10.1401 12.55C10.8783 12.0452 11.4801 11.3655 11.8919 10.5716C12.3037 9.7777 12.5126 8.89425 12.5001 8Z"
                                      d:Fill="{DynamicResource DefaultTheme_PathColor}"
                                      Visibility="{Binding IsNotMute}"/>
                                <Path HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M16 4.00001L15.2 3.31001L12.63 6.24001L10 3.19001L9.2 3.89001L11.96 7.05001L9.17 10.21L9.97 10.91L12.63 7.86001L15.2 10.86L16 10.16L13.33 7.05001L16 4.00001Z M2.69 4.50001H0V9.50001H2.69L5.94 13.1L8.09 13.51V0.51001L5.93 0.90001L2.69 4.50001ZM7 1.78001V12.23L6.46 12.12L3.16 8.47001H1.07V5.56001H3.16L6.49 1.88001L7 1.78001Z"
                                      d:Fill="{DynamicResource DefaultTheme_PathColor}"
                                      Visibility="{Binding IsMute}" />
                                <UXControls:UXSlider Name="B_slider"
                                                     Grid.Column="1"
                                                     Margin="8,0"
                                                     HorizontalContentAlignment="Stretch"
                                                     AutoToolTipPlacement="None"
                                                     KeyboardNavigation.TabIndex="113"
                                                     AutomationProperties.AutomationId="UXSlider_HorizontalToolTipNone"
                                                     AutomationProperties.Name="{Binding [Manual], Source={x:Static lang:LangHelper.Instance}}"
                                                     IsSnapToTickEnabled="True"
                                                     LargeChange="1"
                                                     Maximum="100"
                                                     Minimum="0"
                                                     SmallChange="1"
                                                     Value="{Binding Path=BrightnessValue, Mode=TwoWay}" />
                                <UXControls:UXTextBlock Name="BrightnessTextBlock"
                                                        Grid.Column="2"
                                                        Focusable="True"
                                                        KeyboardNavigation.TabIndex="114"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Center"
                                                        Foreground="{DynamicResource PercentageTextColor}"
                                                        Text="{Binding Path=BrightnessValue, StringFormat={}{0}%}"
                                                        TextBlockSemanticColorType="Light"
                                                        TextBlockType="Body2" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource RightGroupBorderStyle}">
                        <StackPanel Orientation="Vertical"
                                    Margin="16">
                            <Grid Height="40"
                                  Margin="0,0,0,8">
                                <!--#region Display Speaker-->
                                <StackPanel VerticalAlignment="Center"
                                            HorizontalAlignment="Left"
                                            Orientation="Horizontal">
                                    <UXControls:UXTextBlock Text="{Binding [Display_Speaker], Source={x:Static lang:LangHelper.Instance}}"
                                                            FontSize="16"
                                                            Foreground="{DynamicResource TextBlock_ForegroundColor}"
                                                            TextBlockSemanticColorType="Light"
                                                            TextBlockType="Caption"
                                                            Focusable="True"
                                                            KeyboardNavigation.TabIndex="107"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Left"
                                                            x:Name="labelDisplaySpeaker" />
                                    <Border Background="{StaticResource FakeTransparent}">
                                        <ContentControl Template="{StaticResource icon_Info}"
                                                        Margin="10,0,0,0"
                                                        Width="18"
                                                        Height="18"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Left" />
                                        <Border.ToolTip>
                                            <ToolTip Placement="Top"
                                                     VerticalOffset="14"
                                                     HorizontalOffset="13"
                                                     MaxWidth="272"
                                                     Opened="toolTip_Opened">
                                                <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                                    <TextBlock Text="{Binding [Display_Speaker_Tooltips], Source={x:Static lang:LangHelper.Instance}}"
                                                               Style="{StaticResource Tooltip_TextBlockStyle}"
                                                               MaxWidth="230"
                                                               TextWrapping="Wrap"
                                                               Padding="5,0,5,0" />
                                                </Border>
                                            </ToolTip>
                                        </Border.ToolTip>
                                    </Border>
                                </StackPanel>
                                <UXControls:UXToggleSwitch IsChecked="{Binding Path= DisplaySpeakerStatus}"
                                                           ContentTextVisibility="True"
                                                           Content="{Binding Path=DisplaySpeakerStatus_String}"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Focusable="True"
                                                           KeyboardNavigation.TabIndex="108"
                                                           AutomationProperties.LabeledBy="{Binding ElementName=labelDisplaySpeaker}"
                                                           Foreground="{DynamicResource TextBlock_ForegroundColor}" />
                                <!--#endregion Display Speaker-->
                            </Grid>
                            <Grid Height="40"
                                  Margin="0,0,0,8">
                                <!--#region Spatial Audio-->
                                <StackPanel VerticalAlignment="Center"
                                            HorizontalAlignment="Left"
                                            Orientation="Horizontal">
                                    <UXControls:UXTextBlock Text="{Binding [Spatial_Audio], Source={x:Static lang:LangHelper.Instance}}"
                                                            FontSize="16"
                                                            Foreground="{DynamicResource TextBlock_ForegroundColor}"
                                                            TextBlockSemanticColorType="Light"
                                                            TextBlockType="Caption"
                                                            Focusable="True"
                                                            KeyboardNavigation.TabIndex="107"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Left"
                                                            x:Name="labelSpatialAudio" />
                                    <Border Background="{StaticResource FakeTransparent}">
                                        <ContentControl Template="{StaticResource icon_Info}"
                                                        Margin="10,0,0,0"
                                                        Width="18"
                                                        Height="18"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Left" />
                                        <Border.ToolTip>
                                            <ToolTip Placement="Top"
                                                     VerticalOffset="14"
                                                     HorizontalOffset="13"
                                                     MaxWidth="272"
                                                     Opened="toolTip_Opened">
                                                <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                                    <TextBlock Text="{Binding [Spatial_Audio_Tooltips], Source={x:Static lang:LangHelper.Instance}}"
                                                               Style="{StaticResource Tooltip_TextBlockStyle}"
                                                               MaxWidth="230"
                                                               TextWrapping="Wrap"
                                                               Padding="5,0,5,0" />
                                                </Border>
                                            </ToolTip>
                                        </Border.ToolTip>
                                    </Border>
                                </StackPanel>
                                <UXControls:UXToggleSwitch IsChecked="{Binding Path= SpatialAudioStatus}"
                                                           ContentTextVisibility="True"
                                                           Content="{Binding Path=SpatialAudioStatus_String}"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Focusable="True"
                                                           KeyboardNavigation.TabIndex="108"
                                                           AutomationProperties.LabeledBy="{Binding ElementName=labelSpatialAudio}"
                                                           Foreground="{DynamicResource TextBlock_ForegroundColor}" />
                                <!--#endregion Spatial Audio-->
                            </Grid>
                            <Grid Height="40"
                                  Margin="0,0,0,8">
                                <!--#region Audio Source-->
                                <UXControls:UXTextBlock Text="{Binding [Audio_Source], Source={x:Static lang:LangHelper.Instance}}"
                                                        FontSize="16"
                                                        MaxWidth="345"
                                                        HorizontalAlignment="Left"
                                                        TextWrapping="WrapWithOverflow"
                                                        Foreground="{DynamicResource TextBlock_ForegroundColor}"
                                                        TextBlockSemanticColorType="Light"
                                                        Focusable="True"
                                                        KeyboardNavigation.TabIndex="101"
                                                        TextBlockType="Caption"
                                                        VerticalAlignment="Center"
                                                        x:Name="labelAudioSource" />
                                <ComboBox Style="{StaticResource DdpmComboBoxStyle}"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          ItemsSource="{Binding AudioSource_ItemsCollection}"
                                          SelectedItem="{Binding SelectedAudioSource, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayText"
                                          Width="200"
                                          KeyboardNavigation.TabIndex="104"
                                          AutomationProperties.LabeledBy="{Binding ElementName=labelAudioSource}">
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem"
                                               BasedOn="{StaticResource DdpmComboBoxItemContainerStyle}">
                                            <Setter Property="AutomationProperties.Name"
                                                    Value="{Binding DisplayText}" />
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                </ComboBox>
                                <!--#endregion Audio Source-->
                            </Grid>
                            <Grid Height="40"
                                  Margin="0,0,0,8">
                                <!--#region Audio Profiles-->
                                <UXControls:UXTextBlock Text="{Binding [Audio_Profiles], Source={x:Static lang:LangHelper.Instance}}"
                                                        FontSize="16"
                                                        MaxWidth="345"
                                                        HorizontalAlignment="Left"
                                                        TextWrapping="WrapWithOverflow"
                                                        Foreground="{DynamicResource TextBlock_ForegroundColor}"
                                                        TextBlockSemanticColorType="Light"
                                                        Focusable="True"
                                                        KeyboardNavigation.TabIndex="101"
                                                        TextBlockType="Caption"
                                                        VerticalAlignment="Center"
                                                        x:Name="labelAudioProfiles" />
                                <ComboBox Style="{StaticResource DdpmComboBoxStyle}"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          ItemsSource="{Binding AudioProfiles_ItemsCollection}"
                                          SelectedItem="{Binding SelectedAudioProfiles, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayText"
                                          Width="200"
                                          KeyboardNavigation.TabIndex="104"
                                          AutomationProperties.LabeledBy="{Binding ElementName=labelAudioProfiles}">
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem"
                                               BasedOn="{StaticResource DdpmComboBoxItemContainerStyle}">
                                            <Setter Property="AutomationProperties.Name"
                                                    Value="{Binding DisplayText}" />
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                </ComboBox>
                                <!--#endregion Audio Profiles-->
                            </Grid>
                            <Grid Height="40"
                                  Margin="0,0,0,0">
                                <!--#region PBP Audio-->
                                <StackPanel VerticalAlignment="Center"
                                            HorizontalAlignment="Left"
                                            Orientation="Horizontal">
                                    <UXControls:UXTextBlock Text="{Binding [PBP_Audio], Source={x:Static lang:LangHelper.Instance}}"
                                                            FontSize="16"
                                                            MaxWidth="345"
                                                            HorizontalAlignment="Left"
                                                            TextWrapping="WrapWithOverflow"
                                                            Foreground="{DynamicResource TextBlock_ForegroundColor}"
                                                            TextBlockSemanticColorType="Light"
                                                            Focusable="True"
                                                            KeyboardNavigation.TabIndex="101"
                                                            TextBlockType="Caption"
                                                            VerticalAlignment="Center"
                                                            x:Name="labelPBPAudio" />
                                    <Border Background="{StaticResource FakeTransparent}">
                                        <ContentControl Template="{StaticResource icon_Info}"
                                                        Margin="10,0,0,0"
                                                        Width="18"
                                                        Height="18"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Left" />
                                        <Border.ToolTip>
                                            <ToolTip Placement="Top"
                                                     VerticalOffset="14"
                                                     HorizontalOffset="13"
                                                     MaxWidth="272"
                                                     Opened="toolTip_Opened">
                                                <Border Style="{StaticResource Tooltip_OutterBorderStyle}">
                                                    <TextBlock Text="{Binding [PBP_Audio_Tooltips], Source={x:Static lang:LangHelper.Instance}}"
                                                               Style="{StaticResource Tooltip_TextBlockStyle}"
                                                               MaxWidth="230"
                                                               TextWrapping="Wrap"
                                                               Padding="5,0,5,0" />
                                                </Border>
                                            </ToolTip>
                                        </Border.ToolTip>
                                    </Border>
                                </StackPanel>
                                <ComboBox Style="{StaticResource DdpmComboBoxStyle}"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          ItemsSource="{Binding PBP_Audio_ItemsCollection}"
                                          SelectedItem="{Binding SelectedPBP_Audio, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayText"
                                          Width="200"
                                          KeyboardNavigation.TabIndex="104"
                                          AutomationProperties.LabeledBy="{Binding ElementName=labelPBPAudio}">
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem"
                                               BasedOn="{StaticResource DdpmComboBoxItemContainerStyle}">
                                            <Setter Property="AutomationProperties.Name"
                                                    Value="{Binding DisplayText}" />
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                </ComboBox>
                                <!--#endregion PBP Audio-->
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <Border Name="DisableAll"
                        Background="#4C24273C">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility"
                                    Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}"
                                             Value="True">
                                    <Setter Property="Visibility"
                                            Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <UXControls:UXBusyIndicator BusyIndicatorType="Secondary"
                                                    Width="64"
                                                    Height="64"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsActive="{Binding IsBusy}" />
                        <UXControls:UXTextBlock Margin="0, 20, 0, 0"
                                                Text="{Binding [HomePage.0], Source={x:Static lang:LangHelper.Instance}}"
                                                Foreground="#FF797F84" />
                    </StackPanel>
                </Border>
            </Grid>
        </UXControls:UXScrollViewer>
    </Grid>
</UserControl>