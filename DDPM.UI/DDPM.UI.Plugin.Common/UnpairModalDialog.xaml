<Window x:Class="DDPM.UI.Plugin.Common.UnpairModalDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DDPM.UI.Plugin.Common"
        mc:Ignorable="d"
        xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF" AllowsTransparency="True"
        Title="UnpairModalDialog" MinHeight="312" Width="587" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" WindowStyle="None" SizeToContent="Height"
        Background="Transparent">
    <Window.Resources>
        <Style x:Key="BorderContinue" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BorderContinueBackground}" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Width" Value="120" />
            <Setter Property="Height" Value="40" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderContinueBorderBrush}" />
        </Style>
        <Style x:Key="BorderCancel" TargetType="Border">
            <Setter Property="Background" Value="#0672CB" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Width" Value="107" />
            <Setter Property="Height" Value="40" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="#F5F6F7" />
        </Style>
    </Window.Resources>
    <Grid>
        <Border Name="Border1" Background="{DynamicResource UnpairModalDialogBorder1}" CornerRadius="14" Height="312" Width="587" BorderThickness="1" BorderBrush="#293B4D">
            <StackPanel Orientation="Vertical" Margin="0,68,0,0">
                <UXControls:UXTextBlock Name="txtCaption" Foreground="{DynamicResource txtCaption_TxtColor}" VerticalAlignment="Center" FontWeight="Light"
                                        HorizontalAlignment="Center" FontFamily="Roboto" FontSize="40" Margin="0,0,0,5" />
                <UXControls:UXTextBlock Name="txtMessage" Foreground="{DynamicResource txtMessage_TxtColor}" VerticalAlignment="Center" FontWeight="Normal" TextWrapping="Wrap" TextAlignment="Center"
                                        Margin="0,5,0,0"      HorizontalAlignment="Center" FontFamily="Roboto" FontSize="16" LineHeight="24" Width="454" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,30">
                    <Border Style="{StaticResource BorderContinue}" Cursor="Hand" MouseLeftButtonDown="Continue_MouseLeftButtonDown">
                        <UXControls:UXTextBlock Name="txtContinue" Foreground="{DynamicResource UnpairModalDialogTxtColor}" VerticalAlignment="Center" FontWeight="Medium"
                                                HorizontalAlignment="Center" FontFamily="Roboto" FontSize="14" />
                    </Border>
                    <Border Style="{StaticResource BorderCancel}" Cursor="" Margin="6,0,0,0" MouseLeftButtonDown="Cancel_MouseLeftButtonDown">
                        <UXControls:UXTextBlock Name="txtCancel" Foreground="{DynamicResource UnpairModalDialogTxtColor}" VerticalAlignment="Center" FontWeight="Medium"
                                                HorizontalAlignment="Center" FontFamily="Roboto" FontSize="14" Margin="5,0,0,0" />
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>