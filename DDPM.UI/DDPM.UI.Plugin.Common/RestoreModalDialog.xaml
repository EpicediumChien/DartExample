<Window x:Class="DDPM.UI.Plugin.Common.RestoreModalDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DDPM.UI.Plugin.Common"
        mc:Ignorable="d"
        xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF" AllowsTransparency="True"
        Title="RestoreModalDialog" Height="196" Width="417" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        Background="{DynamicResource DefaultTheme_DialogBoxBkColor}">
    <Window.Resources>
        <!--
        <Style x:Key="BorderYes" TargetType="Border">
            <Setter Property="Background" Value="#0E1C2F" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Width" Value="87" />
            <Setter Property="Height" Value="40" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#F5F6F7" />
        </Style>
        <Style x:Key="BorderNo" TargetType="Border">
            <Setter Property="Background" Value="#0672CB" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Width" Value="81" />
            <Setter Property="Height" Value="40" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="#F5F6F7" />
        </Style> -->
    </Window.Resources>
    <Grid>
        <Border CornerRadius="4" Height="196" Width="417" BorderThickness="1" >
            <StackPanel Orientation="Vertical" Margin="35,36,0,0">
                <UXControls:UXTextBlock Name="txtCaption" VerticalAlignment="Center" FontWeight="Normal"
                                        HorizontalAlignment="Left" FontFamily="Roboto" FontSize="20" Margin="0,0,0,10" />
                <UXControls:UXTextBlock Name="txtMessage" VerticalAlignment="Center" FontWeight="Normal" TextWrapping="Wrap"
                                        HorizontalAlignment="Left" FontFamily="Roboto" FontSize="16" LineHeight="24" Width="353" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
                    <!--
                    <Border Style="{StaticResource BorderYes}" Cursor="Hand" MouseLeftButtonDown="Yes_MouseLeftButtonDown">
                        <UXControls:UXTextBlock Name="txtYes" Foreground="#F5F6F7" VerticalAlignment="Center" FontWeight="Medium"
                                                HorizontalAlignment="Center" FontFamily="Roboto" FontSize="14" />
                    </Border>
                    <Border Style="{StaticResource BorderNo}" Cursor="Hand" Margin="6,0,0,0" MouseLeftButtonDown="No_MouseLeftButtonDown">
                        <UXControls:UXTextBlock Name="txtNo" Foreground="#F5F6F7" VerticalAlignment="Center" FontWeight="Medium"
                                                HorizontalAlignment="Center" FontFamily="Roboto" FontSize="14" Margin="5,0,0,0" />
                    </Border> -->
                    <UXControls:UXButton
                        Name="txtYes" MinHeight="40" MinWidth="87"
                        Margin="0,8,6,0"                      
                        ButtonType="Secondary"
                        Click="Yes_MouseLeftButtonDown"
                        Content="N/A" FontFamily="Roboto" FontSize="14" FontWeight="Medium"
                        CornerRadius="2"/>
                    <UXControls:UXButton
                        Name="txtNo" MinHeight="40" MinWidth="87"
                        Margin="0,8,0,0"
                        ButtonType="Primary"
                        Click="No_MouseLeftButtonDown"
                        Content="N/A" FontFamily="Roboto" FontSize="14" FontWeight="Medium"
                        CornerRadius="2" />
                </StackPanel>
            </StackPanel>
        </Border>
        <Image x:Name="CloseIcon" Margin="0,17,17,0" Source="/DDPM.UI.Resources;component/Resources/Images/CloseX.png" Stretch="Fill"
               VerticalAlignment="Top" HorizontalAlignment="Right" Width="14" Height="14" MouseLeftButtonDown="No_MouseLeftButtonDown" Cursor="" />
    </Grid>
</Window>