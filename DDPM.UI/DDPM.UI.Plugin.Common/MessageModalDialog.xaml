<Window x:Class="DDPM.UI.Plugin.Common.MessageModalDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DDPM.UI.Plugin.Common"
        mc:Ignorable="d"
        xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF" Background="Transparent" AllowsTransparency="True"
        Title="MessageModalDialog" Width="417" ResizeMode="NoResize" ShowInTaskbar="False" 
        WindowStartupLocation="CenterOwner" WindowStyle="None" SizeToContent="Height">
  <Window.Resources>
    <Style x:Key="BorderYes" TargetType="Border">
      <Setter Property="Background" Value="#0E1C2F" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Width" Value="107" />
      <Setter Property="Height" Value="40" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#F5F6F7" />
    </Style>
    <Style x:Key="BorderNo" TargetType="Border">
      <Setter Property="Background" Value="#0672CB" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Width" Value="107" />
      <Setter Property="Height" Value="40" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
  </Window.Resources>
  <Grid>
    <Border Background="#E00B172C" CornerRadius="4" 
            Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}}" 
            Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=UserControl}}" 
            BorderThickness="1" BorderBrush="#293B4D"  >
      <StackPanel Orientation="Vertical" Margin="35,36,0,0">
        <UXControls:UXTextBlock Name="txtCaption" Foreground="#FFFFFF" VerticalAlignment="Center" FontWeight="Normal"
                                      HorizontalAlignment="Left" FontFamily="Roboto" FontSize="20" Margin="0,0,0,10"/>
        <UXControls:UXTextBlock Name="txtMessage" Foreground="#FFFFFF" VerticalAlignment="Center" FontWeight="Normal" TextWrapping="Wrap" 
                                      HorizontalAlignment="Left" FontFamily="Roboto" FontSize="16" LineHeight="24" Width="352"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,30">
          <Border x:Name="Button1" Style="{StaticResource BorderYes}" Cursor="Hand" MouseLeftButtonDown="Yes_MouseLeftButtonDown" Margin="0,8,6,0">
            <UXControls:UXTextBlock Name="txtButton1" Foreground="#F5F6F7" VerticalAlignment="Center" FontWeight="Medium"
                                      HorizontalAlignment="Center" FontFamily="Roboto" FontSize="14"/>
          </Border>
          <Border x:Name="Button2" Style="{StaticResource BorderNo}" Cursor="Hand" Margin="0,8,0,0" MouseLeftButtonDown="No_MouseLeftButtonDown">
            <UXControls:UXTextBlock Name="txtButton2" Foreground="#F5F6F7" VerticalAlignment="Center" FontWeight="Medium"
                                      HorizontalAlignment="Center" FontFamily="Roboto" FontSize="14" Margin="5,0,0,0"/>
          </Border>
        </StackPanel>

      </StackPanel>
    </Border>
    <Image x:Name="CloseIcon" Margin="0,17,17,0" Source="/DDPM.UI.Resources;component/Resources/Images/CloseX.png" Stretch="Fill"  
           VerticalAlignment="Top" HorizontalAlignment="Right" Width="14" Height="14" MouseLeftButtonDown="No_MouseLeftButtonDown" Cursor=""/>
  </Grid>
</Window>
