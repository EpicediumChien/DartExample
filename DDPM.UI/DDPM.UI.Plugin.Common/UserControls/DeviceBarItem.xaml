<UserControl x:Class="DDPM.UI.Common.DeviceBarItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             xmlns:local="clr-namespace:DDPM.UI.Common"
             mc:Ignorable="d"
             HorizontalAlignment="Right"
             d:DesignHeight="72" d:DesignWidth="228"
             >
  <UserControl.Resources>
  </UserControl.Resources>

  <Grid Height="64"  VerticalAlignment="Top" Margin="0,0,0,8" HorizontalAlignment="Right" Visibility="{Binding Visibility}">
    <Border Name="bdRoot" Width="212" BorderThickness="2" CornerRadius="13" Focusable="True"
                MouseEnter="rootGrid_MouseEnter" MouseLeave="rootGrid_MouseLeave" MouseLeftButtonDown="rootGrid_MouseLeftButtonDown">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="60" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Image Grid.Column="0" Width="24" Height="24" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="18,0,0,0"
                       Source="{Binding Icon}" />

        <UXControls:UXTextBlock Grid.Column="1" Text="{Binding Text}" FontSize="14" FontFamily="Roboto" LineHeight="20"
                                        VerticalAlignment="Center" HorizontalAlignment="Left" FontWeight="Bold" Padding="0,4,0,0"
                                        Foreground="White" />
      </Grid>
    </Border>
  </Grid>
</UserControl>