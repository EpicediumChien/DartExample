<UserControl x:Class="DDPM.UI.Common.DeviceBarItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             xmlns:Common="clr-namespace:DDPM.UI.Common"
             xmlns:common="clr-namespace:DDPM.UI.Common;assembly=DDPM.UI.Common"
             mc:Ignorable="d"
             HorizontalAlignment="Right"
             d:DesignHeight="72" d:DesignWidth="228"
             IsTabStop="True" Focusable="True"
             AutomationProperties.Name="{Binding Text, Mode=OneWay}" 
             PreviewKeyDown="UserControl_PreviewKeyDown"
             >
    <!-- Robert_Lin, 2025-2-8 UserControl add IsTabStop and Focusable for Narrator
    -->
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Foreground" Value="{DynamicResource Vbar_FgBrush_Default}" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource Vbar_FgBrush_Disabled}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <UserControl.Resources>
        <common:IdxToVisibilityConverter x:Key="IdxToVis"/>
        <FontFamily x:Key="RobotoFont">
            pack://application:,,,/DDPM.UI.Resources;component/Resources/Fonts/#Roboto
        </FontFamily>
    </UserControl.Resources>

  <Grid Height="64"  VerticalAlignment="Top" Margin="0,0,0,8" HorizontalAlignment="Right" Visibility="{Binding Visibility}">
      <!-- Robert_Lin 2025-2-8 Change Facusable=True to False to avoid Narrator DeviceBarItem twice -->
        <Border Name="bdRoot" Width="212" BorderThickness="2" CornerRadius="13" Focusable="False"
                MouseEnter="rootGrid_MouseEnter" MouseLeave="rootGrid_MouseLeave" MouseLeftButtonDown="rootGrid_MouseLeftButtonDown">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="212" />
                    <Setter Property="CornerRadius" Value="13" />
                    <Setter Property="Focusable" Value="True" />
                    <Setter Property="BorderThickness" Value="2" />
                    <Setter Property="Background" Value="{DynamicResource Vbar_BkBrush_Default}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Vbar_BdBrush_Default}" />
                </Style>
            </Border.Style>
            <Grid x:Name="iconTextGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

