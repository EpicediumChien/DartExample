<UserControl x:Class="DDPM.UI.Module.SpeakerAudioPreset.SpeakerAudioPresetRightView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:local="clr-namespace:DDPM.UI.Module.SpeakerAudioPreset"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:plugin="clr-namespace:DDPM.UI.Plugin.ViewModels;assembly=DDPM.UI.Plugin.Common"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             xmlns:common="clr-namespace:DDPM.UI.Common;assembly=DDPM.UI.Common"
             xmlns:lang="clr-namespace:DDPM.UI.Resources.Helper;assembly=DDPM.UI.Resources"
             d:DataContext="{d:DesignInstance Type=plugin:SoundBarViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="655" d:DesignWidth="470">
  <UserControl.Resources>
    <ResourceDictionary>

      <ImageBrush x:Key="UnselectedNodeImage" ImageSource="pack://application:,,,/DDPM.UI.Common;component/Resources/Headset_Dot.png" />
      <ImageBrush x:Key="SelectedNodeImage" ImageSource="pack://application:,,,/DDPM.UI.Common;component/Resources/Headset_whitedot.png" />

      <LinearGradientBrush x:Key="PressedBackground" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#0672CB" Offset="0.0" />
        <GradientStop Color="#0078D4" Offset="0.46" />
        <GradientStop Color="#6E69CF" Offset="1.1831" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="PressedBorderBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#55B4FD" Offset="0.0045" />
        <GradientStop Color="#6E69CF" Offset="1.0" />
      </LinearGradientBrush>

      <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </ResourceDictionary>
  </UserControl.Resources>
  <UXControls:UXScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid x:Name="MainGrid">
      <!--Elsa 20250331 for PIMS-348388 change Width="470" to Width="auto",change Margin="0,10,10,0" to Margin="0,10,16,16" -->
      <Border x:Name="MainBorder" CornerRadius="13" Width="auto" Height="auto"  Margin="0,10,16,16">
        <StackPanel x:Name="MainStackPanel" Orientation="Vertical" Margin="16">

          <Grid VerticalAlignment="Top" Margin="0,0,0,15">
            <Border x:Name="AudioPresetBorder" CornerRadius="6" Width="auto" Height="Auto" VerticalAlignment="Top">
              <StackPanel x:Name="AudioModesStackPanel" Orientation="Vertical">
                <Grid x:Name="TitleGrid" VerticalAlignment="Top" Margin="20,0,0,0">
                  <!--Chewlin 20250219 change Width="280" to MaxWidth="310" Fix ES-XL language Audio Preset Title Clipping issue(No Pims Number) -->
                  <UXControls:UXTextBlock x:Name="AudioSettingsTextBlock" Text="{Binding [SpeakerAudioPreset.0], Source={x:Static lang:LangHelper.Instance}}" FontFamily="Roboto" FontSize="20" Height="28" MaxWidth="310" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,20,20,20" />
                </Grid>
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>
                  <!--Chewlin 20250219 ADD MaxWidth="420" TextWrapping="WrapWithOverflow" to Fix ES-XL language Audio Preset1 content Clipping issue(No Pims Number) -->
                  <StackPanel Orientation="Horizontal" Grid.Row="0" HorizontalAlignment="Left">
                    <UXControls:UXTextBlock x:Name="AudioOutputPresetsTextBlock1"  Text="{Binding [SpeakerAudioPreset.1], Source={x:Static lang:LangHelper.Instance}}" Grid.Row="0" Grid.Column="0"  Foreground="{DynamicResource TextBlock_ForegroundColor}" FontSize="14" Margin="20,0,0,20" MaxWidth="420" TextWrapping="WrapWithOverflow"/>
                  </StackPanel>

                  <StackPanel Grid.Row="1">
                    <UXControls:UXToggleSwitch x:Name="DefaultButton" BorderBrush="#FF1B385F" BorderThickness="2" Width="406" Height="56" Margin="16,0,4,8" IsChecked="{Binding IsDefaultChecked, Mode=TwoWay}">
                      <UXControls:UXToggleSwitch.Template>
                        <ControlTemplate TargetType="UXControls:UXToggleSwitch">
                          <Border x:Name="DefaultButtonBorder"  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="13,13,13,13">
                            <Grid>
                              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <UXControls:UXTextBlock x:Name="DefaultButtonBorderTxt" Text="{Binding [Default], Source={x:Static lang:LangHelper.Instance}}" FontSize="14" Foreground="{DynamicResource TextBlock_ForegroundColor}" TextAlignment="Center" />
                              </StackPanel>
                            </Grid>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                              <Setter TargetName="DefaultButtonBorder" Property="Background" Value="{StaticResource PressedBackground}" />
                              <Setter TargetName="DefaultButtonBorder" Property="BorderBrush" Value="{StaticResource PressedBorderBrush}" />
                              <Setter TargetName="DefaultButtonBorderTxt" Property="Foreground" Value="White" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </UXControls:UXToggleSwitch.Template>
                    </UXControls:UXToggleSwitch>
                  </StackPanel>

                  <StackPanel Grid.Row="2">
                    <UXControls:UXToggleSwitch x:Name="SpeechButton" BorderThickness="1.5" Width="406" Height="56" Margin="16,0,0,8" IsChecked="{Binding IsSpeechChecked, Mode=TwoWay}">
                      <UXControls:UXToggleSwitch.Template>
                        <ControlTemplate TargetType="UXControls:UXToggleSwitch">
                          <Border x:Name="SpeechButtonBorder" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="13,13,13,13">
                            <Grid>
                              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <UXControls:UXTextBlock x:Name="SpeechButtonBorderTxt" Text="{Binding [SpeakerAudioPreset.2], Source={x:Static lang:LangHelper.Instance}}" FontSize="14" Foreground="{DynamicResource TextBlock_ForegroundColor}" TextAlignment="Center" />
                              </StackPanel>
                            </Grid>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                              <Setter TargetName="SpeechButtonBorder" Property="Background" Value="{StaticResource PressedBackground}" />
                              <Setter TargetName="SpeechButtonBorder" Property="BorderBrush" Value="{StaticResource PressedBorderBrush}" />
                              <Setter TargetName="SpeechButtonBorderTxt" Property="Foreground" Value="White" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </UXControls:UXToggleSwitch.Template>
                    </UXControls:UXToggleSwitch>
                  </StackPanel>
                  <StackPanel Grid.Row="3">
                    <UXControls:UXToggleSwitch x:Name="BassBoostButton" BorderThickness="1.5" Width="406" Height="56" Margin="16,0,4,8" IsChecked="{Binding IsBassBoostChecked, Mode=TwoWay}">
                      <UXControls:UXToggleSwitch.Template>
                        <ControlTemplate TargetType="UXControls:UXToggleSwitch">
                          <Border x:Name="BassBoostButtonBorder" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="13,13,13,13">
                            <Grid>
                              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <UXControls:UXTextBlock x:Name="BassBoostButtonBorderTxt" Text="{Binding [HeadsetAudioSettings.7], Source={x:Static lang:LangHelper.Instance}}" FontSize="14" Foreground="{DynamicResource TextBlock_ForegroundColor}" TextAlignment="Center" />
                              </StackPanel>
                            </Grid>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                              <Setter TargetName="BassBoostButtonBorder" Property="Background" Value="{StaticResource PressedBackground}" />
                              <Setter TargetName="BassBoostButtonBorder" Property="BorderBrush" Value="{StaticResource PressedBorderBrush}" />
                              <Setter TargetName="BassBoostButtonBorderTxt" Property="Foreground" Value="White" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </UXControls:UXToggleSwitch.Template>
                    </UXControls:UXToggleSwitch>
                  </StackPanel>
                  <StackPanel Grid.Row="4">
                    <UXControls:UXToggleSwitch x:Name="TrebleBoostButton" BorderThickness="1.5" Width="406" Height="56" Margin="16,0,0,8" IsChecked="{Binding IsTrebleBoostChecked, Mode=TwoWay}">
                      <UXControls:UXToggleSwitch.Template>
                        <ControlTemplate TargetType="UXControls:UXToggleSwitch">
                          <Border x:Name="TrebleBoostButtonBorder" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="13,13,13,13">
                            <Grid>
                              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <UXControls:UXTextBlock x:Name="TrebleBoostButtonBorderTxt" Text="{Binding [HeadsetAudioSettings.9], Source={x:Static lang:LangHelper.Instance}}" FontSize="14" Foreground="{DynamicResource TextBlock_ForegroundColor}" TextAlignment="Center" />
                              </StackPanel>
                            </Grid>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                              <Setter TargetName="TrebleBoostButtonBorder" Property="Background" Value="{StaticResource PressedBackground}" />
                              <Setter TargetName="TrebleBoostButtonBorder" Property="BorderBrush" Value="{StaticResource PressedBorderBrush}" />
                              <Setter TargetName="TrebleBoostButtonBorderTxt" Property="Foreground" Value="White" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </UXControls:UXToggleSwitch.Template>
                    </UXControls:UXToggleSwitch>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
          </Grid>
          <!--Elsa 20250320 for PIMS-348396 change Margin="-8,0,0,0" to Margin="0,0,0,0" add Border and StackPanel,change Width="456" to Width="auto"-->
          <Grid Visibility="{Binding IsDefaultChecked, Converter={StaticResource BooleanToVisibilityConverter}}"  x:Name="AudioEqualizerGrid" Grid.Row="4" Grid.ColumnSpan="1" Width="auto" Height="344" VerticalAlignment="Top" Margin="0,0,0,0">
            <Border x:Name="AudioEqualizer" CornerRadius="6" Width="auto" Height="Auto" VerticalAlignment="Top">
              <StackPanel x:Name="AudioEqualizerStackPanel" Orientation="Vertical">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>
                </Grid>
                <StackPanel Grid.Row="0" HorizontalAlignment="Left" Margin="20,20,0,0">
                  <UXControls:UXTextBlock Text="{Binding [HeadsetAudioSettings.10], Source={x:Static lang:LangHelper.Instance}}" Foreground="{DynamicResource TextBlock_ForegroundColor}" FontSize="16" />
                </StackPanel>
                <StackPanel Grid.Row="1" HorizontalAlignment="Left" Margin="20,20,0,20">
                  <!--Chewlin 20250108 for PIMS-334383 change TextWrapping="Wrap" to TextWrapping="WrapWithOverflow",ADD Width="430"(default 435.287)-->
                  <UXControls:UXTextBlock Text="{Binding [SpeakerAudioPreset.3], Source={x:Static lang:LangHelper.Instance}}" TextWrapping="WrapWithOverflow" Width="430" Foreground="{DynamicResource TextBlock_ForegroundColor}" FontSize="14" />
                </StackPanel>
                <StackPanel Grid.Row="2" HorizontalAlignment="Left" Margin="20,20,0,0">
                  <Canvas x:Name="EqualizerCanvas" HorizontalAlignment="Center" VerticalAlignment="Center" Width="456" Height="324" Margin="0,0,0,0">
                    <!-- 中間橫線 -->
                    <Line X1="40" Y1="81" X2="411" Y2="81" Stroke="{DynamicResource EQLine_Color}" StrokeThickness="2" />

                    <!-- 垂直線條 -->
                    <Line X1="92.5" Y1="0" X2="92.5" Y2="159" Stroke="{DynamicResource EQLine_Color}" StrokeThickness="2" />
                    <Line X1="222.5" Y1="0" X2="222.5" Y2="159" Stroke="{DynamicResource EQLine_Color}" StrokeThickness="2" />
                    <Line X1="352.5" Y1="0" X2="352.5" Y2="159" Stroke="{DynamicResource EQLine_Color}" StrokeThickness="2" />
                    <!-- 曲線 -->
                    <Path Name="CurvePath" Stroke="#FF0672CB" Canvas.Left="0" Canvas.Top="0" StrokeThickness="2.3" Width="410" Fill="Transparent">
                      <Path.Data>
                        <PathGeometry>
                          <PathFigure StartPoint="90,65" IsClosed="False" x:Name="CurvePathFigure">
                            <BezierSegment x:Name="Segment1" Point1="100,65" Point2="150,65" Point3="150,65" />
                            <BezierSegment x:Name="Segment2" Point1="200,65" Point2="250,65" Point3="350,65" />
                          </PathFigure>
                        </PathGeometry>
                      </Path.Data>
                    </Path>
                    <!-- 節點 -->
                    <Image x:Name="Node1" Source="pack://application:,,,/DDPM.UI.Common;component/Resources/Headset_Dot.png" Canvas.Left="86" Canvas.Top="59" Width="13.79" Height="13.79" MouseLeftButtonDown="Node_MouseLeftButtonDown" MouseMove="Node_MouseMove" MouseLeftButtonUp="Node_MouseLeftButtonUp" />
                    <Border x:Name="Node1TextBackground" Background="{StaticResource UnselectedNodeImage}" Width="28" Height="28" Canvas.Left="46" Canvas.Top="35" Visibility="Collapsed">
                      <TextBlock x:Name="Node1Text" Text="0" Foreground="{DynamicResource TextBlock_ForegroundColor}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <Image x:Name="Node2" Source="pack://application:,,,/DDPM.UI.Common;component/Resources/Headset_Dot.png" Canvas.Left="216" Canvas.Top="59" Width="13.79" Height="13.79" MouseLeftButtonDown="Node_MouseLeftButtonDown" MouseMove="Node_MouseMove" MouseLeftButtonUp="Node_MouseLeftButtonUp" />
                    <Border x:Name="Node2TextBackground" Background="{StaticResource UnselectedNodeImage}" Width="28" Height="28" Canvas.Left="136" Canvas.Top="35" Visibility="Collapsed">
                      <TextBlock x:Name="Node2Text" Text="0" Foreground="{DynamicResource TextBlock_ForegroundColor}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <Image x:Name="Node3" Source="pack://application:,,,/DDPM.UI.Common;component/Resources/Headset_Dot.png" Canvas.Left="346" Canvas.Top="59" Width="13.79" Height="13.79" MouseLeftButtonDown="Node_MouseLeftButtonDown" MouseMove="Node_MouseMove" MouseLeftButtonUp="Node_MouseLeftButtonUp" />
                    <Border x:Name="Node3TextBackground" Background="{StaticResource UnselectedNodeImage}" Width="28" Height="28" Canvas.Left="226" Canvas.Top="35" Visibility="Collapsed">
                      <TextBlock x:Name="Node3Text" Text="0" Foreground="{DynamicResource TextBlock_ForegroundColor}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Row="3" HorizontalAlignment="Stretch" Margin="13,72,0,0">
                      <UXControls:UXTextBlock Text="{Binding [HeadsetAudioSettings.12], Source={x:Static lang:LangHelper.Instance},StringFormat={}0 {0}}" Foreground="{DynamicResource TextBlock_ForegroundColor}" FontSize="12" />
                    </StackPanel>

                    <StackPanel Grid.Row="3" HorizontalAlignment="Stretch" Margin="80,165,0,0">
                      <UXControls:UXTextBlock Text="{Binding [HeadsetAudioSettings.13], Source={x:Static lang:LangHelper.Instance}}" Foreground="{DynamicResource TextBlock_ForegroundColor}" FontSize="12" />
                    </StackPanel>

                    <StackPanel Grid.Row="3" HorizontalAlignment="Stretch" Margin="210,165,0,0">
                      <UXControls:UXTextBlock Text="{Binding [HeadsetAudioSettings.14], Source={x:Static lang:LangHelper.Instance}}" Foreground="{DynamicResource TextBlock_ForegroundColor}" FontSize="12" />
                    </StackPanel>

                    <StackPanel Grid.Row="3" HorizontalAlignment="Stretch" Margin="340,165,0,0">
                      <UXControls:UXTextBlock Text="{Binding [HeadsetAudioSettings.15], Source={x:Static lang:LangHelper.Instance}}" Foreground="{DynamicResource TextBlock_ForegroundColor}" FontSize="12" />
                    </StackPanel>
                  </Canvas>
                </StackPanel>
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
  </UXControls:UXScrollViewer>
</UserControl>