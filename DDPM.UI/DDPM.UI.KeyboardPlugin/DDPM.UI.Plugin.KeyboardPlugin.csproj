    <Compile Remove="Resources\**" />
    <Compile Remove="Themes\**" />
    <Compile Remove="ViewModels\**" />
    <EmbeddedResource Remove="Interfaces\**" />
    <EmbeddedResource Remove="Models\**" />
    <EmbeddedResource Remove="Resources\**" />
    <EmbeddedResource Remove="Themes\**" />
    <EmbeddedResource Remove="ViewModels\**" />
    <None Remove="Interfaces\**" />
    <None Remove="Models\**" />
    <None Remove="Resources\**" />
    <None Remove="Themes\**" />
    <None Remove="ViewModels\**" />
    <Page Remove="Interfaces\**" />
    <Page Remove="Models\**" />
    <Page Remove="Resources\**" />
    <Page Remove="Themes\**" />
    <Page Remove="ViewModels\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DCF.UX.WPF" Version="2.2.4.1" />
    <PackageReference Include="Dell.UCA.ThickClient.Interfaces" Version="4.0.27" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DDPM.UI.Common\DDPM.UI.Common.csproj" />
    <ProjectReference Include="..\DDPM.UI.Module.Collaboration\DDPM.UI.Module.Collaboration.csproj" />
    <ProjectReference Include="..\DDPM.UI.Module.Illumination\DDPM.UI.Module.Illumination.csproj" />
    <ProjectReference Include="..\DDPM.UI.Module.KeyCustomization\DDPM.UI.Module.KeyCustomization.csproj" />
    <ProjectReference Include="..\DDPM.UI.Plugin.Common\DDPM.UI.Plugin.Common.csproj" />
    <ProjectReference Include="..\DDPM.UI.Resources\DDPM.UI.Resources.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="DDPM.SA.Common">
      <HintPath>..\CommonDll\DDPM.SA.Common.dll</HintPath>
    </Reference>
  </ItemGroup>

