<UserControl x:Class="DDPM.UI.Common.UserControls.MonitorIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             xmlns:local="clr-namespace:DDPM.UI.Common.UserControls"
             mc:Ignorable="d"
             d:DesignHeight="40" d:DesignWidth="111">

    <!-- Robert_Lin, 2024-7-25, Unused class -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="MonitorIndicator_BkColor" Color="#99193457" />
    </UserControl.Resources>
    <Grid>
        <Border Background="{StaticResource MonitorIndicator_BkColor}" CornerRadius="2"
                Padding="8,8" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <Image x:Name="ConnectPort" Source="/DDPM.UI.Resources;component/Resources/Images/Port.png"
                       Stretch="UniformToFill" Width="16" Height="16" />
                <UXControls:UXTextBlock Text="{Binding InputSource}" Margin="4,0,0,0"
                                        Foreground="White" FontSize="14" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>