<UserControl x:Class="DDPM.UI.Common.AddDeviceHeaderCtrl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DDPM.UI.Common"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Visibility="{Binding CtrlVisibility}">
    <UserControl.Resources>
        <SolidColorBrush x:Key="RightView_BkColor" Color="#99193457" />
        <SolidColorBrush x:Key="RightView_Header_BkColor" Color="#0A2343" />
        <LinearGradientBrush x:Key="RightView_Header_HiColor" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="#FF0672CB" />
            <GradientStop Offset="1" Color="#FF6E69CF" />
        </LinearGradientBrush>

        <Style x:Key="TextBlock_HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontFamily" Value="Roboto" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border Grid.Row="0" CornerRadius="4" Background="{StaticResource RightView_Header_BkColor}" Height="30" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{Binding Col1Width}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- Header[0] -->
                <Border Grid.Column="0" CornerRadius="4,0,0,4" MouseLeftButtonDown="header0_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Image Name="Icon1" Width="16" Height="16" Margin="0,0,5,0"></Image>
                        <TextBlock Text="{Binding Text1, Mode=TwoWay}" Style="{StaticResource TextBlock_HeaderTextStyle}" />
                    </StackPanel>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding InternalSelectedIndex}" Value="0">
                                    <Setter Property="Background" Value="{StaticResource RightView_Header_HiColor}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <!-- Header[1] -->
                <Border Grid.Column="1" CornerRadius="0,0,0,0" MouseLeftButtonDown="header1_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Image Name="Icon2" Width="16" Height="16" Margin="0,0,5,0"></Image>
                        <TextBlock Text="{Binding Text2, Mode=TwoWay}" Style="{StaticResource TextBlock_HeaderTextStyle}" />
                    </StackPanel>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding InternalSelectedIndex}" Value="1">
                                    <Setter Property="Background" Value="{StaticResource RightView_Header_HiColor}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <!-- Header[2] -->
                <Border Grid.Column="2" CornerRadius="0,4,4,0" MouseLeftButtonDown="header2_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Image Name="Icon3" Width="16" Height="16" Margin="0,0,5,0"></Image>
                        <TextBlock Text="{Binding Text3, Mode=TwoWay}" Style="{StaticResource TextBlock_HeaderTextStyle}" />
                    </StackPanel>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding InternalSelectedIndex}" Value="2">
                                    <Setter Property="Background" Value="{StaticResource RightView_Header_HiColor}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>