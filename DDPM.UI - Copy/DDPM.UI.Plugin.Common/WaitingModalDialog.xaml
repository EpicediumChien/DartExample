<Window x:Class="DDPM.UI.Plugin.Common.WaitingModalDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DDPM.UI.Plugin.Common"
        mc:Ignorable="d"
        xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
        xmlns:viewmodels="clr-namespace:DDPM.UI.Plugin.ViewModels"
        d:DataContext="{d:DesignInstance Type=viewmodels:AddDeviceViewModel}" Background="Transparent" AllowsTransparency="True"
        Title="WaitingModalDialog" Height="349" Width="587" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" WindowStyle="None">
    <Window.Resources>
        <Style x:Key="BorderYes" TargetType="Border">
            <Setter Property="Background" Value="#0E1C2F" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Width" Value="87" />
            <Setter Property="Height" Value="40" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#F5F6F7" />
        </Style>
        <Style x:Key="BorderNo" TargetType="Border">
            <Setter Property="Background" Value="#0672CB" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Width" Value="81" />
            <Setter Property="Height" Value="40" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="#F5F6F7" />
        </Style>
    </Window.Resources>
    <Grid>
        <Border Background="#E00B172C" CornerRadius="4" Width="587" BorderThickness="1" BorderBrush="#293B4D">
            <StackPanel Orientation="Vertical" Margin="0">
                <UXControls:UXTextBlock Name="txtCaption" Foreground="#FFFFFF" VerticalAlignment="Center" FontWeight="Light"
                                        HorizontalAlignment="Center" FontFamily="Roboto" FontSize="32" Margin="0,36,0,20" />
                <UXControls:UXBusyIndicator BusyIndicatorType="Secondary" Foreground="#0672CB" VerticalAlignment="Center" FontWeight="Normal"
                                            HorizontalAlignment="Center"  Width="64" Height="64" IsActive="True" Margin="0,10,0,0" />
                <UXControls:UXTextBlock Name="txtMessage" Foreground="#FFFFFF" FontWeight="Normal" TextWrapping="Wrap" Margin="0,35,0,0"
                                        HorizontalAlignment="Center" FontFamily="Roboto" FontSize="20" LineHeight="28" />
                <Border Name="bdrAlert" Background="#364861" CornerRadius="4" Margin="30,25,30,0" BorderThickness="7,0,0,0" Height="57" BorderBrush="#E67F01">
                    <StackPanel Orientation="Horizontal">
                        <Image x:Name="InfoIcon" Margin="12,0,0,0" Source="/DDPM.UI.Resources;component/Resources/Images/Alert.png" Stretch="Fill"
                               VerticalAlignment="Center" HorizontalAlignment="Left" Width="18" Height="18">
                        </Image>
                        <UXControls:UXTextBlock Name="txtAlert" FontSize="13" Background="#364861" Foreground="#F5F6F7" TextWrapping="Wrap"
                                                VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5,16,0,13" LineHeight="24" Padding="0,3,35,2">
                            <Run Name="txtAlert1" FontFamily="Roboto" FontWeight="Normal" />
                        </UXControls:UXTextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>