<Window x:Class="DDPM.UI.Plugin.Common.OpenRunModalDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DDPM.UI.Plugin.Common"
        mc:Ignorable="d"
        xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF" xmlns:common="clr-namespace:DDPM.UI.Common;assembly=DDPM.UI.Common" AllowsTransparency="True"
        Title="OpenRunModalDialog" ResizeMode="NoResize" ShowInTaskbar="False"
        InputMethod.IsInputMethodEnabled="False"
        WindowStartupLocation="Manual" WindowStyle="None" Background="#0D121A">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DDPM.UI.Common;component/PluginStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="CaptionTextStyle" TargetType="UXControls:UXTextBlock">
                <Setter Property="FontFamily" Value="Roboto" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="LineHeight" Value="18" />
                <Setter Property="Foreground" Value="#A4B8CD" />
            </Style>
            <Style x:Key="DescriptionTextStyle" TargetType="UXControls:UXTextBlock">
                <Setter Property="FontFamily" Value="Roboto" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="Foreground" Value="#A4B8CD" />
            </Style>
            <Style x:Key="CancelButtonStyle" TargetType="common:ActionButton">
                <Setter Property="Height" Value="40" />
                <Setter Property="Background" Value="#0D121A" />
                <Setter Property="Foreground" Value="#FFFFFF" />
                <Setter Property="CornerRadius" Value="2" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="#F5F6F7" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontFamily" Value="Roboto" />
                <Setter Property="FontWeight" Value="Medium" />
            </Style>
            <Style x:Key="SaveButtonStyle" TargetType="common:ActionButton">
                <Setter Property="Height" Value="40" />
                <Setter Property="Background" Value="#0672CB" />
                <Setter Property="Foreground" Value="#F5F6F7" />
                <Setter Property="CornerRadius" Value="2" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontFamily" Value="Roboto" />
                <Setter Property="FontWeight" Value="Medium" />
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Background" Value="#333941" />
                        <Setter Property="Foreground" Value="#818488" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="BrowseButtonStyle" TargetType="common:ActionButton">
                <Setter Property="Height" Value="40" />
                <Setter Property="Width" Value="133" />
                <Setter Property="Background" Value="#0672CB" />
                <Setter Property="Foreground" Value="#F5F6F7" />
                <Setter Property="CornerRadius" Value="2" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontFamily" Value="Roboto" />
                <Setter Property="FontWeight" Value="Medium" />
            </Style>
            <Style x:Key="BorderStyle1" TargetType="Border">
                <Setter Property="Background" Value="#99132F54" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Width" Value="487" />
                <Setter Property="Height" Value="275" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid VerticalAlignment="Top" HorizontalAlignment="Left">
            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,65">
                    <Image Margin="64,21,0,0" Source="/DDPM.UI.Resources;component/Resources/Images/arrow-left.png" Stretch="Uniform"
                           VerticalAlignment="Top" HorizontalAlignment="Left" Cursor="Hand" Width="24" Height="24" MouseLeftButtonDown="CancelClick">
                    </Image>
                    <UXControls:UXTextBlock Name="txtTitleBar" Margin="14,19,0,0" HorizontalAlignment="Left"
                                            Style="{StaticResource ProductNameTextStyle}" Cursor="" VerticalAlignment="Top" />
                </StackPanel>
            </StackPanel>
        </Grid>
        <Grid VerticalAlignment="Top" Margin="0,168,0,0" Width="487">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Left" Margin="0" VerticalAlignment="Top">
                <UXControls:UXTextBlock Name="txtCaption" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Left" />
                <UXControls:UXTextBlock Name="txtDescription" Style="{StaticResource DescriptionTextStyle}"  Margin="0,10,0,17" />
                <Border Style="{StaticResource BorderStyle1}" Margin="0">
                    <DockPanel Name="SearchPanel" Margin="15,12,15,12">
                        <UXControls:UXScrollViewer x:Name="svAction" VerticalScrollBarVisibility="Auto">
                            <ItemsControl Name="OpenRunItems">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <UXControls:UXRadioButton Background="Black" Foreground="White" Margin="0" Padding="12,0,0,0" Height="36"
                                                                      GroupName="OpenRun" Click="ActionRadioButton_Click" Loaded="ActionButtonLoaded" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </UXControls:UXScrollViewer>
                    </DockPanel>
                </Border>
                <StackPanel Name="spOpen" Orientation="Horizontal" Visibility="Collapsed" Margin="0,15,0,0">
                    <common:ActionButton Name="btnBrowse" Style="{StaticResource BrowseButtonStyle}" MouseDown="BrowseClick" Margin="0,0,0,0" />
                    <Grid x:Name="FilePath" Height="50" Margin="0,0,0,-10">
                        <StackPanel Orientation="Horizontal">
                            <Image x:Name="CloseIcon" Source="/DDPM.UI.Resources;component/Resources/Images/CloseXX.png" Stretch="Uniform" Margin="0,0,0,0"
                                   VerticalAlignment="Center" Width="16" Height="16" MouseLeftButtonDown="ClearBrowse" Cursor="Hand" />
                            <UXControls:UXTextBlock Name="txtBrowse" Style="{StaticResource DescriptionTextStyle}" Margin="12,0,0,0" Width="480" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,33,0,0">
                    <common:ActionButton Name="btnCancel" Style="{StaticResource CancelButtonStyle}" Margin="0,0,7,0" MouseDown="CancelClick"
                                         Width="103" />
                    <common:ActionButton Name="btnSave" Style="{StaticResource SaveButtonStyle}" MouseDown="SaveClick" IsEnabled="False"
                                         Width="94" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>