<Window x:Class="DDPM.UI.Plugin.Common.RadialMenuModalDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DDPM.UI.Plugin.Common"
        mc:Ignorable="d"
        xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF" xmlns:common="clr-namespace:DDPM.UI.Common;assembly=DDPM.UI.Common" xmlns:viewmodels="clr-namespace:DDPM.UI.Plugin.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:PenViewModel}" AllowsTransparency="True"
        Title="OpenRunModalDialog" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="Manual" WindowStyle="None" Background="#0D121A">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/DDPM.UI.Common;component/PluginStyles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="CaptionTextStyle" TargetType="UXControls:UXTextBlock">
        <Setter Property="FontFamily" Value="Roboto" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="Foreground" Value="#A4B8CD" />
      </Style>
      <Style x:Key="DescriptionTextStyle" TargetType="UXControls:UXTextBlock">
        <Setter Property="FontFamily" Value="Roboto" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="#A4B8CD" />
      </Style>
      <Style x:Key="CancelButtonStyle" TargetType="common:ActionButton">
        <Setter Property="Height" Value="40" />
        <Setter Property="Background" Value="#0D121A" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#F5F6F7" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="Roboto" />
        <Setter Property="FontWeight" Value="Medium" />
      </Style>
      <Style x:Key="SaveButtonStyle" TargetType="common:ActionButton">
        <Setter Property="Height" Value="40" />
        <Setter Property="Background" Value="#0672CB" />
        <Setter Property="Foreground" Value="#F5F6F7" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="Roboto" />
        <Setter Property="FontWeight" Value="Medium" />
        <Style.Triggers>
          <Trigger Property="IsEnabled" Value="False">
            <Setter Property="Background" Value="#333941" />
            <Setter Property="Foreground" Value="#818488" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="BrowseButtonStyle" TargetType="common:ActionButton">
        <Setter Property="Height" Value="40" />
        <Setter Property="Width" Value="133" />
        <Setter Property="Background" Value="#0672CB" />
        <Setter Property="Foreground" Value="#F5F6F7" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="Roboto" />
        <Setter Property="FontWeight" Value="Medium" />
      </Style>
      <Style x:Key="BorderStyle1" TargetType="Border">
        <Setter Property="Background" Value="#99132F54" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Width" Value="288" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#1E3F6C" />
      </Style>
      <Style x:Key="TextBlockStyle1" TargetType="UXControls:UXTextBlock">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontFamily" Value="Roboto" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="15,16,0,0" />
      </Style>
      <Style x:Key="LabelStyle1" TargetType="UXControls:UXTextBlock">
        <Setter Property="Foreground" Value="#CCCCCC" />
        <Setter Property="FontFamily" Value="Roboto" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="HorizontalAlignment" Value="Left" />
      </Style>
    </ResourceDictionary>
  </Window.Resources>
  <Grid>
    <Grid VerticalAlignment="Top" HorizontalAlignment="Left">
      <StackPanel Orientation="Vertical">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,65">
          <Image Margin="64,21,0,0" Source="/DDPM.UI.Resources;component/Resources/Images/arrow-left.png" Stretch="Uniform"
                 VerticalAlignment="Top" HorizontalAlignment="Left" Cursor="Hand" Width="24" Height="24" MouseLeftButtonDown="BacklClick">
          </Image>
          <UXControls:UXTextBlock Name="txtTitleBar" Margin="14,19,0,0" HorizontalAlignment="Left"
                            Style="{StaticResource ProductNameTextStyle}" Cursor="" VerticalAlignment="Top" />
        </StackPanel>
      </StackPanel>
    </Grid>
    <Grid VerticalAlignment="Top" Margin="10,172,0,0" Width="860">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="400"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid Grid.Column="0">
        <Canvas Name="canvas" />
        <Image x:Name="imgCenter" Margin="145,145,0,0" Source="/DDPM.UI.Resources;component/Resources/Images/PenRadialCenter.png" Stretch="Uniform"
               VerticalAlignment="Top" HorizontalAlignment="Left" Width="110" Height="110" MouseLeftButtonDown="BacklClick"/>
        <UXControls:UXTextBlock Name="Label1" Style="{StaticResource LabelStyle1}" Margin="245,150,0,0" TextAlignment="Center" Width="150" MouseEnter="Path_MouseEnter" MouseLeave="Path_MouseLeave" MouseLeftButtonDown="Path_MouseLeftButtonDown" />
        <UXControls:UXTextBlock Name="Label2" Style="{StaticResource LabelStyle1}" Margin="210,55,0,0" TextAlignment="Center" Width="110" MouseEnter="Path_MouseEnter" MouseLeave="Path_MouseLeave" MouseLeftButtonDown="Path_MouseLeftButtonDown" />
        <UXControls:UXTextBlock Name="Label3" Style="{StaticResource LabelStyle1}" Margin="80,55,0,0" TextAlignment="Center" Width="110" MouseEnter="Path_MouseEnter" MouseLeave="Path_MouseLeave" MouseLeftButtonDown="Path_MouseLeftButtonDown" />
        <UXControls:UXTextBlock Name="Label4" Style="{StaticResource LabelStyle1}" Margin="0,150,0,0" TextAlignment="Center" Width="150" MouseEnter="Path_MouseEnter" MouseLeave="Path_MouseLeave" MouseLeftButtonDown="Path_MouseLeftButtonDown" />
        <UXControls:UXTextBlock Name="Label5" Style="{StaticResource LabelStyle1}" Margin="0,235,0,0" TextAlignment="Center" Width="150" MouseEnter="Path_MouseEnter" MouseLeave="Path_MouseLeave" MouseLeftButtonDown="Path_MouseLeftButtonDown" />
        <UXControls:UXTextBlock Name="Label6" Style="{StaticResource LabelStyle1}" Margin="80,330,0,0" TextAlignment="Center" Width="110" MouseEnter="Path_MouseEnter" MouseLeave="Path_MouseLeave" MouseLeftButtonDown="Path_MouseLeftButtonDown" />
        <UXControls:UXTextBlock Name="Label7" Style="{StaticResource LabelStyle1}" Margin="210,330,0,0" TextAlignment="Center" Width="110" MouseEnter="Path_MouseEnter" MouseLeave="Path_MouseLeave" MouseLeftButtonDown="Path_MouseLeftButtonDown" />
        <UXControls:UXTextBlock Name="Label8" Style="{StaticResource LabelStyle1}" Margin="245,235,0,0" TextAlignment="Center" Width="150" MouseEnter="Path_MouseEnter" MouseLeave="Path_MouseLeave" MouseLeftButtonDown="Path_MouseLeftButtonDown" />
      </Grid>
      <Grid Grid.Column="1">
        <StackPanel Orientation="Vertical" Margin="88,28,0,0">
          <UXControls:UXTextBlock Name="txtFunction" Style="{StaticResource DescriptionTextStyle}"/>
          <Border Name="bdrMenuItem" Style="{StaticResource BorderStyle1}" Margin="0,10,0,0" HorizontalAlignment="Left">
            <StackPanel>
              <Grid>
                <UXControls:UXTextBlock Name="txtMenu" Style="{StaticResource TextBlockStyle1}" />
                <Image x:Name="imgCombo" Source="/DDPM.UI.Resources;component/Resources/Images/Down.png" MouseLeftButtonDown="ComboButtonClick" HorizontalAlignment="Right" VerticalAlignment="Top"
                           Style="{StaticResource ActionArrowStyle}" Margin="0,19,15,19">
                </Image>
              </Grid>
              <DockPanel Name="MenuPanel" Margin="0,-5,5,8" Height="242" Visibility="Collapsed">
                <UXControls:UXScrollViewer x:Name="svMenu" VerticalScrollBarVisibility="Auto">
                  <ItemsControl Name="MenuItems" >
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel>
                          <UXControls:UXRadioButton Background="Black" Foreground="White" Margin="28,-2,0,6" Padding="8,0,0,0"
                                                    GroupName="Options" Click="ActionRadioButton_Click" Loaded="ActionButtonLoaded"/>
                          <common:ActionButton Style="{StaticResource EditActionButtonStyle}" Margin="58,2,0,6" Loaded="ActionButtonLoaded" Tag="Edit" MouseDown="EditActionClick" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </UXControls:UXScrollViewer>
              </DockPanel>
            </StackPanel>
          </Border>
          <StackPanel Name="SectionB">
            <StackPanel Name="spLabel">
              <UXControls:UXTextBlock Name="txtLabel" Style="{StaticResource DescriptionTextStyle}" Margin="0,34,0,0"/>
              <UXControls:UXTextBox Name="txtLabelText" Width="288" Height="56" Padding="10,19" FontWeight="Medium" FontFamily="Roboto" FontSize="14" Margin="0,18,0,0"
                                HorizontalAlignment="Left" Background="#141D28" BorderThickness="1" Foreground="#F5F6F7" BorderBrush="#7E7E7E" MaxLength="30" 
                                TextChanged="LabelTextChanged" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <Grid Width="350" Margin="0,35,0,0">
                <UXControls:UXTextBlock Name="txtUseCenter" Style="{StaticResource DescriptionTextStyle}" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <UXControls:UXToggleSwitch Name="tsUseCenter" Margin="0" HorizontalAlignment="Right" VerticalAlignment="Center" Click="tsUseCenter_Click"
                                         Foreground="White" FontFamily="Roboto" FontSize="16" FontWeight="Normal"/>
              </Grid>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,35,0,0">
              <common:ActionButton Name="btnRestore" Style="{StaticResource CancelButtonStyle}" Margin="0,0,15,0" MouseDown="RestoreClick" Width="176"/>
              <common:ActionButton Name="btnSave" Style="{StaticResource SaveButtonStyle}" MouseDown="SaveClick" IsEnabled="False" Width="176"/>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>
