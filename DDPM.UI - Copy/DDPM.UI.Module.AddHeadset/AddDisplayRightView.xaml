<UserControl x:Class="DDPM.UI.Module.AddDisplay.AddDisplayRightView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DDPM.UI.Module.AddDisplay"
             xmlns:UXControls="clr-namespace:Dell.Client.Framework.UX.WPF.Controls;assembly=DCF.UX.WPF"
             mc:Ignorable="d" 
             xmlns:plugin="clr-namespace:DDPM.UI.Plugin.ViewModels;assembly=DDPM.UI.Plugin.Common"
             d:DesignHeight="647" d:DesignWidth="320" VerticalAlignment="Top" HorizontalAlignment="Left">
  <Grid>
    <Border Background="#99132F54" CornerRadius="13" Width="320" Height="655" Margin="0,10,0,0"/>
    <Grid>
      <UXControls:UXTextBlock Text="{Binding KeyCustomizeCaption}" FontFamily="Roboto" FontSize="20" FontWeight="Normal"
                    Margin="18,24,0,0" Foreground="White"
                    VerticalAlignment="Top" HorizontalAlignment="Left"/>

    </Grid>
    <Grid>
      
    </Grid>
  </Grid>
</UserControl>
